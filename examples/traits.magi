// Interfaces and Operator Overloading
//
// Run with: magi run examples/traits.magi

import std.math

struct Vec2 { x: float, y: float }

func Vec2.magnitude(self) {
    math.sqrt(self.x * self.x + self.y * self.y)
}

func Vec2.add(self, other) {
    Vec2 { x: self.x + other.x, y: self.y + other.y }
}

func Vec2.subtract(self, other) {
    Vec2 { x: self.x - other.x, y: self.y - other.y }
}

func Vec2.equal(self, other) {
    self.x == other.x && self.y == other.y
}

func Vec2.display(self) {
    f"Vec2({self.x}, {self.y})"
}

println("--- Vec2 Operations ---")
const a = Vec2 { x: 3.0, y: 4.0 }
const b = Vec2 { x: 1.0, y: 2.0 }

println(f"a = {a}")
println(f"b = {b}")
println(f"a + b = {a + b}")
println(f"a - b = {a - b}")
println(f"a == b: {a == b}")
println(f"|a| = {a.magnitude()}")

println("")
println("--- Interface Satisfaction ---")

interface HasArea {
    func area(self) -> float
}

struct Circle { radius: float }
struct Square { side: float }

func Circle.area(self) { math.pi * self.radius * self.radius }
func Circle.display(self) { f"Circle(r={self.radius})" }

func Square.area(self) { self.side * self.side }
func Square.display(self) { f"Square(s={self.side})" }

func print_area(shape) {
    println(f"  area = {shape.area()}")
}

const shapes = [Circle { radius: 5.0 }, Square { side: 3.0 }]
for shape in shapes {
    println(shape)
    print_area(shape)
}
