// Fibonacci — recursive vs iterative
//
// Run with: magi run examples/fibonacci.magi

func fib_recursive(n) {
    if n <= 1 { n } else { fib_recursive(n - 1) + fib_recursive(n - 2) }
}

func fib_iterative(n) {
    if n <= 1 { return n }
    let a = 0
    let b = 1
    for i in 2..=n {
        const temp = a + b
        a = b
        b = temp
    }
    b
}

println("--- Recursive Fibonacci (first 15) ---")
const recursive_results = [fib_recursive(i) for i in 0..15]
println(f"  {recursive_results}")

println("")
println("--- Iterative Fibonacci (first 30) ---")
const fibs = [fib_iterative(i) for i in 0..30]
println(f"  {fibs}")

println("")
println("--- Fibonacci Properties ---")
const sum = fibs.reduce(0, (acc, x) => acc + x)
println(f"  Sum of first 30: {sum}")
println(f"  fib(20) = {fib_iterative(20)}")
println(f"  fib(29) = {fib_iterative(29)}")
