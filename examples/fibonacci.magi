// Fibonacci — recursive vs iterative implementations
//
// Run with: magi run examples/fibonacci.magi

// Recursive fibonacci (simple but exponential)
fn fib_recursive(n) {
    if n <= 1 { n } else { fib_recursive(n - 1) + fib_recursive(n - 2) }
}

// Iterative fibonacci (O(n) time, O(1) space)
fn fib_iterative(n) {
    if n <= 1 { return n; }
    let mut a = 0;
    let mut b = 1;
    for (let mut i = 2; i <= n; i += 1) {
        let temp = a + b;
        a = b;
        b = temp;
    }
    b
}

// Generate first N fibonacci numbers using the iterative version
fn fib_sequence(count) {
    [fib_iterative(i) for i in 0..count]
}

output "--- Recursive Fibonacci (first 15) ---";
let recursive_results = [fib_recursive(i) for i in 0..15];
output f"  {recursive_results}";

output "";
output "--- Iterative Fibonacci (first 30) ---";
let fibs = fib_sequence(30);
output f"  {fibs}";

output "";
output "--- Fibonacci Properties ---";
let sum = fibs.reduce(0, |acc, x| acc + x);
output f"  Sum of first 30: {sum}";
output f"  fib(20) = {fib_iterative(20)}";
output f"  fib(29) = {fib_iterative(29)}";

// Golden ratio approximation: fib(n)/fib(n-1) approaches phi
let ratio = fib_iterative(29) / fib_iterative(28);
output f"  fib(29)/fib(28) = {ratio} (golden ratio ~ 1.618)";
