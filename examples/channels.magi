// Channels — spawn + channel producer-consumer patterns
//
// Run with: magi run examples/channels.magi

println("=== Basic Channel Send/Receive ===")

const ch = channel()
const tx = ch[0]
const rx = ch[1]

chan_send(tx, "hello from channel!")
const msg = chan_recv(rx)
println(f"Received: {msg}")

println("")
println("=== Producer-Consumer with Spawn ===")

const ch2 = channel()
const producer_tx = ch2[0]
const consumer_rx = ch2[1]

func produce(sender, count) {
    for i in 0..count {
        chan_send(sender, i * 10)
    }
}

const producer = spawn produce(producer_tx, 5)

let results = []
for i in 0..5 {
    const val = chan_recv(consumer_rx)
    results = array_push(results, val)
}

await producer
println(f"Received values: {results}")

println("")
println("=== Bounded Channel ===")

const bounded = channel(3)
const btx = bounded[0]
const brx = bounded[1]

chan_send(btx, "a")
chan_send(btx, "b")
chan_send(btx, "c")

println(f"  1: {chan_recv(brx)}")
println(f"  2: {chan_recv(brx)}")
println(f"  3: {chan_recv(brx)}")

println("")
println("Channels demo complete.")
