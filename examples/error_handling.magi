// Error Handling — errors are values, multi-return
//
// Run with: magi run examples/error_handling.magi

println("=== Multi-Return Errors ===")

func divide(a, b) {
    if b == 0 { return 0, "division by zero" }
    return a / b, null
}

let result, err = divide(10, 2)
println(f"10 / 2 = {result} (err: {err})")

let result2, err2 = divide(10, 0)
println(f"10 / 0 = {result2} (err: {err2})")

println("")
println("=== Error Propagation ===")

func read_number(input) {
    const n = parse_int(input)
    if n == null { return 0, f"not a number: {input}" }
    return n, null
}

func double_input(input) {
    let n, err = read_number(input)
    if err { return 0, err }
    return n * 2, null
}

let val, err = double_input("21")
println(f"double(21) = {val}")

let val2, err2 = double_input("abc")
println(f"double(abc) error: {err2}")

println("")
println("=== Null Coalescing ===")

const name = null ?? "default"
println(f"null ?? default = {name}")

const config = {"host": "localhost"}
const port = config.port ?? 8080
println(f"port = {port}")

println("")
println("=== Optional Chaining ===")

const user = {"profile": {"name": "Alice"}}
println(f"name = {user?.profile?.name}")
const fallback = "dark"
println(f"missing = {user?.settings?.theme ?? fallback}")

println("")
println("Error handling demo complete.")
