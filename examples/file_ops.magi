// File Operations — read, write, list, and manage files
//
// Run with: magi run examples/file_ops.magi

use std::fs::*;
use std::path::*;

const demo_dir = "/tmp/magi-demo"

println("=== Create Directory ===")
fs_mkdir(demo_dir)
println(f"Created directory: {demo_dir}")

println("")
println("=== Write Files ===")

const hello_path = path_join(demo_dir, "hello.txt")
fs_write(hello_path, "Hello from MAGI!\nThis is a test file.\n")
println(f"Wrote: {hello_path}")

const data_path = path_join(demo_dir, "data.txt")
fs_write(data_path, "line 1\nline 2\nline 3\n")
println(f"Wrote: {data_path}")

println("")
println("=== Read Files ===")

const content = fs_read(hello_path)
println(f"Content of hello.txt:")
println(content)

println("")
println("=== List Directory ===")

const files = fs_list(demo_dir)
println(f"Files in {demo_dir}:")
for file in files {
    println(f"  {file}")
}

println("")
println("=== Cleanup ===")

fs_remove(hello_path)
fs_remove(data_path)
fs_remove(demo_dir)
println("Cleaned up temporary files.")

println("")
println("File operations demo complete.")
