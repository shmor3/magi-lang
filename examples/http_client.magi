// HTTP Client — fetch URLs and inspect responses
//
// Run with: magi run examples/http_client.magi

import std.{net, json}

println("=== Simple HTTP GET ===")

let response, err = net.get("https://httpbin.org/get")
if err {
    println(f"Request failed: {err}")
} else {
    println(f"Status: {response.status}")
    println(f"Body length: {len(response.body)} chars")
}

println("")
println("=== HTTP POST with JSON ===")

const post_body = to_json({"message": "Hello from MAGI!", "version": "1.0.0"})
let post_response, err = net.post("https://httpbin.org/post", post_body)
if err {
    println(f"POST failed: {err}")
} else {
    println(f"POST status: {post_response.status}")
}

println("")
println("HTTP client demo complete.")
