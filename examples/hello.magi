// Hello World — MAGI
//
// Run with: magi run examples/hello.magi

func main() {
    const name = "World"
    println(f"Hello, {name}!")

    const banner = "=" * 30
    println(banner)

    // FizzBuzz 1..20
    for n in 1..=20 {
        const label = match n {
            _ if n % 15 == 0 => "FizzBuzz",
            _ if n % 3 == 0 => "Fizz",
            _ if n % 5 == 0 => "Buzz",
            _ => to_string(n),
        }
        println(f"{n}: {label}")
    }

    println(banner)
    println("Done!")
}

main()
