// Hello MAGI — string formatting and fizzbuzz
use pkg::shared::*;

fn repeat_str(s, n) {
    let mut result = "";
    let mut i = 0;
    while i < n {
        result = result + s;
        i = i + 1;
    }
    result
}

output "Hello from MAGI!";
output repeat_str("=", 30);

// FizzBuzz 1..20
let numbers = range(1, 21);
for n in numbers {
    output f"{n}: {fizzbuzz(n)}";
}

output repeat_str("=", 30);
output "Done!";
