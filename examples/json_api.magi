// JSON API — parse, construct, query, and transform JSON data
//
// Run with: magi run examples/json_api.magi

println("=== JSON Parse ===")

const json_str = '{"name": "Alice", "age": 30, "skills": ["MAGI", "Go", "Rust"]}'
const data = parse_json(json_str)
println(f"Name: {data.name}")
println(f"Age: {data.age}")
println(f"Skills: {data.skills}")

println("")
println("=== JSON Construct ===")

const person = {
    "name": "Bob",
    "age": 25,
    "active": true,
    "scores": [95, 87, 92],
}
const json_output = to_json(person)
println(f"JSON: {json_output}")

println("")
println("=== JSON Transform ===")

const users = [
    {"name": "Alice", "score": 95},
    {"name": "Bob", "score": 87},
    {"name": "Carol", "score": 92},
]

const names = users.map(u => u.name)
println(f"Names: {names}")

const high_scorers = users.filter(u => u.score >= 90).map(u => u.name)
println(f"High scorers: {high_scorers}")

println("")
println("JSON demo complete.")
