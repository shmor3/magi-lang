// Concurrency — spawn tasks and await results
//
// Run with: magi run examples/concurrency.magi

println("=== Spawn and Await ===")

func compute(n) {
    let result = 0
    for i in 0..n {
        result = result + i
    }
    result
}

const t1 = spawn compute(1000)
const t2 = spawn compute(2000)
const t3 = spawn compute(3000)

const r1 = await t1
const r2 = await t2
const r3 = await t3

println(f"sum(0..1000) = {r1}")
println(f"sum(0..2000) = {r2}")
println(f"sum(0..3000) = {r3}")

println("")
println("Concurrency demo complete.")
