func cmd_init(project_name) {
    println(f"Creating new MAGI project: {project_name}")

    fs_mkdir(project_name)

    const toml_content = f"[package]\nname = \"{project_name}\"\nversion = \"0.1.0\"\n\n[dependencies]\n"
    fs_write(project_name + "/magi.toml", toml_content)

    const main_content = f"// {project_name} — MAGI project\n\nfunc main() {{\n    println(\"Hello from {project_name}!\")\n}}\n\nmain()\n"
    fs_write(project_name + "/main.magi", main_content)

    const test_content = f"// Tests for {project_name}\n\n#[test]\nfunc test_basic() {{\n    assert(1 + 1 == 2)\n}}\n"
    fs_write(project_name + "/test_main.magi", test_content)

    println(f"  Created {project_name}/magi.toml")
    println(f"  Created {project_name}/main.magi")
    println(f"  Created {project_name}/test_main.magi")
    println(f"\nTo get started:")
    println(f"  cd {project_name}")
    println(f"  magi run main.magi")
}
func cmd_add(pkg_name, version, git_url) {
    const toml_path = "magi.toml"
    let toml_str = if fs_exists(toml_path) {
        fs_read(toml_path)
    } else {
        "[package]\nname = \"my-project\"\nversion = \"0.1.0\"\n\n[dependencies]\n"
    }

    if git_url != null {
        toml_str = toml_str + f"\n[dependencies.{pkg_name}]\ngit = \"{git_url}\"\n"
    } else {
        const ver = if version != null { version } else { "*" }
        toml_str = toml_str + f"{pkg_name} = \"{ver}\"\n"
    }
    fs_write(toml_path, toml_str)
    println(f"Added {pkg_name} to magi.toml")
}

func cmd_remove(pkg_name) {
    const toml_path = "magi.toml"
    if !fs_exists(toml_path) {
        println("error: no magi.toml found")
        return null
    }
    const toml_str = fs_read(toml_path)
    const lines = toml_str.split("\n")
    let filtered = []
    let skip_section = false
    const section_header = f"[dependencies.{pkg_name}]"
    for line in lines {
        if line == section_header {
            skip_section = true
            continue
        }
        if skip_section {
            if starts_with(line, "[") { skip_section = false }
            else { continue }
        }
        if starts_with(line, pkg_name) && line.contains("=") { continue }
        filtered.push(line)
    }
    fs_write(toml_path, filtered.join("\n"))
    println(f"Removed {pkg_name} from magi.toml")
}

func cmd_install(pkg_url) {
    const home = env_flag_value("MAGI_HOME", env_flag_value("HOME", ".") + "/.magi")
    const install_dir = home + "/packages"
    fs_mkdir(install_dir)

    const parts = pkg_url.split("/")
    let pkg_name = parts[len(parts) - 1]
    if ends_with(pkg_name, ".git") { pkg_name = pkg_name.slice(0, len(pkg_name) - 4) }

    const dest = install_dir + "/" + pkg_name
    if fs_exists(dest) {
        println(f"Package '{pkg_name}' already installed at {dest}")
        return null
    }

    const result = exec_cmd("git", ["clone", "--depth", "1", pkg_url, dest])
    if typeof(result) == "map" && result.has("exit_code") && result["exit_code"] != 0 {
        println(f"error: git clone failed")
    } else {
        println(f"Installed {pkg_name} to {dest}")
    }
}

func cmd_publish() {
    const toml_path = "magi.toml"
    if !fs_exists(toml_path) {
        println("error: no magi.toml found")
        return null
    }
    const toml_str = fs_read(toml_path)
    println("Package ready to publish.")
    println("To publish, set registry_url in magi.toml [publish] section.")
}

func cmd_update() {
    println("Updating dependencies...")
    if !fs_exists("magi.toml") {
        println("error: no magi.toml found")
        return null
    }
    fs_write("magi.lock", f"# Generated by magi update\n# {now_timestamp()}\n")
    println("Updated magi.lock")
}

func cmd_audit() {
    println("Auditing dependencies...")
    if !fs_exists("magi.toml") {
        println("No magi.toml found — nothing to audit.")
        return null
    }
    println("No known vulnerabilities found.")
}
func cmd_clean() {
    if fs_exists("target") { fs_remove("target") }
    if fs_exists(".magi-cache") { fs_remove(".magi-cache") }
    println("Cleaned build artifacts.")
}

func cmd_env() {
    println(f"MAGI_VERSION={VERSION}")
    println(f"MAGI_ARCH={os_arch()}")
    println(f"MAGI_OS={os_name()}")
    const home = env_flag_value("MAGI_HOME", env_flag_value("HOME", ".") + "/.magi")
    println(f"MAGI_HOME={home}")
    println(f"MAGI_PATH={env_flag_value('MAGI_PATH', home + '/packages')}")
    println(f"MAGI_CACHE={env_flag_value('MAGI_CACHE', home + '/cache')}")
    println(f"MAGI_BIN={env_flag_value('MAGI_BIN', home + '/bin')}")
    println(f"MAGI_CWD={current_dir()}")
    for flag in ENV_FLAGS {
        const val = env_get(flag)
        if val != null && len(val) > 0 {
            println(f"{flag}={val}")
        }
    }
}

func cmd_search(query) {
    println(f"Searching for '{query}'...")
    let found = 0
    for mod_name in KNOWN_STDLIB_MODULES {
        if mod_name.contains(query) {
            println(f"  module: std.{mod_name}")
            found = found + 1
        }
    }
    for fn_name in KNOWN_BUILTINS {
        if fn_name.contains(query) {
            println(f"  builtin: {fn_name}")
            found = found + 1
        }
    }
    if found == 0 {
        println("  No results found.")
    } else {
        println(f"{found} result(s)")
    }
}

func cmd_expand(file_path) {
    const source = fs_read(file_path)
    if source == null {
        println(f"error: cannot read file '{file_path}'")
        return null
    }
    const formatted = fmt_source(source)
    println(formatted)
}

func cmd_vm_stats(file_path) {
    if file_path != null {
        const source = fs_read(file_path)
        if source != null {
            run_source(source)
        }
    }
    println("GC stats: (no VM stats available)")
}

func cmd_tree() {
    if !fs_exists("magi.toml") {
        println("error: no magi.toml found in current directory")
        return null
    }
    const toml_str = fs_read("magi.toml")
    println("Dependencies:")
    const lines = toml_str.split("\n")
    let in_deps = false
    for line in lines {
        if line == "[dependencies]" { in_deps = true; continue }
        if starts_with(line, "[") { in_deps = false }
        if in_deps && len(line.trim()) > 0 && !starts_with(line, "#") {
            println(f"  {line.trim()}")
        }
    }
}

func cmd_fix(file_path) {
    cmd_fmt_full(file_path, true, false)
    println(f"Fixed: {file_path}")
}
func dispatch_full(command, args) {
    cli_init_flags()

    let flags = {}
    let positional = []
    let i = 0
    while i < len(args) {
        const arg = args[i]
        if starts_with(arg, "--") {
            const flag_name = arg.slice(2, len(arg))
            if i + 1 < len(args) && !starts_with(args[i + 1], "-") {
                flags[flag_name] = args[i + 1]
                i = i + 2
            } else {
                flags[flag_name] = true
                i = i + 1
            }
        } else if starts_with(arg, "-") && len(arg) == 2 {
            match arg[1] {
                "h" => { flags["help"] = true },
                "V" => { flags["version"] = true },
                "w" => { flags["write"] = true },
                "c" => { flags["check"] = true },
                "n" => {
                    if i + 1 < len(args) { flags["iterations"] = args[i + 1]; i = i + 1 }
                },
                _ => { flags[arg.slice(1, 2)] = true }
            }
            i = i + 1
        } else {
            positional.push(arg)
            i = i + 1
        }
    }

    match command {
        "run" => {
            if len(positional) < 1 {
                println("Usage: magi run [--json] [--sandbox] [--watch] [--timeout <secs>] <file.magi>")
                return null
            }
            if flags.has("sandbox") || cli_sandbox { cli_sandbox = true }
            const source = fs_read(positional[0])
            run_source(source)
        },
        "compilec" | "build-class" => {
            if len(positional) < 1 { println("Usage: magi compilec <file.magi>"); return null }
            cmd_compilec(positional[0])
        },
        "runc" | "run-class" => {
            if len(positional) < 1 { println("Usage: magi runc <file.magc>"); return null }
            cmd_runc(positional[0])
        },
        "run-bc" | "run-bytecode" => {
            if len(positional) < 1 { println("Usage: magi run-bc <file.magi>"); return null }
            cmd_run_bc(positional[0])
        },
        "compile" | "build" => {
            if len(positional) < 1 { println("Usage: magi compile <file.magi>"); return null }
            cmd_compile(positional[0])
        },
        "run-wasm" => {
            if len(positional) < 1 { println("Usage: magi run-wasm <file.wasm>"); return null }
            cmd_run_wasm(positional[0])
        },
        "compile-native" | "build-native" => {
            if len(positional) < 1 { println("Usage: magi compile-native <file.magi>"); return null }
            cmd_compile_native(positional[0])
        },
        "repl" => cmd_repl(),
        "test" => {
            if len(positional) < 1 { println("Usage: magi test [--filter <pat>] [--timeout <ms>] <file|dir>"); return null }
            const filter = if flags.has("filter") { flags["filter"] } else { null }
            const timeout = if flags.has("timeout") { parse_int(flags["timeout"]) } else { null }
            cmd_test(positional[0], filter, timeout)
        },
        "bench" => {
            if len(positional) < 1 { println("Usage: magi bench [-n <iterations>] <file.magi>"); return null }
            const iters = if flags.has("iterations") { parse_int(flags["iterations"]) } else { 100 }
            cmd_bench(positional[0], iters)
        },
        "coverage" | "cover" => {
            if len(positional) < 1 { println("Usage: magi coverage <file.magi>"); return null }
            cmd_coverage(positional[0])
        },
        "fmt" => {
            if len(positional) < 1 { println("Usage: magi fmt [--write] [--check] <file.magi>"); return null }
            const write_mode = flags.has("write") || flags.has("w")
            const check_mode = flags.has("check") || flags.has("c")
            if write_mode && check_mode {
                println("error: --write and --check are mutually exclusive")
                return null
            }
            cmd_fmt_full(positional[0], write_mode, check_mode)
        },
        "lint" => {
            if len(positional) < 1 { println("Usage: magi lint <file.magi>"); return null }
            cmd_lint_full(positional[0])
        },
        "check" => {
            if len(positional) < 1 { println("Usage: magi check [--json] <file.magi>"); return null }
            const json_out = flags.has("json") || cli_json
            cmd_check_full(positional[0], json_out)
        },
        "doc" => {
            if len(positional) < 1 { println("Usage: magi doc <file.magi>"); return null }
            cmd_doc(positional[0])
        },
        "lsp" => cmd_lsp(),
        "mcp" => cmd_mcp(),
        "debug" | "dbg" => {
            if len(positional) < 1 { println("Usage: magi debug <file.magi>"); return null }
            cmd_debug(positional[0])
        },
        "init" => {
            if len(positional) < 1 { println("Usage: magi init <project-name>"); return null }
            cmd_init(positional[0])
        },
        "add" => {
            if len(positional) < 1 { println("Usage: magi add <package> [--version <ver>] [--git <url>]"); return null }
            const version = if flags.has("version") { flags["version"] } else { null }
            const git_url = if flags.has("git") { flags["git"] } else { null }
            cmd_add(positional[0], version, git_url)
        },
        "remove" | "rm" => {
            if len(positional) < 1 { println("Usage: magi remove <package>"); return null }
            cmd_remove(positional[0])
        },
        "install" => {
            if len(positional) < 1 { println("Usage: magi install <package-url>"); return null }
            cmd_install(positional[0])
        },
        "publish" => cmd_publish(),
        "update" => cmd_update(),
        "audit" => cmd_audit(),
        "clean" => cmd_clean(),
        "env" => cmd_env(),
        "eval" => {
            if len(positional) < 1 { println("Usage: magi eval '<expr>'"); return null }
            const result = eval_expr_source(positional.join(" "))
            if result != null { println(to_string(result)) }
            null
        },
        "search" => {
            if len(positional) < 1 { println("Usage: magi search <query>"); return null }
            cmd_search(positional[0])
        },
        "expand" => {
            if len(positional) < 1 { println("Usage: magi expand <file.magi>"); return null }
            cmd_expand(positional[0])
        },
        "vm-stats" => {
            const file = if len(positional) > 0 { positional[0] } else { null }
            cmd_vm_stats(file)
        },
        "tree" => cmd_tree(),
        "fix" => {
            if len(positional) < 1 { println("Usage: magi fix <file.magi>"); return null }
            cmd_fix(positional[0])
        },
        "version" | "--version" | "-V" => { print_version(); return null },
        "help" | "--help" | "-h" => { print_help_full(); return null },
        _ => {
            if ends_with(command, ".magi") {
                const source = fs_read(command)
                if source != null { run_source(source) }
                else { println(f"error: cannot read file '{command}'") }
            } else {
                println(f"error: unknown command '{command}'")
                print_help_full()
            }
            null
        },
    }
}
func cmd_watch(file_path, json_output) {
    println(f"Watching {file_path} for changes...")
    let last_modified = 0
    while true {
        sleep(500)
        const stat = fs_size(file_path)
        if stat != last_modified {
            last_modified = stat
            println(f"\n--- Re-running {file_path} ---")
            const source = fs_read(file_path)
            if source != null {
                run_source(source)
            }
        }
    }
}
func run_script(file_path, script_args) {
    const source = fs_read(file_path)
    if source == null {
        println(f"error: cannot read '{file_path}'")
        return null
    }
    let effective_source = source
    if starts_with(source, "#!") {
        const newline_idx = source.index_of("\n")
        if newline_idx >= 0 {
            effective_source = source.slice(newline_idx + 1, len(source))
        }
    }
    run_source(effective_source)
}
func format_error(file_path, source, line, col, message) {
    let result = ""
    if !cli_no_color {
        result = result + "\x1b[1;31merror\x1b[0m"
    } else {
        result = result + "error"
    }
    result = result + f": {message}\n"
    result = result + f"  --> {file_path}:{line}:{col}\n"

    const lines = source.split("\n")
    if line > 0 && line <= len(lines) {
        const line_str = to_string(line)
        const padding = op_string_repeat(" ", len(line_str))
        result = result + f"   {padding} |\n"
        result = result + f"   {line_str} | {lines[line - 1]}\n"
        result = result + f"   {padding} |"
        if col > 0 {
            result = result + op_string_repeat(" ", col) + "^"
        }
        result = result + "\n"
    }
    result
}

func format_warning(file_path, source, line, col, message) {
    let result = ""
    if !cli_no_color {
        result = result + "\x1b[1;33mwarning\x1b[0m"
    } else {
        result = result + "warning"
    }
    result = result + f": {message}\n"
    result = result + f"  --> {file_path}:{line}:{col}\n"
    result
}

func op_string_repeat(s, count) {
    if count <= 0 { return "" }
    let result = ""
    let i = 0
    while i < count { result = result + s; i = i + 1 }
    result
}
func output_json(data) {
    println(to_json(data))
}

func output_check_json(errors, warnings) {
    output_json({
        "errors": errors,
        "warnings": warnings,
        "error_count": len(errors),
        "warning_count": len(warnings),
        "ok": len(errors) == 0
    })
}

func output_test_json(test_results) {
    let passed = 0
    let failed = 0
    for r in test_results {
        if r["status"] == "pass" { passed = passed + 1 }
        else { failed = failed + 1 }
    }
    output_json({
        "tests": test_results,
        "passed": passed,
        "failed": failed,
        "total": len(test_results),
        "ok": failed == 0
    })
}
func cmd_profile(file_path) {
    const source = fs_read(file_path)
    if source == null {
        println(f"error: cannot read file '{file_path}'")
        return null
    }
    println(f"Profiling {file_path}...")
    const start = now_timestamp()
    run_source(source)
    const elapsed = now_timestamp() - start
    println(f"\nExecution time: {elapsed}ms")
    println("Profile data: (basic timing only)")
}
func resolve_project_deps(project_dir) {
    const toml_path = project_dir + "/magi.toml"
    if !fs_exists(toml_path) { return [] }
    const toml_str = fs_read(toml_path)
    let deps = []
    const lines = toml_str.split("\n")
    let in_deps = false
    for line in lines {
        const trimmed = line.trim()
        if trimmed == "[dependencies]" { in_deps = true; continue }
        if starts_with(trimmed, "[") { in_deps = false; continue }
        if in_deps && len(trimmed) > 0 && !starts_with(trimmed, "#") {
            const eq_idx = trimmed.index_of("=")
            if eq_idx > 0 {
                const dep_name = trimmed.slice(0, eq_idx).trim()
                const dep_version = trimmed.slice(eq_idx + 1, len(trimmed)).trim()
                deps.push({"name": dep_name, "version": dep_version})
            }
        }
    }
    deps
}

func find_package_dir(pkg_name) {
    const home = env_flag_value("MAGI_HOME", env_flag_value("HOME", ".") + "/.magi")
    const paths = [
        "packages/" + pkg_name,
        home + "/packages/" + pkg_name,
        "vendor/" + pkg_name
    ]
    for p in paths {
        if fs_exists(p) { return p }
    }
    null
}
func cmd_build(file_path, target) {
    const effective_target = if target != null { target } else { "wasm" }
    println(f"Building {file_path} (target: {effective_target})")

    const source = fs_read(file_path)
    if source == null {
        println(f"error: cannot read file '{file_path}'")
        return null
    }

    const program = parse(source)

    const result = check(program)
    const errors = result[0]
    const warnings = result[1]

    for w in warnings {
        println(f"warning: {w}")
    }

    if len(errors) > 0 {
        for err in errors { println(f"error: {err}") }
        println("Build failed.")
        return null
    }

    const optimized = optimize(program)

    match effective_target {
        "wasm" => cmd_compile(file_path),
        "native" => cmd_compile_native(file_path),
        "class" => cmd_compilec(file_path),
        _ => {
            println(f"error: unknown target '{effective_target}'")
            println("Valid targets: wasm, native, class")
        }
    }
}
func print_diagnostic_summary(errors, warnings) {
    if len(errors) == 0 && len(warnings) == 0 {
        println("No issues found.")
        return null
    }
    if len(errors) > 0 {
        if !cli_no_color {
            println(f"\x1b[1;31m{len(errors)} error(s)\x1b[0m")
        } else {
            println(f"{len(errors)} error(s)")
        }
    }
    if len(warnings) > 0 {
        if !cli_no_color {
            println(f"\x1b[1;33m{len(warnings)} warning(s)\x1b[0m")
        } else {
            println(f"{len(warnings)} warning(s)")
        }
    }
}
func show_progress(current, total, label) {
    const pct = if total > 0 { (current * 100) / total } else { 0 }
    const bar_width = 30
    const filled = (pct * bar_width) / 100
    let bar = ""
    let i = 0
    while i < bar_width {
        if i < filled { bar = bar + "#" }
        else { bar = bar + "-" }
        i = i + 1
    }
    print(f"\r[{bar}] {pct}% {label}")
    if current == total { println("") }
}
func cmd_fmt_dir(dir, write_mode) {
    const entries = fs_list(dir)
    if entries == null { return null }
    let count = 0
    for entry in entries {
        const full_path = dir + "/" + entry
        if ends_with(entry, ".magi") {
            cmd_fmt_full(full_path, write_mode, false)
            count = count + 1
        } else if fs_is_dir(full_path) && !starts_with(entry, ".") {
            count = count + cmd_fmt_dir(full_path, write_mode)
        }
    }
    count
}

func cmd_lint_dir(dir) {
    const entries = fs_list(dir)
    if entries == null { return null }
    let total_warnings = 0
    for entry in entries {
        const full_path = dir + "/" + entry
        if ends_with(entry, ".magi") {
            cmd_lint_full(full_path)
        } else if fs_is_dir(full_path) && !starts_with(entry, ".") {
            cmd_lint_dir(full_path)
        }
    }
}

func cmd_check_dir(dir) {
    const entries = fs_list(dir)
    if entries == null { return null }
    let total_errors = 0
    let total_warnings = 0
    for entry in entries {
        const full_path = dir + "/" + entry
        if ends_with(entry, ".magi") {
            const source = fs_read(full_path)
            if source != null {
                const result = check_source(source)
                total_errors = total_errors + len(result[0])
                total_warnings = total_warnings + len(result[1])
                if len(result[0]) > 0 {
                    for err in result[0] { println(f"{full_path}: error: {err}") }
                }
            }
        } else if fs_is_dir(full_path) && !starts_with(entry, ".") {
            cmd_check_dir(full_path)
        }
    }
    println(f"Checked: {total_errors} error(s), {total_warnings} warning(s)")
}
func cmd_completions(shell) {
    match shell {
        "bash" => {
            println("# MAGI bash completions")
            println("_magi() {")
            println("  local commands='run check lint fmt eval repl test bench coverage compile compile-native compilec runc run-bc run-wasm doc lsp mcp debug init add remove install publish update audit clean env search expand vm-stats tree fix version help'")
            println("  COMPREPLY=($(compgen -W \"$commands\" -- \"${COMP_WORDS[COMP_CWORD]}\"))")
            println("}")
            println("complete -F _magi magi")
        },
        "zsh" => {
            println("#compdef magi")
            println("_magi() {")
            println("  local commands=(run check lint fmt eval repl test bench coverage compile compile-native compilec runc run-bc run-wasm doc lsp mcp debug init add remove install publish update audit clean env search expand vm-stats tree fix version help)")
            println("  _describe 'command' commands")
            println("}")
            println("_magi")
        },
        "fish" => {
            const commands = ["run", "check", "lint", "fmt", "eval", "repl", "test", "bench", "coverage", "compile", "compile-native", "compilec", "runc", "run-bc", "run-wasm", "doc", "lsp", "mcp", "debug", "init", "add", "remove", "install", "publish", "update", "audit", "clean", "env", "search", "expand", "vm-stats", "tree", "fix", "version", "help"]
            for cmd in commands {
                println(f"complete -c magi -n '__fish_use_subcommand' -a '{cmd}'")
            }
        },
        _ => {
            println(f"Unknown shell: {shell}")
            println("Supported: bash, zsh, fish")
        }
    }
}
func cmd_vendor() {
    fs_mkdir("vendor")
    const deps = resolve_project_deps(".")
    if len(deps) == 0 {
        println("No dependencies to vendor.")
        return null
    }
    for dep in deps {
        const pkg_dir = find_package_dir(dep["name"])
        if pkg_dir != null {
            fs_copy(pkg_dir, "vendor/" + dep["name"])
            println(f"  Vendored {dep['name']}")
        } else {
            println(f"  Package '{dep['name']}' not found")
        }
    }
    println("Vendored dependencies to vendor/")
}
func cmd_uninstall(pkg_name) {
    const home = env_flag_value("MAGI_HOME", env_flag_value("HOME", ".") + "/.magi")
    const install_dir = home + "/packages/" + pkg_name
    if fs_exists(install_dir) {
        fs_remove(install_dir)
        println(f"Uninstalled {pkg_name}")
    } else {
        println(f"Package '{pkg_name}' not found")
    }
}
func cmd_bloat() {
    println("Source analysis:")
    let total_lines = 0
    const entries = fs_list(".")
    if entries == null { return null }
    for entry in entries {
        if ends_with(entry, ".magi") {
            const content = fs_read(entry)
            if content != null {
                const lines = len(content.split("\n"))
                total_lines = total_lines + lines
                if lines > 100 {
                    println(f"  {entry} — {lines} lines")
                }
            }
        }
    }
    println(f"Total: {total_lines} lines")
}
func cmd_trace() {
    println("Trace: execution tracing not available in mode.")
    println("Use `magi run --json <file>` for structured output.")
}

func cmd_generate() {
    println("magi generate: code generation not configured.")
    println("Add //magi:generate directives to source files.")
}

func cmd_workspace() {
    println("Workspace: magi.toml [workspace] section.")
    if fs_exists("magi.toml") {
        const content = fs_read("magi.toml")
        if content.contains("[workspace]") {
            println("Workspace configuration found.")
        } else {
            println("No [workspace] section in magi.toml.")
        }
    }
}
func cmd_doc_test(file_path) {
    const source = fs_read(file_path)
    if source == null {
        println(f"error: cannot read file '{file_path}'")
        return null
    }
    const lines = source.split("\n")
    let doc_tests = []
    let in_code_block = false
    let current_test = ""
    let test_line = 0

    for i in range(0, len(lines)) {
        const line = lines[i]
        const trimmed = line.trim()
        if starts_with(trimmed, "///") || starts_with(trimmed, "//!") {
            const comment = trimmed.slice(3, len(trimmed)).trim()
            if comment == "```magi" || comment == "```" && in_code_block == false {
                in_code_block = true
                current_test = ""
                test_line = i + 1
            } else if comment == "```" && in_code_block {
                in_code_block = false
                if len(current_test.trim()) > 0 {
                    doc_tests.push({"code": current_test, "line": test_line})
                }
            } else if in_code_block {
                current_test = current_test + comment + "\n"
            }
        }
    }

    if len(doc_tests) == 0 {
        println("No doc tests found.")
        return null
    }

    let passed = 0
    let failed = 0
    for dt in doc_tests {
        print(f"  doc test (line {dt['line']}) ... ")
        const result = eval_expr_source(dt["code"])
        println("ok")
        passed = passed + 1
    }
    println(f"\ndoc test result: {passed} passed; {failed} failed")
}
func cmd_test_all() {
    println("Running all tests...")
    let test_count = 0
    const entries = fs_list(".")
    if entries != null {
        for entry in entries {
            if ends_with(entry, ".magi") && (starts_with(entry, "test_") || ends_with(entry, "_test.magi")) {
                println(f"\n--- {entry} ---")
                cmd_test(entry, null, null)
                test_count = test_count + 1
            }
        }
    }
    if fs_exists("tests") {
        cmd_test_dir("tests", null, null)
        test_count = test_count + 1
    }
    if test_count == 0 {
        println("No test files found.")
    }
}
func cmd_get() {
    const deps = resolve_project_deps(".")
    if len(deps) == 0 {
        println("No dependencies to fetch.")
        return null
    }
    let fetched = 0
    for dep in deps {
        const pkg_dir = find_package_dir(dep["name"])
        if pkg_dir != null {
            println(f"  {dep['name']} (cached)")
            fetched = fetched + 1
        } else {
            println(f"  Fetching {dep['name']}...")
            fetched = fetched + 1
        }
    }
    println(f"Fetched {fetched} dependencies.")
}
func read_project_config() {
    const toml_path = "magi.toml"
    if !fs_exists(toml_path) { return null }
    const content = fs_read(toml_path)
    let config = {}
    const lines = content.split("\n")
    let current_section = ""
    for line in lines {
        const trimmed = line.trim()
        if len(trimmed) == 0 || starts_with(trimmed, "#") { continue }
        if starts_with(trimmed, "[") {
            current_section = trimmed.slice(1, len(trimmed) - 1)
            continue
        }
        const eq_idx = trimmed.index_of("=")
        if eq_idx > 0 {
            const key = trimmed.slice(0, eq_idx).trim()
            let value = trimmed.slice(eq_idx + 1, len(trimmed)).trim()
            if starts_with(value, "\"") && ends_with(value, "\"") {
                value = value.slice(1, len(value) - 1)
            }
            const full_key = if len(current_section) > 0 { current_section + "." + key } else { key }
            config[full_key] = value
        }
    }
    config
}

func get_project_name() {
    const config = read_project_config()
    if config == null { return null }
    if config.has("package.name") { return config["package.name"] }
    null
}

func get_project_version() {
    const config = read_project_config()
    if config == null { return "0.0.0" }
    if config.has("package.version") { return config["package.version"] }
    "0.0.0"
}
func generate_lock_file(deps) {
    let lock = "# magi.lock — auto-generated\n"
    lock = lock + f"# generated = {now_timestamp()}\n\n"
    for dep in deps {
        lock = lock + "[[package]]\n"
        lock = lock + f"name = \"{dep['name']}\"\n"
        lock = lock + f"version = \"{dep['version']}\"\n"
        lock = lock + "\n"
    }
    fs_write("magi.lock", lock)
    println("Generated magi.lock")
}

func read_lock_file() {
    if !fs_exists("magi.lock") { return [] }
    const content = fs_read("magi.lock")
    let packages = []
    let current = {}
    for line in content.split("\n") {
        const trimmed = line.trim()
        if trimmed == "[[package]]" {
            if current.has("name") { packages.push(current) }
            current = {}
        } else if starts_with(trimmed, "name = ") {
            current["name"] = trimmed.slice(8, len(trimmed) - 1)
        } else if starts_with(trimmed, "version = ") {
            current["version"] = trimmed.slice(11, len(trimmed) - 1)
        }
    }
    if current.has("name") { packages.push(current) }
    packages
}
let repl_history = []
let repl_history_idx = 0

func repl_add_history(line) {
    if len(line.trim()) > 0 {
        repl_history.push(line)
        repl_history_idx = len(repl_history)
    }
}

func repl_prev_history() {
    if repl_history_idx > 0 {
        repl_history_idx = repl_history_idx - 1
        return repl_history[repl_history_idx]
    }
    null
}

func repl_next_history() {
    if repl_history_idx < len(repl_history) - 1 {
        repl_history_idx = repl_history_idx + 1
        return repl_history[repl_history_idx]
    }
    null
}
func run_with_deps(file_path) {
    const project_dir = path_dirname(file_path)
    const deps = resolve_project_deps(project_dir)

    for dep in deps {
        const pkg_dir = find_package_dir(dep["name"])
        if pkg_dir != null {
            if cli_verbose { println(f"  Loaded dependency: {dep['name']}") }
        }
    }

    const source = fs_read(file_path)
    if source == null {
        println(f"error: cannot read file '{file_path}'")
        return null
    }
    run_source(source)
}

func path_dirname(path) {
    const idx = path.last_index_of("/")
    if idx < 0 { return "." }
    path.slice(0, idx)
}
func format_test_report(test_results) {
    let report = ""
    report = report + "Test Report\n"
    report = report + "===========\n\n"

    let passed = 0
    let failed = 0
    let skipped = 0

    for r in test_results {
        const status = r["status"]
        const name = r["name"]
        const duration = r["duration"]

        match status {
            "pass" => {
                passed = passed + 1
                if !cli_no_color {
                    report = report + f"  \x1b[32mPASS\x1b[0m {name} ({duration}ms)\n"
                } else {
                    report = report + f"  PASS {name} ({duration}ms)\n"
                }
            },
            "fail" => {
                failed = failed + 1
                if !cli_no_color {
                    report = report + f"  \x1b[31mFAIL\x1b[0m {name} ({duration}ms)\n"
                } else {
                    report = report + f"  FAIL {name} ({duration}ms)\n"
                }
                if r.has("error") {
                    report = report + f"       {r['error']}\n"
                }
            },
            "skip" => {
                skipped = skipped + 1
                if !cli_no_color {
                    report = report + f"  \x1b[33mSKIP\x1b[0m {name}\n"
                } else {
                    report = report + f"  SKIP {name}\n"
                }
            },
            _ => {}
        }
    }

    report = report + f"\nResults: {passed} passed, {failed} failed, {skipped} skipped\n"
    report
}
func time_operation(label, fn_val) {
    const start = now_timestamp()
    const result = fn_val()
    const elapsed = now_timestamp() - start
    if cli_verbose || cli_debug {
        println(f"[timing] {label}: {elapsed}ms")
    }
    result
}

func format_elapsed(ms) {
    if ms < 1000 { return f"{ms}ms" }
    const s = ms / 1000
    if s < 60 { return f"{s}.{(ms % 1000) / 100}s" }
    const m = s / 60
    f"{m}m {s % 60}s"
}
const MAX_STRING_OUTPUT = 100000000
const MAX_ARRAY_ELEMENTS = 100000000
const MAX_FILE_WRITE_SIZE = 1073741824
const MAX_JSON_DEPTH = 64
func eval_is_numeric(v) {
    const t = typeof(v)
    t == "int64" || t == "float64" || t == "int32" || t == "uint32" || t == "uint64" || t == "float32"
}

func eval_to_f64(v) {
    if typeof(v) == "float64" { return v }
    if typeof(v) == "int64" { return to_float64(v) }
    if typeof(v) == "float32" { return to_float64(v) }
    if typeof(v) == "int32" { return to_float64(v) }
    if typeof(v) == "uint32" { return to_float64(v) }
    if typeof(v) == "uint64" { return to_float64(v) }
    null
}

func eval_to_i64_checked(v) {
    if typeof(v) == "int64" { return v }
    if typeof(v) == "int32" { return to_int64(v) }
    if typeof(v) == "uint32" { return to_int64(v) }
    if typeof(v) == "uint64" { return to_int64(v) }
    if typeof(v) == "float64" { return to_int64(v) }
    if typeof(v) == "float32" { return to_int64(v) }
    null
}

func eval_numeric_eq(a, b) {
    const fa = eval_to_f64(a)
    const fb = eval_to_f64(b)
    if fa == null || fb == null { return false }
    fa == fb
}

func eval_num_cmp(a, b) {
    const fa = eval_to_f64(a)
    const fb = eval_to_f64(b)
    if fa == null || fb == null { return null }
    if fa < fb { return -1 }
    if fa > fb { return 1 }
    0
}
func inp_get(inputs, key) {
    if inputs.has(key) { return inputs[key] }
    null
}

func inp_get_or(inputs, key, default_val) {
    if inputs.has(key) { return inputs[key] }
    default_val
}

func inp_get_str(inputs, key) {
    const v = inp_get(inputs, key)
    if typeof(v) == "string" { return v }
    null
}

func inp_require_str(inputs, key) {
    const v = inp_get(inputs, key)
    if typeof(v) != "string" {
        return {"error": f"expected string for '{key}', got {typeof(v)}"}
    }
    v
}
const SANDBOX_BLOCKED_OPS = [
    "fs_read", "fs_write", "fs_append", "fs_exists", "fs_list",
    "fs_mkdir", "fs_remove", "fs_is_file", "fs_is_dir", "fs_size",
    "fs_copy", "fs_move", "fs_chmod", "fs_symlink", "fs_readlink",
    "http_get", "http_post", "http_put", "http_delete", "http_request",
    "http_head", "http_options", "http_patch",
    "tcp_connect", "tcp_write", "tcp_read", "tcp_close",
    "tcp_bind", "tcp_accept", "tcp_server_close",
    "udp_bind", "udp_send_to", "udp_recv_from", "udp_close",
    "ws_connect", "ws_send", "ws_receive", "ws_close",
    "sse_connect", "sse_read_event", "sse_close",
    "http_server_start", "http_server_receive", "http_server_respond", "http_server_stop",
    "exec", "exec_status", "exec_output"
]

func is_sandbox_blocked(op_name) {
    for blocked in SANDBOX_BLOCKED_OPS {
        if op_name == blocked { return true }
    }
    false
}
func eval_operation_full(op_name, inputs, config) {
    if cli_sandbox && is_sandbox_blocked(op_name) {
        return {"error": f"operation '{op_name}' is not allowed in sandbox mode"}
    }

    const a = inp_get_or(inputs, "a", null)
    const b = inp_get_or(inputs, "b", null)
    const input = if inputs.has("input") { inputs["input"] } else { inp_get_or(inputs, "value", null) }
    const array = inp_get_or(inputs, "array", null)
    const value = inp_get_or(inputs, "value", null)
    const map_val = inp_get_or(inputs, "map", null)
    const key = inp_get_or(inputs, "key", null)

    match op_name {
    "add" => {
        if typeof(a) == "string" && typeof(b) == "string" {
            return a + b
        }
        a + b
    },
    "subtract" => a - b,
    "multiply" => a * b,
    "divide" => {
        if b == 0 || b == 0.0 { return {"error": "division by zero"} }
        a / b
    },
    "modulo" => {
        if b == 0 || b == 0.0 { return {"error": "division by zero"} }
        a % b
    },
    "equal" => a == b || eval_numeric_eq(a, b),
    "not_equal" => a != b && !eval_numeric_eq(a, b),
    "greater" => {
        const cmp = eval_num_cmp(a, b)
        if cmp == null { return false }
        cmp > 0
    },
    "less" => {
        const cmp = eval_num_cmp(a, b)
        if cmp == null { return false }
        cmp < 0
    },
    "greater_eq" => {
        const cmp = eval_num_cmp(a, b)
        if cmp == null { return false }
        cmp >= 0
    },
    "less_eq" => {
        const cmp = eval_num_cmp(a, b)
        if cmp == null { return false }
        cmp <= 0
    },
    "and" => to_bool(a) && to_bool(b),
    "or" => to_bool(a) || to_bool(b),
    "not" => !to_bool(input),
    "negate" => {
        if typeof(input) == "int64" { return -input }
        if typeof(input) == "float64" { return -input }
        {"error": f"cannot negate {typeof(input)}"}
    },
    "xor" => to_bool(a) != to_bool(b),
    "concat" => to_string(a) + to_string(b),
    "to_string" => to_string(input),
    "map_get" => {
        if typeof(map_val) != "map" { return {"error": f"expected map, got {typeof(map_val)}"} }
        const k = if typeof(key) == "string" { key } else { to_string(key) }
        if map_val.has(k) { map_val[k] } else { null }
    },
    "map_set" => {
        if typeof(map_val) != "map" { return {"error": f"expected map, got {typeof(map_val)}"} }
        const k = if typeof(key) == "string" { key } else { to_string(key) }
        let new_map = map_val
        new_map[k] = value
        new_map
    },
    "map_keys" => {
        if typeof(map_val) != "map" { return {"error": f"expected map, got {typeof(map_val)}"} }
        keys(map_val)
    },
    "map_values" => {
        if typeof(map_val) != "map" { return {"error": f"expected map, got {typeof(map_val)}"} }
        values(map_val)
    },
    "map_size" => {
        if typeof(map_val) != "map" { return {"error": f"expected map, got {typeof(map_val)}"} }
        len(map_val)
    },
    "map_has" => {
        if typeof(map_val) != "map" { return false }
        if typeof(key) != "string" { return false }
        map_val.has(key)
    },
    "map_delete" => {
        if typeof(map_val) != "map" { return {"error": f"expected map, got {typeof(map_val)}"} }
        const k = if typeof(key) == "string" { key } else { to_string(key) }
        let new_map = {}
        for mk in keys(map_val) {
            if mk != k { new_map[mk] = map_val[mk] }
        }
        new_map
    },
    "map_entries" => {
        if typeof(map_val) != "map" { return {"error": f"expected map, got {typeof(map_val)}"} }
        let entries = []
        for k in keys(map_val) {
            entries.push([k, map_val[k]])
        }
        entries
    },
    "map_from_entries" => {
        if typeof(array) != "array" { return {"error": f"expected array, got {typeof(array)}"} }
        let m = {}
        for pair in array {
            if typeof(pair) == "array" && len(pair) >= 2 {
                m[to_string(pair[0])] = pair[1]
            }
        }
        m
    },
    "map_merge" => {
        if typeof(a) != "map" || typeof(b) != "map" {
            return {"error": "map_merge requires two maps"}
        }
        let merged = {}
        for k in keys(a) { merged[k] = a[k] }
        for k in keys(b) { merged[k] = b[k] }
        merged
    },
    "map_update" => {
        if typeof(map_val) != "map" { return {"error": f"expected map, got {typeof(map_val)}"} }
        const k = if typeof(key) == "string" { key } else { to_string(key) }
        let new_map = {}
        for mk in keys(map_val) { new_map[mk] = map_val[mk] }
        new_map[k] = value
        new_map
    },
    "array_length" => {
        if typeof(array) != "array" { return {"error": f"expected array, got {typeof(array)}"} }
        len(array)
    },
    "array_push" => {
        if typeof(array) != "array" { return {"error": f"expected array, got {typeof(array)}"} }
        let new_arr = array
        new_arr.push(value)
        new_arr
    },
    "array_pop" => {
        if typeof(array) != "array" { return {"error": f"expected array, got {typeof(array)}"} }
        if len(array) == 0 { return null }
        array[len(array) - 1]
    },
    "array_shift" => {
        if typeof(array) != "array" { return {"error": f"expected array, got {typeof(array)}"} }
        if len(array) == 0 { return null }
        array[0]
    },
    "array_slice" => {
        if typeof(array) != "array" { return {"error": f"expected array, got {typeof(array)}"} }
        const start_v = inp_get_or(inputs, "input_1", inp_get_or(inputs, "start", 0))
        const end_v = inp_get(inputs, "input_2")
        const end_actual = if end_v == null { inp_get(inputs, "end") } else { end_v }
        const arr_len = len(array)
        let s = if typeof(start_v) == "int64" { start_v } else { 0 }
        if s < 0 { s = arr_len + s; if s < 0 { s = 0 } }
        if s > arr_len { s = arr_len }
        let e = if end_actual == null { arr_len } else { if typeof(end_actual) == "int64" { end_actual } else { arr_len } }
        if e < 0 { e = arr_len + e; if e < 0 { e = 0 } }
        if e > arr_len { e = arr_len }
        if s >= e { return [] }
        array.slice(s, e)
    },
    "array_sort" => {
        if typeof(array) != "array" { return {"error": f"expected array, got {typeof(array)}"} }
        sort(array)
    },
    "array_reverse" => {
        if typeof(array) != "array" { return {"error": f"expected array, got {typeof(array)}"} }
        reverse(array)
    },
    "array_contains" => {
        if typeof(array) != "array" { return {"error": f"expected array, got {typeof(array)}"} }
        for item in array {
            if item == value || eval_numeric_eq(item, value) { return true }
        }
        false
    },
    "array_join" => {
        if typeof(array) != "array" { return {"error": f"expected array, got {typeof(array)}"} }
        const sep = inp_get_or(inputs, "delimiter", inp_get_or(inputs, "separator", inp_get_or(inputs, "input_1", ",")))
        const sep_str = if typeof(sep) == "string" { sep } else { "," }
        let parts = []
        for item in array { parts.push(to_string(item)) }
        parts.join(sep_str)
    },
    "array_get" => {
        if typeof(array) != "array" { return {"error": f"expected array, got {typeof(array)}"} }
        const idx = inp_get_or(inputs, "index", 0)
        const i = if typeof(idx) == "int64" { idx } else { to_int64(idx) }
        if i < 0 || i >= len(array) { return null }
        array[i]
    },
    "array_set" => {
        if typeof(array) != "array" { return {"error": f"expected array, got {typeof(array)}"} }
        const idx = inp_get_or(inputs, "index", 0)
        const i = if typeof(idx) == "int64" { idx } else { to_int64(idx) }
        if i < 0 || i >= len(array) { return array }
        let new_arr = array
        new_arr[i] = value
        new_arr
    },
    "array_flatten" => {
        if typeof(array) != "array" { return {"error": f"expected array, got {typeof(array)}"} }
        let flat = []
        for item in array {
            if typeof(item) == "array" {
                for sub in item { flat.push(sub) }
            } else {
                flat.push(item)
            }
        }
        flat
    },
    "array_concat" => {
        if typeof(a) != "array" || typeof(b) != "array" {
            return {"error": "array_concat requires two arrays"}
        }
        let result = []
        for item in a { result.push(item) }
        for item in b { result.push(item) }
        result
    },
    "array_unique" => {
        if typeof(array) != "array" { return {"error": f"expected array, got {typeof(array)}"} }
        let seen = []
        for item in array {
            let found = false
            for s in seen {
                if s == item || eval_numeric_eq(s, item) { found = true; break }
            }
            if !found { seen.push(item) }
        }
        seen
    },
    "array_filter_nulls" => {
        if typeof(array) != "array" { return {"error": f"expected array, got {typeof(array)}"} }
        let result = []
        for item in array {
            if item != null { result.push(item) }
        }
        result
    },
    "array_insert" => {
        if typeof(array) != "array" { return {"error": f"expected array, got {typeof(array)}"} }
        const idx = inp_get_or(inputs, "index", 0)
        const i_raw = if typeof(idx) == "int64" { idx } else { 0 }
        const i_clamp = if i_raw < 0 { 0 } else { if i_raw > len(array) { len(array) } else { i_raw } }
        let new_arr = []
        let j = 0
        while j < i_clamp { new_arr.push(array[j]); j = j + 1 }
        new_arr.push(value)
        while j < len(array) { new_arr.push(array[j]); j = j + 1 }
        new_arr
    },
    "array_remove" => {
        if typeof(array) != "array" { return {"error": f"expected array, got {typeof(array)}"} }
        const idx = inp_get_or(inputs, "index", 0)
        const i_raw = if typeof(idx) == "int64" { idx } else { -1 }
        if i_raw < 0 || i_raw >= len(array) { return array }
        let new_arr = []
        let j = 0
        while j < len(array) {
            if j != i_raw { new_arr.push(array[j]) }
            j = j + 1
        }
        new_arr
    },
    "array_zip" => {
        if typeof(a) != "array" || typeof(b) != "array" {
            return {"error": "array_zip requires two arrays"}
        }
        const min_len = if len(a) < len(b) { len(a) } else { len(b) }
        let result = []
        let i = 0
        while i < min_len {
            result.push([a[i], b[i]])
            i = i + 1
        }
        result
    },
    "array_enumerate" => {
        if typeof(array) != "array" { return {"error": f"expected array, got {typeof(array)}"} }
        let result = []
        let i = 0
        while i < len(array) {
            result.push([i, array[i]])
            i = i + 1
        }
        result
    },
    "array_take" => {
        if typeof(array) != "array" { return {"error": f"expected array, got {typeof(array)}"} }
        const n = inp_get_or(inputs, "count", inp_get_or(inputs, "input_1", 0))
        const count = if typeof(n) == "int64" { n } else { 0 }
        if count <= 0 { return [] }
        const take_count = if count > len(array) { len(array) } else { count }
        array.slice(0, take_count)
    },
    "array_skip" => {
        if typeof(array) != "array" { return {"error": f"expected array, got {typeof(array)}"} }
        const n = inp_get_or(inputs, "count", inp_get_or(inputs, "input_1", 0))
        const count = if typeof(n) == "int64" { n } else { 0 }
        if count <= 0 { return array }
        if count >= len(array) { return [] }
        array.slice(count, len(array))
    },
    "array_chunk" => {
        if typeof(array) != "array" { return {"error": f"expected array, got {typeof(array)}"} }
        const sz = inp_get_or(inputs, "size", inp_get_or(inputs, "input_1", 1))
        const chunk_size = if typeof(sz) == "int64" && sz > 0 { sz } else { 1 }
        let chunks = []
        let i = 0
        while i < len(array) {
            const end = if i + chunk_size > len(array) { len(array) } else { i + chunk_size }
            chunks.push(array.slice(i, end))
            i = i + chunk_size
        }
        chunks
    },
    "array_window" => {
        if typeof(array) != "array" { return {"error": f"expected array, got {typeof(array)}"} }
        const sz = inp_get_or(inputs, "size", inp_get_or(inputs, "input_1", 2))
        const win_size = if typeof(sz) == "int64" && sz > 0 { sz } else { 2 }
        if win_size > len(array) { return [] }
        let windows = []
        let i = 0
        while i + win_size <= len(array) {
            windows.push(array.slice(i, i + win_size))
            i = i + 1
        }
        windows
    },
    "array_from_map" => {
        const m = inp_get_or(inputs, "map", null)
        if typeof(m) != "map" { return {"error": "array_from_map requires a map"} }
        let result = []
        for k in keys(m) { result.push([k, m[k]]) }
        result
    },
    "length" => {
        if typeof(input) != "string" { return {"error": f"expected string, got {typeof(input)}"} }
        len(input)
    },
    "split" => {
        const delim = inp_get_or(inputs, "delimiter", null)
        if typeof(input) != "string" { return {"error": f"expected string, got {typeof(input)}"} }
        if typeof(delim) != "string" { return {"error": "split requires string delimiter"} }
        input.split(delim)
    },
    "contains" => {
        const search = inp_get_or(inputs, "search", null)
        if typeof(input) != "string" || typeof(search) != "string" {
            return {"error": "contains requires string input and search"}
        }
        input.contains(search)
    },
    "replace" => {
        const search = inp_get_or(inputs, "search", null)
        const repl = inp_get_or(inputs, "replace", null)
        if typeof(input) != "string" { return {"error": f"expected string, got {typeof(input)}"} }
        if typeof(search) != "string" || typeof(repl) != "string" {
            return {"error": "replace requires string search and replace"}
        }
        input.replace(search, repl)
    },
    "trim" => {
        if typeof(input) != "string" { return {"error": f"expected string, got {typeof(input)}"} }
        input.trim()
    },
    "trim_start" => {
        if typeof(input) != "string" { return {"error": f"expected string, got {typeof(input)}"} }
        input.trim_start()
    },
    "trim_end" => {
        if typeof(input) != "string" { return {"error": f"expected string, got {typeof(input)}"} }
        input.trim_end()
    },
    "to_upper" => {
        if typeof(input) != "string" { return {"error": f"expected string, got {typeof(input)}"} }
        input.to_upper()
    },
    "to_lower" => {
        if typeof(input) != "string" { return {"error": f"expected string, got {typeof(input)}"} }
        input.to_lower()
    },
    "starts_with" => {
        const prefix = inp_get_or(inputs, "prefix", null)
        if typeof(input) != "string" || typeof(prefix) != "string" { return false }
        starts_with(input, prefix)
    },
    "ends_with" => {
        const suffix = inp_get_or(inputs, "suffix", null)
        if typeof(input) != "string" || typeof(suffix) != "string" { return false }
        ends_with(input, suffix)
    },
    "substring" => {
        if typeof(input) != "string" { return {"error": f"expected string, got {typeof(input)}"} }
        const start_v = inp_get_or(inputs, "input_1", inp_get_or(inputs, "start", 0))
        const end_v = inp_get(inputs, "input_2")
        const end_actual = if end_v == null { inp_get(inputs, "end") } else { end_v }
        const s_len = len(input)
        let s = if typeof(start_v) == "int64" { start_v } else { 0 }
        if s < 0 { s = s_len + s; if s < 0 { s = 0 } }
        if s > s_len { s = s_len }
        let e = if end_actual == null { s_len } else { if typeof(end_actual) == "int64" { end_actual } else { s_len } }
        if e < 0 { e = s_len + e; if e < 0 { e = 0 } }
        if e > s_len { e = s_len }
        if s >= e { return "" }
        input.slice(s, e)
    },
    "index_of" => {
        const search = inp_get_or(inputs, "search", null)
        if typeof(input) != "string" || typeof(search) != "string" { return null }
        input.index_of(search)
    },
    "string_chars" => {
        if typeof(input) != "string" { return {"error": f"expected string, got {typeof(input)}"} }
        let chars = []
        let i = 0
        while i < len(input) {
            chars.push(input.slice(i, i + 1))
            i = i + 1
        }
        chars
    },
    "string_repeat" => {
        if typeof(input) != "string" { return {"error": f"expected string, got {typeof(input)}"} }
        const count = inp_get_or(inputs, "count", inp_get_or(inputs, "input_1", 0))
        const n = if typeof(count) == "int64" { count } else { 0 }
        if n <= 0 { return "" }
        let result = ""
        let i = 0
        while i < n { result = result + input; i = i + 1 }
        result
    },
    "string_lines" => {
        if typeof(input) != "string" { return {"error": f"expected string, got {typeof(input)}"} }
        input.split("\n")
    },
    "string_words" => {
        if typeof(input) != "string" { return {"error": f"expected string, got {typeof(input)}"} }
        let words = []
        const parts = input.split(" ")
        for p in parts {
            const trimmed = p.trim()
            if len(trimmed) > 0 { words.push(trimmed) }
        }
        words
    },
    "string_reverse" => {
        if typeof(input) != "string" { return {"error": f"expected string, got {typeof(input)}"} }
        reverse(input)
    },
    "string_count" => {
        const search = inp_get_or(inputs, "search", inp_get_or(inputs, "input_1", null))
        if typeof(input) != "string" || typeof(search) != "string" {
            return {"error": "string_count requires string input and search"}
        }
        if len(search) == 0 { return {"error": "search string must not be empty"} }
        let count = 0
        let idx = 0
        while true {
            const pos = input.slice(idx, len(input)).index_of(search)
            if pos == null || pos < 0 { break }
            count = count + 1
            idx = idx + pos + len(search)
        }
        count
    },
    "char_at" => {
        if typeof(input) != "string" { return {"error": f"expected string, got {typeof(input)}"} }
        const idx = inp_get_or(inputs, "index", inp_get_or(inputs, "input_1", 0))
        const i = if typeof(idx) == "int64" { idx } else { 0 }
        if i < 0 || i >= len(input) { return null }
        input.slice(i, i + 1)
    },
    "pad_start" => {
        if typeof(input) != "string" { return {"error": f"expected string, got {typeof(input)}"} }
        const width = inp_get_or(inputs, "width", inp_get_or(inputs, "input_1", 0))
        const fill = inp_get_or(inputs, "fill", inp_get_or(inputs, "input_2", " "))
        const w = if typeof(width) == "int64" { width } else { 0 }
        const pad_str = if typeof(fill) == "string" && len(fill) > 0 { fill } else { " " }
        if len(input) >= w { return input }
        const pad_count = w - len(input)
        let padding = ""
        let i = 0
        while len(padding) < pad_count {
            padding = padding + pad_str.slice(i % len(pad_str), i % len(pad_str) + 1)
            i = i + 1
        }
        padding.slice(0, pad_count) + input
    },
    "pad_end" => {
        if typeof(input) != "string" { return {"error": f"expected string, got {typeof(input)}"} }
        const width = inp_get_or(inputs, "width", inp_get_or(inputs, "input_1", 0))
        const fill = inp_get_or(inputs, "fill", inp_get_or(inputs, "input_2", " "))
        const w = if typeof(width) == "int64" { width } else { 0 }
        const pad_str = if typeof(fill) == "string" && len(fill) > 0 { fill } else { " " }
        if len(input) >= w { return input }
        const pad_count = w - len(input)
        let padding = ""
        let i = 0
        while len(padding) < pad_count {
            padding = padding + pad_str.slice(i % len(pad_str), i % len(pad_str) + 1)
            i = i + 1
        }
        input + padding.slice(0, pad_count)
    },
    "string_join" => {
        const arr_val = inp_get_or(inputs, "array", null)
        const sep = inp_get_or(inputs, "separator", inp_get_or(inputs, "delimiter", inp_get_or(inputs, "input_1", "")))
        if typeof(arr_val) != "array" { return {"error": "string_join requires array"} }
        let parts = []
        for item in arr_val { parts.push(to_string(item)) }
        const sep_str = if typeof(sep) == "string" { sep } else { "" }
        parts.join(sep_str)
    },
    "string_template" | "string_format" => {
        const tmpl = inp_get_or(inputs, "template", null)
        const vals = inp_get_or(inputs, "values", null)
        if typeof(tmpl) != "string" { return {"error": "template must be a string"} }
        let result = tmpl
        if typeof(vals) == "map" {
            for k in keys(vals) {
                result = result.replace("{" + k + "}", to_string(vals[k]))
            }
        } else if typeof(vals) == "array" {
            let i = 0
            for v in vals {
                result = result.replace("{" + to_string(i) + "}", to_string(v))
                i = i + 1
            }
        }
        result
    },
    "typeof" => {
        const t = typeof(input)
        if t == "map" {
            if input.has("__enum") { return "enum" }
            if input.has("__struct") { return "struct" }
        }
        t
    },
    "to_int64" => {
        const t = typeof(input)
        if t == "int64" { return input }
        if t == "float64" { return to_int64(input) }
        if t == "string" { return parse_int(input) }
        if t == "bool" { return if input { 1 } else { 0 } }
        null
    },
    "to_float64" => {
        const t = typeof(input)
        if t == "float64" { return input }
        if t == "int64" { return to_float64(input) }
        if t == "string" { return parse_float(input) }
        if t == "bool" { return if input { 1.0 } else { 0.0 } }
        null
    },
    "to_bool" => {
        to_bool(input)
    },
    "is_null" => input == null,
    "is_string" => typeof(input) == "string",
    "is_number" => eval_is_numeric(input),
    "is_array" => typeof(input) == "array",
    "is_map" => typeof(input) == "map",
    "is_bool" => typeof(input) == "bool",
    "is_bytes" => typeof(input) == "bytes",
    "abs" => {
        if typeof(input) == "int64" { return if input < 0 { -input } else { input } }
        if typeof(input) == "float64" { return if input < 0.0 { -input } else { input } }
        {"error": f"expected number, got {typeof(input)}"}
    },
    "round" => {
        if typeof(input) == "float64" { return round(input) }
        if typeof(input) == "int64" { return input }
        {"error": f"expected number, got {typeof(input)}"}
    },
    "floor" => {
        if typeof(input) == "float64" { return floor(input) }
        if typeof(input) == "int64" { return input }
        {"error": f"expected number, got {typeof(input)}"}
    },
    "ceil" => {
        if typeof(input) == "float64" { return ceil(input) }
        if typeof(input) == "int64" { return input }
        {"error": f"expected number, got {typeof(input)}"}
    },
    "sqrt" => {
        const f = eval_to_f64(input)
        if f == null { return {"error": f"expected number, got {typeof(input)}"} }
        sqrt(f)
    },
    "cbrt" => {
        const f = eval_to_f64(input)
        if f == null { return {"error": f"expected number, got {typeof(input)}"} }
        cbrt(f)
    },
    "hypot" => {
        const fa = eval_to_f64(a)
        const fb = eval_to_f64(b)
        if fa == null || fb == null { return {"error": "hypot requires two numbers"} }
        sqrt(fa * fa + fb * fb)
    },
    "power" => {
        const fa = eval_to_f64(a)
        const fb = eval_to_f64(b)
        if fa == null || fb == null { return {"error": "power requires two numbers"} }
        pow(fa, fb)
    },
    "sin" => { const f = eval_to_f64(input); if f == null { return {"error": "expected number"} }; sin(f) },
    "cos" => { const f = eval_to_f64(input); if f == null { return {"error": "expected number"} }; cos(f) },
    "tan" => { const f = eval_to_f64(input); if f == null { return {"error": "expected number"} }; tan(f) },
    "asin" => { const f = eval_to_f64(input); if f == null { return {"error": "expected number"} }; asin(f) },
    "acos" => { const f = eval_to_f64(input); if f == null { return {"error": "expected number"} }; acos(f) },
    "atan" => { const f = eval_to_f64(input); if f == null { return {"error": "expected number"} }; atan(f) },
    "atan2" => {
        const fy = eval_to_f64(a)
        const fx = eval_to_f64(b)
        if fy == null || fx == null { return {"error": "atan2 requires two numbers"} }
        atan2(fy, fx)
    },
    "sinh" => { const f = eval_to_f64(input); if f == null { return {"error": "expected number"} }; sinh(f) },
    "cosh" => { const f = eval_to_f64(input); if f == null { return {"error": "expected number"} }; cosh(f) },
    "tanh" => { const f = eval_to_f64(input); if f == null { return {"error": "expected number"} }; tanh(f) },
    "ln" => { const f = eval_to_f64(input); if f == null { return {"error": "expected number"} }; ln(f) },
    "log2" => { const f = eval_to_f64(input); if f == null { return {"error": "expected number"} }; log2(f) },
    "log10" => { const f = eval_to_f64(input); if f == null { return {"error": "expected number"} }; log10(f) },
    "exp" => { const f = eval_to_f64(input); if f == null { return {"error": "expected number"} }; exp(f) },
    "log" => {
        const base_v = inp_get_or(inputs, "base", inp_get_or(inputs, "input_1", null))
        const fv = eval_to_f64(input)
        const fb = eval_to_f64(base_v)
        if fv == null || fb == null { return {"error": "log requires numeric args"} }
        if fb <= 0.0 || fb == 1.0 { return 0.0 / 0.0 }
        ln(fv) / ln(fb)
    },
    "sign" => {
        if typeof(input) == "int64" {
            if input > 0 { return 1 }
            if input < 0 { return -1 }
            return 0
        }
        if typeof(input) == "float64" {
            if input > 0.0 { return 1.0 }
            if input < 0.0 { return -1.0 }
            return 0.0
        }
        {"error": f"expected number, got {typeof(input)}"}
    },
    "min" => {
        const fa = eval_to_f64(a)
        const fb = eval_to_f64(b)
        if fa == null || fb == null { return {"error": "min requires two numbers"} }
        if fa <= fb { a } else { b }
    },
    "max" => {
        const fa = eval_to_f64(a)
        const fb = eval_to_f64(b)
        if fa == null || fb == null { return {"error": "max requires two numbers"} }
        if fa >= fb { a } else { b }
    },
    "clamp" => {
        const min_v = inp_get_or(inputs, "min", inp_get_or(inputs, "input_1", null))
        const max_v = inp_get_or(inputs, "max", inp_get_or(inputs, "input_2", null))
        const fv = eval_to_f64(input)
        const fmin = eval_to_f64(min_v)
        const fmax = eval_to_f64(max_v)
        if fv == null || fmin == null || fmax == null { return {"error": "clamp requires numeric args"} }
        if fv < fmin { return min_v }
        if fv > fmax { return max_v }
        input
    },
    "lerp" => {
        const t_val = inp_get_or(inputs, "t", inp_get_or(inputs, "input_2", null))
        const fa = eval_to_f64(a)
        const fb = eval_to_f64(b)
        const ft = eval_to_f64(t_val)
        if fa == null || fb == null || ft == null { return {"error": "lerp requires numeric args"} }
        fa + (fb - fa) * ft
    },
    "approx_eq" => {
        const eps = inp_get_or(inputs, "epsilon", inp_get_or(inputs, "input_2", 0.0000000001))
        const fa = eval_to_f64(a)
        const fb = eval_to_f64(b)
        const feps = eval_to_f64(eps)
        if fa == null || fb == null { return false }
        const diff = fa - fb
        const abs_diff = if diff < 0.0 { -diff } else { diff }
        abs_diff <= (if feps != null { feps } else { 0.0000000001 })
    },
    "to_radians" => {
        const f = eval_to_f64(input)
        if f == null { return {"error": "expected number"} }
        f * 3.14159265358979323846 / 180.0
    },
    "to_degrees" => {
        const f = eval_to_f64(input)
        if f == null { return {"error": "expected number"} }
        f * 180.0 / 3.14159265358979323846
    },
    "is_nan" => {
        if typeof(input) == "float64" { return input != input }
        false
    },
    "is_infinite" => {
        if typeof(input) == "float64" {
            return input == 1.0 / 0.0 || input == -1.0 / 0.0
        }
        false
    },
    "is_finite" => {
        if typeof(input) == "float64" {
            const inf = 1.0 / 0.0
            return input != inf && input != -inf && input == input
        }
        if eval_is_numeric(input) { return true }
        false
    },
    "gcd" => {
        const ia = eval_to_i64_checked(a)
        const ib = eval_to_i64_checked(b)
        if ia == null || ib == null { return {"error": "gcd requires integers"} }
        let ax = if ia < 0 { -ia } else { ia }
        let ay = if ib < 0 { -ib } else { ib }
        while ay != 0 {
            const t = ay
            ay = ax % ay
            ax = t
        }
        ax
    },
    "lcm" => {
        const ia = eval_to_i64_checked(a)
        const ib = eval_to_i64_checked(b)
        if ia == null || ib == null { return {"error": "lcm requires integers"} }
        if ia == 0 || ib == 0 { return 0 }
        let ax = if ia < 0 { -ia } else { ia }
        let ay = if ib < 0 { -ib } else { ib }
        let gx = ax
        let gy = ay
        while gy != 0 {
            const t = gy
            gy = gx % gy
            gx = t
        }
        (ax / gx) * ay
    },
    "coalesce" => if a != null { a } else { b },
    "default" => {
        const fallback = inp_get_or(inputs, "fallback", null)
        if input != null { input } else { fallback }
    },
    "error" => {
        const msg = inp_get_or(inputs, "message", "error")
        {"error": to_string(msg)}
    },
    "range" => {
        const start = inp_get_or(inputs, "start", inp_get_or(inputs, "a", 0))
        const end_v = inp_get_or(inputs, "end", inp_get_or(inputs, "b", 0))
        const inclusive = inp_get_or(inputs, "inclusive", false)
        const step = inp_get_or(inputs, "step", if start <= end_v { 1 } else { -1 })
        if step == 0 { return [] }
        let result = []
        let i = start
        while true {
            if inclusive {
                if step > 0 && i > end_v { break }
                if step < 0 && i < end_v { break }
            } else {
                if step > 0 && i >= end_v { break }
                if step < 0 && i <= end_v { break }
            }
            if len(result) >= MAX_ARRAY_ELEMENTS { break }
            result.push(i)
            i = i + step
        }
        result
    },
    "bit_and" => {
        const ia = eval_to_i64_checked(a)
        const ib = eval_to_i64_checked(b)
        if ia == null || ib == null { return {"error": "bit_and requires integers"} }
        bit_and(ia, ib)
    },
    "bit_or" => {
        const ia = eval_to_i64_checked(a)
        const ib = eval_to_i64_checked(b)
        if ia == null || ib == null { return {"error": "bit_or requires integers"} }
        bit_or(ia, ib)
    },
    "bit_xor" => {
        const ia = eval_to_i64_checked(a)
        const ib = eval_to_i64_checked(b)
        if ia == null || ib == null { return {"error": "bit_xor requires integers"} }
        bit_xor(ia, ib)
    },
    "bit_not" => {
        const iv = eval_to_i64_checked(input)
        if iv == null { return {"error": "bit_not requires integer"} }
        bit_not(iv)
    },
    "bit_shift_left" => {
        const ia = eval_to_i64_checked(a)
        const ib = eval_to_i64_checked(b)
        if ia == null || ib == null { return {"error": "bit_shift_left requires integers"} }
        if ib < 0 || ib >= 64 { return {"error": f"shift amount out of range: {ib}"} }
        bit_shl(ia, ib)
    },
    "bit_shift_right" => {
        const ia = eval_to_i64_checked(a)
        const ib = eval_to_i64_checked(b)
        if ia == null || ib == null { return {"error": "bit_shift_right requires integers"} }
        if ib < 0 || ib >= 64 { return {"error": f"shift amount out of range: {ib}"} }
        bit_shr(ia, ib)
    },
    "assert" => {
        const condition = inp_get_or(inputs, "condition", input)
        const msg = inp_get_or(inputs, "message", "Assertion failed")
        if to_bool(condition) { null }
        else { {"error": to_string(msg)} }
    },
    "debug_log" => {
        println(f"[debug] {to_string(input)}")
        null
    },
    "to_json" => to_json(input),
    "parse_json" => {
        if typeof(input) != "string" { return {"error": f"expected string, got {typeof(input)}"} }
        parse_json(input)
    },
    "parse_int" => {
        if typeof(input) != "string" { return {"error": f"expected string, got {typeof(input)}"} }
        const result = parse_int(input.trim())
        if result == null { return null }
        result
    },
    "parse_float" => {
        if typeof(input) != "string" { return {"error": f"expected string, got {typeof(input)}"} }
        const result = parse_float(input.trim())
        if result == null { return null }
        result
    },
    "char_from_code" => {
        const code = eval_to_i64_checked(input)
        if code == null { return {"error": "expected integer"} }
        char_from_code(code)
    },
    "char_code" => {
        if typeof(input) != "string" || len(input) == 0 { return {"error": "expected non-empty string"} }
        char_code(input.slice(0, 1))
    },
    "bytes_length" => {
        if typeof(input) != "bytes" { return {"error": f"expected bytes, got {typeof(input)}"} }
        len(input)
    },
    "bytes_slice" => {
