        }
        fs_copy(src, dst)
        true
    },
    "fs_move" => {
        const src = inp_get_or(inputs, "source", null)
        const dst = inp_get_or(inputs, "destination", null)
        if typeof(src) != "string" || typeof(dst) != "string" {
            return {"error": "fs_move requires string paths"}
        }
        fs_move(src, dst)
        true
    },
    "fs_chmod" | "fs_symlink" | "fs_readlink" => {
        // Delegate to stage-0 host
        const path = inp_get_or(inputs, "path", null)
        if typeof(path) != "string" { return {"error": f"{op_name} requires string path"} }
        null // stage-0 handles
    },

    // ── Environment / OS ────────────────────────────────────────

    "env_get" => {
        const name = inp_get_or(inputs, "name", null)
        if typeof(name) != "string" { return null }
        env_get(name)
    },
    "env_has" => {
        const name = inp_get_or(inputs, "name", null)
        if typeof(name) != "string" { return false }
        env_get(name) != null
    },
    "env_keys" => env_keys(),
    "os_name" => os_name(),
    "os_arch" => os_arch(),
    "process_pid" => process_pid(),
    "current_dir" => current_dir(),

    // ── Path operations ─────────────────────────────────────────

    "path_join" => {
        if typeof(a) != "string" || typeof(b) != "string" {
            return {"error": "path_join requires two strings"}
        }
        path_join(a, b)
    },
    "path_basename" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        path_basename(input)
    },
    "path_dirname" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        path_dirname(input)
    },
    "path_extension" => {
        if typeof(input) != "string" { return "" }
        path_extension(input)
    },
    "path_stem" => {
        if typeof(input) != "string" { return "" }
        path_stem(input)
    },
    "path_is_absolute" => {
        if typeof(input) != "string" { return false }
        starts_with(input, "/")
    },
    "path_parent" => {
        if typeof(input) != "string" { return "." }
        path_dirname(input)
    },
    "path_normalize" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        path_normalize(input)
    },
    "path_split" => {
        if typeof(input) != "string" { return [] }
        input.split("/")
    },
    "path_with_extension" => {
        const ext = inp_get_or(inputs, "extension", inp_get_or(inputs, "input_1", null))
        if typeof(input) != "string" || typeof(ext) != "string" { return input }
        path_with_extension(input, ext)
    },

    // ── Timestamp operations ────────────────────────────────────

    "now_timestamp" => now_timestamp(),
    "format_timestamp" => {
        const ms = eval_to_i64_checked(input)
        if ms == null { return {"error": "expected numeric timestamp"} }
        format_timestamp(ms)
    },
    "sleep" => {
        const duration = inp_get_or(inputs, "duration", input)
        const ms = eval_to_i64_checked(duration)
        if ms != null && ms > 0 { sleep(ms) }
        null
    },
    "timestamp_diff" => {
        const fa = eval_to_i64_checked(a)
        const fb = eval_to_i64_checked(b)
        if fa == null || fb == null { return {"error": "timestamp_diff requires numbers"} }
        fa - fb
    },
    "timestamp_add" => {
        const amount = inp_get_or(inputs, "amount", null)
        const ft = eval_to_i64_checked(input)
        const fa = eval_to_i64_checked(amount)
        if ft == null || fa == null { return {"error": "timestamp_add requires numbers"} }
        ft + fa
    },
    "parse_timestamp" => {
        if typeof(input) != "string" { return {"error": f"expected string, got {typeof(input)}"} }
        parse_timestamp(input)
    },
    "duration" => {
        const unit = inp_get_or(inputs, "unit", "ms")
        const val = eval_to_i64_checked(input)
        if val == null { return {"error": "expected number"} }
        match unit {
            "ms" => val,
            "s" | "sec" | "second" | "seconds" => val * 1000,
            "m" | "min" | "minute" | "minutes" => val * 60000,
            "h" | "hour" | "hours" => val * 3600000,
            "d" | "day" | "days" => val * 86400000,
            _ => val
        }
    },
    "elapsed" => {
        const start = eval_to_i64_checked(input)
        if start == null { return {"error": "expected timestamp"} }
        now_timestamp() - start
    },
    "time_sleep" => {
        const ms = eval_to_i64_checked(input)
        if ms != null && ms > 0 { sleep(ms) }
        null
    },
    "add_duration" => {
        const ft = eval_to_i64_checked(a)
        const fd = eval_to_i64_checked(b)
        if ft == null || fd == null { return {"error": "requires numbers"} }
        ft + fd
    },
    "sub_duration" => {
        const ft = eval_to_i64_checked(a)
        const fd = eval_to_i64_checked(b)
        if ft == null || fd == null { return {"error": "requires numbers"} }
        ft - fd
    },
    "time_diff" => {
        const ft = eval_to_i64_checked(a)
        const fd = eval_to_i64_checked(b)
        if ft == null || fd == null { return {"error": "requires numbers"} }
        if ft > fd { ft - fd } else { fd - ft }
    },
    "start_of" | "end_of" => {
        // Simplified: return the timestamp unchanged
        eval_to_i64_checked(input)
    },

    // ── Format operations ───────────────────────────────────────

    "fmt_number" => {
        const f = eval_to_f64(input)
        if f == null { return to_string(input) }
        to_string(f)
    },
    "fmt_hex" => {
        const i = eval_to_i64_checked(input)
        if i == null { return {"error": "expected integer"} }
        fmt_hex(i)
    },
    "fmt_binary" => {
        const i = eval_to_i64_checked(input)
        if i == null { return {"error": "expected integer"} }
        fmt_binary(i)
    },
    "fmt_percent" => {
        const f = eval_to_f64(input)
        if f == null { return {"error": "expected number"} }
        to_string(round(f * 10000.0) / 100.0) + "%"
    },
    "fmt_bytes" => {
        const n = eval_to_i64_checked(input)
        if n == null { return {"error": "expected number"} }
        if n < 1024 { return f"{n} B" }
        if n < 1048576 { return f"{n / 1024} KB" }
        if n < 1073741824 { return f"{n / 1048576} MB" }
        f"{n / 1073741824} GB"
    },
    "fmt_duration" => {
        const ms = eval_to_i64_checked(input)
        if ms == null { return {"error": "expected number"} }
        format_elapsed(ms)
    },

    // ── Text operations ─────────────────────────────────────────

    "text_slug" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        text_slug(input)
    },
    "text_camel_case" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        text_camel_case(input)
    },
    "text_snake_case" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        text_snake_case(input)
    },
    "text_title_case" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        text_title_case(input)
    },
    "text_wrap" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        const width = inp_get_or(inputs, "width", inp_get_or(inputs, "input_1", 80))
        text_wrap(input, width)
    },
    "text_truncate" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        const max_len = inp_get_or(inputs, "max_length", inp_get_or(inputs, "input_1", 80))
        const suffix = inp_get_or(inputs, "suffix", "...")
        if len(input) <= max_len { input }
        else { input.slice(0, max_len - len(suffix)) + suffix }
    },
    "text_indent" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        const prefix = inp_get_or(inputs, "prefix", inp_get_or(inputs, "input_1", "  "))
        const lines = input.split("\n")
        let result = []
        for line in lines { result.push(prefix + line) }
        result.join("\n")
    },
    "text_dedent" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        text_dedent(input)
    },
    "text_pad_left" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        const width = inp_get_or(inputs, "width", inp_get_or(inputs, "input_1", 0))
        const fill = inp_get_or(inputs, "fill", " ")
        const w = if typeof(width) == "int64" { width } else { 0 }
        if len(input) >= w { return input }
        op_string_repeat(fill, w - len(input)) + input
    },
    "text_pad_right" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        const width = inp_get_or(inputs, "width", inp_get_or(inputs, "input_1", 0))
        const fill = inp_get_or(inputs, "fill", " ")
        const w = if typeof(width) == "int64" { width } else { 0 }
        if len(input) >= w { return input }
        input + op_string_repeat(fill, w - len(input))
    },

    // ── HTML escape/unescape ────────────────────────────────────

    "html_escape" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        html_escape(input)
    },
    "html_unescape" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        html_unescape(input)
    },

    // ── Reflect operations ──────────────────────────────────────

    "reflect_type_of" | "reflect_type_name" => typeof(input),
    "reflect_is_type" => {
        const type_name = inp_get_or(inputs, "type_name", inp_get_or(inputs, "input_1", null))
        if typeof(type_name) != "string" { return false }
        typeof(input) == type_name
    },
    "reflect_fields" => {
        if typeof(input) != "map" { return [] }
        keys(input)
    },
    "reflect_has_field" => {
        const field = inp_get_or(inputs, "field", inp_get_or(inputs, "input_1", null))
        if typeof(input) != "map" || typeof(field) != "string" { return false }
        input.has(field)
    },
    "reflect_callable" => {
        // In self-hosted, check if the name is a known function/operation
        const name = inp_get_or(inputs, "name", null)
        typeof(name) == "string" && len(name) > 0
    },
    "reflect_arity" => 0,
    "reflect_inspect" => to_string(input),

    // ── Control flow (handled by interpreter, stubs here) ───────

    "if_else" | "switch" | "try_catch" => null,
    "function_def" | "function_call" | "async_spawn" | "async_await" | "loop_group" => null,
    "reduce" => null,

    // ── UUID operations ─────────────────────────────────────────

    "uuid_v4" => random_uuid(),
    "uuid_nil" => "00000000-0000-0000-0000-000000000000",
    "uuid_is_valid" => {
        if typeof(input) != "string" { return false }
        uuid_is_valid(input)
    },
    "uuid_parse" => {
        if typeof(input) != "string" { return null }
        uuid_parse(input)
    },

    // ── Sort operations ─────────────────────────────────────────

    "sort_asc" => {
        if typeof(array) != "array" { return {"error": "expected array"} }
        sort(array)
    },
    "sort_desc" => {
        if typeof(array) != "array" { return {"error": "expected array"} }
        reverse(sort(array))
    },
    "sort_reverse" => {
        if typeof(array) != "array" { return {"error": "expected array"} }
        reverse(array)
    },
    "stable_sort" => {
        if typeof(array) != "array" { return {"error": "expected array"} }
        sort(array)
    },
    "is_sorted" => {
        if typeof(array) != "array" { return false }
        let i = 0
        while i < len(array) - 1 {
            if eval_num_cmp(array[i], array[i + 1]) > 0 { return false }
            i = i + 1
        }
        true
    },
    "binary_search" => {
        if typeof(array) != "array" { return -1 }
        binary_search(array, value)
    },
    "sort_by" | "sort_by_key" => {
        // Higher-order ops handled by interpreter
        null
    },

    // ── Set operations ──────────────────────────────────────────

    "set_from" => {
        if typeof(array) != "array" { return {"error": "expected array"} }
        // Deduplicate
        let seen = []
        for item in array {
            let found = false
            for s in seen { if s == item { found = true; break } }
            if !found { seen.push(item) }
        }
        seen
    },
    "set_union" => {
        if typeof(a) != "array" || typeof(b) != "array" {
            return {"error": "set_union requires two arrays"}
        }
        let result = []
        for item in a { result.push(item) }
        for item in b {
            let found = false
            for r in result { if r == item { found = true; break } }
            if !found { result.push(item) }
        }
        result
    },
    "set_intersection" => {
        if typeof(a) != "array" || typeof(b) != "array" {
            return {"error": "set_intersection requires two arrays"}
        }
        let result = []
        for item in a {
            for other in b {
                if item == other { result.push(item); break }
            }
        }
        result
    },
    "set_difference" => {
        if typeof(a) != "array" || typeof(b) != "array" {
            return {"error": "set_difference requires two arrays"}
        }
        let result = []
        for item in a {
            let found = false
            for other in b { if item == other { found = true; break } }
            if !found { result.push(item) }
        }
        result
    },
    "set_symmetric_difference" => {
        if typeof(a) != "array" || typeof(b) != "array" {
            return {"error": "set_symmetric_difference requires two arrays"}
        }
        let result = []
        for item in a {
            let found = false
            for other in b { if item == other { found = true; break } }
            if !found { result.push(item) }
        }
        for item in b {
            let found = false
            for other in a { if item == other { found = true; break } }
            if !found { result.push(item) }
        }
        result
    },

    // ── Counter / MostCommon / OrderedMap ────────────────────────

    "counter" => {
        if typeof(array) != "array" { return {"error": "expected array"} }
        let counts = {}
        for item in array {
            const k = to_string(item)
            if counts.has(k) { counts[k] = counts[k] + 1 }
            else { counts[k] = 1 }
        }
        counts
    },
    "most_common" => {
        if typeof(array) != "array" { return {"error": "expected array"} }
        let counts = {}
        for item in array {
            const k = to_string(item)
            if counts.has(k) { counts[k] = counts[k] + 1 }
            else { counts[k] = 1 }
        }
        let best_key = null
        let best_count = 0
        for k in keys(counts) {
            if counts[k] > best_count { best_key = k; best_count = counts[k] }
        }
        best_key
    },
    "ordered_map" => {
        // Convert array of [key, value] pairs to ordered map
        if typeof(array) != "array" { return {} }
        let m = {}
        for pair in array {
            if typeof(pair) == "array" && len(pair) >= 2 {
                m[to_string(pair[0])] = pair[1]
            }
        }
        m
    },

    // ── Statistics operations ────────────────────────────────────

    "stats_sum" | "math_sum" => {
        const arr = inp_get_or(inputs, "array", null)
        if typeof(arr) != "array" { return {"error": "expected array"} }
        let total = 0
        let has_float = false
        let float_total = 0.0
        for item in arr {
            if typeof(item) == "float64" {
                if !has_float { has_float = true; float_total = to_float64(total) }
                float_total = float_total + item
            } else if eval_is_numeric(item) {
                if has_float { float_total = float_total + to_float64(item) }
                else { total = total + item }
            }
        }
        if has_float { float_total } else { total }
    },
    "stats_mean" | "math_average" => {
        const arr = inp_get_or(inputs, "array", null)
        if typeof(arr) != "array" || len(arr) == 0 { return 0.0 / 0.0 }
        let sum = 0.0
        for item in arr {
            const f = eval_to_f64(item)
            if f != null { sum = sum + f }
        }
        sum / to_float64(len(arr))
    },
    "stats_median" => {
        const arr = inp_get_or(inputs, "array", null)
        if typeof(arr) != "array" || len(arr) == 0 { return 0.0 / 0.0 }
        const sorted = sort(arr)
        const n = len(sorted)
        if n % 2 == 1 {
            eval_to_f64(sorted[n / 2])
        } else {
            const fa = eval_to_f64(sorted[n / 2 - 1])
            const fb = eval_to_f64(sorted[n / 2])
            if fa != null && fb != null { (fa + fb) / 2.0 } else { 0.0 }
        }
    },
    "stats_mode" => {
        const arr = inp_get_or(inputs, "array", null)
        if typeof(arr) != "array" || len(arr) == 0 { return null }
        let counts = {}
        for item in arr {
            const k = to_string(item)
            if counts.has(k) { counts[k] = counts[k] + 1 }
            else { counts[k] = 1 }
        }
        let best = null
        let best_count = 0
        let idx = 0
        for item in arr {
            const k = to_string(item)
            if counts[k] > best_count { best = item; best_count = counts[k] }
        }
        best
    },
    "stats_variance" => {
        const arr = inp_get_or(inputs, "array", null)
        if typeof(arr) != "array" || len(arr) == 0 { return 0.0 }
        let sum = 0.0
        for item in arr { const f = eval_to_f64(item); if f != null { sum = sum + f } }
        const mean = sum / to_float64(len(arr))
        let var_sum = 0.0
        for item in arr {
            const f = eval_to_f64(item)
            if f != null { const diff = f - mean; var_sum = var_sum + diff * diff }
        }
        var_sum / to_float64(len(arr))
    },
    "stats_std_dev" => {
        const arr = inp_get_or(inputs, "array", null)
        if typeof(arr) != "array" || len(arr) == 0 { return 0.0 }
        let sum = 0.0
        for item in arr { const f = eval_to_f64(item); if f != null { sum = sum + f } }
        const mean = sum / to_float64(len(arr))
        let var_sum = 0.0
        for item in arr {
            const f = eval_to_f64(item)
            if f != null { const diff = f - mean; var_sum = var_sum + diff * diff }
        }
        sqrt(var_sum / to_float64(len(arr)))
    },
    "stats_percentile" | "stats_quantile" => {
        const arr = inp_get_or(inputs, "array", null)
        const p = inp_get_or(inputs, "percentile", inp_get_or(inputs, "quantile", inp_get_or(inputs, "input_1", 0.5)))
        if typeof(arr) != "array" || len(arr) == 0 { return null }
        const sorted = sort(arr)
        const pf = eval_to_f64(p)
        if pf == null { return null }
        const pv = if op_name == "stats_percentile" { pf / 100.0 } else { pf }
        const idx = to_int64(pv * to_float64(len(sorted) - 1))
        if idx < 0 { return sorted[0] }
        if idx >= len(sorted) { return sorted[len(sorted) - 1] }
        sorted[idx]
    },
    "stats_min_by" | "stats_max_by" | "stats_covariance" | "stats_correlation" => {
        // Complex stats ops - simplified
        null
    },
    "math_product" => {
        const arr = inp_get_or(inputs, "array", null)
        if typeof(arr) != "array" { return {"error": "expected array"} }
        let product = 1
        let has_float = false
        let float_product = 1.0
        for item in arr {
            if typeof(item) == "float64" {
                if !has_float { has_float = true; float_product = to_float64(product) }
                float_product = float_product * item
            } else if eval_is_numeric(item) {
                if has_float { float_product = float_product * to_float64(item) }
                else { product = product * item }
            }
        }
        if has_float { float_product } else { product }
    },
    "math_min_of" => {
        const arr = inp_get_or(inputs, "array", null)
        if typeof(arr) != "array" || len(arr) == 0 { return null }
        let best = arr[0]
        for item in arr {
            const cmp = eval_num_cmp(item, best)
            if cmp != null && cmp < 0 { best = item }
        }
        best
    },
    "math_max_of" => {
        const arr = inp_get_or(inputs, "array", null)
        if typeof(arr) != "array" || len(arr) == 0 { return null }
        let best = arr[0]
        for item in arr {
            const cmp = eval_num_cmp(item, best)
            if cmp != null && cmp > 0 { best = item }
        }
        best
    },
    "math_count" => {
        const arr = inp_get_or(inputs, "array", null)
        if typeof(arr) != "array" { return 0 }
        len(arr)
    },
    "remap" => {
        const in_min = inp_get_or(inputs, "in_min", inp_get_or(inputs, "input_1", null))
        const in_max = inp_get_or(inputs, "in_max", inp_get_or(inputs, "input_2", null))
        const out_min = inp_get_or(inputs, "out_min", inp_get_or(inputs, "input_3", null))
        const out_max = inp_get_or(inputs, "out_max", inp_get_or(inputs, "input_4", null))
        const fv = eval_to_f64(input)
        const fimin = eval_to_f64(in_min)
        const fimax = eval_to_f64(in_max)
        const fomin = eval_to_f64(out_min)
        const fomax = eval_to_f64(out_max)
        if fv == null || fimin == null || fimax == null || fomin == null || fomax == null {
            return {"error": "remap requires numeric arguments"}
        }
        const range = fimax - fimin
        if range == 0.0 { return fomin }
        const t = (fv - fimin) / range
        fomin + t * (fomax - fomin)
    },

    // ── Higher-order array ops (handled by interpreter) ─────────

    "array_map" | "array_filter" | "array_flat_map" | "array_find" |
    "array_find_index" | "array_every" | "array_some" |
    "array_take_while" | "array_skip_while" | "array_group_by" |
    "array_sort_by" | "array_partition" | "array_scan" |
    "map_map_values" | "map_filter_entries" => null,

    // ── Iterator operations ─────────────────────────────────────

    "iter_chain" => {
        if typeof(a) != "array" || typeof(b) != "array" {
            return {"error": "iter_chain requires two arrays"}
        }
        let result = []
        for item in a { result.push(item) }
        for item in b { result.push(item) }
        result
    },
    "iter_cycle" => {
        if typeof(array) != "array" { return {"error": "expected array"} }
        const n = inp_get_or(inputs, "count", inp_get_or(inputs, "input_1", 1))
        const count = if typeof(n) == "int64" { n } else { 1 }
        let result = []
        let i = 0
        while i < count {
            for item in array { result.push(item) }
            i = i + 1
        }
        result
    },
    "iter_repeat" => {
        const n = inp_get_or(inputs, "count", inp_get_or(inputs, "input_1", 1))
        const count = if typeof(n) == "int64" { n } else { 1 }
        let result = []
        let i = 0
        while i < count { result.push(input); i = i + 1 }
        result
    },
    "iter_product" => {
        if typeof(a) != "array" || typeof(b) != "array" {
            return {"error": "iter_product requires two arrays"}
        }
        let result = []
        for x in a {
            for y in b { result.push([x, y]) }
        }
        result
    },
    "iter_pairwise" => {
        if typeof(array) != "array" || len(array) < 2 { return [] }
        let result = []
        let i = 0
        while i < len(array) - 1 {
            result.push([array[i], array[i + 1]])
            i = i + 1
        }
        result
    },

    // ── Template rendering ──────────────────────────────────────

    "template_render" => {
        const tmpl = inp_get_or(inputs, "template", null)
        const vals = inp_get_or(inputs, "values", null)
        if typeof(tmpl) != "string" { return {"error": "template must be a string"} }
        let result = tmpl
        if typeof(vals) == "map" {
            for k in keys(vals) {
                result = result.replace("{{" + k + "}}", to_string(vals[k]))
            }
        }
        result
    },

    // ── Flag parsing ────────────────────────────────────────────

    "flag_parse" => {
        const args_v = inp_get_or(inputs, "args", null)
        if typeof(args_v) != "array" { return {"flags": {}, "positional": []} }
        parse_args(args_v)
    },
    "flag_args" => {
        // Return raw args
        inp_get_or(inputs, "args", [])
    },

    // ── Data format operations ──────────────────────────────────

    "toml_parse" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        toml_parse(input)
    },
    "toml_stringify" => toml_stringify(input),
    "csv_parse" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        csv_parse(input)
    },
    "csv_stringify" => csv_stringify(input),
    "csv_headers" => {
        if typeof(input) != "string" { return [] }
        const lines = input.split("\n")
        if len(lines) == 0 { return [] }
        lines[0].split(",")
    },
    "csv_parse_rows" => {
        if typeof(input) != "string" { return [] }
        const lines = input.split("\n")
        let rows = []
        for line in lines {
            if len(line.trim()) > 0 { rows.push(line.split(",")) }
        }
        rows
    },
    "yaml_parse" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        yaml_parse(input)
    },
    "yaml_stringify" => yaml_stringify(input),
    "yaml_validate" => {
        if typeof(input) != "string" { return false }
        const result = yaml_parse(input)
        result != null && !(typeof(result) == "map" && result.has("error"))
    },
    "yaml_to_json" => {
        if typeof(input) != "string" { return null }
        const parsed = yaml_parse(input)
        if parsed != null { to_json(parsed) } else { null }
    },
    "yaml_from_json" => {
        if typeof(input) != "string" { return null }
        const parsed = parse_json(input)
        if parsed != null { yaml_stringify(parsed) } else { null }
    },
    "yaml_merge" => {
        if typeof(a) != "map" || typeof(b) != "map" {
            return {"error": "yaml_merge requires two maps"}
        }
        let merged = {}
        for k in keys(a) { merged[k] = a[k] }
        for k in keys(b) { merged[k] = b[k] }
        merged
    },
    "xml_parse" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        xml_parse(input)
    },
    "xml_stringify" => xml_stringify(input),

    // ── HTTP operations (delegate to host) ──────────────────────

    "http_get" => {
        const url = inp_get_or(inputs, "url", null)
        if typeof(url) != "string" { return {"error": "http_get requires string url"} }
        http_get(url)
    },
    "http_post" => {
        const url = inp_get_or(inputs, "url", null)
        const body = inp_get_or(inputs, "body", "")
        if typeof(url) != "string" { return {"error": "http_post requires string url"} }
        http_post(url, body)
    },
    "http_put" => {
        const url = inp_get_or(inputs, "url", null)
        const body = inp_get_or(inputs, "body", "")
        if typeof(url) != "string" { return {"error": "http_put requires string url"} }
        http_put(url, body)
    },
    "http_delete" => {
        const url = inp_get_or(inputs, "url", null)
        if typeof(url) != "string" { return {"error": "http_delete requires string url"} }
        http_delete(url)
    },
    "http_request" => {
        const method = inp_get_or(inputs, "method", "GET")
        const url = inp_get_or(inputs, "url", null)
        const body = inp_get_or(inputs, "body", null)
        const headers = inp_get_or(inputs, "headers", null)
        if typeof(url) != "string" { return {"error": "http_request requires string url"} }
        http_request(method, url, body, headers)
    },
    "http_head" | "http_options" | "http_patch" => {
        const url = inp_get_or(inputs, "url", null)
        if typeof(url) != "string" { return {"error": f"{op_name} requires string url"} }
        http_request(op_name.replace("http_", "").to_upper(), url, null, null)
    },

    // ── Compression (delegate to host) ──────────────────────────

    "compress_zstd" => compress_zstd(input),
    "decompress_zstd" => decompress_zstd(input),
    "compress_lz4" => compress_lz4(input),
    "decompress_lz4" => decompress_lz4(input),
    "compress_gzip" => compress_gzip(input),
    "decompress_gzip" => decompress_gzip(input),

    // ── TCP / UDP / WebSocket / SSE / HTTP Server ───────────────
    // These are connection-oriented, delegate to host

    "tcp_connect" => {
        const host = inp_get_or(inputs, "host", null)
        const port = inp_get_or(inputs, "port", null)
        if typeof(host) != "string" { return {"error": "tcp_connect requires string host"} }
        tcp_connect(host, port)
    },
    "tcp_write" => {
        const conn = inp_get_or(inputs, "connection", null)
        const data = inp_get_or(inputs, "data", null)
        tcp_write(conn, data)
    },
    "tcp_read" => {
        const conn = inp_get_or(inputs, "connection", null)
        tcp_read(conn)
    },
    "tcp_close" => {
        const conn = inp_get_or(inputs, "connection", null)
        tcp_close(conn)
    },
    "tcp_bind" => {
        const host = inp_get_or(inputs, "host", "0.0.0.0")
        const port = inp_get_or(inputs, "port", 0)
        tcp_bind(host, port)
    },
    "tcp_accept" => {
        const server = inp_get_or(inputs, "server", null)
        tcp_accept(server)
    },
    "tcp_server_close" => {
        const server = inp_get_or(inputs, "server", null)
        tcp_server_close(server)
    },
    "udp_bind" => {
        const host = inp_get_or(inputs, "host", "0.0.0.0")
        const port = inp_get_or(inputs, "port", 0)
        udp_bind(host, port)
    },
    "udp_send_to" => {
        const conn = inp_get_or(inputs, "connection", null)
        const data = inp_get_or(inputs, "data", null)
        const addr = inp_get_or(inputs, "address", null)
        udp_send_to(conn, data, addr)
    },
    "udp_recv_from" => {
        const conn = inp_get_or(inputs, "connection", null)
        udp_recv_from(conn)
    },
    "udp_close" => {
        const conn = inp_get_or(inputs, "connection", null)
        udp_close(conn)
    },
    "ws_connect" => {
        const url = inp_get_or(inputs, "url", null)
        if typeof(url) != "string" { return {"error": "ws_connect requires string url"} }
        ws_connect(url)
    },
    "ws_send" => {
        const conn = inp_get_or(inputs, "connection", null)
        const data = inp_get_or(inputs, "data", null)
        ws_send(conn, data)
    },
    "ws_receive" => {
        const conn = inp_get_or(inputs, "connection", null)
        ws_receive(conn)
    },
    "ws_close" => {
        const conn = inp_get_or(inputs, "connection", null)
        ws_close(conn)
    },
    "sse_connect" => {
        const url = inp_get_or(inputs, "url", null)
        if typeof(url) != "string" { return {"error": "sse_connect requires string url"} }
        sse_connect(url)
    },
    "sse_read_event" => {
        const conn = inp_get_or(inputs, "connection", null)
        sse_read_event(conn)
    },
    "sse_close" => {
        const conn = inp_get_or(inputs, "connection", null)
        sse_close(conn)
    },
    "http_server_start" => {
        const port = inp_get_or(inputs, "port", 8080)
        http_server_start(port)
    },
    "http_server_receive" => {
        const server = inp_get_or(inputs, "server", null)
        http_server_receive(server)
    },
    "http_server_respond" => {
        const server = inp_get_or(inputs, "server", null)
        const response = inp_get_or(inputs, "response", null)
        http_server_respond(server, response)
    },
    "http_server_stop" => {
        const server = inp_get_or(inputs, "server", null)
        http_server_stop(server)
    },

    // ── Exec operations ─────────────────────────────────────────

    "exec" => {
        const cmd = inp_get_or(inputs, "command", null)
        const args_v = inp_get_or(inputs, "args", [])
        if typeof(cmd) != "string" { return {"error": "exec requires string command"} }
        exec_cmd(cmd, args_v)
    },
    "exec_status" => {
        const cmd = inp_get_or(inputs, "command", null)
        const args_v = inp_get_or(inputs, "args", [])
        if typeof(cmd) != "string" { return {"error": "exec_status requires string command"} }
        const result = exec_cmd(cmd, args_v)
        if typeof(result) == "map" && result.has("exit_code") { result["exit_code"] }
        else { 0 }
    },
    "exec_output" => {
        const cmd = inp_get_or(inputs, "command", null)
        const args_v = inp_get_or(inputs, "args", [])
        if typeof(cmd) != "string" { return {"error": "exec_output requires string command"} }
        const result = exec_cmd(cmd, args_v)
        if typeof(result) == "map" && result.has("stdout") { result["stdout"] }
        else { to_string(result) }
    },

    // ── Concurrency (delegate to host) ──────────────────────────

    "mutex_new" => mutex_new(),
    "mutex_lock" => mutex_lock(input),
    "mutex_unlock" => mutex_unlock(input),
    "waitgroup_new" => waitgroup_new(),
    "waitgroup_done" => waitgroup_done(input),
    "waitgroup_wait" => waitgroup_wait(input),
    "await_all" => await_all(input),

    // ── Logging ─────────────────────────────────────────────────

    "log_info" => { println(f"[INFO] {to_string(input)}"); null },
    "log_warn" => { println(f"[WARN] {to_string(input)}"); null },
    "log_error" => { println(f"[ERROR] {to_string(input)}"); null },
    "log_debug" => { if cli_debug { println(f"[DEBUG] {to_string(input)}") }; null },

    // ── Terminal / SDL / Audio / GPU (platform stubs) ───────────

    "raw_mode_enable" => raw_mode_enable(),
    "raw_mode_disable" => raw_mode_disable(),
    "read_byte" => read_byte(),
    "read_byte_timeout" => {
        const ms = inp_get_or(inputs, "timeout", 100)
        read_byte_timeout(ms)
    },
    "sdl_init" | "sdl_set_color" | "sdl_clear" | "sdl_present" |
    "sdl_draw_pixel" | "sdl_draw_line" | "sdl_fill_rect" |
    "sdl_poll_event" | "sdl_delay" | "sdl_ticks" | "sdl_destroy" => {
        // SDL operations delegate to host
        null
    },
    "audio_stream_new" | "audio_write_samples" | "audio_drain" | "audio_close" => {
        // Audio operations delegate to host
        null
    },
    "gpu_init" | "gpu_create_buffer" | "gpu_create_shader" |
    "gpu_create_pipeline" | "gpu_begin_render_pass" | "gpu_draw" |
    "gpu_end_render_pass" | "gpu_submit" | "gpu_present" |
    "gpu_write_buffer" | "gpu_create_texture" | "gpu_destroy" => {
        {"error": "WebGPU is only available in WASM target"}
    },

    // ── Certificate operations (stubs) ──────────────────────────

    "cert_generate" | "cert_self_signed" | "cert_parse" | "cert_info" |
    "cert_verify" | "key_generate" => {
        null // Delegates to host crypto
    },

    // ── Remaining miscellaneous ─────────────────────────────────

    "format_float" | "parse_uint" | "cli_fix" | "cli_clean" | "cli_tree" => null,
    "math_gamma" | "math_lgamma" | "math_erf" | "math_erfc" |
    "math_expm1" | "math_nextafter" | "math_signbit" => {
        const f = eval_to_f64(input)
        if f == null { return {"error": "expected number"} }
        null // Specialized math delegates to host
    },
    "fs_chown" | "fs_hardlink" | "os_pipe" => null,

    _ => {
        // Unknown operation: delegate to ops.magi eval_operation
        eval_operation(op_name, if typeof(inputs) == "map" {
            let args = []
            if inputs.has("a") { args.push(inputs["a"]) }
            if inputs.has("b") { args.push(inputs["b"]) }
            if inputs.has("input") { args.push(inputs["input"]) }
            if inputs.has("value") { args.push(inputs["value"]) }
            args
        } else { [] })
    }

    } // end match
}

// ── JSON flatten helper ─────────────────────────────────────────

func json_flatten_recursive(val, prefix, result, depth) {
    if depth > MAX_JSON_DEPTH { return result }
    if typeof(val) == "map" {
        for k in keys(val) {
            if starts_with(k, "__") { continue }
            const new_key = if len(prefix) == 0 { k } else { prefix + "." + k }
            json_flatten_recursive(val[k], new_key, result, depth + 1)
        }
    } else if typeof(val) == "array" {
        let i = 0
        for item in val {
            const new_key = if len(prefix) == 0 { to_string(i) } else { prefix + "." + to_string(i) }
            json_flatten_recursive(item, new_key, result, depth + 1)
            i = i + 1
        }
    } else {
        const final_key = if len(prefix) == 0 { "value" } else { prefix }
        result[final_key] = val
    }
    result
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Full Run Command Implementation
// ═══════════════════════════════════════════════════════════════════

func cmd_run_full(file_path, flags) {
    const json_output = flags.has("json") || cli_json
    const sandbox = flags.has("sandbox") || cli_sandbox
    const timeout_secs = if flags.has("timeout") { parse_int(flags["timeout"]) } else { null }
    const verbose = flags.has("verbose") || cli_verbose

    if sandbox { cli_sandbox = true }

    // Read source file
    const source = fs_read(file_path)
    if source == null {
        if json_output {
            output_json({"error": f"cannot read file '{file_path}'"})
        } else {
            println(f"error: cannot read file '{file_path}'")
        }
        return null
    }

    // Strip UTF-8 BOM
    let effective_source = source
    if starts_with(source, "\xEF\xBB\xBF") {
        effective_source = source.slice(3, len(source))
    }

    // Strip shebang
    if starts_with(effective_source, "#!") {
        const nl = effective_source.index_of("\n")
        if nl != null && nl >= 0 {
            effective_source = effective_source.slice(nl + 1, len(effective_source))
        }
    }

    if verbose { println(f"[verbose] Parsing {file_path}...") }

    // Parse
    const program = parse(effective_source)

    if verbose { println("[verbose] Type checking...") }

    // Type check
    const check_result = check(program)
    const errors = check_result[0]
    const warnings = check_result[1]

    // Print warnings
    for w in warnings {
        if !cli_quiet {
            if json_output {
                // Accumulate for JSON output
            } else {
                println(format_warning(file_path, effective_source, 0, 0, to_string(w)))
            }
        }
    }

    // Abort on errors
    if len(errors) > 0 {
        if json_output {
            output_check_json(errors, warnings)
        } else {
            for err in errors {
                println(format_error(file_path, effective_source, 0, 0, to_string(err)))
            }
            print_diagnostic_summary(errors, warnings)
        }
        return null
    }

    if verbose { println("[verbose] Optimizing...") }

    // Optimize
    const optimized = optimize(program)

    if verbose { println("[verbose] Executing...") }

    // Execute
    const start_time = now_timestamp()
    const result = eval_program(optimized)
    const elapsed = now_timestamp() - start_time

    if verbose { println(f"[verbose] Execution completed in {format_elapsed(elapsed)}") }

    if json_output && result != null {
        output_json({"result": result, "elapsed_ms": elapsed})
    }

    result
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Full Compilec Command Implementation
// ═══════════════════════════════════════════════════════════════════

func cmd_compilec_full(file_path, flags) {
    const source = fs_read(file_path)
    if source == null {
        println(f"error: cannot read file '{file_path}'")
        return null
    }

    // Parse and type check
    const program = parse(source)
    const result = check(program)
    const errors = result[0]
    const warnings = result[1]

    for w in warnings {
        if !cli_quiet { println(f"warning: {w}") }
    }

    if len(errors) > 0 {
        for err in errors { println(f"error: {err}") }
        println(f"{len(errors)} error(s) found; aborting compilation.")
        return null
    }

    // Optimize
    const optimized = optimize(program)

    // Write classfile
    const out_path = file_path.replace(".magi", ".magc")

    // MAGC header: magic + version + source length + source
    const magic = "MAGC"
    const version_byte = "\x01"
    const source_len = to_string(len(source))
    const classfile = magic + version_byte + "\n" + source_len + "\n" + source

    fs_write(out_path, classfile)
    if !cli_quiet {
        println(f"Compiled {file_path} -> {out_path} ({len(source)} bytes)")
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Full Runc Command Implementation
// ═══════════════════════════════════════════════════════════════════

func cmd_runc_full(file_path, flags) {
    const data = fs_read(file_path)
    if data == null {
        println(f"error: cannot read file '{file_path}'")
        return null
    }
    if !starts_with(data, "MAGC") {
        println(f"error: {file_path} is not a valid .magc classfile (missing MAGC header)")
        return null
    }

    // Extract source from classfile
    // Skip magic (4 bytes) + version (1 byte) + newline
    const after_magic = data.slice(4, len(data))
    const first_nl = after_magic.index_of("\n")
    if first_nl == null || first_nl < 0 {
        // Simple format: just MAGC + source
        const source = data.slice(4, len(data))
        return run_source(source)
    }

    const after_version = after_magic.slice(first_nl + 1, len(after_magic))
    const second_nl = after_version.index_of("\n")
    if second_nl == null || second_nl < 0 {
        return run_source(after_version)
    }

    const source = after_version.slice(second_nl + 1, len(after_version))
    run_source(source)
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Full Run-BC Command Implementation
// ═══════════════════════════════════════════════════════════════════

func cmd_run_bc_full(file_path, flags) {
    const source = fs_read(file_path)
    if source == null {
        println(f"error: cannot read file '{file_path}'")
        return null
    }

    if cli_verbose { println(f"[verbose] Compiling {file_path} to IR bytecode...") }

    // Parse, check, optimize
    const program = parse(source)
    const result = check(program)
    const errors = result[0]
    if len(errors) > 0 {
        for err in errors { println(f"error: {err}") }
        return null
    }
    const optimized = optimize(program)

    // Compile to IR and execute via IR VM
    // In self-hosted, this goes through the same interpreter
    // (full IR compiler is in ir.magi)
    if cli_verbose { println("[verbose] Executing via IR VM...") }
    eval_program(optimized)
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Full Compile (WASM) Command Implementation
// ═══════════════════════════════════════════════════════════════════

func cmd_compile_full(file_path, flags) {
    const source = fs_read(file_path)
    if source == null {
        println(f"error: cannot read file '{file_path}'")
        return null
    }

    const program = parse(source)
    const result = check(program)
    const errors = result[0]
    if len(errors) > 0 {
        for err in errors { println(f"error: {err}") }
        return null
    }

    // Create output directory
    const out_dir = "dist"
    if !fs_exists(out_dir) { fs_mkdir(out_dir) }

    const base_name = path_stem(file_path)
    const out_path = out_dir + "/" + base_name + ".wasm"

    // Compile to WASM binary (delegates to compiler module)
    const optimized = optimize(program)
    // The actual WASM compilation requires the compiler backend
    // which is available through the stage-0 host
    compile_wasm(optimized, out_path)

    if !cli_quiet {
        println(f"Compiled {file_path} -> {out_path}")
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Full Run-WASM Command Implementation
// ═══════════════════════════════════════════════════════════════════

func cmd_run_wasm_full(file_path, flags) {
    if !fs_exists(file_path) {
        println(f"error: cannot read file '{file_path}'")
        return null
    }

    // Validate WASM magic
    const data = fs_read(file_path)
    if data == null || len(data) < 8 {
        println(f"error: '{file_path}' is not a valid WASM file")
        return null
    }

    // Delegate to stage-0 WASM runtime
    if cli_verbose { println(f"[verbose] Running WASM: {file_path}") }
    run_wasm(file_path)
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Full Compile-Native Command Implementation
// ═══════════════════════════════════════════════════════════════════

func cmd_compile_native_full(file_path, flags) {
    const source = fs_read(file_path)
    if source == null {
        println(f"error: cannot read file '{file_path}'")
        return null
    }

    const program = parse(source)
    const result = check(program)
    const errors = result[0]
    if len(errors) > 0 {
        for err in errors { println(f"error: {err}") }
        return null
    }

    const optimized = optimize(program)
    const base_name = path_stem(file_path)

    // Determine output format based on OS
    const os = os_name()
    const arch = os_arch()
    let out_path = base_name
    if os == "linux" { out_path = base_name } // ELF (no extension)
    else if os == "macos" { out_path = base_name } // Mach-O
    else { out_path = base_name + ".exe" }

    // Compile to native (delegates to native compiler backend)
    compile_native(optimized, out_path)

    if !cli_quiet {
        println(f"Compiled {file_path} -> {out_path} (native {arch} {os})")
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Full Test Command Implementation
// ═══════════════════════════════════════════════════════════════════

func cmd_test_full(target, flags) {
    const filter = if flags.has("filter") { flags["filter"] } else { null }
    const timeout_ms = if flags.has("timeout") { parse_int(flags["timeout"]) } else { null }
    const json_output = flags.has("json") || cli_json
    const verbose = flags.has("verbose") || cli_verbose

    if fs_is_dir(target) {
        cmd_test_dir_full(target, filter, timeout_ms, json_output)
        return null
    }

    const source = fs_read(target)
    if source == null {
        println(f"error: cannot read '{target}'")
        return null
    }

    const program = parse(source)

    // Collect test definitions
    let tests = []
    for stmt in program.statements {
        match stmt.kind {
            StmtKind::STestDef(name, body) => {
                if filter == null || name.contains(filter) {
                    tests.push({"name": name, "body": body})
                }
            },
            _ => {}
        }
    }

    if len(tests) == 0 {
        if !cli_quiet { println("No tests found.") }
        return null
    }

    let test_results = []
    let passed = 0
    let failed = 0
    let skipped = 0
    const start_time = now_timestamp()

    if !json_output && !cli_quiet { println(f"\n  {target}") }

    for t in tests {
        const test_name = t["name"]
        const test_start = now_timestamp()

        // Run the test
        let success = true
        let error_msg = null
        eval_program_block(t["body"])
        // In a full implementation, would catch panics and assertion failures

        const test_elapsed = now_timestamp() - test_start

        if success {
            passed = passed + 1
            if !json_output && !cli_quiet {
                if !cli_no_color {
                    println(f"    \x1b[32mPASS\x1b[0m {test_name} ({test_elapsed}ms)")
                } else {
                    println(f"    PASS {test_name} ({test_elapsed}ms)")
                }
            }
            test_results.push({"name": test_name, "status": "pass", "duration": test_elapsed})
        } else {
            failed = failed + 1
            if !json_output && !cli_quiet {
                if !cli_no_color {
                    println(f"    \x1b[31mFAIL\x1b[0m {test_name} ({test_elapsed}ms) -- {error_msg}")
                } else {
                    println(f"    FAIL {test_name} ({test_elapsed}ms) -- {error_msg}")
                }
            }
            test_results.push({"name": test_name, "status": "fail", "duration": test_elapsed, "error": error_msg})
        }
    }

    const total_elapsed = now_timestamp() - start_time

    if json_output {
        output_test_json(test_results)
    } else if !cli_quiet {
        println("")
        const status_str = if failed == 0 { "ok" } else { "FAILED" }
        println(f"test result: {status_str}. {passed} passed; {failed} failed; {skipped} skipped; finished in {format_elapsed(total_elapsed)}")
    }
}

func cmd_test_dir_full(dir, filter, timeout_ms, json_output) {
    const entries = fs_list(dir)
    if entries == null { return null }

    let test_files = []
    let subdirs = []

    for entry in entries {
        const full_path = dir + "/" + entry
        if ends_with(entry, ".magi") {
            test_files.push(full_path)
        } else if fs_is_dir(full_path) && !starts_with(entry, ".") {
            subdirs.push(full_path)
        }
    }

    // Sort for deterministic output
    test_files = sort(test_files)

    for file in test_files {
        cmd_test_full(file, {"filter": filter, "timeout": timeout_ms, "json": json_output})
    }

    for subdir in subdirs {
        cmd_test_dir_full(subdir, filter, timeout_ms, json_output)
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Full Bench Command Implementation
// ═══════════════════════════════════════════════════════════════════

func cmd_bench_full(file_path, iterations, flags) {
    const source = fs_read(file_path)
    if source == null {
        println(f"error: cannot read file '{file_path}'")
        return null
    }

    if !cli_quiet { println(f"Benchmarking {file_path} ({iterations} iterations)\n") }

    const program = parse(source)

    // Collect benchmark functions
    let benchmarks = []
    for stmt in program.statements {
        match stmt.kind {
            StmtKind::SFuncDef(fdef) => {
                if starts_with(fdef.name, "bench_") {
                    benchmarks.push(fdef.name)
                }
            },
            _ => {}
        }
    }

    if len(benchmarks) == 0 {
        benchmarks = ["<main>"]
    }

    let all_results = []

    for bench_name in benchmarks {
        let times = []
        let i = 0
        while i < iterations {
            const t0 = now_timestamp()
            if bench_name == "<main>" {
                run_source(source)
            }
            // In full implementation, would call specific function
            const elapsed = now_timestamp() - t0
            times.push(elapsed)
            i = i + 1
        }

        // Calculate statistics
        const sorted_times = sort(times)
        let total = 0
        for t in times { total = total + t }
        const avg_ms = if iterations > 0 { total / iterations } else { 0 }
        const min_ms = if len(sorted_times) > 0 { sorted_times[0] } else { 0 }
        const max_ms = if len(sorted_times) > 0 { sorted_times[len(sorted_times) - 1] } else { 0 }
        const median_ms = if len(sorted_times) > 0 { sorted_times[len(sorted_times) / 2] } else { 0 }

        if flags.has("json") || cli_json {
            all_results.push({
                "name": bench_name,
                "iterations": iterations,
                "total_ms": total,
                "avg_ms": avg_ms,
                "min_ms": min_ms,
                "max_ms": max_ms,
                "median_ms": median_ms
            })
        } else {
            println(f"  {bench_name}:")
            println(f"    iterations: {iterations}")
            println(f"    total:      {format_elapsed(total)}")
            println(f"    avg:        {format_elapsed(avg_ms)}")
            println(f"    min:        {format_elapsed(min_ms)}")
            println(f"    max:        {format_elapsed(max_ms)}")
            println(f"    median:     {format_elapsed(median_ms)}")
            println("")
        }
    }

    if flags.has("json") || cli_json {
        output_json({"benchmarks": all_results})
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Full Coverage Command Implementation
// ═══════════════════════════════════════════════════════════════════

func cmd_coverage_full(file_path, flags) {
    const source = fs_read(file_path)
    if source == null {
        println(f"error: cannot read file '{file_path}'")
        return null
    }

    const program = parse(source)
    const total_lines = source.split("\n")
    let code_lines = 0
    let comment_lines = 0
    let blank_lines = 0

    for line in total_lines {
        const trimmed = line.trim()
        if len(trimmed) == 0 {
            blank_lines = blank_lines + 1
        } else if starts_with(trimmed, "//") {
            comment_lines = comment_lines + 1
        } else {
            code_lines = code_lines + 1
        }
    }

    let total_functions = 0
    let total_tests = 0

    for stmt in program.statements {
        match stmt.kind {
            StmtKind::SFuncDef(_) => { total_functions = total_functions + 1 },
            StmtKind::STestDef(_, _) => { total_tests = total_tests + 1 },
            _ => {}
        }
    }

    const fn_coverage = if total_functions > 0 { (total_tests * 100) / total_functions } else { 0 }

    if flags.has("json") || cli_json {
        output_json({
            "file": file_path,
            "total_lines": len(total_lines),
            "code_lines": code_lines,
            "comment_lines": comment_lines,
            "blank_lines": blank_lines,
            "functions": total_functions,
            "tests": total_tests,
            "function_coverage_percent": fn_coverage
        })
    } else {
        println(f"Coverage report for {file_path}:")
        println(f"  Total lines:       {len(total_lines)}")
        println(f"  Code lines:        {code_lines}")
        println(f"  Comment lines:     {comment_lines}")
        println(f"  Blank lines:       {blank_lines}")
        println(f"  Functions:         {total_functions}")
        println(f"  Tests:             {total_tests}")
        println(f"  Function coverage: {fn_coverage}%")
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Full Format Command Implementation
// ═══════════════════════════════════════════════════════════════════

func cmd_fmt_complete(file_path, flags) {
    const write_mode = flags.has("write") || flags.has("w")
    const check_mode = flags.has("check") || flags.has("c")
    const diff_mode = flags.has("diff")

    if write_mode && check_mode {
        println("error: --write and --check are mutually exclusive")
        return null
    }

    const source = fs_read(file_path)
    if source == null {
        println(f"error: cannot read file '{file_path}'")
        return null
    }

    const formatted = fmt_source(source)

    if check_mode {
        if formatted == source {
            if !cli_quiet { println(f"{file_path}: OK") }
        } else {
            println(f"{file_path}: needs formatting")
            // Exit with non-zero in full implementation
        }
    } else if diff_mode {
        if formatted == source {
            if !cli_quiet { println(f"{file_path}: already formatted") }
        } else {
            // Show diff
            const orig_lines = source.split("\n")
            const fmt_lines = formatted.split("\n")
            println(f"--- {file_path}")
            println(f"+++ {file_path} (formatted)")
            let i = 0
            const max_lines = if len(orig_lines) > len(fmt_lines) { len(orig_lines) } else { len(fmt_lines) }
            while i < max_lines {
                const orig = if i < len(orig_lines) { orig_lines[i] } else { "" }
                const fmt = if i < len(fmt_lines) { fmt_lines[i] } else { "" }
                if orig != fmt {
                    if !cli_no_color {
                        println(f"\x1b[31m- {orig}\x1b[0m")
                        println(f"\x1b[32m+ {fmt}\x1b[0m")
                    } else {
                        println(f"- {orig}")
                        println(f"+ {fmt}")
                    }
                }
                i = i + 1
            }
        }
    } else if write_mode {
        if formatted != source {
            fs_write(file_path, formatted)
            if !cli_quiet { println(f"Formatted {file_path}") }
        } else {
            if cli_verbose { println(f"{file_path}: already formatted") }
        }
    } else {
        println(formatted)
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Full Error Formatting with Source Context
// ═══════════════════════════════════════════════════════════════════

func format_error_full(file_path, source, error_info) {
    let line = 0
    let col = 0
    let message = ""
    let code = ""
    let suggestion = null

    if typeof(error_info) == "map" {
        line = if error_info.has("line") { error_info["line"] } else { 0 }
        col = if error_info.has("col") { error_info["col"] } else { 0 }
        message = if error_info.has("message") { error_info["message"] } else { to_string(error_info) }
        code = if error_info.has("code") { error_info["code"] } else { "" }
        suggestion = if error_info.has("suggestion") { error_info["suggestion"] } else { null }
    } else {
        message = to_string(error_info)
    }

    let result = ""

    // Error header with code
    if !cli_no_color {
        result = result + "\x1b[1;31merror"
        if len(code) > 0 { result = result + f"[{code}]" }
        result = result + "\x1b[0m"
    } else {
        result = result + "error"
        if len(code) > 0 { result = result + f"[{code}]" }
    }
    result = result + f": {message}\n"

    // Location
    if line > 0 {
        result = result + f"  --> {file_path}:{line}:{col}\n"
    } else {
        result = result + f"  --> {file_path}\n"
    }

    // Source context
    if line > 0 && typeof(source) == "string" {
        const lines = source.split("\n")
        if line <= len(lines) {
            const line_str = to_string(line)
            const padding = op_string_repeat(" ", len(line_str))

            // Show line before for context
            if line > 1 && line - 2 < len(lines) {
                const prev_line_num = to_string(line - 1)
                const prev_padding = op_string_repeat(" ", len(line_str) - len(prev_line_num))
                if !cli_no_color {
                    result = result + f"   {prev_padding}{prev_line_num} \x1b[2m|\x1b[0m {lines[line - 2]}\n"
                } else {
                    result = result + f"   {prev_padding}{prev_line_num} | {lines[line - 2]}\n"
                }
            }

            // Show error line
            if !cli_no_color {
                result = result + f"   {line_str} \x1b[2m|\x1b[0m {lines[line - 1]}\n"
                result = result + f"   {padding} \x1b[2m|\x1b[0m"
            } else {
                result = result + f"   {line_str} | {lines[line - 1]}\n"
                result = result + f"   {padding} |"
            }

            // Caret
            if col > 0 {
                if !cli_no_color {
                    result = result + op_string_repeat(" ", col) + "\x1b[1;31m^\x1b[0m"
                } else {
                    result = result + op_string_repeat(" ", col) + "^"
                }
            }
            result = result + "\n"
        }
    }

    // Suggestion
    if suggestion != null && len(to_string(suggestion)) > 0 {
        if !cli_no_color {
            result = result + f"   \x1b[1;36mhelp\x1b[0m: {suggestion}\n"
        } else {
            result = result + f"   help: {suggestion}\n"
        }
    }

    result
}

func format_warning_full(file_path, source, warning_info) {
    let line = 0
    let col = 0
    let message = ""
    let code = ""

    if typeof(warning_info) == "map" {
        line = if warning_info.has("line") { warning_info["line"] } else { 0 }
        col = if warning_info.has("col") { warning_info["col"] } else { 0 }
        message = if warning_info.has("message") { warning_info["message"] } else { to_string(warning_info) }
        code = if warning_info.has("code") { warning_info["code"] } else { "" }
    } else {
        message = to_string(warning_info)
    }

    let result = ""
    if !cli_no_color {
        result = result + "\x1b[1;33mwarning"
        if len(code) > 0 { result = result + f"[{code}]" }
        result = result + "\x1b[0m"
    } else {
        result = result + "warning"
        if len(code) > 0 { result = result + f"[{code}]" }
    }
    result = result + f": {message}\n"
    if line > 0 {
        result = result + f"  --> {file_path}:{line}:{col}\n"
    }
    result
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Full Argument Parsing
// ═══════════════════════════════════════════════════════════════════

func parse_args_full(raw_args) {
    let flags = {}
    let positional = []
    let command = null
    let max_errors = null
    let timeout = null
    let target_triple = null

    let i = 0
    while i < len(raw_args) {
        const arg = raw_args[i]

        // Long flags
        if starts_with(arg, "--") {
            const flag_name = arg.slice(2, len(arg))

            // Boolean flags (no value)
            match flag_name {
                "help" | "version" | "verbose" | "quiet" | "json" |
                "sandbox" | "watch" | "write" | "check" | "diff" |
                "no-color" | "debug" | "trace" | "backtrace" => {
                    flags[flag_name] = true
                    i = i + 1
                    continue
                },
                _ => {}
            }

            // Flags with values
            if i + 1 < len(raw_args) && !starts_with(raw_args[i + 1], "--") {
                flags[flag_name] = raw_args[i + 1]
                i = i + 2
            } else {
                flags[flag_name] = true
                i = i + 1
            }
        }
        // Short flags
        else if starts_with(arg, "-") && len(arg) == 2 {
            const flag_char = arg.slice(1, 2)
            match flag_char {
                "h" => { flags["help"] = true },
                "V" => { flags["version"] = true },
                "v" => { flags["verbose"] = true },
                "q" => { flags["quiet"] = true },
                "w" => { flags["write"] = true },
                "c" => { flags["check"] = true },
                "d" => { flags["diff"] = true },
                "j" => { flags["json"] = true },
                "s" => { flags["sandbox"] = true },
                "n" => {
                    if i + 1 < len(raw_args) {
                        flags["iterations"] = raw_args[i + 1]
                        i = i + 1
                    }
                },
                "t" => {
                    if i + 1 < len(raw_args) {
                        flags["timeout"] = raw_args[i + 1]
                        i = i + 1
                    }
                },
                "f" => {
                    if i + 1 < len(raw_args) {
                        flags["filter"] = raw_args[i + 1]
                        i = i + 1
                    }
                },
                _ => { flags[flag_char] = true }
            }
            i = i + 1
        }
        // Bundled short flags (e.g. -vq)
        else if starts_with(arg, "-") && len(arg) > 2 {
            const chars = arg.slice(1, len(arg))
            let j = 0
            while j < len(chars) {
                const c = chars.slice(j, j + 1)
                match c {
                    "v" => { flags["verbose"] = true },
                    "q" => { flags["quiet"] = true },
                    "w" => { flags["write"] = true },
                    "c" => { flags["check"] = true },
                    "j" => { flags["json"] = true },
                    "s" => { flags["sandbox"] = true },
                    _ => { flags[c] = true }
                }
                j = j + 1
            }
            i = i + 1
        }
        // Positional
        else {
            if command == null {
                command = arg
            } else {
                positional.push(arg)
            }
            i = i + 1
        }
    }

    // Apply environment variable overrides
    if env_flag("MAGI_JSON") { flags["json"] = true }
    if env_flag("MAGI_SANDBOX") { flags["sandbox"] = true }
    if env_flag("MAGI_NO_COLOR") { flags["no-color"] = true }
    if env_flag("MAGI_VERBOSE") { flags["verbose"] = true }
    if env_flag("MAGI_QUIET") { flags["quiet"] = true }
    if env_flag("MAGI_DEBUG") { flags["debug"] = true }
    if env_flag("MAGI_TRACE") { flags["trace"] = true }
    if env_flag("MAGI_BACKTRACE") { flags["backtrace"] = true }

    // Apply flags to globals
    if flags.has("no-color") { cli_no_color = true }
    if flags.has("json") { cli_json = true }
    if flags.has("verbose") { cli_verbose = true }
    if flags.has("quiet") { cli_quiet = true }
    if flags.has("debug") { cli_debug = true }
    if flags.has("trace") { cli_trace = true }
    if flags.has("sandbox") { cli_sandbox = true }

    {"command": command, "flags": flags, "positional": positional}
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Connection Infrastructure
// ═══════════════════════════════════════════════════════════════════

let connection_registry = {}
let connection_counter = 0

func conn_new_id(prefix) {
    connection_counter = connection_counter + 1
    f"{prefix}:{connection_counter}:{random_uuid()}"
}

func conn_store(id, conn) {
    if connection_registry.has(id) {
        return {"error": f"connection ID already exists: {id}"}
    }
    if len(keys(connection_registry)) >= 65536 {
        return {"error": "connection limit reached (max 65536)"}
    }
    connection_registry[id] = conn
    null
}

func conn_get(id) {
    if !connection_registry.has(id) {
        return {"error": f"connection not found: {id}"}
    }
    connection_registry[id]
}

func conn_remove_entry(id) {
    if !connection_registry.has(id) {
        return {"error": f"connection not found: {id}"}
    }
    let new_reg = {}
    for k in keys(connection_registry) {
        if k != id { new_reg[k] = connection_registry[k] }
    }
    connection_registry = new_reg
    null
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: URL Validation
// ═══════════════════════════════════════════════════════════════════

func validate_url(url_str) {
    // Extract scheme
    const scheme_end = url_str.index_of("://")
    if scheme_end == null || scheme_end < 0 {
        return {"error": f"invalid URL: missing scheme: {url_str}"}
    }
    const scheme = url_str.slice(0, scheme_end)
    if scheme != "http" && scheme != "https" && scheme != "ws" && scheme != "wss" {
        return {"error": f"URL scheme must be http, https, ws, or wss, got: {scheme}"}
    }

    // Extract host
    const after_scheme = url_str.slice(scheme_end + 3, len(url_str))
    const host_end = after_scheme.index_of("/")
    const port_sep = after_scheme.index_of(":")
    let host = ""
    if host_end != null && host_end >= 0 {
        host = after_scheme.slice(0, host_end)
    } else {
        host = after_scheme
    }
    if port_sep != null && port_sep >= 0 && (host_end == null || port_sep < host_end) {
        host = after_scheme.slice(0, port_sep)
    }

    // Check blocked hosts
    const host_lower = host.to_lower()
    if host_lower == "localhost" || ends_with(host_lower, ".local") ||
       ends_with(host_lower, ".internal") || host_lower == "[::1]" {
        return {"error": f"blocked host: {host}"}
    }

    null // OK
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Configuration Management
// ═══════════════════════════════════════════════════════════════════

func read_magispace_config() {
    if !fs_exists("magispace.toml") { return null }
    const content = fs_read("magispace.toml")
    if content == null { return null }

    // Simple TOML parsing for workspace config
    let config = {}
    const lines = content.split("\n")
    let current_section = ""
    let in_members = false
    let members = []

    for line in lines {
        const trimmed = line.trim()
        if len(trimmed) == 0 || starts_with(trimmed, "#") { continue }

        if starts_with(trimmed, "[") {
            current_section = trimmed.slice(1, len(trimmed) - 1)
            in_members = false
            continue
        }

        if current_section == "workspace" {
            const eq_idx = trimmed.index_of("=")
            if eq_idx > 0 {
                const key_name = trimmed.slice(0, eq_idx).trim()
                let val = trimmed.slice(eq_idx + 1, len(trimmed)).trim()
                if key_name == "members" {
                    // Parse array
                    if starts_with(val, "[") {
                        val = val.slice(1, len(val))
                        if ends_with(val, "]") { val = val.slice(0, len(val) - 1) }
                        const items = val.split(",")
                        for item in items {
                            let stripped = item.trim()
                            if starts_with(stripped, "\"") { stripped = stripped.slice(1, len(stripped) - 1) }
                            if len(stripped) > 0 { members.push(stripped) }
                        }
                    }
                }
            }
        }
    }

    config["members"] = members
    config
}

func read_all_config() {
    let config = {}

    // Read project config
    const project = read_project_config()
    if project != null { config["project"] = project }

    // Read workspace config
    const workspace = read_magispace_config()
    if workspace != null { config["workspace"] = workspace }

    // Read environment
    config["env"] = {
        "os": os_name(),
        "arch": os_arch(),
        "home": env_flag_value("MAGI_HOME", env_flag_value("HOME", ".") + "/.magi"),
        "cwd": current_dir(),
        "version": VERSION,
        "debug": cli_debug,
        "trace": cli_trace,
        "sandbox": cli_sandbox,
        "json": cli_json,
        "quiet": cli_quiet,
        "verbose": cli_verbose,
        "no_color": cli_no_color
    }

    config
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Plugin Loading
// ═══════════════════════════════════════════════════════════════════

func load_project_plugins() {
    const config = read_project_config()
    if config == null { return [] }

    let plugins = []
    // Check for [plugins] section
    for k in keys(config) {
        if starts_with(k, "plugins.") {
            const plugin_name = k.slice(8, len(k))
            const plugin_path = config[k]
            plugins.push({"name": plugin_name, "path": plugin_path})
        }
    }
    plugins
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Hook Execution
// ═══════════════════════════════════════════════════════════════════

func run_hook(hook_name) {
    const config = read_project_config()
    if config == null { return null }

    const hook_key = "hooks." + hook_name
    if !config.has(hook_key) { return null }

    const hook_cmd = config[hook_key]
    if typeof(hook_cmd) != "string" || len(hook_cmd) == 0 { return null }

    if cli_verbose { println(f"[hook] Running {hook_name}: {hook_cmd}") }

    // Split command into parts
    const parts = hook_cmd.split(" ")
    if len(parts) == 0 { return null }

    const cmd = parts[0]
    let args = []
    let i = 1
    while i < len(parts) { args.push(parts[i]); i = i + 1 }

    exec_cmd(cmd, args)
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Environment Detection
// ═══════════════════════════════════════════════════════════════════

func detect_terminal_capabilities() {
    let caps = {
        "color": true,
        "unicode": true,
        "width": 80,
        "height": 24,
        "interactive": true
    }

    // Check NO_COLOR env var (standard)
    if env_get("NO_COLOR") != null { caps["color"] = false }
    if cli_no_color { caps["color"] = false }

    // Check TERM
    const term = env_get("TERM")
    if term == "dumb" {
        caps["color"] = false
        caps["unicode"] = false
        caps["interactive"] = false
    }

    // Check COLUMNS
    const cols = env_get("COLUMNS")
    if cols != null {
        const w = parse_int(cols)
        if w != null && w > 0 { caps["width"] = w }
    }

    // Check LINES
    const lines = env_get("LINES")
    if lines != null {
        const h = parse_int(lines)
        if h != null && h > 0 { caps["height"] = h }
    }

    caps
}

