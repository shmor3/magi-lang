let telemetry_events = []

func telemetry_record(event_name, data) {
    if !cli_debug && !cli_trace { return null }
    telemetry_events.push({
        "event": event_name,
        "timestamp": now_timestamp(),
        "data": data
    })
}

func telemetry_flush() {
    if len(telemetry_events) == 0 { return null }
    if cli_trace {
        for event in telemetry_events {
            println(f"[trace] {event['event']} at {event['timestamp']}")
        }
    }
    telemetry_events = []
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Magispace (Workspace) Support
// ═══════════════════════════════════════════════════════════════════

func cmd_workspace_full() {
    const config = read_magispace_config()
    if config == null {
        println("No magispace.toml found in current directory.")
        println("Create one with:")
        println("  [workspace]")
        println("  members = [\"packages/foo\", \"packages/bar\"]")
        return null
    }

    if !config.has("members") || len(config["members"]) == 0 {
        println("Workspace has no members.")
        return null
    }

    println("Workspace members:")
    for member in config["members"] {
        let status = "ok"
        if !fs_exists(member) { status = "missing" }
        else if !fs_exists(member + "/magi.toml") { status = "no magi.toml" }

        if !cli_no_color {
            if status == "ok" {
                println(f"  \x1b[32m{member}\x1b[0m")
            } else {
                println(f"  \x1b[31m{member}\x1b[0m ({status})")
            }
        } else {
            println(f"  {member} ({status})")
        }
    }
}

func cmd_workspace_build(flags) {
    const config = read_magispace_config()
    if config == null {
        println("error: no magispace.toml found")
        return null
    }

    for member in config["members"] {
        if !fs_exists(member) {
            println(f"warning: workspace member '{member}' not found")
            continue
        }

        println(f"\n=== Building {member} ===")
        const main_file = member + "/main.magi"
        if fs_exists(main_file) {
            cmd_compile(main_file)
        } else {
            println(f"  No main.magi found in {member}")
        }
    }
}

func cmd_workspace_test(flags) {
    const config = read_magispace_config()
    if config == null {
        println("error: no magispace.toml found")
        return null
    }

    let total_passed = 0
    let total_failed = 0

    for member in config["members"] {
        if !fs_exists(member) { continue }

        println(f"\n=== Testing {member} ===")
        const test_files = discover_test_files(member)
        for file in test_files {
            cmd_test(file, null, null)
        }
    }
}

func cmd_workspace_check(flags) {
    const config = read_magispace_config()
    if config == null {
        println("error: no magispace.toml found")
        return null
    }

    let total_errors = 0
    let total_warnings = 0

    for member in config["members"] {
        if !fs_exists(member) { continue }
        println(f"\n=== Checking {member} ===")
        const files = discover_magi_files(member)
        for file in files {
            const source = fs_read(file)
            if source == null { continue }
            const result = check_source(source)
            const errors = result[0]
            const warnings = result[1]
            total_errors = total_errors + len(errors)
            total_warnings = total_warnings + len(warnings)
            if len(errors) > 0 {
                for err in errors { println(f"  {file}: error: {err}") }
            }
        }
    }

    println(f"\nWorkspace: {total_errors} error(s), {total_warnings} warning(s)")
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Package Manifest Validation
// ═══════════════════════════════════════════════════════════════════

func validate_package_manifest(toml_path) {
    if !fs_exists(toml_path) {
        return {"valid": false, "errors": ["magi.toml not found"]}
    }

    const content = fs_read(toml_path)
    if content == null {
        return {"valid": false, "errors": ["cannot read magi.toml"]}
    }

    let errors = []
    let warnings = []

    // Check required fields
    const config = read_project_config()
    if config == null {
        return {"valid": false, "errors": ["cannot parse magi.toml"]}
    }

    if !config.has("package.name") || len(config["package.name"]) == 0 {
        errors.push("missing required field: [package] name")
    }
    if !config.has("package.version") || len(config["package.version"]) == 0 {
        errors.push("missing required field: [package] version")
    } else {
        // Validate semver
        const ver = parse_semver(config["package.version"])
        if ver == null {
            errors.push(f"invalid version format: {config['package.version']} (expected semver)")
        }
    }

    // Check optional fields
    if !config.has("package.description") {
        warnings.push("missing optional field: [package] description")
    }

    {"valid": len(errors) == 0, "errors": errors, "warnings": warnings}
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Dependency Graph
// ═══════════════════════════════════════════════════════════════════

func build_dependency_graph(project_dir) {
    let graph = {} // name -> [dependencies]
    let visited = []

    func visit(dir) {
        if dir == null { return null }
        const deps = resolve_project_deps(dir)
        const name = get_project_name()
        if name == null { return null }

        if graph.has(name) { return null } // Already visited
        graph[name] = []

        for dep in deps {
            graph[name].push(dep["name"])
            const dep_dir = find_package_dir(dep["name"])
            if dep_dir != null { visit(dep_dir) }
        }
    }

    visit(project_dir)
    graph
}

func cmd_dependency_graph(flags) {
    const graph = build_dependency_graph(".")
    if len(keys(graph)) == 0 {
        println("No dependencies found.")
        return null
    }

    println("Dependency graph:")
    for name in keys(graph) {
        const deps = graph[name]
        if len(deps) == 0 {
            println(f"  {name} (no dependencies)")
        } else {
            println(f"  {name}")
            for dep in deps {
                println(f"    -> {dep}")
            }
        }
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Incremental Compilation Cache
// ═══════════════════════════════════════════════════════════════════

func cache_dir() {
    const home = env_flag_value("MAGI_CACHE", env_flag_value("MAGI_HOME", env_flag_value("HOME", ".") + "/.magi") + "/cache")
    if !fs_exists(home) { fs_mkdir(home) }
    home
}

func cache_key_for_file(file_path) {
    const source = fs_read(file_path)
    if source == null { return null }
    hash_sha256(source)
}

func cache_get(key) {
    const path = cache_dir() + "/" + key
    if fs_exists(path) { return fs_read(path) }
    null
}

func cache_set(key, value) {
    const path = cache_dir() + "/" + key
    fs_write(path, value)
}

func cache_invalidate(key) {
    const path = cache_dir() + "/" + key
    if fs_exists(path) { fs_remove(path) }
}

func cache_clear() {
    const dir = cache_dir()
    if fs_exists(dir) { fs_remove(dir) }
    fs_mkdir(dir)
    println("Cache cleared.")
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Source Map Generation
// ═══════════════════════════════════════════════════════════════════

func generate_source_map(file_path, source) {
    let map = {
        "version": 3,
        "file": file_path,
        "sources": [file_path],
        "names": [],
        "mappings": ""
    }

    // Generate line-to-line mappings (identity map for now)
    const lines = source.split("\n")
    let mappings = []
    let i = 0
    while i < len(lines) {
        mappings.push("AAAA") // identity mapping
        i = i + 1
    }
    map["mappings"] = mappings.join(";")

    map
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Import Resolution
// ═══════════════════════════════════════════════════════════════════

func resolve_import(module_path, current_file) {
    // Check relative import
    if starts_with(module_path, ".") {
        const dir = path_dirname(current_file)
        const resolved = dir + "/" + module_path.replace(".", "/") + ".magi"
        if fs_exists(resolved) { return resolved }
    }

    // Check std library
    if starts_with(module_path, "std.") {
        const module_name = module_path.slice(4, len(module_path))
        // Standard library modules are built-in
        return "std:" + module_name
    }

    // Check package path
    const paths = [
        "packages/" + module_path.replace(".", "/") + ".magi",
        env_flag_value("MAGI_HOME", env_flag_value("HOME", ".") + "/.magi") + "/packages/" + module_path.replace(".", "/") + ".magi",
        "vendor/" + module_path.replace(".", "/") + ".magi"
    ]

    for p in paths {
        if fs_exists(p) { return p }
    }

    null
}

func resolve_all_imports(source, current_file) {
    let imports = []
    const lines = source.split("\n")

    for line in lines {
        const trimmed = line.trim()
        if starts_with(trimmed, "import ") {
            const module_path = trimmed.slice(7, len(trimmed)).trim()
            const resolved = resolve_import(module_path, current_file)
            imports.push({
                "module": module_path,
                "resolved": resolved,
                "found": resolved != null
            })
        }
    }

    imports
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Output Formatting Utilities
// ═══════════════════════════════════════════════════════════════════

func ansi_bold(text) {
    if cli_no_color { return text }
    f"\x1b[1m{text}\x1b[0m"
}

func ansi_red(text) {
    if cli_no_color { return text }
    f"\x1b[31m{text}\x1b[0m"
}

func ansi_green(text) {
    if cli_no_color { return text }
    f"\x1b[32m{text}\x1b[0m"
}

func ansi_yellow(text) {
    if cli_no_color { return text }
    f"\x1b[33m{text}\x1b[0m"
}

func ansi_blue(text) {
    if cli_no_color { return text }
    f"\x1b[34m{text}\x1b[0m"
}

func ansi_cyan(text) {
    if cli_no_color { return text }
    f"\x1b[36m{text}\x1b[0m"
}

func ansi_dim(text) {
    if cli_no_color { return text }
    f"\x1b[2m{text}\x1b[0m"
}

func table_row(columns, widths) {
    let row = ""
    let i = 0
    while i < len(columns) {
        let cell = to_string(columns[i])
        const w = if i < len(widths) { widths[i] } else { 20 }
        // Pad to width
        while len(cell) < w { cell = cell + " " }
        if len(cell) > w { cell = cell.slice(0, w) }
        row = row + cell
        if i < len(columns) - 1 { row = row + "  " }
        i = i + 1
    }
    row
}

func table_separator(widths) {
    let sep = ""
    let i = 0
    while i < len(widths) {
        let j = 0
        while j < widths[i] { sep = sep + "-"; j = j + 1 }
        if i < len(widths) - 1 { sep = sep + "  " }
        i = i + 1
    }
    sep
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Performance Profiler
// ═══════════════════════════════════════════════════════════════════

let profile_data = {}
let profile_stack = []

func profile_start(label) {
    profile_stack.push({"label": label, "start": now_timestamp()})
}

func profile_end() {
    if len(profile_stack) == 0 { return null }
    const entry = profile_stack[len(profile_stack) - 1]
    let new_stack = []
    let i = 0
    while i < len(profile_stack) - 1 { new_stack.push(profile_stack[i]); i = i + 1 }
    profile_stack = new_stack

    const elapsed = now_timestamp() - entry["start"]
    const label = entry["label"]

    if profile_data.has(label) {
        profile_data[label]["calls"] = profile_data[label]["calls"] + 1
        profile_data[label]["total"] = profile_data[label]["total"] + elapsed
        if elapsed < profile_data[label]["min"] { profile_data[label]["min"] = elapsed }
        if elapsed > profile_data[label]["max"] { profile_data[label]["max"] = elapsed }
    } else {
        profile_data[label] = {
            "calls": 1,
            "total": elapsed,
            "min": elapsed,
            "max": elapsed
        }
    }
}

func profile_report() {
    if len(keys(profile_data)) == 0 {
        println("No profiling data collected.")
        return null
    }

    println("Profile Report")
    println("==============\n")

    const widths = [30, 8, 12, 10, 10]
    println(table_row(["Label", "Calls", "Total", "Min", "Max"], widths))
    println(table_separator(widths))

    for label in keys(profile_data) {
        const d = profile_data[label]
        println(table_row([
            label,
            to_string(d["calls"]),
            format_elapsed(d["total"]),
            format_elapsed(d["min"]),
            format_elapsed(d["max"])
        ], widths))
    }
}

func profile_reset() {
    profile_data = {}
    profile_stack = []
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: File Watcher (polling-based)
// ═══════════════════════════════════════════════════════════════════

func watch_files(dir, callback) {
    let file_hashes = {}

    // Initial scan
    const files = discover_magi_files(dir)
    for file in files {
        file_hashes[file] = fs_size(file)
    }

    println(f"Watching {len(files)} files in {dir}...")

    while true {
        sleep(500)

        let changed = []
        const current_files = discover_magi_files(dir)

        for file in current_files {
            const current_size = fs_size(file)
            if !file_hashes.has(file) {
                // New file
                changed.push({"file": file, "type": "created"})
                file_hashes[file] = current_size
            } else if file_hashes[file] != current_size {
                // Modified file
                changed.push({"file": file, "type": "modified"})
                file_hashes[file] = current_size
            }
        }

        // Check for deleted files
        for file in keys(file_hashes) {
            let found = false
            for cf in current_files { if cf == file { found = true; break } }
            if !found {
                changed.push({"file": file, "type": "deleted"})
                let new_hashes = {}
                for k in keys(file_hashes) {
                    if k != file { new_hashes[k] = file_hashes[k] }
                }
                file_hashes = new_hashes
            }
        }

        if len(changed) > 0 {
            for change in changed {
                if cli_verbose {
                    println(f"[watch] {change['type']}: {change['file']}")
                }
            }
            callback(changed)
        }
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Spinner / Status Indicators
// ═══════════════════════════════════════════════════════════════════

const SPINNER_FRAMES = ["|", "/", "-", "\\"]

func spinner_frame(tick) {
    SPINNER_FRAMES[tick % len(SPINNER_FRAMES)]
}

func show_spinner(label, tick) {
    if cli_no_color || cli_quiet { return null }
    print(f"\r{spinner_frame(tick)} {label}")
}

func clear_spinner() {
    if cli_no_color || cli_quiet { return null }
    print("\r\x1b[K")
}

func status_ok(label) {
    if cli_quiet { return null }
    println(f"{ansi_green('OK')} {label}")
}

func status_fail(label) {
    if cli_quiet { return null }
    println(f"{ansi_red('FAIL')} {label}")
}

func status_warn(label) {
    if cli_quiet { return null }
    println(f"{ansi_yellow('WARN')} {label}")
}

func status_info(label) {
    if cli_quiet { return null }
    println(f"{ansi_blue('INFO')} {label}")
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Subprocess Helpers
// ═══════════════════════════════════════════════════════════════════

func run_command(cmd, args) {
    if cli_sandbox {
        return {"error": "command execution not allowed in sandbox mode"}
    }

    if cli_verbose {
        let arg_str = args.join(" ")
        println(f"[exec] {cmd} {arg_str}")
    }

    const result = exec_cmd(cmd, args)

    if cli_verbose && typeof(result) == "map" {
        if result.has("exit_code") {
            println(f"[exec] exit code: {result['exit_code']}")
        }
    }

    result
}

func run_command_capture(cmd, args) {
    const result = run_command(cmd, args)
    if typeof(result) == "map" && result.has("stdout") {
        return result["stdout"]
    }
    to_string(result)
}

func command_exists(cmd) {
    const result = exec_cmd("which", [cmd])
    if typeof(result) == "map" && result.has("exit_code") {
        return result["exit_code"] == 0
    }
    false
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Git Helpers
// ═══════════════════════════════════════════════════════════════════

func git_current_branch() {
    const result = run_command_capture("git", ["rev-parse", "--abbrev-ref", "HEAD"])
    if typeof(result) == "string" { return result.trim() }
    null
}

func git_is_clean() {
    const result = run_command_capture("git", ["status", "--porcelain"])
    if typeof(result) == "string" { return len(result.trim()) == 0 }
    true
}

func git_latest_tag() {
    const result = run_command_capture("git", ["describe", "--tags", "--abbrev=0"])
    if typeof(result) == "string" { return result.trim() }
    null
}

func git_commit_count() {
    const result = run_command_capture("git", ["rev-list", "--count", "HEAD"])
    if typeof(result) == "string" { return parse_int(result.trim()) }
    0
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Binary Search and Sort Utilities
// ═══════════════════════════════════════════════════════════════════

func binary_search_impl(arr, target) {
    let lo = 0
    let hi = len(arr) - 1
    while lo <= hi {
        const mid = (lo + hi) / 2
        const cmp = eval_num_cmp(arr[mid], target)
        if cmp == null { return -1 }
        if cmp == 0 { return mid }
        if cmp < 0 { lo = mid + 1 }
        else { hi = mid - 1 }
    }
    -1
}

func merge_sort(arr) {
    if len(arr) <= 1 { return arr }
    const mid = len(arr) / 2
    const left = merge_sort(arr.slice(0, mid))
    const right = merge_sort(arr.slice(mid, len(arr)))
    merge(left, right)
}

func merge(left, right) {
    let result = []
    let i = 0
    let j = 0
    while i < len(left) && j < len(right) {
        const cmp = eval_num_cmp(left[i], right[j])
        if cmp != null && cmp <= 0 {
            result.push(left[i])
            i = i + 1
        } else {
            result.push(right[j])
            j = j + 1
        }
    }
    while i < len(left) { result.push(left[i]); i = i + 1 }
    while j < len(right) { result.push(right[j]); j = j + 1 }
    result
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: TOML Writer
// ═══════════════════════════════════════════════════════════════════

func toml_write(data) {
    if typeof(data) != "map" { return to_string(data) }
    let result = ""
    let sections = {}
    let top_level = {}

    // Separate top-level keys from section keys
    for k in keys(data) {
        if typeof(data[k]) == "map" {
            sections[k] = data[k]
        } else {
            top_level[k] = data[k]
        }
    }

    // Write top-level keys first
    for k in keys(top_level) {
        result = result + toml_encode_kv(k, top_level[k]) + "\n"
    }

    // Write sections
    for section in keys(sections) {
        result = result + f"\n[{section}]\n"
        const sec_data = sections[section]
        for k in keys(sec_data) {
            result = result + toml_encode_kv(k, sec_data[k]) + "\n"
        }
    }

    result
}

func toml_encode_kv(key, value) {
    const encoded = toml_encode_value(value)
    f"{key} = {encoded}"
}

func toml_encode_value(value) {
    match typeof(value) {
        "string" => f"\"{value.replace('\\', '\\\\').replace('\"', '\\\"')}\"",
        "int64" | "int32" | "uint32" | "uint64" => to_string(value),
        "float64" | "float32" => to_string(value),
        "bool" => if value { "true" } else { "false" },
        "array" => {
            let items = []
            for item in value { items.push(toml_encode_value(item)) }
            "[" + items.join(", ") + "]"
        },
        _ => to_string(value)
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Glob Pattern Matching
// ═══════════════════════════════════════════════════════════════════

func glob_match(pattern, text) {
    let pi = 0
    let ti = 0
    let star_pi = -1
    let star_ti = -1

    while ti < len(text) {
        if pi < len(pattern) && (pattern.slice(pi, pi + 1) == text.slice(ti, ti + 1) || pattern.slice(pi, pi + 1) == "?") {
            pi = pi + 1
            ti = ti + 1
        } else if pi < len(pattern) && pattern.slice(pi, pi + 1) == "*" {
            star_pi = pi
            star_ti = ti
            pi = pi + 1
        } else if star_pi >= 0 {
            pi = star_pi + 1
            star_ti = star_ti + 1
            ti = star_ti
        } else {
            return false
        }
    }

    while pi < len(pattern) && pattern.slice(pi, pi + 1) == "*" {
        pi = pi + 1
    }

    pi == len(pattern)
}

func glob_files(dir, pattern) {
    let matches = []
    const all_files = discover_magi_files(dir)
    for file in all_files {
        const base = path_basename(file)
        if glob_match(pattern, base) {
            matches.push(file)
        }
    }
    matches
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: String Similarity (Jaro-Winkler)
// ═══════════════════════════════════════════════════════════════════

func jaro_distance(s1, s2) {
    const len1 = len(s1)
    const len2 = len(s2)
    if len1 == 0 && len2 == 0 { return 1.0 }
    if len1 == 0 || len2 == 0 { return 0.0 }

    const match_window = if len1 > len2 { len1 } else { len2 }
    const window = (match_window / 2) - 1

    let s1_matched = []
    let s2_matched = []
    let i = 0
    while i < len1 { s1_matched.push(false); i = i + 1 }
    i = 0
    while i < len2 { s2_matched.push(false); i = i + 1 }

    let matches = 0
    let transpositions = 0

    i = 0
    while i < len1 {
        const lo = if i - window > 0 { i - window } else { 0 }
        const hi = if i + window + 1 < len2 { i + window + 1 } else { len2 }
        let j = lo
        while j < hi {
            if !s2_matched[j] && s1.slice(i, i + 1) == s2.slice(j, j + 1) {
                s1_matched[i] = true
                s2_matched[j] = true
                matches = matches + 1
                break
            }
            j = j + 1
        }
        i = i + 1
    }

    if matches == 0 { return 0.0 }

    let k = 0
    i = 0
    while i < len1 {
        if s1_matched[i] {
            while !s2_matched[k] { k = k + 1 }
            if s1.slice(i, i + 1) != s2.slice(k, k + 1) {
                transpositions = transpositions + 1
            }
            k = k + 1
        }
        i = i + 1
    }

    const fm = to_float64(matches)
    (fm / to_float64(len1) + fm / to_float64(len2) + (fm - to_float64(transpositions) / 2.0) / fm) / 3.0
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Changelog Generation
// ═══════════════════════════════════════════════════════════════════

func generate_changelog(from_tag, to_tag) {
    let changelog = f"# Changelog ({from_tag} -> {to_tag})\n\n"

    const result = run_command_capture("git", ["log", f"{from_tag}..{to_tag}", "--oneline"])
    if typeof(result) != "string" {
        changelog = changelog + "No commits found.\n"
        return changelog
    }

    const lines = result.split("\n")
    let features = []
    let fixes = []
    let other = []

    for line in lines {
        const trimmed = line.trim()
        if len(trimmed) == 0 { continue }
        if trimmed.contains("feat") || trimmed.contains("add") {
            features.push(trimmed)
        } else if trimmed.contains("fix") || trimmed.contains("bug") {
            fixes.push(trimmed)
        } else {
            other.push(trimmed)
        }
    }

    if len(features) > 0 {
        changelog = changelog + "## Features\n"
        for f in features { changelog = changelog + f"- {f}\n" }
        changelog = changelog + "\n"
    }

    if len(fixes) > 0 {
        changelog = changelog + "## Bug Fixes\n"
        for f in fixes { changelog = changelog + f"- {f}\n" }
        changelog = changelog + "\n"
    }

    if len(other) > 0 {
        changelog = changelog + "## Other Changes\n"
        for o in other { changelog = changelog + f"- {o}\n" }
        changelog = changelog + "\n"
    }

    changelog
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Terminal Size Detection
// ═══════════════════════════════════════════════════════════════════

func get_terminal_width() {
    const cols = env_get("COLUMNS")
    if cols != null {
        const w = parse_int(cols)
        if w != null && w > 0 { return w }
    }
    // Try tput
    const result = run_command_capture("tput", ["cols"])
    if typeof(result) == "string" {
        const w = parse_int(result.trim())
        if w != null && w > 0 { return w }
    }
    80 // default
}

func get_terminal_height() {
    const lines = env_get("LINES")
    if lines != null {
        const h = parse_int(lines)
        if h != null && h > 0 { return h }
    }
    const result = run_command_capture("tput", ["lines"])
    if typeof(result) == "string" {
        const h = parse_int(result.trim())
        if h != null && h > 0 { return h }
    }
    24 // default
}
