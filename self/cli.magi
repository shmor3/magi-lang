func cmd_bloat() {
    println("Source analysis:")
    let total_lines = 0
    const entries = fs_list(".")
    if entries == null { return null }
    for entry in entries {
        if ends_with(entry, ".magi") {
            const content = fs_read(entry)
            if content != null {
                const lines = len(content.split("\n"))
                total_lines = total_lines + lines
                if lines > 100 {
                    println(f"  {entry} — {lines} lines")
