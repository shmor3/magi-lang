    "error_new" => {
        const msg = inp_get_or(inputs, "message", "error")
        {"message": to_string(msg), "cause": null}
    },
    "error_wrap" => {
        const inner = inp_get_or(inputs, "inner", null)
        const msg = inp_get_or(inputs, "message", "error")
        {"message": to_string(msg), "cause": inner}
    },
    "error_unwrap" => {
        const err = inp_get_or(inputs, "error", null)
        if typeof(err) == "map" && err.has("cause") { err["cause"] } else { null }
    },
    "error_is" => {
        const err = inp_get_or(inputs, "error", null)
        const target = inp_get_or(inputs, "target", null)
        const target_msg = to_string(target)
        let current = err
        while typeof(current) == "map" {
            if current.has("message") && current["message"] == target_msg { return true }
            if !current.has("cause") || current["cause"] == null { break }
            current = current["cause"]
        }
        false
    },
    "error_chain" => {
        const err = inp_get_or(inputs, "error", null)
        let chain = []
        let current = err
        while typeof(current) == "map" {
            if current.has("message") { chain.push(current["message"]) }
            if !current.has("cause") || current["cause"] == null { break }
            current = current["cause"]
        }
        chain
    },
    "json_get" => {
        const json_val = inp_get_or(inputs, "value", null)
        const path = inp_get_or(inputs, "path", null)
        if typeof(path) != "string" { return null }
        const parts = path.split(".")
        let current = json_val
        for part in parts {
            if len(part) == 0 { continue }
            if typeof(current) == "map" {
                if current.has(part) { current = current[part] }
                else { return null }
            } else if typeof(current) == "array" {
                const idx = parse_int(part)
                if idx != null && idx >= 0 && idx < len(current) { current = current[idx] }
                else { return null }
            } else { return null }
        }
        current
    },
    "json_set" => {
        const json_val = inp_get_or(inputs, "value", null)
        const path = inp_get_or(inputs, "path", null)
        const item = inp_get_or(inputs, "item", null)
        if typeof(json_val) == "map" && typeof(path) == "string" {
            let new_map = {}
            for k in keys(json_val) { new_map[k] = json_val[k] }
            new_map[path] = item
            return new_map
        }
        {"error": "json_set requires map and string path"}
    },
    "json_delete" => {
        const json_val = inp_get_or(inputs, "value", null)
        const path = inp_get_or(inputs, "path", null)
        if typeof(json_val) == "map" && typeof(path) == "string" {
            let new_map = {}
            for k in keys(json_val) {
                if k != path { new_map[k] = json_val[k] }
            }
            return new_map
        }
        {"error": "json_delete requires map and string path"}
    },
    "json_type" => {
        match typeof(input) {
            "null" => "null",
            "bool" => "boolean",
            "int64" | "float64" | "int32" | "uint32" | "uint64" | "float32" => "number",
            "string" => "string",
            "array" => "array",
            "map" => "object",
            _ => "unknown"
        }
    },
    "json_merge" => {
        if typeof(a) != "map" || typeof(b) != "map" {
            return {"error": "json_merge requires two maps"}
        }
        let merged = {}
        for k in keys(a) { merged[k] = a[k] }
        for k in keys(b) { merged[k] = b[k] }
        merged
    },
    "json_pretty_print" => {
        to_json_pretty(input)
    },
    "json_compact" => {
        to_json(input)
    },
    "json_validate" => {
        if typeof(input) != "string" { return false }
        const result = parse_json(input)
        result != null && !(typeof(result) == "map" && result.has("error"))
    },
    "json_flatten" => {
        json_flatten_recursive(input, "", {}, 0)
    },
    "json_query" => {
        const json_val = inp_get_or(inputs, "value", null)
        const path = inp_get_or(inputs, "path", null)
        if typeof(path) != "string" { return null }
        const parts = path.split(".")
        let current = json_val
        for part in parts {
            if len(part) == 0 { continue }
            if typeof(current) == "map" && current.has(part) { current = current[part] }
            else if typeof(current) == "array" {
                const idx = parse_int(part)
                if idx != null && idx >= 0 && idx < len(current) { current = current[idx] }
                else { return null }
            } else { return null }
        }
        current
    },
