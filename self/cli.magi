func cmd_repl() {
    println(f"MAGI {VERSION}  REPL")
    println("Type expressions to evaluate. Use 'exit' or Ctrl-D to quit.")
    println("")
    let running = true
    while running {
        print("magi> ")
        const line = input("")
        if line == null || line == "exit" || line == "quit" {
            running = false
            continue
        }
        if len(line.trim()) == 0 { continue }

        if starts_with(line, ":") {
            const repl_cmd = line.slice(1, len(line)).trim()
            match repl_cmd {
                "help" => {
                    println("REPL commands:")
                    println("  :help     Show this help")
                    println("  :type <e> Show type of expression")
                    println("  :ast <e>  Show AST of expression")
                    println("  :clear    Clear screen")
                    println("  :quit     Exit REPL")
                },
                "quit" => { running = false },
                "clear" => { print("\x1b[2J\x1b[H") },
                _ => {
                    if starts_with(repl_cmd, "type ") {
                        const expr_src = repl_cmd.slice(5, len(repl_cmd))
                        const program = parse(expr_src)
                        println(f"type: unknown")
                    } else {
                        println(f"Unknown REPL command: :{repl_cmd}")
                    }
                }
            }
            continue
        }

        const result = eval_expr_source(line)
        if result != null {
            println(to_string(result))
        }
    }
    println("Goodbye.")
}
func cmd_test(target, filter, timeout_ms) {
    if fs_is_dir(target) {
        cmd_test_dir(target, filter, timeout_ms)
        return null
    }
    const source = fs_read(target)
    if source == null {
        println(f"error: cannot read '{target}'")
        return null
    }
    const program = parse(source)

    let tests = []
    for stmt in program.statements {
        match stmt.kind {
            StmtKind::STestDef(name, body) => {
                if filter == null || name.contains(filter) {
                    tests.push({"name": name, "body": body})
                }
            },
            _ => {}
        }
    }

    if len(tests) == 0 {
        println("No tests found.")
        return null
    }

    let passed = 0
    let failed = 0
    let skipped = 0
    const start_time = now_timestamp()

    for t in tests {
        const test_name = t["name"]
        print(f"  test {test_name} ... ")
        let success = true
        let error_msg = ""
        eval_program_block(t["body"])
        if success {
            println("ok")
            passed = passed + 1
        } else {
            println(f"FAILED: {error_msg}")
            failed = failed + 1
        }
    }

    const elapsed = now_timestamp() - start_time
    println("")
    println(f"test result: {if failed == 0 { 'ok' } else { 'FAILED' }}. {passed} passed; {failed} failed; {skipped} skipped; finished in {elapsed}ms")
    null
}

func cmd_test_dir(dir, filter, timeout_ms) {
    const entries = fs_list(dir)
    if entries == null { return null }
    let test_files = []
    for entry in entries {
        if ends_with(entry, ".magi") && (starts_with(entry, "test_") || ends_with(entry, "_test.magi")) {
            test_files.push(dir + "/" + entry)
        }
    }
    for entry in entries {
        const full_path = dir + "/" + entry
        if fs_is_dir(full_path) {
            cmd_test_dir(full_path, filter, timeout_ms)
        }
    }
    for file in test_files {
        println(f"--- {file} ---")
        cmd_test(file, filter, timeout_ms)
    }
}

func eval_program_block(block) {
    if block == null { return null }
    null
}
func cmd_bench(file_path, iterations) {
    const source = fs_read(file_path)
    if source == null {
        println(f"error: cannot read file '{file_path}'")
        return null
    }
    println(f"Benchmarking {file_path} ({iterations} iterations)")
    println("")

    const program = parse(source)

    let benchmarks = []
    for stmt in program.statements {
        match stmt.kind {
            StmtKind::SFuncDef(fdef) => {
                if starts_with(fdef.name, "bench_") {
                    benchmarks.push(fdef.name)
                }
            },
            _ => {}
        }
    }

    if len(benchmarks) == 0 {
        benchmarks = ["<main>"]
    }

    for bench_name in benchmarks {
        const start_time = now_timestamp()
        let i = 0
        while i < iterations {
            if bench_name == "<main>" {
                run_source(source)
            }
            i = i + 1
        }
        const elapsed = now_timestamp() - start_time
        const avg_ns = if iterations > 0 { (elapsed * 1000000) / iterations } else { 0 }
        println(f"  {bench_name}: {iterations} iterations, {elapsed}ms total, {avg_ns}ns/iter")
    }
}
func cmd_coverage(file_path) {
    const source = fs_read(file_path)
    if source == null {
        println(f"error: cannot read file '{file_path}'")
        return null
    }
    const program = parse(source)

    let total_functions = 0
    let total_tests = 0
    let total_lines = source.split("\n")
    let code_lines = 0
    for line in total_lines {
        const trimmed = line.trim()
        if len(trimmed) > 0 && !starts_with(trimmed, "//") {
            code_lines = code_lines + 1
        }
    }

    for stmt in program.statements {
        match stmt.kind {
            StmtKind::SFuncDef(_) => { total_functions = total_functions + 1 },
            StmtKind::STestDef(_, _) => { total_tests = total_tests + 1 },
            _ => {}
        }
    }

    const fn_coverage = if total_functions > 0 { (total_tests * 100) / total_functions } else { 0 }
    println(f"Coverage report for {file_path}:")
    println(f"  Total lines:     {len(total_lines)}")
    println(f"  Code lines:      {code_lines}")
    println(f"  Functions:       {total_functions}")
    println(f"  Tests:           {total_tests}")
    println(f"  Function coverage: {fn_coverage}%")
}
func cmd_fmt_full(file_path, write_mode, check_mode) {
    const source = fs_read(file_path)
    if source == null {
        println(f"error: cannot read file '{file_path}'")
        return null
    }
    const formatted = fmt_source(source)
    if check_mode {
        if formatted == source {
            println(f"{file_path}: OK")
        } else {
            println(f"{file_path}: needs formatting")
        }
    } else if write_mode {
        fs_write(file_path, formatted)
        println(f"Formatted {file_path}")
    } else {
        println(formatted)
    }
}
func cmd_lint_full(file_path) {
    const source = fs_read(file_path)
    if source == null {
        println(f"error: cannot read file '{file_path}'")
        return null
    }
    const warnings = lint_source(source)
    if len(warnings) == 0 {
        println(f"{file_path}: no warnings")
    } else {
        for w in warnings {
            println(f"{file_path}: {w}")
        }
        println(f"{len(warnings)} warning(s)")
    }
}
func cmd_check_full(file_path, json_output) {
    const source = fs_read(file_path)
    if source == null {
        println(f"error: cannot read file '{file_path}'")
        return null
    }
    const result = check_source(source)
    const errors = result[0]
    const warnings = result[1]

    if json_output {
        println(to_json({"errors": errors, "warnings": warnings}))
    } else {
        for w in warnings { println(f"warning: {w}") }
        for err in errors { println(f"error: {err}") }
        if len(errors) == 0 {
            println("OK: no errors")
        } else {
            println(f"{len(errors)} error(s) found")
        }
    }
}
func cmd_doc(file_path) {
    const source = fs_read(file_path)
    if source == null {
        println(f"error: cannot read file '{file_path}'")
        return null
    }
    const program = parse(source)

    println(f"# Documentation for {file_path}")
    println("")

    for stmt in program.statements {
        match stmt.kind {
            StmtKind::SFuncDef(fdef) => {
                let param_strs = []
                for p in fdef.params {
                    let ps = p.name
                    if p.type_ann != null && p.type_ann != "" { ps = ps + ": " + p.type_ann }
                    if p.default_val != null { ps = ps + " = ..." }
                    param_strs.push(ps)
                }
                const ret = if fdef.return_type != null && fdef.return_type != "" { " -> " + fdef.return_type } else { "" }
                println(f"## func {fdef.name}({param_strs.join(', ')}){ret}")
                println("")
            },
            StmtKind::SStructDef(name, fields, _) => {
                let field_strs = []
                for f in fields { field_strs.push(f.name) }
                println(f"## struct {name}")
                println(f"  Fields: {field_strs.join(', ')}")
                println("")
            },
            StmtKind::SEnumDef(name, variants, _) => {
                let variant_strs = []
                for v in variants { variant_strs.push(v.name) }
                println(f"## enum {name}")
                println(f"  Variants: {variant_strs.join(', ')}")
                println("")
            },
            _ => {}
        }
    }
}
