func cmd_profile(args) {
    if len(args) == 0 {
        println("Usage: magi profile <file.magi> [--output <file>] [--format <text|json|flamegraph>]")
        return null
    }

    const file_path = args[0]
    const out_path = find_flag_value(args, "--output")
    const format = find_flag_value(args, "--format")
    const format_type = if format != null { format } else { "text" }

    println(f"Profiling: {file_path}")

    let profile_data = {
        "call_counts": {"__s": true},
        "call_times": {"__s": true},
        "alloc_counts": {"__s": true},
        "peak_memory": 0,
        "total_time": 0,
    }

    const start_time = timestamp_ms()

    const source = read_file_safe(file_path)
    if source != null {
        const program = parse(source)
        eval_program(program)
    }

    profile_data["total_time"] = timestamp_ms() - start_time

    match format_type {
        "json" => {
            println(json_stringify(profile_data))
        },
        "flamegraph" => {
            println("# Flamegraph format (pipe to flamegraph.pl)")
            for name in profile_data["call_counts"].keys() {
                if name == "__s" { continue }
                const count = profile_data["call_counts"][name]
                const time = if profile_data["call_times"].has(name) {
                    profile_data["call_times"][name]
                } else { 0 }
                println(f"{name} {time}")
            }
        },
        _ => {
            println(f"\nProfile results ({profile_data[\"total_time\"]}ms total):")
            println(f"  {'Function':-40s} {'Calls':>10s} {'Time (us)':>12s} {'Avg (us)':>10s}")
            println("  " + "-".repeat(74))
        },
    }

    profile_data
}

func find_flag_value(args, flag) {
    let i = 0
    while i < len(args) {
        if args[i] == flag && i + 1 < len(args) {
            return args[i + 1]
        }
        i = i + 1
    }
    null
}
func cmd_leak_check(args) {
    if len(args) == 0 {
        println("Usage: magi leak-check <file.magi>")
        return null
    }

    const file_path = args[0]
    println(f"Checking for memory leaks: {file_path}")

    let alloc_sites = {"__s": true}
    let dealloc_count = 0
    let alloc_count = 0
    let peak_objects = 0
    let current_objects = 0

    const before_stats = i_memory_stats()

    const source = read_file_safe(file_path)
    if source != null {
        const program = parse(source)
        eval_program(program)
    }

    const after_stats = i_memory_stats()

    const leaked_bytes = after_stats["used"] - before_stats["used"]
    const leaked_objects = after_stats["heap_objects"] - before_stats["heap_objects"]

    if leaked_bytes > 0 || leaked_objects > 0 {
        println(f"\nPotential memory leaks detected:")
        println(f"  Leaked bytes:   {leaked_bytes}")
        println(f"  Leaked objects: {leaked_objects}")
        println(f"  Peak memory:    {after_stats[\"used\"]} bytes")
    } else {
        println(f"\nNo memory leaks detected.")
        println(f"  Final memory: {after_stats[\"used\"]} bytes")
    }

    {"leaked_bytes": leaked_bytes, "leaked_objects": leaked_objects}
}
func repl_with_recovery() {
    println(f"MAGI {VERSION} REPL")
    println("Type 'exit' or Ctrl+D to quit. ':help' for commands.\n")

    let history = []
    let context = i_new_scope()
    let multi_line_buffer = ""
    let in_multi_line = false
    let brace_depth = 0

    while true {
        const prompt = if in_multi_line { "... " } else { ">>> " }
        const line = read_line(prompt)
        if line == null { break }

        if !in_multi_line {
            if line.trim() == "exit" || line.trim() == ":quit" || line.trim() == ":q" { break }
            if line.trim() == ":help" || line.trim() == ":h" {
                repl_help()
                continue
            }
            if line.trim() == ":clear" || line.trim() == ":cls" {
                println("\x1b[2J\x1b[H")
                continue
            }
            if line.trim() == ":history" {
                for h in history { println(h) }
                continue
            }
            if line.trim() == ":reset" {
                context = i_new_scope()
                i_scopes = [i_new_scope()]
                println("Environment reset.")
                continue
            }
            if line.trim() == ":env" {
                const scope = i_scopes[len(i_scopes) - 1]
                for k in scope.keys() {
                    if k == "__s" { continue }
                    println(f"  {k} = {i_display(scope[k][\"value\"])}")
                }
                continue
            }
            if line.trim() == ":type" {
                println("Type checking mode not yet implemented.")
                continue
            }
        }

        for c in line.chars() {
            if c == "{" || c == "(" || c == "[" { brace_depth = brace_depth + 1 }
            if c == "}" || c == ")" || c == "]" { brace_depth = brace_depth - 1 }
        }

        if in_multi_line {
            multi_line_buffer = multi_line_buffer + "\n" + line
            if brace_depth <= 0 {
                in_multi_line = false
                const input = multi_line_buffer
                multi_line_buffer = ""
                brace_depth = 0
                repl_eval_with_recovery(input, history)
            }
        } else if brace_depth > 0 {
            in_multi_line = true
            multi_line_buffer = line
        } else {
            repl_eval_with_recovery(line, history)
        }
    }

    println("Goodbye!")
}

func repl_eval_with_recovery(input, history) {
    if input.trim() == "" { return }
    history.push(input)

    let program = null
    let parse_ok = true
    const expr_source = input
    program = try_parse(expr_source)
    if program == null {
        parse_ok = false
    }

    if !parse_ok {
        println(f"Parse error. Check syntax and try again.")
        return
    }

    const result = try_eval(program)
    if result != null && typeof(result) == "map" && result.has("__error") {
        println(f"Runtime error: {result[\"__error\"]}")
    } else if result != null {
        println(i_display(result))
    }
}

func try_parse(source) {
    parse(source)
}

func try_eval(program) {
    eval_program(program)
}

func repl_help() {
    println("REPL Commands:")
    println("  :help, :h     - Show this help")
    println("  :quit, :q     - Exit REPL")
    println("  :clear, :cls  - Clear screen")
    println("  :history      - Show command history")
    println("  :reset        - Reset environment")
    println("  :env          - Show current variables")
    println("  :type <expr>  - Show type of expression")
    println("")
    println("Multi-line input: open a brace/paren to continue on next line.")
    println("Use 'exit' or Ctrl+D to quit.")
}

