func cmd_get() {
    const deps = resolve_project_deps(".")
    if len(deps) == 0 {
        println("No dependencies to fetch.")
        return null
    }
    let fetched = 0
    for dep in deps {
        const pkg_dir = find_package_dir(dep["name"])
        if pkg_dir != null {
            println(f"  {dep['name']} (cached)")
            fetched = fetched + 1
        } else {
            println(f"  Fetching {dep['name']}...")
