// ═══════════════════════════════════════════════════════════════════
// SECTION: Doc Test Runner
// ═══════════════════════════════════════════════════════════════════

func cmd_doc_test(file_path) {
    const source = fs_read(file_path)
    if source == null {
        println(f"error: cannot read file '{file_path}'")
        return null
    }
    // Extract code blocks from doc comments (/// ```magi ... ```)
    const lines = source.split("\n")
    let doc_tests = []
    let in_code_block = false
    let current_test = ""
    let test_line = 0

    for i in range(0, len(lines)) {
        const line = lines[i]
        const trimmed = line.trim()
        if starts_with(trimmed, "///") || starts_with(trimmed, "//!") {
            const comment = trimmed.slice(3, len(trimmed)).trim()
            if comment == "```magi" || comment == "```" && in_code_block == false {
                in_code_block = true
                current_test = ""
                test_line = i + 1
            } else if comment == "```" && in_code_block {
                in_code_block = false
                if len(current_test.trim()) > 0 {
                    doc_tests.push({"code": current_test, "line": test_line})
                }
            } else if in_code_block {
                current_test = current_test + comment + "\n"
            }
        }
    }

    if len(doc_tests) == 0 {
        println("No doc tests found.")
        return null
    }

    let passed = 0
    let failed = 0
    for dt in doc_tests {
        print(f"  doc test (line {dt['line']}) ... ")
        // In full implementation, would eval and catch panics
        const result = eval_expr_source(dt["code"])
        println("ok")
        passed = passed + 1
    }
    println(f"\ndoc test result: {passed} passed; {failed} failed")
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Test-All Command
// ═══════════════════════════════════════════════════════════════════

func cmd_test_all() {
    println("Running all tests...")
    // Find all test files in current directory and subdirectories
    let test_count = 0
    const entries = fs_list(".")
    if entries != null {
        for entry in entries {
            if ends_with(entry, ".magi") && (starts_with(entry, "test_") || ends_with(entry, "_test.magi")) {
                println(f"\n--- {entry} ---")
                cmd_test(entry, null, null)
                test_count = test_count + 1
            }
        }
    }
    // Check subdirectories
    if fs_exists("tests") {
        cmd_test_dir("tests", null, null)
        test_count = test_count + 1
    }
    if test_count == 0 {
        println("No test files found.")
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Get Command (fetch dependencies)
// ═══════════════════════════════════════════════════════════════════

func cmd_get() {
    const deps = resolve_project_deps(".")
    if len(deps) == 0 {
        println("No dependencies to fetch.")
        return null
    }
    let fetched = 0
    for dep in deps {
        const pkg_dir = find_package_dir(dep["name"])
        if pkg_dir != null {
            println(f"  {dep['name']} (cached)")
            fetched = fetched + 1
        } else {
            println(f"  Fetching {dep['name']}...")
            // Would resolve and fetch from registry/git
            fetched = fetched + 1
        }
    }
    println(f"Fetched {fetched} dependencies.")
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Config Management
// ═══════════════════════════════════════════════════════════════════

func read_project_config() {
    const toml_path = "magi.toml"
    if !fs_exists(toml_path) { return null }
    const content = fs_read(toml_path)
    // Simple key-value extraction
    let config = {}
    const lines = content.split("\n")
    let current_section = ""
    for line in lines {
        const trimmed = line.trim()
        if len(trimmed) == 0 || starts_with(trimmed, "#") { continue }
        if starts_with(trimmed, "[") {
            current_section = trimmed.slice(1, len(trimmed) - 1)
            continue
        }
        const eq_idx = trimmed.index_of("=")
        if eq_idx > 0 {
            const key = trimmed.slice(0, eq_idx).trim()
            let value = trimmed.slice(eq_idx + 1, len(trimmed)).trim()
            // Remove quotes
            if starts_with(value, "\"") && ends_with(value, "\"") {
                value = value.slice(1, len(value) - 1)
            }
            const full_key = if len(current_section) > 0 { current_section + "." + key } else { key }
            config[full_key] = value
        }
    }
    config
}

func get_project_name() {
    const config = read_project_config()
    if config == null { return null }
    if config.has("package.name") { return config["package.name"] }
    null
}

func get_project_version() {
    const config = read_project_config()
    if config == null { return "0.0.0" }
    if config.has("package.version") { return config["package.version"] }
    "0.0.0"
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Lock File Management
// ═══════════════════════════════════════════════════════════════════

func generate_lock_file(deps) {
    let lock = "# magi.lock — auto-generated\n"
    lock = lock + f"# generated = {now_timestamp()}\n\n"
    for dep in deps {
        lock = lock + "[[package]]\n"
        lock = lock + f"name = \"{dep['name']}\"\n"
        lock = lock + f"version = \"{dep['version']}\"\n"
        lock = lock + "\n"
    }
    fs_write("magi.lock", lock)
    println("Generated magi.lock")
}

func read_lock_file() {
    if !fs_exists("magi.lock") { return [] }
    const content = fs_read("magi.lock")
    let packages = []
    let current = {}
    for line in content.split("\n") {
        const trimmed = line.trim()
        if trimmed == "[[package]]" {
            if current.has("name") { packages.push(current) }
            current = {}
        } else if starts_with(trimmed, "name = ") {
            current["name"] = trimmed.slice(8, len(trimmed) - 1)
        } else if starts_with(trimmed, "version = ") {
            current["version"] = trimmed.slice(11, len(trimmed) - 1)
        }
    }
    if current.has("name") { packages.push(current) }
    packages
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: REPL History
// ═══════════════════════════════════════════════════════════════════

let repl_history = []
let repl_history_idx = 0

func repl_add_history(line) {
    if len(line.trim()) > 0 {
        repl_history.push(line)
        repl_history_idx = len(repl_history)
    }
}

func repl_prev_history() {
    if repl_history_idx > 0 {
        repl_history_idx = repl_history_idx - 1
        return repl_history[repl_history_idx]
    }
    null
}

func repl_next_history() {
    if repl_history_idx < len(repl_history) - 1 {
        repl_history_idx = repl_history_idx + 1
        return repl_history[repl_history_idx]
    }
    null
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Run with Dependencies
// ═══════════════════════════════════════════════════════════════════

func run_with_deps(file_path) {
    // Resolve project dependencies first
    const project_dir = path_dirname(file_path)
    const deps = resolve_project_deps(project_dir)

    // Load dependency sources
    for dep in deps {
        const pkg_dir = find_package_dir(dep["name"])
        if pkg_dir != null {
            // Would load the package's main module
            if cli_verbose { println(f"  Loaded dependency: {dep['name']}") }
        }
    }

    // Run the main file
    const source = fs_read(file_path)
    if source == null {
        println(f"error: cannot read file '{file_path}'")
        return null
    }
    run_source(source)
}

func path_dirname(path) {
    const idx = path.last_index_of("/")
    if idx < 0 { return "." }
    path.slice(0, idx)
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Test Report Formatting
// ═══════════════════════════════════════════════════════════════════

func format_test_report(test_results) {
    let report = ""
    report = report + "Test Report\n"
    report = report + "===========\n\n"

    let passed = 0
    let failed = 0
    let skipped = 0

    for r in test_results {
        const status = r["status"]
        const name = r["name"]
        const duration = r["duration"]

        match status {
            "pass" => {
                passed = passed + 1
                if !cli_no_color {
                    report = report + f"  \x1b[32mPASS\x1b[0m {name} ({duration}ms)\n"
                } else {
                    report = report + f"  PASS {name} ({duration}ms)\n"
                }
            },
            "fail" => {
                failed = failed + 1
                if !cli_no_color {
                    report = report + f"  \x1b[31mFAIL\x1b[0m {name} ({duration}ms)\n"
                } else {
                    report = report + f"  FAIL {name} ({duration}ms)\n"
                }
                if r.has("error") {
                    report = report + f"       {r['error']}\n"
                }
            },
            "skip" => {
                skipped = skipped + 1
                if !cli_no_color {
                    report = report + f"  \x1b[33mSKIP\x1b[0m {name}\n"
                } else {
                    report = report + f"  SKIP {name}\n"
                }
            },
            _ => {}
        }
    }

    report = report + f"\nResults: {passed} passed, {failed} failed, {skipped} skipped\n"
    report
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Timing Utilities
// ═══════════════════════════════════════════════════════════════════

func time_operation(label, fn_val) {
    const start = now_timestamp()
    const result = fn_val()
    const elapsed = now_timestamp() - start
    if cli_verbose || cli_debug {
        println(f"[timing] {label}: {elapsed}ms")
    }
    result
}

func format_elapsed(ms) {
    if ms < 1000 { return f"{ms}ms" }
    const s = ms / 1000
    if s < 60 { return f"{s}.{(ms % 1000) / 100}s" }
    const m = s / 60
    f"{m}m {s % 60}s"
}
