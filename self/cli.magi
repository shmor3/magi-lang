const ENV_FLAGS = [
    "MAGI_DEBUG",       // Enable debug output
    "MAGI_TRACE",       // Enable execution tracing
    "MAGI_SANDBOX",     // Enable sandbox mode (no OS access)
    "MAGI_NO_COLOR",    // Disable colored output
    "MAGI_JSON",        // Output in JSON format
    "MAGI_QUIET",       // Suppress non-essential output
    "MAGI_VERBOSE",     // Enable verbose output
    "MAGI_BACKTRACE",   // Enable backtrace on errors
    "MAGI_HOME",        // Home directory for MAGI toolchain
    "MAGI_PATH",        // Package search path
    "MAGI_CACHE",       // Cache directory
    "MAGI_LOG",         // Log level (error, warn, info, debug, trace)
    "MAGI_TARGET",      // Build target directory
    "MAGI_INCREMENTAL", // Enable incremental compilation
    "MAGI_TOOLCHAIN",   // Toolchain version
    "MAGI_PROXY"        // Package registry proxy
]

func env_flag(name) {
    const val = env_get(name)
    if val == null || val == "" || val == "0" || val == "false" {
        return false
    }
    true
}

func env_flag_value(name, default_val) {
    const val = env_get(name)
    if val == null || val == "" { return default_val }
    val
}

let cli_debug = false
let cli_trace = false
let cli_sandbox = false
let cli_no_color = false
let cli_json = false
let cli_quiet = false
let cli_verbose = false

func cli_init_flags() {
    cli_debug = env_flag("MAGI_DEBUG")
    cli_trace = env_flag("MAGI_TRACE")
    cli_sandbox = env_flag("MAGI_SANDBOX")
    cli_no_color = env_flag("MAGI_NO_COLOR")
    cli_json = env_flag("MAGI_JSON")
    cli_quiet = env_flag("MAGI_QUIET")
    cli_verbose = env_flag("MAGI_VERBOSE")
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Argument Parsing
// ═══════════════════════════════════════════════════════════════════

// Parse CLI arguments into { command, flags, positional }
func parse_args(raw_args) {
    let flags = {}
    let positional = []
    let command = null

    let i = 0
    while i < len(raw_args) {
        const arg = raw_args[i]
        if starts_with(arg, "--") {
            const flag_name = arg.slice(2, len(arg))
            // Check if next arg is a value (not another flag)
            if i + 1 < len(raw_args) && !starts_with(raw_args[i + 1], "-") {
                flags[flag_name] = raw_args[i + 1]
                i = i + 2
            } else {
                flags[flag_name] = true
                i = i + 1
            }
        } else if starts_with(arg, "-") && len(arg) == 2 {
            const flag_char = arg[1]
            // Short flags
            match flag_char {
                "h" => { flags["help"] = true },
                "V" => { flags["version"] = true },
                "v" => { flags["verbose"] = true },
                "q" => { flags["quiet"] = true },
                "w" => { flags["write"] = true },
                "c" => { flags["check"] = true },
                "n" => {
                    if i + 1 < len(raw_args) {
                        flags["iterations"] = raw_args[i + 1]
                        i = i + 1
                    }
                },
                _ => { flags[to_string(flag_char)] = true }
            }
            i = i + 1
        } else {
            if command == null {
                command = arg
            } else {
                positional.push(arg)
            }
            i = i + 1
        }
    }

    {"command": command, "flags": flags, "positional": positional}
}

