// SECTION: Error Code Reference
// ═══════════════════════════════════════════════════════════════════

const ERROR_CODES = {
    "E100": "Syntax error",
    "E101": "Unexpected token",
    "E102": "Unterminated string literal",
    "E103": "Unterminated block comment",
    "E104": "Invalid number literal",
    "E105": "Invalid escape sequence",
    "E200": "Type error",
    "E201": "Undefined variable",
    "E202": "Undefined function",
    "E203": "Argument count mismatch",
    "E204": "Type mismatch in assignment",
    "E205": "Cannot assign to immutable variable",
    "E206": "Duplicate definition",
    "E207": "Invalid return type",
    "E300": "Runtime error",
    "E301": "Division by zero",
    "E302": "Integer overflow",
    "E303": "Stack overflow",
    "E304": "Index out of bounds",
    "E305": "Key not found",
    "E306": "Assertion failed",
    "E307": "Timeout exceeded",
    "E400": "IO error",
    "E401": "File not found",
    "E402": "Permission denied",
    "E403": "Network error",
    "E404": "Connection refused",
    "E405": "DNS resolution failed",
    "E406": "Certificate error",
    "E407": "Sandbox violation",
    "E408": "Resource limit exceeded",
    "E409": "Invalid format"
}

func error_code_message(code) {
    if ERROR_CODES.has(code) { ERROR_CODES[code] }
    else { "Unknown error" }
}

func suggest_did_you_mean(name, candidates) {
    // Simple Levenshtein-distance based suggestion
    let best = null
    let best_dist = 999

    for candidate in candidates {
        const dist = levenshtein_distance(name, candidate)
        if dist < best_dist && dist <= 3 {
            best = candidate
            best_dist = dist
        }
    }

    best
}

func levenshtein_distance(s1, s2) {
    const m = len(s1)
    const n = len(s2)
    if m == 0 { return n }
    if n == 0 { return m }

    // Use two rows for space efficiency
    let prev = []
    let curr = []
    let i = 0
    while i <= n { prev.push(i); curr.push(0); i = i + 1 }

    i = 1
    while i <= m {
        curr[0] = i
        let j = 1
        while j <= n {
            const cost = if s1.slice(i - 1, i) == s2.slice(j - 1, j) { 0 } else { 1 }
            const del = prev[j] + 1
            const ins = curr[j - 1] + 1
            const sub = prev[j - 1] + cost
            let min_val = del
            if ins < min_val { min_val = ins }
            if sub < min_val { min_val = sub }
            curr[j] = min_val
            j = j + 1
        }
        // Swap rows
        let temp = prev
        prev = curr
        curr = temp
        i = i + 1
    }

    prev[n]
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: HTTP Client Wrapper
// ═══════════════════════════════════════════════════════════════════

func http_client_request(method, url, body, headers, timeout_ms) {
    // Validate URL
    const url_check = validate_url(url)
    if url_check != null { return url_check }

    // Build request options
    let opts = {
        "method": method,
        "url": url
    }
    if body != null { opts["body"] = body }
    if headers != null { opts["headers"] = headers }
    if timeout_ms != null { opts["timeout"] = timeout_ms }

    // Delegate to host HTTP client
    http_request(method, url, body, headers)
}

func http_client_get(url) { http_client_request("GET", url, null, null, null) }
func http_client_post(url, body) { http_client_request("POST", url, body, null, null) }
func http_client_put(url, body) { http_client_request("PUT", url, body, null, null) }
func http_client_delete(url) { http_client_request("DELETE", url, null, null, null) }

// ═══════════════════════════════════════════════════════════════════
// SECTION: Process Spawning
// ═══════════════════════════════════════════════════════════════════

func spawn_process(command, args, opts) {
    if cli_sandbox {
        return {"error": "process spawning is not allowed in sandbox mode"}
    }

    let effective_opts = if opts != null { opts } else { {} }
    let cwd = if effective_opts.has("cwd") { effective_opts["cwd"] } else { null }
    let env_vars = if effective_opts.has("env") { effective_opts["env"] } else { null }

    const result = exec_cmd(command, args)
    result
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Full Dispatch v2 (Enhanced)
// ═══════════════════════════════════════════════════════════════════

func dispatch_v2(raw_args) {
    // Initialize environment flags
    cli_init_flags()

    // Parse all arguments
    const parsed = parse_args_full(raw_args)
    const command = parsed["command"]
    const flags = parsed["flags"]
    const positional = parsed["positional"]

    // Handle global flags
    if flags.has("help") && command == null { print_help_full(); return null }
    if flags.has("version") && command == null { print_version(); return null }

    if command == null {
        print_help_full()
        return null
    }

    // Run pre-command hook
    run_hook("pre-" + command)

    const result = match command {
        "run" => {
            if len(positional) < 1 {
                println("Usage: magi run [options] <file.magi>")
                return null
            }
            cmd_run_full(positional[0], flags)
        },
        "compilec" | "build-class" => {
            if len(positional) < 1 { println("Usage: magi compilec <file.magi>"); return null }
            cmd_compilec_full(positional[0], flags)
        },
        "runc" | "run-class" => {
            if len(positional) < 1 { println("Usage: magi runc <file.magc>"); return null }
            cmd_runc_full(positional[0], flags)
        },
        "run-bc" | "run-bytecode" => {
            if len(positional) < 1 { println("Usage: magi run-bc <file.magi>"); return null }
            cmd_run_bc_full(positional[0], flags)
        },
        "compile" | "build" => {
            if len(positional) < 1 { println("Usage: magi compile <file.magi>"); return null }
            cmd_compile_full(positional[0], flags)
        },
        "run-wasm" => {
            if len(positional) < 1 { println("Usage: magi run-wasm <file.wasm>"); return null }
            cmd_run_wasm_full(positional[0], flags)
        },
        "compile-native" | "build-native" => {
            if len(positional) < 1 { println("Usage: magi compile-native <file.magi>"); return null }
            cmd_compile_native_full(positional[0], flags)
        },
        "test" => {
            if len(positional) < 1 { println("Usage: magi test [options] <file|dir>"); return null }
            cmd_test_full(positional[0], flags)
        },
        "test-all" => cmd_test_all(),
        "bench" => {
            if len(positional) < 1 { println("Usage: magi bench [-n <iterations>] <file.magi>"); return null }
            const iters = if flags.has("iterations") { parse_int(flags["iterations"]) } else { 100 }
            cmd_bench_full(positional[0], iters, flags)
        },
        "coverage" | "cover" => {
            if len(positional) < 1 { println("Usage: magi coverage <file.magi>"); return null }
            cmd_coverage_full(positional[0], flags)
        },
        "fmt" | "format" => {
            if len(positional) < 1 { println("Usage: magi fmt [options] <file.magi>"); return null }
            cmd_fmt_complete(positional[0], flags)
        },
        "lint" => {
            if len(positional) < 1 { println("Usage: magi lint <file.magi>"); return null }
            cmd_lint_full(positional[0])
        },
        "check" => {
            if len(positional) < 1 { println("Usage: magi check [--json] <file.magi>"); return null }
            cmd_check_full(positional[0], flags.has("json") || cli_json)
        },
        "doc" => {
            if len(positional) < 1 { println("Usage: magi doc <file.magi>"); return null }
            cmd_doc(positional[0])
        },
        "doc-test" => {
            if len(positional) < 1 { println("Usage: magi doc-test <file.magi>"); return null }
            cmd_doc_test(positional[0])
        },
        "repl" => cmd_repl(),
        "eval" => {
            if len(positional) < 1 { println("Usage: magi eval '<expr>'"); return null }
            const r = eval_expr_source(positional.join(" "))
            if r != null { println(to_string(r)) }
            null
        },
        "lsp" => cmd_lsp(),
        "mcp" => cmd_mcp(),
        "debug" | "dbg" => {
            if len(positional) < 1 { println("Usage: magi debug <file.magi>"); return null }
            cmd_debug(positional[0])
        },
        "init" => {
            if len(positional) < 1 { println("Usage: magi init <project-name>"); return null }
            cmd_init(positional[0])
        },
        "add" => {
            if len(positional) < 1 { println("Usage: magi add <package>"); return null }
            const ver = if flags.has("version") { flags["version"] } else { null }
            const git = if flags.has("git") { flags["git"] } else { null }
            cmd_add(positional[0], ver, git)
        },
        "remove" | "rm" => {
            if len(positional) < 1 { println("Usage: magi remove <package>"); return null }
            cmd_remove(positional[0])
        },
        "install" => {
            if len(positional) < 1 { println("Usage: magi install <url>"); return null }
            cmd_install(positional[0])
        },
        "uninstall" => {
            if len(positional) < 1 { println("Usage: magi uninstall <package>"); return null }
            cmd_uninstall(positional[0])
        },
        "publish" => cmd_publish(),
        "update" => cmd_update(),
        "audit" => cmd_audit(),
        "clean" => cmd_clean(),
        "env" => cmd_env(),
        "search" => {
            if len(positional) < 1 { println("Usage: magi search <query>"); return null }
            cmd_search(positional[0])
        },
        "expand" => {
            if len(positional) < 1 { println("Usage: magi expand <file.magi>"); return null }
            cmd_expand(positional[0])
        },
        "vm-stats" => {
            const file = if len(positional) > 0 { positional[0] } else { null }
            cmd_vm_stats(file)
        },
        "tree" => cmd_tree(),
        "fix" => {
            if len(positional) < 1 { println("Usage: magi fix <file.magi>"); return null }
            cmd_fix(positional[0])
        },
        "get" => cmd_get(),
        "vendor" => cmd_vendor(),
        "profile" => {
            if len(positional) < 1 { println("Usage: magi profile <file.magi>"); return null }
            cmd_profile(positional[0])
        },
        "bloat" => cmd_bloat(),
        "trace" => cmd_trace(),
        "generate" => cmd_generate(),
        "workspace" => cmd_workspace(),
        "completions" => {
            const shell = if len(positional) > 0 { positional[0] } else { "bash" }
            cmd_completions(shell)
        },
        "version" | "--version" | "-V" => print_version(),
        "help" | "--help" | "-h" => print_help_full(),
        _ => {
            // Check if it's a .magi file passed directly
            if ends_with(command, ".magi") {
                cmd_run_full(command, flags)
            } else {
                println(f"error: unknown command '{command}'")
                const suggestion = suggest_did_you_mean(command, [
                    "run", "check", "lint", "fmt", "eval", "repl", "test", "bench",
                    "compile", "compile-native", "compilec", "runc", "run-bc", "run-wasm",
                    "doc", "lsp", "mcp", "debug", "init", "add", "remove", "install",
                    "publish", "update", "audit", "clean", "env", "search", "expand",
                    "vm-stats", "tree", "fix", "version", "help", "coverage", "profile"
                ])
                if suggestion != null {
                    println(f"  Did you mean '{suggestion}'?")
                }
                println("")
                print_help_full()
            }
            null
        }
    }

    // Run post-command hook
    run_hook("post-" + command)

    result
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Watch Mode (Full)
// ═══════════════════════════════════════════════════════════════════

func cmd_watch_full(file_path, flags) {
    const json_output = flags.has("json") || cli_json

    if !cli_quiet { println(f"Watching {file_path} for changes...") }

    let last_size = -1
    let last_run = 0

    while true {
        sleep(500)
        const current_size = fs_size(file_path)
        if current_size != last_size && now_timestamp() - last_run > 1000 {
            last_size = current_size
            last_run = now_timestamp()

            if !cli_quiet {
                if !cli_no_color {
                    print("\x1b[2J\x1b[H") // Clear screen
                }
                println(f"--- Re-running {file_path} ({format_elapsed(now_timestamp())}) ---\n")
            }

            cmd_run_full(file_path, flags)
        }
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: JSON Error Output
// ═══════════════════════════════════════════════════════════════════

func output_errors_json(file_path, errors, warnings) {
    let error_list = []
    for err in errors {
        let entry = {}
        if typeof(err) == "map" {
            entry = err
        } else {
            entry = {"message": to_string(err)}
        }
        entry["severity"] = "error"
        entry["file"] = file_path
        error_list.push(entry)
    }

    let warning_list = []
    for w in warnings {
        let entry = {}
        if typeof(w) == "map" {
            entry = w
        } else {
            entry = {"message": to_string(w)}
        }
        entry["severity"] = "warning"
        entry["file"] = file_path
        warning_list.push(entry)
    }

    output_json({
        "diagnostics": error_list + warning_list,
        "error_count": len(errors),
        "warning_count": len(warnings),
        "ok": len(errors) == 0
    })
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Diff Utility
// ═══════════════════════════════════════════════════════════════════

func simple_diff(original, modified) {
    const orig_lines = original.split("\n")
    const mod_lines = modified.split("\n")
    let result = ""
    let i = 0
    const max_lines = if len(orig_lines) > len(mod_lines) { len(orig_lines) } else { len(mod_lines) }

    while i < max_lines {
        const orig = if i < len(orig_lines) { orig_lines[i] } else { null }
        const mod = if i < len(mod_lines) { mod_lines[i] } else { null }

        if orig == null && mod != null {
            result = result + f"+{i + 1}: {mod}\n"
        } else if orig != null && mod == null {
            result = result + f"-{i + 1}: {orig}\n"
        } else if orig != mod {
            result = result + f"-{i + 1}: {orig}\n"
            result = result + f"+{i + 1}: {mod}\n"
        }
        i = i + 1
    }

    if len(result) == 0 { return "No differences." }
    result
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Source File Utilities
// ═══════════════════════════════════════════════════════════════════

func read_source_safe(path) {
    // Check file exists
    if !fs_exists(path) {
        return {"error": f"cannot read '{path}': file not found"}
    }

    // Check file size
    const size = fs_size(path)
    if size > 67108864 { // 64 MB
        return {"error": f"'{path}' exceeds maximum source file size ({size} bytes, limit 67108864 bytes)"}
    }

    const source = fs_read(path)
    if source == null {
        return {"error": f"cannot read '{path}'"}
    }

    // Strip UTF-8 BOM
    let effective = source
    if starts_with(source, "\xEF\xBB\xBF") {
        effective = source.slice(3, len(source))
    }

    // Check for null bytes (binary file)
    if effective.contains("\x00") {
        return {"error": f"'{path}' appears to be a binary file"}
    }

    effective
}

func count_source_lines(source) {
    const lines = source.split("\n")
    let code = 0
    let comments = 0
    let blank = 0
    for line in lines {
        const trimmed = line.trim()
        if len(trimmed) == 0 { blank = blank + 1 }
        else if starts_with(trimmed, "//") { comments = comments + 1 }
        else { code = code + 1 }
    }
    {"total": len(lines), "code": code, "comments": comments, "blank": blank}
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: REPL v2 — Full Interactive Session
// ═══════════════════════════════════════════════════════════════════

func cmd_repl_full() {
    println(f"MAGI {VERSION} (self-hosted) REPL")
    println("Type expressions to evaluate. Press Ctrl-D to exit.")
    println("Type :help for REPL commands.")
    println("")

    let running = true
    let scope = {}
    let history_lines = []
    let line_count = 0

    while running {
        print(">>> ")
        const line = input("")
        if line == null {
            running = false
            continue
        }

        const trimmed = line.trim()
        if len(trimmed) == 0 { continue }

        // Record history
        repl_add_history(trimmed)
        line_count = line_count + 1

        // Multiline support: if line ends with {, (, [, or \, keep reading
        let full_line = trimmed
        while ends_with(full_line, "{") || ends_with(full_line, "(") ||
              ends_with(full_line, "[") || ends_with(full_line, "\\") {
            if ends_with(full_line, "\\") {
                full_line = full_line.slice(0, len(full_line) - 1)
            }
            print("... ")
            const cont = input("")
            if cont == null { break }
            full_line = full_line + "\n" + cont
        }

        // REPL commands
        if starts_with(full_line, ":") {
            const repl_cmd = full_line.slice(1, len(full_line)).trim()
            const cmd_parts = repl_cmd.split(" ")
            const cmd_name = cmd_parts[0]

            match cmd_name {
                "help" => {
                    println("REPL Commands:")
                    println("  :help         Show this help")
                    println("  :quit         Exit REPL")
                    println("  :clear        Clear screen")
                    println("  :type <expr>  Show type of expression")
                    println("  :time <expr>  Time an expression")
                    println("  :load <file>  Load and execute a file")
                    println("  :save <file>  Save REPL history to file")
                    println("  :history      Show REPL history")
                    println("  :reset        Reset REPL state")
                    println("  :env          Show environment")
                    println("  :ast <expr>   Show AST of expression")
                },
                "quit" | "exit" | "q" => { running = false },
                "clear" | "cls" => { print("\x1b[2J\x1b[H") },
                "type" => {
                    if len(cmd_parts) > 1 {
                        const expr = repl_cmd.slice(5, len(repl_cmd))
                        const result = eval_expr_source(expr)
                        println(f"type: {typeof(result)}")
                    } else {
                        println("Usage: :type <expression>")
                    }
                },
                "time" => {
                    if len(cmd_parts) > 1 {
                        const expr = repl_cmd.slice(5, len(repl_cmd))
                        const start = now_timestamp()
                        const result = eval_expr_source(expr)
                        const elapsed = now_timestamp() - start
                        if result != null { println(to_string(result)) }
                        println(f"({format_elapsed(elapsed)})")
                    } else {
                        println("Usage: :time <expression>")
                    }
                },
                "load" => {
                    if len(cmd_parts) > 1 {
                        const file = cmd_parts[1]
                        const source = fs_read(file)
                        if source != null {
                            println(f"Loading {file}...")
                            run_source(source)
                            println(f"Loaded {file}")
                        } else {
                            println(f"error: cannot read '{file}'")
                        }
                    } else {
                        println("Usage: :load <file.magi>")
                    }
                },
                "save" => {
                    if len(cmd_parts) > 1 {
                        const file = cmd_parts[1]
                        const content = repl_history.join("\n")
                        fs_write(file, content)
                        println(f"Saved {len(repl_history)} lines to {file}")
                    } else {
                        println("Usage: :save <file>")
                    }
                },
                "history" | "hist" => {
                    let i = 0
                    for h in repl_history {
                        println(f"  {i + 1}: {h}")
                        i = i + 1
                    }
                },
                "reset" => {
                    scope = {}
                    println("REPL state reset.")
                },
                "env" => {
                    cmd_env()
                },
                "ast" => {
                    if len(cmd_parts) > 1 {
                        const expr = repl_cmd.slice(4, len(repl_cmd))
                        const program = parse(expr)
                        println(to_string(program))
                    } else {
                        println("Usage: :ast <expression>")
                    }
                },
                _ => {
                    println(f"Unknown REPL command: :{cmd_name}")
                    println("Type :help for available commands.")
                }
            }
            continue
        }

        // Evaluate expression
        const result = eval_expr_source(full_line)
        if result != null {
            // Pretty-print result
            if typeof(result) == "string" {
                if !cli_no_color {
                    println(f"\x1b[32m\"{result}\"\x1b[0m")
                } else {
                    println(f"\"{result}\"")
                }
            } else if typeof(result) == "map" || typeof(result) == "array" {
                const json_str = to_json_pretty(result)
                if !cli_no_color {
                    println(f"\x1b[36m{json_str}\x1b[0m")
                } else {
                    println(json_str)
                }
            } else if typeof(result) == "null" {
                // Don't print null
            } else {
                if !cli_no_color {
                    println(f"\x1b[33m{to_string(result)}\x1b[0m")
                } else {
                    println(to_string(result))
                }
            }
        }
    }

    println("Goodbye.")
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: LSP Server Implementation
// ═══════════════════════════════════════════════════════════════════

func cmd_lsp_full() {
    println("Starting MAGI LSP server on stdin/stdout...")

    // LSP initialization
    let initialized = false
    let open_documents = {} // uri -> source
    let running = true

    while running {
        // Read JSON-RPC message from stdin
        const header = input("")
        if header == null { break }

        // Parse Content-Length header
        if !starts_with(header, "Content-Length:") { continue }
        const content_length = parse_int(header.slice(16, len(header)).trim())
        if content_length == null || content_length <= 0 { continue }

        // Read empty line separator
        const separator = input("")

        // Read body
        const body = input("")
        if body == null { break }

        // Parse JSON-RPC
        const msg = parse_json(body)
        if msg == null { continue }

        const method = if msg.has("method") { msg["method"] } else { null }
        const msg_id = if msg.has("id") { msg["id"] } else { null }
        const params = if msg.has("params") { msg["params"] } else { {} }

        match method {
            "initialize" => {
                const response = {
                    "jsonrpc": "2.0",
                    "id": msg_id,
                    "result": {
                        "capabilities": {
                            "textDocumentSync": 1,
                            "completionProvider": {"triggerCharacters": [".", ":"]},
                            "hoverProvider": true,
                            "definitionProvider": true,
                            "diagnosticProvider": {"interFileDependencies": false, "workspaceDiagnostics": false}
                        },
                        "serverInfo": {"name": "magi-lsp", "version": VERSION}
                    }
                }
                lsp_send_response(response)
                initialized = true
            },
            "initialized" => {
                // Client acknowledged initialization
            },
            "shutdown" => {
                const response = {
                    "jsonrpc": "2.0",
                    "id": msg_id,
                    "result": null
                }
                lsp_send_response(response)
            },
            "exit" => {
                running = false
            },
            "textDocument/didOpen" => {
                if params.has("textDocument") {
                    const doc = params["textDocument"]
                    const uri = doc["uri"]
                    const text = doc["text"]
                    open_documents[uri] = text
                    // Run diagnostics
                    const diagnostics = lsp_compute_diagnostics(uri, text)
                    lsp_publish_diagnostics(uri, diagnostics)
                }
            },
            "textDocument/didChange" => {
                if params.has("textDocument") && params.has("contentChanges") {
                    const uri = params["textDocument"]["uri"]
                    const changes = params["contentChanges"]
                    if len(changes) > 0 {
                        const new_text = changes[len(changes) - 1]["text"]
                        open_documents[uri] = new_text
                        const diagnostics = lsp_compute_diagnostics(uri, new_text)
                        lsp_publish_diagnostics(uri, diagnostics)
                    }
                }
            },
            "textDocument/didClose" => {
                if params.has("textDocument") {
                    const uri = params["textDocument"]["uri"]
                    let new_docs = {}
                    for k in keys(open_documents) {
                        if k != uri { new_docs[k] = open_documents[k] }
                    }
                    open_documents = new_docs
                }
            },
            "textDocument/completion" => {
                const items = lsp_get_completions(params)
                const response = {
                    "jsonrpc": "2.0",
                    "id": msg_id,
                    "result": {"isIncomplete": false, "items": items}
                }
                lsp_send_response(response)
            },
            "textDocument/hover" => {
                const hover = lsp_get_hover(params, open_documents)
                const response = {
                    "jsonrpc": "2.0",
                    "id": msg_id,
                    "result": hover
                }
                lsp_send_response(response)
            },
            _ => {
                // Unknown method — respond with error for requests
                if msg_id != null {
                    const response = {
                        "jsonrpc": "2.0",
                        "id": msg_id,
                        "error": {"code": -32601, "message": f"Method not found: {method}"}
                    }
                    lsp_send_response(response)
                }
            }
        }
    }
}

func lsp_send_response(response) {
    const body = to_json(response)
    print(f"Content-Length: {len(body)}\r\n\r\n{body}")
}

func lsp_compute_diagnostics(uri, source) {
    let diagnostics = []

    // Parse and collect errors
    const program = parse(source)
    const result = check_source(source)
    const errors = result[0]
    const warnings = result[1]

    for err in errors {
        diagnostics.push({
            "range": {"start": {"line": 0, "character": 0}, "end": {"line": 0, "character": 0}},
            "severity": 1,
            "source": "magi",
            "message": to_string(err)
        })
    }

    for w in warnings {
        diagnostics.push({
            "range": {"start": {"line": 0, "character": 0}, "end": {"line": 0, "character": 0}},
            "severity": 2,
            "source": "magi",
            "message": to_string(w)
        })
    }

    // Lint
    const lint_warnings = lint_source(source)
    for w in lint_warnings {
        diagnostics.push({
            "range": {"start": {"line": 0, "character": 0}, "end": {"line": 0, "character": 0}},
            "severity": 3,
            "source": "magi-lint",
            "message": to_string(w)
        })
    }

    diagnostics
}

func lsp_publish_diagnostics(uri, diagnostics) {
    const notification = {
        "jsonrpc": "2.0",
        "method": "textDocument/publishDiagnostics",
        "params": {
            "uri": uri,
            "diagnostics": diagnostics
        }
    }
    lsp_send_response(notification)
}

func lsp_get_completions(params) {
    let items = []

    // Keywords
    const keywords = [
        "let", "const", "func", "return", "if", "else", "for", "while",
        "match", "break", "continue", "struct", "enum", "interface",
        "import", "true", "false", "null", "in", "test", "spawn", "await"
    ]
    for kw in keywords {
        items.push({
            "label": kw,
            "kind": 14, // Keyword
            "detail": "keyword"
        })
    }

    // Builtins
    for fn_name in KNOWN_BUILTINS {
        items.push({
            "label": fn_name,
            "kind": 3, // Function
            "detail": "builtin function"
        })
    }

    // Stdlib modules
    for mod_name in KNOWN_STDLIB_MODULES {
        items.push({
            "label": f"std.{mod_name}",
            "kind": 9, // Module
            "detail": "stdlib module"
        })
    }

    items
}

func lsp_get_hover(params, open_documents) {
    if !params.has("textDocument") || !params.has("position") { return null }

    const uri = params["textDocument"]["uri"]
    if !open_documents.has(uri) { return null }

    const source = open_documents[uri]
    const pos = params["position"]
    const line = pos["line"]
    const character = pos["character"]

    // Get the word at position
    const lines = source.split("\n")
    if line >= len(lines) { return null }

    const line_text = lines[line]
    let word_start = character
    let word_end = character

    // Expand left
    while word_start > 0 {
        const ch = line_text.slice(word_start - 1, word_start)
        if ch == " " || ch == "(" || ch == ")" || ch == "{" || ch == "}" ||
           ch == "[" || ch == "]" || ch == "," || ch == ";" || ch == "." { break }
        word_start = word_start - 1
    }
    // Expand right
    while word_end < len(line_text) {
        const ch = line_text.slice(word_end, word_end + 1)
        if ch == " " || ch == "(" || ch == ")" || ch == "{" || ch == "}" ||
           ch == "[" || ch == "]" || ch == "," || ch == ";" || ch == "." { break }
        word_end = word_end + 1
    }

    const word = line_text.slice(word_start, word_end)
    if len(word) == 0 { return null }

    // Look up hover info
    let hover_text = null
    for fn_name in KNOWN_BUILTINS {
        if fn_name == word {
            hover_text = f"**{fn_name}** — builtin function"
            break
        }
    }

    if hover_text == null {
        const keywords_info = {
            "let": "**let** — declare a mutable variable",
            "const": "**const** — declare an immutable variable",
            "func": "**func** — declare a function",
            "return": "**return** — return a value from a function",
            "if": "**if** — conditional expression",
            "else": "**else** — alternative branch",
            "for": "**for** — iterate over a collection",
            "while": "**while** — loop while condition is true",
            "match": "**match** — pattern matching expression",
            "struct": "**struct** — define a structure type",
            "enum": "**enum** — define an enumeration type",
            "interface": "**interface** — define an interface (implicit)",
            "import": "**import** — import a module",
            "test": "**test** — define a test block"
        }
        if keywords_info.has(word) {
            hover_text = keywords_info[word]
        }
    }

    if hover_text == null { return null }

    {
        "contents": {"kind": "markdown", "value": hover_text},
        "range": {
            "start": {"line": line, "character": word_start},
            "end": {"line": line, "character": word_end}
        }
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: MCP Server Implementation
// ═══════════════════════════════════════════════════════════════════

func cmd_mcp_full() {
    println("Starting MAGI MCP server on stdin/stdout...")

    let running = true
    while running {
        const line = input("")
        if line == null { break }

        const msg = parse_json(line)
        if msg == null { continue }

        const method = if msg.has("method") { msg["method"] } else { null }
        const msg_id = if msg.has("id") { msg["id"] } else { null }
        const params = if msg.has("params") { msg["params"] } else { {} }

        match method {
            "initialize" => {
                const response = {
                    "jsonrpc": "2.0",
                    "id": msg_id,
                    "result": {
                        "protocolVersion": "2024-11-05",
                        "capabilities": {
                            "tools": {}
                        },
                        "serverInfo": {"name": "magi-mcp", "version": VERSION}
                    }
                }
                println(to_json(response))
            },
            "tools/list" => {
                const response = {
                    "jsonrpc": "2.0",
                    "id": msg_id,
                    "result": {
                        "tools": [
                            {
                                "name": "run",
                                "description": "Run a MAGI program",
                                "inputSchema": {
                                    "type": "object",
                                    "properties": {"source": {"type": "string", "description": "MAGI source code"}},
                                    "required": ["source"]
                                }
                            },
                            {
                                "name": "check",
                                "description": "Type check MAGI source",
                                "inputSchema": {
                                    "type": "object",
                                    "properties": {"source": {"type": "string", "description": "MAGI source code"}},
                                    "required": ["source"]
                                }
                            },
                            {
                                "name": "eval",
                                "description": "Evaluate a MAGI expression",
                                "inputSchema": {
                                    "type": "object",
                                    "properties": {"expression": {"type": "string", "description": "MAGI expression"}},
                                    "required": ["expression"]
                                }
                            },
                            {
                                "name": "format",
                                "description": "Format MAGI source code",
                                "inputSchema": {
                                    "type": "object",
                                    "properties": {"source": {"type": "string", "description": "MAGI source code"}},
                                    "required": ["source"]
                                }
                            },
                            {
                                "name": "lint",
                                "description": "Lint MAGI source code",
                                "inputSchema": {
                                    "type": "object",
                                    "properties": {"source": {"type": "string", "description": "MAGI source code"}},
                                    "required": ["source"]
                                }
                            }
                        ]
                    }
                }
                println(to_json(response))
            },
            "tools/call" => {
                const tool_name = if params.has("name") { params["name"] } else { null }
                const arguments = if params.has("arguments") { params["arguments"] } else { {} }

                let tool_result = null

                match tool_name {
                    "run" => {
                        const source = if arguments.has("source") { arguments["source"] } else { "" }
                        tool_result = to_string(run_source(source))
                    },
                    "check" => {
                        const source = if arguments.has("source") { arguments["source"] } else { "" }
                        const result = check_source(source)
                        tool_result = to_json({"errors": result[0], "warnings": result[1]})
                    },
                    "eval" => {
                        const expr = if arguments.has("expression") { arguments["expression"] } else { "" }
                        const result = eval_expr_source(expr)
                        tool_result = to_string(result)
                    },
                    "format" => {
                        const source = if arguments.has("source") { arguments["source"] } else { "" }
                        tool_result = fmt_source(source)
                    },
                    "lint" => {
                        const source = if arguments.has("source") { arguments["source"] } else { "" }
                        const warnings = lint_source(source)
                        tool_result = to_json(warnings)
                    },
                    _ => {
                        tool_result = f"Unknown tool: {tool_name}"
                    }
                }

                const response = {
                    "jsonrpc": "2.0",
                    "id": msg_id,
                    "result": {
                        "content": [{"type": "text", "text": if tool_result != null { tool_result } else { "" }}]
                    }
                }
                println(to_json(response))
            },
            _ => {
                if msg_id != null {
                    const response = {
                        "jsonrpc": "2.0",
                        "id": msg_id,
                        "error": {"code": -32601, "message": f"Method not found: {method}"}
                    }
                    println(to_json(response))
                }
            }
        }
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Debug Session Implementation
// ═══════════════════════════════════════════════════════════════════

func cmd_debug_full(file_path) {
    const source = fs_read(file_path)
    if source == null {
        println(f"error: cannot read file '{file_path}'")
        return null
    }

    println(f"MAGI Debugger -- {file_path}")
    println("Commands:")
    println("  s, step     Step into next statement")
    println("  n, next     Step over (skip into functions)")
    println("  c, continue Run until next breakpoint")
    println("  b <line>    Set breakpoint at line")
    println("  d <line>    Delete breakpoint at line")
    println("  p <expr>    Print expression value")
    println("  l, list     Show current source context")
    println("  bt          Show backtrace")
    println("  w, watch    Add watch expression")
    println("  info        Show breakpoints and watches")
    println("  q, quit     Exit debugger")
    println("")

    const lines = source.split("\n")
    let breakpoints = []
    let watches = []
    let current_line = 0
    let running = true
    let paused = true

    // Show first line
    debug_show_context(lines, current_line, breakpoints)

    while running {
        print("(magi-dbg) ")
        const cmd = input("")
        if cmd == null { break }

        const parts = cmd.trim().split(" ")
        const cmd_name = parts[0]

        match cmd_name {
            "s" | "step" => {
                current_line = current_line + 1
                if current_line >= len(lines) {
                    println("Program finished.")
                    running = false
                } else {
                    debug_show_context(lines, current_line, breakpoints)
                    // Evaluate watches
                    for w in watches {
                        const result = eval_expr_source(w)
                        println(f"  watch: {w} = {to_string(result)}")
                    }
                }
            },
            "n" | "next" => {
                current_line = current_line + 1
                if current_line >= len(lines) {
                    println("Program finished.")
                    running = false
                } else {
                    debug_show_context(lines, current_line, breakpoints)
                }
            },
            "c" | "continue" => {
                let hit = false
                while current_line < len(lines) - 1 {
                    current_line = current_line + 1
                    for bp in breakpoints {
                        if bp == current_line {
                            hit = true
                            break
                        }
                    }
                    if hit { break }
                }
                if hit {
                    println(f"Breakpoint hit at line {current_line + 1}")
                    debug_show_context(lines, current_line, breakpoints)
                } else {
                    println("Program finished.")
                    running = false
                }
            },
            "b" | "break" => {
                if len(parts) > 1 {
                    const bp_line = parse_int(parts[1])
                    if bp_line != null && bp_line > 0 && bp_line <= len(lines) {
                        breakpoints.push(bp_line - 1)
                        println(f"Breakpoint set at line {bp_line}")
                    } else {
                        println("Invalid line number")
                    }
                } else {
                    println("Usage: b <line>")
                }
            },
            "d" | "delete" => {
                if len(parts) > 1 {
                    const bp_line = parse_int(parts[1])
                    if bp_line != null {
                        let new_bps = []
                        for bp in breakpoints {
                            if bp != bp_line - 1 { new_bps.push(bp) }
                        }
                        breakpoints = new_bps
                        println(f"Breakpoint deleted at line {bp_line}")
                    }
                }
            },
            "p" | "print" => {
                if len(parts) > 1 {
                    const expr = cmd.slice(2, len(cmd)).trim()
                    const result = eval_expr_source(expr)
                    println(f"  = {to_string(result)}")
                } else {
                    println("Usage: p <expression>")
                }
            },
            "l" | "list" => {
                debug_show_context(lines, current_line, breakpoints)
            },
            "bt" | "backtrace" => {
                println(f"  #0 {file_path}:{current_line + 1}")
                println("  (single-frame -- self-hosted debugger)")
            },
            "w" | "watch" => {
                if len(parts) > 1 {
                    const expr = cmd.slice(2, len(cmd)).trim()
                    watches.push(expr)
                    println(f"Watch added: {expr}")
                } else {
                    println("Usage: w <expression>")
                }
            },
            "info" => {
                println("Breakpoints:")
                for bp in breakpoints { println(f"  line {bp + 1}") }
                println("Watches:")
                for w in watches { println(f"  {w}") }
            },
            "q" | "quit" | "exit" => {
                running = false
            },
            "" => {},
            _ => {
                println(f"Unknown command: {cmd_name}")
                println("Type 'help' for available commands.")
            }
        }
    }

    println("Debugger exited.")
}

func debug_show_context(lines, current, breakpoints) {
    const start = if current > 3 { current - 3 } else { 0 }
    const end = if current + 4 < len(lines) { current + 4 } else { len(lines) }

    let i = start
    while i < end {
        let prefix = "  "
        // Check if breakpoint
        for bp in breakpoints {
            if bp == i { prefix = "* " }
        }
        // Current line indicator
        if i == current {
            if !cli_no_color {
                println(f"\x1b[1;33m{prefix}{i + 1:4} > {lines[i]}\x1b[0m")
            } else {
                println(f"{prefix}{i + 1:4} > {lines[i]}")
            }
        } else {
            println(f"{prefix}{i + 1:4}   {lines[i]}")
        }
        i = i + 1
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Batch Operations
// ═══════════════════════════════════════════════════════════════════

func cmd_check_batch(files, flags) {
    let total_errors = 0
    let total_warnings = 0
    let files_checked = 0

    for file in files {
        const source = fs_read(file)
        if source == null {
            println(f"warning: cannot read '{file}'")
            continue
        }

        const result = check_source(source)
        const errors = result[0]
        const warnings = result[1]

        if len(errors) > 0 || (cli_verbose && len(warnings) > 0) {
            for err in errors {
                println(format_error(file, source, 0, 0, to_string(err)))
            }
            for w in warnings {
                if cli_verbose { println(format_warning(file, source, 0, 0, to_string(w))) }
            }
        }

        total_errors = total_errors + len(errors)
        total_warnings = total_warnings + len(warnings)
        files_checked = files_checked + 1
    }

    if !cli_quiet {
        println(f"\nChecked {files_checked} files: {total_errors} error(s), {total_warnings} warning(s)")
    }

    total_errors == 0
}

func cmd_lint_batch(files, flags) {
    let total_warnings = 0
    let files_checked = 0

    for file in files {
        const source = fs_read(file)
        if source == null { continue }

        const warnings = lint_source(source)
        if len(warnings) > 0 {
            for w in warnings {
                println(f"{file}: {w}")
            }
        }

        total_warnings = total_warnings + len(warnings)
        files_checked = files_checked + 1
    }

    if !cli_quiet {
        println(f"\nLinted {files_checked} files: {total_warnings} warning(s)")
    }
}

func cmd_fmt_batch(files, flags) {
    const write_mode = flags.has("write") || flags.has("w")
    let formatted_count = 0
    let already_ok = 0

    for file in files {
        const source = fs_read(file)
        if source == null { continue }

        const formatted = fmt_source(source)
        if formatted != source {
            if write_mode {
                fs_write(file, formatted)
                if !cli_quiet { println(f"Formatted {file}") }
            } else {
                println(f"{file}: needs formatting")
            }
            formatted_count = formatted_count + 1
        } else {
            already_ok = already_ok + 1
        }
    }

    if !cli_quiet {
        println(f"\n{formatted_count} file(s) formatted, {already_ok} already OK")
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: File Discovery
// ═══════════════════════════════════════════════════════════════════

func discover_magi_files(dir) {
    let files = []
    const entries = fs_list(dir)
    if entries == null { return files }

    for entry in entries {
        if starts_with(entry, ".") { continue }
        const full_path = dir + "/" + entry
        if ends_with(entry, ".magi") {
            files.push(full_path)
        } else if fs_is_dir(full_path) {
            const sub_files = discover_magi_files(full_path)
            for f in sub_files { files.push(f) }
        }
    }

    files
}

func discover_test_files(dir) {
    let files = []
    const all_files = discover_magi_files(dir)
    for f in all_files {
        const base = path_basename(f)
        if starts_with(base, "test_") || ends_with(base, "_test.magi") {
            files.push(f)
        }
    }
    files
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Version Comparison
// ═══════════════════════════════════════════════════════════════════

func parse_semver(version_str) {
    const parts = version_str.split(".")
    if len(parts) < 3 { return null }
    const major = parse_int(parts[0])
    const minor = parse_int(parts[1])
    // Handle pre-release suffix
    const patch_str = parts[2]
    const dash_idx = patch_str.index_of("-")
    let patch = null
    let pre = null
    if dash_idx != null && dash_idx >= 0 {
        patch = parse_int(patch_str.slice(0, dash_idx))
        pre = patch_str.slice(dash_idx + 1, len(patch_str))
    } else {
        patch = parse_int(patch_str)
    }
    if major == null || minor == null || patch == null { return null }
    {"major": major, "minor": minor, "patch": patch, "pre": pre}
}

func compare_semver(a, b) {
    const va = parse_semver(a)
    const vb = parse_semver(b)
    if va == null || vb == null { return 0 }
    if va["major"] != vb["major"] { return va["major"] - vb["major"] }
    if va["minor"] != vb["minor"] { return va["minor"] - vb["minor"] }
    if va["patch"] != vb["patch"] { return va["patch"] - vb["patch"] }
    // Pre-release versions have lower precedence
    if va["pre"] != null && vb["pre"] == null { return -1 }
    if va["pre"] == null && vb["pre"] != null { return 1 }
    0
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Checksum Utilities
// ═══════════════════════════════════════════════════════════════════

func compute_file_hash(file_path) {
    const content = fs_read(file_path)
    if content == null { return null }
    hash_sha256(content)
}

func verify_file_hash(file_path, expected_hash) {
    const actual = compute_file_hash(file_path)
    if actual == null { return false }
    actual == expected_hash
}

