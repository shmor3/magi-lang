    },
    "now_timestamp" => now_timestamp(),
    "format_timestamp" => {
        const ms = eval_to_i64_checked(input)
        if ms == null { return {"error": "expected numeric timestamp"} }
        format_timestamp(ms)
    },
    "sleep" => {
        const duration = inp_get_or(inputs, "duration", input)
        const ms = eval_to_i64_checked(duration)
        if ms != null && ms > 0 { sleep(ms) }
        null
    },
    "timestamp_diff" => {
        const fa = eval_to_i64_checked(a)
        const fb = eval_to_i64_checked(b)
        if fa == null || fb == null { return {"error": "timestamp_diff requires numbers"} }
        fa - fb
    },
    "timestamp_add" => {
        const amount = inp_get_or(inputs, "amount", null)
        const ft = eval_to_i64_checked(input)
        const fa = eval_to_i64_checked(amount)
        if ft == null || fa == null { return {"error": "timestamp_add requires numbers"} }
        ft + fa
    },
    "parse_timestamp" => {
        if typeof(input) != "string" { return {"error": f"expected string, got {typeof(input)}"} }
        parse_timestamp(input)
    },
    "duration" => {
        const unit = inp_get_or(inputs, "unit", "ms")
        const val = eval_to_i64_checked(input)
        if val == null { return {"error": "expected number"} }
        match unit {
            "ms" => val,
            "s" | "sec" | "second" | "seconds" => val * 1000,
            "m" | "min" | "minute" | "minutes" => val * 60000,
            "h" | "hour" | "hours" => val * 3600000,
            "d" | "day" | "days" => val * 86400000,
            _ => val
        }
    },
    "elapsed" => {
        const start = eval_to_i64_checked(input)
        if start == null { return {"error": "expected timestamp"} }
        now_timestamp() - start
    },
    "time_sleep" => {
        const ms = eval_to_i64_checked(input)
        if ms != null && ms > 0 { sleep(ms) }
        null
    },
    "add_duration" => {
        const ft = eval_to_i64_checked(a)
        const fd = eval_to_i64_checked(b)
        if ft == null || fd == null { return {"error": "requires numbers"} }
        ft + fd
    },
    "sub_duration" => {
        const ft = eval_to_i64_checked(a)
        const fd = eval_to_i64_checked(b)
        if ft == null || fd == null { return {"error": "requires numbers"} }
        ft - fd
    },
    "time_diff" => {
        const ft = eval_to_i64_checked(a)
        const fd = eval_to_i64_checked(b)
        if ft == null || fd == null { return {"error": "requires numbers"} }
        if ft > fd { ft - fd } else { fd - ft }
    },
    "start_of" | "end_of" => {
        eval_to_i64_checked(input)
    },
    "fmt_number" => {
        const f = eval_to_f64(input)
        if f == null { return to_string(input) }
        to_string(f)
    },
    "fmt_hex" => {
        const i = eval_to_i64_checked(input)
        if i == null { return {"error": "expected integer"} }
        fmt_hex(i)
    },
    "fmt_binary" => {
        const i = eval_to_i64_checked(input)
        if i == null { return {"error": "expected integer"} }
        fmt_binary(i)
    },
    "fmt_percent" => {
        const f = eval_to_f64(input)
        if f == null { return {"error": "expected number"} }
        to_string(round(f * 10000.0) / 100.0) + "%"
    },
    "fmt_bytes" => {
        const n = eval_to_i64_checked(input)
        if n == null { return {"error": "expected number"} }
        if n < 1024 { return f"{n} B" }
        if n < 1048576 { return f"{n / 1024} KB" }
        if n < 1073741824 { return f"{n / 1048576} MB" }
        f"{n / 1073741824} GB"
    },
    "fmt_duration" => {
        const ms = eval_to_i64_checked(input)
        if ms == null { return {"error": "expected number"} }
        format_elapsed(ms)
    },
    "text_slug" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        text_slug(input)
    },
    "text_camel_case" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        text_camel_case(input)
    },
    "text_snake_case" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        text_snake_case(input)
    },
    "text_title_case" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        text_title_case(input)
    },
    "text_wrap" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        const width = inp_get_or(inputs, "width", inp_get_or(inputs, "input_1", 80))
        text_wrap(input, width)
    },
    "text_truncate" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        const max_len = inp_get_or(inputs, "max_length", inp_get_or(inputs, "input_1", 80))
        const suffix = inp_get_or(inputs, "suffix", "...")
        if len(input) <= max_len { input }
        else { input.slice(0, max_len - len(suffix)) + suffix }
    },
    "text_indent" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        const prefix = inp_get_or(inputs, "prefix", inp_get_or(inputs, "input_1", "  "))
        const lines = input.split("\n")
        let result = []
        for line in lines { result.push(prefix + line) }
        result.join("\n")
    },
    "text_dedent" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        text_dedent(input)
    },
    "text_pad_left" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        const width = inp_get_or(inputs, "width", inp_get_or(inputs, "input_1", 0))
        const fill = inp_get_or(inputs, "fill", " ")
        const w = if typeof(width) == "int64" { width } else { 0 }
        if len(input) >= w { return input }
        op_string_repeat(fill, w - len(input)) + input
    },
    "text_pad_right" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        const width = inp_get_or(inputs, "width", inp_get_or(inputs, "input_1", 0))
        const fill = inp_get_or(inputs, "fill", " ")
        const w = if typeof(width) == "int64" { width } else { 0 }
        if len(input) >= w { return input }
        input + op_string_repeat(fill, w - len(input))
    },
    "html_escape" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        html_escape(input)
    },
    "html_unescape" => {
        if typeof(input) != "string" { return {"error": "expected string"} }
        html_unescape(input)
    },
    "reflect_type_of" | "reflect_type_name" => typeof(input),
    "reflect_is_type" => {
        const type_name = inp_get_or(inputs, "type_name", inp_get_or(inputs, "input_1", null))
        if typeof(type_name) != "string" { return false }
        typeof(input) == type_name
    },
    "reflect_fields" => {
        if typeof(input) != "map" { return [] }
        keys(input)
    },
    "reflect_has_field" => {
        const field = inp_get_or(inputs, "field", inp_get_or(inputs, "input_1", null))
        if typeof(input) != "map" || typeof(field) != "string" { return false }
        input.has(field)
    },
    "reflect_callable" => {
        const name = inp_get_or(inputs, "name", null)
        typeof(name) == "string" && len(name) > 0
    },
    "reflect_arity" => 0,
    "reflect_inspect" => to_string(input),
    "if_else" | "switch" | "try_catch" => null,
    "function_def" | "function_call" | "async_spawn" | "async_await" | "loop_group" => null,
    "reduce" => null,
    "uuid_v4" => random_uuid(),
    "uuid_nil" => "00000000-0000-0000-0000-000000000000",
