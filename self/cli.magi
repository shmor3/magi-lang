// ── compilec: compile to classfile ──────────────────────────────

func cmd_compilec(file_path) {
    const source = fs_read(file_path)
    if source == null {
        println(f"error: cannot read file '{file_path}'")
        return null
    }
    const program = parse(source)
    const result = check(program)
    const errors = result[0]
    if len(errors) > 0 {
        for err in errors { println(f"error: {err}") }
        println("Type errors found; aborting compilation.")
        return null
    }
    // Create MAGC classfile: header + source
    const out_path = file_path.replace(".magi", ".magc")
    const header = "MAGC"
    // In self-hosted, we write the source as the classfile payload
    fs_write(out_path, header + source)
    println(f"Compiled {file_path} -> {out_path}")
}

// ── runc: run classfile ─────────────────────────────────────────

func cmd_runc(file_path) {
    const data = fs_read(file_path)
    if data == null {
        println(f"error: cannot read file '{file_path}'")
        return null
    }
    if !starts_with(data, "MAGC") {
        println(f"error: {file_path} is not a valid .magc file")
        return null
    }
    // Extract source from classfile
    const source = data.slice(4, len(data))
    run_source(source)
}

// ── run-bc: run via IR bytecode VM ──────────────────────────────

func cmd_run_bc(file_path) {
    const source = fs_read(file_path)
    if source == null {
        println(f"error: cannot read file '{file_path}'")
        return null
    }
    // In self-hosted, run-bc goes through the same pipeline
    // (would use IR compiler in full implementation)
    run_source(source)
}

// ── compile: compile to WASM ────────────────────────────────────

func cmd_compile(file_path) {
    const source = fs_read(file_path)
    if source == null {
        println(f"error: cannot read file '{file_path}'")
        return null
