
const VERSION = "1.0.0"
func run_source(source) {
    const program = parse(source)
    const result = check(program)
    const errors = result[0]
    const warnings = result[1]
    if len(errors) > 0 {
        for err in errors {
            println(f"error: {err}")
        }
        return null
    }
    for w in warnings {
        println(f"warning: {w}")
    }
    const optimized = optimize(program)
    eval_program(optimized)
}

func check_source(source) {
    const program = parse(source)
    check(program)
}

func lint_source(source) {
    const program = parse(source)
    lint(program)
}

func fmt_source(source) {
    const program = parse(source)
    format_program(program)
}

func eval_expr_source(expr_source) {
    eval_source(expr_source)
}
func print_help() {
    println("MAGI Programming Language ")
    println("")
    println("Commands:")
    println("  run <file>      Run a MAGI program")
    println("  check <file>    Type check a program")
    println("  lint <file>     Lint a program")
    println("  fmt <file>      Format a program")
    println("  eval '<expr>'   Evaluate an expression")
    println("  version         Print version")
    println("  help            Print this help")
    println("")
    println("Flags:")
    println("  --help, -h      Print this help")
}

func print_version() {
    println(f"MAGI {VERSION}")
}

func dispatch(command, args) {
    match command {
        "run" => {
            if len(args) < 1 {
                println("Usage: magi run <file>")
                return null
            }
            const source = fs_read(args[0])
            run_source(source)
        },
        "check" => {
            if len(args) < 1 {
                println("Usage: magi check <file>")
                return null
            }
            const source = fs_read(args[0])
            const result = check_source(source)
            const errors = result[0]
            const warnings = result[1]
            for w in warnings { println(f"warning: {w}") }
            for err in errors { println(f"error: {err}") }
            if len(errors) == 0 {
                println("OK: no errors")
            }
            null
        },
        "lint" => {
            if len(args) < 1 {
                println("Usage: magi lint <file>")
                return null
            }
            const source = fs_read(args[0])
            const warnings = lint_source(source)
            if len(warnings) == 0 {
                println("OK: no warnings")
            } else {
                for w in warnings { println(f"warning: {w}") }
            }
            null
        },
        "fmt" => {
            if len(args) < 1 {
                println("Usage: magi fmt <file>")
                return null
            }
            const source = fs_read(args[0])
            const formatted = fmt_source(source)
            println(formatted)
            null
        },
        "eval" => {
            if len(args) < 1 {
                println("Usage: magi eval '<expr>'")
                return null
            }
            const result = eval_expr_source(args[0])
            if result != null {
                println(to_string(result))
            }
            null
        },
        "version" => print_version(),
        "help" | "--help" | "-h" => print_help(),
        _ => {
            if ends_with(command, ".magi") {
                const source = fs_read(command)
                run_source(source)
            } else {
                println(f"Unknown command: {command}")
                print_help()
            }
            null
        },
    }
}
const ENV_FLAGS = [
    "MAGI_DEBUG",
    "MAGI_TRACE",
    "MAGI_SANDBOX",
    "MAGI_NO_COLOR",
    "MAGI_JSON",
    "MAGI_QUIET",
    "MAGI_VERBOSE",
    "MAGI_BACKTRACE",
    "MAGI_HOME",
    "MAGI_PATH",
    "MAGI_CACHE",
    "MAGI_LOG",
    "MAGI_TARGET",
    "MAGI_INCREMENTAL",
    "MAGI_TOOLCHAIN",
    "MAGI_PROXY"
]

func env_flag(name) {
    const val = env_get(name)
    if val == null || val == "" || val == "0" || val == "false" {
        return false
    }
    true
}

func env_flag_value(name, default_val) {
    const val = env_get(name)
    if val == null || val == "" { return default_val }
    val
}

let cli_debug = false
let cli_trace = false
let cli_sandbox = false
let cli_no_color = false
let cli_json = false
let cli_quiet = false
let cli_verbose = false

func cli_init_flags() {
    cli_debug = env_flag("MAGI_DEBUG")
    cli_trace = env_flag("MAGI_TRACE")
    cli_sandbox = env_flag("MAGI_SANDBOX")
    cli_no_color = env_flag("MAGI_NO_COLOR")
    cli_json = env_flag("MAGI_JSON")
    cli_quiet = env_flag("MAGI_QUIET")
    cli_verbose = env_flag("MAGI_VERBOSE")
}
func parse_args(raw_args) {
    let flags = {}
    let positional = []
    let command = null

    let i = 0
    while i < len(raw_args) {
        const arg = raw_args[i]
        if starts_with(arg, "--") {
            const flag_name = arg.slice(2, len(arg))
            if i + 1 < len(raw_args) && !starts_with(raw_args[i + 1], "-") {
                flags[flag_name] = raw_args[i + 1]
                i = i + 2
            } else {
                flags[flag_name] = true
                i = i + 1
            }
        } else if starts_with(arg, "-") && len(arg) == 2 {
            const flag_char = arg[1]
            match flag_char {
                "h" => { flags["help"] = true },
                "V" => { flags["version"] = true },
                "v" => { flags["verbose"] = true },
                "q" => { flags["quiet"] = true },
                "w" => { flags["write"] = true },
                "c" => { flags["check"] = true },
                "n" => {
                    if i + 1 < len(raw_args) {
                        flags["iterations"] = raw_args[i + 1]
                        i = i + 1
                    }
                },
                _ => { flags[to_string(flag_char)] = true }
            }
            i = i + 1
        } else {
            if command == null {
                command = arg
            } else {
                positional.push(arg)
            }
            i = i + 1
        }
    }

    {"command": command, "flags": flags, "positional": positional}
}
