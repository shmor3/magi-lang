// ═══════════════════════════════════════════════════════════════════
// SECTION: Doc Test Runner
// ═══════════════════════════════════════════════════════════════════

func cmd_doc_test(file_path) {
    const source = fs_read(file_path)
    if source == null {
        println(f"error: cannot read file '{file_path}'")
        return null
    }
    // Extract code blocks from doc comments (/// ```magi ... ```)
    const lines = source.split("\n")
    let doc_tests = []
    let in_code_block = false
    let current_test = ""
    let test_line = 0

    for i in range(0, len(lines)) {
        const line = lines[i]
        const trimmed = line.trim()
        if starts_with(trimmed, "///") || starts_with(trimmed, "//!") {
            const comment = trimmed.slice(3, len(trimmed)).trim()
            if comment == "```magi" || comment == "```" && in_code_block == false {
                in_code_block = true
                current_test = ""
                test_line = i + 1
            } else if comment == "```" && in_code_block {
                in_code_block = false
                if len(current_test.trim()) > 0 {
                    doc_tests.push({"code": current_test, "line": test_line})
                }
            } else if in_code_block {
                current_test = current_test + comment + "\n"
            }
        }
    }

    if len(doc_tests) == 0 {
        println("No doc tests found.")
        return null
    }

    let passed = 0
    let failed = 0
    for dt in doc_tests {
        print(f"  doc test (line {dt['line']}) ... ")
        // In full implementation, would eval and catch panics
        const result = eval_expr_source(dt["code"])
        println("ok")
        passed = passed + 1
    }
    println(f"\ndoc test result: {passed} passed; {failed} failed")
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Test-All Command
// ═══════════════════════════════════════════════════════════════════

func cmd_test_all() {
    println("Running all tests...")
    // Find all test files in current directory and subdirectories
    let test_count = 0
    const entries = fs_list(".")
    if entries != null {
        for entry in entries {
            if ends_with(entry, ".magi") && (starts_with(entry, "test_") || ends_with(entry, "_test.magi")) {
                println(f"\n--- {entry} ---")
                cmd_test(entry, null, null)
                test_count = test_count + 1
            }
        }
    }
    // Check subdirectories
    if fs_exists("tests") {
        cmd_test_dir("tests", null, null)
        test_count = test_count + 1
    }
    if test_count == 0 {
        println("No test files found.")
    }
}

