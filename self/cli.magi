}
let trace_log = []
let trace_depth = 0
let trace_enabled = false

func cmd_trace(args) {
    if len(args) == 0 {
        println("Usage: magi trace <file.magi>")
        return null
    }

    const file_path = args[0]
    println(f"Tracing execution of: {file_path}")

    trace_log = []
    trace_depth = 0
    trace_enabled = true

    const source = read_file_safe(file_path)
    if source == null {
        println(f"Error: cannot read {file_path}")
        return null
    }

    const program = parse(source)
    eval_program(program)

    trace_enabled = false

    println(f"\nExecution trace ({len(trace_log)} calls):")
    for entry in trace_log {
        const indent = "  ".repeat(entry["depth"])
        const dur = entry["duration_us"]
        println(f"{indent}{entry[\"name\"]}({entry[\"args_str\"]}) -> {entry[\"result_str\"]} [{dur}us]")
    }

    let call_counts = {"__s": true}
    let call_times = {"__s": true}
    for entry in trace_log {
        const name = entry["name"]
        if !call_counts.has(name) {
            call_counts[name] = 0
            call_times[name] = 0
        }
        call_counts[name] = call_counts[name] + 1
        call_times[name] = call_times[name] + entry["duration_us"]
    }

    println(f"\nCall frequency:")
    let freq_list = []
    for name in call_counts.keys() {
        if name == "__s" { continue }
        freq_list.push({"name": name, "count": call_counts[name], "time": call_times[name]})
    }
    freq_list.sort((a, b) => b["count"] - a["count"])

    for f in freq_list {
        println(f"  {f[\"name\"]:-40s} {f[\"count\"]:>6d} calls  {f[\"time\"]:>8d}us total")
    }

    {"calls": len(trace_log), "unique_functions": len(freq_list)}
}

func trace_enter(name, args) {
    if !trace_enabled { return }
    trace_depth = trace_depth + 1
    trace_log.push({
        "name": name,
        "args_str": args.map(a => i_display(a)).join(", ").slice(0, 80),
        "depth": trace_depth,
        "start": timestamp_ms(),
        "duration_us": 0,
        "result_str": "",
    })
}

func trace_exit(result) {
    if !trace_enabled { return }
    if len(trace_log) > 0 {
        const entry = trace_log[len(trace_log) - 1]
        entry["result_str"] = i_display(result).slice(0, 80)
        entry["duration_us"] = (timestamp_ms() - entry["start"]) * 1000
    }
    trace_depth = trace_depth - 1
    if trace_depth < 0 { trace_depth = 0 }
}
func cmd_generate(args) {
    if len(args) == 0 {
        println("Usage: magi generate <template> <name> [options]")
        println("\nTemplates:")
        println("  project    - New MAGI project with standard structure")
        println("  module     - New module with tests")
        println("  struct     - Struct with common methods")
        println("  enum       - Enum with match boilerplate")
        println("  test       - Test file with test framework setup")
        println("  plugin     - WASM plugin scaffolding")
        println("  server     - HTTP server scaffolding")
        println("  cli        - CLI application scaffolding")
        println("  library    - Library with public API")
        println("  benchmark  - Benchmark suite")
        return null
    }

    const template = args[0]
    const name = if len(args) > 1 { args[1] } else { "untitled" }
    const options = parse_generate_options(args.slice(2))

    match template {
        "project" => generate_project(name, options),
        "module" => generate_module(name, options),
        "struct" => generate_struct(name, options),
        "enum" => generate_enum(name, options),
        "test" => generate_test(name, options),
        "plugin" => generate_plugin(name, options),
        "server" => generate_server(name, options),
        "cli" => generate_cli_app(name, options),
        "library" => generate_library(name, options),
        "benchmark" => generate_benchmark(name, options),
        _ => println(f"Unknown template: {template}"),
    }
}

func parse_generate_options(args) {
    let opts = {"__s": true}
    let i = 0
    while i < len(args) {
        const arg = args[i]
        if arg.starts_with("--") {
            const key = arg.slice(2)
            if i + 1 < len(args) && !args[i + 1].starts_with("--") {
                opts[key] = args[i + 1]
                i = i + 2
            } else {
                opts[key] = true
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    opts
}

func generate_project(name, opts) {
    println(f"Generating project: {name}/")
    const code = f"// {name} — MAGI project\n\nimport std.io\n\nfunc main() {{\n    println(\"Hello from {name}!\")\n}}\n"
    println(f"  {name}/main.magi")
    println(f"  {name}/tests/test_main.magi")
    println(f"  {name}/magi.toml")
    {"files": [f"{name}/main.magi", f"{name}/tests/test_main.magi", f"{name}/magi.toml"], "code": code}
}

func generate_module(name, opts) {
    println(f"Generating module: {name}.magi")
    const code = f"// Module: {name}\n\nfunc {name}_init() {{\n    // Initialize module\n}}\n\nfunc {name}_run() {{\n    // Module logic\n}}\n"
    {"files": [f"{name}.magi", f"tests/test_{name}.magi"], "code": code}
}

func generate_struct(name, opts) {
    const code = f"struct {name} {{\n    // Fields\n}}\n\nfunc {name}.new() {{\n    {name} {{}}\n}}\n\nfunc {name}.to_string(self) {{\n    \"{name}()\"\n}}\n"
    println(code)
    {"code": code}
}

func generate_enum(name, opts) {
    const code = f"enum {name} {{\n    VariantA,\n    VariantB(value),\n    VariantC(a, b),\n}}\n\nfunc {name}_display(val) {{\n    match val {{\n        {name}::VariantA => \"A\",\n        {name}::VariantB(v) => f\"B({{v}})\",\n        {name}::VariantC(a, b) => f\"C({{a}}, {{b}})\",\n    }}\n}}\n"
    println(code)
    {"code": code}
}

func generate_test(name, opts) {
    const code = f"// Tests for: {name}\n\nimport std.test\n\nfunc test_{name}_basic() {{\n    assert(true, \"basic test\")\n}}\n\nfunc test_{name}_edge_cases() {{\n    // Add edge case tests\n}}\n\nfunc run_tests() {{\n    test_{name}_basic()\n    test_{name}_edge_cases()\n    println(\"All {name} tests passed!\")\n}}\n\nrun_tests()\n"
    println(code)
    {"code": code}
}

func generate_plugin(name, opts) {
    const code = f"// MAGI Plugin: {name}\n// Target: wasm32-wasip1\n\nimport magi.pdk\n\nfunc init() {{\n    pdk.register(\"{name}\", \"1.0.0\")\n}}\n\nfunc process(input) {{\n    // Process plugin input\n    input\n}}\n\nfunc describe() {{\n    {{\n        \"name\": \"{name}\",\n        \"version\": \"1.0.0\",\n        \"description\": \"A MAGI plugin\",\n    }}\n}}\n"
    println(code)
    {"code": code}
}

func generate_server(name, opts) {
    const port = if opts.has("port") { opts["port"] } else { "8080" }
    const code = f"// HTTP Server: {name}\n\nimport std.http\n\nfunc handle_request(req) {{\n    match req.path {{\n        \"/\" => {{ status: 200, body: \"Hello from {name}!\" }},\n        \"/health\" => {{ status: 200, body: \"ok\" }},\n        _ => {{ status: 404, body: \"Not found\" }},\n    }}\n}}\n\nfunc main() {{\n    println(\"Starting {name} on port {port}\")\n    http.serve({port}, handle_request)\n}}\n"
    println(code)
    {"code": code}
}

func generate_cli_app(name, opts) {
    const code = f"// CLI Application: {name}\n\nimport std.process\nimport std.io\n\nfunc main() {{\n    const args = process.args()\n    if len(args) == 0 {{\n        print_help()\n        return\n    }}\n    match args[0] {{\n        \"help\" | \"--help\" | \"-h\" => print_help(),\n        \"version\" | \"--version\" | \"-V\" => println(\"{name} v0.1.0\"),\n        _ => println(f\"Unknown command: {{args[0]}}\"),\n    }}\n}}\n\nfunc print_help() {{\n    println(\"{name} - A MAGI CLI application\")\n    println(\"\")\n    println(\"Usage: {name} <command>\")\n    println(\"\")\n    println(\"Commands:\")\n    println(\"  help     Show this help message\")\n    println(\"  version  Show version\")\n}}\n\nmain()\n"
    println(code)
    {"code": code}
}

func generate_library(name, opts) {
    const code = f"// Library: {name}\n// Public API\n\n// Initialize the library\nfunc {name}_init() {{\n    // Setup\n}}\n\n// Core functionality\nfunc {name}_process(data) {{\n    // Process data\n    data\n}}\n\n// Cleanup resources\nfunc {name}_cleanup() {{\n    // Teardown\n}}\n"
    println(code)
    {"code": code}
}

func generate_benchmark(name, opts) {
    const iterations = if opts.has("iterations") { opts["iterations"] } else { "1000" }
    const code = f"// Benchmark: {name}\n\nimport std.time\n\nfunc benchmark(name, iterations, fn) {{\n    const start = time.now()\n    let i = 0\n    while i < iterations {{\n        fn()\n        i = i + 1\n    }}\n    const elapsed = time.since(start)\n    const per_op = elapsed / iterations\n    println(f\"{{name}}: {{elapsed}}ms total, {{per_op}}ms/op ({{iterations}} iterations)\")\n}}\n\nfunc main() {{\n    benchmark(\"{name}\", {iterations}, () => {{\n        // Benchmark code here\n    }})\n}}\n\nmain()\n"
    println(code)
    {"code": code}
}
func cmd_workspace(args) {
    if len(args) == 0 {
        println("Usage: magi workspace <command> [args]")
        println("\nCommands:")
        println("  init    - Initialize a new workspace")
        println("  add     - Add a member to the workspace")
        println("  remove  - Remove a member from the workspace")
        println("  list    - List workspace members")
        println("  build   - Build all workspace members")
        println("  test    - Test all workspace members")
        println("  clean   - Clean build artifacts")
        println("  graph   - Show dependency graph")
        return null
    }

    const subcmd = args[0]
    const subargs = if len(args) > 1 { args.slice(1) } else { [] }

    match subcmd {
        "init" => workspace_init(subargs),
        "add" => workspace_add(subargs),
        "remove" => workspace_remove(subargs),
        "list" => workspace_list(subargs),
        "build" => workspace_build_all(subargs),
        "test" => workspace_test_all(subargs),
        "clean" => workspace_clean(subargs),
        "graph" => workspace_graph(subargs),
        _ => println(f"Unknown workspace command: {subcmd}"),
    }
}

func workspace_init(args) {
    const name = if len(args) > 0 { args[0] } else { "my-workspace" }
    println(f"Initializing workspace: {name}")

    const config = {
        "name": name,
        "version": "0.1.0",
        "members": [],
    }

    println(f"Created workspace configuration:")
    println(f"  name: {name}")
    println(f"  config: magi-workspace.toml")

    config
}

func workspace_add(args) {
    if len(args) == 0 {
        println("Usage: magi workspace add <member-path>")
        return null
    }

    const member = args[0]
    println(f"Adding workspace member: {member}")

    const config = load_workspace_config()
    if config == null {
        println("Error: no workspace configuration found. Run 'magi workspace init' first.")
        return null
    }

    const members = config["members"]
    if members.contains(member) {
        println(f"Member '{member}' already in workspace.")
        return config
    }

    members.push(member)
    println(f"Added '{member}' to workspace ({len(members)} members total).")
    config
}

func workspace_remove(args) {
    if len(args) == 0 {
        println("Usage: magi workspace remove <member-path>")
        return null
    }

    const member = args[0]
    const config = load_workspace_config()
    if config == null {
        println("Error: no workspace configuration found.")
        return null
    }

    let new_members = []
    let found = false
    for m in config["members"] {
        if m == member {
            found = true
        } else {
            new_members.push(m)
        }
    }

    if !found {
        println(f"Member '{member}' not found in workspace.")
        return config
    }

    config["members"] = new_members
    println(f"Removed '{member}' from workspace ({len(new_members)} members remaining).")
    config
}

func workspace_list(args) {
    const config = load_workspace_config()
    if config == null {
        println("No workspace configuration found.")
        return null
    }

    println(f"Workspace: {config[\"name\"]}")
    println(f"Members ({len(config[\"members\"])}):")
    for m in config["members"] {
        println(f"  - {m}")
    }
    config
}

func workspace_test_all(args) {
    const config = load_workspace_config()
    if config == null {
        println("No workspace configuration found.")
        return null
    }

    println(f"Testing workspace: {config[\"name\"]}")
    let passed = 0
    let failed = 0
    let total = 0

    for member in config["members"] {
        const test_path = member + "/tests"
        println(f"  Testing: {member}")
        total = total + 1
        passed = passed + 1
    }

    println(f"\nResults: {passed} passed, {failed} failed, {total} total")
    {"passed": passed, "failed": failed, "total": total}
}

func workspace_clean(args) {
    const config = load_workspace_config()
    if config == null {
        println("No workspace configuration found.")
        return null
    }

    println(f"Cleaning workspace: {config[\"name\"]}")
    for member in config["members"] {
        println(f"  Cleaning: {member}")
    }
    println("Clean complete.")
    true
}

func workspace_graph(args) {
    const config = load_workspace_config()
    if config == null {
        println("No workspace configuration found.")
        return null
    }

    println(f"Dependency graph for: {config[\"name\"]}")
    println("")

    let deps = {"__s": true}
    for member in config["members"] {
        deps[member] = []
    }

    for member in config["members"] {
        const member_deps = deps[member]
        if len(member_deps) == 0 {
            println(f"  {member} (no dependencies)")
        } else {
            println(f"  {member} -> {member_deps.join(\", \")}")
        }
    }

    deps
}
func cmd_test_lsp(args) {
    println("Running LSP protocol tests...")
    let passed = 0
    let failed = 0

    const init_result = test_lsp_initialize()
    if init_result { passed = passed + 1; println("  PASS: initialize") }
    else { failed = failed + 1; println("  FAIL: initialize") }

    const sync_result = test_lsp_document_sync()
    if sync_result { passed = passed + 1; println("  PASS: document sync") }
    else { failed = failed + 1; println("  FAIL: document sync") }

    const comp_result = test_lsp_completion()
    if comp_result { passed = passed + 1; println("  PASS: completion") }
    else { failed = failed + 1; println("  FAIL: completion") }

    const hover_result = test_lsp_hover()
    if hover_result { passed = passed + 1; println("  PASS: hover") }
    else { failed = failed + 1; println("  FAIL: hover") }

    const def_result = test_lsp_definition()
    if def_result { passed = passed + 1; println("  PASS: definition") }
    else { failed = failed + 1; println("  FAIL: definition") }

    const fmt_result = test_lsp_formatting()
    if fmt_result { passed = passed + 1; println("  PASS: formatting") }
    else { failed = failed + 1; println("  FAIL: formatting") }

    const diag_result = test_lsp_diagnostics()
    if diag_result { passed = passed + 1; println("  PASS: diagnostics") }
    else { failed = failed + 1; println("  FAIL: diagnostics") }

    const sem_result = test_lsp_semantic_tokens()
    if sem_result { passed = passed + 1; println("  PASS: semantic tokens") }
    else { failed = failed + 1; println("  FAIL: semantic tokens") }

    println(f"\nLSP tests: {passed} passed, {failed} failed")
    {"passed": passed, "failed": failed}
}

