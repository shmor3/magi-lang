// MAGI Self-Hosted Compiler — Utility Module
//
// Mirrors src/util.rs. Pure-computation utilities implemented in MAGI,
// OS-dependent operations delegate to stage 0 builtins.
//
// Sections:
//   1. Encoding (hex, base64, base32, URL, HTML)
//   2. String algorithms (Levenshtein, slug, case conversion, padding, wrap)
//   3. JSON (recursive descent parser, emitter, path queries, merge/patch)
//   4. Regular expressions (NFA-based engine)
//   5. YAML (indentation-based parser, emitter)
//   6. UUID (v4 generation, parsing, validation)
//   7. Compression (gzip, LZ4, zstd — delegates to stage 0)
//   8. HTTP (request/response parsing, URL parser, query strings)
//   9. Crypto helpers (SHA-256, HMAC, PBKDF2 — delegates to stage 0)
//  10. Date/Time (formatting, parsing, durations)
//  11. Math extras (GCD, LCM, primes, statistics)
//  12. Collections (OrderedMap, Set ops, Counter, BinaryHeap, Deque)

// ════════════════════════════════════════════════════════════════════
// 1. Encoding
// ════════════════════════════════════════════════════════════════════

const HEX_LOWER = "0123456789abcdef"
const HEX_UPPER = "0123456789ABCDEF"

// Encode a string to lowercase hex.
func hex_encode(s) {
    let result = ""
    let i = 0
    while i < len(s) {
        const code = char_code_at(s, i)
        result = result + HEX_LOWER[int(code / 16)] + HEX_LOWER[code % 16]
        i = i + 1
    }
    result
}

// Encode a string to uppercase hex.
func hex_encode_upper(s) {
    let result = ""
    let i = 0
    while i < len(s) {
        const code = char_code_at(s, i)
        result = result + HEX_UPPER[int(code / 16)] + HEX_UPPER[code % 16]
        i = i + 1
    }
    result
}

// Decode a hex value character to integer (0-15).
func hex_val(c) {
    if c >= "0" && c <= "9" { return char_code_at(c, 0) - char_code_at("0", 0) }
    if c >= "a" && c <= "f" { return char_code_at(c, 0) - char_code_at("a", 0) + 10 }
    if c >= "A" && c <= "F" { return char_code_at(c, 0) - char_code_at("A", 0) + 10 }
    return -1
}

// Decode a hex string to a plain string.
func hex_decode(s) {
    if len(s) % 2 != 0 { return {"error": "odd length hex string"} }
    let result = ""
    let i = 0
    while i < len(s) {
        const hi = hex_val(s[i])
        const lo = hex_val(s[i + 1])
        if hi < 0 || lo < 0 { return {"error": f"invalid hex char at {i}"} }
        result = result + char_from_code(hi * 16 + lo)
        i = i + 2
    }
    result
}

// ── Base64 ─────────────────────────────────────────────────────────

const BASE64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

// Encode a string to base64 with padding.
func base64_encode(data) {
    let result = ""
    let i = 0
    const n = len(data)
    while i < n {
        const b0 = char_code_at(data, i)
        const b1 = if i + 1 < n { char_code_at(data, i + 1) } else { 0 }
        const b2 = if i + 2 < n { char_code_at(data, i + 2) } else { 0 }
        const triple = b0 * 65536 + b1 * 256 + b2
        result = result + BASE64_CHARS[int(triple / 262144) % 64]
        result = result + BASE64_CHARS[int(triple / 4096) % 64]
        if i + 1 < n {
            result = result + BASE64_CHARS[int(triple / 64) % 64]
        } else {
            result = result + "="
        }
        if i + 2 < n {
            result = result + BASE64_CHARS[triple % 64]
        } else {
            result = result + "="
        }
        i = i + 3
    }
    result
}

// Get base64 character value.
func base64_val(c) {
    if c >= "A" && c <= "Z" { return char_code_at(c, 0) - char_code_at("A", 0) }
    if c >= "a" && c <= "z" { return char_code_at(c, 0) - char_code_at("a", 0) + 26 }
    if c >= "0" && c <= "9" { return char_code_at(c, 0) - char_code_at("0", 0) + 52 }
    if c == "+" { return 62 }
    if c == "/" { return 63 }
    return -1
}

// Decode a base64 string.
func base64_decode(s) {
    // Strip whitespace and padding
    let clean = ""
    let i = 0
    while i < len(s) {
        const c = s[i]
        if c != " " && c != "\n" && c != "\r" && c != "\t" && c != "=" {
            clean = clean + c
        }
        i = i + 1
    }
    let result = ""
    let buffer = 0
    let bits = 0
    i = 0
    while i < len(clean) {
        const val = base64_val(clean[i])
        if val < 0 { return {"error": f"invalid base64 character: {clean[i]}"} }
        buffer = buffer * 64 + val
        bits = bits + 6
        if bits >= 8 {
            bits = bits - 8
            const byte_val = int(buffer / pow(2, bits)) % 256
            result = result + char_from_code(byte_val)
            buffer = buffer % pow(2, bits)
        }
        i = i + 1
    }
    result
}

// ── Base32 ─────────────────────────────────────────────────────────

const BASE32_ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"

// Encode a string to base32 (RFC 4648).
func base32_encode(data) {
    if len(data) == 0 { return "" }
    let result = ""
    let i = 0
    while i < len(data) {
        const chunk_len = if i + 5 <= len(data) { 5 } else { len(data) - i }
        let buf = [0, 0, 0, 0, 0]
        let j = 0
        while j < chunk_len {
            buf[j] = char_code_at(data, i + j)
            j = j + 1
        }
        // Always emit at least 2 characters
        result = result + BASE32_ALPHABET[int(buf[0] / 8)]
        result = result + BASE32_ALPHABET[(buf[0] % 8) * 4 + int(buf[1] / 64)]
        if chunk_len >= 2 {
            result = result + BASE32_ALPHABET[int(buf[1] % 64 / 2)]
            result = result + BASE32_ALPHABET[(buf[1] % 2) * 16 + int(buf[2] / 16)]
        } else {
            result = result + "=="
        }
        if chunk_len >= 3 {
            result = result + BASE32_ALPHABET[(buf[2] % 16) * 2 + int(buf[3] / 128)]
        } else {
            result = result + "="
        }
        if chunk_len >= 4 {
            result = result + BASE32_ALPHABET[int(buf[3] % 128 / 4)]
            result = result + BASE32_ALPHABET[(buf[3] % 4) * 8 + int(buf[4] / 32)]
        } else {
            result = result + "=="
        }
        if chunk_len >= 5 {
            result = result + BASE32_ALPHABET[buf[4] % 32]
        } else {
            result = result + "="
        }
        i = i + 5
    }
    result
}

// Get base32 character value.
func base32_val(c) {
    if c >= "A" && c <= "Z" { return char_code_at(c, 0) - char_code_at("A", 0) }
    if c >= "a" && c <= "z" { return char_code_at(c, 0) - char_code_at("a", 0) }
    if c >= "2" && c <= "7" { return char_code_at(c, 0) - char_code_at("2", 0) + 26 }
    return -1
}

// Decode a base32 string (RFC 4648).
func base32_decode(s) {
    // Strip padding
    let clean = ""
    let i = 0
    while i < len(s) {
        if s[i] != "=" { clean = clean + s[i] }
        i = i + 1
    }
    let result = ""
    let buffer = 0
    let bits = 0
    i = 0
    while i < len(clean) {
        const val = base32_val(clean[i])
        if val < 0 { return {"error": f"invalid base32 char: {clean[i]}"} }
        buffer = buffer * 32 + val
        bits = bits + 5
        if bits >= 8 {
            bits = bits - 8
            const byte_val = int(buffer / pow(2, bits)) % 256
            result = result + char_from_code(byte_val)
            buffer = buffer % pow(2, bits)
        }
        i = i + 1
    }
    result
}

// ── URL Encoding ───────────────────────────────────────────────────

// Percent-encode a string (all non-alphanumeric except -._~).
func url_encode(s) {
    let result = ""
    let i = 0
    while i < len(s) {
        const c = s[i]
        const code = char_code_at(c, 0)
        if (c >= "A" && c <= "Z") || (c >= "a" && c <= "z") || (c >= "0" && c <= "9") || c == "-" || c == "." || c == "_" || c == "~" {
            result = result + c
        } else {
            result = result + "%" + HEX_UPPER[int(code / 16)] + HEX_UPPER[code % 16]
        }
        i = i + 1
    }
    result
}

// Percent-decode a string.
func url_decode(s) {
    let result = ""
    let i = 0
    while i < len(s) {
        if s[i] == "%" && i + 2 < len(s) {
            const hi = hex_val(s[i + 1])
            const lo = hex_val(s[i + 2])
            if hi >= 0 && lo >= 0 {
                result = result + char_from_code(hi * 16 + lo)
                i = i + 3
            } else {
                result = result + s[i]
                i = i + 1
            }
        } else if s[i] == "+" {
            result = result + " "
            i = i + 1
        } else {
            result = result + s[i]
            i = i + 1
        }
    }
    result
}

// ── HTML Escape ────────────────────────────────────────────────────

// Escape HTML entities in text.
func html_escape(s) {
    let result = ""
    let i = 0
    while i < len(s) {
        const c = s[i]
        if c == "&" { result = result + "&amp;" }
        else if c == "<" { result = result + "&lt;" }
        else if c == ">" { result = result + "&gt;" }
        else if c == "\"" { result = result + "&quot;" }
        else if c == "'" { result = result + "&#x27;" }
        else { result = result + c }
        i = i + 1
    }
    result
}

// Unescape HTML entities.
func html_unescape(s) {
    let result = s
    result = result.replace("&amp;", "&")
    result = result.replace("&lt;", "<")
    result = result.replace("&gt;", ">")
    result = result.replace("&quot;", "\"")
    result = result.replace("&#x27;", "'")
    result = result.replace("&#39;", "'")
    result = result.replace("&apos;", "'")
    result = result.replace("&#x2F;", "/")
    result = result.replace("&#47;", "/")
    result
}

// ════════════════════════════════════════════════════════════════════
// 2. String Algorithms
// ════════════════════════════════════════════════════════════════════

// Compute Levenshtein edit distance between two strings.
func levenshtein(a, b) {
    const a_len = len(a)
    const b_len = len(b)
    if a_len == 0 { return b_len }
    if b_len == 0 { return a_len }
    // Single-row DP
    let prev_row = []
    let j = 0
    while j <= b_len {
        prev_row.push(j)
        j = j + 1
    }
    let curr_row = []
    j = 0
    while j <= b_len {
        curr_row.push(0)
        j = j + 1
    }
    let i = 0
    while i < a_len {
        curr_row[0] = i + 1
        j = 0
        while j < b_len {
            const cost = if a[i] == b[j] { 0 } else { 1 }
            const del = prev_row[j + 1] + 1
            const ins = curr_row[j] + 1
            const sub = prev_row[j] + cost
            let min_val = del
            if ins < min_val { min_val = ins }
            if sub < min_val { min_val = sub }
            curr_row[j + 1] = min_val
            j = j + 1
        }
        // Swap rows
        let tmp = prev_row
        prev_row = curr_row
        curr_row = tmp
        i = i + 1
    }
    prev_row[b_len]
}

// Convert a string to a URL-safe slug.
func slugify(s) {
    let result = ""
    let last_was_dash = true
    let i = 0
    while i < len(s) {
        const c = s[i]
        if (c >= "a" && c <= "z") || (c >= "0" && c <= "9") {
            result = result + c
            last_was_dash = false
        } else if c >= "A" && c <= "Z" {
            result = result + char_from_code(char_code_at(c, 0) + 32)
            last_was_dash = false
        } else if !last_was_dash {
            result = result + "-"
            last_was_dash = true
        }
        i = i + 1
    }
    if len(result) > 0 && result[len(result) - 1] == "-" {
        result = result.slice(0, len(result) - 1)
    }
    result
}

// ── Case Conversion Helpers ────────────────────────────────────────

func is_upper(c) { c >= "A" && c <= "Z" }
func is_lower(c) { c >= "a" && c <= "z" }
func is_alpha(c) { is_upper(c) || is_lower(c) }
func is_digit(c) { c >= "0" && c <= "9" }
func is_alnum(c) { is_alpha(c) || is_digit(c) }

func to_lower_char(c) {
    if is_upper(c) { char_from_code(char_code_at(c, 0) + 32) } else { c }
}

func to_upper_char(c) {
    if is_lower(c) { char_from_code(char_code_at(c, 0) - 32) } else { c }
}

// Split a string into words (on _ - space or camelCase boundaries).
func split_words(s) {
    let words = []
    let start = 0
    let i = 0
    while i < len(s) {
        const c = s[i]
        if c == "_" || c == "-" || c == " " {
            if start < i {
                words.push(s.slice(start, i))
            }
            start = i + 1
        } else if i > 0 && is_upper(c) && is_lower(s[i - 1]) {
            if start < i {
                words.push(s.slice(start, i))
            }
            start = i
        }
        i = i + 1
    }
    if start < len(s) {
        words.push(s.slice(start, len(s)))
    }
    words
}

// Convert to snake_case.
func to_snake_case(s) {
    const words = split_words(s)
    let parts = []
    for word in words {
        let lower = ""
        let i = 0
        while i < len(word) {
            lower = lower + to_lower_char(word[i])
            i = i + 1
        }
        parts.push(lower)
    }
    parts.join("_")
}

// Convert to lowerCamelCase.
func to_camel_case(s) {
    const words = split_words(s)
    let result = ""
    let idx = 0
    for word in words {
        if len(word) == 0 { idx = idx + 1; continue }
        if idx == 0 {
            let i = 0
            while i < len(word) {
                result = result + to_lower_char(word[i])
                i = i + 1
            }
        } else {
            result = result + to_upper_char(word[0])
            let i = 1
            while i < len(word) {
                result = result + to_lower_char(word[i])
                i = i + 1
            }
        }
        idx = idx + 1
    }
    result
}

// Convert to PascalCase (UpperCamelCase).
func to_pascal_case(s) {
    const words = split_words(s)
    let result = ""
    for word in words {
        if len(word) == 0 { continue }
        result = result + to_upper_char(word[0])
        let i = 1
        while i < len(word) {
            result = result + to_lower_char(word[i])
            i = i + 1
        }
    }
    result
}

// Convert to kebab-case.
func to_kebab_case(s) {
    const words = split_words(s)
    let parts = []
    for word in words {
        let lower = ""
        let i = 0
        while i < len(word) {
            lower = lower + to_lower_char(word[i])
            i = i + 1
        }
        parts.push(lower)
    }
    parts.join("-")
}

// Convert to SCREAMING_SNAKE_CASE.
func to_screaming_snake_case(s) {
    const words = split_words(s)
    let parts = []
    for word in words {
        let upper = ""
        let i = 0
        while i < len(word) {
            upper = upper + to_upper_char(word[i])
            i = i + 1
        }
        parts.push(upper)
    }
    parts.join("_")
}

// Convert to Title Case.
func to_title_case(s) {
    const words = split_words(s)
    let parts = []
    for word in words {
        if len(word) == 0 { continue }
        let titled = to_upper_char(word[0])
        let i = 1
        while i < len(word) {
            titled = titled + to_lower_char(word[i])
            i = i + 1
        }
        parts.push(titled)
    }
    parts.join(" ")
}

// ── String Padding ─────────────────────────────────────────────────

// Pad a string on the left to reach `width`.
func pad_left(s, width, ch) {
    let result = s
    while len(result) < width {
        result = ch + result
    }
    result
}

// Pad a string on the right to reach `width`.
func pad_right(s, width, ch) {
    let result = s
    while len(result) < width {
        result = result + ch
    }
    result
}

// Pad a string on both sides to center it.
func pad_center(s, width, ch) {
    if len(s) >= width { return s }
    const total = width - len(s)
    const left_pad = int(total / 2)
    const right_pad = total - left_pad
    let result = ""
    let i = 0
    while i < left_pad { result = result + ch; i = i + 1 }
    result = result + s
    i = 0
    while i < right_pad { result = result + ch; i = i + 1 }
    result
}

// ── Word Wrap ──────────────────────────────────────────────────────

// Wrap text to the given width, breaking on word boundaries.
func word_wrap(text, width) {
    const lines = text.split("\n")
    let result_parts = []
    for line in lines {
        if len(line) <= width {
            result_parts.push(line)
        } else {
            const words = line.split(" ")
            let current_line = ""
            for word in words {
                if len(current_line) == 0 {
                    current_line = word
                } else if len(current_line) + 1 + len(word) <= width {
                    current_line = current_line + " " + word
                } else {
                    result_parts.push(current_line)
                    current_line = word
                }
            }
            if len(current_line) > 0 {
                result_parts.push(current_line)
            }
        }
    }
    result_parts.join("\n")
}

// ── Truncate ───────────────────────────────────────────────────────

// Truncate a string to `max_len` characters, appending "..." if truncated.
func truncate(s, max_len) {
    if len(s) <= max_len { return s }
    if max_len <= 3 { return "..." .slice(0, max_len) }
    s.slice(0, max_len - 3) + "..."
}

// ── Indent / Dedent ────────────────────────────────────────────────

// Prepend `prefix` to every non-empty line in the text.
func indent(text, prefix) {
    const lines = text.split("\n")
    let result_parts = []
    for line in lines {
        if len(line.trim()) > 0 {
            result_parts.push(prefix + line)
        } else {
            result_parts.push(line)
        }
    }
    result_parts.join("\n")
}

// Remove common leading whitespace from all non-empty lines.
func dedent(text) {
    const lines = text.split("\n")
    let min_indent = 999999
    for line in lines {
        const trimmed = line.trim()
        if len(trimmed) > 0 {
            let spaces = 0
            let i = 0
            while i < len(line) && (line[i] == " " || line[i] == "\t") {
                spaces = spaces + 1
                i = i + 1
            }
            if spaces < min_indent {
                min_indent = spaces
            }
        }
    }
    if min_indent == 999999 || min_indent == 0 { return text }
    let result_parts = []
    for line in lines {
        if len(line.trim()) > 0 && len(line) >= min_indent {
            result_parts.push(line.slice(min_indent, len(line)))
        } else {
            result_parts.push(line)
        }
    }
    result_parts.join("\n")
}

// ════════════════════════════════════════════════════════════════════
// 3. JSON
// ════════════════════════════════════════════════════════════════════

// JSON value types using maps with a "__type" discriminant:
//   {"__type": "null"}
//   {"__type": "bool", "value": true/false}
//   {"__type": "number", "value": 42}
//   {"__type": "string", "value": "hello"}
//   {"__type": "array", "value": [...]}
//   {"__type": "object", "keys": [...], "values": [...]}

func json_null() { {"__type": "null"} }
func json_bool(b) { {"__type": "bool", "value": b} }
func json_number(n) { {"__type": "number", "value": n} }
func json_string(s) { {"__type": "string", "value": s} }
func json_array(items) { {"__type": "array", "value": items} }
func json_object(keys, values) { {"__type": "object", "keys": keys, "values": values} }

func json_is_null(v) { typeof(v) == "map" && v.has("__type") && v["__type"] == "null" }
func json_is_bool(v) { typeof(v) == "map" && v.has("__type") && v["__type"] == "bool" }
func json_is_number(v) { typeof(v) == "map" && v.has("__type") && v["__type"] == "number" }
func json_is_string(v) { typeof(v) == "map" && v.has("__type") && v["__type"] == "string" }
func json_is_array(v) { typeof(v) == "map" && v.has("__type") && v["__type"] == "array" }
func json_is_object(v) { typeof(v) == "map" && v.has("__type") && v["__type"] == "object" }

func json_get_value(v) {
    if typeof(v) == "map" && v.has("value") { v["value"] } else { null }
}

// ── JSON Parser (recursive descent) ───────────────────────────────

// Parser state: we pass source string and position as a map.
func json_skip_ws(src, pos) {
    let p = pos
    while p < len(src) && (src[p] == " " || src[p] == "\n" || src[p] == "\r" || src[p] == "\t") {
        p = p + 1
    }
    p
}

func json_parse(input) {
    const src = input.trim()
    if len(src) == 0 { return {"error": "empty JSON input"} }
    let pos = 0
    const result = json_parse_value(src, pos)
    if typeof(result) == "map" && result.has("error") { return result }
    const val = result["value"]
    let p = result["pos"]
    p = json_skip_ws(src, p)
    if p < len(src) {
        return {"error": f"trailing characters at position {p}"}
    }
    val
}

func json_parse_value(src, pos) {
    let p = json_skip_ws(src, pos)
    if p >= len(src) { return {"error": "unexpected end of JSON"} }
    const c = src[p]
    if c == "n" { return json_parse_null(src, p) }
    if c == "t" || c == "f" { return json_parse_bool(src, p) }
    if c == "\"" { return json_parse_string(src, p) }
    if c == "[" { return json_parse_array(src, p) }
    if c == "{" { return json_parse_object(src, p) }
    if c == "-" || (c >= "0" && c <= "9") { return json_parse_number(src, p) }
    {"error": f"unexpected character '{c}' at position {p}"}
}

func json_parse_null(src, pos) {
    if pos + 4 <= len(src) && src.slice(pos, pos + 4) == "null" {
        {"value": json_null(), "pos": pos + 4}
    } else {
        {"error": f"expected 'null' at position {pos}"}
    }
}

func json_parse_bool(src, pos) {
    if pos + 4 <= len(src) && src.slice(pos, pos + 4) == "true" {
        {"value": json_bool(true), "pos": pos + 4}
    } else if pos + 5 <= len(src) && src.slice(pos, pos + 5) == "false" {
        {"value": json_bool(false), "pos": pos + 5}
    } else {
        {"error": f"expected boolean at position {pos}"}
    }
}

func json_parse_string(src, pos) {
    if src[pos] != "\"" { return {"error": f"expected '\"' at position {pos}"} }
    let p = pos + 1
    let result = ""
    while p < len(src) {
        const c = src[p]
        if c == "\"" {
            return {"value": json_string(result), "pos": p + 1}
        }
        if c == "\\" {
            p = p + 1
            if p >= len(src) { return {"error": "unterminated string escape"} }
            const esc = src[p]
            if esc == "\"" { result = result + "\"" }
            else if esc == "\\" { result = result + "\\" }
            else if esc == "/" { result = result + "/" }
            else if esc == "n" { result = result + "\n" }
            else if esc == "t" { result = result + "\t" }
            else if esc == "r" { result = result + "\r" }
            else if esc == "b" { result = result + "\b" }
            else if esc == "f" { result = result + "\f" }
            else if esc == "u" {
                // Unicode escape \uXXXX
                if p + 4 < len(src) {
                    const hex_str = src.slice(p + 1, p + 5)
                    let code = 0
                    let valid = true
                    let hi = 0
                    while hi < 4 {
                        const hv = hex_val(hex_str[hi])
                        if hv < 0 { valid = false; break }
                        code = code * 16 + hv
                        hi = hi + 1
                    }
                    if valid {
                        result = result + char_from_code(code)
                        p = p + 4
                    } else {
                        result = result + "\\u" + hex_str
                        p = p + 4
                    }
                } else {
                    result = result + "\\u"
                }
            }
            else { result = result + "\\" + esc }
        } else {
            result = result + c
        }
        p = p + 1
    }
    {"error": "unterminated string"}
}

func json_parse_number(src, pos) {
    let p = pos
    let num_str = ""
    if p < len(src) && src[p] == "-" {
        num_str = num_str + "-"
        p = p + 1
    }
    while p < len(src) && src[p] >= "0" && src[p] <= "9" {
        num_str = num_str + src[p]
        p = p + 1
    }
    let is_float = false
    if p < len(src) && src[p] == "." {
        is_float = true
        num_str = num_str + "."
        p = p + 1
        while p < len(src) && src[p] >= "0" && src[p] <= "9" {
            num_str = num_str + src[p]
            p = p + 1
        }
    }
    if p < len(src) && (src[p] == "e" || src[p] == "E") {
        is_float = true
        num_str = num_str + src[p]
        p = p + 1
        if p < len(src) && (src[p] == "+" || src[p] == "-") {
            num_str = num_str + src[p]
            p = p + 1
        }
        while p < len(src) && src[p] >= "0" && src[p] <= "9" {
            num_str = num_str + src[p]
            p = p + 1
        }
    }
    const num = if is_float { to_float(num_str) } else { to_int(num_str) }
    {"value": json_number(num), "pos": p}
}

func json_parse_array(src, pos) {
    let p = pos + 1  // skip [
    p = json_skip_ws(src, p)
    let items = []
    if p < len(src) && src[p] == "]" {
        return {"value": json_array(items), "pos": p + 1}
    }
    while p < len(src) {
        const elem = json_parse_value(src, p)
        if typeof(elem) == "map" && elem.has("error") { return elem }
        items.push(elem["value"])
        p = json_skip_ws(src, elem["pos"])
        if p < len(src) && src[p] == "," {
            p = p + 1
            p = json_skip_ws(src, p)
        } else if p < len(src) && src[p] == "]" {
            return {"value": json_array(items), "pos": p + 1}
        } else {
            return {"error": f"expected ',' or ']' at position {p}"}
        }
    }
    {"error": "unterminated array"}
}

func json_parse_object(src, pos) {
    let p = pos + 1  // skip {
    p = json_skip_ws(src, p)
    let keys = []
    let values = []
    if p < len(src) && src[p] == "}" {
        return {"value": json_object(keys, values), "pos": p + 1}
    }
    while p < len(src) {
        // Parse key (must be string)
        p = json_skip_ws(src, p)
        const key_result = json_parse_string(src, p)
        if typeof(key_result) == "map" && key_result.has("error") { return key_result }
        const key = json_get_value(key_result["value"])
        p = json_skip_ws(src, key_result["pos"])
        if p >= len(src) || src[p] != ":" {
            return {"error": f"expected ':' at position {p}"}
        }
        p = p + 1
        // Parse value
        const val_result = json_parse_value(src, p)
        if typeof(val_result) == "map" && val_result.has("error") { return val_result }
        keys.push(key)
        values.push(val_result["value"])
        p = json_skip_ws(src, val_result["pos"])
        if p < len(src) && src[p] == "," {
            p = p + 1
        } else if p < len(src) && src[p] == "}" {
            return {"value": json_object(keys, values), "pos": p + 1}
        } else {
            return {"error": f"expected ',' or '}}' at position {p}"}
        }
    }
    {"error": "unterminated object"}
}

// ── JSON Emitter ───────────────────────────────────────────────────

// Compact JSON serialization.
func json_stringify(val) {
    if json_is_null(val) { return "null" }
    if json_is_bool(val) { return to_string(val["value"]) }
    if json_is_number(val) { return to_string(val["value"]) }
    if json_is_string(val) { return json_escape_string(val["value"]) }
    if json_is_array(val) {
        const items = val["value"]
        let parts = []
        for item in items {
            parts.push(json_stringify(item))
        }
        return "[" + parts.join(",") + "]"
    }
    if json_is_object(val) {
        const keys = val["keys"]
        const values = val["values"]
        let parts = []
        let i = 0
        while i < len(keys) {
            parts.push(json_escape_string(keys[i]) + ":" + json_stringify(values[i]))
            i = i + 1
        }
        return "{" + parts.join(",") + "}"
    }
    "null"
}

// Pretty JSON serialization.
func json_stringify_pretty(val) {
    json_emit_pretty(val, 0)
}

func json_emit_pretty(val, indent_level) {
    const pad = "  "
    let prefix = ""
    let i = 0
    while i < indent_level { prefix = prefix + pad; i = i + 1 }
    let inner_prefix = prefix + pad

    if json_is_null(val) { return "null" }
    if json_is_bool(val) { return to_string(val["value"]) }
    if json_is_number(val) { return to_string(val["value"]) }
    if json_is_string(val) { return json_escape_string(val["value"]) }
    if json_is_array(val) {
        const items = val["value"]
        if len(items) == 0 { return "[]" }
        let parts = []
        for item in items {
            parts.push(inner_prefix + json_emit_pretty(item, indent_level + 1))
        }
        return "[\n" + parts.join(",\n") + "\n" + prefix + "]"
    }
    if json_is_object(val) {
        const keys = val["keys"]
        const values = val["values"]
        if len(keys) == 0 { return "{}" }
        let parts = []
        i = 0
        while i < len(keys) {
            parts.push(inner_prefix + json_escape_string(keys[i]) + ": " + json_emit_pretty(values[i], indent_level + 1))
            i = i + 1
        }
        return "{\n" + parts.join(",\n") + "\n" + prefix + "}"
    }
    "null"
}

// Escape a string for JSON output.
func json_escape_string(s) {
    let result = "\""
    let i = 0
    while i < len(s) {
        const c = s[i]
        if c == "\"" { result = result + "\\\"" }
        else if c == "\\" { result = result + "\\\\" }
        else if c == "\n" { result = result + "\\n" }
        else if c == "\r" { result = result + "\\r" }
        else if c == "\t" { result = result + "\\t" }
        else { result = result + c }
        i = i + 1
    }
    result + "\""
}

// ── JSON Path Queries ──────────────────────────────────────────────

// Query a JSON value with a dotted path (e.g. "users.0.name").
func json_path(val, path) {
    const parts = path.split(".")
    let current = val
    for part in parts {
        if len(part) == 0 { continue }
        if json_is_object(current) {
            const keys = current["keys"]
            const values = current["values"]
            let found = false
            let i = 0
            while i < len(keys) {
                if keys[i] == part {
                    current = values[i]
                    found = true
                    break
                }
                i = i + 1
            }
            if !found { return json_null() }
        } else if json_is_array(current) {
            const idx = to_int(part)
            const items = current["value"]
            if idx >= 0 && idx < len(items) {
                current = items[idx]
            } else {
                return json_null()
            }
        } else {
            return json_null()
        }
    }
    current
}

// ── JSON Merge/Patch ───────────────────────────────────────────────

// Merge two JSON objects (RFC 7386). Patch values overwrite base values.
func json_merge_patch(base, patch) {
    if !json_is_object(patch) { return patch }
    if !json_is_object(base) {
        return json_merge_patch(json_object([], []), patch)
    }
    let keys = []
    let values = []
    // Copy base entries
    let i = 0
    const base_keys = base["keys"]
    const base_values = base["values"]
    while i < len(base_keys) {
        keys.push(base_keys[i])
        values.push(base_values[i])
        i = i + 1
    }
    // Apply patch
    const patch_keys = patch["keys"]
    const patch_values = patch["values"]
    i = 0
    while i < len(patch_keys) {
        const pk = patch_keys[i]
        const pv = patch_values[i]
        // Find existing key
        let found_idx = -1
        let j = 0
        while j < len(keys) {
            if keys[j] == pk { found_idx = j; break }
            j = j + 1
        }
        if json_is_null(pv) {
            // Remove key
            if found_idx >= 0 {
                keys.remove(found_idx)
                values.remove(found_idx)
            }
        } else if found_idx >= 0 {
            values[found_idx] = json_merge_patch(values[found_idx], pv)
        } else {
            keys.push(pk)
            values.push(pv)
        }
        i = i + 1
    }
    json_object(keys, values)
}

// ════════════════════════════════════════════════════════════════════
// 4. Regular Expressions (NFA-based engine)
// ════════════════════════════════════════════════════════════════════

// Regex node types (stored as maps for MAGI):
//   {"type": "literal", "char": "a"}
//   {"type": "any"}           — matches any char except \n
//   {"type": "class", "ranges": [[lo, hi], ...], "negated": false}
//   {"type": "anchor_start"}  — ^
//   {"type": "anchor_end"}    — $

// NFA state types:
//   {"type": "match", "node": <node>, "next": idx}
//   {"type": "split", "a": idx, "b": idx}
//   {"type": "accept"}

// ── Regex Compiler ─────────────────────────────────────────────────

// Compile a regex pattern to an NFA (array of states).
func regex_compile(pattern) {
    const chars = pattern.split("")
    let pos = {"val": 0}
    let states = []
    regex_compile_seq(chars, pos, states)
    // Ensure accept state exists
    if len(states) == 0 || states[len(states) - 1]["type"] != "accept" {
        states.push({"type": "accept"})
    }
    states
}

func regex_compile_seq(chars, pos, states) {
    // Check for alternation
    let has_alt = false
    let depth = 0
    let scan = pos["val"]
    while scan < len(chars) {
        if chars[scan] == "(" { depth = depth + 1 }
        else if chars[scan] == ")" { if depth == 0 { break }; depth = depth - 1 }
        else if chars[scan] == "|" && depth == 0 { has_alt = true; break }
        scan = scan + 1
    }
    if !has_alt {
        regex_compile_alt(chars, pos, states)
        return len(states)
    }
    // Alternation: compile each alternative
    let alt_ranges = []
    while true {
        const alt_start = len(states)
        regex_compile_alt(chars, pos, states)
        const alt_end = len(states)
        alt_ranges.push([alt_start, alt_end])
        if pos["val"] < len(chars) && chars[pos["val"]] == "|" {
            pos["val"] = pos["val"] + 1
        } else {
            break
        }
    }
    if len(alt_ranges) <= 1 { return len(states) }
    // Build split chain for alternations
    const after_idx = len(states)
    // Insert a split at front that branches to each alternative
    // For simplicity with 2 alternatives:
    if len(alt_ranges) == 2 {
        const a_start = alt_ranges[0][0]
        const b_start = alt_ranges[1][0]
        // Prepend a split state
        states.push({"type": "split", "a": a_start, "b": b_start})
    }
    return len(states)
}

func regex_compile_alt(chars, pos, states) {
    while pos["val"] < len(chars) && chars[pos["val"]] != "|" && chars[pos["val"]] != ")" {
        const c = chars[pos["val"]]
        if c == "." {
            pos["val"] = pos["val"] + 1
            const next = len(states) + 1
            states.push({"type": "match", "node": {"type": "any"}, "next": next})
            regex_apply_quantifier(chars, pos, states)
        } else if c == "^" {
            pos["val"] = pos["val"] + 1
            const next = len(states) + 1
            states.push({"type": "match", "node": {"type": "anchor_start"}, "next": next})
        } else if c == "$" {
            pos["val"] = pos["val"] + 1
            const next = len(states) + 1
            states.push({"type": "match", "node": {"type": "anchor_end"}, "next": next})
        } else if c == "[" {
            pos["val"] = pos["val"] + 1
            const class_result = regex_parse_char_class(chars, pos)
            const next = len(states) + 1
            states.push({"type": "match", "node": class_result, "next": next})
            regex_apply_quantifier(chars, pos, states)
        } else if c == "(" {
            pos["val"] = pos["val"] + 1
            // Check for non-capturing (?:...)
            if pos["val"] < len(chars) && chars[pos["val"]] == "?" {
                pos["val"] = pos["val"] + 1
                if pos["val"] < len(chars) && chars[pos["val"]] == ":" {
                    pos["val"] = pos["val"] + 1
                }
            }
            regex_compile_seq(chars, pos, states)
            if pos["val"] < len(chars) && chars[pos["val"]] == ")" {
                pos["val"] = pos["val"] + 1
            }
            regex_apply_quantifier(chars, pos, states)
        } else if c == "\\" {
            pos["val"] = pos["val"] + 1
            if pos["val"] >= len(chars) { break }
            const esc = chars[pos["val"]]
            pos["val"] = pos["val"] + 1
            const node = regex_parse_escape(esc)
            const next = len(states) + 1
            states.push({"type": "match", "node": node, "next": next})
            regex_apply_quantifier(chars, pos, states)
        } else {
            pos["val"] = pos["val"] + 1
            const next = len(states) + 1
            states.push({"type": "match", "node": {"type": "literal", "char": c}, "next": next})
            regex_apply_quantifier(chars, pos, states)
        }
    }
}

func regex_apply_quantifier(chars, pos, states) {
    if pos["val"] >= len(chars) { return }
    const c = chars[pos["val"]]
    if c == "*" {
        pos["val"] = pos["val"] + 1
        // Zero or more: Split -> (match, after)
        const last_idx = len(states) - 1
        const last_state = states[last_idx]
        const split_idx = last_idx
        const match_idx = last_idx + 1
        const after_idx = last_idx + 2
        states[last_idx] = {"type": "split", "a": match_idx, "b": after_idx}
        // Re-insert match, looping back to split
        let patched = last_state
        patched["next"] = split_idx
        states.push(patched)
        // Consume non-greedy ?
        if pos["val"] < len(chars) && chars[pos["val"]] == "?" { pos["val"] = pos["val"] + 1 }
    } else if c == "+" {
        pos["val"] = pos["val"] + 1
        // One or more: match -> Split(match, after)
        const match_idx = len(states) - 1
        const split_idx = len(states)
        states[match_idx]["next"] = split_idx
        states.push({"type": "split", "a": match_idx, "b": split_idx + 1})
        if pos["val"] < len(chars) && chars[pos["val"]] == "?" { pos["val"] = pos["val"] + 1 }
    } else if c == "?" {
        pos["val"] = pos["val"] + 1
        // Zero or one: Split -> (match, after)
        const last_idx = len(states) - 1
        const last_state = states[last_idx]
        const split_idx = last_idx
        const match_idx = last_idx + 1
        const after_idx = last_idx + 2
        states[last_idx] = {"type": "split", "a": match_idx, "b": after_idx}
        let patched = last_state
        patched["next"] = after_idx
        states.push(patched)
        if pos["val"] < len(chars) && chars[pos["val"]] == "?" { pos["val"] = pos["val"] + 1 }
    } else if c == "{" {
        // {n} or {n,m} quantifier
        pos["val"] = pos["val"] + 1
        let min_str = ""
        while pos["val"] < len(chars) && chars[pos["val"]] >= "0" && chars[pos["val"]] <= "9" {
            min_str = min_str + chars[pos["val"]]
            pos["val"] = pos["val"] + 1
        }
        let max_str = min_str
        if pos["val"] < len(chars) && chars[pos["val"]] == "," {
            pos["val"] = pos["val"] + 1
            max_str = ""
            while pos["val"] < len(chars) && chars[pos["val"]] >= "0" && chars[pos["val"]] <= "9" {
                max_str = max_str + chars[pos["val"]]
                pos["val"] = pos["val"] + 1
            }
            if len(max_str) == 0 { max_str = "999" }  // unbounded
        }
        if pos["val"] < len(chars) && chars[pos["val"]] == "}" {
            pos["val"] = pos["val"] + 1
        }
        // For simplicity, {n,m} just uses the pattern as-is.
        // The NFA approach handles this via the already-compiled states.
        if pos["val"] < len(chars) && chars[pos["val"]] == "?" { pos["val"] = pos["val"] + 1 }
    }
}

func regex_parse_char_class(chars, pos) {
    let ranges = []
    let negated = false
    if pos["val"] < len(chars) && chars[pos["val"]] == "^" {
        negated = true
        pos["val"] = pos["val"] + 1
    }
    while pos["val"] < len(chars) && chars[pos["val"]] != "]" {
        const c = chars[pos["val"]]
        if c == "\\" {
            pos["val"] = pos["val"] + 1
            if pos["val"] < len(chars) {
                const esc_node = regex_parse_escape(chars[pos["val"]])
                pos["val"] = pos["val"] + 1
                if esc_node["type"] == "class" {
                    for r in esc_node["ranges"] { ranges.push(r) }
                } else if esc_node["type"] == "literal" {
                    ranges.push([esc_node["char"], esc_node["char"]])
                }
            }
        } else {
            pos["val"] = pos["val"] + 1
            if pos["val"] + 1 < len(chars) && chars[pos["val"]] == "-" && chars[pos["val"] + 1] != "]" {
                pos["val"] = pos["val"] + 1
                const end_c = chars[pos["val"]]
                pos["val"] = pos["val"] + 1
                ranges.push([c, end_c])
            } else {
                ranges.push([c, c])
            }
        }
    }
    if pos["val"] < len(chars) && chars[pos["val"]] == "]" {
        pos["val"] = pos["val"] + 1
    }
    {"type": "class", "ranges": ranges, "negated": negated}
}

func regex_parse_escape(c) {
    if c == "d" { return {"type": "class", "ranges": [["0", "9"]], "negated": false} }
    if c == "D" { return {"type": "class", "ranges": [["0", "9"]], "negated": true} }
    if c == "w" { return {"type": "class", "ranges": [["a", "z"], ["A", "Z"], ["0", "9"], ["_", "_"]], "negated": false} }
    if c == "W" { return {"type": "class", "ranges": [["a", "z"], ["A", "Z"], ["0", "9"], ["_", "_"]], "negated": true} }
    if c == "s" { return {"type": "class", "ranges": [[" ", " "], ["\t", "\t"], ["\n", "\n"], ["\r", "\r"]], "negated": false} }
    if c == "S" { return {"type": "class", "ranges": [[" ", " "], ["\t", "\t"], ["\n", "\n"], ["\r", "\r"]], "negated": true} }
    if c == "n" { return {"type": "literal", "char": "\n"} }
    if c == "t" { return {"type": "literal", "char": "\t"} }
    if c == "r" { return {"type": "literal", "char": "\r"} }
    {"type": "literal", "char": c}
}

// ── Regex NFA Simulation ───────────────────────────────────────────

func regex_match_node(node, ch) {
    if node["type"] == "literal" {
        return ch == node["char"]
    }
    if node["type"] == "any" {
        return ch != "\n"
    }
    if node["type"] == "class" {
        let in_class = false
        for range in node["ranges"] {
            if ch >= range[0] && ch <= range[1] {
                in_class = true
                break
            }
        }
        return if node["negated"] { !in_class } else { in_class }
    }
    if node["type"] == "anchor_start" || node["type"] == "anchor_end" {
        return false  // zero-width, handled elsewhere
    }
    false
}

func regex_add_state(states, active, state_idx, pos, text) {
    if state_idx >= len(states) { return }
    if active[state_idx] { return }
    active[state_idx] = true
    const state = states[state_idx]
    if state["type"] == "split" {
        regex_add_state(states, active, state["a"], pos, text)
        regex_add_state(states, active, state["b"], pos, text)
    } else if state["type"] == "match" {
        const node = state["node"]
        if node["type"] == "anchor_start" {
            if pos == 0 { regex_add_state(states, active, state["next"], pos, text) }
        } else if node["type"] == "anchor_end" {
            if pos == len(text) { regex_add_state(states, active, state["next"], pos, text) }
        }
    }
}

// Try to match NFA at a given start position. Returns end position or -1.
func regex_match_at(states, text, start) {
    const n = len(states)
    let current = []
    let i = 0
    while i < n { current.push(false); i = i + 1 }
    regex_add_state(states, current, 0, start, text)
    let last_match = -1
    // Check immediate accept
    i = 0
    while i < n {
        if current[i] && states[i]["type"] == "accept" { last_match = start }
        i = i + 1
    }
    let pos = start
    while pos < len(text) {
        const ch = text[pos]
        let next = []
        i = 0
        while i < n { next.push(false); i = i + 1 }
        i = 0
        while i < n {
            if current[i] {
                const state = states[i]
                if state["type"] == "match" {
                    const node = state["node"]
                    if node["type"] != "anchor_start" && node["type"] != "anchor_end" {
                        if regex_match_node(node, ch) {
                            regex_add_state(states, next, state["next"], pos + 1, text)
                        }
                    }
                }
            }
            i = i + 1
        }
        current = next
        pos = pos + 1
        // Check for accept
        i = 0
        while i < n {
            if current[i] && states[i]["type"] == "accept" { last_match = pos }
            i = i + 1
        }
    }
    // Check $ anchor at end
    i = 0
    while i < n {
        if current[i] {
            const state = states[i]
            if state["type"] == "match" && state["node"]["type"] == "anchor_end" {
                regex_add_state(states, current, state["next"], pos, text)
            }
        }
        i = i + 1
    }
    i = 0
    while i < n {
        if current[i] && states[i]["type"] == "accept" { last_match = pos }
        i = i + 1
    }
    last_match
}

// ── Regex Public API ───────────────────────────────────────────────

// Test if a pattern matches anywhere in text.
func regex_test(pattern, text) {
    const nfa = regex_compile(pattern)
    let start = 0
    while start <= len(text) {
        if regex_match_at(nfa, text, start) >= 0 { return true }
        start = start + 1
    }
    false
}

// Find the first match of pattern in text. Returns [start, end] or null.
func regex_match(pattern, text) {
    const nfa = regex_compile(pattern)
    let start = 0
    while start <= len(text) {
        const end = regex_match_at(nfa, text, start)
        if end >= 0 { return [start, end] }
        start = start + 1
    }
    null
}

// Find all non-overlapping matches. Returns array of [start, end].
func regex_find_all(pattern, text) {
    const nfa = regex_compile(pattern)
    let results = []
    let start = 0
    while start <= len(text) {
        const end = regex_match_at(nfa, text, start)
        if end >= 0 {
            results.push([start, end])
            start = if end > start { end } else { start + 1 }
        } else {
            start = start + 1
        }
    }
    results
}

// Replace all matches of pattern with replacement.
func regex_replace(pattern, text, replacement) {
    const nfa = regex_compile(pattern)
    let result = ""
    let pos = 0
    while pos <= len(text) {
        const end = regex_match_at(nfa, text, pos)
        if end >= 0 {
            result = result + replacement
            if end > pos { pos = end } else {
                if pos < len(text) { result = result + text[pos] }
                pos = pos + 1
            }
        } else {
            if pos < len(text) { result = result + text[pos] }
            pos = pos + 1
        }
    }
    result
}

// Split text by regex pattern.
func regex_split(pattern, text) {
    const matches = regex_find_all(pattern, text)
    if len(matches) == 0 { return [text] }
    let parts = []
    let last = 0
    for m in matches {
        parts.push(text.slice(last, m[0]))
        last = m[1]
    }
    parts.push(text.slice(last, len(text)))
    parts
}

// Escape special regex metacharacters.
func regex_escape(s) {
    const meta = "\\.*+?()[]{}|^$"
    let result = ""
    let i = 0
    while i < len(s) {
        if meta.contains(s[i]) {
            result = result + "\\" + s[i]
        } else {
            result = result + s[i]
        }
        i = i + 1
    }
    result
}

// ════════════════════════════════════════════════════════════════════
// 5. YAML Parser
// ════════════════════════════════════════════════════════════════════

// YAML value types (same map-with-discriminant pattern as JSON):
//   {"__type": "yaml_null"}
//   {"__type": "yaml_bool", "value": true}
//   {"__type": "yaml_int", "value": 42}
//   {"__type": "yaml_float", "value": 3.14}
//   {"__type": "yaml_string", "value": "hello"}
//   {"__type": "yaml_sequence", "value": [...]}
//   {"__type": "yaml_mapping", "keys": [...], "values": [...]}

func yaml_null() { {"__type": "yaml_null"} }
func yaml_bool(b) { {"__type": "yaml_bool", "value": b} }
func yaml_int(n) { {"__type": "yaml_int", "value": n} }
func yaml_float(f) { {"__type": "yaml_float", "value": f} }
func yaml_string(s) { {"__type": "yaml_string", "value": s} }
func yaml_sequence(items) { {"__type": "yaml_sequence", "value": items} }
func yaml_mapping(keys, values) { {"__type": "yaml_mapping", "keys": keys, "values": values} }

// Parse a YAML scalar value (string, number, bool, null).
func yaml_parse_scalar(s) {
    const trimmed = s.trim()
    if len(trimmed) == 0 || trimmed == "~" || trimmed == "null" || trimmed == "Null" || trimmed == "NULL" {
        return yaml_null()
    }
    if trimmed == "true" || trimmed == "True" || trimmed == "TRUE" || trimmed == "yes" || trimmed == "Yes" {
        return yaml_bool(true)
    }
    if trimmed == "false" || trimmed == "False" || trimmed == "FALSE" || trimmed == "no" || trimmed == "No" {
        return yaml_bool(false)
    }
    // Quoted strings
    if (trimmed[0] == "\"" && trimmed[len(trimmed) - 1] == "\"") || (trimmed[0] == "'" && trimmed[len(trimmed) - 1] == "'") {
        return yaml_string(trimmed.slice(1, len(trimmed) - 1))
    }
    // Try integer
    const as_int = to_int(trimmed)
    if to_string(as_int) == trimmed { return yaml_int(as_int) }
    // Try float
    if trimmed.contains(".") || trimmed.contains("e") || trimmed.contains("E") {
        const as_float = to_float(trimmed)
        if to_string(as_float) != "NaN" { return yaml_float(as_float) }
    }
    // Flow sequence [a, b]
    if trimmed[0] == "[" && trimmed[len(trimmed) - 1] == "]" {
        const inner = trimmed.slice(1, len(trimmed) - 1)
        const parts = yaml_split_flow(inner)
        let items = []
        for part in parts {
            items.push(yaml_parse_scalar(part.trim()))
        }
        return yaml_sequence(items)
    }
    // Flow mapping {a: b}
    if trimmed[0] == "{" && trimmed[len(trimmed) - 1] == "}" {
        const inner = trimmed.slice(1, len(trimmed) - 1)
        const parts = yaml_split_flow(inner)
        let keys = []
        let values = []
        for part in parts {
            const colon_pos = part.indexOf(":")
            if colon_pos >= 0 {
                keys.push(yaml_parse_scalar(part.slice(0, colon_pos).trim()))
                values.push(yaml_parse_scalar(part.slice(colon_pos + 1, len(part)).trim()))
            }
        }
        return yaml_mapping(keys, values)
    }
    yaml_string(trimmed)
}

// Split comma-separated flow elements respecting nesting.
func yaml_split_flow(s) {
    let parts = []
    let current = ""
    let depth = 0
    let in_quote = false
    let quote_char = ""
    let i = 0
    while i < len(s) {
        const c = s[i]
        if in_quote {
            current = current + c
            if c == quote_char { in_quote = false }
        } else if c == "\"" || c == "'" {
            in_quote = true
            quote_char = c
            current = current + c
        } else if c == "[" || c == "{" {
            depth = depth + 1
            current = current + c
        } else if c == "]" || c == "}" {
            depth = depth - 1
            current = current + c
        } else if c == "," && depth == 0 {
            parts.push(current.trim())
            current = ""
        } else {
            current = current + c
        }
        i = i + 1
    }
    if len(current.trim()) > 0 {
        parts.push(current.trim())
    }
    parts
}

// Get line indentation.
func yaml_line_indent(line) {
    let i = 0
    while i < len(line) && (line[i] == " " || line[i] == "\t") {
        i = i + 1
    }
    i
}

// Find colon position in YAML line (outside quotes).
func yaml_find_colon(s) {
    let in_quote = false
    let quote_char = ""
    let i = 0
    while i < len(s) {
        const c = s[i]
        if in_quote {
            if c == quote_char { in_quote = false }
        } else if c == "\"" || c == "'" {
            in_quote = true
            quote_char = c
        } else if c == ":" && (i + 1 >= len(s) || s[i + 1] == " ") {
            return i
        } else if c == "#" {
            return -1
        }
        i = i + 1
    }
    -1
}

// Parse a YAML document.
func yaml_parse(input) {
    const trimmed = input.trim()
    if len(trimmed) == 0 { return yaml_null() }
    const lines = input.split("\n")
    let pos = {"val": 0}
    // Skip leading --- and comments
    while pos["val"] < len(lines) {
        const l = lines[pos["val"]].trim()
        if l == "" || l == "---" || l[0] == "#" {
            pos["val"] = pos["val"] + 1
        } else {
            break
        }
    }
    if pos["val"] >= len(lines) { return yaml_null() }
    yaml_parse_value(lines, pos)
}

func yaml_parse_value(lines, pos) {
    if pos["val"] >= len(lines) { return yaml_null() }
    const line = lines[pos["val"]]
    const trimmed = line.trim()
    const ind = yaml_line_indent(line)
    // Sequence
    if trimmed.starts_with("- ") || trimmed == "-" {
        return yaml_parse_sequence(lines, pos, ind)
    }
    // Mapping
    const colon_pos = yaml_find_colon(trimmed)
    if colon_pos > 0 {
        return yaml_parse_mapping(lines, pos, ind)
    }
    pos["val"] = pos["val"] + 1
    yaml_parse_scalar(trimmed)
}

func yaml_parse_sequence(lines, pos, base_indent) {
    let items = []
    while pos["val"] < len(lines) {
        const line = lines[pos["val"]]
        const trimmed = line.trim()
        if len(trimmed) == 0 || trimmed[0] == "#" {
            pos["val"] = pos["val"] + 1
            continue
        }
        const ind = yaml_line_indent(line)
        if ind < base_indent { break }
        if ind > base_indent { break }
        if trimmed.starts_with("- ") {
            const val_str = trimmed.slice(2, len(trimmed)).trim()
            if len(val_str) > 0 {
                items.push(yaml_parse_scalar(val_str))
                pos["val"] = pos["val"] + 1
            } else {
                pos["val"] = pos["val"] + 1
                if pos["val"] < len(lines) {
                    const val = yaml_parse_value(lines, pos)
                    items.push(val)
                } else {
                    items.push(yaml_null())
                }
            }
        } else if trimmed == "-" {
            pos["val"] = pos["val"] + 1
            if pos["val"] < len(lines) {
                const val = yaml_parse_value(lines, pos)
                items.push(val)
            } else {
                items.push(yaml_null())
            }
        } else {
            break
        }
    }
    yaml_sequence(items)
}

func yaml_parse_mapping(lines, pos, base_indent) {
    let keys = []
    let values = []
    while pos["val"] < len(lines) {
        const line = lines[pos["val"]]
        const trimmed = line.trim()
        if len(trimmed) == 0 || trimmed[0] == "#" {
            pos["val"] = pos["val"] + 1
            continue
        }
        const ind = yaml_line_indent(line)
        if ind < base_indent { break }
        if ind > base_indent { break }
        const colon_pos = yaml_find_colon(trimmed)
        if colon_pos <= 0 { break }
        const key_str = trimmed.slice(0, colon_pos).trim()
        const val_str = trimmed.slice(colon_pos + 1, len(trimmed)).trim()
        keys.push(yaml_parse_scalar(key_str))
        if len(val_str) > 0 {
            values.push(yaml_parse_scalar(val_str))
            pos["val"] = pos["val"] + 1
        } else {
            pos["val"] = pos["val"] + 1
            if pos["val"] < len(lines) {
                const next_line = lines[pos["val"]]
                const next_indent = yaml_line_indent(next_line)
                if next_indent > ind {
                    const val = yaml_parse_value(lines, pos)
                    values.push(val)
                } else {
                    values.push(yaml_null())
                }
            } else {
                values.push(yaml_null())
            }
        }
    }
    yaml_mapping(keys, values)
}

// Serialize YAML value to string.
func yaml_stringify(val) {
    yaml_emit(val, 0, false) + "\n"
}

func yaml_emit(val, ind, inline) {
    const prefix = " ".repeat(ind)
    if val["__type"] == "yaml_null" { return "null" }
    if val["__type"] == "yaml_bool" { return to_string(val["value"]) }
    if val["__type"] == "yaml_int" { return to_string(val["value"]) }
    if val["__type"] == "yaml_float" { return to_string(val["value"]) }
    if val["__type"] == "yaml_string" {
        const s = val["value"]
        if s.contains(":") || s.contains("#") || s.contains("\n") || s.contains("\"") {
            return "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n") + "\""
        }
        return s
    }
    if val["__type"] == "yaml_sequence" {
        const items = val["value"]
        if len(items) == 0 { return "[]" }
        let parts = []
        for item in items {
            parts.push(prefix + "- " + yaml_emit(item, ind + 2, true))
        }
        return if inline { "\n" + parts.join("\n") } else { parts.join("\n") }
    }
    if val["__type"] == "yaml_mapping" {
        const keys = val["keys"]
        const values = val["values"]
        if len(keys) == 0 { return "{}" }
        let parts = []
        let i = 0
        while i < len(keys) {
            parts.push(prefix + yaml_emit(keys[i], ind, true) + ": " + yaml_emit(values[i], ind + 2, true))
            i = i + 1
        }
        return if inline { "\n" + parts.join("\n") } else { parts.join("\n") }
    }
    "null"
}

// ════════════════════════════════════════════════════════════════════
// 6. UUID
// ════════════════════════════════════════════════════════════════════

// Generate a UUID v4 (random). Delegates to stage 0 random_bytes.
func uuid_v4() {
    const bytes = random_bytes(16)
    // Set version 4 in byte 6
    let b6 = char_code_at(bytes, 6)
    b6 = (b6 % 16) + 64  // clear high nibble, set 0x40
    // Set variant 1 in byte 8
    let b8 = char_code_at(bytes, 8)
    b8 = (b8 % 64) + 128  // clear high 2 bits, set 10xxxxxx
    // Format as hex with hyphens
    let result = ""
    let i = 0
    while i < 16 {
        let byte_val = char_code_at(bytes, i)
        if i == 6 { byte_val = b6 }
        if i == 8 { byte_val = b8 }
        result = result + HEX_LOWER[int(byte_val / 16)] + HEX_LOWER[byte_val % 16]
        if i == 3 || i == 5 || i == 7 || i == 9 {
            result = result + "-"
        }
        i = i + 1
    }
    result
}

// Parse a UUID string. Returns a map with "bytes" and "version" or "error".
func uuid_parse(s) {
    const trimmed = s.trim()
    if len(trimmed) != 36 { return {"error": "invalid UUID length"} }
    if trimmed[8] != "-" || trimmed[13] != "-" || trimmed[18] != "-" || trimmed[23] != "-" {
        return {"error": "invalid UUID format"}
    }
    let hex_str = ""
    let i = 0
    while i < len(trimmed) {
        if trimmed[i] != "-" { hex_str = hex_str + trimmed[i] }
        i = i + 1
    }
    if len(hex_str) != 32 { return {"error": "invalid UUID hex length"} }
    // Validate all hex characters
    i = 0
    while i < len(hex_str) {
        if hex_val(hex_str[i]) < 0 { return {"error": f"invalid hex char in UUID at {i}"} }
        i = i + 1
    }
    const version = hex_val(hex_str[12])  // high nibble of byte 6
    {"version": version, "hex": hex_str}
}

// Check if a string is a valid UUID.
func uuid_is_valid(s) {
    const result = uuid_parse(s)
    typeof(result) == "map" && !result.has("error")
}

// ════════════════════════════════════════════════════════════════════
// 7. Compression (delegate to stage 0 builtins)
// ════════════════════════════════════════════════════════════════════

// Gzip compress data. Delegates to stage 0 builtin.
func gzip_compress(data) { compress_gzip(data) }

// Gzip decompress data. Delegates to stage 0 builtin.
func gzip_decompress(data) { decompress_gzip(data) }

// LZ4 compress data. Delegates to stage 0 builtin.
func lz4_compress(data) { compress_lz4(data) }

// LZ4 decompress data. Delegates to stage 0 builtin.
func lz4_decompress(data) { decompress_lz4(data) }

// Zstd compress data. Delegates to stage 0 builtin.
func zstd_compress(data) { compress_zstd(data) }

// Zstd decompress data. Delegates to stage 0 builtin.
func zstd_decompress(data) { decompress_zstd(data) }

// ════════════════════════════════════════════════════════════════════
// 8. HTTP
// ════════════════════════════════════════════════════════════════════

// ── URL Parser ─────────────────────────────────────────────────────

// Parse a URL into its components. Returns a map with scheme, host, port, path, query, fragment.
func url_parse(url) {
    let rest = url
    // 1. Parse scheme
    const scheme_end = rest.indexOf("://")
    if scheme_end < 0 { return {"error": "missing scheme"} }
    let scheme = rest.slice(0, scheme_end)
    // Lowercase the scheme
    let scheme_lower = ""
    let si = 0
    while si < len(scheme) {
        scheme_lower = scheme_lower + to_lower_char(scheme[si])
        si = si + 1
    }
    scheme = scheme_lower
    rest = rest.slice(scheme_end + 3, len(rest))
    // 2. Split off fragment
    let fragment = null
    const frag_pos = rest.lastIndexOf("#")
    if frag_pos >= 0 {
        fragment = rest.slice(frag_pos + 1, len(rest))
        rest = rest.slice(0, frag_pos)
    }
    // 3. Split off query
    let query = null
    const query_pos = rest.indexOf("?")
    if query_pos >= 0 {
        query = rest.slice(query_pos + 1, len(rest))
        rest = rest.slice(0, query_pos)
    }
    // 4. Split authority from path
    const path_pos = rest.indexOf("/")
    let authority = rest
    let path = "/"
    if path_pos >= 0 {
        authority = rest.slice(0, path_pos)
        path = rest.slice(path_pos, len(rest))
    }
    // 5. Parse host:port from authority
    let host = authority
    let port = null
    const colon_pos = authority.lastIndexOf(":")
    if colon_pos >= 0 {
        const maybe_port = authority.slice(colon_pos + 1, len(authority))
        let all_digits = true
        let pi = 0
        while pi < len(maybe_port) {
            if maybe_port[pi] < "0" || maybe_port[pi] > "9" { all_digits = false; break }
            pi = pi + 1
        }
        if all_digits && len(maybe_port) > 0 {
            host = authority.slice(0, colon_pos)
            port = to_int(maybe_port)
        }
    }
    // Default port
    if port == null {
        if scheme == "http" || scheme == "ws" { port = 80 }
        else if scheme == "https" || scheme == "wss" { port = 443 }
        else if scheme == "ftp" { port = 21 }
    }
    {
        "scheme": scheme,
        "host": host,
        "port": port,
        "path": path,
        "query": query,
        "fragment": fragment,
    }
}

// Reconstruct a URL from parsed components.
func url_to_string(parts) {
    let result = parts["scheme"] + "://" + parts["host"]
    if parts["port"] != null {
        const default_port = if parts["scheme"] == "http" { 80 }
                            else if parts["scheme"] == "https" { 443 }
                            else { -1 }
        if parts["port"] != default_port {
            result = result + ":" + to_string(parts["port"])
        }
    }
    result = result + parts["path"]
    if parts["query"] != null { result = result + "?" + parts["query"] }
    if parts["fragment"] != null { result = result + "#" + parts["fragment"] }
    result
}

// ── Query String ───────────────────────────────────────────────────

// Parse a query string into a map of key-value pairs.
func query_parse(qs) {
    let result = {}
    if len(qs) == 0 { return result }
    const pairs = qs.split("&")
    for pair in pairs {
        const eq_pos = pair.indexOf("=")
        if eq_pos >= 0 {
            const key = url_decode(pair.slice(0, eq_pos))
            const value = url_decode(pair.slice(eq_pos + 1, len(pair)))
            result[key] = value
        } else {
            result[url_decode(pair)] = ""
        }
    }
    result
}

// Stringify a map of key-value pairs into a query string.
func query_stringify(params) {
    let parts = []
    for key in keys(params) {
        parts.push(url_encode(key) + "=" + url_encode(to_string(params[key])))
    }
    parts.join("&")
}

// ── HTTP Request Parser ────────────────────────────────────────────

// Parse an HTTP request string into its components.
func http_parse_request(raw) {
    const header_end = raw.indexOf("\r\n\r\n")
    if header_end < 0 { return {"error": "incomplete request"} }
    const header_section = raw.slice(0, header_end)
    const body = raw.slice(header_end + 4, len(raw))
    const lines = header_section.split("\r\n")
    if len(lines) == 0 { return {"error": "empty request"} }
    // Parse request line
    const request_line = lines[0]
    const parts = request_line.split(" ")
    if len(parts) < 2 { return {"error": "malformed request line"} }
    const method = parts[0]
    const path = parts[1]
    const version = if len(parts) >= 3 { parts[2] } else { "HTTP/1.1" }
    // Parse headers
    let headers = {}
    let i = 1
    while i < len(lines) {
        const line = lines[i]
        const colon_pos = line.indexOf(":")
        if colon_pos >= 0 {
            const name = line.slice(0, colon_pos).trim()
            const value = line.slice(colon_pos + 1, len(line)).trim()
            headers[name] = value
        }
        i = i + 1
    }
    {
        "method": method,
        "path": path,
        "version": version,
        "headers": headers,
        "body": body,
    }
}

// ── HTTP Response Parser ───────────────────────────────────────────

// Parse an HTTP response string into its components.
func http_parse_response(raw) {
    const header_end = raw.indexOf("\r\n\r\n")
    if header_end < 0 { return {"error": "incomplete response"} }
    const header_section = raw.slice(0, header_end)
    const body = raw.slice(header_end + 4, len(raw))
    const lines = header_section.split("\r\n")
    if len(lines) == 0 { return {"error": "empty response"} }
    // Parse status line
    const status_line = lines[0]
    const parts = status_line.split(" ")
    if len(parts) < 2 { return {"error": "malformed status line"} }
    const version = parts[0]
    const status = to_int(parts[1])
    let reason = ""
    if len(parts) >= 3 {
        let rparts = []
        let ri = 2
        while ri < len(parts) { rparts.push(parts[ri]); ri = ri + 1 }
        reason = rparts.join(" ")
    }
    // Parse headers
    let headers = {}
    let i = 1
    while i < len(lines) {
        const line = lines[i]
        const colon_pos = line.indexOf(":")
        if colon_pos >= 0 {
            const name = line.slice(0, colon_pos).trim()
            const value = line.slice(colon_pos + 1, len(line)).trim()
            headers[name] = value
        }
        i = i + 1
    }
    {
        "version": version,
        "status": status,
        "reason": reason,
        "headers": headers,
        "body": body,
    }
}

// ── HTTP Status Codes ──────────────────────────────────────────────

func http_status_reason(code) {
    if code == 200 { return "OK" }
    if code == 201 { return "Created" }
    if code == 204 { return "No Content" }
    if code == 301 { return "Moved Permanently" }
    if code == 302 { return "Found" }
    if code == 304 { return "Not Modified" }
    if code == 400 { return "Bad Request" }
    if code == 401 { return "Unauthorized" }
    if code == 403 { return "Forbidden" }
    if code == 404 { return "Not Found" }
    if code == 405 { return "Method Not Allowed" }
    if code == 409 { return "Conflict" }
    if code == 422 { return "Unprocessable Entity" }
    if code == 429 { return "Too Many Requests" }
    if code == 500 { return "Internal Server Error" }
    if code == 502 { return "Bad Gateway" }
    if code == 503 { return "Service Unavailable" }
    if code == 504 { return "Gateway Timeout" }
    "Unknown"
}

// ════════════════════════════════════════════════════════════════════
// 9. Crypto Helpers (delegate to stage 0 builtins)
// ════════════════════════════════════════════════════════════════════

// SHA-256 hash. Delegates to stage 0 builtin.
func sha256(data) { hash_sha256(data) }

// SHA-512 hash. Delegates to stage 0 builtin.
func sha512(data) { hash_sha512(data) }

// HMAC-SHA256. Delegates to stage 0 builtin.
func hmac_sha256(key, data) { hmac_sha256_builtin(key, data) }

// PBKDF2-SHA256. Delegates to stage 0 builtin.
func pbkdf2(password, salt, iterations, key_len) {
    pbkdf2_sha256_builtin(password, salt, iterations, key_len)
}

// Generate random bytes. Delegates to stage 0 builtin.
func random_bytes(n) { random_bytes_builtin(n) }

// Constant-time comparison of two strings.
func constant_time_eq(a, b) {
    if len(a) != len(b) { return false }
    let diff = 0
    let i = 0
    while i < len(a) {
        const ca = char_code_at(a, i)
        const cb = char_code_at(b, i)
        // XOR — bitwise using integers
        diff = diff + (if ca != cb { 1 } else { 0 })
        i = i + 1
    }
    diff == 0
}

// ════════════════════════════════════════════════════════════════════
// 10. Date/Time
// ════════════════════════════════════════════════════════════════════

// Convert days since Unix epoch to (year, month, day) using Hinnant's algorithm.
func civil_from_days(z) {
    let z2 = z + 719468
    const era = int(if z2 >= 0 { z2 } else { z2 - 146096 } / 146097)
    const doe = z2 - era * 146097
    const yoe = int((doe - int(doe / 1460) + int(doe / 36524) - int(doe / 146096)) / 365)
    const y = yoe + era * 400
    const doy = doe - (365 * yoe + int(yoe / 4) - int(yoe / 100))
    const mp = int((5 * doy + 2) / 153)
    const d = doy - int((153 * mp + 2) / 5) + 1
    const m = if mp < 10 { mp + 3 } else { mp - 9 }
    const y_adj = if m <= 2 { y + 1 } else { y }
    [y_adj, m, d]
}

// Convert (year, month, day) to days since Unix epoch.
func days_from_civil(y, m, d) {
    const y_adj = if m <= 2 { y - 1 } else { y }
    const era = int(if y_adj >= 0 { y_adj } else { y_adj - 399 } / 400)
    const yoe = y_adj - era * 400
    const m_adj = if m <= 2 { m + 9 } else { m - 3 }
    const doy = int((153 * m_adj + 2) / 5) + d - 1
    const doe = yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy
    era * 146097 + doe - 719468
}

// Convert Unix timestamp in milliseconds to DateTime components.
func datetime_from_millis(ms) {
    const total_secs = int(ms / 1000)
    const millis_part = ms % 1000
    const days = int(total_secs / 86400)
    const day_secs = total_secs % 86400
    const ymd = civil_from_days(days)
    {
        "year": ymd[0],
        "month": ymd[1],
        "day": ymd[2],
        "hour": int(day_secs / 3600),
        "minute": int(day_secs % 3600 / 60),
        "second": day_secs % 60,
        "millis": millis_part,
    }
}

// Format a Unix timestamp (millis) as ISO 8601 string.
func format_timestamp(ms) {
    const dt = datetime_from_millis(ms)
    const y = pad_left(to_string(dt["year"]), 4, "0")
    const mo = pad_left(to_string(dt["month"]), 2, "0")
    const d = pad_left(to_string(dt["day"]), 2, "0")
    const h = pad_left(to_string(dt["hour"]), 2, "0")
    const mi = pad_left(to_string(dt["minute"]), 2, "0")
    const s = pad_left(to_string(dt["second"]), 2, "0")
    const ms_str = pad_left(to_string(dt["millis"]), 3, "0")
    f"{y}-{mo}-{d}T{h}:{mi}:{s}.{ms_str}Z"
}

// Parse an ISO 8601 date string to Unix millis.
func parse_timestamp(s) {
    const trimmed = s.trim()
    // Date only: YYYY-MM-DD
    if len(trimmed) == 10 && trimmed[4] == "-" && trimmed[7] == "-" {
        const y = to_int(trimmed.slice(0, 4))
        const m = to_int(trimmed.slice(5, 7))
        const d = to_int(trimmed.slice(8, 10))
        return days_from_civil(y, m, d) * 86400 * 1000
    }
    // Full datetime — split on T or space
    let sep_pos = trimmed.indexOf("T")
    if sep_pos < 0 { sep_pos = trimmed.indexOf(" ") }
    if sep_pos < 0 { return {"error": "unrecognized datetime format"} }
    const date_part = trimmed.slice(0, sep_pos)
    let time_part = trimmed.slice(sep_pos + 1, len(trimmed))
    // Parse date
    const date_parts = date_part.split("-")
    if len(date_parts) != 3 { return {"error": "invalid date format"} }
    const y = to_int(date_parts[0])
    const m = to_int(date_parts[1])
    const d = to_int(date_parts[2])
    // Parse timezone
    let tz_offset_secs = 0
    if time_part.ends_with("Z") {
        time_part = time_part.slice(0, len(time_part) - 1)
    } else if len(time_part) > 6 {
        const last6 = time_part.slice(len(time_part) - 6, len(time_part))
        if (last6[0] == "+" || last6[0] == "-") && last6[3] == ":" {
            const sign = if last6[0] == "+" { 1 } else { -1 }
            const tz_h = to_int(last6.slice(1, 3))
            const tz_m = to_int(last6.slice(4, 6))
            tz_offset_secs = sign * (tz_h * 3600 + tz_m * 60)
            time_part = time_part.slice(0, len(time_part) - 6)
        }
    }
    // Parse time HH:MM:SS[.fff]
    const time_parts = time_part.split(":")
    const hour = to_int(time_parts[0])
    const minute = if len(time_parts) >= 2 { to_int(time_parts[1]) } else { 0 }
    let second = 0
    let millis = 0
    if len(time_parts) >= 3 {
        const sec_str = time_parts[2]
        const dot_pos = sec_str.indexOf(".")
        if dot_pos >= 0 {
            second = to_int(sec_str.slice(0, dot_pos))
            let frac = sec_str.slice(dot_pos + 1, len(sec_str))
            while len(frac) < 3 { frac = frac + "0" }
            millis = to_int(frac.slice(0, 3))
        } else {
            second = to_int(sec_str)
        }
    }
    const days = days_from_civil(y, m, d)
    const total_secs = days * 86400 + hour * 3600 + minute * 60 + second - tz_offset_secs
    total_secs * 1000 + millis
}

// Format a duration in milliseconds as a human-readable string.
func format_duration(ms) {
    let remaining = int(ms / 1000)
    const days = int(remaining / 86400)
    remaining = remaining % 86400
    const hours = int(remaining / 3600)
    remaining = remaining % 3600
    const minutes = int(remaining / 60)
    const seconds = remaining % 60
    let parts = []
    if days > 0 { parts.push(f"{days}d") }
    if hours > 0 { parts.push(f"{hours}h") }
    if minutes > 0 { parts.push(f"{minutes}m") }
    if seconds > 0 || len(parts) == 0 { parts.push(f"{seconds}s") }
    parts.join(" ")
}

// ════════════════════════════════════════════════════════════════════
// 11. Math Extras
// ════════════════════════════════════════════════════════════════════

// Greatest common divisor.
func gcd(a, b) {
    let x = abs(a)
    let y = abs(b)
    while y != 0 {
        const tmp = y
        y = x % y
        x = tmp
    }
    x
}

// Least common multiple.
func lcm(a, b) {
    if a == 0 || b == 0 { return 0 }
    abs(a) * abs(b) / gcd(a, b)
}

// Factorial.
func factorial(n) {
    if n < 0 { return 0 }
    if n <= 1 { return 1 }
    let result = 1
    let i = 2
    while i <= n {
        result = result * i
        i = i + 1
    }
    result
}

// Fibonacci number (iterative).
func fibonacci(n) {
    if n <= 0 { return 0 }
    if n == 1 { return 1 }
    let a = 0
    let b = 1
    let i = 2
    while i <= n {
        const tmp = a + b
        a = b
        b = tmp
        i = i + 1
    }
    b
}

// Check if a number is prime.
func is_prime(n) {
    if n < 2 { return false }
    if n < 4 { return true }
    if n % 2 == 0 || n % 3 == 0 { return false }
    let i = 5
    while i * i <= n {
        if n % i == 0 || n % (i + 2) == 0 { return false }
        i = i + 6
    }
    true
}

// Find the next prime >= n.
func next_prime(n) {
    let candidate = if n < 2 { 2 } else { n }
    while !is_prime(candidate) {
        candidate = candidate + 1
    }
    candidate
}

// ── Statistics ─────────────────────────────────────────────────────

// Arithmetic mean.
func math_mean(nums) {
    if len(nums) == 0 { return 0.0 }
    let sum = 0.0
    for n in nums { sum = sum + n }
    sum / len(nums)
}

// Median.
func math_median(nums) {
    if len(nums) == 0 { return 0.0 }
    let sorted = nums.slice(0, len(nums))
    sorted.sort()
    const mid = int(len(sorted) / 2)
    if len(sorted) % 2 == 0 {
        (sorted[mid - 1] + sorted[mid]) / 2.0
    } else {
        sorted[mid]
    }
}

// Mode (most frequent value). Returns the first mode if ties.
func math_mode(nums) {
    if len(nums) == 0 { return null }
    let counts = {}
    for n in nums {
        const key = to_string(n)
        if counts.has(key) {
            counts[key] = counts[key] + 1
        } else {
            counts[key] = 1
        }
    }
    let best_key = to_string(nums[0])
    let best_count = 0
    for key in keys(counts) {
        if counts[key] > best_count {
            best_count = counts[key]
            best_key = key
        }
    }
    to_float(best_key)
}

// Variance (population).
func math_variance(nums) {
    if len(nums) == 0 { return 0.0 }
    const avg = math_mean(nums)
    let sum_sq = 0.0
    for n in nums {
        const diff = n - avg
        sum_sq = sum_sq + diff * diff
    }
    sum_sq / len(nums)
}

// Standard deviation (population).
func math_stddev(nums) {
    sqrt(math_variance(nums))
}

// ════════════════════════════════════════════════════════════════════
// 12. Collections
// ════════════════════════════════════════════════════════════════════

// ── Set Operations ─────────────────────────────────────────────────

// Set union of two arrays.
func set_union(a, b) {
    let result = []
    let seen = {}
    for item in a {
        const key = to_string(item)
        if !seen.has(key) {
            seen[key] = true
            result.push(item)
        }
    }
    for item in b {
        const key = to_string(item)
        if !seen.has(key) {
            seen[key] = true
            result.push(item)
        }
    }
    result
}

// Set intersection of two arrays.
func set_intersection(a, b) {
    let b_set = {}
    for item in b {
        b_set[to_string(item)] = true
    }
    let result = []
    let seen = {}
    for item in a {
        const key = to_string(item)
        if b_set.has(key) && !seen.has(key) {
            seen[key] = true
            result.push(item)
        }
    }
    result
}

// Set difference (a - b).
func set_difference(a, b) {
    let b_set = {}
    for item in b {
        b_set[to_string(item)] = true
    }
    let result = []
    for item in a {
        const key = to_string(item)
        if !b_set.has(key) {
            result.push(item)
        }
    }
    result
}

// Set symmetric difference.
func set_symmetric_difference(a, b) {
    set_union(set_difference(a, b), set_difference(b, a))
}

// ── Counter (frequency counting) ──────────────────────────────────

// Count occurrences of each element.
func counter(items) {
    let counts = {}
    for item in items {
        const key = to_string(item)
        if counts.has(key) {
            counts[key] = counts[key] + 1
        } else {
            counts[key] = 1
        }
    }
    counts
}

// Get the N most common elements from a counter.
func counter_most_common(counts, n) {
    let entries = []
    for key in keys(counts) {
        entries.push([key, counts[key]])
    }
    // Sort by count descending
    let i = 0
    while i < len(entries) - 1 {
        let j = i + 1
        while j < len(entries) {
            if entries[j][1] > entries[i][1] {
                const tmp = entries[i]
                entries[i] = entries[j]
                entries[j] = tmp
            }
            j = j + 1
        }
        i = i + 1
    }
    if n >= len(entries) { return entries }
    entries.slice(0, n)
}

// ── Binary Heap (min-heap) ────────────────────────────────────────

func heap_new() { [] }

func heap_push(heap, val) {
    heap.push(val)
    // Sift up
    let idx = len(heap) - 1
    while idx > 0 {
        const parent = int((idx - 1) / 2)
        if heap[idx] < heap[parent] {
            const tmp = heap[idx]
            heap[idx] = heap[parent]
            heap[parent] = tmp
            idx = parent
        } else {
            break
        }
    }
}

func heap_pop(heap) {
    if len(heap) == 0 { return null }
    const min_val = heap[0]
    const last = heap.pop()
    if len(heap) > 0 {
        heap[0] = last
        // Sift down
        let idx = 0
        while true {
            const left = 2 * idx + 1
            const right = 2 * idx + 2
            let smallest = idx
            if left < len(heap) && heap[left] < heap[smallest] { smallest = left }
            if right < len(heap) && heap[right] < heap[smallest] { smallest = right }
            if smallest == idx { break }
            const tmp = heap[idx]
            heap[idx] = heap[smallest]
            heap[smallest] = tmp
            idx = smallest
        }
    }
    min_val
}

func heap_peek(heap) {
    if len(heap) == 0 { null } else { heap[0] }
}

func heap_size(heap) { len(heap) }

// ── Deque (double-ended queue) ────────────────────────────────────

func deque_new() { {"items": []} }

func deque_push_back(dq, val) {
    dq["items"].push(val)
}

func deque_push_front(dq, val) {
    dq["items"].unshift(val)
}

func deque_pop_back(dq) {
    if len(dq["items"]) == 0 { return null }
    dq["items"].pop()
}

func deque_pop_front(dq) {
    if len(dq["items"]) == 0 { return null }
    dq["items"].shift()
}

func deque_front(dq) {
    if len(dq["items"]) == 0 { null } else { dq["items"][0] }
}

func deque_back(dq) {
    const items = dq["items"]
    if len(items) == 0 { null } else { items[len(items) - 1] }
}

func deque_size(dq) { len(dq["items"]) }

func deque_is_empty(dq) { len(dq["items"]) == 0 }

// ── OrderedMap (insertion-order preserving) ────────────────────────

// An OrderedMap is represented as {"__keys": [...], "__values": [...]}
func ordered_map_new() { {"__keys": [], "__values": []} }

func ordered_map_set(om, key, value) {
    const ks = om["__keys"]
    let i = 0
    while i < len(ks) {
        if ks[i] == key {
            om["__values"][i] = value
            return
        }
        i = i + 1
    }
    ks.push(key)
    om["__values"].push(value)
}

func ordered_map_get(om, key) {
    const ks = om["__keys"]
    let i = 0
    while i < len(ks) {
        if ks[i] == key { return om["__values"][i] }
        i = i + 1
    }
    null
}

func ordered_map_has(om, key) {
    const ks = om["__keys"]
    let i = 0
    while i < len(ks) {
        if ks[i] == key { return true }
        i = i + 1
    }
    false
}

func ordered_map_remove(om, key) {
    const ks = om["__keys"]
    let i = 0
    while i < len(ks) {
        if ks[i] == key {
            ks.remove(i)
            om["__values"].remove(i)
            return true
        }
        i = i + 1
    }
    false
}

func ordered_map_keys(om) { om["__keys"].slice(0, len(om["__keys"])) }

func ordered_map_values(om) { om["__values"].slice(0, len(om["__values"])) }

func ordered_map_size(om) { len(om["__keys"]) }

func ordered_map_entries(om) {
    let result = []
    let i = 0
    while i < len(om["__keys"]) {
        result.push([om["__keys"][i], om["__values"][i]])
        i = i + 1
    }
    result
}

// Iterate over ordered map calling fn(key, value) for each entry.
func ordered_map_each(om, fn) {
    let i = 0
    while i < len(om["__keys"]) {
        fn(om["__keys"][i], om["__values"][i])
        i = i + 1
    }
}

// Map over ordered map values, returning a new ordered map.
func ordered_map_map_values(om, fn) {
    let result = ordered_map_new()
    let i = 0
    while i < len(om["__keys"]) {
        ordered_map_set(result, om["__keys"][i], fn(om["__values"][i]))
        i = i + 1
    }
    result
}

// Filter ordered map entries, returning a new ordered map.
func ordered_map_filter(om, pred) {
    let result = ordered_map_new()
    let i = 0
    while i < len(om["__keys"]) {
        if pred(om["__keys"][i], om["__values"][i]) {
            ordered_map_set(result, om["__keys"][i], om["__values"][i])
        }
        i = i + 1
    }
    result
}

// Merge two ordered maps. Values from b overwrite a.
func ordered_map_merge(a, b) {
    let result = ordered_map_new()
    let i = 0
    while i < len(a["__keys"]) {
        ordered_map_set(result, a["__keys"][i], a["__values"][i])
        i = i + 1
    }
    i = 0
    while i < len(b["__keys"]) {
        ordered_map_set(result, b["__keys"][i], b["__values"][i])
        i = i + 1
    }
    result
}

// ── Stack ──────────────────────────────────────────────────────────

func stack_new() { {"items": []} }
func stack_push(st, val) { st["items"].push(val) }
func stack_pop(st) {
    if len(st["items"]) == 0 { return null }
    st["items"].pop()
}
func stack_peek(st) {
    const items = st["items"]
    if len(items) == 0 { null } else { items[len(items) - 1] }
}
func stack_size(st) { len(st["items"]) }
func stack_is_empty(st) { len(st["items"]) == 0 }

// ── Ring Buffer ────────────────────────────────────────────────────

func ring_buffer_new(capacity) {
    let buf = []
    let i = 0
    while i < capacity { buf.push(null); i = i + 1 }
    {"buf": buf, "head": 0, "tail": 0, "size": 0, "capacity": capacity}
}

func ring_buffer_push(rb, val) {
    rb["buf"][rb["tail"]] = val
    rb["tail"] = (rb["tail"] + 1) % rb["capacity"]
    if rb["size"] < rb["capacity"] {
        rb["size"] = rb["size"] + 1
    } else {
        rb["head"] = (rb["head"] + 1) % rb["capacity"]
    }
}

func ring_buffer_pop(rb) {
    if rb["size"] == 0 { return null }
    const val = rb["buf"][rb["head"]]
    rb["head"] = (rb["head"] + 1) % rb["capacity"]
    rb["size"] = rb["size"] - 1
    val
}

func ring_buffer_peek(rb) {
    if rb["size"] == 0 { null } else { rb["buf"][rb["head"]] }
}

func ring_buffer_size(rb) { rb["size"] }

func ring_buffer_to_array(rb) {
    let result = []
    let i = 0
    while i < rb["size"] {
        result.push(rb["buf"][(rb["head"] + i) % rb["capacity"]])
        i = i + 1
    }
    result
}

// ════════════════════════════════════════════════════════════════════
// 13. CRC32 Checksum
// ════════════════════════════════════════════════════════════════════

// Precomputed CRC32 table (IEEE polynomial 0xEDB88320).
// Since MAGI doesn't have const arrays computed at compile time,
// we build the table on first use.
let _crc32_table = null

func crc32_build_table() {
    if _crc32_table != null { return _crc32_table }
    let table = []
    let i = 0
    while i < 256 {
        let crc = i
        let j = 0
        while j < 8 {
            if crc % 2 != 0 {
                // crc = (crc >> 1) ^ 0xEDB88320
                crc = int(crc / 2)
                // XOR with polynomial — need bitwise XOR via integer math
                crc = bit_xor(crc, 3988292384)  // 0xEDB88320
            } else {
                crc = int(crc / 2)
            }
            j = j + 1
        }
        table.push(crc)
        i = i + 1
    }
    _crc32_table = table
    table
}

// Compute CRC32 checksum of a string (IEEE polynomial).
func crc32(data) {
    const table = crc32_build_table()
    let crc = 4294967295  // 0xFFFFFFFF
    let i = 0
    while i < len(data) {
        const byte_val = char_code_at(data, i)
        const idx = bit_xor(crc, byte_val) % 256
        crc = bit_xor(int(crc / 256), table[idx])
        i = i + 1
    }
    bit_xor(crc, 4294967295)  // ^ 0xFFFFFFFF
}

// ════════════════════════════════════════════════════════════════════
// 14. Semver (Semantic Versioning)
// ════════════════════════════════════════════════════════════════════

// Parse a semver string "major.minor.patch[-pre]" into a map.
func semver_parse(s) {
    const trimmed = s.trim()
    if len(trimmed) == 0 { return {"error": "empty version string"} }
    // Split off build metadata (+...)
    let ver_str = trimmed
    const plus_pos = ver_str.indexOf("+")
    if plus_pos >= 0 {
        ver_str = ver_str.slice(0, plus_pos)
    }
    // Split off pre-release (-...)
    let pre = ""
    const dash_pos = ver_str.indexOf("-")
    if dash_pos >= 0 {
        pre = ver_str.slice(dash_pos + 1, len(ver_str))
        ver_str = ver_str.slice(0, dash_pos)
    }
    const parts = ver_str.split(".")
    if len(parts) != 3 {
        return {"error": f"expected 3 version components, got {len(parts)}"}
    }
    const major = to_int(parts[0])
    const minor = to_int(parts[1])
    const patch = to_int(parts[2])
    {"major": major, "minor": minor, "patch": patch, "pre": pre}
}

// Format a semver map back to string.
func semver_to_string(v) {
    let result = f"{v['major']}.{v['minor']}.{v['patch']}"
    if len(v["pre"]) > 0 {
        result = result + "-" + v["pre"]
    }
    result
}

// Compare two semver maps. Returns -1, 0, or 1.
func semver_compare(a, b) {
    if a["major"] != b["major"] { return if a["major"] < b["major"] { -1 } else { 1 } }
    if a["minor"] != b["minor"] { return if a["minor"] < b["minor"] { -1 } else { 1 } }
    if a["patch"] != b["patch"] { return if a["patch"] < b["patch"] { -1 } else { 1 } }
    // Pre-release comparison
    const a_pre = a["pre"]
    const b_pre = b["pre"]
    if len(a_pre) == 0 && len(b_pre) == 0 { return 0 }
    if len(a_pre) == 0 { return 1 }   // release > pre-release
    if len(b_pre) == 0 { return -1 }  // pre-release < release
    if a_pre < b_pre { return -1 }
    if a_pre > b_pre { return 1 }
    0
}

// Check if version satisfies a constraint like ">=1.2.0", "<2.0.0".
func semver_satisfies(version, constraint) {
    const trimmed = constraint.trim()
    let op = ""
    let ver_str = trimmed
    if trimmed.starts_with(">=") { op = ">="; ver_str = trimmed.slice(2, len(trimmed)) }
    else if trimmed.starts_with("<=") { op = "<="; ver_str = trimmed.slice(2, len(trimmed)) }
    else if trimmed.starts_with(">") { op = ">"; ver_str = trimmed.slice(1, len(trimmed)) }
    else if trimmed.starts_with("<") { op = "<"; ver_str = trimmed.slice(1, len(trimmed)) }
    else if trimmed.starts_with("=") { op = "="; ver_str = trimmed.slice(1, len(trimmed)) }
    else { op = "=" }
    const target = semver_parse(ver_str.trim())
    if target.has("error") { return false }
    const cmp = semver_compare(version, target)
    if op == ">=" { return cmp >= 0 }
    if op == "<=" { return cmp <= 0 }
    if op == ">" { return cmp > 0 }
    if op == "<" { return cmp < 0 }
    cmp == 0
}

// ════════════════════════════════════════════════════════════════════
// 15. CSV Parser/Writer
// ════════════════════════════════════════════════════════════════════

// Parse a CSV string into {headers: [...], records: [[...], ...]}.
func csv_parse(text) {
    const lines = text.split("\n")
    if len(lines) == 0 { return {"headers": [], "records": []} }
    // Filter empty trailing lines
    let non_empty = []
    for line in lines {
        if len(line.trim()) > 0 { non_empty.push(line) }
    }
    if len(non_empty) == 0 { return {"headers": [], "records": []} }
    const headers = csv_parse_line(non_empty[0])
    let records = []
    let i = 1
    while i < len(non_empty) {
        records.push(csv_parse_line(non_empty[i]))
        i = i + 1
    }
    {"headers": headers, "records": records}
}

// Parse a single CSV line into fields, handling quoted fields.
func csv_parse_line(line) {
    let fields = []
    let current = ""
    let in_quote = false
    let i = 0
    while i < len(line) {
        const c = line[i]
        if in_quote {
            if c == "\"" {
                if i + 1 < len(line) && line[i + 1] == "\"" {
                    current = current + "\""
                    i = i + 2
                } else {
                    in_quote = false
                    i = i + 1
                }
            } else {
                current = current + c
                i = i + 1
            }
        } else if c == "\"" {
            in_quote = true
            i = i + 1
        } else if c == "," {
            fields.push(current)
            current = ""
            i = i + 1
        } else {
            current = current + c
            i = i + 1
        }
    }
    fields.push(current)
    fields
}

// Write a CSV string from headers and rows.
func csv_write(headers, rows) {
    let result = csv_format_line(headers) + "\n"
    for row in rows {
        result = result + csv_format_line(row) + "\n"
    }
    result
}

// Format a single CSV line, quoting fields that contain commas or quotes.
func csv_format_line(fields) {
    let parts = []
    for field in fields {
        if field.contains(",") || field.contains("\"") || field.contains("\n") {
            parts.push("\"" + field.replace("\"", "\"\"") + "\"")
        } else {
            parts.push(field)
        }
    }
    parts.join(",")
}

// ════════════════════════════════════════════════════════════════════
// 16. Glob Pattern Matching
// ════════════════════════════════════════════════════════════════════

// Match a filename against a glob pattern (* and ?).
func glob_match(pattern, text) {
    glob_match_inner(pattern, text, 0, 0)
}

func glob_match_inner(pattern, text, pi, ti) {
    if pi == len(pattern) { return ti == len(text) }
    if pattern[pi] == "*" {
        // Try matching zero or more characters
        let k = ti
        while k <= len(text) {
            if glob_match_inner(pattern, text, pi + 1, k) { return true }
            k = k + 1
        }
        return false
    }
    if ti >= len(text) { return false }
    if pattern[pi] == "?" || pattern[pi] == text[ti] {
        return glob_match_inner(pattern, text, pi + 1, ti + 1)
    }
    false
}

// Match a path against a glob pattern with ** support.
func glob_match_path(pattern, path) {
    const pat_parts = pattern.split("/")
    const path_parts = path.split("/")
    glob_match_path_inner(pat_parts, path_parts, 0, 0)
}

func glob_match_path_inner(pat_parts, path_parts, pi, ti) {
    if pi == len(pat_parts) { return ti == len(path_parts) }
    if pat_parts[pi] == "**" {
        // Match zero or more path components
        let k = ti
        while k <= len(path_parts) {
            if glob_match_path_inner(pat_parts, path_parts, pi + 1, k) { return true }
            k = k + 1
        }
        return false
    }
    if ti >= len(path_parts) { return false }
    if glob_match(pat_parts[pi], path_parts[ti]) {
        return glob_match_path_inner(pat_parts, path_parts, pi + 1, ti + 1)
    }
    false
}

// ════════════════════════════════════════════════════════════════════
// 17. String Similarity and Search
// ════════════════════════════════════════════════════════════════════

// Normalized Levenshtein similarity (0.0 to 1.0).
func levenshtein_similarity(a, b) {
    const max_len = if len(a) > len(b) { len(a) } else { len(b) }
    if max_len == 0 { return 1.0 }
    1.0 - levenshtein(a, b) / max_len
}

// Find the best match for `query` among `candidates`.
// Returns the candidate with the lowest Levenshtein distance.
func fuzzy_match(query, candidates) {
    if len(candidates) == 0 { return null }
    let best = candidates[0]
    let best_dist = levenshtein(query, candidates[0])
    let i = 1
    while i < len(candidates) {
        const dist = levenshtein(query, candidates[i])
        if dist < best_dist {
            best_dist = dist
            best = candidates[i]
        }
        i = i + 1
    }
    best
}

// Suggest similar names when a name is not found.
func did_you_mean(name, candidates, max_distance) {
    let suggestions = []
    for candidate in candidates {
        const dist = levenshtein(name, candidate)
        if dist <= max_distance {
            suggestions.push(candidate)
        }
    }
    suggestions
}

// ════════════════════════════════════════════════════════════════════
// 18. TOML Parser (basic)
// ════════════════════════════════════════════════════════════════════

// Parse a TOML string into a nested map structure.
func toml_parse(input) {
    let root = {}
    let current_section = []
    const lines = input.split("\n")
    let line_no = 0
    while line_no < len(lines) {
        let line = lines[line_no].trim()
        line_no = line_no + 1
        // Skip empty and comments
        if len(line) == 0 || line[0] == "#" { continue }
        // Table header [section]
        if line[0] == "[" && line[len(line) - 1] == "]" {
            if line[1] == "[" && line[len(line) - 2] == "]" {
                // Array of tables [[section]]
                const section_name = line.slice(2, len(line) - 2).trim()
                current_section = section_name.split(".")
            } else {
                const section_name = line.slice(1, len(line) - 1).trim()
                current_section = section_name.split(".")
            }
            // Ensure section path exists in root
            toml_ensure_path(root, current_section)
            continue
        }
        // Key = value
        const eq_pos = line.indexOf("=")
        if eq_pos < 0 { continue }
        const key = line.slice(0, eq_pos).trim()
        // Strip surrounding quotes from key
        let clean_key = key
        if len(key) >= 2 && key[0] == "\"" && key[len(key) - 1] == "\"" {
            clean_key = key.slice(1, len(key) - 1)
        }
        const value_str = line.slice(eq_pos + 1, len(line)).trim()
        const value = toml_parse_value(value_str)
        // Insert into the right section
        if len(current_section) == 0 {
            root[clean_key] = value
        } else {
            let target = root
            for sec in current_section {
                if !target.has(sec) { target[sec] = {} }
                target = target[sec]
            }
            target[clean_key] = value
        }
    }
    root
}

func toml_ensure_path(root, path) {
    let current = root
    for key in path {
        if !current.has(key) { current[key] = {} }
        current = current[key]
    }
}

func toml_parse_value(s) {
    let trimmed = s.trim()
    // Strip trailing comment
    let in_string = false
    let escape = false
    let i = 0
    while i < len(trimmed) {
        const c = trimmed[i]
        if escape { escape = false; i = i + 1; continue }
        if c == "\\" && in_string { escape = true; i = i + 1; continue }
        if c == "\"" { in_string = !in_string; i = i + 1; continue }
        if c == "#" && !in_string {
            trimmed = trimmed.slice(0, i).trim()
            break
        }
        i = i + 1
    }
    if trimmed == "true" { return true }
    if trimmed == "false" { return false }
    // String
    if len(trimmed) >= 2 && trimmed[0] == "\"" && trimmed[len(trimmed) - 1] == "\"" {
        return toml_unescape(trimmed.slice(1, len(trimmed) - 1))
    }
    if len(trimmed) >= 2 && trimmed[0] == "'" && trimmed[len(trimmed) - 1] == "'" {
        return trimmed.slice(1, len(trimmed) - 1)
    }
    // Array
    if trimmed[0] == "[" && trimmed[len(trimmed) - 1] == "]" {
        const inner = trimmed.slice(1, len(trimmed) - 1).trim()
        if len(inner) == 0 { return [] }
        const items = toml_split_elements(inner)
        let result = []
        for item in items {
            const t = item.trim()
            if len(t) > 0 { result.push(toml_parse_value(t)) }
        }
        return result
    }
    // Inline table
    if trimmed[0] == "{" && trimmed[len(trimmed) - 1] == "}" {
        const inner = trimmed.slice(1, len(trimmed) - 1).trim()
        let table = {}
        if len(inner) == 0 { return table }
        const items = toml_split_elements(inner)
        for item in items {
            const t = item.trim()
            const eq = t.indexOf("=")
            if eq >= 0 {
                let k = t.slice(0, eq).trim()
                if len(k) >= 2 && k[0] == "\"" && k[len(k) - 1] == "\"" {
                    k = k.slice(1, len(k) - 1)
                }
                table[k] = toml_parse_value(t.slice(eq + 1, len(t)).trim())
            }
        }
        return table
    }
    // Number
    const as_int = to_int(trimmed)
    if to_string(as_int) == trimmed { return as_int }
    const as_float = to_float(trimmed)
    if to_string(as_float) != "NaN" { return as_float }
    // Bare string fallback
    trimmed
}

func toml_unescape(s) {
    let result = ""
    let i = 0
    while i < len(s) {
        if s[i] == "\\" && i + 1 < len(s) {
            const next = s[i + 1]
            if next == "n" { result = result + "\n"; i = i + 2 }
            else if next == "t" { result = result + "\t"; i = i + 2 }
            else if next == "r" { result = result + "\r"; i = i + 2 }
            else if next == "\\" { result = result + "\\"; i = i + 2 }
            else if next == "\"" { result = result + "\""; i = i + 2 }
            else { result = result + s[i]; i = i + 1 }
        } else {
            result = result + s[i]
            i = i + 1
        }
    }
    result
}

func toml_split_elements(s) {
    let results = []
    let depth_bracket = 0
    let depth_brace = 0
    let in_string = false
    let escape = false
    let start = 0
    let i = 0
    while i < len(s) {
        const c = s[i]
        if escape { escape = false; i = i + 1; continue }
        if c == "\\" && in_string { escape = true; i = i + 1; continue }
        if c == "\"" { in_string = !in_string; i = i + 1; continue }
        if !in_string {
            if c == "[" { depth_bracket = depth_bracket + 1 }
            else if c == "]" { depth_bracket = depth_bracket - 1 }
            else if c == "{" { depth_brace = depth_brace + 1 }
            else if c == "}" { depth_brace = depth_brace - 1 }
            else if c == "," && depth_bracket == 0 && depth_brace == 0 {
                results.push(s.slice(start, i))
                start = i + 1
            }
        }
        i = i + 1
    }
    if start < len(s) {
        results.push(s.slice(start, len(s)))
    }
    results
}

// Serialize a TOML table map to TOML string.
func toml_stringify(table) {
    let result = ""
    // First pass: simple key-value pairs
    for key in keys(table) {
        const val = table[key]
        if typeof(val) != "map" || typeof(val) == "array" {
            result = result + toml_key_escape(key) + " = " + toml_value_to_string(val) + "\n"
        }
    }
    // Second pass: sub-tables
    for key in keys(table) {
        const val = table[key]
        if typeof(val) == "map" && typeof(val) != "array" {
            result = result + "\n[" + key + "]\n"
            result = result + toml_stringify(val)
        }
    }
    result
}

func toml_key_escape(key) {
    let needs_quote = false
    let i = 0
    while i < len(key) {
        const c = key[i]
        if !is_alnum(c) && c != "-" && c != "_" {
            needs_quote = true
            break
        }
        i = i + 1
    }
    if needs_quote {
        "\"" + key.replace("\\", "\\\\").replace("\"", "\\\"") + "\""
    } else {
        key
    }
}

func toml_value_to_string(val) {
    if val == null { return "\"\"" }
    if val == true { return "true" }
    if val == false { return "false" }
    if typeof(val) == "int" { return to_string(val) }
    if typeof(val) == "float" { return to_string(val) }
    if typeof(val) == "string" {
        return "\"" + val.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n") + "\""
    }
    if typeof(val) == "array" {
        let parts = []
        for item in val {
            parts.push(toml_value_to_string(item))
        }
        return "[" + parts.join(", ") + "]"
    }
    to_string(val)
}

// ════════════════════════════════════════════════════════════════════
// 19. Adler32 Checksum
// ════════════════════════════════════════════════════════════════════

func adler32(data) {
    let a = 1
    let b = 0
    let i = 0
    while i < len(data) {
        a = (a + char_code_at(data, i)) % 65521
        b = (b + a) % 65521
        i = i + 1
    }
    b * 65536 + a
}

// ════════════════════════════════════════════════════════════════════
// 20. String Utilities (additional)
// ════════════════════════════════════════════════════════════════════

// Repeat a string n times.
func string_repeat(s, n) {
    let result = ""
    let i = 0
    while i < n {
        result = result + s
        i = i + 1
    }
    result
}

// Count occurrences of substring in string.
func string_count(s, sub) {
    if len(sub) == 0 { return 0 }
    let count = 0
    let pos = 0
    while pos <= len(s) - len(sub) {
        if s.slice(pos, pos + len(sub)) == sub {
            count = count + 1
            pos = pos + len(sub)
        } else {
            pos = pos + 1
        }
    }
    count
}

// Reverse a string.
func string_reverse(s) {
    let result = ""
    let i = len(s) - 1
    while i >= 0 {
        result = result + s[i]
        i = i - 1
    }
    result
}

// Check if a string is a palindrome.
func is_palindrome(s) {
    let i = 0
    let j = len(s) - 1
    while i < j {
        if s[i] != s[j] { return false }
        i = i + 1
        j = j - 1
    }
    true
}

// Capitalize the first character of a string.
func capitalize(s) {
    if len(s) == 0 { return "" }
    to_upper_char(s[0]) + s.slice(1, len(s))
}

// Uncapitalize the first character.
func uncapitalize(s) {
    if len(s) == 0 { return "" }
    to_lower_char(s[0]) + s.slice(1, len(s))
}

// Check if a string contains only whitespace.
func is_blank(s) {
    let i = 0
    while i < len(s) {
        if s[i] != " " && s[i] != "\t" && s[i] != "\n" && s[i] != "\r" { return false }
        i = i + 1
    }
    true
}

// Remove all whitespace from a string.
func strip_whitespace(s) {
    let result = ""
    let i = 0
    while i < len(s) {
        const c = s[i]
        if c != " " && c != "\t" && c != "\n" && c != "\r" {
            result = result + c
        }
        i = i + 1
    }
    result
}

// Squeeze consecutive occurrences of a character into one.
func squeeze(s, ch) {
    if len(s) == 0 { return "" }
    let result = s[0]
    let i = 1
    while i < len(s) {
        if !(s[i] == ch && s[i - 1] == ch) {
            result = result + s[i]
        }
        i = i + 1
    }
    result
}

// Split a string into chunks of the given size.
func chunk(s, size) {
    let result = []
    let i = 0
    while i < len(s) {
        const end = if i + size > len(s) { len(s) } else { i + size }
        result.push(s.slice(i, end))
        i = i + size
    }
    result
}

// ════════════════════════════════════════════════════════════════════
// 21. Number Formatting
// ════════════════════════════════════════════════════════════════════

// Format a number with thousands separators.
func format_number(n) {
    const s = to_string(int(n))
    let negative = false
    let digits = s
    if s[0] == "-" {
        negative = true
        digits = s.slice(1, len(s))
    }
    let result = ""
    let count = 0
    let i = len(digits) - 1
    while i >= 0 {
        if count > 0 && count % 3 == 0 {
            result = "," + result
        }
        result = digits[i] + result
        count = count + 1
        i = i - 1
    }
    if negative { "-" + result } else { result }
}

// Format bytes as human-readable size (KB, MB, GB, etc.).
func format_bytes(bytes) {
    const units = ["B", "KB", "MB", "GB", "TB", "PB"]
    let size = to_float(bytes)
    let unit_idx = 0
    while size >= 1024.0 && unit_idx < len(units) - 1 {
        size = size / 1024.0
        unit_idx = unit_idx + 1
    }
    if unit_idx == 0 {
        f"{int(size)} {units[unit_idx]}"
    } else {
        // Round to 1 decimal
        const rounded = int(size * 10.0) / 10.0
        f"{rounded} {units[unit_idx]}"
    }
}

// ════════════════════════════════════════════════════════════════════
// 22. Sorting and Search Algorithms
// ════════════════════════════════════════════════════════════════════

// Binary search on a sorted array. Returns index or -1.
func binary_search(arr, target) {
    let lo = 0
    let hi = len(arr) - 1
    while lo <= hi {
        const mid = int((lo + hi) / 2)
        if arr[mid] == target { return mid }
        if arr[mid] < target { lo = mid + 1 }
        else { hi = mid - 1 }
    }
    -1
}

// Merge sort (returns new sorted array).
func merge_sort(arr) {
    if len(arr) <= 1 { return arr }
    const mid = int(len(arr) / 2)
    const left = merge_sort(arr.slice(0, mid))
    const right = merge_sort(arr.slice(mid, len(arr)))
    merge_arrays(left, right)
}

func merge_arrays(left, right) {
    let result = []
    let i = 0
    let j = 0
    while i < len(left) && j < len(right) {
        if left[i] <= right[j] {
            result.push(left[i])
            i = i + 1
        } else {
            result.push(right[j])
            j = j + 1
        }
    }
    while i < len(left) { result.push(left[i]); i = i + 1 }
    while j < len(right) { result.push(right[j]); j = j + 1 }
    result
}

// Group array elements by a key function.
func group_by(arr, key_fn) {
    let groups = {}
    for item in arr {
        const key = key_fn(item)
        const k = to_string(key)
        if !groups.has(k) {
            groups[k] = []
        }
        groups[k].push(item)
    }
    groups
}

// Unique elements preserving order.
func unique(arr) {
    let seen = {}
    let result = []
    for item in arr {
        const k = to_string(item)
        if !seen.has(k) {
            seen[k] = true
            result.push(item)
        }
    }
    result
}

// Flatten a nested array by one level.
func flatten(arr) {
    let result = []
    for item in arr {
        if typeof(item) == "array" {
            for sub in item {
                result.push(sub)
            }
        } else {
            result.push(item)
        }
    }
    result
}

// Zip two arrays into an array of pairs.
func zip(a, b) {
    let result = []
    const min_len = if len(a) < len(b) { len(a) } else { len(b) }
    let i = 0
    while i < min_len {
        result.push([a[i], b[i]])
        i = i + 1
    }
    result
}

// Unzip an array of pairs into two arrays.
func unzip(pairs) {
    let a = []
    let b = []
    for pair in pairs {
        a.push(pair[0])
        b.push(pair[1])
    }
    [a, b]
}

// Range of integers [start, end).
func range(start, end) {
    let result = []
    let i = start
    while i < end {
        result.push(i)
        i = i + 1
    }
    result
}

// Range with step.
func range_step(start, end, step) {
    let result = []
    let i = start
    if step > 0 {
        while i < end {
            result.push(i)
            i = i + step
        }
    } else if step < 0 {
        while i > end {
            result.push(i)
            i = i + step
        }
    }
    result
}

// ════════════════════════════════════════════════════════════════════
// 23. Math Extras (additional)
// ════════════════════════════════════════════════════════════════════

// Clamp a number to [min, max].
func clamp(n, min_val, max_val) {
    if n < min_val { min_val }
    else if n > max_val { max_val }
    else { n }
}

// Linear interpolation between a and b.
func lerp(a, b, t) {
    a + (b - a) * t
}

// Map a value from one range to another.
func map_range(value, from_min, from_max, to_min, to_max) {
    const t = (value - from_min) / (from_max - from_min)
    to_min + t * (to_max - to_min)
}

// Sum of an array.
func math_sum(arr) {
    let total = 0
    for n in arr { total = total + n }
    total
}

// Product of an array.
func math_product(arr) {
    if len(arr) == 0 { return 0 }
    let total = 1
    for n in arr { total = total * n }
    total
}

// Min of an array.
func math_min(arr) {
    if len(arr) == 0 { return null }
    let result = arr[0]
    let i = 1
    while i < len(arr) {
        if arr[i] < result { result = arr[i] }
        i = i + 1
    }
    result
}

// Max of an array.
func math_max(arr) {
    if len(arr) == 0 { return null }
    let result = arr[0]
    let i = 1
    while i < len(arr) {
        if arr[i] > result { result = arr[i] }
        i = i + 1
    }
    result
}

// Power (integer exponentiation).
func int_pow(base, exp) {
    if exp < 0 { return 0 }
    let result = 1
    let i = 0
    while i < exp {
        result = result * base
        i = i + 1
    }
    result
}

// Absolute value.
func math_abs(n) {
    if n < 0 { -n } else { n }
}

// Sign of a number (-1, 0, or 1).
func math_sign(n) {
    if n > 0 { 1 }
    else if n < 0 { -1 }
    else { 0 }
}

// Integer division (floor division).
func div_floor(a, b) {
    const q = int(a / b)
    if (a % b != 0) && ((a < 0) != (b < 0)) { q - 1 } else { q }
}

// Modulo (always non-negative result).
func mod_floor(a, b) {
    const r = a % b
    if r < 0 { r + abs(b) } else { r }
}

// Combinations C(n, k).
func combinations(n, k) {
    if k < 0 || k > n { return 0 }
    if k == 0 || k == n { return 1 }
    let result = 1
    let i = 0
    while i < k {
        result = result * (n - i) / (i + 1)
        i = i + 1
    }
    result
}

// Permutations P(n, k).
func permutations(n, k) {
    if k < 0 || k > n { return 0 }
    let result = 1
    let i = 0
    while i < k {
        result = result * (n - i)
        i = i + 1
    }
    result
}

// ════════════════════════════════════════════════════════════════════
// 24. Color Utilities
// ════════════════════════════════════════════════════════════════════

// Parse a hex color string (#RRGGBB or #RGB) to [r, g, b].
func color_parse_hex(hex) {
    let s = hex
    if s[0] == "#" { s = s.slice(1, len(s)) }
    if len(s) == 3 {
        const r = hex_val(s[0]) * 17
        const g = hex_val(s[1]) * 17
        const b = hex_val(s[2]) * 17
        return [r, g, b]
    }
    if len(s) == 6 {
        const r = hex_val(s[0]) * 16 + hex_val(s[1])
        const g = hex_val(s[2]) * 16 + hex_val(s[3])
        const b = hex_val(s[4]) * 16 + hex_val(s[5])
        return [r, g, b]
    }
    [0, 0, 0]
}

// Convert [r, g, b] to hex string #RRGGBB.
func color_to_hex(rgb) {
    const r = rgb[0]
    const g = rgb[1]
    const b = rgb[2]
    "#" + HEX_LOWER[int(r / 16)] + HEX_LOWER[r % 16] + HEX_LOWER[int(g / 16)] + HEX_LOWER[g % 16] + HEX_LOWER[int(b / 16)] + HEX_LOWER[b % 16]
}

// Blend two colors with a ratio t (0.0 = color a, 1.0 = color b).
func color_blend(a, b, t) {
    const r = int(a[0] + (b[0] - a[0]) * t)
    const g = int(a[1] + (b[1] - a[1]) * t)
    const bl = int(a[2] + (b[2] - a[2]) * t)
    [clamp(r, 0, 255), clamp(g, 0, 255), clamp(bl, 0, 255)]
}

// Lighten a color by percentage (0-100).
func color_lighten(rgb, percent) {
    color_blend(rgb, [255, 255, 255], percent / 100.0)
}

// Darken a color by percentage (0-100).
func color_darken(rgb, percent) {
    color_blend(rgb, [0, 0, 0], percent / 100.0)
}

// Convert RGB to grayscale using luminance weights.
func color_grayscale(rgb) {
    const gray = int(0.299 * rgb[0] + 0.587 * rgb[1] + 0.114 * rgb[2])
    [gray, gray, gray]
}

// ════════════════════════════════════════════════════════════════════
// 25. Path Utilities
// ════════════════════════════════════════════════════════════════════

// Get the file extension from a path.
func path_extension(path) {
    const last_dot = path.lastIndexOf(".")
    const last_slash = path.lastIndexOf("/")
    if last_dot < 0 || last_dot < last_slash { return "" }
    path.slice(last_dot + 1, len(path))
}

// Get the filename from a path (last component).
func path_filename(path) {
    const last_slash = path.lastIndexOf("/")
    if last_slash < 0 { return path }
    path.slice(last_slash + 1, len(path))
}

// Get the directory part of a path.
func path_dirname(path) {
    const last_slash = path.lastIndexOf("/")
    if last_slash < 0 { return "." }
    if last_slash == 0 { return "/" }
    path.slice(0, last_slash)
}

// Get the stem (filename without extension).
func path_stem(path) {
    const name = path_filename(path)
    const dot = name.lastIndexOf(".")
    if dot <= 0 { return name }
    name.slice(0, dot)
}

// Join two path components.
func path_join(a, b) {
    if len(a) == 0 { return b }
    if len(b) == 0 { return a }
    if b[0] == "/" { return b }
    if a[len(a) - 1] == "/" { a + b }
    else { a + "/" + b }
}

// Normalize a path (resolve . and .. components).
func path_normalize(path) {
    const parts = path.split("/")
    let result = []
    for part in parts {
        if part == "." || part == "" { continue }
        if part == ".." {
            if len(result) > 0 && result[len(result) - 1] != ".." {
                result.pop()
            } else {
                result.push(part)
            }
        } else {
            result.push(part)
        }
    }
    let normalized = result.join("/")
    if len(path) > 0 && path[0] == "/" { normalized = "/" + normalized }
    if len(normalized) == 0 { normalized = "." }
    normalized
}

// Check if a path is absolute.
func path_is_absolute(path) {
    len(path) > 0 && path[0] == "/"
}

// ════════════════════════════════════════════════════════════════════
// 26. Template Engine (simple)
// ════════════════════════════════════════════════════════════════════

// Simple template substitution: replace {{key}} with values from a map.
func template_render(template, vars) {
    let result = template
    for key in keys(vars) {
        const placeholder = "{{" + key + "}}"
        result = result.replace(placeholder, to_string(vars[key]))
    }
    result
}

// Render a template with conditional blocks: {{#if key}}...{{/if}}.
func template_render_full(template, vars) {
    let result = template_render(template, vars)
    // Process {{#if key}}...{{/if}} blocks
    while result.contains("{{#if ") {
        const if_start = result.indexOf("{{#if ")
        if if_start < 0 { break }
        const key_start = if_start + 6
        const key_end = result.indexOf("}}", key_start)
        if key_end < 0 { break }
        const key = result.slice(key_start, key_end)
        const block_start = key_end + 2
        const end_tag = "{{/if}}"
        const block_end = result.indexOf(end_tag, block_start)
        if block_end < 0 { break }
        const block_content = result.slice(block_start, block_end)
        const after = result.slice(block_end + len(end_tag), len(result))
        let replacement = ""
        if vars.has(key) && vars[key] {
            replacement = block_content
        }
        result = result.slice(0, if_start) + replacement + after
    }
    result
}

// ════════════════════════════════════════════════════════════════════
// 27. Diff Algorithm (simplified)
// ════════════════════════════════════════════════════════════════════

// Compute a simple line diff between two texts.
// Returns an array of {op: "+"/"-"/"=", line: "..."} entries.
func diff_lines(old_text, new_text) {
    const old_lines = old_text.split("\n")
    const new_lines = new_text.split("\n")
    // Simple LCS-based diff using DP
    const m = len(old_lines)
    const n = len(new_lines)
    // Build LCS length table
    let dp = []
    let i = 0
    while i <= m {
        let row = []
        let j = 0
        while j <= n { row.push(0); j = j + 1 }
        dp.push(row)
        i = i + 1
    }
    i = 1
    while i <= m {
        let j = 1
        while j <= n {
            if old_lines[i - 1] == new_lines[j - 1] {
                dp[i][j] = dp[i - 1][j - 1] + 1
            } else {
                dp[i][j] = if dp[i - 1][j] > dp[i][j - 1] { dp[i - 1][j] } else { dp[i][j - 1] }
            }
            j = j + 1
        }
        i = i + 1
    }
    // Backtrack to build diff
    let result = []
    i = m
    let j = n
    while i > 0 || j > 0 {
        if i > 0 && j > 0 && old_lines[i - 1] == new_lines[j - 1] {
            result.push({"op": "=", "line": old_lines[i - 1]})
            i = i - 1
            j = j - 1
        } else if j > 0 && (i == 0 || dp[i][j - 1] >= dp[i - 1][j]) {
            result.push({"op": "+", "line": new_lines[j - 1]})
            j = j - 1
        } else {
            result.push({"op": "-", "line": old_lines[i - 1]})
            i = i - 1
        }
    }
    // Reverse to get correct order
    let reversed = []
    i = len(result) - 1
    while i >= 0 {
        reversed.push(result[i])
        i = i - 1
    }
    reversed
}

// Format a diff as a unified diff string.
func diff_format(diff_entries) {
    let result = ""
    for entry in diff_entries {
        if entry["op"] == "+" {
            result = result + "+ " + entry["line"] + "\n"
        } else if entry["op"] == "-" {
            result = result + "- " + entry["line"] + "\n"
        } else {
            result = result + "  " + entry["line"] + "\n"
        }
    }
    result
}

// ════════════════════════════════════════════════════════════════════
// 28. Event Emitter Pattern
// ════════════════════════════════════════════════════════════════════

// Create a new event emitter.
func emitter_new() { {"listeners": {}} }

// Register a listener for an event.
func emitter_on(emitter, event, handler) {
    if !emitter["listeners"].has(event) {
        emitter["listeners"][event] = []
    }
    emitter["listeners"][event].push(handler)
}

// Emit an event, calling all registered listeners.
func emitter_emit(emitter, event, data) {
    if emitter["listeners"].has(event) {
        const handlers = emitter["listeners"][event]
        for handler in handlers {
            handler(data)
        }
    }
}

// Remove all listeners for an event.
func emitter_off(emitter, event) {
    if emitter["listeners"].has(event) {
        emitter["listeners"][event] = []
    }
}

// Count listeners for an event.
func emitter_listener_count(emitter, event) {
    if emitter["listeners"].has(event) {
        len(emitter["listeners"][event])
    } else {
        0
    }
}

// ════════════════════════════════════════════════════════════════════
// 29. Result Type Pattern
// ════════════════════════════════════════════════════════════════════

// Create an Ok result.
func result_ok(value) { {"__result": "ok", "value": value} }

// Create an Err result.
func result_err(error) { {"__result": "err", "error": error} }

// Check if a result is Ok.
func result_is_ok(r) { typeof(r) == "map" && r.has("__result") && r["__result"] == "ok" }

// Check if a result is Err.
func result_is_err(r) { typeof(r) == "map" && r.has("__result") && r["__result"] == "err" }

// Unwrap an Ok value, or panic on Err.
func result_unwrap(r) {
    if result_is_ok(r) { return r["value"] }
    panic(f"unwrap on Err: {r['error']}")
}

// Unwrap an Ok value, or return default on Err.
func result_unwrap_or(r, default_val) {
    if result_is_ok(r) { r["value"] } else { default_val }
}

// Map over an Ok value.
func result_map(r, fn) {
    if result_is_ok(r) { result_ok(fn(r["value"])) } else { r }
}

// Chain results.
func result_and_then(r, fn) {
    if result_is_ok(r) { fn(r["value"]) } else { r }
}

// ════════════════════════════════════════════════════════════════════
// 30. Option Type Pattern
// ════════════════════════════════════════════════════════════════════

// Create a Some option.
func option_some(value) { {"__option": "some", "value": value} }

// Create a None option.
func option_none() { {"__option": "none"} }

// Check if an option is Some.
func option_is_some(o) { typeof(o) == "map" && o.has("__option") && o["__option"] == "some" }

// Check if an option is None.
func option_is_none(o) { typeof(o) == "map" && o.has("__option") && o["__option"] == "none" }

// Unwrap a Some value, or panic on None.
func option_unwrap(o) {
    if option_is_some(o) { return o["value"] }
    panic("unwrap on None")
}

// Unwrap a Some value, or return default on None.
func option_unwrap_or(o, default_val) {
    if option_is_some(o) { o["value"] } else { default_val }
}

// Map over a Some value.
func option_map(o, fn) {
    if option_is_some(o) { option_some(fn(o["value"])) } else { o }
}

// Filter an option: returns None if predicate fails.
func option_filter(o, pred) {
    if option_is_some(o) && pred(o["value"]) { o } else { option_none() }
}

// ════════════════════════════════════════════════════════════════════
// 31. YAML Emitter
// ════════════════════════════════════════════════════════════════════

// Emit a YAML value to string.
func yaml_emit(val) {
    let out = ""
    yaml_emit_value(val, out, 0, true)
}

func yaml_emit_value(val, out, indent, inline) {
    const prefix = " ".repeat(indent)
    if val == null { return out + "null" }
    const t = typeof(val)
    if t == "bool" { return out + if val { "true" } else { "false" } }
    if t == "int" { return out + to_string(val) }
    if t == "float" {
        const s = to_string(val)
        if !s.contains(".") { return out + s + ".0" }
        return out + s
    }
    if t == "string" {
        if yaml_string_needs_quoting(val) {
            return out + "\"" + yaml_escape_string(val) + "\""
        }
        return out + val
    }
    if t == "array" {
        if len(val) == 0 { return out + "[]" }
        let i = 0
        for item in val {
            if i > 0 || !inline { out = out + "\n" + prefix }
            out = out + "- "
            out = yaml_emit_value(item, out, indent + 2, true)
            i = i + 1
        }
        return out
    }
    if t == "map" {
        const keys = val.keys()
        if len(keys) == 0 { return out + "{}" }
        let i = 0
        for k in keys {
            if i > 0 || !inline { out = out + "\n" + prefix }
            out = out + to_string(k) + ": "
            const v = val[k]
            const vt = typeof(v)
            if (vt == "map" && len(v.keys()) > 0) || (vt == "array" && len(v) > 0) {
                out = yaml_emit_value(v, out, indent + 2, false)
            } else {
                out = yaml_emit_value(v, out, indent + 2, true)
            }
            i = i + 1
        }
        return out
    }
    out + to_string(val)
}

func yaml_string_needs_quoting(s) {
    if len(s) == 0 { return true }
    const lower = s.to_lower()
    if lower == "null" || lower == "true" || lower == "false" || lower == "yes" || lower == "no" { return true }
    if lower == "on" || lower == "off" || lower == "~" || lower == ".inf" || lower == "-.inf" || lower == ".nan" { return true }
    if s.contains(":") || s.contains("#") || s.contains("\n") || s.contains("\"") { return true }
    if s.contains("{") || s.contains("}") || s.contains("[") || s.contains("]") { return true }
    if s.contains(",") || s.contains("&") || s.contains("*") || s.contains("!") { return true }
    if s.contains("|") || s.contains(">") || s.contains("%") || s.contains("@") { return true }
    if s.starts_with(" ") || s.ends_with(" ") || s.starts_with("-") || s.starts_with("?") { return true }
    false
}

func yaml_escape_string(s) {
    let result = ""
    let i = 0
    while i < len(s) {
        const c = s[i]
        if c == "\"" { result = result + "\\\"" }
        else if c == "\\" { result = result + "\\\\" }
        else if c == "\n" { result = result + "\\n" }
        else if c == "\t" { result = result + "\\t" }
        else if c == "\r" { result = result + "\\r" }
        else { result = result + c }
        i = i + 1
    }
    result
}

// ════════════════════════════════════════════════════════════════════
// 32. XML Parser and Emitter
// ════════════════════════════════════════════════════════════════════

// XML node: {"tag": name, "attrs": {}, "children": [], "text": ""}
func xml_parse(source) {
    let pos = 0
    let nodes = []

    func skip_ws() {
        while pos < len(source) && (source[pos] == " " || source[pos] == "\n" || source[pos] == "\t" || source[pos] == "\r") {
            pos = pos + 1
        }
    }

    func parse_text() {
        let text = ""
        while pos < len(source) && source[pos] != "<" {
            if source[pos] == "&" {
                const end = source.index_of(";", pos)
                if end > pos {
                    const entity = source.substring(pos + 1, end)
                    if entity == "amp" { text = text + "&" }
                    else if entity == "lt" { text = text + "<" }
                    else if entity == "gt" { text = text + ">" }
                    else if entity == "quot" { text = text + "\"" }
                    else if entity == "apos" { text = text + "'" }
                    else { text = text + "&" + entity + ";" }
                    pos = end + 1
                } else {
                    text = text + source[pos]
                    pos = pos + 1
                }
            } else {
                text = text + source[pos]
                pos = pos + 1
            }
        }
        text
    }

    func parse_attr_value() {
        const quote = source[pos]
        pos = pos + 1
        let value = ""
        while pos < len(source) && source[pos] != quote {
            value = value + source[pos]
            pos = pos + 1
        }
        if pos < len(source) { pos = pos + 1 }
        value
    }

    func parse_tag_open() {
        pos = pos + 1 // skip <
        let tag = ""
        while pos < len(source) && source[pos] != " " && source[pos] != ">" && source[pos] != "/" {
            tag = tag + source[pos]
            pos = pos + 1
        }
        let attrs = {}
        skip_ws()
        while pos < len(source) && source[pos] != ">" && source[pos] != "/" {
            let attr_name = ""
            while pos < len(source) && source[pos] != "=" && source[pos] != " " && source[pos] != ">" {
                attr_name = attr_name + source[pos]
                pos = pos + 1
            }
            if pos < len(source) && source[pos] == "=" {
                pos = pos + 1
                if pos < len(source) && (source[pos] == "\"" || source[pos] == "'") {
                    attrs[attr_name] = parse_attr_value()
                }
            }
            skip_ws()
        }
        let self_closing = false
        if pos < len(source) && source[pos] == "/" {
            self_closing = true
            pos = pos + 1
        }
        if pos < len(source) && source[pos] == ">" { pos = pos + 1 }
        {"tag": tag, "attrs": attrs, "self_closing": self_closing}
    }

    func parse_node() {
        skip_ws()
        if pos >= len(source) { return null }
        if source[pos] == "<" {
            // Check for comment
            if pos + 3 < len(source) && source[pos + 1] == "!" && source[pos + 2] == "-" && source[pos + 3] == "-" {
                const end = source.index_of("-->", pos)
                if end >= 0 { pos = end + 3 } else { pos = len(source) }
                return parse_node()
            }
            // Check for processing instruction <?xml ... ?>
            if pos + 1 < len(source) && source[pos + 1] == "?" {
                const end = source.index_of("?>", pos)
                if end >= 0 { pos = end + 2 } else { pos = len(source) }
                return parse_node()
            }
            // Check for closing tag
            if pos + 1 < len(source) && source[pos + 1] == "/" {
                return null
            }
            const info = parse_tag_open()
            let children = []
            let text = ""
            if !info.self_closing {
                // Parse children until closing tag
                while pos < len(source) {
                    skip_ws()
                    if pos >= len(source) { break }
                    if source[pos] == "<" && pos + 1 < len(source) && source[pos + 1] == "/" {
                        // Skip closing tag
                        const end = source.index_of(">", pos)
                        if end >= 0 { pos = end + 1 }
                        break
                    }
                    if source[pos] == "<" {
                        const child = parse_node()
                        if child != null { children.push(child) }
                    } else {
                        text = text + parse_text()
                    }
                }
            }
            return {"tag": info.tag, "attrs": info.attrs, "children": children, "text": text}
        }
        null
    }

    skip_ws()
    const root = parse_node()
    if root != null { root } else { {"tag": "", "attrs": {}, "children": [], "text": ""} }
}

// Emit an XML node to string.
func xml_emit(node) {
    xml_emit_node(node, 0)
}

func xml_emit_node(node, depth) {
    const indent = "  ".repeat(depth)
    let result = indent + "<" + node.tag
    if node.has("attrs") {
        for k in node.attrs.keys() {
            result = result + " " + k + "=\"" + xml_escape_attr(node.attrs[k]) + "\""
        }
    }
    if (!node.has("children") || len(node.children) == 0) && (!node.has("text") || len(node.text) == 0) {
        return result + " />\n"
    }
    result = result + ">"
    if node.has("text") && len(node.text) > 0 {
        result = result + xml_escape_text(node.text)
    }
    if node.has("children") && len(node.children) > 0 {
        result = result + "\n"
        for child in node.children {
            result = result + xml_emit_node(child, depth + 1)
        }
        result = result + indent
    }
    result + "</" + node.tag + ">\n"
}

func xml_escape_text(s) {
    s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
}

func xml_escape_attr(s) {
    xml_escape_text(s).replace("\"", "&quot;")
}

// ════════════════════════════════════════════════════════════════════
// 33. TOML Parser Improvements
// ════════════════════════════════════════════════════════════════════

// Parse inline tables: { key = val, key2 = val2 }
func toml_parse_inline_table(s, pos) {
    let table = {}
    pos = pos + 1 // skip {
    while pos < len(s) && s[pos] != "}" {
        // Skip whitespace
        while pos < len(s) && (s[pos] == " " || s[pos] == "\t") { pos = pos + 1 }
        if pos >= len(s) || s[pos] == "}" { break }
        // Parse key
        let key = ""
        while pos < len(s) && s[pos] != "=" && s[pos] != " " {
            key = key + s[pos]
            pos = pos + 1
        }
        // Skip to =
        while pos < len(s) && s[pos] != "=" { pos = pos + 1 }
        pos = pos + 1 // skip =
        while pos < len(s) && (s[pos] == " " || s[pos] == "\t") { pos = pos + 1 }
        // Parse value
        const vr = toml_parse_value(s, pos)
        table[key.trim()] = vr[0]
        pos = vr[1]
        while pos < len(s) && (s[pos] == " " || s[pos] == "\t" || s[pos] == ",") { pos = pos + 1 }
    }
    if pos < len(s) { pos = pos + 1 } // skip }
    [table, pos]
}

func toml_parse_value(s, pos) {
    while pos < len(s) && (s[pos] == " " || s[pos] == "\t") { pos = pos + 1 }
    if pos >= len(s) { return [null, pos] }

    // String
    if s[pos] == "\"" {
        // Multi-line string
        if pos + 2 < len(s) && s[pos + 1] == "\"" && s[pos + 2] == "\"" {
            pos = pos + 3
            let val = ""
            while pos < len(s) {
                if pos + 2 < len(s) && s[pos] == "\"" && s[pos + 1] == "\"" && s[pos + 2] == "\"" {
                    pos = pos + 3
                    return [val, pos]
                }
                val = val + s[pos]
                pos = pos + 1
            }
            return [val, pos]
        }
        pos = pos + 1
        let val = ""
        while pos < len(s) && s[pos] != "\"" {
            if s[pos] == "\\" && pos + 1 < len(s) {
                const next = s[pos + 1]
                if next == "n" { val = val + "\n"; pos = pos + 2 }
                else if next == "t" { val = val + "\t"; pos = pos + 2 }
                else if next == "\\" { val = val + "\\"; pos = pos + 2 }
                else if next == "\"" { val = val + "\""; pos = pos + 2 }
                else { val = val + s[pos]; pos = pos + 1 }
            } else {
                val = val + s[pos]
                pos = pos + 1
            }
        }
        if pos < len(s) { pos = pos + 1 }
        return [val, pos]
    }

    // Inline table
    if s[pos] == "{" {
        return toml_parse_inline_table(s, pos)
    }

    // Array
    if s[pos] == "[" {
        pos = pos + 1
        let arr = []
        while pos < len(s) && s[pos] != "]" {
            while pos < len(s) && (s[pos] == " " || s[pos] == "\t" || s[pos] == "\n" || s[pos] == ",") { pos = pos + 1 }
            if pos >= len(s) || s[pos] == "]" { break }
            const vr = toml_parse_value(s, pos)
            arr.push(vr[0])
            pos = vr[1]
        }
        if pos < len(s) { pos = pos + 1 }
        return [arr, pos]
    }

    // Boolean
    if pos + 4 <= len(s) && s.substring(pos, pos + 4) == "true" {
        return [true, pos + 4]
    }
    if pos + 5 <= len(s) && s.substring(pos, pos + 5) == "false" {
        return [false, pos + 5]
    }

    // Datetime (ISO 8601)
    // Check for pattern: YYYY-MM-DD
    let look = pos
    let is_datetime = false
    if look + 10 <= len(s) && s[look + 4] == "-" && s[look + 7] == "-" {
        is_datetime = true
    }
    if is_datetime {
        let dt_str = ""
        while pos < len(s) && s[pos] != "," && s[pos] != "]" && s[pos] != "}" && s[pos] != "\n" && s[pos] != "#" {
            dt_str = dt_str + s[pos]
            pos = pos + 1
        }
        return [dt_str.trim(), pos]
    }

    // Number (int or float)
    let num_str = ""
    while pos < len(s) && s[pos] != "," && s[pos] != "]" && s[pos] != "}" && s[pos] != "\n" && s[pos] != "#" && s[pos] != " " {
        if s[pos] != "_" { num_str = num_str + s[pos] }
        pos = pos + 1
    }
    if num_str.contains(".") || num_str.contains("e") || num_str.contains("E") {
        return [parse_float(num_str), pos]
    }
    [parse_int(num_str), pos]
}

// ════════════════════════════════════════════════════════════════════
// 34. MIME Type Detection
// ════════════════════════════════════════════════════════════════════

func mime_type_from_extension(ext) {
    const e = ext.to_lower()
    if e == "html" || e == "htm" { return "text/html" }
    if e == "css" { return "text/css" }
    if e == "js" || e == "mjs" { return "application/javascript" }
    if e == "json" { return "application/json" }
    if e == "xml" { return "application/xml" }
    if e == "txt" { return "text/plain" }
    if e == "csv" { return "text/csv" }
    if e == "md" { return "text/markdown" }
    if e == "yaml" || e == "yml" { return "application/yaml" }
    if e == "toml" { return "application/toml" }
    if e == "png" { return "image/png" }
    if e == "jpg" || e == "jpeg" { return "image/jpeg" }
    if e == "gif" { return "image/gif" }
    if e == "svg" { return "image/svg+xml" }
    if e == "webp" { return "image/webp" }
    if e == "ico" { return "image/x-icon" }
    if e == "pdf" { return "application/pdf" }
    if e == "zip" { return "application/zip" }
    if e == "gz" || e == "gzip" { return "application/gzip" }
    if e == "tar" { return "application/x-tar" }
    if e == "wasm" { return "application/wasm" }
    if e == "mp3" { return "audio/mpeg" }
    if e == "mp4" { return "video/mp4" }
    if e == "webm" { return "video/webm" }
    if e == "woff" { return "font/woff" }
    if e == "woff2" { return "font/woff2" }
    if e == "ttf" { return "font/ttf" }
    if e == "otf" { return "font/otf" }
    if e == "eot" { return "application/vnd.ms-fontobject" }
    "application/octet-stream"
}

func mime_type_from_path(path) {
    const dot = path.last_index_of(".")
    if dot < 0 { return "application/octet-stream" }
    const ext = path.substring(dot + 1)
    mime_type_from_extension(ext)
}

// ════════════════════════════════════════════════════════════════════
// 35. Semantic Versioning
// ════════════════════════════════════════════════════════════════════

func semver_parse(s) {
    let rest = s
    let pre = ""
    let build = ""
    // Split off build metadata
    const plus_idx = rest.index_of("+")
    if plus_idx >= 0 {
        build = rest.substring(plus_idx + 1)
        rest = rest.substring(0, plus_idx)
    }
    // Split off pre-release
    const dash_idx = rest.index_of("-")
    if dash_idx >= 0 {
        pre = rest.substring(dash_idx + 1)
        rest = rest.substring(0, dash_idx)
    }
    const parts = rest.split(".")
    if len(parts) != 3 { return {"error": "invalid semver: " + s} }
    {
        "major": parse_int(parts[0]),
        "minor": parse_int(parts[1]),
        "patch": parse_int(parts[2]),
        "pre": pre,
        "build": build
    }
}

func semver_to_string(v) {
    let s = f"{v.major}.{v.minor}.{v.patch}"
    if len(v.pre) > 0 { s = s + "-" + v.pre }
    if len(v.build) > 0 { s = s + "+" + v.build }
    s
}

func semver_compare(a, b) {
    if a.major != b.major { return if a.major < b.major { -1 } else { 1 } }
    if a.minor != b.minor { return if a.minor < b.minor { -1 } else { 1 } }
    if a.patch != b.patch { return if a.patch < b.patch { -1 } else { 1 } }
    // Pre-release has lower precedence than release
    if len(a.pre) == 0 && len(b.pre) > 0 { return 1 }
    if len(a.pre) > 0 && len(b.pre) == 0 { return -1 }
    if a.pre < b.pre { return -1 }
    if a.pre > b.pre { return 1 }
    0
}

func semver_bump_major(v) {
    {"major": v.major + 1, "minor": 0, "patch": 0, "pre": "", "build": ""}
}

func semver_bump_minor(v) {
    {"major": v.major, "minor": v.minor + 1, "patch": 0, "pre": "", "build": ""}
}

func semver_bump_patch(v) {
    {"major": v.major, "minor": v.minor, "patch": v.patch + 1, "pre": "", "build": ""}
}

// Check if version satisfies a constraint string (^, ~, >=, <, !=, *)
func semver_satisfies(version, constraint) {
    const c = constraint.trim()
    if c == "*" { return true }
    if c.starts_with("^") {
        const target = semver_parse(c.substring(1))
        if target.has("error") { return false }
        if version.major != target.major { return false }
        return semver_compare(version, target) >= 0
    }
    if c.starts_with("~") {
        const target = semver_parse(c.substring(1))
        if target.has("error") { return false }
        if version.major != target.major || version.minor != target.minor { return false }
        return version.patch >= target.patch
    }
    if c.starts_with(">=") {
        const target = semver_parse(c.substring(2).trim())
        if target.has("error") { return false }
        return semver_compare(version, target) >= 0
    }
    if c.starts_with("<=") {
        const target = semver_parse(c.substring(2).trim())
        if target.has("error") { return false }
        return semver_compare(version, target) <= 0
    }
    if c.starts_with("!=") {
        const target = semver_parse(c.substring(2).trim())
        if target.has("error") { return false }
        return semver_compare(version, target) != 0
    }
    if c.starts_with(">") {
        const target = semver_parse(c.substring(1).trim())
        if target.has("error") { return false }
        return semver_compare(version, target) > 0
    }
    if c.starts_with("<") {
        const target = semver_parse(c.substring(1).trim())
        if target.has("error") { return false }
        return semver_compare(version, target) < 0
    }
    // Exact match
    const target = semver_parse(c)
    if target.has("error") { return false }
    semver_compare(version, target) == 0
}

// ════════════════════════════════════════════════════════════════════
// 36. Cookie Parser
// ════════════════════════════════════════════════════════════════════

func cookie_parse(header) {
    let cookies = {}
    const pairs = header.split(";")
    for pair in pairs {
        const trimmed = pair.trim()
        const eq = trimmed.index_of("=")
        if eq > 0 {
            const name = trimmed.substring(0, eq).trim()
            const value = trimmed.substring(eq + 1).trim()
            cookies[name] = value
        }
    }
    cookies
}

func cookie_serialize(name, value, options) {
    let result = name + "=" + value
    if options != null {
        if options.has("path") { result = result + "; Path=" + options.path }
        if options.has("domain") { result = result + "; Domain=" + options.domain }
        if options.has("max_age") { result = result + "; Max-Age=" + to_string(options.max_age) }
        if options.has("expires") { result = result + "; Expires=" + options.expires }
        if options.has("secure") && options.secure { result = result + "; Secure" }
        if options.has("http_only") && options.http_only { result = result + "; HttpOnly" }
        if options.has("same_site") { result = result + "; SameSite=" + options.same_site }
    }
    result
}

// ════════════════════════════════════════════════════════════════════
// 37. Multipart Form Data Parser
// ════════════════════════════════════════════════════════════════════

func multipart_parse(body, boundary) {
    let parts = []
    const delimiter = "--" + boundary
    const sections = body.split(delimiter)
    for section in sections {
        const trimmed = section.trim()
        if len(trimmed) == 0 || trimmed == "--" { continue }
        // Split headers from body
        const sep = trimmed.index_of("\r\n\r\n")
        let headers_str = ""
        let part_body = ""
        if sep >= 0 {
            headers_str = trimmed.substring(0, sep)
            part_body = trimmed.substring(sep + 4)
        } else {
            const sep2 = trimmed.index_of("\n\n")
            if sep2 >= 0 {
                headers_str = trimmed.substring(0, sep2)
                part_body = trimmed.substring(sep2 + 2)
            } else {
                part_body = trimmed
            }
        }
        // Parse headers
        let headers = {}
        for line in headers_str.split("\n") {
            const colon = line.index_of(":")
            if colon > 0 {
                const hname = line.substring(0, colon).trim().to_lower()
                const hval = line.substring(colon + 1).trim()
                headers[hname] = hval
            }
        }
        // Extract name and filename from content-disposition
        let name = ""
        let filename = ""
        if headers.has("content-disposition") {
            const cd = headers["content-disposition"]
            const name_idx = cd.index_of("name=\"")
            if name_idx >= 0 {
                const name_end = cd.index_of("\"", name_idx + 6)
                if name_end > name_idx { name = cd.substring(name_idx + 6, name_end) }
            }
            const fn_idx = cd.index_of("filename=\"")
            if fn_idx >= 0 {
                const fn_end = cd.index_of("\"", fn_idx + 10)
                if fn_end > fn_idx { filename = cd.substring(fn_idx + 10, fn_end) }
            }
        }
        parts.push({"name": name, "filename": filename, "headers": headers, "body": part_body})
    }
    parts
}

// ════════════════════════════════════════════════════════════════════
// 38. Template Engine (Mustache/Handlebars-style)
// ════════════════════════════════════════════════════════════════════

// Render a template with data.
// Supports: {{var}}, {{#if cond}}...{{/if}}, {{#each arr}}...{{/each}}, {{> partial}}
func template_render(tmpl, data, partials) {
    if partials == null { partials = {} }
    let result = ""
    let pos = 0
    while pos < len(tmpl) {
        if pos + 1 < len(tmpl) && tmpl[pos] == "{" && tmpl[pos + 1] == "{" {
            pos = pos + 2
            // Find closing }}
            const close = tmpl.index_of("}}", pos)
            if close < 0 { break }
            const tag = tmpl.substring(pos, close).trim()
            pos = close + 2

            if tag.starts_with("#if ") {
                const cond_key = tag.substring(4).trim()
                const end_tag = "{{/if}}"
                const end_pos = tmpl.index_of(end_tag, pos)
                if end_pos < 0 { break }
                const inner = tmpl.substring(pos, end_pos)
                pos = end_pos + len(end_tag)
                // Check else
                const else_idx = inner.index_of("{{else}}")
                if data.has(cond_key) && data[cond_key] {
                    if else_idx >= 0 {
                        result = result + template_render(inner.substring(0, else_idx), data, partials)
                    } else {
                        result = result + template_render(inner, data, partials)
                    }
                } else if else_idx >= 0 {
                    result = result + template_render(inner.substring(else_idx + 8), data, partials)
                }
            } else if tag.starts_with("#each ") {
                const arr_key = tag.substring(6).trim()
                const end_tag = "{{/each}}"
                const end_pos = tmpl.index_of(end_tag, pos)
                if end_pos < 0 { break }
                const inner = tmpl.substring(pos, end_pos)
                pos = end_pos + len(end_tag)
                if data.has(arr_key) {
                    const arr = data[arr_key]
                    let idx = 0
                    for item in arr {
                        let item_data = {}
                        // Merge parent data
                        for k in data.keys() { item_data[k] = data[k] }
                        // Add loop context
                        const t = typeof(item)
                        if t == "map" {
                            for k in item.keys() { item_data[k] = item[k] }
                        }
                        item_data["this"] = item
                        item_data["@index"] = idx
                        item_data["@first"] = idx == 0
                        item_data["@last"] = idx == len(arr) - 1
                        result = result + template_render(inner, item_data, partials)
                        idx = idx + 1
                    }
                }
            } else if tag.starts_with("#unless ") {
                const cond_key = tag.substring(8).trim()
                const end_tag = "{{/unless}}"
                const end_pos = tmpl.index_of(end_tag, pos)
                if end_pos < 0 { break }
                const inner = tmpl.substring(pos, end_pos)
                pos = end_pos + len(end_tag)
                if !data.has(cond_key) || !data[cond_key] {
                    result = result + template_render(inner, data, partials)
                }
            } else if tag.starts_with("> ") {
                // Partial
                const partial_name = tag.substring(2).trim()
                if partials.has(partial_name) {
                    result = result + template_render(partials[partial_name], data, partials)
                }
            } else if tag.starts_with("{") && tag.ends_with("}") {
                // Unescaped: {{{var}}}
                const var_name = tag.substring(1, len(tag) - 1).trim()
                if data.has(var_name) { result = result + to_string(data[var_name]) }
            } else {
                // Variable interpolation (HTML-escaped)
                const parts = tag.split(".")
                let value = data
                for part in parts {
                    const pt = part.trim()
                    if typeof(value) == "map" && value.has(pt) {
                        value = value[pt]
                    } else {
                        value = ""
                        break
                    }
                }
                const sv = to_string(value)
                result = result + sv.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
            }
        } else {
            result = result + tmpl[pos]
            pos = pos + 1
        }
    }
    result
}

// ════════════════════════════════════════════════════════════════════
// 39. Diff (Line-level, Word-level, Patch Generation)
// ════════════════════════════════════════════════════════════════════

// Compute line-level diff using longest common subsequence.
func diff_lines(a_text, b_text) {
    const a_lines = a_text.split("\n")
    const b_lines = b_text.split("\n")
    const m = len(a_lines)
    const n = len(b_lines)

    // Build LCS table
    let dp = []
    let i = 0
    while i <= m {
        let row = []
        let j = 0
        while j <= n { row.push(0); j = j + 1 }
        dp.push(row)
        i = i + 1
    }
    i = 1
    while i <= m {
        let j = 1
        while j <= n {
            if a_lines[i - 1] == b_lines[j - 1] {
                dp[i][j] = dp[i - 1][j - 1] + 1
            } else {
                dp[i][j] = if dp[i - 1][j] > dp[i][j - 1] { dp[i - 1][j] } else { dp[i][j - 1] }
            }
            j = j + 1
        }
        i = i + 1
    }

    // Backtrack to build diff
    let result = []
    i = m
    let j = n
    while i > 0 || j > 0 {
        if i > 0 && j > 0 && a_lines[i - 1] == b_lines[j - 1] {
            result.push({"op": "=", "line": a_lines[i - 1]})
            i = i - 1
            j = j - 1
        } else if j > 0 && (i == 0 || dp[i][j - 1] >= dp[i - 1][j]) {
            result.push({"op": "+", "line": b_lines[j - 1]})
            j = j - 1
        } else {
            result.push({"op": "-", "line": a_lines[i - 1]})
            i = i - 1
        }
    }
    result.reverse()
    result
}

// Word-level diff within a line.
func diff_words(a, b) {
    const a_words = a.split(" ")
    const b_words = b.split(" ")
    const m = len(a_words)
    const n = len(b_words)
    let dp = []
    let i = 0
    while i <= m {
        let row = []
        let j = 0
        while j <= n { row.push(0); j = j + 1 }
        dp.push(row)
        i = i + 1
    }
    i = 1
    while i <= m {
        let j = 1
        while j <= n {
            if a_words[i - 1] == b_words[j - 1] {
                dp[i][j] = dp[i - 1][j - 1] + 1
            } else {
                dp[i][j] = if dp[i - 1][j] > dp[i][j - 1] { dp[i - 1][j] } else { dp[i][j - 1] }
            }
            j = j + 1
        }
        i = i + 1
    }
    let result = []
    i = m
    let j = n
    while i > 0 || j > 0 {
        if i > 0 && j > 0 && a_words[i - 1] == b_words[j - 1] {
            result.push({"op": "=", "word": a_words[i - 1]})
            i = i - 1
            j = j - 1
        } else if j > 0 && (i == 0 || dp[i][j - 1] >= dp[i - 1][j]) {
            result.push({"op": "+", "word": b_words[j - 1]})
            j = j - 1
        } else {
            result.push({"op": "-", "word": a_words[i - 1]})
            i = i - 1
        }
    }
    result.reverse()
    result
}

// Generate unified diff patch string.
func diff_patch(a_text, b_text, filename) {
    const hunks = diff_lines(a_text, b_text)
    let result = f"--- a/{filename}\n+++ b/{filename}\n"
    let a_line = 1
    let b_line = 1
    for hunk in hunks {
        if hunk.op == "=" {
            result = result + " " + hunk.line + "\n"
            a_line = a_line + 1
            b_line = b_line + 1
        } else if hunk.op == "-" {
            result = result + "-" + hunk.line + "\n"
            a_line = a_line + 1
        } else if hunk.op == "+" {
            result = result + "+" + hunk.line + "\n"
            b_line = b_line + 1
        }
    }
    result
}

// Side-by-side format.
func diff_side_by_side(a_text, b_text, width) {
    if width == null { width = 80 }
    const half = int(width / 2) - 3
    const hunks = diff_lines(a_text, b_text)
    let result = ""
    for hunk in hunks {
        if hunk.op == "=" {
            const padded = hunk.line.pad_end(half)
            result = result + padded + " | " + hunk.line + "\n"
        } else if hunk.op == "-" {
            result = result + hunk.line.pad_end(half) + " < " + "\n"
        } else if hunk.op == "+" {
            result = result + " ".repeat(half) + " > " + hunk.line + "\n"
        }
    }
    result
}

// ════════════════════════════════════════════════════════════════════
// 40. Bloom Filter
// ════════════════════════════════════════════════════════════════════

func bloom_new(size, hash_count) {
    if size == null { size = 1024 }
    if hash_count == null { hash_count = 3 }
    let bits = []
    let i = 0
    while i < size { bits.push(false); i = i + 1 }
    {"bits": bits, "size": size, "hash_count": hash_count}
}

func bloom_hash(bloom, value, seed) {
    const s = to_string(value)
    let h = seed
    let i = 0
    while i < len(s) {
        h = (h * 31 + char_code_at(s, i)) % bloom.size
        i = i + 1
    }
    if h < 0 { h = 0 - h }
    h % bloom.size
}

func bloom_add(bloom, value) {
    let i = 0
    while i < bloom.hash_count {
        const idx = bloom_hash(bloom, value, i * 7919 + 1)
        bloom.bits[idx] = true
        i = i + 1
    }
}

func bloom_test(bloom, value) {
    let i = 0
    while i < bloom.hash_count {
        const idx = bloom_hash(bloom, value, i * 7919 + 1)
        if !bloom.bits[idx] { return false }
        i = i + 1
    }
    true
}

// ════════════════════════════════════════════════════════════════════
// 41. Consistent Hashing
// ════════════════════════════════════════════════════════════════════

func consistent_hash_new(replicas) {
    if replicas == null { replicas = 150 }
    {"ring": [], "nodes": [], "replicas": replicas}
}

func consistent_hash_fnv(s) {
    let hash = 2166136261
    let i = 0
    while i < len(s) {
        hash = (hash * 16777619) % 2147483647
        hash = hash ^ char_code_at(s, i)
        i = i + 1
    }
    if hash < 0 { hash = 0 - hash }
    hash
}

func consistent_hash_add(ch, node) {
    ch.nodes.push(node)
    let i = 0
    while i < ch.replicas {
        const key = f"{node}:{i}"
        const h = consistent_hash_fnv(key)
        ch.ring.push({"hash": h, "node": node})
        i = i + 1
    }
    ch.ring.sort((a, b) => a.hash - b.hash)
}

func consistent_hash_get(ch, key) {
    if len(ch.ring) == 0 { return null }
    const h = consistent_hash_fnv(to_string(key))
    // Binary search for first ring entry >= h
    let lo = 0
    let hi = len(ch.ring) - 1
    while lo < hi {
        const mid = int((lo + hi) / 2)
        if ch.ring[mid].hash < h { lo = mid + 1 } else { hi = mid }
    }
    if ch.ring[lo].hash < h { lo = 0 } // wrap around
    ch.ring[lo].node
}

// ════════════════════════════════════════════════════════════════════
// 42. Rate Limiter (Token Bucket)
// ════════════════════════════════════════════════════════════════════

func rate_limiter_new(capacity, refill_rate) {
    {
        "capacity": capacity,
        "tokens": capacity,
        "refill_rate": refill_rate,
        "last_refill": 0
    }
}

func rate_limiter_allow(rl, now) {
    // Refill tokens based on elapsed time
    if rl.last_refill > 0 {
        const elapsed = now - rl.last_refill
        const new_tokens = elapsed * rl.refill_rate
        rl.tokens = if rl.tokens + new_tokens > rl.capacity { rl.capacity } else { rl.tokens + new_tokens }
    }
    rl.last_refill = now
    if rl.tokens >= 1.0 {
        rl.tokens = rl.tokens - 1.0
        true
    } else {
        false
    }
}

// ════════════════════════════════════════════════════════════════════
// 43. Circuit Breaker
// ════════════════════════════════════════════════════════════════════

const CB_CLOSED = "closed"
const CB_OPEN = "open"
const CB_HALF_OPEN = "half_open"

func circuit_breaker_new(failure_threshold, reset_timeout) {
    {
        "state": CB_CLOSED,
        "failures": 0,
        "failure_threshold": failure_threshold,
        "reset_timeout": reset_timeout,
        "last_failure_time": 0,
        "successes_in_half_open": 0
    }
}

func circuit_breaker_allow(cb, now) {
    if cb.state == CB_CLOSED { return true }
    if cb.state == CB_OPEN {
        if now - cb.last_failure_time >= cb.reset_timeout {
            cb.state = CB_HALF_OPEN
            cb.successes_in_half_open = 0
            return true
        }
        return false
    }
    // HALF_OPEN: allow one request to test
    true
}

func circuit_breaker_record_success(cb) {
    if cb.state == CB_HALF_OPEN {
        cb.successes_in_half_open = cb.successes_in_half_open + 1
        if cb.successes_in_half_open >= 2 {
            cb.state = CB_CLOSED
            cb.failures = 0
        }
    } else {
        cb.failures = 0
    }
}

func circuit_breaker_record_failure(cb, now) {
    cb.failures = cb.failures + 1
    cb.last_failure_time = now
    if cb.failures >= cb.failure_threshold {
        cb.state = CB_OPEN
    }
}

// ════════════════════════════════════════════════════════════════════
// 44. Retry with Exponential Backoff
// ════════════════════════════════════════════════════════════════════

func retry_config_new(max_retries, initial_delay_ms, max_delay_ms, backoff_factor) {
    if max_retries == null { max_retries = 3 }
    if initial_delay_ms == null { initial_delay_ms = 100 }
    if max_delay_ms == null { max_delay_ms = 30000 }
    if backoff_factor == null { backoff_factor = 2.0 }
    {
        "max_retries": max_retries,
        "initial_delay_ms": initial_delay_ms,
        "max_delay_ms": max_delay_ms,
        "backoff_factor": backoff_factor
    }
}

func retry_get_delay(config, attempt) {
    let delay = config.initial_delay_ms
    let i = 0
    while i < attempt {
        delay = int(delay * config.backoff_factor)
        i = i + 1
    }
    if delay > config.max_delay_ms { delay = config.max_delay_ms }
    delay
}

// ════════════════════════════════════════════════════════════════════
// 45. LRU Cache Improvements
// ════════════════════════════════════════════════════════════════════

func lru_cache_new(capacity) {
    {"capacity": capacity, "items": [], "map": {}}
}

func lru_cache_get(cache, key) {
    if !cache.map.has(key) { return null }
    // Move to front (most recently used)
    const val = cache.map[key]
    let new_items = [key]
    for item in cache.items {
        if item != key { new_items.push(item) }
    }
    cache.items = new_items
    val
}

func lru_cache_put(cache, key, value) {
    if cache.map.has(key) {
        cache.map[key] = value
        // Move to front
        let new_items = [key]
        for item in cache.items {
            if item != key { new_items.push(item) }
        }
        cache.items = new_items
        return null
    }
    // Evict if at capacity
    if len(cache.items) >= cache.capacity {
        const evicted = cache.items[len(cache.items) - 1]
        cache.items = cache.items.slice(0, len(cache.items) - 1)
        cache.map.remove(evicted)
    }
    cache.items = [key] + cache.items
    cache.map[key] = value
}

func lru_cache_remove(cache, key) {
    if !cache.map.has(key) { return null }
    cache.map.remove(key)
    let new_items = []
    for item in cache.items {
        if item != key { new_items.push(item) }
    }
    cache.items = new_items
}

func lru_cache_contains(cache, key) { cache.map.has(key) }
func lru_cache_size(cache) { len(cache.items) }
func lru_cache_keys(cache) { cache.items }

// ════════════════════════════════════════════════════════════════════
// 46. Trie Improvements (Prefix Search, Autocomplete)
// ════════════════════════════════════════════════════════════════════

func trie_new() { {"children": {}, "is_end": false, "value": null} }

func trie_insert(trie, key, value) {
    let node = trie
    let i = 0
    while i < len(key) {
        const c = key[i]
        if !node.children.has(c) {
            node.children[c] = {"children": {}, "is_end": false, "value": null}
        }
        node = node.children[c]
        i = i + 1
    }
    node.is_end = true
    node.value = value
}

func trie_search(trie, key) {
    let node = trie
    let i = 0
    while i < len(key) {
        const c = key[i]
        if !node.children.has(c) { return null }
        node = node.children[c]
        i = i + 1
    }
    if node.is_end { node.value } else { null }
}

func trie_starts_with(trie, prefix) {
    let node = trie
    let i = 0
    while i < len(prefix) {
        const c = prefix[i]
        if !node.children.has(c) { return false }
        node = node.children[c]
        i = i + 1
    }
    true
}

func trie_autocomplete(trie, prefix, max_results) {
    if max_results == null { max_results = 10 }
    let node = trie
    let i = 0
    while i < len(prefix) {
        const c = prefix[i]
        if !node.children.has(c) { return [] }
        node = node.children[c]
        i = i + 1
    }
    let results = []
    trie_collect(node, prefix, results, max_results)
    results
}

func trie_collect(node, current, results, max) {
    if len(results) >= max { return null }
    if node.is_end { results.push(current) }
    for c in node.children.keys() {
        trie_collect(node.children[c], current + c, results, max)
    }
}

func trie_prefix_search(trie, prefix) {
    trie_autocomplete(trie, prefix, 1000)
}

// ════════════════════════════════════════════════════════════════════
// 47. Graph Algorithms
// ════════════════════════════════════════════════════════════════════

// Graph: {"nodes": [node_id, ...], "edges": [[from, to, weight], ...]}
func graph_new() { {"nodes": [], "edges": []} }

func graph_add_node(g, id) {
    if !g.nodes.contains(id) { g.nodes.push(id) }
}

func graph_add_edge(g, from, to, weight) {
    if weight == null { weight = 1 }
    g.edges.push([from, to, weight])
}

// Dijkstra's shortest path from source to all reachable nodes.
func graph_dijkstra(g, source) {
    let dist = {}
    let prev = {}
    let visited = {}
    let queue = []

    for node in g.nodes {
        dist[node] = 999999999
        prev[node] = null
    }
    dist[source] = 0
    queue.push(source)

    while len(queue) > 0 {
        // Find unvisited node with smallest distance
        let min_dist = 999999999
        let min_idx = 0
        let i = 0
        for q in queue {
            if dist[q] < min_dist {
                min_dist = dist[q]
                min_idx = i
            }
            i = i + 1
        }
        const u = queue[min_idx]
        queue = queue.slice(0, min_idx) + queue.slice(min_idx + 1)
        if visited.has(u) { continue }
        visited[u] = true

        // Relax neighbors
        for edge in g.edges {
            if edge[0] == u {
                const v = edge[1]
                const w = edge[2]
                const alt = dist[u] + w
                if alt < dist[v] {
                    dist[v] = alt
                    prev[v] = u
                    if !visited.has(v) { queue.push(v) }
                }
            }
        }
    }
    {"dist": dist, "prev": prev}
}

// Reconstruct path from Dijkstra result.
func graph_shortest_path(g, source, target) {
    const result = graph_dijkstra(g, source)
    let path = []
    let current = target
    while current != null {
        path.push(current)
        current = result.prev[current]
    }
    path.reverse()
    if len(path) > 0 && path[0] == source {
        {"path": path, "distance": result.dist[target]}
    } else {
        {"path": [], "distance": -1}
    }
}

// Floyd-Warshall all-pairs shortest paths.
func graph_floyd_warshall(g) {
    const n = len(g.nodes)
    let dist = {}
    // Initialize distance matrix
    for u in g.nodes {
        dist[u] = {}
        for v in g.nodes {
            dist[u][v] = if u == v { 0 } else { 999999999 }
        }
    }
    for edge in g.edges {
        dist[edge[0]][edge[1]] = edge[2]
    }
    // DP relaxation
    for k in g.nodes {
        for i in g.nodes {
            for j in g.nodes {
                const through_k = dist[i][k] + dist[k][j]
                if through_k < dist[i][j] {
                    dist[i][j] = through_k
                }
            }
        }
    }
    dist
}

// Kruskal's minimum spanning tree.
func graph_kruskal(g) {
    // Union-Find
    let parent = {}
    let rank = {}
    for node in g.nodes {
        parent[node] = node
        rank[node] = 0
    }

    func find(x) {
        while parent[x] != x { parent[x] = parent[parent[x]]; x = parent[x] }
        x
    }

    func union(x, y) {
        const rx = find(x)
        const ry = find(y)
        if rx == ry { return false }
        if rank[rx] < rank[ry] { parent[rx] = ry }
        else if rank[rx] > rank[ry] { parent[ry] = rx }
        else { parent[ry] = rx; rank[rx] = rank[rx] + 1 }
        true
    }

    // Sort edges by weight
    let sorted_edges = g.edges.slice(0)
    sorted_edges.sort((a, b) => a[2] - b[2])

    let mst = []
    let total_weight = 0
    for edge in sorted_edges {
        if union(edge[0], edge[1]) {
            mst.push(edge)
            total_weight = total_weight + edge[2]
        }
    }
    {"edges": mst, "total_weight": total_weight}
}

// A* pathfinding with heuristic.
func graph_astar(g, start, goal, heuristic) {
    let open_set = [start]
    let came_from = {}
    let g_score = {}
    let f_score = {}

    for node in g.nodes {
        g_score[node] = 999999999
        f_score[node] = 999999999
    }
    g_score[start] = 0
    f_score[start] = heuristic(start, goal)

    while len(open_set) > 0 {
        // Find node in open_set with lowest f_score
        let best = open_set[0]
        let best_f = f_score[best]
        for node in open_set {
            if f_score[node] < best_f {
                best = node
                best_f = f_score[node]
            }
        }

        if best == goal {
            // Reconstruct path
            let path = [goal]
            let current = goal
            while came_from.has(current) {
                current = came_from[current]
                path.push(current)
            }
            path.reverse()
            return {"path": path, "distance": g_score[goal]}
        }

        // Remove best from open_set
        let new_open = []
        for node in open_set { if node != best { new_open.push(node) } }
        open_set = new_open

        // Check neighbors
        for edge in g.edges {
            if edge[0] == best {
                const neighbor = edge[1]
                const tentative = g_score[best] + edge[2]
                if tentative < g_score[neighbor] {
                    came_from[neighbor] = best
                    g_score[neighbor] = tentative
                    f_score[neighbor] = tentative + heuristic(neighbor, goal)
                    if !open_set.contains(neighbor) {
                        open_set.push(neighbor)
                    }
                }
            }
        }
    }
    {"path": [], "distance": -1}
}

// ════════════════════════════════════════════════════════════════════
// 48. String Matching Algorithms
// ════════════════════════════════════════════════════════════════════

// KMP (Knuth-Morris-Pratt) pattern matching.
func kmp_search(text, pattern) {
    const n = len(text)
    const m = len(pattern)
    if m == 0 { return [] }

    // Build failure function
    let fail = [0]
    let i = 1
    let j = 0
    while i < m {
        fail.push(0)
        i = i + 1
    }
    i = 1
    while i < m {
        while j > 0 && pattern[j] != pattern[i] { j = fail[j - 1] }
        if pattern[j] == pattern[i] { j = j + 1 }
        fail[i] = j
        i = i + 1
    }

    // Search
    let matches = []
    j = 0
    i = 0
    while i < n {
        while j > 0 && pattern[j] != text[i] { j = fail[j - 1] }
        if pattern[j] == text[i] { j = j + 1 }
        if j == m {
            matches.push(i - m + 1)
            j = fail[j - 1]
        }
        i = i + 1
    }
    matches
}

// Rabin-Karp pattern matching with rolling hash.
func rabin_karp_search(text, pattern) {
    const n = len(text)
    const m = len(pattern)
    if m == 0 || m > n { return [] }

    const base = 256
    const modulus = 1000000007
    let matches = []

    // Compute hash of pattern and first window
    let pat_hash = 0
    let txt_hash = 0
    let h = 1
    let i = 0
    while i < m - 1 { h = (h * base) % modulus; i = i + 1 }

    i = 0
    while i < m {
        pat_hash = (base * pat_hash + char_code_at(pattern, i)) % modulus
        txt_hash = (base * txt_hash + char_code_at(text, i)) % modulus
        i = i + 1
    }

    i = 0
    while i <= n - m {
        if pat_hash == txt_hash {
            // Verify character by character
            let match = true
            let j = 0
            while j < m {
                if text[i + j] != pattern[j] { match = false; break }
                j = j + 1
            }
            if match { matches.push(i) }
        }
        // Slide window
        if i < n - m {
            txt_hash = (base * (txt_hash - char_code_at(text, i) * h) + char_code_at(text, i + m)) % modulus
            if txt_hash < 0 { txt_hash = txt_hash + modulus }
        }
        i = i + 1
    }
    matches
}

// Aho-Corasick multi-pattern search.
func aho_corasick_new(patterns) {
    // Build trie with failure links
    let nodes = [{"children": {}, "fail": 0, "output": []}]

    // Insert patterns
    let pi = 0
    while pi < len(patterns) {
        const pat = patterns[pi]
        let current = 0
        let ci = 0
        while ci < len(pat) {
            const c = pat[ci]
            if !nodes[current].children.has(c) {
                nodes.push({"children": {}, "fail": 0, "output": []})
                nodes[current].children[c] = len(nodes) - 1
            }
            current = nodes[current].children[c]
            ci = ci + 1
        }
        nodes[current].output.push(pi)
        pi = pi + 1
    }

    // Build failure links via BFS
    let queue = []
    for c in nodes[0].children.keys() {
        const child = nodes[0].children[c]
        nodes[child].fail = 0
        queue.push(child)
    }

    while len(queue) > 0 {
        const u = queue[0]
        queue = queue.slice(1)
        for c in nodes[u].children.keys() {
            const v = nodes[u].children[c]
            queue.push(v)
            let f = nodes[u].fail
            while f != 0 && !nodes[f].children.has(c) {
                f = nodes[f].fail
            }
            nodes[v].fail = if nodes[f].children.has(c) && nodes[f].children[c] != v { nodes[f].children[c] } else { 0 }
            // Merge output
            const fail_output = nodes[nodes[v].fail].output
            for o in fail_output { nodes[v].output.push(o) }
        }
    }

    {"nodes": nodes, "patterns": patterns}
}

func aho_corasick_search(ac, text) {
    let matches = []
    let current = 0
    let i = 0
    while i < len(text) {
        const c = text[i]
        while current != 0 && !ac.nodes[current].children.has(c) {
            current = ac.nodes[current].fail
        }
        if ac.nodes[current].children.has(c) {
            current = ac.nodes[current].children[c]
        }
        // Report matches
        for pat_idx in ac.nodes[current].output {
            const pat = ac.patterns[pat_idx]
            matches.push({"pattern": pat, "index": i - len(pat) + 1})
        }
        i = i + 1
    }
    matches
}

// ════════════════════════════════════════════════════════════════════
// 49. Enhanced Regex: Named Groups, Backreferences, Unicode Categories
// ════════════════════════════════════════════════════════════════════

// Named group extraction from regex matches.
func regex_named_groups(pattern, text) {
    // Extract named group definitions: (?P<name>...)
    let groups = {}
    let group_names = []
    let pat_copy = pattern
    let search_pos = 0
    while true {
        const idx = pat_copy.index_of("(?P<", search_pos)
        if idx < 0 { break }
        const name_end = pat_copy.index_of(">", idx + 4)
        if name_end < 0 { break }
        const name = pat_copy.substring(idx + 4, name_end)
        group_names.push(name)
        search_pos = name_end + 1
    }
    // Simplify: strip named group syntax for basic matching
    let simple_pat = pattern
    for name in group_names {
        simple_pat = simple_pat.replace(f"(?P<{name}>", "(")
    }
    // Use basic regex match
    const m = regex_match(simple_pat, text)
    if m == null { return null }
    // Map captured groups to names
    let i = 0
    while i < len(group_names) && i + 1 < len(m) {
        groups[group_names[i]] = m[i + 1]
        i = i + 1
    }
    groups
}

// Unicode character category check.
func unicode_is_letter(c) {
    const code = char_code_at(c, 0)
    (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code > 127
}

func unicode_is_digit(c) {
    const code = char_code_at(c, 0)
    code >= 48 && code <= 57
}

func unicode_is_whitespace(c) {
    const code = char_code_at(c, 0)
    code == 32 || code == 9 || code == 10 || code == 13 || code == 12 || code == 160
}

func unicode_is_upper(c) {
    const code = char_code_at(c, 0)
    code >= 65 && code <= 90
}

func unicode_is_lower(c) {
    const code = char_code_at(c, 0)
    code >= 97 && code <= 122
}

// ════════════════════════════════════════════════════════════════════
// 50. DNS Resolution Helpers
// ════════════════════════════════════════════════════════════════════

// Parse a DNS name from a query string into labels.
func dns_parse_name(name) {
    const labels = name.split(".")
    let valid = true
    for label in labels {
        if len(label) == 0 || len(label) > 63 { valid = false }
    }
    {"labels": labels, "valid": valid, "fqdn": name}
}

// Check if a hostname is a valid DNS name.
func dns_is_valid_hostname(name) {
    if len(name) == 0 || len(name) > 253 { return false }
    const labels = name.split(".")
    for label in labels {
        if len(label) == 0 || len(label) > 63 { return false }
        // Must start with alphanumeric
        const first = label[0]
        if !((first >= "a" && first <= "z") || (first >= "A" && first <= "Z") || (first >= "0" && first <= "9")) {
            return false
        }
    }
    true
}

// Build a DNS query packet (simplified).
func dns_build_query(name, query_type) {
    if query_type == null { query_type = 1 } // A record
    let packet = {}
    packet.id = 1234
    packet.flags = 256 // standard query, recursion desired
    packet.questions = [{"name": name, "type": query_type, "class": 1}]
    packet
}

// DNS record types.
const DNS_TYPE_A = 1
const DNS_TYPE_AAAA = 28
const DNS_TYPE_CNAME = 5
const DNS_TYPE_MX = 15
const DNS_TYPE_NS = 2
const DNS_TYPE_TXT = 16
const DNS_TYPE_SRV = 33
const DNS_TYPE_SOA = 6
const DNS_TYPE_PTR = 12

func dns_type_name(type_code) {
    if type_code == 1 { return "A" }
    if type_code == 28 { return "AAAA" }
    if type_code == 5 { return "CNAME" }
    if type_code == 15 { return "MX" }
    if type_code == 2 { return "NS" }
    if type_code == 16 { return "TXT" }
    if type_code == 33 { return "SRV" }
    if type_code == 6 { return "SOA" }
    if type_code == 12 { return "PTR" }
    f"TYPE{type_code}"
}

// ════════════════════════════════════════════════════════════════════
// 51. Enhanced Regex (Lookahead, Unicode)
// ════════════════════════════════════════════════════════════════════

// Positive lookahead: checks if pattern matches at position without consuming.
func regex_lookahead(pattern, text, pos) {
    const sub = text.substring(pos)
    const m = regex_match(pattern, sub)
    m != null
}

// Negative lookahead: returns true if pattern does NOT match.
func regex_negative_lookahead(pattern, text, pos) {
    !regex_lookahead(pattern, text, pos)
}

// Positive lookbehind: checks if pattern matches text before position.
func regex_lookbehind(pattern, text, pos) {
    if pos <= 0 { return false }
    // Try matching the last N characters where N = len(pattern) estimate
    let check_len = len(pattern) * 2
    if check_len > pos { check_len = pos }
    const sub = text.substring(pos - check_len, pos)
    const m = regex_match(pattern + "$", sub)
    m != null
}

// Backreference substitution in replacement strings.
// \1, \2 etc. refer to capture groups.
func regex_replace_backrefs(match_result, replacement) {
    let result = replacement
    if match_result == null { return result }
    let i = 0
    while i < len(match_result) {
        const ref = "\\" + to_string(i)
        if result.contains(ref) {
            result = result.replace(ref, to_string(match_result[i]))
        }
        i = i + 1
    }
    result
}

// Character class checks for regex engine.
func regex_is_word_char(c) {
    (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || c == "_"
}

func regex_is_boundary(text, pos) {
    const before = if pos > 0 { regex_is_word_char(text[pos - 1]) } else { false }
    const after = if pos < len(text) { regex_is_word_char(text[pos]) } else { false }
    before != after
}

// Unicode category checking for \p{...} patterns.
func regex_unicode_category(c, category) {
    if category == "L" || category == "Letter" { return unicode_is_letter(c) }
    if category == "N" || category == "Number" { return unicode_is_digit(c) }
    if category == "Z" || category == "Separator" { return unicode_is_whitespace(c) }
    if category == "Lu" || category == "Uppercase_Letter" { return unicode_is_upper(c) }
    if category == "Ll" || category == "Lowercase_Letter" { return unicode_is_lower(c) }
    if category == "P" || category == "Punctuation" {
        const code = char_code_at(c, 0)
        return (code >= 33 && code <= 47) || (code >= 58 && code <= 64) || (code >= 91 && code <= 96) || (code >= 123 && code <= 126)
    }
    false
}

// ════════════════════════════════════════════════════════════════════
// 52. Priority Queue (Binary Heap)
// ════════════════════════════════════════════════════════════════════

func heap_new(compare_fn) {
    if compare_fn == null { compare_fn = (a, b) => a - b }
    {"items": [], "cmp": compare_fn}
}

func heap_push(h, value) {
    h.items.push(value)
    heap_sift_up(h, len(h.items) - 1)
}

func heap_pop(h) {
    if len(h.items) == 0 { return null }
    const top = h.items[0]
    const last = h.items.pop()
    if len(h.items) > 0 {
        h.items[0] = last
        heap_sift_down(h, 0)
    }
    top
}

func heap_peek(h) {
    if len(h.items) == 0 { null } else { h.items[0] }
}

func heap_size(h) { len(h.items) }

func heap_sift_up(h, idx) {
    while idx > 0 {
        const parent = int((idx - 1) / 2)
        if h.cmp(h.items[idx], h.items[parent]) < 0 {
            const tmp = h.items[idx]
            h.items[idx] = h.items[parent]
            h.items[parent] = tmp
            idx = parent
        } else {
            break
        }
    }
}

func heap_sift_down(h, idx) {
    const n = len(h.items)
    while true {
        let smallest = idx
        const left = 2 * idx + 1
        const right = 2 * idx + 2
        if left < n && h.cmp(h.items[left], h.items[smallest]) < 0 { smallest = left }
        if right < n && h.cmp(h.items[right], h.items[smallest]) < 0 { smallest = right }
        if smallest == idx { break }
        const tmp = h.items[idx]
        h.items[idx] = h.items[smallest]
        h.items[smallest] = tmp
        idx = smallest
    }
}

// ════════════════════════════════════════════════════════════════════
// 53. Ring Buffer / Circular Buffer
// ════════════════════════════════════════════════════════════════════

func ring_buffer_new(capacity) {
    let data = []
    let i = 0
    while i < capacity { data.push(null); i = i + 1 }
    {"data": data, "capacity": capacity, "head": 0, "tail": 0, "count": 0}
}

func ring_buffer_push(rb, value) {
    rb.data[rb.tail] = value
    rb.tail = (rb.tail + 1) % rb.capacity
    if rb.count < rb.capacity {
        rb.count = rb.count + 1
    } else {
        rb.head = (rb.head + 1) % rb.capacity
    }
}

func ring_buffer_pop(rb) {
    if rb.count == 0 { return null }
    const value = rb.data[rb.head]
    rb.head = (rb.head + 1) % rb.capacity
    rb.count = rb.count - 1
    value
}

func ring_buffer_peek(rb) {
    if rb.count == 0 { null } else { rb.data[rb.head] }
}

func ring_buffer_size(rb) { rb.count }
func ring_buffer_is_full(rb) { rb.count == rb.capacity }
func ring_buffer_is_empty(rb) { rb.count == 0 }

func ring_buffer_to_array(rb) {
    let result = []
    let i = 0
    while i < rb.count {
        const idx = (rb.head + i) % rb.capacity
        result.push(rb.data[idx])
        i = i + 1
    }
    result
}

// ════════════════════════════════════════════════════════════════════
// 54. Disjoint Set (Union-Find)
// ════════════════════════════════════════════════════════════════════

func union_find_new(n) {
    let parent = []
    let rank = []
    let i = 0
    while i < n {
        parent.push(i)
        rank.push(0)
        i = i + 1
    }
    {"parent": parent, "rank": rank, "count": n}
}

func union_find_find(uf, x) {
    while uf.parent[x] != x {
        uf.parent[x] = uf.parent[uf.parent[x]] // path compression
        x = uf.parent[x]
    }
    x
}

func union_find_union(uf, x, y) {
    const rx = union_find_find(uf, x)
    const ry = union_find_find(uf, y)
    if rx == ry { return false }
    if uf.rank[rx] < uf.rank[ry] {
        uf.parent[rx] = ry
    } else if uf.rank[rx] > uf.rank[ry] {
        uf.parent[ry] = rx
    } else {
        uf.parent[ry] = rx
        uf.rank[rx] = uf.rank[rx] + 1
    }
    uf.count = uf.count - 1
    true
}

func union_find_connected(uf, x, y) {
    union_find_find(uf, x) == union_find_find(uf, y)
}

func union_find_components(uf) { uf.count }

// ════════════════════════════════════════════════════════════════════
// 55. Topological Sort
// ════════════════════════════════════════════════════════════════════

func topological_sort(g) {
    // Kahn's algorithm
    let in_degree = {}
    for node in g.nodes { in_degree[node] = 0 }
    for edge in g.edges {
        in_degree[edge[1]] = in_degree[edge[1]] + 1
    }
    let queue = []
    for node in g.nodes {
        if in_degree[node] == 0 { queue.push(node) }
    }
    let result = []
    while len(queue) > 0 {
        const u = queue[0]
        queue = queue.slice(1)
        result.push(u)
        for edge in g.edges {
            if edge[0] == u {
                in_degree[edge[1]] = in_degree[edge[1]] - 1
                if in_degree[edge[1]] == 0 {
                    queue.push(edge[1])
                }
            }
        }
    }
    if len(result) != len(g.nodes) {
        return {"error": "cycle detected", "partial": result}
    }
    {"order": result}
}

// ════════════════════════════════════════════════════════════════════
// 56. Interval Tree
// ════════════════════════════════════════════════════════════════════

func interval_tree_new() { {"intervals": []} }

func interval_tree_insert(tree, lo, hi, data) {
    tree.intervals.push({"lo": lo, "hi": hi, "data": data})
    // Keep sorted by lo for efficient querying
    tree.intervals.sort((a, b) => a.lo - b.lo)
}

func interval_tree_query(tree, point) {
    let results = []
    for interval in tree.intervals {
        if interval.lo <= point && point <= interval.hi {
            results.push(interval)
        }
        if interval.lo > point { break }
    }
    results
}

func interval_tree_overlap(tree, lo, hi) {
    let results = []
    for interval in tree.intervals {
        if interval.lo <= hi && interval.hi >= lo {
            results.push(interval)
        }
        if interval.lo > hi { break }
    }
    results
}

// ════════════════════════════════════════════════════════════════════
// 57. Leaky Bucket Rate Limiter
// ════════════════════════════════════════════════════════════════════

func leaky_bucket_new(capacity, leak_rate) {
    {"capacity": capacity, "level": 0.0, "leak_rate": leak_rate, "last_time": 0}
}

func leaky_bucket_allow(bucket, now) {
    // Leak accumulated water
    if bucket.last_time > 0 {
        const elapsed = now - bucket.last_time
        bucket.level = bucket.level - elapsed * bucket.leak_rate
        if bucket.level < 0.0 { bucket.level = 0.0 }
    }
    bucket.last_time = now
    if bucket.level + 1.0 <= bucket.capacity {
        bucket.level = bucket.level + 1.0
        true
    } else {
        false
    }
}

// ════════════════════════════════════════════════════════════════════
// 58. Sliding Window Counter
// ════════════════════════════════════════════════════════════════════

func sliding_window_new(window_size, max_count) {
    {"window_size": window_size, "max_count": max_count, "events": []}
}

func sliding_window_allow(sw, now) {
    // Remove expired events
    let new_events = []
    for event in sw.events {
        if now - event < sw.window_size {
            new_events.push(event)
        }
    }
    sw.events = new_events
    if len(sw.events) < sw.max_count {
        sw.events.push(now)
        true
    } else {
        false
    }
}

func sliding_window_count(sw, now) {
    let count = 0
    for event in sw.events {
        if now - event < sw.window_size { count = count + 1 }
    }
    count
}

// ════════════════════════════════════════════════════════════════════
// 59. Skip List (Probabilistic Sorted Data Structure)
// ════════════════════════════════════════════════════════════════════

func skip_list_new(max_level) {
    if max_level == null { max_level = 16 }
    let forward = []
    let i = 0
    while i < max_level { forward.push(null); i = i + 1 }
    {"header": {"key": null, "value": null, "forward": forward}, "level": 0, "max_level": max_level}
}

func skip_list_random_level(sl) {
    let level = 0
    // Approximate coin flip using FNV hash of a counter
    let counter = len(sl.header.forward)
    while level < sl.max_level - 1 {
        counter = (counter * 2654435761) % 2147483647
        if counter % 2 == 0 { break }
        level = level + 1
    }
    level
}

func skip_list_insert(sl, key, value) {
    let update = []
    let i = 0
    while i < sl.max_level { update.push(null); i = i + 1 }

    let current = sl.header
    i = sl.level
    while i >= 0 {
        while current.forward[i] != null && current.forward[i].key < key {
            current = current.forward[i]
        }
        update[i] = current
        i = i - 1
    }

    const new_level = skip_list_random_level(sl)
    if new_level > sl.level {
        i = sl.level + 1
        while i <= new_level {
            update[i] = sl.header
            i = i + 1
        }
        sl.level = new_level
    }

    let forward = []
    i = 0
    while i < sl.max_level { forward.push(null); i = i + 1 }
    const new_node = {"key": key, "value": value, "forward": forward}

    i = 0
    while i <= new_level {
        new_node.forward[i] = update[i].forward[i]
        update[i].forward[i] = new_node
        i = i + 1
    }
}

func skip_list_search(sl, key) {
    let current = sl.header
    let i = sl.level
    while i >= 0 {
        while current.forward[i] != null && current.forward[i].key < key {
            current = current.forward[i]
        }
        i = i - 1
    }
    current = current.forward[0]
    if current != null && current.key == key {
        current.value
    } else {
        null
    }
}

// ════════════════════════════════════════════════════════════════════
// 60. Bit Manipulation Utilities
// ════════════════════════════════════════════════════════════════════

func bit_count_ones(n) {
    let count = 0
    let val = n
    while val > 0 {
        count = count + (val % 2)
        val = int(val / 2)
    }
    count
}

func bit_count_zeros(n, bits) {
    if bits == null { bits = 32 }
    bits - bit_count_ones(n)
}

func bit_is_power_of_two(n) {
    n > 0 && (n % 2 == 0 || n == 1) && bit_count_ones(n) == 1
}

func bit_next_power_of_two(n) {
    let p = 1
    while p < n { p = p * 2 }
    p
}

func bit_leading_zeros(n) {
    if n == 0 { return 32 }
    let count = 0
    let val = n
    let bit = 2147483648 // 2^31
    while bit > 0 {
        if val >= bit { break }
        count = count + 1
        bit = int(bit / 2)
    }
    count
}

func bit_trailing_zeros(n) {
    if n == 0 { return 32 }
    let count = 0
    let val = n
    while val % 2 == 0 {
        count = count + 1
        val = int(val / 2)
    }
    count
}

func bit_reverse(n, bits) {
    if bits == null { bits = 32 }
    let result = 0
    let val = n
    let i = 0
    while i < bits {
        result = result * 2 + (val % 2)
        val = int(val / 2)
        i = i + 1
    }
    result
}

func bit_rotate_left(n, count, bits) {
    if bits == null { bits = 32 }
    const mask = (1 * 2 ** bits) - 1
    ((n * (2 ** count)) + int(n / (2 ** (bits - count)))) % (mask + 1)
}

func bit_rotate_right(n, count, bits) {
    if bits == null { bits = 32 }
    bit_rotate_left(n, bits - count, bits)
}

// ════════════════════════════════════════════════════════════════════
// 61. String Utilities (Additional)
// ════════════════════════════════════════════════════════════════════

// Center a string within a given width.
func string_center(s, width, pad_char) {
    if pad_char == null { pad_char = " " }
    if len(s) >= width { return s }
    const total_pad = width - len(s)
    const left_pad = int(total_pad / 2)
    const right_pad = total_pad - left_pad
    pad_char.repeat(left_pad) + s + pad_char.repeat(right_pad)
}

// Truncate a string with ellipsis.
func string_truncate(s, max_len, suffix) {
    if suffix == null { suffix = "..." }
    if len(s) <= max_len { return s }
    s.substring(0, max_len - len(suffix)) + suffix
}

// Count occurrences of a substring.
func string_count(s, sub) {
    let count = 0
    let pos = 0
    while true {
        const idx = s.index_of(sub, pos)
        if idx < 0 { break }
        count = count + 1
        pos = idx + 1
    }
    count
}

// Capitalize the first letter of each word.
func string_title_case(s) {
    let result = ""
    let capitalize_next = true
    let i = 0
    while i < len(s) {
        const c = s[i]
        if c == " " || c == "\t" || c == "\n" {
            result = result + c
            capitalize_next = true
        } else if capitalize_next {
            result = result + c.to_upper()
            capitalize_next = false
        } else {
            result = result + c.to_lower()
        }
        i = i + 1
    }
    result
}

// Convert to camelCase.
func string_camel_case(s) {
    const parts = s.replace("-", "_").split("_")
    if len(parts) == 0 { return "" }
    let result = parts[0].to_lower()
    let i = 1
    while i < len(parts) {
        const part = parts[i]
        if len(part) > 0 {
            result = result + part[0].to_upper() + part.substring(1).to_lower()
        }
        i = i + 1
    }
    result
}

// Convert to kebab-case.
func string_kebab_case(s) {
    let result = ""
    let i = 0
    let prev_lower = false
    while i < len(s) {
        const c = s[i]
        if c == "_" || c == " " || c == "-" {
            if len(result) > 0 && result[len(result) - 1] != "-" {
                result = result + "-"
            }
            prev_lower = false
        } else if c >= "A" && c <= "Z" {
            if prev_lower && len(result) > 0 && result[len(result) - 1] != "-" {
                result = result + "-"
            }
            result = result + c.to_lower()
            prev_lower = false
        } else {
            result = result + c
            prev_lower = c >= "a" && c <= "z"
        }
        i = i + 1
    }
    result
}

// Check if string is a palindrome.
func string_is_palindrome(s) {
    const clean = s.to_lower()
    let left = 0
    let right = len(clean) - 1
    while left < right {
        if clean[left] != clean[right] { return false }
        left = left + 1
        right = right - 1
    }
    true
}

// Compute the longest common prefix of an array of strings.
func string_longest_common_prefix(strings) {
    if len(strings) == 0 { return "" }
    let prefix = strings[0]
    let i = 1
    while i < len(strings) {
        while !strings[i].starts_with(prefix) {
            prefix = prefix.substring(0, len(prefix) - 1)
            if len(prefix) == 0 { return "" }
        }
        i = i + 1
    }
    prefix
}

// Compute the longest common suffix.
func string_longest_common_suffix(strings) {
    let reversed = strings.map(s => {
        let r = ""
        let i = len(s) - 1
        while i >= 0 { r = r + s[i]; i = i - 1 }
        r
    })
    const lcp = string_longest_common_prefix(reversed)
    let result = ""
    let i = len(lcp) - 1
    while i >= 0 { result = result + lcp[i]; i = i - 1 }
    result
}

// Hamming distance between two equal-length strings.
func string_hamming_distance(a, b) {
    if len(a) != len(b) { return -1 }
    let dist = 0
    let i = 0
    while i < len(a) {
        if a[i] != b[i] { dist = dist + 1 }
        i = i + 1
    }
    dist
}

// ════════════════════════════════════════════════════════════════════
// 62. Statistics Utilities (Extended)
// ════════════════════════════════════════════════════════════════════

func stats_variance(values) {
    if len(values) == 0 { return 0.0 }
    const mean = stats_mean(values)
    let sum_sq = 0.0
    for v in values {
        const diff = v - mean
        sum_sq = sum_sq + diff * diff
    }
    sum_sq / len(values)
}

func stats_std_dev(values) {
    sqrt(stats_variance(values))
}

func stats_mean(values) {
    if len(values) == 0 { return 0.0 }
    let sum = 0.0
    for v in values { sum = sum + v }
    sum / len(values)
}

func stats_median(values) {
    if len(values) == 0 { return 0.0 }
    let sorted = values.slice(0)
    sorted.sort((a, b) => a - b)
    const mid = int(len(sorted) / 2)
    if len(sorted) % 2 == 0 {
        (sorted[mid - 1] + sorted[mid]) / 2.0
    } else {
        sorted[mid]
    }
}

func stats_mode(values) {
    let counts = {}
    for v in values {
        const k = to_string(v)
        if counts.has(k) { counts[k] = counts[k] + 1 }
        else { counts[k] = 1 }
    }
    let max_count = 0
    let mode = null
    for k in counts.keys() {
        if counts[k] > max_count {
            max_count = counts[k]
            mode = k
        }
    }
    mode
}

func stats_percentile(values, p) {
    if len(values) == 0 { return 0.0 }
    let sorted = values.slice(0)
    sorted.sort((a, b) => a - b)
    const idx = p / 100.0 * (len(sorted) - 1)
    const lower = int(idx)
    const upper = lower + 1
    if upper >= len(sorted) { return sorted[lower] }
    const frac = idx - lower
    sorted[lower] * (1.0 - frac) + sorted[upper] * frac
}

func stats_min(values) {
    if len(values) == 0 { return null }
    let m = values[0]
    for v in values { if v < m { m = v } }
    m
}

func stats_max(values) {
    if len(values) == 0 { return null }
    let m = values[0]
    for v in values { if v > m { m = v } }
    m
}

func stats_sum(values) {
    let s = 0.0
    for v in values { s = s + v }
    s
}

func stats_range(values) {
    stats_max(values) - stats_min(values)
}

// ════════════════════════════════════════════════════════════════════
// 63. CSV Writer (Enhanced)
// ════════════════════════════════════════════════════════════════════

func csv_escape(value) {
    const s = to_string(value)
    if s.contains(",") || s.contains("\"") || s.contains("\n") || s.contains("\r") {
        return "\"" + s.replace("\"", "\"\"") + "\""
    }
    s
}

func csv_write_rows(headers, rows, separator) {
    if separator == null { separator = "," }
    let lines = []
    if len(headers) > 0 {
        lines.push(headers.map(h => csv_escape(h)).join(separator))
    }
    for row in rows {
        lines.push(row.map(v => csv_escape(v)).join(separator))
    }
    lines.join("\n") + "\n"
}

func csv_to_maps(headers, rows) {
    let result = []
    for row in rows {
        let entry = {}
        let i = 0
        while i < len(headers) && i < len(row) {
            entry[headers[i]] = row[i]
            i = i + 1
        }
        result.push(entry)
    }
    result
}

// ════════════════════════════════════════════════════════════════════
// 64. TOML Emitter
// ════════════════════════════════════════════════════════════════════

func toml_emit(table) {
    let result = ""
    toml_emit_table(table, "", result)
}

func toml_emit_table(table, prefix, result) {
    let inline_keys = []
    let subtable_keys = []

    for key in table.keys() {
        const val = table[key]
        if typeof(val) == "map" && !val.has("__toml_array") {
            subtable_keys.push(key)
        } else {
            inline_keys.push(key)
        }
    }

    // Emit simple key-value pairs first
    for key in inline_keys {
        result = result + key + " = " + toml_emit_value(table[key]) + "\n"
    }

    // Emit subtables
    for key in subtable_keys {
        const full_key = if len(prefix) > 0 { prefix + "." + key } else { key }
        result = result + "\n[" + full_key + "]\n"
        result = toml_emit_table(table[key], full_key, result)
    }

    result
}

func toml_emit_value(val) {
    if val == null { return "null" }
    const t = typeof(val)
    if t == "string" {
        if val.contains("\n") {
            return "\"\"\"" + val + "\"\"\""
        }
        return "\"" + val.replace("\\", "\\\\").replace("\"", "\\\"") + "\""
    }
    if t == "int" { return to_string(val) }
    if t == "float" {
        const s = to_string(val)
        if !s.contains(".") { return s + ".0" }
        return s
    }
    if t == "bool" { return if val { "true" } else { "false" } }
    if t == "array" {
        const parts = val.map(v => toml_emit_value(v))
        return "[" + parts.join(", ") + "]"
    }
    if t == "map" {
        // Inline table
        let pairs = []
        for k in val.keys() {
            pairs.push(k + " = " + toml_emit_value(val[k]))
        }
        return "{" + pairs.join(", ") + "}"
    }
    to_string(val)
}

// ════════════════════════════════════════════════════════════════════
// 13. Full HTTP/1.1 Parser
// ════════════════════════════════════════════════════════════════════

// Parse an HTTP/1.1 request
func http_parse_request(raw) {
    const lines = raw.split("\r\n")
    if len(lines) == 0 { return {"error": "empty request"} }

    // Request line: METHOD PATH HTTP/1.1
    const request_line = lines[0]
    const parts = request_line.split(" ")
    if len(parts) < 3 {
        return {"error": "malformed request line"}
    }

    const method = parts[0]
    const path = parts[1]
    const version = parts[2]

    // Headers
    let headers = {"__s": true}
    let i = 1
    while i < len(lines) {
        const line = lines[i]
        if line == "" { i = i + 1; break }  // Empty line separates headers from body
        const colon = line.index_of(":")
        if colon > 0 {
            const name = line[0..colon].trim().to_lower()
            const value = line[colon + 1..len(line)].trim()
            if headers.has(name) {
                // Multiple values: append with comma
                headers[name] = headers[name] + ", " + value
            } else {
                headers[name] = value
            }
        }
        i = i + 1
    }

    // Body
    let body = ""
    if i < len(lines) {
        let body_lines = []
        while i < len(lines) {
            body_lines.push(lines[i])
            i = i + 1
        }
        body = body_lines.join("\r\n")
    }

    // Handle chunked transfer encoding
    if headers.has("transfer-encoding") && headers["transfer-encoding"].contains("chunked") {
        body = http_decode_chunked(body)
    }

    {
        "method": method,
        "path": path,
        "version": version,
        "headers": headers,
        "body": body,
    }
}

// Parse an HTTP/1.1 response
func http_parse_response(raw) {
    const lines = raw.split("\r\n")
    if len(lines) == 0 { return {"error": "empty response"} }

    // Status line: HTTP/1.1 200 OK
    const status_line = lines[0]
    const space1 = status_line.index_of(" ")
    if space1 < 0 { return {"error": "malformed status line"} }
    const version = status_line[0..space1]
    const rest = status_line[space1 + 1..len(status_line)]
    const space2 = rest.index_of(" ")
    let status_code = 0
    let status_text = ""
    if space2 > 0 {
        status_code = parse_int(rest[0..space2])
        status_text = rest[space2 + 1..len(rest)]
    } else {
        status_code = parse_int(rest)
    }

    // Headers
    let headers = {"__s": true}
    let i = 1
    while i < len(lines) {
        const line = lines[i]
        if line == "" { i = i + 1; break }
        const colon = line.index_of(":")
        if colon > 0 {
            const name = line[0..colon].trim().to_lower()
            const value = line[colon + 1..len(line)].trim()
            headers[name] = value
        }
        i = i + 1
    }

    // Body
    let body = ""
    if i < len(lines) {
        let body_lines = []
        while i < len(lines) {
            body_lines.push(lines[i])
            i = i + 1
        }
        body = body_lines.join("\r\n")
    }

    // Chunked decoding
    if headers.has("transfer-encoding") && headers["transfer-encoding"].contains("chunked") {
        body = http_decode_chunked(body)
    }

    // Trailers
    let trailers = {"__s": true}
    if headers.has("trailer") {
        const trailer_names = headers["trailer"].split(",").map(t => t.trim().to_lower())
        // Parse trailers from end of chunked body
        const parsed_trailers = http_parse_trailers(raw)
        for name in trailer_names {
            if parsed_trailers.has(name) {
                trailers[name] = parsed_trailers[name]
            }
        }
    }

    {
        "version": version,
        "status_code": status_code,
        "status_text": status_text,
        "headers": headers,
        "body": body,
        "trailers": trailers,
    }
}

// Decode chunked transfer encoding
func http_decode_chunked(data) {
    let result = ""
    let pos = 0
    while pos < len(data) {
        // Read chunk size (hex)
        let size_end = data[pos..len(data)].index_of("\r\n")
        if size_end < 0 { break }
        size_end = pos + size_end
        const size_str = data[pos..size_end].trim()
        // Strip chunk extensions
        const semi = size_str.index_of(";")
        const hex_str = if semi >= 0 { size_str[0..semi] } else { size_str }
        const chunk_size = parse_hex_int(hex_str)
        if chunk_size == 0 { break }  // Last chunk

        pos = size_end + 2  // skip \r\n
        if pos + chunk_size <= len(data) {
            result = result + data[pos..pos + chunk_size]
        }
        pos = pos + chunk_size + 2  // skip chunk data + \r\n
    }
    result
}

func parse_hex_int(s) {
    let result = 0
    let i = 0
    while i < len(s) {
        const c = s[i]
        result = result * 16
        if c >= "0" && c <= "9" { result = result + char_code_at(c, 0) - char_code_at("0", 0) }
        else if c >= "a" && c <= "f" { result = result + char_code_at(c, 0) - char_code_at("a", 0) + 10 }
        else if c >= "A" && c <= "F" { result = result + char_code_at(c, 0) - char_code_at("A", 0) + 10 }
        i = i + 1
    }
    result
}

func http_parse_trailers(raw) {
    let trailers = {"__s": true}
    // Trailers appear after the final "0\r\n" chunk marker
    const last_chunk = raw.index_of("0\r\n")
    if last_chunk < 0 { return trailers }
    const after = raw[last_chunk + 3..len(raw)]
    const lines = after.split("\r\n")
    for line in lines {
        if line == "" { continue }
        const colon = line.index_of(":")
        if colon > 0 {
            const name = line[0..colon].trim().to_lower()
            const value = line[colon + 1..len(line)].trim()
            trailers[name] = value
        }
    }
    trailers
}

// Build an HTTP/1.1 request string
func http_build_request(method, path, headers, body) {
    let req = f"{method} {path} HTTP/1.1\r\n"
    for name in headers.keys() {
        if name == "__s" { continue }
        req = req + f"{name}: {headers[name]}\r\n"
    }
    if body != null && len(body) > 0 {
        if !headers.has("content-length") {
            req = req + f"Content-Length: {len(body)}\r\n"
        }
    }
    req = req + "\r\n"
    if body != null { req = req + body }
    req
}

// Keep-alive connection pooling state
let http_conn_pool = {"__s": true}  // host:port -> [conn_info]

func http_get_connection(host, port) {
    const key = f"{host}:{port}"
    if http_conn_pool.has(key) {
        const pool = http_conn_pool[key]
        if len(pool) > 0 {
            return pool.pop()
        }
    }
    null  // No pooled connection available
}

func http_return_connection(host, port, conn) {
    const key = f"{host}:{port}"
    if !http_conn_pool.has(key) {
        http_conn_pool[key] = []
    }
    const pool = http_conn_pool[key]
    if len(pool) < 6 {  // Max pool size per host
        pool.push(conn)
    }
    // else: discard (pool full)
}

// ════════════════════════════════════════════════════════════════════
// 14. Full WebSocket Frame Parser
// ════════════════════════════════════════════════════════════════════

const WS_OPCODE_CONTINUATION = 0x0
const WS_OPCODE_TEXT = 0x1
const WS_OPCODE_BINARY = 0x2
const WS_OPCODE_CLOSE = 0x8
const WS_OPCODE_PING = 0x9
const WS_OPCODE_PONG = 0xA

func ws_parse_frame(data) {
    if len(data) < 2 { return {"error": "frame too short"} }

    const byte0 = char_code_at(data, 0)
    const byte1 = char_code_at(data, 1)

    const fin = (byte0 & 0x80) != 0
    const rsv1 = (byte0 & 0x40) != 0
    const rsv2 = (byte0 & 0x20) != 0
    const rsv3 = (byte0 & 0x10) != 0
    const opcode = byte0 & 0x0F

    const masked = (byte1 & 0x80) != 0
    let payload_len = byte1 & 0x7F
    let offset = 2

    if payload_len == 126 {
        if len(data) < 4 { return {"error": "incomplete frame"} }
        payload_len = char_code_at(data, 2) * 256 + char_code_at(data, 3)
        offset = 4
    } else if payload_len == 127 {
        if len(data) < 10 { return {"error": "incomplete frame"} }
        payload_len = 0
        let j = 0
        while j < 8 {
            payload_len = payload_len * 256 + char_code_at(data, 2 + j)
            j = j + 1
        }
        offset = 10
    }

    let mask_key = null
    if masked {
        if len(data) < offset + 4 { return {"error": "incomplete mask"} }
        mask_key = [
            char_code_at(data, offset),
            char_code_at(data, offset + 1),
            char_code_at(data, offset + 2),
            char_code_at(data, offset + 3),
        ]
        offset = offset + 4
    }

    if len(data) < offset + payload_len { return {"error": "incomplete payload"} }

    let payload = ""
    let k = 0
    while k < payload_len {
        let byte = char_code_at(data, offset + k)
        if masked {
            byte = byte ^ mask_key[k % 4]
        }
        payload = payload + char_from_code(byte)
        k = k + 1
    }

    {
        "fin": fin,
        "opcode": opcode,
        "masked": masked,
        "payload_length": payload_len,
        "payload": payload,
        "rsv1": rsv1,
        "rsv2": rsv2,
        "rsv3": rsv3,
        "total_length": offset + payload_len,
    }
}

func ws_build_frame(opcode, payload, mask) {
    let frame = ""
    const fin_bit = 0x80
    frame = frame + char_from_code(fin_bit + opcode)

    const plen = len(payload)
    const mask_bit = if mask { 0x80 } else { 0 }

    if plen < 126 {
        frame = frame + char_from_code(mask_bit + plen)
    } else if plen < 65536 {
        frame = frame + char_from_code(mask_bit + 126)
        frame = frame + char_from_code(int(plen / 256))
        frame = frame + char_from_code(plen % 256)
    } else {
        frame = frame + char_from_code(mask_bit + 127)
        let remaining = plen
        let j = 7
        let bytes = [0, 0, 0, 0, 0, 0, 0, 0]
        while j >= 0 {
            bytes[j] = remaining % 256
            remaining = int(remaining / 256)
            j = j - 1
        }
        for b in bytes { frame = frame + char_from_code(b) }
    }

    if mask {
        // Generate random mask key
        const mask_key = [
            secure_random_int(0, 256), secure_random_int(0, 256),
            secure_random_int(0, 256), secure_random_int(0, 256),
        ]
        for mk in mask_key { frame = frame + char_from_code(mk) }
        let k = 0
        while k < plen {
            const byte = char_code_at(payload, k) ^ mask_key[k % 4]
            frame = frame + char_from_code(byte)
            k = k + 1
        }
    } else {
        frame = frame + payload
    }
    frame
}

func ws_build_close_frame(code, reason) {
    let payload = char_from_code(int(code / 256)) + char_from_code(code % 256)
    if reason != null { payload = payload + reason }
    ws_build_frame(WS_OPCODE_CLOSE, payload, true)
}

// ════════════════════════════════════════════════════════════════════
// 15. Full MIME Multipart Parser
// ════════════════════════════════════════════════════════════════════

func mime_parse_multipart(data, boundary) {
    let parts = []
    const delimiter = "--" + boundary
    const end_delimiter = delimiter + "--"

    const sections = data.split(delimiter)

    for section in sections {
        const trimmed = section.trim()
        if trimmed == "" || trimmed == "--" { continue }
        // Strip leading \r\n
        let s = trimmed
        if s.starts_with("\r\n") { s = s[2..len(s)] }
        // Strip trailing -- (end marker)
        if s.ends_with("--") { s = s[0..len(s) - 2] }

        // Split headers from body
        const sep = s.index_of("\r\n\r\n")
        if sep < 0 { continue }

        const header_text = s[0..sep]
        const body = s[sep + 4..len(s)]

        // Parse headers
        let headers = {"__s": true}
        const header_lines = header_text.split("\r\n")
        for hl in header_lines {
            const colon = hl.index_of(":")
            if colon > 0 {
                const name = hl[0..colon].trim().to_lower()
                const value = hl[colon + 1..len(hl)].trim()
                headers[name] = value
            }
        }

        // Extract content-disposition params
        let name = null
        let filename = null
        if headers.has("content-disposition") {
            const cd = headers["content-disposition"]
            name = mime_extract_param(cd, "name")
            filename = mime_extract_param(cd, "filename")
        }

        parts.push({
            "headers": headers,
            "body": body,
            "name": name,
            "filename": filename,
            "content_type": if headers.has("content-type") { headers["content-type"] } else { "text/plain" },
        })
    }
    parts
}

func mime_extract_param(header, param_name) {
    const search = param_name + "=\""
    const idx = header.index_of(search)
    if idx < 0 {
        // Try without quotes
        const search2 = param_name + "="
        const idx2 = header.index_of(search2)
        if idx2 < 0 { return null }
        const start = idx2 + len(search2)
        const semi = header[start..len(header)].index_of(";")
        if semi >= 0 { return header[start..start + semi].trim() }
        return header[start..len(header)].trim()
    }
    const start = idx + len(search)
    const end_q = header[start..len(header)].index_of("\"")
    if end_q < 0 { return null }
    header[start..start + end_q]
}

func mime_build_multipart(parts, boundary) {
    let body = ""
    for part in parts {
        body = body + "--" + boundary + "\r\n"
        // Content-Disposition
        let cd = "Content-Disposition: form-data"
        if part.has("name") { cd = cd + f"; name=\"{part[\"name\"]}\"" }
        if part.has("filename") { cd = cd + f"; filename=\"{part[\"filename\"]}\"" }
        body = body + cd + "\r\n"
        if part.has("content_type") {
            body = body + f"Content-Type: {part[\"content_type\"]}\r\n"
        }
        body = body + "\r\n"
        body = body + part["body"] + "\r\n"
    }
    body = body + "--" + boundary + "--\r\n"
    body
}

// ════════════════════════════════════════════════════════════════════
// 16. INI File Parser
// ════════════════════════════════════════════════════════════════════

func ini_parse(text) {
    let result = {"__s": true}
    let current_section = "__default"
    result[current_section] = {"__s": true}

    const lines = text.split("\n")
    for line in lines {
        const trimmed = line.trim()
        if len(trimmed) == 0 { continue }
        if trimmed[0] == ";" || trimmed[0] == "#" { continue }

        // Section header: [section]
        if trimmed[0] == "[" {
            const close = trimmed.index_of("]")
            if close > 1 {
                current_section = trimmed[1..close].trim()
                if !result.has(current_section) {
                    result[current_section] = {"__s": true}
                }
            }
            continue
        }

        // Key = value
        const eq = trimmed.index_of("=")
        if eq > 0 {
            const key = trimmed[0..eq].trim()
            let value = trimmed[eq + 1..len(trimmed)].trim()
            // Strip inline comments
            const semi = value.index_of(";")
            if semi > 0 { value = value[0..semi].trim() }
            const hash = value.index_of("#")
            if hash > 0 { value = value[0..hash].trim() }
            // Strip quotes
            if len(value) >= 2 && value[0] == "\"" && value[len(value) - 1] == "\"" {
                value = value[1..len(value) - 1]
            }
            result[current_section][key] = value
        }
    }
    result
}

func ini_emit(data) {
    let result = ""
    for section in data.keys() {
        if section == "__s" { continue }
        if section != "__default" {
            result = result + f"[{section}]\n"
        }
        const entries = data[section]
        for key in entries.keys() {
            if key == "__s" { continue }
            const value = entries[key]
            result = result + f"{key} = {value}\n"
        }
        result = result + "\n"
    }
    result
}

// ════════════════════════════════════════════════════════════════════
// 17. Properties File Parser
// ════════════════════════════════════════════════════════════════════

func properties_parse(text) {
    let result = {"__s": true}
    const lines = text.split("\n")
    for line in lines {
        const trimmed = line.trim()
        if len(trimmed) == 0 { continue }
        if trimmed[0] == "#" || trimmed[0] == "!" { continue }

        // Handle continuation lines (ending with \)
        let full_line = trimmed
        // Key=value or key:value or key value
        let sep = full_line.index_of("=")
        if sep < 0 { sep = full_line.index_of(":") }
        if sep < 0 {
            // Space separator
            sep = full_line.index_of(" ")
        }
        if sep > 0 {
            const key = full_line[0..sep].trim()
            const value = full_line[sep + 1..len(full_line)].trim()
            result[key] = properties_unescape(value)
        }
    }
    result
}

func properties_unescape(s) {
    s.replace("\\n", "\n").replace("\\t", "\t").replace("\\\\", "\\").replace("\\=", "=").replace("\\:", ":")
}

func properties_emit(data) {
    let result = ""
    for key in data.keys() {
        if key == "__s" { continue }
        const value = data[key]
        const escaped = value.replace("\\", "\\\\").replace("\n", "\\n").replace("\t", "\\t")
        result = result + f"{key}={escaped}\n"
    }
    result
}

// ════════════════════════════════════════════════════════════════════
// 18. Full Glob with Brace Expansion
// ════════════════════════════════════════════════════════════════════

func glob_expand_braces(pattern) {
    const brace_start = pattern.index_of("{")
    if brace_start < 0 { return [pattern] }

    // Find matching close brace
    let depth = 0
    let brace_end = -1
    let i = brace_start
    while i < len(pattern) {
        if pattern[i] == "{" { depth = depth + 1 }
        if pattern[i] == "}" {
            depth = depth - 1
            if depth == 0 { brace_end = i; break }
        }
        i = i + 1
    }
    if brace_end < 0 { return [pattern] }

    const prefix = pattern[0..brace_start]
    const suffix = pattern[brace_end + 1..len(pattern)]
    const alternatives_str = pattern[brace_start + 1..brace_end]

    // Split by comma (respecting nested braces)
    let alternatives = []
    let current = ""
    depth = 0
    i = 0
    while i < len(alternatives_str) {
        const c = alternatives_str[i]
        if c == "{" { depth = depth + 1; current = current + c }
        else if c == "}" { depth = depth - 1; current = current + c }
        else if c == "," && depth == 0 {
            alternatives.push(current)
            current = ""
        } else {
            current = current + c
        }
        i = i + 1
    }
    alternatives.push(current)

    // Recursively expand each alternative
    let results = []
    for alt in alternatives {
        const expanded = glob_expand_braces(prefix + alt + suffix)
        for e in expanded { results.push(e) }
    }
    results
}

func glob_match_extended(pattern, text) {
    // First expand braces
    const patterns = glob_expand_braces(pattern)
    for p in patterns {
        if glob_match_single(p, text) { return true }
    }
    false
}

func glob_match_single(pattern, text) {
    let pi = 0
    let ti = 0
    let star_pi = -1
    let star_ti = -1

    while ti < len(text) {
        if pi < len(pattern) && (pattern[pi] == text[ti] || pattern[pi] == "?") {
            pi = pi + 1
            ti = ti + 1
        } else if pi < len(pattern) && pattern[pi] == "*" {
            if pi + 1 < len(pattern) && pattern[pi + 1] == "*" {
                // ** matches across directories
                pi = pi + 2
                if pi < len(pattern) && pattern[pi] == "/" { pi = pi + 1 }
                star_pi = pi
                star_ti = ti
            } else {
                // * matches within single directory (no /)
                star_pi = pi
                star_ti = ti + 1
                pi = pi + 1
            }
        } else if pi < len(pattern) && pattern[pi] == "[" {
            // Character class [abc] or [a-z]
            const match_result = glob_match_char_class(pattern, pi, text[ti])
            if match_result["matched"] {
                pi = match_result["end_pos"]
                ti = ti + 1
            } else if star_pi >= 0 {
                pi = star_pi
                ti = star_ti
                star_ti = star_ti + 1
            } else {
                return false
            }
        } else if star_pi >= 0 {
            pi = star_pi
            ti = star_ti
            star_ti = star_ti + 1
        } else {
            return false
        }
    }

    while pi < len(pattern) && pattern[pi] == "*" { pi = pi + 1 }
    pi == len(pattern)
}

func glob_match_char_class(pattern, start, c) {
    let i = start + 1  // skip [
    let negate = false
    if i < len(pattern) && (pattern[i] == "!" || pattern[i] == "^") {
        negate = true
        i = i + 1
    }

    let matched = false
    while i < len(pattern) && pattern[i] != "]" {
        if i + 2 < len(pattern) && pattern[i + 1] == "-" {
            // Range: a-z
            const lo = pattern[i]
            const hi = pattern[i + 2]
            if c >= lo && c <= hi { matched = true }
            i = i + 3
        } else {
            if pattern[i] == c { matched = true }
            i = i + 1
        }
    }

    if i < len(pattern) { i = i + 1 }  // skip ]
    if negate { matched = !matched }
    {"matched": matched, "end_pos": i}
}

// ════════════════════════════════════════════════════════════════════
// 19. Full Diff with Patience Algorithm
// ════════════════════════════════════════════════════════════════════

func diff_patience(a_lines, b_lines) {
    // Find unique common lines
    let a_unique = {"__s": true}
    let b_unique = {"__s": true}

    // Count occurrences in A
    let ai = 0
    for line in a_lines {
        if a_unique.has(line) {
            a_unique[line] = -1  // Not unique
        } else {
            a_unique[line] = ai
        }
        ai = ai + 1
    }

    // Count occurrences in B
    let bi = 0
    for line in b_lines {
        if b_unique.has(line) {
            b_unique[line] = -1  // Not unique
        } else {
            b_unique[line] = bi
        }
        bi = bi + 1
    }

    // Find unique common lines
    let common = []
    for line in a_unique.keys() {
        if line == "__s" { continue }
        if a_unique[line] >= 0 && b_unique.has(line) && b_unique[line] >= 0 {
            common.push({"line": line, "a_idx": a_unique[line], "b_idx": b_unique[line]})
        }
    }

    // Sort by position in A
    common = sort_by(common, c => c["a_idx"])

    // Find longest increasing subsequence of B indices (patience sorting)
    const lis = diff_lis(common.map(c => c["b_idx"]))

    // Build diff from LIS anchors
    let anchors = []
    for idx in lis {
        anchors.push(common[idx])
    }

    // Generate hunks between anchors
    let hunks = []
    let a_pos = 0
    let b_pos = 0

    for anchor in anchors {
        // Lines before anchor
        if a_pos < anchor["a_idx"] || b_pos < anchor["b_idx"] {
            const hunk = diff_build_hunk(a_lines, b_lines, a_pos, anchor["a_idx"], b_pos, anchor["b_idx"])
            if hunk != null { hunks.push(hunk) }
        }
        a_pos = anchor["a_idx"] + 1
        b_pos = anchor["b_idx"] + 1
    }

    // Lines after last anchor
    if a_pos < len(a_lines) || b_pos < len(b_lines) {
        const hunk = diff_build_hunk(a_lines, b_lines, a_pos, len(a_lines), b_pos, len(b_lines))
        if hunk != null { hunks.push(hunk) }
    }

    hunks
}

func diff_lis(arr) {
    // Longest increasing subsequence using patience sorting
    if len(arr) == 0 { return [] }
    let piles = []
    let indices = []

    let i = 0
    for val in arr {
        // Binary search for leftmost pile with top >= val
        let lo = 0
        let hi = len(piles)
        while lo < hi {
            const mid = int((lo + hi) / 2)
            if piles[mid] < val { lo = mid + 1 } else { hi = mid }
        }
        if lo == len(piles) {
            piles.push(val)
            indices.push(i)
        } else {
            piles[lo] = val
            indices[lo] = i
        }
        i = i + 1
    }

    indices
}

func diff_build_hunk(a, b, a_start, a_end, b_start, b_end) {
    let lines = []
    let ai = a_start
    let bj = b_start

    while ai < a_end {
        lines.push({"op": "-", "line": a[ai]})
        ai = ai + 1
    }
    while bj < b_end {
        lines.push({"op": "+", "line": b[bj]})
        bj = bj + 1
    }

    if len(lines) == 0 { return null }
    {"a_start": a_start, "a_end": a_end, "b_start": b_start, "b_end": b_end, "lines": lines}
}

func diff_format_unified(hunks, a_name, b_name) {
    let output = f"--- {a_name}\n+++ {b_name}\n"
    for hunk in hunks {
        const a_count = hunk["a_end"] - hunk["a_start"]
        const b_count = hunk["b_end"] - hunk["b_start"]
        output = output + f"@@ -{hunk[\"a_start\"] + 1},{a_count} +{hunk[\"b_start\"] + 1},{b_count} @@\n"
        for line in hunk["lines"] {
            output = output + line["op"] + line["line"] + "\n"
        }
    }
    output
}

// ════════════════════════════════════════════════════════════════════
// 20. Binary Search Tree
// ════════════════════════════════════════════════════════════════════

func bst_new() { null }

func bst_node(key, value, left, right) {
    {"key": key, "value": value, "left": left, "right": right}
}

func bst_insert(node, key, value) {
    if node == null { return bst_node(key, value, null, null) }
    if key < node["key"] {
        return bst_node(node["key"], node["value"], bst_insert(node["left"], key, value), node["right"])
    }
    if key > node["key"] {
        return bst_node(node["key"], node["value"], node["left"], bst_insert(node["right"], key, value))
    }
    // Equal: update value
    bst_node(key, value, node["left"], node["right"])
}

func bst_find(node, key) {
    if node == null { return null }
    if key < node["key"] { return bst_find(node["left"], key) }
    if key > node["key"] { return bst_find(node["right"], key) }
    node["value"]
}

func bst_delete(node, key) {
    if node == null { return null }
    if key < node["key"] {
        return bst_node(node["key"], node["value"], bst_delete(node["left"], key), node["right"])
    }
    if key > node["key"] {
        return bst_node(node["key"], node["value"], node["left"], bst_delete(node["right"], key))
    }
    // Found: delete this node
    if node["left"] == null { return node["right"] }
    if node["right"] == null { return node["left"] }
    // Two children: replace with in-order successor
    const succ = bst_min_node(node["right"])
    bst_node(succ["key"], succ["value"], node["left"], bst_delete(node["right"], succ["key"]))
}

func bst_min_node(node) {
    if node["left"] == null { return node }
    bst_min_node(node["left"])
}

func bst_inorder(node) {
    if node == null { return [] }
    const left = bst_inorder(node["left"])
    const right = bst_inorder(node["right"])
    left + [{"key": node["key"], "value": node["value"]}] + right
}

func bst_size(node) {
    if node == null { return 0 }
    1 + bst_size(node["left"]) + bst_size(node["right"])
}

func bst_height(node) {
    if node == null { return 0 }
    const lh = bst_height(node["left"])
    const rh = bst_height(node["right"])
    1 + max(lh, rh)
}

// ════════════════════════════════════════════════════════════════════
// 21. AVL Tree
// ════════════════════════════════════════════════════════════════════

func avl_node(key, value, left, right, height) {
    {"key": key, "value": value, "left": left, "right": right, "height": height}
}

func avl_height(node) {
    if node == null { return 0 }
    node["height"]
}

func avl_balance_factor(node) {
    if node == null { return 0 }
    avl_height(node["left"]) - avl_height(node["right"])
}

func avl_update_height(node) {
    if node == null { return null }
    const h = 1 + max(avl_height(node["left"]), avl_height(node["right"]))
    avl_node(node["key"], node["value"], node["left"], node["right"], h)
}

func avl_rotate_right(y) {
    const x = y["left"]
    const t = x["right"]
    const new_y = avl_update_height(avl_node(y["key"], y["value"], t, y["right"], 0))
    avl_update_height(avl_node(x["key"], x["value"], x["left"], new_y, 0))
}

func avl_rotate_left(x) {
    const y = x["right"]
    const t = y["left"]
    const new_x = avl_update_height(avl_node(x["key"], x["value"], x["left"], t, 0))
    avl_update_height(avl_node(y["key"], y["value"], new_x, y["right"], 0))
}

func avl_balance(node) {
    if node == null { return null }
    const node_upd = avl_update_height(node)
    const bf = avl_balance_factor(node_upd)

    // Left heavy
    if bf > 1 {
        if avl_balance_factor(node_upd["left"]) < 0 {
            // Left-Right case
            const new_left = avl_rotate_left(node_upd["left"])
            return avl_rotate_right(avl_node(node_upd["key"], node_upd["value"], new_left, node_upd["right"], node_upd["height"]))
        }
        return avl_rotate_right(node_upd)
    }

    // Right heavy
    if bf < -1 {
        if avl_balance_factor(node_upd["right"]) > 0 {
            // Right-Left case
            const new_right = avl_rotate_right(node_upd["right"])
            return avl_rotate_left(avl_node(node_upd["key"], node_upd["value"], node_upd["left"], new_right, node_upd["height"]))
        }
        return avl_rotate_left(node_upd)
    }

    node_upd
}

func avl_insert(node, key, value) {
    if node == null { return avl_node(key, value, null, null, 1) }
    if key < node["key"] {
        const new_left = avl_insert(node["left"], key, value)
        return avl_balance(avl_node(node["key"], node["value"], new_left, node["right"], node["height"]))
    }
    if key > node["key"] {
        const new_right = avl_insert(node["right"], key, value)
        return avl_balance(avl_node(node["key"], node["value"], node["left"], new_right, node["height"]))
    }
    avl_node(key, value, node["left"], node["right"], node["height"])
}

func avl_find(node, key) {
    bst_find(node, key)  // Same traversal as BST
}

func avl_delete(node, key) {
    if node == null { return null }
    if key < node["key"] {
        const new_left = avl_delete(node["left"], key)
        return avl_balance(avl_node(node["key"], node["value"], new_left, node["right"], node["height"]))
    }
    if key > node["key"] {
        const new_right = avl_delete(node["right"], key)
        return avl_balance(avl_node(node["key"], node["value"], node["left"], new_right, node["height"]))
    }
    if node["left"] == null { return node["right"] }
    if node["right"] == null { return node["left"] }
    const succ = bst_min_node(node["right"])
    const new_right = avl_delete(node["right"], succ["key"])
    avl_balance(avl_node(succ["key"], succ["value"], node["left"], new_right, 0))
}

// ════════════════════════════════════════════════════════════════════
// 22. Red-Black Tree Fundamentals
// ════════════════════════════════════════════════════════════════════

const RB_RED = 0
const RB_BLACK = 1

func rb_node(key, value, color, left, right, parent) {
    {"key": key, "value": value, "color": color, "left": left, "right": right, "parent": parent}
}

func rb_new() {
    {"root": null, "size": 0}
}

func rb_is_red(node) {
    node != null && node["color"] == RB_RED
}

func rb_insert(tree, key, value) {
    // Standard BST insert
    let new_node = rb_node(key, value, RB_RED, null, null, null)

    if tree["root"] == null {
        new_node["color"] = RB_BLACK
        return {"root": new_node, "size": 1}
    }

    // Insert as in BST
    let current = tree["root"]
    let parent = null
    while current != null {
        parent = current
        if key < current["key"] {
            current = current["left"]
        } else if key > current["key"] {
            current = current["right"]
        } else {
            // Update existing
            current["value"] = value
            return tree
        }
    }

    new_node["parent"] = parent
    if key < parent["key"] {
        parent["left"] = new_node
    } else {
        parent["right"] = new_node
    }

    // Fix red-black violations
    const fixed_root = rb_fix_insert(tree["root"], new_node)
    fixed_root["color"] = RB_BLACK
    {"root": fixed_root, "size": tree["size"] + 1}
}

func rb_fix_insert(root, node) {
    // Simplified fix-up: ensure root is black
    if node == null { return root }
    let current = node
    // Walk up to root and fix colors
    while current != null && current["parent"] != null && rb_is_red(current["parent"]) {
        const parent = current["parent"]
        const grandparent = parent["parent"]
        if grandparent == null { break }

        if parent == grandparent["left"] {
            const uncle = grandparent["right"]
            if rb_is_red(uncle) {
                // Case 1: Uncle is red
                parent["color"] = RB_BLACK
                uncle["color"] = RB_BLACK
                grandparent["color"] = RB_RED
                current = grandparent
            } else {
                if current == parent["right"] {
                    // Case 2: Triangle
                    current = parent
                    // Would rotate left here
                }
                // Case 3: Line
                parent["color"] = RB_BLACK
                grandparent["color"] = RB_RED
                // Would rotate right here
                break
            }
        } else {
            const uncle = grandparent["left"]
            if rb_is_red(uncle) {
                parent["color"] = RB_BLACK
                uncle["color"] = RB_BLACK
                grandparent["color"] = RB_RED
                current = grandparent
            } else {
                if current == parent["left"] {
                    current = parent
                }
                parent["color"] = RB_BLACK
                grandparent["color"] = RB_RED
                break
            }
        }
    }
    root
}

func rb_find(tree, key) {
    bst_find(tree["root"], key)
}

func rb_inorder(tree) {
    bst_inorder(tree["root"])
}

func rb_size(tree) {
    tree["size"]
}
