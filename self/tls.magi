// MAGI Self-Hosted Compiler — TLS/Crypto Wrapper
//
// All TLS and cryptographic operations delegate to stage 0 builtins.
// This module provides a clean MAGI-level API for:
//   - TLS configuration (client and server)
//   - Certificate generation and parsing
//   - Symmetric encryption (AES-GCM)
//   - Asymmetric encryption (RSA, ECDSA)
//   - Hashing (SHA-256, SHA-384, SHA-512, BLAKE3)
//   - HMAC computation
//   - Key derivation (PBKDF2, HKDF)
//   - Random number generation (CSPRNG)
//   - Base64 encoding/decoding
//   - Hex encoding/decoding
//   - JWT token creation and verification

// ══════════════════════════════════════════════════════════════════
// ── TLS Configuration ───────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

// Create a TLS configuration for a server
func tls_server_config(cert_path, key_path) {
    {
        "__tls_config": true,
        "mode": "server",
        "cert_path": cert_path,
        "key_path": key_path,
        "min_protocol": "TLS1.2",
        "max_protocol": "TLS1.3",
        "cipher_suites": [
            "TLS_AES_256_GCM_SHA384",
            "TLS_AES_128_GCM_SHA256",
            "TLS_CHACHA20_POLY1305_SHA256"
        ],
        "alpn_protocols": ["h2", "http/1.1"],
        "client_auth": "none",
    }
}

// Create a TLS configuration for a client
func tls_client_config(ca_cert_path) {
    {
        "__tls_config": true,
        "mode": "client",
        "ca_cert_path": ca_cert_path,
        "min_protocol": "TLS1.2",
        "max_protocol": "TLS1.3",
        "verify_hostname": true,
        "verify_cert": true,
        "alpn_protocols": ["h2", "http/1.1"],
    }
}

// Set minimum TLS protocol version
func tls_set_min_protocol(config, version) {
    config["min_protocol"] = version
    config
}

// Set maximum TLS protocol version
func tls_set_max_protocol(config, version) {
    config["max_protocol"] = version
    config
}

// Enable or disable hostname verification
func tls_set_verify_hostname(config, verify) {
    config["verify_hostname"] = verify
    config
}

// Set ALPN protocols
func tls_set_alpn(config, protocols) {
    config["alpn_protocols"] = protocols
    config
}

// Set client certificate authentication mode
func tls_set_client_auth(config, mode) {
    // mode: "none", "optional", "required"
    config["client_auth"] = mode
    config
}

// Load a TLS configuration into the runtime
func tls_load_config(config) {
    tls_configure(config)
}

// ══════════════════════════════════════════════════════════════════
// ── Certificate Operations ──────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

// Generate a self-signed certificate
func tls_generate_self_signed(common_name, days) {
    cert_generate(common_name, days)
}

// Parse a PEM-encoded certificate
func tls_parse_cert(pem_data) {
    cert_parse(pem_data)
}

// Verify a certificate against a CA
func tls_verify_cert(cert_pem, ca_pem) {
    cert_verify(cert_pem, ca_pem)
}

// Get certificate information (subject, issuer, validity, etc.)
func tls_cert_info(cert_pem) {
    const parsed = cert_parse(cert_pem)
    if parsed == null { return null }
    {
        "subject": if parsed.has("subject") { parsed["subject"] } else { "" },
        "issuer": if parsed.has("issuer") { parsed["issuer"] } else { "" },
        "not_before": if parsed.has("not_before") { parsed["not_before"] } else { "" },
        "not_after": if parsed.has("not_after") { parsed["not_after"] } else { "" },
        "serial": if parsed.has("serial") { parsed["serial"] } else { "" },
        "fingerprint_sha256": if parsed.has("fingerprint_sha256") { parsed["fingerprint_sha256"] } else { "" },
    }
}

// Check if a certificate is expired
func tls_cert_is_expired(cert_info) {
    if cert_info == null { return true }
    // Would need time comparison; delegate to stage 0
    false
}

// Generate a certificate signing request (CSR)
func tls_generate_csr(common_name, org, country) {
    cert_generate_csr(common_name, org, country)
}

// ══════════════════════════════════════════════════════════════════
// ── Hashing ─────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_sha256(data) { sha256(data) }
func tls_sha384(data) { sha384(data) }
func tls_sha512(data) { sha512(data) }
func tls_md5(data) { md5(data) }
func tls_blake3(data) { blake3(data) }

// Hash with a specified algorithm
func tls_hash(data, algorithm) {
    match algorithm {
        "sha256" => sha256(data),
        "sha384" => sha384(data),
        "sha512" => sha512(data),
        "md5" => md5(data),
        "blake3" => blake3(data),
        _ => panic(f"unknown hash algorithm: {algorithm}")
    }
}

// Hash a file
func tls_hash_file(path, algorithm) {
    const data = read_file(path)
    tls_hash(data, algorithm)
}

// Verify a hash
func tls_verify_hash(data, expected_hash, algorithm) {
    const actual = tls_hash(data, algorithm)
    actual == expected_hash
}

// ══════════════════════════════════════════════════════════════════
// ── HMAC ────────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_hmac_sha256(key, data) { hmac(key, data, "sha256") }
func tls_hmac_sha512(key, data) { hmac(key, data, "sha512") }

func tls_hmac(key, data, algorithm) {
    hmac(key, data, algorithm)
}

func tls_hmac_verify(key, data, expected_mac, algorithm) {
    const actual = tls_hmac(key, data, algorithm)
    // Constant-time comparison
    tls_constant_time_eq(actual, expected_mac)
}

// ══════════════════════════════════════════════════════════════════
// ── Key Derivation ──────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_pbkdf2(password, salt, iterations, key_length) {
    pbkdf2(password, salt, iterations, key_length)
}

func tls_hkdf(input_key, salt, info, length) {
    hkdf(input_key, salt, info, length)
}

// ══════════════════════════════════════════════════════════════════
// ── Symmetric Encryption (AES-GCM) ─────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_aes_gcm_encrypt(key, plaintext, aad) {
    aes_gcm_encrypt(key, plaintext, aad)
}

func tls_aes_gcm_decrypt(key, ciphertext, aad) {
    aes_gcm_decrypt(key, ciphertext, aad)
}

// Generate a random AES key (256-bit)
func tls_generate_aes_key() {
    random_bytes(32)
}

// Generate a random nonce (96-bit for AES-GCM)
func tls_generate_nonce() {
    random_bytes(12)
}

// ══════════════════════════════════════════════════════════════════
// ── Random Number Generation (CSPRNG) ───────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_random_bytes(n) { random_bytes(n) }
func tls_random_int(min_val, max_val) { random_int(min_val, max_val) }
func tls_random_float() { random_float() }

func tls_uuid_v4() { uuid() }

// Generate a random token (hex string)
func tls_random_token(byte_count) {
    const bytes = random_bytes(byte_count)
    tls_bytes_to_hex(bytes)
}

// ══════════════════════════════════════════════════════════════════
// ── Base64 Encoding/Decoding ────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_base64_encode(data) { base64_encode(data) }
func tls_base64_decode(data) { base64_decode(data) }

// URL-safe Base64
func tls_base64url_encode(data) {
    let encoded = base64_encode(data)
    encoded = encoded.replace("+", "-")
    encoded = encoded.replace("/", "_")
    // Remove padding
    while len(encoded) > 0 && encoded[len(encoded) - 1] == "=" {
        encoded = encoded.substring(0, len(encoded) - 1)
    }
    encoded
}

func tls_base64url_decode(data) {
    let padded = data.replace("-", "+").replace("_", "/")
    // Add padding
    while len(padded) % 4 != 0 { padded = padded + "=" }
    base64_decode(padded)
}

// ══════════════════════════════════════════════════════════════════
// ── Hex Encoding/Decoding ───────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_bytes_to_hex(bytes) {
    const hex_chars = "0123456789abcdef"
    let result = ""
    if typeof(bytes) == "array" {
        for b in bytes {
            result = result + hex_chars[b / 16] + hex_chars[b % 16]
        }
    } else if typeof(bytes) == "string" {
        for c in bytes.chars() {
            const code = char_code(c)
            result = result + hex_chars[code / 16] + hex_chars[code % 16]
        }
    }
    result
}

func tls_hex_to_bytes(hex_str) {
    let result = []
    let i = 0
    while i < len(hex_str) - 1 {
        const high = tls_hex_char_val(hex_str[i])
        const low = tls_hex_char_val(hex_str[i + 1])
        result.push(high * 16 + low)
        i = i + 2
    }
    result
}

func tls_hex_char_val(c) {
    if c >= "0" && c <= "9" { return char_code(c) - char_code("0") }
    if c >= "a" && c <= "f" { return 10 + char_code(c) - char_code("a") }
    if c >= "A" && c <= "F" { return 10 + char_code(c) - char_code("A") }
    0
}

// ══════════════════════════════════════════════════════════════════
// ── JWT Operations ──────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

// Create a JWT token
func tls_jwt_create(payload, secret, algorithm) {
    const header = {"alg": algorithm, "typ": "JWT"}
    const header_b64 = tls_base64url_encode(to_json(header))
    const payload_b64 = tls_base64url_encode(to_json(payload))
    const signing_input = header_b64 + "." + payload_b64

    let signature = ""
    match algorithm {
        "HS256" => { signature = tls_base64url_encode(hmac(secret, signing_input, "sha256")) },
        "HS384" => { signature = tls_base64url_encode(hmac(secret, signing_input, "sha384")) },
        "HS512" => { signature = tls_base64url_encode(hmac(secret, signing_input, "sha512")) },
        _ => panic(f"unsupported JWT algorithm: {algorithm}")
    }

    signing_input + "." + signature
}

// Verify and decode a JWT token
func tls_jwt_verify(token, secret, algorithm) {
    const parts = token.split(".")
    if len(parts) != 3 { return {"valid": false, "error": "invalid token format"} }

    const header_b64 = parts[0]
    const payload_b64 = parts[1]
    const signature_b64 = parts[2]

    const signing_input = header_b64 + "." + payload_b64
    let expected_sig = ""
    match algorithm {
        "HS256" => { expected_sig = tls_base64url_encode(hmac(secret, signing_input, "sha256")) },
        "HS384" => { expected_sig = tls_base64url_encode(hmac(secret, signing_input, "sha384")) },
        "HS512" => { expected_sig = tls_base64url_encode(hmac(secret, signing_input, "sha512")) },
        _ => { return {"valid": false, "error": f"unsupported algorithm: {algorithm}"} }
    }

    if !tls_constant_time_eq(signature_b64, expected_sig) {
        return {"valid": false, "error": "signature mismatch"}
    }

    const payload = parse_json(tls_base64url_decode(payload_b64))
    {"valid": true, "payload": payload}
}

// Decode JWT payload without verification
func tls_jwt_decode(token) {
    const parts = token.split(".")
    if len(parts) < 2 { return null }
    const payload_str = tls_base64url_decode(parts[1])
    parse_json(payload_str)
}

// ══════════════════════════════════════════════════════════════════
// ── Constant-Time Comparison ────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_constant_time_eq(a, b) {
    if len(a) != len(b) { return false }
    let diff = 0
    let i = 0
    while i < len(a) {
        if a[i] != b[i] { diff = diff + 1 }
        i = i + 1
    }
    diff == 0
}

// ══════════════════════════════════════════════════════════════════
// ── Password Hashing ────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

// Hash a password with a random salt using PBKDF2
func tls_hash_password(password) {
    const salt = tls_random_token(16)
    const hash = tls_pbkdf2(password, salt, 100000, 32)
    const hash_hex = tls_bytes_to_hex(hash)
    f"pbkdf2:sha256:100000${salt}${hash_hex}"
}

// Verify a password against a stored hash
func tls_verify_password(password, stored_hash) {
    const parts = stored_hash.split("$")
    if len(parts) != 3 { return false }
    const header_parts = parts[0].split(":")
    if len(header_parts) < 3 { return false }
    const iterations = to_int(header_parts[2])
    const salt = parts[1]
    const expected_hash = parts[2]
    const actual = tls_bytes_to_hex(tls_pbkdf2(password, salt, iterations, 32))
    tls_constant_time_eq(actual, expected_hash)
}

// ══════════════════════════════════════════════════════════════════
// ── Full TLS Client Configuration ────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_client_config_full(options) {
    const config = tls_client_config(
        if options.has("ca_cert_path") { options["ca_cert_path"] } else { "" }
    )

    if options.has("min_version") {
        config["min_protocol"] = options["min_version"]
    }
    if options.has("max_version") {
        config["max_protocol"] = options["max_version"]
    }
    if options.has("verify_hostname") {
        config["verify_hostname"] = options["verify_hostname"]
    }
    if options.has("verify_cert") {
        config["verify_cert"] = options["verify_cert"]
    }
    if options.has("cipher_suites") {
        config["cipher_suites"] = options["cipher_suites"]
    }
    if options.has("alpn_protocols") {
        config["alpn_protocols"] = options["alpn_protocols"]
    }
    if options.has("client_cert") {
        config["client_cert"] = options["client_cert"]
    }
    if options.has("client_key") {
        config["client_key"] = options["client_key"]
    }
    if options.has("sni_hostname") {
        config["sni_hostname"] = options["sni_hostname"]
    }

    config
}

// Cipher suite presets
func tls_cipher_suites_modern() {
    [
        "TLS_AES_256_GCM_SHA384",
        "TLS_AES_128_GCM_SHA256",
        "TLS_CHACHA20_POLY1305_SHA256"
    ]
}

func tls_cipher_suites_compatible() {
    [
        "TLS_AES_256_GCM_SHA384",
        "TLS_AES_128_GCM_SHA256",
        "TLS_CHACHA20_POLY1305_SHA256",
        "TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384",
        "TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384",
        "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256",
        "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256"
    ]
}

// ══════════════════════════════════════════════════════════════════
// ── X.509 Certificate Parsing ────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_parse_cert_full(pem_data) {
    const parsed = cert_parse(pem_data)
    if parsed == null { return null }

    {
        "subject": if parsed.has("subject") { parsed["subject"] } else { "" },
        "issuer": if parsed.has("issuer") { parsed["issuer"] } else { "" },
        "serial": if parsed.has("serial") { parsed["serial"] } else { "" },
        "not_before": if parsed.has("not_before") { parsed["not_before"] } else { "" },
        "not_after": if parsed.has("not_after") { parsed["not_after"] } else { "" },
        "fingerprint_sha256": if parsed.has("fingerprint_sha256") { parsed["fingerprint_sha256"] } else { "" },
        "fingerprint_sha1": if parsed.has("fingerprint_sha1") { parsed["fingerprint_sha1"] } else { "" },
        "public_key_algorithm": if parsed.has("public_key_algorithm") { parsed["public_key_algorithm"] } else { "" },
        "signature_algorithm": if parsed.has("signature_algorithm") { parsed["signature_algorithm"] } else { "" },
        "key_size": if parsed.has("key_size") { parsed["key_size"] } else { 0 },
        "is_ca": if parsed.has("is_ca") { parsed["is_ca"] } else { false },
        "subject_alt_names": if parsed.has("subject_alt_names") { parsed["subject_alt_names"] } else { [] },
        "key_usage": if parsed.has("key_usage") { parsed["key_usage"] } else { [] },
        "extended_key_usage": if parsed.has("extended_key_usage") { parsed["extended_key_usage"] } else { [] },
        "version": if parsed.has("version") { parsed["version"] } else { 3 }
    }
}

// ══════════════════════════════════════════════════════════════════
// ── Certificate Generation ───────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_generate_cert(options) {
    const common_name = if options.has("common_name") { options["common_name"] } else { "localhost" }
    const days = if options.has("days") { options["days"] } else { 365 }
    const org = if options.has("organization") { options["organization"] } else { "" }
    const country = if options.has("country") { options["country"] } else { "" }
    const state = if options.has("state") { options["state"] } else { "" }
    const locality = if options.has("locality") { options["locality"] } else { "" }
    const alt_names = if options.has("alt_names") { options["alt_names"] } else { [] }
    const is_ca = if options.has("is_ca") { options["is_ca"] } else { false }
    const key_type = if options.has("key_type") { options["key_type"] } else { "rsa" }
    const key_size = if options.has("key_size") { options["key_size"] } else { 2048 }

    cert_generate_full({
        "common_name": common_name,
        "days": days,
        "organization": org,
        "country": country,
        "state": state,
        "locality": locality,
        "alt_names": alt_names,
        "is_ca": is_ca,
        "key_type": key_type,
        "key_size": key_size
    })
}

func tls_generate_ca_cert(common_name, days) {
    tls_generate_cert({
        "common_name": common_name,
        "days": days,
        "is_ca": true,
        "key_type": "rsa",
        "key_size": 4096
    })
}

// ══════════════════════════════════════════════════════════════════
// ── Key Generation ───────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_generate_rsa_key(bits) {
    // Delegate to stage 0 builtin
    const result = rsa_keygen(bits)
    {
        "algorithm": "RSA",
        "key_size": bits,
        "private_key": result["private"],
        "public_key": result["public"],
        "format": "DER"
    }
}

func tls_generate_ecdsa_key() {
    const result = ecdsa_keygen()
    {
        "algorithm": "ECDSA",
        "curve": "P-256",
        "private_key": result["private"],
        "public_key": result["public"],
        "format": "DER"
    }
}

func tls_generate_ed25519_key() {
    const result = ed25519_keygen()
    {
        "algorithm": "Ed25519",
        "private_key": result["private"],
        "public_key": result["public"],
        "format": "DER"
    }
}

func tls_generate_key(algorithm, options) {
    match algorithm {
        "rsa" => {
            const bits = if options.has("bits") { options["bits"] } else { 2048 }
            tls_generate_rsa_key(bits)
        },
        "rsa-2048" => tls_generate_rsa_key(2048),
        "rsa-4096" => tls_generate_rsa_key(4096),
        "ecdsa" => tls_generate_ecdsa_key(),
        "ecdsa-p256" => tls_generate_ecdsa_key(),
        "ed25519" => tls_generate_ed25519_key(),
        _ => panic(f"Unknown key algorithm: {algorithm}")
    }
}

// ══════════════════════════════════════════════════════════════════
// ── All Hash Algorithms ──────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_sha1(data) { sha1(data) }

func tls_hash_full(data, algorithm) {
    match algorithm {
        "sha1" => sha1(data),
        "sha-1" => sha1(data),
        "sha256" => sha256(data),
        "sha-256" => sha256(data),
        "sha384" => sha384(data),
        "sha-384" => sha384(data),
        "sha512" => sha512(data),
        "sha-512" => sha512(data),
        "md5" => md5(data),
        "blake3" => blake3(data),
        _ => panic(f"Unknown hash algorithm: {algorithm}")
    }
}

// ══════════════════════════════════════════════════════════════════
// ── HMAC for All Algorithms ──────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_hmac_sha384(key, data) { hmac(key, data, "sha384") }

func tls_hmac_full(key, data, algorithm) {
    match algorithm {
        "sha1" => hmac(key, data, "sha1"),
        "sha256" => hmac(key, data, "sha256"),
        "sha384" => hmac(key, data, "sha384"),
        "sha512" => hmac(key, data, "sha512"),
        _ => panic(f"Unsupported HMAC algorithm: {algorithm}")
    }
}

func tls_hmac_verify_full(key, data, expected_mac, algorithm) {
    const actual = tls_hmac_full(key, data, algorithm)
    tls_constant_time_eq(actual, expected_mac)
}

// ══════════════════════════════════════════════════════════════════
// ── AES-256-CBC Encrypt/Decrypt ──────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_aes_cbc_encrypt(key, plaintext, iv) {
    if iv == null {
        // Auto-generate IV
        const auto_iv = random_bytes(16)
        const ciphertext = aes_cbc_encrypt(key, plaintext, auto_iv)
        {"ciphertext": ciphertext, "iv": auto_iv}
    } else {
        const ciphertext = aes_cbc_encrypt(key, plaintext, iv)
        {"ciphertext": ciphertext, "iv": iv}
    }
}

func tls_aes_cbc_decrypt(key, ciphertext, iv) {
    aes_cbc_decrypt(key, ciphertext, iv)
}

// ══════════════════════════════════════════════════════════════════
// ── AES-256-GCM Encrypt/Decrypt (enhanced) ───────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_aes_gcm_encrypt_full(key, plaintext, aad, nonce) {
    let actual_nonce = nonce
    if actual_nonce == null {
        actual_nonce = random_bytes(12)
    }
    const result = aes_gcm_encrypt(key, plaintext, aad)
    {
        "ciphertext": result,
        "nonce": actual_nonce,
        "aad": aad
    }
}

func tls_aes_gcm_decrypt_full(key, ciphertext, aad, nonce) {
    aes_gcm_decrypt(key, ciphertext, aad)
}

// ══════════════════════════════════════════════════════════════════
// ── ChaCha20-Poly1305 Encrypt/Decrypt ────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_chacha20_encrypt(key, plaintext, nonce, aad) {
    let actual_nonce = nonce
    if actual_nonce == null {
        actual_nonce = random_bytes(12)
    }
    const ciphertext = chacha20_poly1305_encrypt(key, plaintext, actual_nonce, aad)
    {
        "ciphertext": ciphertext,
        "nonce": actual_nonce,
        "aad": aad
    }
}

func tls_chacha20_decrypt(key, ciphertext, nonce, aad) {
    chacha20_poly1305_decrypt(key, ciphertext, nonce, aad)
}

// Generate a ChaCha20 key (256-bit)
func tls_generate_chacha20_key() {
    random_bytes(32)
}

// ══════════════════════════════════════════════════════════════════
// ── RSA Sign/Verify ──────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_rsa_sign(data, private_key) {
    rsa_sign(data, private_key)
}

func tls_rsa_verify(data, signature, public_key) {
    rsa_verify(data, signature, public_key)
}

func tls_rsa_sign_with_hash(data, private_key, hash_algo) {
    const digest = tls_hash_full(data, hash_algo)
    rsa_sign(digest, private_key)
}

func tls_rsa_verify_with_hash(data, signature, public_key, hash_algo) {
    const digest = tls_hash_full(data, hash_algo)
    rsa_verify(digest, signature, public_key)
}

// ══════════════════════════════════════════════════════════════════
// ── ECDSA Sign/Verify ────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_ecdsa_sign(data, private_key) {
    ecdsa_sign(data, private_key)
}

func tls_ecdsa_verify(data, signature, public_key) {
    ecdsa_verify(data, signature, public_key)
}

func tls_ecdsa_sign_with_hash(data, private_key, hash_algo) {
    const digest = tls_hash_full(data, hash_algo)
    ecdsa_sign(digest, private_key)
}

// ══════════════════════════════════════════════════════════════════
// ── Ed25519 Sign/Verify ──────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_ed25519_sign(data, private_key) {
    ed25519_sign(data, private_key)
}

func tls_ed25519_verify(data, signature, public_key) {
    ed25519_verify(data, signature, public_key)
}

// ══════════════════════════════════════════════════════════════════
// ── Key Derivation: bcrypt, argon2, scrypt ───────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_bcrypt_hash(password, rounds) {
    const actual_rounds = if rounds == null { 12 } else { rounds }
    bcrypt_hash(password, actual_rounds)
}

func tls_bcrypt_verify(password, hash) {
    bcrypt_verify(password, hash)
}

func tls_argon2_hash(password, salt, options) {
    const time_cost = if options.has("time_cost") { options["time_cost"] } else { 3 }
    const memory_cost = if options.has("memory_cost") { options["memory_cost"] } else { 65536 }
    const parallelism = if options.has("parallelism") { options["parallelism"] } else { 4 }
    const output_len = if options.has("output_length") { options["output_length"] } else { 32 }

    argon2_hash(password, salt, time_cost, memory_cost, parallelism, output_len)
}

func tls_argon2_verify(password, hash) {
    argon2_verify(password, hash)
}

func tls_scrypt_hash(password, salt, options) {
    const n = if options.has("n") { options["n"] } else { 16384 }
    const r = if options.has("r") { options["r"] } else { 8 }
    const p = if options.has("p") { options["p"] } else { 1 }
    const output_len = if options.has("output_length") { options["output_length"] } else { 32 }

    scrypt_hash(password, salt, n, r, p, output_len)
}

// ══════════════════════════════════════════════════════════════════
// ── HKDF Key Expansion ──────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_hkdf_extract(salt, input_key_material) {
    // HKDF-Extract: PRK = HMAC-Hash(salt, IKM)
    tls_hmac_sha256(salt, input_key_material)
}

func tls_hkdf_expand(prk, info, length) {
    // HKDF-Expand using HMAC-SHA256
    hkdf_expand(prk, info, length)
}

func tls_hkdf_full(input_key, salt, info, length, hash_algo) {
    match hash_algo {
        "sha256" => hkdf(input_key, salt, info, length),
        "sha384" => hkdf(input_key, salt, info, length),
        "sha512" => hkdf(input_key, salt, info, length),
        _ => hkdf(input_key, salt, info, length),
    }
}

// ══════════════════════════════════════════════════════════════════
// ── CSPRNG (Random Bytes) ────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_secure_random(n) { random_bytes(n) }
func tls_random_hex(byte_count) { tls_bytes_to_hex(random_bytes(byte_count)) }

func tls_random_base64(byte_count) {
    tls_base64_encode(random_bytes(byte_count))
}

func tls_random_base64url(byte_count) {
    tls_base64url_encode(random_bytes(byte_count))
}

// ══════════════════════════════════════════════════════════════════
// ── X.509 Certificate Chain Verification ─────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_verify_chain(cert_chain, root_certs) {
    // cert_chain: array of PEM strings (leaf first, root last)
    // root_certs: array of trusted root PEM strings
    if len(cert_chain) == 0 {
        return {"valid": false, "error": "Empty certificate chain"}
    }

    // Verify each cert is signed by the next
    let i = 0
    while i < len(cert_chain) - 1 {
        const cert = cert_chain[i]
        const issuer = cert_chain[i + 1]
        const result = cert_verify(cert, issuer)
        if result != true {
            return {"valid": false, "error": f"Chain verification failed at position {i}", "position": i}
        }
        i = i + 1
    }

    // Verify the last cert against root certs
    const last_cert = cert_chain[len(cert_chain) - 1]
    let root_verified = false
    for root in root_certs {
        if cert_verify(last_cert, root) == true {
            root_verified = true
            break
        }
    }

    if !root_verified {
        // Check if the last cert is self-signed (root)
        if cert_verify(last_cert, last_cert) == true {
            // Self-signed, check if it's in the root store
            let found = false
            for root in root_certs {
                if root == last_cert {
                    found = true
                    break
                }
            }
            if !found {
                return {"valid": false, "error": "Self-signed certificate not in trust store"}
            }
        } else {
            return {"valid": false, "error": "Root certificate not trusted"}
        }
    }

    {"valid": true}
}

// ══════════════════════════════════════════════════════════════════
// ── PEM Encoding/Decoding ────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_pem_encode(der_data, label) {
    const b64 = tls_base64_encode(der_data)
    // Wrap at 64 characters
    let lines = []
    let i = 0
    while i < len(b64) {
        const end = min(i + 64, len(b64))
        lines.push(b64[i..end])
        i = i + 64
    }
    "-----BEGIN " + label + "-----\n" + lines.join("\n") + "\n-----END " + label + "-----\n"
}

func tls_pem_decode(pem_data) {
    const lines = pem_data.split("\n")
    let label = ""
    let b64_data = ""
    let inside = false

    for line in lines {
        const trimmed = line.trim()
        if trimmed.starts_with("-----BEGIN ") {
            label = trimmed[11..len(trimmed) - 5]
            inside = true
            continue
        }
        if trimmed.starts_with("-----END ") {
            inside = false
            continue
        }
        if inside {
            b64_data = b64_data + trimmed
        }
    }

    {"label": label, "data": tls_base64_decode(b64_data)}
}

func tls_pem_encode_cert(der_data) {
    tls_pem_encode(der_data, "CERTIFICATE")
}

func tls_pem_encode_private_key(der_data) {
    tls_pem_encode(der_data, "PRIVATE KEY")
}

func tls_pem_encode_public_key(der_data) {
    tls_pem_encode(der_data, "PUBLIC KEY")
}

// ══════════════════════════════════════════════════════════════════
// ── DER Encoding/Decoding ────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_der_encode_length(length) {
    if length < 128 {
        return [length]
    }
    // Long form
    let bytes = []
    let remaining = length
    while remaining > 0 {
        bytes = [remaining % 256] + bytes
        remaining = remaining / 256
    }
    [128 + len(bytes)] + bytes
}

func tls_der_decode_length(data, offset) {
    if offset >= len(data) { return {"length": 0, "consumed": 0} }
    const first = data[offset]
    if first < 128 {
        return {"length": first, "consumed": 1}
    }
    const num_bytes = first - 128
    let length = 0
    let i = 0
    while i < num_bytes {
        length = length * 256 + data[offset + 1 + i]
        i = i + 1
    }
    {"length": length, "consumed": 1 + num_bytes}
}

func tls_der_encode_integer(value) {
    // Tag 0x02 for INTEGER
    let bytes = []
    let v = if value < 0 { 0 - value } else { value }
    if v == 0 {
        bytes = [0]
    } else {
        while v > 0 {
            bytes = [v % 256] + bytes
            v = v / 256
        }
        // Add leading zero if high bit set (positive number)
        if value >= 0 && bytes[0] >= 128 {
            bytes = [0] + bytes
        }
    }
    [2] + tls_der_encode_length(len(bytes)) + bytes
}

func tls_der_encode_sequence(contents) {
    [48] + tls_der_encode_length(len(contents)) + contents
}

func tls_der_encode_octet_string(data) {
    [4] + tls_der_encode_length(len(data)) + data
}

func tls_der_encode_utf8_string(text) {
    let bytes = []
    for c in text.chars() {
        bytes.push(char_code(c))
    }
    [12] + tls_der_encode_length(len(bytes)) + bytes
}

// ══════════════════════════════════════════════════════════════════
// ── JWT Token Creation and Verification (enhanced) ───────────────
// ══════════════════════════════════════════════════════════════════

func tls_jwt_create_full(payload, key, options) {
    const algorithm = if options.has("algorithm") { options["algorithm"] } else { "HS256" }
    const header = {"alg": algorithm, "typ": "JWT"}

    // Add optional header fields
    if options.has("kid") { header["kid"] = options["kid"] }
    if options.has("jku") { header["jku"] = options["jku"] }

    // Add standard claims
    let full_payload = {}
    for k in keys(payload) {
        full_payload[k] = payload[k]
    }
    if options.has("issuer") { full_payload["iss"] = options["issuer"] }
    if options.has("subject") { full_payload["sub"] = options["subject"] }
    if options.has("audience") { full_payload["aud"] = options["audience"] }
    if options.has("expiration") { full_payload["exp"] = options["expiration"] }
    if options.has("not_before") { full_payload["nbf"] = options["not_before"] }
    if options.has("issued_at") { full_payload["iat"] = options["issued_at"] }
    if options.has("jti") { full_payload["jti"] = options["jti"] }

    const header_b64 = tls_base64url_encode(to_json(header))
    const payload_b64 = tls_base64url_encode(to_json(full_payload))
    const signing_input = header_b64 + "." + payload_b64

    let signature = ""
    match algorithm {
        "HS256" => { signature = tls_base64url_encode(hmac(key, signing_input, "sha256")) },
        "HS384" => { signature = tls_base64url_encode(hmac(key, signing_input, "sha384")) },
        "HS512" => { signature = tls_base64url_encode(hmac(key, signing_input, "sha512")) },
        "RS256" => { signature = tls_base64url_encode(tls_rsa_sign_with_hash(signing_input, key, "sha256")) },
        "RS384" => { signature = tls_base64url_encode(tls_rsa_sign_with_hash(signing_input, key, "sha384")) },
        "RS512" => { signature = tls_base64url_encode(tls_rsa_sign_with_hash(signing_input, key, "sha512")) },
        "ES256" => { signature = tls_base64url_encode(tls_ecdsa_sign(signing_input, key)) },
        "EdDSA" => { signature = tls_base64url_encode(tls_ed25519_sign(signing_input, key)) },
        _ => panic(f"Unsupported JWT algorithm: {algorithm}")
    }

    signing_input + "." + signature
}

func tls_jwt_verify_full(token, key, options) {
    const parts = token.split(".")
    if len(parts) != 3 {
        return {"valid": false, "error": "Invalid token format"}
    }

    const header_b64 = parts[0]
    const payload_b64 = parts[1]
    const signature_b64 = parts[2]

    // Decode header to get algorithm
    const header = parse_json(tls_base64url_decode(header_b64))
    if header == null {
        return {"valid": false, "error": "Invalid header"}
    }
    const algorithm = if header.has("alg") { header["alg"] } else { "" }

    // Validate algorithm matches expected
    if options.has("algorithm") && options["algorithm"] != algorithm {
        return {"valid": false, "error": f"Algorithm mismatch: expected {options[\"algorithm\"]}, got {algorithm}"}
    }

    const signing_input = header_b64 + "." + payload_b64

    // Verify signature
    let sig_valid = false
    match algorithm {
        "HS256" => {
            const expected = tls_base64url_encode(hmac(key, signing_input, "sha256"))
            sig_valid = tls_constant_time_eq(signature_b64, expected)
        },
        "HS384" => {
            const expected = tls_base64url_encode(hmac(key, signing_input, "sha384"))
            sig_valid = tls_constant_time_eq(signature_b64, expected)
        },
        "HS512" => {
            const expected = tls_base64url_encode(hmac(key, signing_input, "sha512"))
            sig_valid = tls_constant_time_eq(signature_b64, expected)
        },
        "RS256" => {
            const sig = tls_base64url_decode(signature_b64)
            sig_valid = tls_rsa_verify_with_hash(signing_input, sig, key, "sha256")
        },
        "ES256" => {
            const sig = tls_base64url_decode(signature_b64)
            sig_valid = tls_ecdsa_verify(signing_input, sig, key)
        },
        "EdDSA" => {
            const sig = tls_base64url_decode(signature_b64)
            sig_valid = tls_ed25519_verify(signing_input, sig, key)
        },
        _ => {
            return {"valid": false, "error": f"Unsupported algorithm: {algorithm}"}
        }
    }

    if !sig_valid {
        return {"valid": false, "error": "Signature verification failed"}
    }

    // Decode payload
    const payload = parse_json(tls_base64url_decode(payload_b64))
    if payload == null {
        return {"valid": false, "error": "Invalid payload"}
    }

    // Validate claims
    const now = time_now() / 1000  // seconds

    // Check expiration
    if payload.has("exp") {
        if now > payload["exp"] {
            return {"valid": false, "error": "Token expired", "payload": payload}
        }
    }

    // Check not-before
    if payload.has("nbf") {
        if now < payload["nbf"] {
            return {"valid": false, "error": "Token not yet valid", "payload": payload}
        }
    }

    // Check issuer
    if options.has("issuer") && payload.has("iss") {
        if payload["iss"] != options["issuer"] {
            return {"valid": false, "error": "Issuer mismatch", "payload": payload}
        }
    }

    // Check audience
    if options.has("audience") && payload.has("aud") {
        if payload["aud"] != options["audience"] {
            return {"valid": false, "error": "Audience mismatch", "payload": payload}
        }
    }

    {"valid": true, "header": header, "payload": payload}
}

// ══════════════════════════════════════════════════════════════════
// ── OAuth2 Helper Functions ──────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_oauth2_authorization_url(base_url, client_id, redirect_uri, scope, state) {
    let url = base_url + "?"
    url = url + "response_type=code"
    url = url + "&client_id=" + url_encode(client_id)
    url = url + "&redirect_uri=" + url_encode(redirect_uri)
    if scope != "" { url = url + "&scope=" + url_encode(scope) }
    if state != "" { url = url + "&state=" + url_encode(state) }
    url
}

func tls_oauth2_token_request(token_url, client_id, client_secret, code, redirect_uri) {
    {
        "url": token_url,
        "method": "POST",
        "headers": {
            "Content-Type": "application/x-www-form-urlencoded",
            "Authorization": "Basic " + tls_base64_encode(client_id + ":" + client_secret)
        },
        "body": "grant_type=authorization_code"
            + "&code=" + url_encode(code)
            + "&redirect_uri=" + url_encode(redirect_uri)
    }
}

func tls_oauth2_refresh_request(token_url, client_id, client_secret, refresh_token) {
    {
        "url": token_url,
        "method": "POST",
        "headers": {
            "Content-Type": "application/x-www-form-urlencoded",
            "Authorization": "Basic " + tls_base64_encode(client_id + ":" + client_secret)
        },
        "body": "grant_type=refresh_token&refresh_token=" + url_encode(refresh_token)
    }
}

func tls_oauth2_pkce_challenge() {
    // Generate PKCE code verifier and challenge
    const verifier = tls_random_base64url(32)
    const challenge = tls_base64url_encode(sha256(verifier))
    {"verifier": verifier, "challenge": challenge, "method": "S256"}
}

func tls_oauth2_client_credentials(token_url, client_id, client_secret, scope) {
    {
        "url": token_url,
        "method": "POST",
        "headers": {
            "Content-Type": "application/x-www-form-urlencoded",
            "Authorization": "Basic " + tls_base64_encode(client_id + ":" + client_secret)
        },
        "body": "grant_type=client_credentials" + if scope != "" { "&scope=" + url_encode(scope) } else { "" }
    }
}

// ══════════════════════════════════════════════════════════════════
// ── Base64url Encoding (for JWT) ─────────────────────────────────
// ══════════════════════════════════════════════════════════════════

// Already defined above as tls_base64url_encode and tls_base64url_decode

// ══════════════════════════════════════════════════════════════════
// ── URL Encoding Helper ──────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func url_encode(s) {
    const hex_chars = "0123456789ABCDEF"
    let result = ""
    for c in s.chars() {
        const code = char_code(c)
        if (c >= "A" && c <= "Z") || (c >= "a" && c <= "z") || (c >= "0" && c <= "9") || c == "-" || c == "_" || c == "." || c == "~" {
            result = result + c
        } else {
            result = result + "%" + hex_chars[code / 16] + hex_chars[code % 16]
        }
    }
    result
}

// ══════════════════════════════════════════════════════════════════
// ── Symmetric Encryption Convenience ─────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_encrypt(algorithm, key, plaintext, options) {
    const aad = if options.has("aad") { options["aad"] } else { "" }
    const nonce = if options.has("nonce") { options["nonce"] } else { null }
    const iv = if options.has("iv") { options["iv"] } else { null }

    match algorithm {
        "aes-256-gcm" => tls_aes_gcm_encrypt_full(key, plaintext, aad, nonce),
        "aes-256-cbc" => tls_aes_cbc_encrypt(key, plaintext, iv),
        "chacha20-poly1305" => tls_chacha20_encrypt(key, plaintext, nonce, aad),
        _ => panic(f"Unknown encryption algorithm: {algorithm}")
    }
}

func tls_decrypt(algorithm, key, ciphertext, options) {
    const aad = if options.has("aad") { options["aad"] } else { "" }
    const nonce = if options.has("nonce") { options["nonce"] } else { null }
    const iv = if options.has("iv") { options["iv"] } else { null }

    match algorithm {
        "aes-256-gcm" => tls_aes_gcm_decrypt_full(key, ciphertext, aad, nonce),
        "aes-256-cbc" => tls_aes_cbc_decrypt(key, ciphertext, iv),
        "chacha20-poly1305" => tls_chacha20_decrypt(key, ciphertext, nonce, aad),
        _ => panic(f"Unknown decryption algorithm: {algorithm}")
    }
}

// ══════════════════════════════════════════════════════════════════
// ── Digital Signature Convenience ────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_sign(algorithm, data, private_key) {
    match algorithm {
        "rsa" => tls_rsa_sign(data, private_key),
        "rsa-sha256" => tls_rsa_sign_with_hash(data, private_key, "sha256"),
        "rsa-sha384" => tls_rsa_sign_with_hash(data, private_key, "sha384"),
        "rsa-sha512" => tls_rsa_sign_with_hash(data, private_key, "sha512"),
        "ecdsa" => tls_ecdsa_sign(data, private_key),
        "ecdsa-p256" => tls_ecdsa_sign(data, private_key),
        "ed25519" => tls_ed25519_sign(data, private_key),
        _ => panic(f"Unknown signing algorithm: {algorithm}")
    }
}

func tls_verify(algorithm, data, signature, public_key) {
    match algorithm {
        "rsa" => tls_rsa_verify(data, signature, public_key),
        "rsa-sha256" => tls_rsa_verify_with_hash(data, signature, public_key, "sha256"),
        "rsa-sha384" => tls_rsa_verify_with_hash(data, signature, public_key, "sha384"),
        "rsa-sha512" => tls_rsa_verify_with_hash(data, signature, public_key, "sha512"),
        "ecdsa" => tls_ecdsa_verify(data, signature, public_key),
        "ecdsa-p256" => tls_ecdsa_verify(data, signature, public_key),
        "ed25519" => tls_ed25519_verify(data, signature, public_key),
        _ => panic(f"Unknown verification algorithm: {algorithm}")
    }
}

// ══════════════════════════════════════════════════════════════════
// ── Key Derivation Convenience ───────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_derive_key(algorithm, password, salt, options) {
    const output_length = if options.has("output_length") { options["output_length"] } else { 32 }

    match algorithm {
        "pbkdf2" => {
            const iterations = if options.has("iterations") { options["iterations"] } else { 100000 }
            tls_pbkdf2(password, salt, iterations, output_length)
        },
        "bcrypt" => {
            const rounds = if options.has("rounds") { options["rounds"] } else { 12 }
            tls_bcrypt_hash(password, rounds)
        },
        "argon2" => tls_argon2_hash(password, salt, options),
        "scrypt" => tls_scrypt_hash(password, salt, options),
        "hkdf" => {
            const info = if options.has("info") { options["info"] } else { "" }
            tls_hkdf(password, salt, info, output_length)
        },
        _ => panic(f"Unknown key derivation algorithm: {algorithm}")
    }
}

// ══════════════════════════════════════════════════════════════════
// ── Full TLS Connection Establishment ───────────────────────────
// ══════════════════════════════════════════════════════════════════

// TLS connection state
func tls_connection_new() {
    {
        "__tls_conn": true,
        "state": "new",
        "protocol": null,
        "cipher_suite": null,
        "peer_cert": null,
        "session_id": null,
        "alpn_selected": null,
    }
}

// Full TLS handshake state machine
func tls_handshake(config, hostname) {
    const conn = tls_connection_new()
    conn["hostname"] = hostname

    // Step 1: ClientHello
    const client_hello = tls_build_client_hello(config, hostname)
    conn["state"] = "client_hello_sent"

    // Step 2: Delegate actual TLS to stage 0
    const result = tls_connect(hostname, config)
    if result.has("error") {
        conn["state"] = "error"
        conn["error"] = result["error"]
        return conn
    }

    // Step 3: Record negotiated parameters
    conn["state"] = "connected"
    conn["protocol"] = if result.has("protocol") { result["protocol"] } else { "TLS1.3" }
    conn["cipher_suite"] = if result.has("cipher_suite") { result["cipher_suite"] } else { "TLS_AES_256_GCM_SHA384" }
    conn["session_id"] = if result.has("session_id") { result["session_id"] } else { tls_random_hex(32) }
    conn["alpn_selected"] = if result.has("alpn") { result["alpn"] } else { null }

    // Step 4: Validate peer certificate
    if result.has("peer_cert") {
        conn["peer_cert"] = result["peer_cert"]
        const validation = tls_validate_cert_chain(result["peer_cert"], hostname, config)
        if !validation["valid"] {
            conn["state"] = "cert_error"
            conn["error"] = validation["reason"]
            return conn
        }
    }

    conn
}

func tls_build_client_hello(config, hostname) {
    {
        "type": "client_hello",
        "version": config["max_protocol"],
        "random": tls_random_hex(32),
        "session_id": "",
        "cipher_suites": config["cipher_suites"],
        "extensions": [
            {"type": "server_name", "hostname": hostname},
            {"type": "supported_versions", "versions": ["TLS1.3", "TLS1.2"]},
            {"type": "signature_algorithms", "algorithms": [
                "ecdsa_secp256r1_sha256", "rsa_pss_rsae_sha256",
                "rsa_pkcs1_sha256", "ecdsa_secp384r1_sha384",
            ]},
            {"type": "supported_groups", "groups": ["x25519", "secp256r1", "secp384r1"]},
            {"type": "alpn", "protocols": config["alpn_protocols"]},
        ],
    }
}

func tls_random_hex(bytes) {
    // Delegate to stage 0 CSPRNG
    const rand = tls_random_bytes(bytes)
    if typeof(rand) == "string" { return rand }
    // Fallback: not cryptographically secure
    let result = ""
    let i = 0
    while i < bytes * 2 {
        const val = (time_now() * 7 + i * 13) % 16
        result = result + "0123456789abcdef"[val]
        i = i + 1
    }
    result
}

// ══════════════════════════════════════════════════════════════════
// ── Certificate Chain Validation ────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_validate_cert_chain(cert, hostname, config) {
    let result = {"valid": true, "reason": null}

    // Check 1: Certificate not expired
    if cert.has("not_before") && cert.has("not_after") {
        const now = time_now()
        if now < cert["not_before"] {
            return {"valid": false, "reason": "certificate not yet valid"}
        }
        if now > cert["not_after"] {
            return {"valid": false, "reason": "certificate has expired"}
        }
    }

    // Check 2: Hostname verification
    if config.has("verify_hostname") && config["verify_hostname"] {
        if !tls_verify_hostname(cert, hostname) {
            return {"valid": false, "reason": f"hostname '{hostname}' does not match certificate"}
        }
    }

    // Check 3: Signature verification
    if cert.has("issuer_cert") && cert.has("signature") {
        const sig_valid = tls_verify_signature(
            cert["tbs_certificate"],
            cert["signature"],
            cert["issuer_cert"]["public_key"],
            cert["signature_algorithm"]
        )
        if !sig_valid {
            return {"valid": false, "reason": "certificate signature verification failed"}
        }
    }

    // Check 4: Key usage
    if cert.has("extensions") {
        const ku = tls_find_extension(cert["extensions"], "key_usage")
        if ku != null {
            if !ku["digital_signature"] && !ku["key_agreement"] {
                return {"valid": false, "reason": "certificate key usage does not allow TLS"}
            }
        }
    }

    // Check 5: Basic constraints (CA cert check)
    if cert.has("is_ca") && cert["is_ca"] {
        // CA cert should not be used as end-entity
        if !cert.has("issuer_cert") {
            // Self-signed CA, only valid if explicitly trusted
        }
    }

    result
}

func tls_verify_hostname(cert, hostname) {
    // Check Subject Alternative Names (SAN)
    if cert.has("san") {
        for san in cert["san"] {
            if tls_hostname_matches(san, hostname) { return true }
        }
    }
    // Fallback to Common Name
    if cert.has("subject") && cert["subject"].has("CN") {
        return tls_hostname_matches(cert["subject"]["CN"], hostname)
    }
    false
}

func tls_hostname_matches(pattern, hostname) {
    if pattern == hostname { return true }
    // Wildcard matching: *.example.com matches foo.example.com
    if pattern.starts_with("*.") {
        const domain = pattern[2..len(pattern)]
        const dot_idx = hostname.index_of(".")
        if dot_idx > 0 {
            const hostname_domain = hostname[dot_idx + 1..len(hostname)]
            return hostname_domain == domain
        }
    }
    false
}

func tls_find_extension(extensions, oid) {
    for ext in extensions {
        if ext.has("oid") && ext["oid"] == oid { return ext }
        if ext.has("type") && ext["type"] == oid { return ext }
    }
    null
}

// ══════════════════════════════════════════════════════════════════
// ── OCSP Stapling ───────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_ocsp_request(cert, issuer_cert) {
    // Build OCSP request
    const serial = if cert.has("serial_number") { cert["serial_number"] } else { "" }
    const issuer_hash = tls_sha256(if issuer_cert.has("subject_der") { issuer_cert["subject_der"] } else { "" })
    const issuer_key_hash = tls_sha256(if issuer_cert.has("public_key_der") { issuer_cert["public_key_der"] } else { "" })

    {
        "type": "ocsp_request",
        "hash_algorithm": "sha256",
        "issuer_name_hash": issuer_hash,
        "issuer_key_hash": issuer_key_hash,
        "serial_number": serial,
    }
}

func tls_ocsp_check(cert, issuer_cert, ocsp_url) {
    const request = tls_ocsp_request(cert, issuer_cert)
    // Delegate actual HTTP request to stage 0
    const response = tls_ocsp_query(ocsp_url, request)
    if response == null {
        return {"status": "unknown", "reason": "OCSP responder unreachable"}
    }
    if response.has("error") {
        return {"status": "unknown", "reason": response["error"]}
    }

    match response["cert_status"] {
        "good" => {"status": "good", "this_update": response["this_update"], "next_update": response["next_update"]},
        "revoked" => {"status": "revoked", "revocation_time": response["revocation_time"], "reason": response["revocation_reason"]},
        _ => {"status": "unknown", "reason": "OCSP returned unknown status"},
    }
}

// Process OCSP stapled response from TLS handshake
func tls_process_stapled_ocsp(stapled_response, cert, issuer_cert) {
    if stapled_response == null { return {"status": "not_stapled"} }
    // Verify OCSP response signature
    if stapled_response.has("signature") && issuer_cert != null {
        const sig_valid = tls_verify_signature(
            stapled_response["tbs_response"],
            stapled_response["signature"],
            issuer_cert["public_key"],
            stapled_response["signature_algorithm"]
        )
        if !sig_valid {
            return {"status": "invalid", "reason": "OCSP response signature invalid"}
        }
    }
    // Check freshness
    if stapled_response.has("next_update") {
        const now = time_now()
        if now > stapled_response["next_update"] {
            return {"status": "stale", "reason": "OCSP response has expired"}
        }
    }
    {"status": stapled_response["cert_status"]}
}

// ══════════════════════════════════════════════════════════════════
// ── Certificate Revocation (CRL) Checking ───────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_check_crl(cert, crl_url) {
    // Delegate CRL download to stage 0
    const crl = tls_download_crl(crl_url)
    if crl == null {
        return {"revoked": false, "reason": "CRL unavailable"}
    }

    const serial = if cert.has("serial_number") { cert["serial_number"] } else { "" }

    // Check if serial is in revoked list
    if crl.has("revoked_certificates") {
        for entry in crl["revoked_certificates"] {
            if entry["serial_number"] == serial {
                return {
                    "revoked": true,
                    "revocation_date": entry["revocation_date"],
                    "reason": if entry.has("reason") { entry["reason"] } else { "unspecified" },
                }
            }
        }
    }

    {"revoked": false, "checked_at": time_now()}
}

// ══════════════════════════════════════════════════════════════════
// ── Full X.509 Extension Parsing ────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_parse_x509_extensions(cert_data) {
    let extensions = []
    if !cert_data.has("extensions") { return extensions }

    for ext_raw in cert_data["extensions"] {
        const oid = ext_raw["oid"]
        const critical = if ext_raw.has("critical") { ext_raw["critical"] } else { false }
        const value = ext_raw["value"]

        const parsed = match oid {
            "2.5.29.15" => tls_parse_key_usage(value),
            "2.5.29.37" => tls_parse_extended_key_usage(value),
            "2.5.29.17" => tls_parse_san(value),
            "2.5.29.19" => tls_parse_basic_constraints(value),
            "2.5.29.35" => tls_parse_authority_key_id(value),
            "2.5.29.14" => tls_parse_subject_key_id(value),
            "2.5.29.31" => tls_parse_crl_distribution(value),
            "1.3.6.1.5.5.7.1.1" => tls_parse_authority_info_access(value),
            "2.5.29.32" => tls_parse_certificate_policies(value),
            "2.5.29.30" => tls_parse_name_constraints(value),
            _ => {"type": "unknown", "oid": oid, "value": value},
        }

        parsed["critical"] = critical
        parsed["oid"] = oid
        extensions.push(parsed)
    }
    extensions
}

func tls_parse_key_usage(value) {
    {
        "type": "key_usage",
        "digital_signature": if value.has("digital_signature") { value["digital_signature"] } else { false },
        "key_encipherment": if value.has("key_encipherment") { value["key_encipherment"] } else { false },
        "data_encipherment": if value.has("data_encipherment") { value["data_encipherment"] } else { false },
        "key_agreement": if value.has("key_agreement") { value["key_agreement"] } else { false },
        "key_cert_sign": if value.has("key_cert_sign") { value["key_cert_sign"] } else { false },
        "crl_sign": if value.has("crl_sign") { value["crl_sign"] } else { false },
    }
}

func tls_parse_extended_key_usage(value) {
    let usages = []
    if typeof(value) == "array" {
        for oid in value {
            const name = match oid {
                "1.3.6.1.5.5.7.3.1" => "serverAuth",
                "1.3.6.1.5.5.7.3.2" => "clientAuth",
                "1.3.6.1.5.5.7.3.3" => "codeSigning",
                "1.3.6.1.5.5.7.3.4" => "emailProtection",
                "1.3.6.1.5.5.7.3.8" => "timeStamping",
                "1.3.6.1.5.5.7.3.9" => "OCSPSigning",
                _ => oid,
            }
            usages.push(name)
        }
    }
    {"type": "extended_key_usage", "usages": usages}
}

func tls_parse_san(value) {
    let names = []
    if typeof(value) == "array" {
        for entry in value {
            if typeof(entry) == "string" {
                names.push({"type": "dns", "value": entry})
            } else if typeof(entry) == "map" {
                names.push(entry)
            }
        }
    }
    {"type": "subject_alt_name", "names": names}
}

func tls_parse_basic_constraints(value) {
    {
        "type": "basic_constraints",
        "is_ca": if value.has("is_ca") { value["is_ca"] } else { false },
        "path_length": if value.has("path_length") { value["path_length"] } else { null },
    }
}

func tls_parse_authority_key_id(value) {
    {"type": "authority_key_identifier", "key_id": value}
}

func tls_parse_subject_key_id(value) {
    {"type": "subject_key_identifier", "key_id": value}
}

func tls_parse_crl_distribution(value) {
    let points = []
    if typeof(value) == "array" {
        for entry in value {
            points.push(entry)
        }
    }
    {"type": "crl_distribution_points", "points": points}
}

func tls_parse_authority_info_access(value) {
    let entries = []
    if typeof(value) == "array" {
        for entry in value {
            entries.push(entry)
        }
    }
    {"type": "authority_info_access", "entries": entries}
}

func tls_parse_certificate_policies(value) {
    {"type": "certificate_policies", "policies": value}
}

func tls_parse_name_constraints(value) {
    {"type": "name_constraints", "permitted": if value.has("permitted") { value["permitted"] } else { [] }, "excluded": if value.has("excluded") { value["excluded"] } else { [] }}
}

// ══════════════════════════════════════════════════════════════════
// ── Certificate Signing Request (CSR) Generation ────────────────
// ══════════════════════════════════════════════════════════════════

func tls_generate_csr(subject, key_pair, options) {
    const san = if options.has("san") { options["san"] } else { [] }
    const key_usage = if options.has("key_usage") { options["key_usage"] } else { ["digital_signature", "key_encipherment"] }
    const signature_algorithm = if options.has("signature_algorithm") { options["signature_algorithm"] } else { "sha256WithRSAEncryption" }

    const csr = {
        "type": "certificate_signing_request",
        "version": 0,
        "subject": subject,
        "public_key": key_pair["public_key"],
        "public_key_algorithm": key_pair["algorithm"],
        "signature_algorithm": signature_algorithm,
        "extensions": [],
    }

    // Add SAN extension
    if len(san) > 0 {
        let san_entries = []
        for name in san {
            if name.contains("@") {
                san_entries.push({"type": "email", "value": name})
            } else if name.matches("^[0-9.]+$") || name.contains(":") {
                san_entries.push({"type": "ip", "value": name})
            } else {
                san_entries.push({"type": "dns", "value": name})
            }
        }
        csr["extensions"].push({"oid": "2.5.29.17", "value": san_entries})
    }

    // Add key usage
    if len(key_usage) > 0 {
        let ku = {}
        for usage in key_usage {
            ku[usage] = true
        }
        csr["extensions"].push({"oid": "2.5.29.15", "value": ku, "critical": true})
    }

    // Sign the CSR with the private key
    const tbs = csr_serialize_tbs(csr)
    csr["signature"] = tls_sign(tbs, key_pair["private_key"], signature_algorithm)
    csr
}

func csr_serialize_tbs(csr) {
    // Simplified TBS (to-be-signed) serialization
    let tbs = f"CSR:v{csr[\"version\"]}:"
    if csr["subject"].has("CN") { tbs = tbs + f"CN={csr[\"subject\"][\"CN\"]}," }
    if csr["subject"].has("O") { tbs = tbs + f"O={csr[\"subject\"][\"O\"]}," }
    if csr["subject"].has("C") { tbs = tbs + f"C={csr[\"subject\"][\"C\"]}," }
    tbs = tbs + f":alg={csr[\"public_key_algorithm\"]}"
    tbs
}

// ══════════════════════════════════════════════════════════════════
// ── PKCS#12 Container Handling ──────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_pkcs12_create(cert, private_key, password, options) {
    const friendly_name = if options.has("friendly_name") { options["friendly_name"] } else { "" }
    const ca_certs = if options.has("ca_certs") { options["ca_certs"] } else { [] }

    // Delegate actual PKCS#12 creation to stage 0
    tls_pkcs12_export(cert, private_key, password, friendly_name, ca_certs)
}

func tls_pkcs12_parse(data, password) {
    // Delegate actual PKCS#12 parsing to stage 0
    const result = tls_pkcs12_import(data, password)
    if result == null {
        return {"error": "failed to parse PKCS#12 container"}
    }
    {
        "cert": result["cert"],
        "private_key": result["private_key"],
        "ca_certs": if result.has("ca_certs") { result["ca_certs"] } else { [] },
    }
}

// ══════════════════════════════════════════════════════════════════
// ── Secure Random Number Generation ─────────────────────────────
// ══════════════════════════════════════════════════════════════════

// Generate cryptographically secure random bytes
func secure_random(length) {
    tls_random_bytes(length)
}

// Generate a random integer in range [min, max)
func secure_random_int(min_val, max_val) {
    if min_val >= max_val { return min_val }
    const range = max_val - min_val
    const bytes = tls_random_bytes(8)
    const value = tls_bytes_to_int(bytes)
    min_val + (abs(value) % range)
}

// Generate a random UUID v4
func secure_random_uuid() {
    const bytes = tls_random_bytes(16)
    // Set version (4) and variant (RFC4122)
    tls_uuid_from_random_bytes(bytes)
}

// Generate a random string of specified length from given alphabet
func secure_random_string(length, alphabet) {
    let result = ""
    const alpha_len = len(alphabet)
    let i = 0
    while i < length {
        const idx = secure_random_int(0, alpha_len)
        result = result + alphabet[idx]
        i = i + 1
    }
    result
}

// Generate random alphanumeric token
func secure_random_token(length) {
    secure_random_string(length, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789")
}

// ══════════════════════════════════════════════════════════════════
// ── Key Agreement (ECDH, X25519) ────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func tls_ecdh_generate_keypair(curve) {
    const valid_curves = ["P-256", "P-384", "P-521", "X25519"]
    let found = false
    for c in valid_curves {
        if c == curve { found = true; break }
    }
    if !found { panic(f"Unsupported curve: {curve}. Supported: {valid_curves.join(\", \")}") }

    // Delegate key generation to stage 0
    tls_generate_key_pair("ecdh", {"curve": curve})
}

func tls_ecdh_derive_shared_secret(private_key, peer_public_key, curve) {
    // Delegate ECDH computation to stage 0
    tls_key_agreement("ecdh", private_key, peer_public_key, {"curve": curve})
}

func tls_x25519_generate_keypair() {
    tls_ecdh_generate_keypair("X25519")
}

func tls_x25519_derive_shared_secret(private_key, peer_public_key) {
    tls_ecdh_derive_shared_secret(private_key, peer_public_key, "X25519")
}

// Ephemeral Diffie-Hellman: generate keypair, derive shared secret, derive key
func tls_ecdhe_exchange(curve, peer_public_key) {
    const keypair = tls_ecdh_generate_keypair(curve)
    const shared = tls_ecdh_derive_shared_secret(keypair["private_key"], peer_public_key, curve)

    // Derive actual key using HKDF
    const derived = tls_hkdf(shared, "", "tls13 derived", 32)
    {
        "public_key": keypair["public_key"],
        "shared_secret": shared,
        "derived_key": derived,
    }
}

// ══════════════════════════════════════════════════════════════════
// ── Digital Signature Algorithm Negotiation ─────────────────────
// ══════════════════════════════════════════════════════════════════

const TLS_SIGNATURE_ALGORITHMS = [
    {"id": 0x0401, "name": "rsa_pkcs1_sha256", "hash": "sha256", "sig": "rsa"},
    {"id": 0x0501, "name": "rsa_pkcs1_sha384", "hash": "sha384", "sig": "rsa"},
    {"id": 0x0601, "name": "rsa_pkcs1_sha512", "hash": "sha512", "sig": "rsa"},
    {"id": 0x0403, "name": "ecdsa_secp256r1_sha256", "hash": "sha256", "sig": "ecdsa", "curve": "P-256"},
    {"id": 0x0503, "name": "ecdsa_secp384r1_sha384", "hash": "sha384", "sig": "ecdsa", "curve": "P-384"},
    {"id": 0x0603, "name": "ecdsa_secp521r1_sha512", "hash": "sha512", "sig": "ecdsa", "curve": "P-521"},
    {"id": 0x0804, "name": "rsa_pss_rsae_sha256", "hash": "sha256", "sig": "rsa_pss"},
    {"id": 0x0805, "name": "rsa_pss_rsae_sha384", "hash": "sha384", "sig": "rsa_pss"},
    {"id": 0x0806, "name": "rsa_pss_rsae_sha512", "hash": "sha512", "sig": "rsa_pss"},
    {"id": 0x0807, "name": "ed25519", "hash": "none", "sig": "ed25519"},
    {"id": 0x0808, "name": "ed448", "hash": "none", "sig": "ed448"},
]

func tls_negotiate_signature_algorithm(client_algos, server_cert) {
    const cert_type = if server_cert.has("public_key_algorithm") { server_cert["public_key_algorithm"] } else { "rsa" }

    for algo_name in client_algos {
        for sa in TLS_SIGNATURE_ALGORITHMS {
            if sa["name"] == algo_name {
                // Check compatibility with cert type
                const compatible = match cert_type {
                    "rsa" => sa["sig"] == "rsa" || sa["sig"] == "rsa_pss",
                    "ecdsa" => sa["sig"] == "ecdsa",
                    "ed25519" => sa["sig"] == "ed25519",
                    "ed448" => sa["sig"] == "ed448",
                    _ => false,
                }
                if compatible { return sa }
            }
        }
    }
    null
}

func tls_sign_with_algorithm(data, private_key, algorithm) {
    match algorithm["sig"] {
        "rsa" => tls_rsa_sign(data, private_key, algorithm["hash"]),
        "rsa_pss" => tls_rsa_pss_sign(data, private_key, algorithm["hash"]),
        "ecdsa" => tls_ecdsa_sign(data, private_key),
        "ed25519" => tls_ed25519_sign(data, private_key),
        _ => panic(f"Unsupported signature algorithm: {algorithm[\"sig\"]}"),
    }
}

func tls_verify_with_algorithm(data, signature, public_key, algorithm) {
    match algorithm["sig"] {
        "rsa" => tls_rsa_verify(data, signature, public_key, algorithm["hash"]),
        "rsa_pss" => tls_rsa_pss_verify(data, signature, public_key, algorithm["hash"]),
        "ecdsa" => tls_ecdsa_verify(data, signature, public_key),
        "ed25519" => tls_ed25519_verify(data, signature, public_key),
        _ => false,
    }
}
