// MAGI Self-Hosted Compiler — Type Checker
//
// Walks the AST from parse() and validates correctness:
//   - Variable resolution (undefined, immutable assignment)
//   - Function validation (arity, duplicates)
//   - Match exhaustiveness (enum variants, wildcard)
//   - Import validation (known stdlib modules)
//   - Basic type inference (literals, binary ops)
//   - Lint warnings (unused variables, unreachable code, empty match)
//
// Uses module-level mutable state (same pattern as parser/interpreter).
// Large match blocks are split into helper functions to reduce stack depth
// (the MAGI interpreter creates deep call stacks for match with many arms).

// ── Type Checker State ──────────────────────────────────────────

// Each scope is a map: name -> { "mutable": bool, "used": bool, "typ": string, "line": int }
let tc_scopes = []
// Function signatures: name -> { "arity": int, "min_arity": int, "has_rest": bool, "line": int }
let tc_functions = {"__s": true}
// Enum definitions: name -> [variant_names]
let tc_enums = {"__s": true}
// Struct definitions: name -> [field_names]
let tc_structs = {"__s": true}
// Errors and warnings accumulated during checking
let tc_errors = []
let tc_warnings = []
// Track if we are inside a loop (for break/continue validation)
let tc_loop_depth = 0
// Track if we are inside a function (for return validation)
let tc_func_depth = 0
// Match arm enum pattern tracking (used during exhaustiveness check)
let tc_enum_patterns = {"__s": true}

// ── Known stdlib modules ────────────────────────────────────────

const KNOWN_STDLIB_MODULES = [
    "array", "array_ext", "big", "binary", "bits", "bloom", "bufio",
    "build", "bytes", "cert", "cmp", "collections", "complex", "compress",
    "concurrent", "container", "control", "conv", "crypto", "csv",
    "debug", "embed", "encoding", "env", "error_chain", "errors",
    "expvar", "filepath", "flag", "fmt", "fs", "glob", "graph", "hash",
    "heap", "hex", "html", "http", "image", "inspect", "io", "iter",
    "json", "lazy", "log", "map", "math", "matrix", "memo", "mime",
    "multipart", "net", "number", "observe", "option", "os", "path",
    "pattern", "pipe", "platform", "pool", "process", "profile",
    "protocol", "ptr", "queue", "rand", "reflect", "regex", "result",
    "ring", "runtime", "semver", "serialize", "signal", "simd", "slice",
    "sort", "sql", "state", "stream", "string", "string_ext", "struct",
    "sync", "sysinfo", "template", "test", "text", "thread", "time",
    "tls", "trace", "tuple", "type", "unicode", "unsafe", "url",
    "uuid", "validate", "wasm", "xml", "yaml", "zip"
]

// ── Known builtin functions ─────────────────────────────────────

const KNOWN_BUILTINS = [
    "len", "push", "pop", "println", "print", "output", "assert",
    "to_string", "to_int", "to_float", "typeof", "panic", "input",
    "range", "map", "filter", "reduce", "keys", "values", "contains",
    "contains_key", "split", "join", "trim", "replace", "starts_with",
    "ends_with", "to_upper", "to_lower", "abs", "min", "max", "floor",
    "ceil", "round", "sqrt", "pow", "append", "slice", "sort",
    "reverse", "index_of", "chars", "char_at", "substring", "repeat",
    "format", "parse_int", "parse_float", "is_null", "is_int",
    "is_float", "is_string", "is_bool", "is_array", "is_map",
    "tokenize", "parse", "eval", "type_name", "string_length",
    "array_length", "hash", "clone", "freeze", "is_frozen",
    "error", "is_error", "unwrap", "some", "none", "is_some", "is_none"
]

// ── Scope Management ────────────────────────────────────────────

// Empty map {} is null in MAGI, so use a sentinel key to create a real map
func tc_new_scope() {
    {"__s": true}
}

func tc_push_scope() {
    tc_scopes.push(tc_new_scope())
}

func tc_pop_scope() {
    if len(tc_scopes) == 0 { return null }
    const scope = tc_scopes.pop()
    for name in scope.keys() {
        if name == "__s" { continue }
        const info = scope[name]
        if !info.used && !starts_with(name, "_") {
            tc_warnings.push(f"unused variable '{name}' (declared at line {info.line})")
        }
    }
}

func tc_define_var(name, is_mutable, type_str, line) {
    if len(tc_scopes) == 0 { return null }
    const idx = len(tc_scopes) - 1
    let scope = tc_scopes[idx]
    scope[name] = {"mutable": is_mutable, "used": false, "typ": type_str, "line": line}
    tc_scopes[idx] = scope
}

func tc_lookup_var(name) {
    let i = len(tc_scopes) - 1
    while i >= 0 {
        const scope = tc_scopes[i]
        if scope.has(name) {
            return scope[name]
        }
        i = i - 1
    }
    null
}

func tc_mark_used(name) {
    let i = len(tc_scopes) - 1
    while i >= 0 {
        let scope = tc_scopes[i]
        if scope.has(name) {
            let info = scope[name]
            info["used"] = true
            scope[name] = info
            tc_scopes[i] = scope
            return null
        }
        i = i - 1
    }
}

func tc_is_defined(name) {
    tc_lookup_var(name) != null
}

func tc_is_mutable(name) {
    const info = tc_lookup_var(name)
    if info == null { return false }
    info.mutable
}

func tc_is_builtin(name) {
    KNOWN_BUILTINS.contains(name)
}

// ── Error/Warning Emitters ──────────────────────────────────────

func tc_error_at(line, msg) {
    tc_errors.push(f"line {line}: {msg}")
}

func tc_warn_at(line, msg) {
    tc_warnings.push(f"line {line}: {msg}")
}

// ── Pre-registration Pass ───────────────────────────────────────

func tc_count_required_params(params) {
    let count = 0
    for p in params {
        if p.default_val == null && !p.rest && !p.kwargs {
            count = count + 1
        }
    }
    count
}

func tc_has_rest_param(params) {
    for p in params {
        if p.rest { return true }
    }
    false
}

func tc_register_func(fdef, line) {
    const name = fdef.name
    const params = fdef.params
    const arity = len(params)
    const min_arity = tc_count_required_params(params)
    const has_rest = tc_has_rest_param(params)
    if tc_functions.has(name) {
        const existing = tc_functions[name]
        tc_warn_at(line, f"duplicate definition of function '{name}' (first defined at line {existing.line})")
    }
    tc_functions[name] = {
        "arity": arity, "min_arity": min_arity,
        "has_rest": has_rest, "line": line,
        "return_type": fdef.return_type
    }
}

func tc_preregister(stmts) {
    for stmt in stmts {
        const kind = stmt.kind
        match kind {
            StmtKind::SFuncDef(fdef) => {
                tc_register_func(fdef, stmt.span.start_line)
            },
            StmtKind::SAsyncFuncDef(fdef) => {
                tc_register_func(fdef, stmt.span.start_line)
            },
            StmtKind::SEnumDef(name, variants, _methods) => {
                let variant_names = []
                for v in variants {
                    variant_names.push(v.name)
                }
                tc_enums[name] = variant_names
            },
            StmtKind::SStructDef(name, fields, _methods) => {
                let field_names = []
                for f in fields {
                    field_names.push(f.name)
                }
                tc_structs[name] = field_names
            },
            _ => {}
        }
    }
}

// ── Statement Checking ──────────────────────────────────────────

func tc_check_stmts(stmts) {
    let had_terminal = false
    for stmt in stmts {
        if had_terminal {
            tc_warn_at(stmt.span.start_line, "unreachable code after return/break/continue")
        }
        tc_check_stmt(stmt)
        match stmt.kind {
            StmtKind::SReturn(_) => { had_terminal = true },
            StmtKind::SBreak(_, _) => { had_terminal = true },
            StmtKind::SContinue(_) => { had_terminal = true },
            _ => {}
        }
    }
}

// Check assignment to a variable (must be defined and mutable)
func tc_check_assign(name, line) {
    if !tc_is_defined(name) {
        tc_error_at(line, f"undefined variable '{name}'")
    } else if !tc_is_mutable(name) {
        tc_error_at(line, f"cannot assign to immutable variable '{name}'")
    } else {
        tc_mark_used(name)
    }
}

// Split statement checking into groups to reduce match arm count.
// Group 1: variable declarations and assignments
func tc_check_stmt_vars(kind, line) {
    match kind {
        StmtKind::SConst(name, expr) => {
            tc_check_expr(expr)
            const t = tc_infer_expr_type(expr)
            tc_define_var(name, false, t, line)
            return null
        },
        StmtKind::SLet(name, expr) => {
            tc_check_expr(expr)
            const t = tc_infer_expr_type(expr)
            tc_define_var(name, false, t, line)
            return null
        },
        StmtKind::SLetMut(name, expr) => {
            tc_check_expr(expr)
            const t = tc_infer_expr_type(expr)
            tc_define_var(name, true, t, line)
            return null
        },
        StmtKind::SLetDestructure(pattern, is_mut, expr) => {
            tc_check_expr(expr)
            tc_define_destructure_vars(pattern, is_mut, line)
            return null
        },
        StmtKind::SAssignment(name, expr) => {
            tc_check_expr(expr)
            tc_check_assign(name, line)
            return null
        },
        StmtKind::SCompoundAssign(name, _op, expr) => {
            tc_check_expr(expr)
            tc_check_assign(name, line)
            return null
        },
        StmtKind::SFieldAssign(obj_expr, _field, val_expr) => {
            tc_check_expr(obj_expr)
            tc_check_expr(val_expr)
            return null
        },
        StmtKind::SIndexAssign(obj_expr, idx_expr, val_expr) => {
            tc_check_expr(obj_expr)
            tc_check_expr(idx_expr)
            tc_check_expr(val_expr)
            return null
        },
        StmtKind::STupleAssign(names, expr) => {
            tc_check_expr(expr)
            for name in names { tc_check_assign(name, line) }
            return null
        },
        StmtKind::SIncrement(name) => {
            tc_check_assign(name, line)
            return null
        },
        StmtKind::SDecrement(name) => {
            tc_check_assign(name, line)
            return null
        },
        _ => {}
    }
}

// Group 2: control flow
func tc_check_stmt_flow(kind, line) {
    match kind {
        StmtKind::SReturn(expr) => {
            if expr != null { tc_check_expr(expr) }
            if tc_func_depth == 0 {
                tc_error_at(line, "return statement outside of function")
            }
            return null
        },
        StmtKind::SBreak(_label, expr) => {
            if expr != null { tc_check_expr(expr) }
            if tc_loop_depth == 0 {
                tc_error_at(line, "break statement outside of loop")
            }
            return null
        },
        StmtKind::SContinue(_label) => {
            if tc_loop_depth == 0 {
                tc_error_at(line, "continue statement outside of loop")
            }
            return null
        },
        StmtKind::SIf(cond, then_block, else_block) => {
            tc_check_expr(cond)
            tc_push_scope()
            tc_check_block(then_block)
            tc_pop_scope()
            if else_block != null {
                tc_push_scope()
                tc_check_block(else_block)
                tc_pop_scope()
            }
            return null
        },
        StmtKind::SWhileLoop(_label, cond, body) => {
            tc_check_expr(cond)
            tc_push_scope()
            tc_loop_depth = tc_loop_depth + 1
            tc_check_block(body)
            tc_loop_depth = tc_loop_depth - 1
            tc_pop_scope()
            return null
        },
        StmtKind::SDoWhile(_label, cond, body) => {
            tc_push_scope()
            tc_loop_depth = tc_loop_depth + 1
            tc_check_block(body)
            tc_loop_depth = tc_loop_depth - 1
            tc_pop_scope()
            tc_check_expr(cond)
            return null
        },
        StmtKind::SMatch(expr, arms) => {
            tc_check_expr(expr)
            tc_check_match_arms(arms, line)
            return null
        },
        _ => {}
    }
}

// Group 3: for loops (separate to keep match small)
func tc_check_stmt_for(kind, line) {
    match kind {
        StmtKind::SForLoop(_label, pattern, iterable, body) => {
            tc_check_expr(iterable)
            tc_push_scope()
            tc_loop_depth = tc_loop_depth + 1
            // The parser may pass a plain string or a ForPattern
            if typeof(pattern) == "string" {
                tc_define_var(pattern, false, "unknown", line)
            } else {
                tc_define_for_pattern_vars(pattern, line)
            }
            tc_check_block(body)
            tc_loop_depth = tc_loop_depth - 1
            tc_pop_scope()
            return null
        },
        _ => {}
    }
}

func tc_define_for_pattern_vars(pattern, line) {
    match pattern {
        ForPattern::Single(name) => {
            tc_define_var(name, false, "unknown", line)
        },
        ForPattern::ArrayDestructure(elems) => {
            for e in elems {
                tc_define_destr_elem(e, line)
            }
        },
        ForPattern::MapDestructure(elems) => {
            for e in elems {
                tc_define_destr_elem(e, line)
            }
        },
        _ => {}
    }
}

func tc_define_destr_elem(e, line) {
    match e {
        DestructureElement::DName(n) => {
            tc_define_var(n, false, "unknown", line)
        },
        DestructureElement::DRest(n) => {
            tc_define_var(n, false, "array", line)
        },
        _ => {}
    }
}

// Group 4: definitions and other statements
func tc_check_stmt_defs(kind, line) {
    match kind {
        StmtKind::SFuncDef(fdef) => {
            tc_check_funcdef(fdef, line)
            return null
        },
        StmtKind::SAsyncFuncDef(fdef) => {
            tc_check_funcdef(fdef, line)
            return null
        },
        StmtKind::SOutput(expr) => {
            tc_check_expr(expr)
            return null
        },
        StmtKind::SExprStmt(expr) => {
            tc_check_expr(expr)
            return null
        },
        StmtKind::SStructDef(_name, _fields, methods) => {
            for m in methods { tc_check_funcdef(m, line) }
            return null
        },
        StmtKind::SEnumDef(_name, _variants, methods) => {
            for m in methods { tc_check_funcdef(m, line) }
            return null
        },
        StmtKind::SImplBlock(_type_name, methods) => {
            for m in methods { tc_check_funcdef(m, line) }
            return null
        },
        StmtKind::SImplTrait(_trait_name, _type_name, methods) => {
            for m in methods { tc_check_funcdef(m, line) }
            return null
        },
        _ => {}
    }
}

// Group 5: misc statements
func tc_check_stmt_misc(kind, line) {
    match kind {
        StmtKind::SImportModule(path_parts, _alias, _items) => {
            if len(path_parts) >= 2 {
                const base = path_parts[0]
                const mod_name = path_parts[1]
                if base == "std" && !KNOWN_STDLIB_MODULES.contains(mod_name) {
                    tc_warn_at(line, f"unknown stdlib module '{mod_name}'")
                }
            }
            return null
        },
        StmtKind::SDefer(expr) => {
            tc_check_expr(expr)
            return null
        },
        StmtKind::SSpawn(expr) => {
            tc_check_expr(expr)
            return null
        },
        StmtKind::SThrow(expr) => {
            tc_check_expr(expr)
            return null
        },
        StmtKind::STryCatch(try_block, catch_var, catch_block, finally_block) => {
            tc_push_scope()
            tc_check_block(try_block)
            tc_pop_scope()
            tc_push_scope()
            tc_define_var(catch_var, false, "unknown", line)
            tc_check_block(catch_block)
            tc_pop_scope()
            if finally_block != null {
                tc_push_scope()
                tc_check_block(finally_block)
                tc_pop_scope()
            }
            return null
        },
        StmtKind::STestDef(_name, body) => {
            tc_push_scope()
            tc_func_depth = tc_func_depth + 1
            tc_check_block(body)
            tc_func_depth = tc_func_depth - 1
            tc_pop_scope()
            return null
        },
        StmtKind::SModuleDef(_name, body) => {
            tc_push_scope()
            tc_preregister(body.stmts)
            tc_check_stmts(body.stmts)
            tc_pop_scope()
            return null
        },
        _ => {}
    }
}

func tc_check_stmt(stmt) {
    const kind = stmt.kind
    const line = stmt.span.start_line
    // Try each group; each returns null (no-op) if it doesn't handle the kind
    tc_check_stmt_vars(kind, line)
    tc_check_stmt_flow(kind, line)
    tc_check_stmt_for(kind, line)
    tc_check_stmt_defs(kind, line)
    tc_check_stmt_misc(kind, line)
}

// ── Function Definition Checking ────────────────────────────────

func tc_check_funcdef(fdef, line) {
    tc_push_scope()
    tc_func_depth = tc_func_depth + 1
    for param in fdef.params {
        tc_define_var(param.name, false, param.type_ann, line)
        if param.name == "self" { tc_mark_used("self") }
        if param.default_val != null { tc_check_expr(param.default_val) }
    }
    tc_check_block(fdef.body)
    tc_func_depth = tc_func_depth - 1
    tc_pop_scope()
}

// ── Block Checking ──────────────────────────────────────────────

func tc_check_block(block) {
    if block == null { return null }
    tc_check_stmts(block.stmts)
    if block.tail_expr != null {
        tc_check_expr(block.tail_expr)
    }
}

// ── Destructure Variable Definitions ────────────────────────────

func tc_define_destructure_vars(pattern, is_mutable, line) {
    match pattern {
        DestructurePattern::DArray(elems) => {
            for e in elems { tc_define_destr_elem_mut(e, is_mutable, line) }
        },
        DestructurePattern::DMap(elems) => {
            for e in elems { tc_define_destr_elem_mut(e, is_mutable, line) }
        },
        DestructurePattern::DTuple(elems) => {
            for e in elems { tc_define_destr_elem_mut(e, is_mutable, line) }
        },
        _ => {}
    }
}

func tc_define_destr_elem_mut(e, is_mutable, line) {
    match e {
        DestructureElement::DName(n) => {
            tc_define_var(n, is_mutable, "unknown", line)
        },
        DestructureElement::DRest(n) => {
            tc_define_var(n, is_mutable, "array", line)
        },
        _ => {}
    }
}

// ── Expression Checking ─────────────────────────────────────────
// Split into groups to reduce match arm count per function.

func tc_check_expr(expr) {
    if expr == null { return null }
    const kind = expr.kind
    const line = expr.span.start_line
    // Try each group
    tc_check_expr_basic(kind, line)
    tc_check_expr_compound(kind, line)
    tc_check_expr_advanced(kind, line)
}

// Group 1: literals, variables, basic ops
func tc_check_expr_basic(kind, line) {
    match kind {
        ExprKind::ELiteral(lit) => {
            tc_check_literal(lit)
            return null
        },
        ExprKind::EVariable(name) => {
            if !tc_is_defined(name) && !tc_enums.has(name) && !tc_structs.has(name) && !tc_functions.has(name) {
                tc_error_at(line, f"undefined variable '{name}'")
            } else {
                tc_mark_used(name)
            }
            return null
        },
        ExprKind::EBinaryOp(op, left, right) => {
            tc_check_expr(left)
            tc_check_expr(right)
            return null
        },
        ExprKind::EUnaryOp(op, operand) => {
            tc_check_expr(operand)
            return null
        },
        ExprKind::ECall(name, args, _type_args) => {
            for arg in args { tc_check_expr(arg) }
            tc_validate_call(name, args, line)
            return null
        },
        ExprKind::EMethodCall(obj, _method, args, _type_args) => {
            tc_check_expr(obj)
            for arg in args { tc_check_expr(arg) }
            return null
        },
        ExprKind::EPlaceholder => { return true },
        _ => {}
    }
}

func tc_check_literal(lit) {
    match lit {
        Literal::ArrayLit(elems) => {
            for e in elems { tc_check_expr(e) }
        },
        Literal::MapLit(pairs) => {
            for pair in pairs {
                tc_check_expr(pair[0])
                tc_check_expr(pair[1])
            }
        },
        Literal::SetLit(elems) => {
            for e in elems { tc_check_expr(e) }
        },
        _ => {}
    }
}

func tc_validate_call(name, args, line) {
    if tc_functions.has(name) {
        const sig = tc_functions[name]
        const n_args = len(args)
        if !sig.has_rest {
            if n_args < sig.min_arity {
                tc_error_at(line, f"function '{name}' expects at least {sig.min_arity} arguments, got {n_args}")
            } else if n_args > sig.arity {
                tc_error_at(line, f"function '{name}' expects at most {sig.arity} arguments, got {n_args}")
            }
        } else {
            if n_args < sig.min_arity {
                tc_error_at(line, f"function '{name}' expects at least {sig.min_arity} arguments, got {n_args}")
            }
        }
    } else if !tc_is_builtin(name) && !tc_enums.has(name) && !tc_structs.has(name) && !tc_is_defined(name) {
        tc_error_at(line, f"undefined function '{name}'")
    }
}

// Group 2: compound expressions (control flow, blocks, pipes)
func tc_check_expr_compound(kind, line) {
    match kind {
        ExprKind::EPipe(left, right) => {
            tc_check_expr(left)
            tc_check_expr(right)
            return null
        },
        ExprKind::EIfElse(cond, then_expr, else_expr) => {
            tc_check_expr(cond)
            tc_check_expr(then_expr)
            if else_expr != null { tc_check_expr(else_expr) }
            return null
        },
        ExprKind::EBlock(block) => {
            tc_push_scope()
            tc_check_block(block)
            tc_pop_scope()
            return null
        },
        ExprKind::EIndex(obj, idx) => {
            tc_check_expr(obj)
            tc_check_expr(idx)
            return null
        },
        ExprKind::EFieldAccess(obj, _field) => {
            tc_check_expr(obj)
            return null
        },
        ExprKind::ERange(start, end, _inclusive) => {
            tc_check_expr(start)
            tc_check_expr(end)
            return null
        },
        ExprKind::EAwait(inner) => {
            tc_check_expr(inner)
            return null
        },
        ExprKind::ESpawn(inner) => {
            tc_check_expr(inner)
            return null
        },
        ExprKind::EYield(inner) => {
            if inner != null { tc_check_expr(inner) }
            return null
        },
        _ => {}
    }
}

// Group 3: advanced expressions (lambda, match, comprehensions, constructs)
func tc_check_expr_advanced(kind, line) {
    match kind {
        ExprKind::ELambda(params, body) => {
            tc_push_scope()
            tc_func_depth = tc_func_depth + 1
            for p in params { tc_define_var(p.name, false, p.type_ann, line) }
            tc_check_expr(body)
            tc_func_depth = tc_func_depth - 1
            tc_pop_scope()
        },
        ExprKind::EMatch(subject, arms) => {
            tc_check_expr(subject)
            tc_check_match_arms(arms, line)
        },
        ExprKind::EStringInterp(parts) => {
            tc_check_interp_parts(parts)
        },
        ExprKind::ENullCoalesce(left, right) => {
            tc_check_expr(left)
            tc_check_expr(right)
        },
        ExprKind::EOptionalChain(obj, _field) => {
            tc_check_expr(obj)
        },
        ExprKind::ESpread(inner) => {
            tc_check_expr(inner)
        },
        ExprKind::ELoop(body) => {
            tc_push_scope()
            tc_loop_depth = tc_loop_depth + 1
            tc_check_block(body)
            tc_loop_depth = tc_loop_depth - 1
            tc_pop_scope()
        },
        ExprKind::ETryCatch(try_expr, catch_var, catch_expr) => {
            tc_check_expr(try_expr)
            tc_push_scope()
            tc_define_var(catch_var, false, "unknown", line)
            tc_check_expr(catch_expr)
            tc_pop_scope()
        },
        ExprKind::EListComp(expr, pattern, iterable, cond) => {
            tc_check_expr(iterable)
            tc_push_scope()
            tc_define_var(pattern, false, "unknown", line)
            if cond != null { tc_check_expr(cond) }
            tc_check_expr(expr)
            tc_pop_scope()
        },
        ExprKind::EMapComp(key_expr, val_expr, pattern, iterable, cond) => {
            tc_check_expr(iterable)
            tc_push_scope()
            tc_define_var(pattern, false, "unknown", line)
            if cond != null { tc_check_expr(cond) }
            tc_check_expr(key_expr)
            tc_check_expr(val_expr)
            tc_pop_scope()
        },
        ExprKind::EEnumConstruct(enum_name, variant_name, args) => {
            for arg in args { tc_check_expr(arg) }
            if tc_enums.has(enum_name) {
                const variants = tc_enums[enum_name]
                if !variants.contains(variant_name) {
                    tc_error_at(line, f"enum '{enum_name}' has no variant '{variant_name}'")
                }
            }
        },
        ExprKind::EStructConstruct(struct_name, field_pairs) => {
            for pair in field_pairs { tc_check_expr(pair[1]) }
            if tc_structs.has(struct_name) {
                const known_fields = tc_structs[struct_name]
                for pair in field_pairs {
                    if !known_fields.contains(pair[0]) {
                        tc_warn_at(line, f"struct '{struct_name}' has no field '{pair[0]}'")
                    }
                }
            }
        },
        ExprKind::ETryPropagate(inner) => {
            tc_check_expr(inner)
        },
        ExprKind::ETupleLiteral(elems) => {
            for e in elems { tc_check_expr(e) }
        },
        _ => {}
    }
}

func tc_check_interp_parts(parts) {
    for part in parts {
        match part {
            StringPart::ExprPart(expr) => {
                tc_check_expr(expr)
            },
            _ => {}
        }
    }
}

// ── Match Arm Checking ──────────────────────────────────────────

func tc_check_match_arms(arms, line) {
    if len(arms) == 0 {
        tc_warn_at(line, "empty match expression")
        return null
    }

    let has_wildcard = false
    tc_enum_patterns = {"__s": true}

    for arm in arms {
        tc_push_scope()
        tc_define_pattern_vars(arm.pattern, line)
        if arm.guard != null { tc_check_expr(arm.guard) }
        tc_check_expr(arm.body)
        tc_pop_scope()

        tc_analyze_pattern_coverage(arm.pattern)
        if tc_pattern_is_wildcard(arm.pattern) {
            has_wildcard = true
        }
    }

    // Check exhaustiveness for enum matches
    if !has_wildcard {
        for enum_name in tc_enum_patterns.keys() {
            if enum_name == "__s" { continue }
            if tc_enums.has(enum_name) {
                const all_variants = tc_enums[enum_name]
                const matched_variants = tc_enum_patterns[enum_name]
                let missing = []
                for v in all_variants {
                    if !matched_variants.contains(v) {
                        missing.push(v)
                    }
                }
                if len(missing) > 0 {
                    const missing_str = missing.join(", ")
                    tc_error_at(line, f"non-exhaustive match on enum '{enum_name}': missing variants {missing_str}")
                }
            }
        }
    }
}

func tc_pattern_is_wildcard(pattern) {
    match pattern {
        Pattern::PWildcard => true,
        Pattern::PVariable(_) => true,
        _ => false
    }
}

func tc_analyze_pattern_coverage(pattern) {
    match pattern {
        Pattern::PEnum(enum_name, variant_name, _) => {
            if !tc_enum_patterns.has(enum_name) {
                tc_enum_patterns[enum_name] = []
            }
            let matched = tc_enum_patterns[enum_name]
            if !matched.contains(variant_name) {
                matched.push(variant_name)
                tc_enum_patterns[enum_name] = matched
            }
        },
        Pattern::POr(sub_patterns) => {
            for p in sub_patterns {
                tc_analyze_pattern_coverage(p)
            }
        },
        _ => {}
    }
}

func tc_define_pattern_vars(pattern, line) {
    match pattern {
        Pattern::PVariable(name) => {
            if name != "_" { tc_define_var(name, false, "unknown", line) }
        },
        Pattern::PEnum(_enum_name, _variant, bindings) => {
            for b in bindings { tc_define_pattern_vars(b, line) }
        },
        Pattern::PArray(elems) => {
            for e in elems { tc_define_pattern_vars(e, line) }
        },
        Pattern::PMap(entries) => {
            for e in entries { tc_define_pattern_vars(e, line) }
        },
        Pattern::POr(sub_patterns) => {
            if len(sub_patterns) > 0 { tc_define_pattern_vars(sub_patterns[0], line) }
        },
        Pattern::PRest(name) => {
            if name != "_" { tc_define_var(name, false, "array", line) }
        },
        Pattern::PBinding(name, inner) => {
            tc_define_var(name, false, "unknown", line)
            tc_define_pattern_vars(inner, line)
        },
        Pattern::PType(name, _type) => {
            if name != "_" { tc_define_var(name, false, _type, line) }
        },
        _ => {}
    }
}

// ── Basic Type Inference ────────────────────────────────────────

func tc_infer_expr_type(expr) {
    if expr == null { return "unknown" }
    const kind = expr.kind
    match kind {
        ExprKind::ELiteral(lit) => { return tc_infer_literal_type(lit) },
        ExprKind::EVariable(name) => {
            const info = tc_lookup_var(name)
            if info != null && info.typ != "" && info.typ != "unknown" {
                return info.typ
            }
            return "unknown"
        },
        ExprKind::EBinaryOp(op, left, right) => {
            return tc_infer_binop_type(op, left, right)
        },
        ExprKind::EUnaryOp(op, operand) => {
            return tc_infer_unop_type(op, operand)
        },
        ExprKind::ECall(name, _args, _) => {
            if tc_functions.has(name) {
                const sig = tc_functions[name]
                if sig.return_type != "" { return sig.return_type }
            }
            return "unknown"
        },
        ExprKind::EStringInterp(_) => { return "string" },
        ExprKind::ERange(_, _, _) => { return "array" },
        ExprKind::ETupleLiteral(_) => { return "tuple" },
        ExprKind::EEnumConstruct(name, _, _) => { return name },
        ExprKind::EStructConstruct(name, _) => { return name },
        _ => { return "unknown" }
    }
}

func tc_infer_literal_type(lit) {
    match lit {
        Literal::IntLit(_) => "int",
        Literal::FloatLit(_) => "float",
        Literal::StringLit(_) => "string",
        Literal::BoolLit(_) => "bool",
        Literal::NullLit => "null",
        Literal::ArrayLit(_) => "array",
        Literal::MapLit(_) => "map",
        Literal::SetLit(_) => "set",
        _ => "unknown"
    }
}

func tc_infer_binop_type(op, left, right) {
    // Comparison and logical ops always return bool
    match op {
        BinOp::Eq => { return "bool" },
        BinOp::NotEq => { return "bool" },
        BinOp::Lt => { return "bool" },
        BinOp::Gt => { return "bool" },
        BinOp::LtEq => { return "bool" },
        BinOp::GtEq => { return "bool" },
        BinOp::And => { return "bool" },
        BinOp::Or => { return "bool" },
        BinOp::In => { return "bool" },
        _ => {}
    }
    // Arithmetic ops: infer from operand types
    const lt = tc_infer_expr_type(left)
    const rt = tc_infer_expr_type(right)
    match op {
        BinOp::Add => {
            if lt == "string" || rt == "string" { return "string" }
            if lt == "float" || rt == "float" { return "float" }
            if lt == "int" && rt == "int" { return "int" }
            return "unknown"
        },
        BinOp::Sub => {
            if lt == "float" || rt == "float" { return "float" }
            if lt == "int" && rt == "int" { return "int" }
            return "unknown"
        },
        BinOp::Mul => {
            if lt == "float" || rt == "float" { return "float" }
            if lt == "int" && rt == "int" { return "int" }
            return "unknown"
        },
        BinOp::Div => {
            if lt == "float" || rt == "float" { return "float" }
            if lt == "int" && rt == "int" { return "int" }
            return "unknown"
        },
        BinOp::Mod => {
            if lt == "int" && rt == "int" { return "int" }
            return "unknown"
        },
        _ => { return "int" }
    }
}

func tc_infer_unop_type(op, operand) {
    match op {
        UnOp::Not => "bool",
        UnOp::Neg => {
            const t = tc_infer_expr_type(operand)
            if t == "float" { "float" } else { "int" }
        },
        _ => "unknown"
    }
}

// ── Entry Point ─────────────────────────────────────────────────

func check(program) {
    // Reset state
    tc_scopes = []
    tc_functions = {"__s": true}
    tc_enums = {"__s": true}
    tc_structs = {"__s": true}
    tc_errors = []
    tc_warnings = []
    tc_loop_depth = 0
    tc_func_depth = 0

    // Initialize global scope
    tc_push_scope()

    // Pass 1: pre-register functions, enums, structs
    tc_preregister(program.statements)

    // Pass 2: check all statements
    tc_check_stmts(program.statements)

    // Pop global scope (emits unused variable warnings)
    tc_pop_scope()

    // Return (errors, warnings) as a two-element array
    let result = []
    result.push(tc_errors)
    result.push(tc_warnings)
    result
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Generic Type Parameter Tracking and Validation
// ═══════════════════════════════════════════════════════════════════

// Generic type parameters in scope: name -> { "constraints": [...], "bound": type_str|null }
let tc_type_params = {"__s": true}

// Register generic type parameters for a function or struct
func tc_register_type_params(type_params) {
    for tp in type_params {
        const name = if typeof(tp) == "string" { tp } else { tp[0] }
        let constraints = []
        if typeof(tp) == "array" && len(tp) > 1 {
            constraints = tp.slice(1, len(tp))
        }
        tc_type_params[name] = {"constraints": constraints, "bound": null}
    }
}

// Clear generic type parameters
func tc_clear_type_params() {
    tc_type_params = {"__s": true}
}

// Check if a name is a known type parameter
func tc_is_type_param(name) {
    tc_type_params.has(name) && name != "__s"
}

// Validate that a generic constraint is satisfiable
func tc_check_generic_constraint(param_name, constraint_name, line) {
    // Check the constraint refers to a known interface/trait
    if !tc_structs.has(constraint_name) && !KNOWN_STDLIB_MODULES.contains(constraint_name) {
        // It could be an interface
        let found = false
        for k in tc_type_params.keys() {
            if k == constraint_name { found = true }
        }
        if !found {
            tc_warn_at(line, f"generic constraint '{constraint_name}' on '{param_name}' references unknown type")
        }
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Full Type Inference Engine (Bidirectional)
// ═══════════════════════════════════════════════════════════════════

// Type representation: strings for simple types, maps for complex types
// Simple: "int", "float", "string", "bool", "null", "unknown", "void"
// Array: {"kind": "array", "element": type}
// Map: {"kind": "map", "key": type, "value": type}
// Function: {"kind": "function", "params": [types], "return": type}
// Generic: {"kind": "generic", "name": string, "args": [types]}
// Optional: {"kind": "optional", "inner": type}

func tc_type_to_string(typ) {
    if typeof(typ) == "string" { return typ }
    if typeof(typ) != "map" { return "unknown" }
    if !typ.has("kind") { return "unknown" }
    match typ["kind"] {
        "array" => f"Array<{tc_type_to_string(typ['element'])}>",
        "map" => f"Map<{tc_type_to_string(typ['key'])}, {tc_type_to_string(typ['value'])}>",
        "function" => {
            let param_strs = []
            if typ.has("params") {
                for p in typ["params"] { param_strs.push(tc_type_to_string(p)) }
            }
            const ret = if typ.has("return") { tc_type_to_string(typ["return"]) } else { "void" }
            f"({param_strs.join(', ')}) -> {ret}"
        },
        "generic" => {
            let arg_strs = []
            if typ.has("args") {
                for a in typ["args"] { arg_strs.push(tc_type_to_string(a)) }
            }
            f"{typ['name']}<{arg_strs.join(', ')}>"
        },
        "optional" => f"{tc_type_to_string(typ['inner'])}?",
        "tuple" => {
            let elem_strs = []
            if typ.has("elements") {
                for e in typ["elements"] { elem_strs.push(tc_type_to_string(e)) }
            }
            f"({elem_strs.join(', ')})"
        },
        _ => "unknown"
    }
}

// Check if two types are compatible
func tc_types_compatible(expected, actual) {
    if expected == "unknown" || actual == "unknown" { return true }
    if expected == actual { return true }
    // Numeric widening
    if expected == "float" && actual == "int" { return true }
    if expected == "float64" && actual == "int64" { return true }
    // null is compatible with optional types
    if actual == "null" { return true }
    // Type parameter is always compatible
    if tc_is_type_param(expected) || tc_is_type_param(actual) { return true }
    // Complex type compatibility
    if typeof(expected) == "map" && typeof(actual) == "map" {
        if expected.has("kind") && actual.has("kind") && expected["kind"] == actual["kind"] {
            return true // Simplified: check sub-components in full version
        }
    }
    false
}

// Infer the type of an expression
func tc_infer_expr_type_full(expr) {
    if expr == null { return "unknown" }
    const ek = expr.kind
    match ek {
        ExprKind::EIntLiteral(_) => "int",
        ExprKind::ELiteral(lit) => {
            match lit {
                Literal::LInt(_) => "int",
                Literal::LFloat(_) => "float",
                Literal::LString(_) => "string",
                Literal::LBool(_) => "bool",
                _ => "unknown"
            }
        },
        ExprKind::EFloatLiteral(_) => "float",
        ExprKind::EStringLiteral(_) => "string",
        ExprKind::EBoolLiteral(_) => "bool",
        ExprKind::ENullLiteral => "null",
        ExprKind::EVariable(name) => tc_lookup_var_type(name),
        ExprKind::EArrayLiteral(elems) => {
            if len(elems) > 0 {
                const elem_type = tc_infer_expr_type_full(elems[0])
                {"kind": "array", "element": elem_type}
            } else {
                {"kind": "array", "element": "unknown"}
            }
        },
        ExprKind::EMapLiteral(_) => {"kind": "map", "key": "string", "value": "unknown"},
        ExprKind::EBinaryOp(op, left, right) => tc_infer_binop_type_full(op, left, right),
        ExprKind::EUnaryOp(op, operand) => tc_infer_unop_type(op, operand),
        ExprKind::ECall(name, _, _) => tc_infer_call_return_type(name),
        ExprKind::EMethodCall(obj, method, _, _) => tc_infer_method_return_type(obj, method),
        ExprKind::ELambda(params, _body) => {
            let param_types = []
            for p in params { param_types.push("unknown") }
            {"kind": "function", "params": param_types, "return": "unknown"}
        },
        ExprKind::EIfElse(_, then_block, _) => {
            if then_block != null {
                const stmts = then_block.stmts
                if len(stmts) > 0 {
                    const last = stmts[len(stmts) - 1]
                    match last.kind {
                        StmtKind::SExprStmt(e) => tc_infer_expr_type_full(e),
                        _ => "unknown"
                    }
                } else if then_block.tail_expr != null {
                    tc_infer_expr_type_full(then_block.tail_expr)
                } else { "unknown" }
            } else { "unknown" }
        },
        ExprKind::ERange(_, _, _) => {"kind": "array", "element": "int"},
        ExprKind::EMatch(_, arms) => {
            // Return type is the type of the first arm's body
            if len(arms) > 0 {
                "unknown" // Would need to check arm bodies
            } else { "unknown" }
        },
        ExprKind::ENullCoalesce(left, _right) => tc_infer_expr_type_full(left),
        ExprKind::EStringInterp(_) => "string",
        ExprKind::ETupleLiteral(elems) => {
            let elem_types = []
            for e in elems { elem_types.push(tc_infer_expr_type_full(e)) }
            {"kind": "tuple", "elements": elem_types}
        },
        ExprKind::EStructConstruct(name, _) => name,
        ExprKind::EEnumConstruct(name, _, _) => name,
        _ => "unknown"
    }
}

func tc_infer_binop_type_full(op, left, right) {
    const lt = tc_infer_expr_type_full(left)
    const rt = tc_infer_expr_type_full(right)
    match op {
        BinOp::Add => {
            if lt == "string" || rt == "string" { return "string" }
            if lt == "float" || rt == "float" { return "float" }
            if lt == "int" && rt == "int" { return "int" }
            "unknown"
        },
        BinOp::Sub => {
            if lt == "float" || rt == "float" { return "float" }
            if lt == "int" && rt == "int" { return "int" }
            "unknown"
        },
        BinOp::Mul => {
            if lt == "float" || rt == "float" { return "float" }
            if lt == "int" && rt == "int" { return "int" }
            "unknown"
        },
        BinOp::Div => {
            if lt == "float" || rt == "float" { return "float" }
            if lt == "int" && rt == "int" { return "int" }
            "unknown"
        },
        BinOp::Mod => { if lt == "int" && rt == "int" { "int" } else { "unknown" } },
        BinOp::Eq => "bool",
        BinOp::Ne => "bool",
        BinOp::Lt => "bool",
        BinOp::Le => "bool",
        BinOp::Gt => "bool",
        BinOp::Ge => "bool",
        BinOp::And => "bool",
        BinOp::Or => "bool",
        _ => "unknown"
    }
}

// Lookup variable type in scope
func tc_lookup_var_type(name) {
    let idx = len(tc_scopes) - 1
    while idx >= 0 {
        const scope = tc_scopes[idx]
        if scope.has(name) {
            const info = scope[name]
            return info.typ
        }
        idx = idx - 1
    }
    "unknown"
}

// Infer return type of a function call
func tc_infer_call_return_type(name) {
    // Check builtin return types
    if name == "len" { return "int" }
    if name == "typeof" { return "string" }
    if name == "to_string" { return "string" }
    if name == "to_int" { return "int" }
    if name == "to_float" { return "float" }
    if name == "range" { return {"kind": "array", "element": "int"} }
    if name == "keys" { return {"kind": "array", "element": "string"} }
    if name == "values" { return {"kind": "array", "element": "unknown"} }
    if name == "input" { return "string" }
    if name == "abs" { return "float" }
    if name == "floor" || name == "ceil" || name == "round" { return "int" }
    if name == "sqrt" || name == "pow" { return "float" }
    if name == "min" || name == "max" { return "unknown" }
    if name == "contains" || name == "starts_with" || name == "ends_with" { return "bool" }
    if name == "is_null" || name == "is_int" || name == "is_float" || name == "is_string" || name == "is_bool" || name == "is_array" || name == "is_map" { return "bool" }
    if name == "split" || name == "chars" { return {"kind": "array", "element": "string"} }
    if name == "join" || name == "trim" || name == "replace" { return "string" }
    if name == "sort" || name == "reverse" || name == "filter" || name == "map" || name == "slice" || name == "append" { return {"kind": "array", "element": "unknown"} }
    if name == "reduce" { return "unknown" }
    if name == "parse_int" { return "int" }
    if name == "parse_float" { return "float" }
    "unknown"
}

// Infer return type of a method call
func tc_infer_method_return_type(obj_expr, method) {
    const obj_type = tc_infer_expr_type_full(obj_expr)
    const obj_type_str = if typeof(obj_type) == "string" { obj_type } else {
        if typeof(obj_type) == "map" && obj_type.has("kind") { obj_type["kind"] } else { "unknown" }
    }

    // String methods
    if obj_type_str == "string" {
        if method == "len" || method == "length" || method == "index_of" || method == "count" || method == "char_code" { return "int" }
        if method == "split" || method == "lines" || method == "words" || method == "chars" { return {"kind": "array", "element": "string"} }
        if method == "contains" || method == "starts_with" || method == "ends_with" || method == "is_empty" || method == "is_ascii" || method == "is_numeric" || method == "is_alpha" { return "bool" }
        if method == "to_int" { return "int" }
        if method == "to_float" { return "float" }
        return "string"
    }

    // Array methods
    if obj_type_str == "array" {
        if method == "len" || method == "length" || method == "index_of" || method == "find_index" { return "int" }
        if method == "contains" || method == "includes" || method == "every" || method == "some" || method == "is_empty" { return "bool" }
        if method == "join" { return "string" }
        if method == "sum" || method == "product" { return "unknown" }
        if method == "average" { return "float" }
        if method == "first" || method == "last" || method == "find" || method == "pop" || method == "min" || method == "max" { return "unknown" }
        if method == "to_string" { return "string" }
        if method == "to_map" { return {"kind": "map", "key": "string", "value": "unknown"} }
        if method == "group_by" || method == "frequencies" { return {"kind": "map", "key": "string", "value": "unknown"} }
        if method == "partition" { return {"kind": "tuple", "elements": [{"kind": "array", "element": "unknown"}, {"kind": "array", "element": "unknown"}]} }
        return {"kind": "array", "element": "unknown"}
    }

    // Map methods
    if obj_type_str == "map" {
        if method == "len" { return "int" }
        if method == "has" || method == "contains_key" || method == "contains_value" || method == "is_empty" || method == "every" || method == "some" { return "bool" }
        if method == "keys" { return {"kind": "array", "element": "string"} }
        if method == "values" || method == "entries" || method == "to_entries" || method == "to_array" { return {"kind": "array", "element": "unknown"} }
        if method == "to_string" || method == "to_json" { return "string" }
        return {"kind": "map", "key": "string", "value": "unknown"}
    }

    "unknown"
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Interface Satisfaction Checking
// ═══════════════════════════════════════════════════════════════════

// Interface definitions: name -> { "methods": [method_sigs] }
let tc_interfaces = {"__s": true}

// Register an interface
func tc_register_interface(name, methods) {
    let method_sigs = []
    for m in methods {
        method_sigs.push({"name": to_string(m), "params": [], "return": "unknown"})
    }
    tc_interfaces[name] = {"methods": method_sigs}
}

// Check if a type satisfies an interface
func tc_check_interface_satisfaction(type_name, interface_name, line) {
    if !tc_interfaces.has(interface_name) || interface_name == "__s" { return true }
    const iface = tc_interfaces[interface_name]
    const required_methods = iface["methods"]

    for req in required_methods {
        const method_name = req["name"]
        // Check if type_name has an impl with this method
        let found = false
        // Look through registered functions for TypeName.method
        if tc_functions.has(f"{type_name}.{method_name}") {
            found = true
        }
        if !found {
            tc_error_at(line, f"type '{type_name}' does not satisfy interface '{interface_name}': missing method '{method_name}'")
        }
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Null Safety Analysis
// ═══════════════════════════════════════════════════════════════════

// Track which variables are known to be non-null after checks
let tc_non_null_vars = {"__s": true}

// Enter a null-checked scope (e.g., inside `if x != null`)
func tc_enter_null_checked(var_name) {
    tc_non_null_vars[var_name] = true
}

// Exit null-checked scope
func tc_exit_null_checked(var_name) {
    if tc_non_null_vars.has(var_name) {
        tc_non_null_vars = tc_non_null_vars.delete(var_name)
    }
}

// Check if a variable is known non-null
func tc_is_known_non_null(var_name) {
    tc_non_null_vars.has(var_name) && var_name != "__s"
}

// Analyze an if-condition for null checks
func tc_analyze_null_check(cond) {
    if cond == null { return null }
    const ek = cond.kind
    match ek {
        ExprKind::EBinaryOp(op, left, right) => {
            match op {
                BinOp::Ne => {
                    // Check for: x != null
                    match left.kind {
                        ExprKind::EVariable(name) => {
                            match right.kind {
                                ExprKind::ENullLiteral => { return name },
                                _ => {}
                            }
                        },
                        _ => {}
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
    null
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Pattern Type Checking
// ═══════════════════════════════════════════════════════════════════

func tc_check_pattern(pattern, subject_type, line) {
    if pattern == null { return null }
    if typeof(pattern) == "string" {
        // Wildcard or variable binding
        if pattern == "_" { return null }
        tc_define_var(pattern, false, subject_type, line)
        return null
    }
    if typeof(pattern) == "map" && pattern.has("kind") {
        const pk = pattern["kind"]
        match pk {
            "literal" => {
                // Check literal pattern type matches subject
                const lit_type = tc_infer_literal_type(pattern["value"])
                if !tc_types_compatible(subject_type, lit_type) {
                    tc_warn_at(line, f"pattern type '{lit_type}' may not match subject type '{subject_type}'")
                }
            },
            "enum" => {
                const enum_name = pattern["enum"]
                const variant = pattern["variant"]
                if tc_enums.has(enum_name) {
                    const variants = tc_enums[enum_name]
                    if !variants.contains(variant) {
                        tc_error_at(line, f"enum '{enum_name}' has no variant '{variant}'")
                    }
                }
                if pattern.has("bindings") {
                    for b in pattern["bindings"] {
                        tc_define_var(b, false, "unknown", line)
                    }
                }
            },
            "struct" => {
                const struct_name = pattern["struct"]
                if pattern.has("fields") {
                    for f in pattern["fields"] {
                        if typeof(f) == "array" && len(f) >= 2 {
                            tc_define_var(f[1], false, "unknown", line)
                        }
                    }
                }
            },
            "array" => {
                if pattern.has("elements") {
                    for elem in pattern["elements"] {
                        tc_check_pattern(elem, "unknown", line)
                    }
                }
            },
            "rest" => {
                if pattern.has("name") {
                    tc_define_var(pattern["name"], false, "array", line)
                }
            },
            "guard" => {
                if pattern.has("inner") {
                    tc_check_pattern(pattern["inner"], subject_type, line)
                }
                if pattern.has("guard") {
                    tc_check_expr(pattern["guard"])
                }
            },
            "or" => {
                if pattern.has("left") {
                    tc_check_pattern(pattern["left"], subject_type, line)
                }
                if pattern.has("right") {
                    tc_check_pattern(pattern["right"], subject_type, line)
                }
            },
            "range" => {
                // Range patterns: start..end
            },
            _ => {}
        }
    }
}

func tc_infer_literal_type(val) {
    if val == null { return "null" }
    const t = typeof(val)
    if t == "int64" || t == "int" { return "int" }
    if t == "float64" || t == "float" { return "float" }
    if t == "string" { return "string" }
    if t == "bool" { return "bool" }
    "unknown"
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Closure Capture Type Analysis
// ═══════════════════════════════════════════════════════════════════

// Analyze which variables a closure captures
func tc_analyze_captures(lambda_body) {
    let captured = []
    if lambda_body == null { return captured }

    // Walk the body and find free variables
    if typeof(lambda_body) == "map" && lambda_body.has("stmts") {
        for s in lambda_body.stmts {
            tc_collect_free_vars(s, captured)
        }
    }
    captured
}

func tc_collect_free_vars(stmt, captured) {
    if stmt == null { return null }
    const sk = stmt.kind
    match sk {
        StmtKind::SExprStmt(expr) => tc_collect_free_vars_expr(expr, captured),
        StmtKind::SReturn(expr) => {
            if expr != null { tc_collect_free_vars_expr(expr, captured) }
        },
        _ => {}
    }
}

func tc_collect_free_vars_expr(expr, captured) {
    if expr == null { return null }
    const ek = expr.kind
    match ek {
        ExprKind::EVariable(name) => {
            // Check if this variable is from an outer scope
            let in_current = false
            if len(tc_scopes) > 0 {
                const current = tc_scopes[len(tc_scopes) - 1]
                if current.has(name) { in_current = true }
            }
            if !in_current && !captured.contains(name) {
                captured.push(name)
            }
        },
        ExprKind::EBinaryOp(_, left, right) => {
            tc_collect_free_vars_expr(left, captured)
            tc_collect_free_vars_expr(right, captured)
        },
        ExprKind::EUnaryOp(_, operand) => {
            tc_collect_free_vars_expr(operand, captured)
        },
        ExprKind::ECall(_, args, _) => {
            if args != null {
                for arg in args { tc_collect_free_vars_expr(arg, captured) }
            }
        },
        ExprKind::EMethodCall(obj, _, args, _) => {
            tc_collect_free_vars_expr(obj, captured)
            if args != null {
                for arg in args { tc_collect_free_vars_expr(arg, captured) }
            }
        },
        ExprKind::EFieldAccess(obj, _) => {
            tc_collect_free_vars_expr(obj, captured)
        },
        ExprKind::EIndex(obj, idx) => {
            tc_collect_free_vars_expr(obj, captured)
            tc_collect_free_vars_expr(idx, captured)
        },
        _ => {}
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Lint Warning Rules (Integrated)
// ═══════════════════════════════════════════════════════════════════

// W100: Unused variables (already implemented via tc_pop_scope)

// W101: Unused imports
func tc_check_unused_imports(statements) {
    let imported_names = {"__s": true}
    let used_names = {"__s": true}

    // Collect imported names
    for stmt in statements {
        const sk = stmt.kind
        match sk {
            StmtKind::SImportModule(path_parts, alias, _items) => {
                const name = if alias != null && alias != "" { alias } else {
                    if len(path_parts) > 0 { path_parts[len(path_parts) - 1] } else { "" }
                }
                if name != "" {
                    imported_names[name] = stmt.span.start_line
                }
            },
            _ => {}
        }
    }

    // Collect used names (simplified: check all identifiers)
    for stmt in statements {
        tc_collect_used_names_stmt(stmt, used_names)
    }

    // Check for unused imports
    for name in imported_names.keys() {
        if name == "__s" { continue }
        if !used_names.has(name) {
            tc_warn_at(imported_names[name], f"unused import '{name}' (W101)")
        }
    }
}

func tc_collect_used_names_stmt(stmt, names) {
    if stmt == null { return null }
    const sk = stmt.kind
    match sk {
        StmtKind::SExprStmt(expr) => tc_collect_used_names_expr(expr, names),
        StmtKind::SConst(_, expr) => { if expr != null { tc_collect_used_names_expr(expr, names) } },
        StmtKind::SLet(_, expr) => { if expr != null { tc_collect_used_names_expr(expr, names) } },
        StmtKind::SLetMut(_, expr) => { if expr != null { tc_collect_used_names_expr(expr, names) } },
        StmtKind::SReturn(expr) => { if expr != null { tc_collect_used_names_expr(expr, names) } },
        _ => {}
    }
}

func tc_collect_used_names_expr(expr, names) {
    if expr == null { return null }
    const ek = expr.kind
    match ek {
        ExprKind::EVariable(name) => { names[name] = true },
        ExprKind::ECall(name, args, _) => {
            names[name] = true
            if args != null { for arg in args { tc_collect_used_names_expr(arg, names) } }
        },
        ExprKind::EBinaryOp(_, left, right) => {
            tc_collect_used_names_expr(left, names)
            tc_collect_used_names_expr(right, names)
        },
        ExprKind::EUnaryOp(_, operand) => tc_collect_used_names_expr(operand, names),
        ExprKind::EMethodCall(obj, _, args, _) => {
            tc_collect_used_names_expr(obj, names)
            if args != null { for arg in args { tc_collect_used_names_expr(arg, names) } }
        },
        ExprKind::EFieldAccess(obj, _) => tc_collect_used_names_expr(obj, names),
        ExprKind::EIndex(obj, idx) => {
            tc_collect_used_names_expr(obj, names)
            tc_collect_used_names_expr(idx, names)
        },
        _ => {}
    }
}

// W200: Naming convention checks
func tc_check_naming_convention(name, kind, line) {
    if len(name) == 0 { return null }
    if starts_with(name, "_") { return null } // Skip private/unused

    if kind == "function" || kind == "variable" || kind == "parameter" {
        // Should be snake_case
        if name != to_lower(name) && !name.contains("_") {
            // Might be camelCase
            let has_upper = false
            let i = 1
            while i < len(name) {
                if name[i] >= "A" && name[i] <= "Z" { has_upper = true }
                i = i + 1
            }
            if has_upper {
                tc_warn_at(line, f"'{name}' should use snake_case naming (W200)")
            }
        }
    }

    if kind == "struct" || kind == "enum" || kind == "interface" {
        // Should be PascalCase (start with uppercase)
        if name[0] >= "a" && name[0] <= "z" {
            tc_warn_at(line, f"type '{name}' should use PascalCase naming (W201)")
        }
    }

    if kind == "constant" {
        // Should be UPPER_SNAKE_CASE
        let all_upper = true
        for c in name.chars() {
            if (c >= "a" && c <= "z") { all_upper = false }
        }
        // Don't warn if it's just a normal const (too noisy)
    }
}

// W210: Unreachable code detection
func tc_check_unreachable(statements, line) {
    let found_terminal = false
    for stmt in statements {
        if found_terminal {
            tc_warn_at(stmt.span.start_line, "unreachable code after return/break/continue (W210)")
            return null
        }
        const sk = stmt.kind
        match sk {
            StmtKind::SReturn(_) => { found_terminal = true },
            StmtKind::SBreak(_, _) => { found_terminal = true },
            StmtKind::SContinue(_) => { found_terminal = true },
            StmtKind::SThrow(_) => { found_terminal = true },
            _ => {}
        }
    }
}

// W211: Empty match arms
func tc_check_empty_match(arms, line) {
    if len(arms) == 0 {
        tc_warn_at(line, "match expression has no arms (W211)")
    }
}

// W220: Self-comparison detection
func tc_check_self_comparison(expr, line) {
    if expr == null { return null }
    const ek = expr.kind
    match ek {
        ExprKind::EBinaryOp(op, left, right) => {
            match op {
                BinOp::Eq => {
                    if tc_exprs_identical(left, right) {
                        tc_warn_at(line, "comparing a value to itself always returns true (W220)")
                    }
                },
                BinOp::Ne => {
                    if tc_exprs_identical(left, right) {
                        tc_warn_at(line, "comparing a value to itself always returns false (W220)")
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
}

// Check if two expressions are syntactically identical
func tc_exprs_identical(a, b) {
    if a == null || b == null { return false }
    const ak = a.kind
    const bk = b.kind
    match ak {
        ExprKind::EVariable(name_a) => {
            match bk {
                ExprKind::EVariable(name_b) => name_a == name_b,
                _ => false
            }
        },
        _ => false
    }
}

// W230: Deep nesting detection
func tc_check_nesting_depth(depth, max_depth, line) {
    if depth > max_depth {
        tc_warn_at(line, f"nesting depth ({depth}) exceeds recommended maximum ({max_depth}) (W230)")
    }
}

// W240: Long function detection
func tc_check_function_length(fdef, line) {
    if fdef.body == null { return null }
    const body_length = len(fdef.body.stmts)
    if body_length > 50 {
        tc_warn_at(line, f"function '{fdef.name}' has {body_length} statements, consider splitting (W240)")
    }
}

// W250: Magic number detection
func tc_check_magic_numbers(expr, line) {
    if expr == null { return null }
    const ek = expr.kind
    match ek {
        ExprKind::ELiteral(lit) => {
            match lit {
                Literal::LInt(n) => {
                    // Allow common values: 0, 1, 2, -1, 10, 100
                    if n != 0 && n != 1 && n != 2 && n != -1 && n != 10 && n != 100 {
                        tc_warn_at(line, f"magic number {n}: consider using a named constant (W250)")
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
}

// W251: TODO comment detection (would need source text access)
func tc_check_todo_comments(source, line) {
    if source.contains("TODO") || source.contains("FIXME") || source.contains("HACK") {
        tc_warn_at(line, "TODO/FIXME/HACK comment found (W251)")
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Recursive Type Handling
// ═══════════════════════════════════════════════════════════════════

// Track which types are currently being resolved (for cycle detection)
let tc_resolving_types = {"__s": true}

func tc_begin_resolve_type(name) {
    if tc_resolving_types.has(name) && name != "__s" {
        return true // Cycle detected
    }
    tc_resolving_types[name] = true
    false
}

func tc_end_resolve_type(name) {
    if tc_resolving_types.has(name) {
        tc_resolving_types = tc_resolving_types.delete(name)
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Module Type Tracking
// ═══════════════════════════════════════════════════════════════════

// Map module_name -> { "exports": { name -> type } }
let tc_modules = {"__s": true}

func tc_register_module(name, exports) {
    tc_modules[name] = {"exports": exports}
}

func tc_lookup_module_export(module_name, export_name) {
    if !tc_modules.has(module_name) || module_name == "__s" { return "unknown" }
    const mod = tc_modules[module_name]
    const exports = mod["exports"]
    if exports.has(export_name) { return exports[export_name] }
    "unknown"
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Operator Overload Resolution
// ═══════════════════════════════════════════════════════════════════

// Map type_name -> { op_name -> { "params": [types], "return": type } }
let tc_operator_overloads = {"__s": true}

func tc_register_operator_overload(type_name, op_name, param_types, return_type) {
    if !tc_operator_overloads.has(type_name) {
        tc_operator_overloads[type_name] = {"__s": true}
    }
    let type_ops = tc_operator_overloads[type_name]
    type_ops[op_name] = {"params": param_types, "return": return_type}
    tc_operator_overloads[type_name] = type_ops
}

func tc_resolve_operator_overload(type_name, op_name) {
    if !tc_operator_overloads.has(type_name) || type_name == "__s" { return null }
    const type_ops = tc_operator_overloads[type_name]
    if type_ops.has(op_name) { return type_ops[op_name] }
    null
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Generic Type System — Instantiation & Monomorphization
// ═══════════════════════════════════════════════════════════════════

// Track monomorphized function instances: "name<T1,T2>" -> true
let tc_mono_instances = {"__s": true}

// Instantiate a generic function with concrete type arguments
func tc_instantiate_generic(func_name, type_args, line) {
    if !tc_functions.has(func_name) { return null }
    const sig = tc_functions[func_name]

    // Build the monomorphized key
    let arg_strs = []
    for ta in type_args { arg_strs.push(tc_type_to_string(ta)) }
    const mono_key = f"{func_name}<{arg_strs.join(', ')}>"

    if tc_mono_instances.has(mono_key) { return mono_key }

    // Validate that type arguments satisfy constraints
    if sig.has("type_params") {
        const tps = sig["type_params"]
        if len(type_args) != len(tps) {
            tc_error_at(line, f"function '{func_name}' expects {len(tps)} type arguments, got {len(type_args)}")
            return null
        }
        let i = 0
        while i < len(tps) {
            const tp = tps[i]
            if typeof(tp) == "map" && tp.has("constraints") {
                for constraint in tp["constraints"] {
                    tc_check_constraint_satisfaction(type_args[i], constraint, line)
                }
            }
            i = i + 1
        }
    }

    tc_mono_instances[mono_key] = true
    mono_key
}

// Check that a concrete type satisfies a generic constraint
func tc_check_constraint_satisfaction(concrete_type, constraint, line) {
    const ct_str = tc_type_to_string(concrete_type)
    if typeof(constraint) == "string" {
        // Named constraint: check interface satisfaction
        if tc_interfaces.has(constraint) && constraint != "__s" {
            tc_check_interface_satisfaction(ct_str, constraint, line)
        }
    }
}

// Resolve a generic type by substituting type parameters with concrete types
func tc_substitute_type(typ, substitutions) {
    if typ == null { return "unknown" }
    if typeof(typ) == "string" {
        if substitutions.has(typ) { return substitutions[typ] }
        return typ
    }
    if typeof(typ) != "map" || !typ.has("kind") { return typ }
    const kind = typ["kind"]
    match kind {
        "array" => {
            {"kind": "array", "element": tc_substitute_type(typ["element"], substitutions)}
        },
        "map" => {
            {"kind": "map",
             "key": tc_substitute_type(typ["key"], substitutions),
             "value": tc_substitute_type(typ["value"], substitutions)}
        },
        "function" => {
            let new_params = []
            if typ.has("params") {
                for p in typ["params"] { new_params.push(tc_substitute_type(p, substitutions)) }
            }
            const new_ret = tc_substitute_type(typ["return"], substitutions)
            {"kind": "function", "params": new_params, "return": new_ret}
        },
        "optional" => {
            {"kind": "optional", "inner": tc_substitute_type(typ["inner"], substitutions)}
        },
        "tuple" => {
            let new_elems = []
            if typ.has("elements") {
                for e in typ["elements"] { new_elems.push(tc_substitute_type(e, substitutions)) }
            }
            {"kind": "tuple", "elements": new_elems}
        },
        "generic" => {
            let new_args = []
            if typ.has("args") {
                for a in typ["args"] { new_args.push(tc_substitute_type(a, substitutions)) }
            }
            const resolved_name = if substitutions.has(typ["name"]) { substitutions[typ["name"]] } else { typ["name"] }
            if typeof(resolved_name) == "string" && len(new_args) == 0 { resolved_name }
            else { {"kind": "generic", "name": resolved_name, "args": new_args} }
        },
        _ => typ
    }
}

// Build substitution map from type parameter names to concrete types
func tc_build_substitution_map(type_param_names, type_args) {
    let subs = {"__s": true}
    let i = 0
    const limit = if len(type_param_names) < len(type_args) { len(type_param_names) } else { len(type_args) }
    while i < limit {
        subs[type_param_names[i]] = type_args[i]
        i = i + 1
    }
    subs
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Full Bidirectional Type Inference
// ═══════════════════════════════════════════════════════════════════

// Infer type from assignment context (propagate expected type)
func tc_check_with_expected(expr, expected_type, line) {
    if expr == null { return null }
    const actual = tc_infer_expr_type_full(expr)
    if expected_type != "unknown" && actual != "unknown" {
        if !tc_types_compatible(expected_type, actual) {
            const exp_str = tc_type_to_string(expected_type)
            const act_str = tc_type_to_string(actual)
            tc_error_at(line, f"type mismatch: expected '{exp_str}', got '{act_str}'")
        }
    }
}

// Infer type of a block (last statement or tail expression)
func tc_infer_block_type(block) {
    if block == null { return "void" }
    if block.tail_expr != null {
        return tc_infer_expr_type_full(block.tail_expr)
    }
    const stmts = block.stmts
    if len(stmts) == 0 { return "void" }
    const last = stmts[len(stmts) - 1]
    match last.kind {
        StmtKind::SExprStmt(expr) => tc_infer_expr_type_full(expr),
        StmtKind::SReturn(expr) => {
            if expr != null { tc_infer_expr_type_full(expr) } else { "void" }
        },
        _ => "void"
    }
}

// Infer return type of a function body
func tc_infer_function_return_type(fdef) {
    if fdef.return_type != null && fdef.return_type != "" { return fdef.return_type }
    tc_infer_block_type(fdef.body)
}

// Propagate types through variable assignment
func tc_propagate_assignment_type(name, expr, line) {
    const info = tc_lookup_var(name)
    if info == null { return null }
    const declared = info.typ
    const actual = tc_infer_expr_type_full(expr)
    if declared != "unknown" && actual != "unknown" {
        if !tc_types_compatible(declared, actual) {
            const decl_str = tc_type_to_string(declared)
            const act_str = tc_type_to_string(actual)
            tc_warn_at(line, f"assigning '{act_str}' to variable '{name}' declared as '{decl_str}'")
        }
    }
}

// Propagate types through return statements
func tc_check_return_type(expr, expected_return, line) {
    if expr == null || expected_return == null || expected_return == "unknown" { return null }
    const actual = tc_infer_expr_type_full(expr)
    if actual != "unknown" && !tc_types_compatible(expected_return, actual) {
        const exp_str = tc_type_to_string(expected_return)
        const act_str = tc_type_to_string(actual)
        tc_error_at(line, f"return type mismatch: expected '{exp_str}', got '{act_str}'")
    }
}

// Infer element type from array operations
func tc_infer_array_element_type(arr_expr) {
    const arr_type = tc_infer_expr_type_full(arr_expr)
    if typeof(arr_type) == "map" && arr_type.has("kind") && arr_type["kind"] == "array" {
        return arr_type["element"]
    }
    "unknown"
}

// Infer value type from map operations
func tc_infer_map_value_type(map_expr) {
    const map_type = tc_infer_expr_type_full(map_expr)
    if typeof(map_type) == "map" && map_type.has("kind") && map_type["kind"] == "map" {
        return map_type["value"]
    }
    "unknown"
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Complete Interface Satisfaction Checking
// ═══════════════════════════════════════════════════════════════════

// Method registry: type_name -> [{ "name": string, "params": [types], "return": type }]
let tc_type_methods = {"__s": true}

// Register a method implementation for a type
func tc_register_method(type_name, method_name, param_types, return_type) {
    if !tc_type_methods.has(type_name) {
        tc_type_methods[type_name] = []
    }
    let methods = tc_type_methods[type_name]
    methods.push({"name": method_name, "params": param_types, "return": return_type})
    tc_type_methods[type_name] = methods
}

// Collect all methods for a type (including from impl blocks)
func tc_collect_type_methods(type_name) {
    let methods = []
    // Direct methods from tc_type_methods
    if tc_type_methods.has(type_name) && type_name != "__s" {
        methods = methods.concat(tc_type_methods[type_name])
    }
    // Methods registered as "TypeName.method" in tc_functions
    for fn_name in tc_functions.keys() {
        if fn_name == "__s" { continue }
        if starts_with(fn_name, f"{type_name}.") {
            const method_name = fn_name.slice(len(type_name) + 1, len(fn_name))
            const sig = tc_functions[fn_name]
            methods.push({"name": method_name, "params": [], "return": sig.return_type})
        }
    }
    methods
}

// Full interface satisfaction check with embedded interfaces
func tc_check_interface_satisfaction_full(type_name, interface_name, line) {
    if !tc_interfaces.has(interface_name) || interface_name == "__s" { return true }
    const iface = tc_interfaces[interface_name]
    const required = iface["methods"]
    const type_methods = tc_collect_type_methods(type_name)

    let missing = []
    for req in required {
        const req_name = req["name"]
        let found = false
        for m in type_methods {
            if m["name"] == req_name { found = true; break }
        }
        if !found { missing.push(req_name) }
    }

    // Check embedded interfaces
    if iface.has("embeds") {
        for embedded_name in iface["embeds"] {
            if tc_interfaces.has(embedded_name) && embedded_name != "__s" {
                const embedded = tc_interfaces[embedded_name]
                for req in embedded["methods"] {
                    let found = false
                    for m in type_methods {
                        if m["name"] == req["name"] { found = true; break }
                    }
                    if !found { missing.push(req["name"]) }
                }
            }
        }
    }

    if len(missing) > 0 {
        const missing_str = missing.join(", ")
        tc_error_at(line, f"type '{type_name}' does not satisfy interface '{interface_name}': missing methods [{missing_str}]")
        return false
    }
    true
}

// Register an interface with embedded interfaces support
func tc_register_interface_full(name, methods, embeds) {
    let method_sigs = []
    for m in methods {
        if typeof(m) == "string" {
            method_sigs.push({"name": m, "params": [], "return": "unknown"})
        } else if typeof(m) == "map" {
            method_sigs.push(m)
        }
    }
    tc_interfaces[name] = {"methods": method_sigs, "embeds": embeds}
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Enhanced Null Safety Analysis
// ═══════════════════════════════════════════════════════════════════

// Nullable type tracking: var_name -> bool (true = definitely nullable)
let tc_nullable_vars = {"__s": true}

// Mark a variable as potentially nullable
func tc_mark_nullable(var_name) {
    tc_nullable_vars[var_name] = true
}

// Check if a variable is known to be nullable
func tc_is_nullable(var_name) {
    tc_nullable_vars.has(var_name) && var_name != "__s"
}

// Warn on unchecked null access
func tc_check_null_access(expr, line) {
    if expr == null { return null }
    const ek = expr.kind
    match ek {
        ExprKind::EFieldAccess(obj, field) => {
            match obj.kind {
                ExprKind::EVariable(name) => {
                    if tc_is_nullable(name) && !tc_is_known_non_null(name) {
                        tc_warn_at(line, f"accessing field '{field}' on potentially null variable '{name}' — use null check or optional chaining (W260)")
                    }
                },
                _ => {}
            }
        },
        ExprKind::EMethodCall(obj, method, _args, _ta) => {
            match obj.kind {
                ExprKind::EVariable(name) => {
                    if tc_is_nullable(name) && !tc_is_known_non_null(name) {
                        tc_warn_at(line, f"calling method '{method}' on potentially null variable '{name}' — use null check (W260)")
                    }
                },
                _ => {}
            }
        },
        ExprKind::EIndex(obj, _idx) => {
            match obj.kind {
                ExprKind::EVariable(name) => {
                    if tc_is_nullable(name) && !tc_is_known_non_null(name) {
                        tc_warn_at(line, f"indexing potentially null variable '{name}' — use null check (W260)")
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
}

// Track nullability through assignments
func tc_track_nullability(name, expr) {
    if expr == null { tc_mark_nullable(name); return null }
    const ek = expr.kind
    match ek {
        ExprKind::ELiteral(lit) => {
            match lit {
                Literal::NullLit => tc_mark_nullable(name),
                _ => {}
            }
        },
        ExprKind::ECall(fn_name, _args, _ta) => {
            // Functions that may return null
            if fn_name == "find" || fn_name == "get" || fn_name == "first" || fn_name == "last" || fn_name == "pop" {
                tc_mark_nullable(name)
            }
        },
        ExprKind::ENullCoalesce(_, _) => {
            // Result of ?? is non-null
        },
        _ => {}
    }
}

// Analyze control flow for null narrowing in if/else
func tc_analyze_null_narrowing_stmt(stmt) {
    if stmt == null { return null }
    const sk = stmt.kind
    match sk {
        StmtKind::SIf(cond, then_block, else_block) => {
            const checked_var = tc_analyze_null_check(cond)
            if checked_var != null {
                // Inside then-block, var is non-null
                tc_enter_null_checked(checked_var)
                // then-block processing happens after
            }
        },
        _ => {}
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: All 49 Lint Rules — Full AST Walking
// ═══════════════════════════════════════════════════════════════════

// Lint context for stateful analysis
let lint_enabled_rules = {"__s": true}
let lint_suppress_next = false

// Initialize all lint rules as enabled
func lint_init_rules() {
    const rules = [
        "W100", "W101", "W102", "W103", "W104", "W105", "W106", "W107", "W108", "W109",
        "W110", "W111", "W112", "W113", "W114",
        "W200", "W201", "W202", "W203", "W204", "W205", "W206", "W207", "W208", "W209",
        "W210", "W211", "W212", "W213", "W214",
        "W220", "W221", "W222", "W223", "W224", "W225",
        "W230", "W231", "W232", "W233", "W234", "W235",
        "W240", "W241", "W242", "W243",
        "W250", "W251", "W260"
    ]
    for r in rules { lint_enabled_rules[r] = true }
}

func lint_is_enabled(code) {
    lint_enabled_rules.has(code) && code != "__s"
}

// W102: Variable declared but only assigned, never read
func tc_lint_w102_write_only(scope) {
    for name in scope.keys() {
        if name == "__s" { continue }
        if starts_with(name, "_") { continue }
        const info = scope[name]
        if info.mutable && !info.used {
            tc_warn_at(info.line, f"variable '{name}' is written but never read (W102)")
        }
    }
}

// W103: Mutable variable never mutated
func tc_lint_w103_unnecessary_mut(scope) {
    for name in scope.keys() {
        if name == "__s" { continue }
        if starts_with(name, "_") { continue }
        const info = scope[name]
        if info.mutable && info.used {
            // Would need tracking reassignment; simplified: skip
        }
    }
}

// W104: Empty block body
func tc_lint_w104_empty_block(block, kind, line) {
    if block == null { return null }
    if len(block.stmts) == 0 && block.tail_expr == null {
        tc_warn_at(line, f"empty {kind} body (W104)")
    }
}

// W105: While true without break
func tc_lint_w105_while_true(cond, body, line) {
    if cond == null { return null }
    const ek = cond.kind
    match ek {
        ExprKind::ELiteral(lit) => {
            match lit {
                Literal::BoolLit(true) => {
                    // Check if body contains a break
                    let has_break = false
                    if body != null {
                        for s in body.stmts {
                            match s.kind {
                                StmtKind::SBreak(_, _) => { has_break = true },
                                _ => {}
                            }
                        }
                    }
                    if !has_break {
                        tc_warn_at(line, "infinite loop: `while true` without break (W105)")
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
}

// W106: Boolean literal comparison (e.g., x == true)
func tc_lint_w106_bool_comparison(expr, line) {
    if expr == null { return null }
    const ek = expr.kind
    match ek {
        ExprKind::EBinaryOp(op, left, right) => {
            match op {
                BinOp::Eq => {
                    if tc_is_bool_literal(right) {
                        tc_warn_at(line, "unnecessary comparison with boolean literal — use value directly (W106)")
                    } else if tc_is_bool_literal(left) {
                        tc_warn_at(line, "unnecessary comparison with boolean literal — use value directly (W106)")
                    }
                },
                BinOp::Ne => {
                    if tc_is_bool_literal(right) || tc_is_bool_literal(left) {
                        tc_warn_at(line, "unnecessary comparison with boolean literal — use negation (W106)")
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
}

func tc_is_bool_literal(expr) {
    if expr == null { return false }
    match expr.kind {
        ExprKind::ELiteral(lit) => {
            match lit {
                Literal::BoolLit(_) => true,
                _ => false
            }
        },
        _ => false
    }
}

// W107: Suspicious arithmetic (x * 0, x % 1, x / x)
func tc_lint_w107_suspicious_arith(expr, line) {
    if expr == null { return null }
    const ek = expr.kind
    match ek {
        ExprKind::EBinaryOp(op, left, right) => {
            match op {
                BinOp::Mod => {
                    if tc_is_int_literal(right, 1) {
                        tc_warn_at(line, "modulo by 1 always yields 0 (W107)")
                    }
                },
                BinOp::Mul => {
                    if tc_is_int_literal(right, 0) || tc_is_int_literal(left, 0) {
                        tc_warn_at(line, "multiply by 0 always yields 0 (W107)")
                    }
                },
                BinOp::Div => {
                    if tc_exprs_identical(left, right) {
                        tc_warn_at(line, "dividing a value by itself always yields 1 (W107)")
                    }
                    if tc_is_int_literal(right, 0) {
                        tc_error_at(line, "division by zero (E104)")
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
}

func tc_is_int_literal(expr, val) {
    if expr == null { return false }
    match expr.kind {
        ExprKind::ELiteral(lit) => {
            match lit {
                Literal::IntLit(n) => n == val,
                _ => false
            }
        },
        _ => false
    }
}

// W108: Unnecessary return in tail position
func tc_lint_w108_unnecessary_return(stmts, line) {
    if len(stmts) == 0 { return null }
    const last = stmts[len(stmts) - 1]
    match last.kind {
        StmtKind::SReturn(expr) => {
            if expr != null {
                tc_warn_at(last.span.start_line, "unnecessary return in tail position — expression is implicitly returned (W108)")
            }
        },
        _ => {}
    }
}

// W109: Shadowing in same scope
func tc_lint_w109_shadowing(name, line) {
    if len(tc_scopes) == 0 { return null }
    const current = tc_scopes[len(tc_scopes) - 1]
    if current.has(name) && name != "__s" {
        tc_warn_at(line, f"variable '{name}' shadows previous binding in same scope (W109)")
    }
}

// W110: Unused function
func tc_lint_w110_unused_function(func_name, line) {
    // Tracked via tc_functions used flag (would require extra tracking)
    null
}

// W111: Redundant else after return
func tc_lint_w111_redundant_else(then_block, else_block, line) {
    if then_block == null || else_block == null { return null }
    const then_stmts = then_block.stmts
    if len(then_stmts) > 0 {
        const last = then_stmts[len(then_stmts) - 1]
        match last.kind {
            StmtKind::SReturn(_) => {
                tc_warn_at(line, "else block after return is redundant — consider removing else (W111)")
            },
            StmtKind::SBreak(_, _) => {
                tc_warn_at(line, "else block after break is redundant — consider removing else (W111)")
            },
            _ => {}
        }
    }
}

// W112: Unreachable pattern in match
func tc_lint_w112_unreachable_pattern(arms, line) {
    let had_wildcard = false
    for arm in arms {
        if had_wildcard {
            tc_warn_at(line, "unreachable match arm after wildcard pattern (W112)")
            return null
        }
        if tc_pattern_is_wildcard(arm.pattern) {
            had_wildcard = true
        }
    }
}

// W113: Redundant type annotation
func tc_lint_w113_redundant_annotation(annotation, inferred, line) {
    if annotation == null || annotation == "" || annotation == "unknown" { return null }
    if inferred == null || inferred == "" || inferred == "unknown" { return null }
    if annotation == inferred {
        tc_warn_at(line, f"redundant type annotation '{annotation}' — type is already inferred (W113)")
    }
}

// W114: Deprecated function usage
func tc_lint_w114_deprecated(func_name, line) {
    // Check if function has deprecated marker (would need metadata tracking)
    null
}

// W202: Function too many parameters
func tc_lint_w202_too_many_params(fdef, line) {
    if len(fdef.params) > 7 {
        tc_warn_at(line, f"function '{fdef.name}' has {len(fdef.params)} parameters — consider using a config object (W202)")
    }
}

// W203: Deeply nested code
func tc_lint_w203_deep_nesting(depth, line) {
    if depth > 5 {
        tc_warn_at(line, f"code is nested {depth} levels deep — consider extracting functions (W203)")
    }
}

// W204: While-true loop
func tc_lint_w204_while_true(cond, line) {
    if cond == null { return null }
    match cond.kind {
        ExprKind::ELiteral(lit) => {
            match lit {
                Literal::BoolLit(true) => {
                    tc_warn_at(line, "`while true` — consider using `loop` instead (W204)")
                },
                _ => {}
            }
        },
        _ => {}
    }
}

// W205: Self-comparison
func tc_lint_w205_self_comparison(left, right, op, line) {
    if tc_exprs_identical(left, right) {
        match op {
            BinOp::Eq => tc_warn_at(line, "comparing a value to itself is always true (W205)"),
            BinOp::Ne => tc_warn_at(line, "comparing a value to itself is always false (W205)"),
            BinOp::Lt => tc_warn_at(line, "comparing a value to itself is always false (W205)"),
            BinOp::Gt => tc_warn_at(line, "comparing a value to itself is always false (W205)"),
            BinOp::LtEq => tc_warn_at(line, "comparing a value to itself is always true (W205)"),
            BinOp::GtEq => tc_warn_at(line, "comparing a value to itself is always true (W205)"),
            _ => {}
        }
    }
}

// W206: Empty block
func tc_lint_w206_empty_block(block, context, line) {
    if block == null { return null }
    if len(block.stmts) == 0 && block.tail_expr == null {
        tc_warn_at(line, f"empty {context} block — add a comment if intentional (W206)")
    }
}

// W207: String comparison for type checking
func tc_lint_w207_string_type_check(expr, line) {
    if expr == null { return null }
    match expr.kind {
        ExprKind::EBinaryOp(op, left, right) => {
            match op {
                BinOp::Eq => {
                    if tc_is_typeof_call(left) && tc_is_string_literal(right) {
                        tc_warn_at(line, "consider using `is_*` functions instead of typeof comparison (W207)")
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
}

func tc_is_typeof_call(expr) {
    if expr == null { return false }
    match expr.kind {
        ExprKind::ECall(name, _, _) => name == "typeof",
        _ => false
    }
}

func tc_is_string_literal(expr) {
    if expr == null { return false }
    match expr.kind {
        ExprKind::ELiteral(lit) => {
            match lit {
                Literal::StringLit(_) => true,
                _ => false
            }
        },
        _ => false
    }
}

// W208: Duplicate imports
func tc_lint_w208_duplicate_imports(statements) {
    let seen_imports = {"__s": true}
    for stmt in statements {
        match stmt.kind {
            StmtKind::SImportModule(path_parts, _alias, _items) => {
                const import_key = path_parts.join(".")
                if seen_imports.has(import_key) && import_key != "__s" {
                    tc_warn_at(stmt.span.start_line, f"duplicate import '{import_key}' (W208)")
                }
                seen_imports[import_key] = true
            },
            _ => {}
        }
    }
}

// W209: Variable shadows outer scope
func tc_lint_w209_outer_shadow(name, line) {
    if starts_with(name, "_") { return null }
    // Check outer scopes (skip innermost)
    if len(tc_scopes) < 2 { return null }
    let i = len(tc_scopes) - 2
    while i >= 0 {
        const scope = tc_scopes[i]
        if scope.has(name) && name != "__s" {
            tc_warn_at(line, f"variable '{name}' shadows binding from outer scope (W209)")
            return null
        }
        i = i - 1
    }
}

// W212: Unused match result
func tc_lint_w212_unused_match_result(stmt) {
    if stmt == null { return null }
    match stmt.kind {
        StmtKind::SExprStmt(expr) => {
            match expr.kind {
                ExprKind::EMatch(_, _) => {
                    tc_warn_at(stmt.span.start_line, "match expression result is unused — assign to a variable or use if/else (W212)")
                },
                _ => {}
            }
        },
        _ => {}
    }
}

// W213: Missing else branch in expression position
func tc_lint_w213_missing_else(expr, line) {
    match expr.kind {
        ExprKind::EIfElse(_, _, else_expr) => {
            if else_expr == null {
                tc_warn_at(line, "if expression without else — result may be null (W213)")
            }
        },
        _ => {}
    }
}

// W214: Comparison chain simplification
func tc_lint_w214_comparison_chain(expr, line) {
    if expr == null { return null }
    match expr.kind {
        ExprKind::EBinaryOp(BinOp::Or, left, right) => {
            // Check for x == a || x == b pattern
            if tc_is_equality_check(left) && tc_is_equality_check(right) {
                if tc_same_lhs(left, right) {
                    tc_warn_at(line, "consider using match or `in` instead of chained equality checks (W214)")
                }
            }
        },
        _ => {}
    }
}

func tc_is_equality_check(expr) {
    if expr == null { return false }
    match expr.kind {
        ExprKind::EBinaryOp(BinOp::Eq, _, _) => true,
        _ => false
    }
}

func tc_same_lhs(a, b) {
    match a.kind {
        ExprKind::EBinaryOp(_, left_a, _) => {
            match b.kind {
                ExprKind::EBinaryOp(_, left_b, _) => tc_exprs_identical(left_a, left_b),
                _ => false
            }
        },
        _ => false
    }
}

// W221: Unnecessary semicolons
func tc_lint_w221_extra_semicolons(source) {
    // Would need token-level analysis
    null
}

// W222: Unnecessary parentheses
func tc_lint_w222_extra_parens(expr, line) {
    // Would need paren tracking in AST
    null
}

// W223: Collapsible if
func tc_lint_w223_collapsible_if(stmt, line) {
    match stmt.kind {
        StmtKind::SIf(_, then_block, else_block) => {
            if else_block == null && then_block != null {
                const stmts = then_block.stmts
                if len(stmts) == 1 {
                    match stmts[0].kind {
                        StmtKind::SIf(_, _, _) => {
                            tc_warn_at(line, "nested if can be collapsed with `&&` (W223)")
                        },
                        _ => {}
                    }
                }
            }
        },
        _ => {}
    }
}

// W224: Loop that runs at most once
func tc_lint_w224_single_iteration_loop(body, line) {
    if body == null { return null }
    if len(body.stmts) > 0 {
        const first = body.stmts[0]
        match first.kind {
            StmtKind::SReturn(_) => {
                tc_warn_at(line, "loop body always returns on first iteration (W224)")
            },
            StmtKind::SBreak(_, _) => {
                tc_warn_at(line, "loop body always breaks on first iteration (W224)")
            },
            _ => {}
        }
    }
}

// W225: Constant condition in if
func tc_lint_w225_constant_condition(cond, line) {
    if cond == null { return null }
    match cond.kind {
        ExprKind::ELiteral(lit) => {
            match lit {
                Literal::BoolLit(v) => {
                    const taken = if v { "always" } else { "never" }
                    tc_warn_at(line, f"condition is always {v} — if branch is {taken} taken (W225)")
                },
                _ => {}
            }
        },
        _ => {}
    }
}

// W231: Too many match arms
func tc_lint_w231_too_many_arms(arms, line) {
    if len(arms) > 20 {
        tc_warn_at(line, f"match has {len(arms)} arms — consider refactoring (W231)")
    }
}

// W232: Too many imports
func tc_lint_w232_too_many_imports(statements) {
    let import_count = 0
    for stmt in statements {
        match stmt.kind {
            StmtKind::SImportModule(_, _, _) => { import_count = import_count + 1 },
            _ => {}
        }
    }
    if import_count > 15 {
        tc_warn_at(0, f"file has {import_count} imports — consider splitting into modules (W232)")
    }
}

// W233: Catch block that ignores error
func tc_lint_w233_ignored_error(catch_var, catch_block, line) {
    if catch_var == "_" { return null } // Explicitly ignored
    // Check if catch_var is used in catch_block
    let used = false
    if catch_block != null {
        for s in catch_block.stmts {
            if tc_stmt_references_var(s, catch_var) { used = true; break }
        }
    }
    if !used {
        tc_warn_at(line, f"caught error '{catch_var}' is ignored — consider logging or re-throwing (W233)")
    }
}

func tc_stmt_references_var(stmt, var_name) {
    if stmt == null { return false }
    match stmt.kind {
        StmtKind::SExprStmt(expr) => tc_expr_references_var(expr, var_name),
        StmtKind::SReturn(expr) => {
            if expr != null { tc_expr_references_var(expr, var_name) } else { false }
        },
        StmtKind::SConst(_, expr) => {
            if expr != null { tc_expr_references_var(expr, var_name) } else { false }
        },
        _ => false
    }
}

func tc_expr_references_var(expr, var_name) {
    if expr == null { return false }
    match expr.kind {
        ExprKind::EVariable(name) => name == var_name,
        ExprKind::ECall(_, args, _) => {
            for arg in args {
                if tc_expr_references_var(arg, var_name) { return true }
            }
            false
        },
        ExprKind::EBinaryOp(_, left, right) => {
            tc_expr_references_var(left, var_name) || tc_expr_references_var(right, var_name)
        },
        ExprKind::EMethodCall(obj, _, args, _) => {
            if tc_expr_references_var(obj, var_name) { return true }
            for arg in args {
                if tc_expr_references_var(arg, var_name) { return true }
            }
            false
        },
        _ => false
    }
}

// W234: Duplicate struct field names
func tc_lint_w234_duplicate_struct_fields(fields, line) {
    let seen = {"__s": true}
    for f in fields {
        const name = if typeof(f) == "string" { f } else { f.name }
        if seen.has(name) && name != "__s" {
            tc_warn_at(line, f"duplicate field '{name}' in struct definition (W234)")
        }
        seen[name] = true
    }
}

// W235: Duplicate enum variant names
func tc_lint_w235_duplicate_enum_variants(variants, line) {
    let seen = {"__s": true}
    for v in variants {
        const name = if typeof(v) == "string" { v } else { v.name }
        if seen.has(name) && name != "__s" {
            tc_warn_at(line, f"duplicate variant '{name}' in enum definition (W235)")
        }
        seen[name] = true
    }
}

// W241: Function with multiple return types
func tc_lint_w241_mixed_returns(fdef, line) {
    if fdef.body == null { return null }
    let return_types = []
    tc_collect_return_types(fdef.body, return_types)
    // Check if all return types are compatible
    if len(return_types) > 1 {
        let first = return_types[0]
        for rt in return_types {
            if rt != first && rt != "unknown" && first != "unknown" {
                tc_warn_at(line, f"function '{fdef.name}' has mixed return types (W241)")
                return null
            }
        }
    }
}

func tc_collect_return_types(block, types) {
    if block == null { return null }
    for s in block.stmts {
        match s.kind {
            StmtKind::SReturn(expr) => {
                if expr != null {
                    types.push(tc_infer_expr_type_full(expr))
                } else {
                    types.push("void")
                }
            },
            StmtKind::SIf(_, then_b, else_b) => {
                tc_collect_return_types(then_b, types)
                if else_b != null { tc_collect_return_types(else_b, types) }
            },
            _ => {}
        }
    }
}

// W242: Function with no explicit return type and complex body
func tc_lint_w242_infer_warning(fdef, line) {
    if fdef.return_type != null && fdef.return_type != "" { return null }
    if fdef.body == null { return null }
    if len(fdef.body.stmts) > 10 {
        tc_warn_at(line, f"complex function '{fdef.name}' has no explicit return type — consider adding one (W242)")
    }
}

// W243: Recursive function without base case
func tc_lint_w243_missing_base_case(fdef, line) {
    if fdef.body == null { return null }
    const name = fdef.name
    let calls_self = false
    let has_base = false
    for s in fdef.body.stmts {
        match s.kind {
            StmtKind::SIf(_, _, _) => { has_base = true },
            StmtKind::SExprStmt(expr) => {
                if tc_expr_calls_func(expr, name) { calls_self = true }
            },
            StmtKind::SReturn(expr) => {
                if expr != null && tc_expr_calls_func(expr, name) { calls_self = true }
                else { has_base = true }
            },
            _ => {}
        }
    }
    if calls_self && !has_base {
        tc_warn_at(line, f"recursive function '{name}' has no apparent base case (W243)")
    }
}

func tc_expr_calls_func(expr, func_name) {
    if expr == null { return false }
    match expr.kind {
        ExprKind::ECall(name, args, _) => {
            if name == func_name { return true }
            for arg in args {
                if tc_expr_calls_func(arg, func_name) { return true }
            }
            false
        },
        ExprKind::EBinaryOp(_, left, right) => {
            tc_expr_calls_func(left, func_name) || tc_expr_calls_func(right, func_name)
        },
        _ => false
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Pattern Exhaustiveness for Complex Nested Patterns
// ═══════════════════════════════════════════════════════════════════

// Check exhaustiveness of nested patterns
func tc_check_exhaustiveness_full(subject_expr, arms, line) {
    if len(arms) == 0 {
        tc_warn_at(line, "empty match expression")
        return null
    }

    let has_wildcard = false
    let covered_patterns = []

    for arm in arms {
        if tc_pattern_is_wildcard(arm.pattern) { has_wildcard = true }
        covered_patterns.push(tc_pattern_to_coverage(arm.pattern))
    }

    if has_wildcard { return null } // Wildcard covers everything

    // Check enum exhaustiveness
    const subject_type = tc_infer_expr_type_full(subject_expr)
    const type_str = tc_type_to_string(subject_type)

    if tc_enums.has(type_str) {
        const all_variants = tc_enums[type_str]
        let covered_variants = {"__s": true}
        for cov in covered_patterns {
            if typeof(cov) == "map" && cov.has("enum_variant") {
                covered_variants[cov["enum_variant"]] = true
            }
        }
        let missing = []
        for v in all_variants {
            if !covered_variants.has(v) { missing.push(v) }
        }
        if len(missing) > 0 {
            tc_error_at(line, f"non-exhaustive match: missing variants [{missing.join(', ')}]")
        }
    }

    // Check boolean exhaustiveness
    if type_str == "bool" {
        let has_true = false
        let has_false = false
        for cov in covered_patterns {
            if typeof(cov) == "map" && cov.has("bool_val") {
                if cov["bool_val"] { has_true = true } else { has_false = true }
            }
        }
        if !has_true || !has_false {
            tc_error_at(line, "non-exhaustive match on bool: missing true or false case")
        }
    }

    // Check null exhaustiveness for optional types
    if type_str == "optional" || tc_is_nullable(type_str) {
        let has_null = false
        let has_value = false
        for cov in covered_patterns {
            if typeof(cov) == "map" {
                if cov.has("null_pattern") { has_null = true }
                else { has_value = true }
            }
        }
        if !has_null {
            tc_warn_at(line, "match on nullable value does not handle null case")
        }
    }
}

// Convert a pattern to a coverage descriptor
func tc_pattern_to_coverage(pattern) {
    match pattern {
        Pattern::PVariable(_) => {"wildcard": true},
        Pattern::PWildcard => {"wildcard": true},
        Pattern::PEnum(enum_name, variant, bindings) => {
            let sub_coverage = []
            for b in bindings { sub_coverage.push(tc_pattern_to_coverage(b)) }
            {"enum_name": enum_name, "enum_variant": variant, "bindings": sub_coverage}
        },
        Pattern::PLiteral(lit) => {
            match lit {
                Literal::BoolLit(v) => {"bool_val": v},
                Literal::NullLit => {"null_pattern": true},
                Literal::IntLit(n) => {"int_val": n},
                Literal::StringLit(s) => {"string_val": s},
                _ => {"literal": true}
            }
        },
        Pattern::PArray(elems) => {
            let sub_coverage = []
            for e in elems { sub_coverage.push(tc_pattern_to_coverage(e)) }
            {"array_pattern": sub_coverage}
        },
        Pattern::POr(sub_patterns) => {
            let subs = []
            for p in sub_patterns { subs.push(tc_pattern_to_coverage(p)) }
            {"or_pattern": subs}
        },
        Pattern::PRest(_) => {"rest": true},
        Pattern::PBinding(_, inner) => tc_pattern_to_coverage(inner),
        _ => {"unknown": true}
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Enhanced Closure Capture Analysis
// ═══════════════════════════════════════════════════════════════════

// Track captured variables with their types
func tc_analyze_captures_typed(lambda_params, lambda_body) {
    let captured = []
    if lambda_body == null { return captured }

    // Build set of param names (these are not captures)
    let param_names = {"__s": true}
    for p in lambda_params {
        param_names[p.name] = true
    }

    // Walk the body and find references to outer-scope variables
    tc_collect_captures_from_block(lambda_body, param_names, captured)
    captured
}

func tc_collect_captures_from_block(block, local_names, captured) {
    if block == null { return null }
    if typeof(block) == "map" && block.has("stmts") {
        for s in block.stmts {
            tc_collect_captures_from_stmt(s, local_names, captured)
        }
        if block.tail_expr != null {
            tc_collect_captures_from_expr(block.tail_expr, local_names, captured)
        }
    } else {
        // block might be an expression (arrow lambda)
        tc_collect_captures_from_expr(block, local_names, captured)
    }
}

func tc_collect_captures_from_stmt(stmt, local_names, captured) {
    if stmt == null { return null }
    match stmt.kind {
        StmtKind::SExprStmt(expr) => tc_collect_captures_from_expr(expr, local_names, captured),
        StmtKind::SReturn(expr) => {
            if expr != null { tc_collect_captures_from_expr(expr, local_names, captured) }
        },
        StmtKind::SConst(name, expr) => {
            local_names[name] = true
            if expr != null { tc_collect_captures_from_expr(expr, local_names, captured) }
        },
        StmtKind::SLet(name, expr) => {
            local_names[name] = true
            if expr != null { tc_collect_captures_from_expr(expr, local_names, captured) }
        },
        StmtKind::SLetMut(name, expr) => {
            local_names[name] = true
            if expr != null { tc_collect_captures_from_expr(expr, local_names, captured) }
        },
        StmtKind::SAssignment(name, expr) => {
            if !local_names.has(name) && name != "__s" && tc_is_defined(name) {
                if !captured.contains(name) {
                    captured.push(name)
                }
            }
            if expr != null { tc_collect_captures_from_expr(expr, local_names, captured) }
        },
        StmtKind::SIf(cond, then_b, else_b) => {
            tc_collect_captures_from_expr(cond, local_names, captured)
            tc_collect_captures_from_block(then_b, local_names, captured)
            if else_b != null { tc_collect_captures_from_block(else_b, local_names, captured) }
        },
        StmtKind::SForLoop(_, _pattern, iterable, body) => {
            tc_collect_captures_from_expr(iterable, local_names, captured)
            tc_collect_captures_from_block(body, local_names, captured)
        },
        StmtKind::SWhileLoop(_, cond, body) => {
            tc_collect_captures_from_expr(cond, local_names, captured)
            tc_collect_captures_from_block(body, local_names, captured)
        },
        _ => {}
    }
}

func tc_collect_captures_from_expr(expr, local_names, captured) {
    if expr == null { return null }
    match expr.kind {
        ExprKind::EVariable(name) => {
            if !local_names.has(name) && name != "__s" && tc_is_defined(name) {
                if !captured.contains(name) && !tc_is_builtin(name) {
                    captured.push(name)
                }
            }
        },
        ExprKind::EBinaryOp(_, left, right) => {
            tc_collect_captures_from_expr(left, local_names, captured)
            tc_collect_captures_from_expr(right, local_names, captured)
        },
        ExprKind::EUnaryOp(_, operand) => {
            tc_collect_captures_from_expr(operand, local_names, captured)
        },
        ExprKind::ECall(name, args, _) => {
            if !local_names.has(name) && name != "__s" && tc_is_defined(name) && !tc_is_builtin(name) && !tc_functions.has(name) {
                if !captured.contains(name) { captured.push(name) }
            }
            for arg in args { tc_collect_captures_from_expr(arg, local_names, captured) }
        },
        ExprKind::EMethodCall(obj, _, args, _) => {
            tc_collect_captures_from_expr(obj, local_names, captured)
            for arg in args { tc_collect_captures_from_expr(arg, local_names, captured) }
        },
        ExprKind::EFieldAccess(obj, _) => {
            tc_collect_captures_from_expr(obj, local_names, captured)
        },
        ExprKind::EIndex(obj, idx) => {
            tc_collect_captures_from_expr(obj, local_names, captured)
            tc_collect_captures_from_expr(idx, local_names, captured)
        },
        ExprKind::EIfElse(cond, then_e, else_e) => {
            tc_collect_captures_from_expr(cond, local_names, captured)
            tc_collect_captures_from_expr(then_e, local_names, captured)
            if else_e != null { tc_collect_captures_from_expr(else_e, local_names, captured) }
        },
        ExprKind::ELambda(inner_params, inner_body) => {
            // Nested lambda: add its params to local_names, recurse
            let inner_locals = {}
            for k in local_names.keys() { inner_locals[k] = true }
            for p in inner_params { inner_locals[p.name] = true }
            tc_collect_captures_from_expr(inner_body, inner_locals, captured)
        },
        ExprKind::ELiteral(lit) => {
            match lit {
                Literal::ArrayLit(elems) => {
                    for e in elems { tc_collect_captures_from_expr(e, local_names, captured) }
                },
                Literal::MapLit(pairs) => {
                    for pair in pairs {
                        tc_collect_captures_from_expr(pair[0], local_names, captured)
                        tc_collect_captures_from_expr(pair[1], local_names, captured)
                    }
                },
                _ => {}
            }
        },
        ExprKind::EStringInterp(parts) => {
            for part in parts {
                match part {
                    StringPart::ExprPart(e) => tc_collect_captures_from_expr(e, local_names, captured),
                    _ => {}
                }
            }
        },
        _ => {}
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Import Validation
// ═══════════════════════════════════════════════════════════════════

// Validate all import statements
func tc_validate_imports(statements) {
    for stmt in statements {
        match stmt.kind {
            StmtKind::SImportModule(path_parts, _alias, items) => {
                const line = stmt.span.start_line
                if len(path_parts) == 0 { continue }

                const root = path_parts[0]
                if root == "std" {
                    // Validate stdlib module exists
                    if len(path_parts) >= 2 {
                        const mod_name = path_parts[1]
                        if !KNOWN_STDLIB_MODULES.contains(mod_name) {
                            tc_error_at(line, f"unknown stdlib module 'std.{mod_name}'")
                        }
                    }
                } else if root == "self" || root == "super" || root == "pkg" {
                    // Relative imports: valid path structure
                } else {
                    // External package import: check if package is available
                    // This would require package resolution context
                }

                // Validate specific imported items if any
                if items != null && len(items) > 0 {
                    // Check for duplicate items
                    let seen_items = {"__s": true}
                    for item in items {
                        const item_name = if typeof(item) == "string" { item } else { item.name }
                        if seen_items.has(item_name) && item_name != "__s" {
                            tc_warn_at(line, f"duplicate import item '{item_name}'")
                        }
                        seen_items[item_name] = true
                    }
                }
            },
            _ => {}
        }
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Recursive Type Cycle Detection
// ═══════════════════════════════════════════════════════════════════

// Detect cycles in type definitions (struct A contains B, B contains A)
func tc_detect_type_cycles(statements) {
    // Build dependency graph: type_name -> [referenced_type_names]
    let type_deps = {"__s": true}

    for stmt in statements {
        match stmt.kind {
            StmtKind::SStructDef(name, fields, _methods) => {
                let deps = []
                for f in fields {
                    const ft = if typeof(f) == "map" && f.has("type_ann") { f["type_ann"] } else { null }
                    if ft != null && typeof(ft) == "string" && tc_structs.has(ft) {
                        deps.push(ft)
                    }
                }
                type_deps[name] = deps
            },
            _ => {}
        }
    }

    // DFS cycle detection
    for type_name in type_deps.keys() {
        if type_name == "__s" { continue }
        let visited = {"__s": true}
        let path = []
        if tc_has_type_cycle(type_name, type_deps, visited, path) {
            tc_error_at(0, f"recursive type cycle detected: {path.join(' -> ')} -> {type_name}")
        }
    }
}

func tc_has_type_cycle(current, deps, visited, path) {
    if visited.has(current) && current != "__s" { return true }
    visited[current] = true
    path.push(current)

    if deps.has(current) && current != "__s" {
        const dep_list = deps[current]
        for dep in dep_list {
            if tc_has_type_cycle(dep, deps, visited, path) { return true }
        }
    }

    path.pop()
    false
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Enhanced Error Reporting with Span Information
// ═══════════════════════════════════════════════════════════════════

// Structured diagnostic
func tc_diagnostic(line, col, msg, severity, code, help) {
    {
        "line": line,
        "column": col,
        "message": msg,
        "severity": severity,
        "code": code,
        "help": help,
        "suggestion": null
    }
}

// Add structured error
func tc_add_error(line, msg, code, help) {
    const diag = tc_diagnostic(line, 0, msg, "error", code, help)
    tc_errors.push(diag)
}

// Add structured warning
func tc_add_warning(line, msg, code, help) {
    const diag = tc_diagnostic(line, 0, msg, "warning", code, help)
    tc_warnings.push(diag)
}

// Format a diagnostic for display
func tc_format_diagnostic(diag) {
    if typeof(diag) == "string" { return diag }
    let result = ""
    if diag.has("severity") { result = result + diag["severity"] + ": " }
    if diag.has("code") && diag["code"] != null { result = result + "[" + diag["code"] + "] " }
    if diag.has("line") { result = result + "line " + to_string(diag["line"]) + ": " }
    result = result + diag["message"]
    if diag.has("help") && diag["help"] != null {
        result = result + "\n  help: " + diag["help"]
    }
    if diag.has("suggestion") && diag["suggestion"] != null {
        result = result + "\n  suggestion: " + diag["suggestion"]
    }
    result
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Full Lint Entry Point
// ═══════════════════════════════════════════════════════════════════

// Run all lint rules on a program
func lint(program) {
    let warnings = []
    const stmts = program.statements

    // Initialize lint rules
    lint_init_rules()

    // Import-level checks
    tc_lint_w208_duplicate_imports(stmts)
    tc_lint_w232_too_many_imports(stmts)
    tc_check_unused_imports(stmts)

    // Per-statement lint checks
    for stmt in stmts {
        const line = stmt.span.start_line
        const sk = stmt.kind

        // Function-level checks
        match sk {
            StmtKind::SFuncDef(fdef) => {
                tc_lint_w202_too_many_params(fdef, line)
                tc_check_function_length(fdef, line)
                tc_lint_w241_mixed_returns(fdef, line)
                tc_lint_w242_infer_warning(fdef, line)
                tc_lint_w243_missing_base_case(fdef, line)
                if fdef.body != null {
                    tc_lint_w108_unnecessary_return(fdef.body.stmts, line)
                    tc_check_unreachable(fdef.body.stmts, line)
                }
                tc_check_naming_convention(fdef.name, "function", line)
            },
            StmtKind::SStructDef(name, fields, _methods) => {
                tc_lint_w234_duplicate_struct_fields(fields, line)
                tc_check_naming_convention(name, "struct", line)
            },
            StmtKind::SEnumDef(name, variants, _methods) => {
                tc_lint_w235_duplicate_enum_variants(variants, line)
                tc_check_naming_convention(name, "enum", line)
            },
            StmtKind::SIf(cond, then_b, else_b) => {
                tc_lint_w225_constant_condition(cond, line)
                tc_lint_w111_redundant_else(then_b, else_b, line)
                tc_lint_w223_collapsible_if(stmt, line)
                tc_lint_w206_empty_block(then_b, "if", line)
            },
            StmtKind::SWhileLoop(_, cond, body) => {
                tc_lint_w204_while_true(cond, line)
                tc_lint_w105_while_true(cond, body, line)
                tc_lint_w206_empty_block(body, "while", line)
                tc_lint_w224_single_iteration_loop(body, line)
            },
            StmtKind::SForLoop(_, _, _, body) => {
                tc_lint_w206_empty_block(body, "for", line)
                tc_lint_w224_single_iteration_loop(body, line)
            },
            StmtKind::SMatch(_, arms) => {
                tc_check_empty_match(arms, line)
                tc_lint_w112_unreachable_pattern(arms, line)
                tc_lint_w231_too_many_arms(arms, line)
            },
            StmtKind::STryCatch(_, catch_var, catch_block, _) => {
                tc_lint_w233_ignored_error(catch_var, catch_block, line)
            },
            StmtKind::SExprStmt(expr) => {
                tc_lint_w106_bool_comparison(expr, line)
                tc_lint_w107_suspicious_arith(expr, line)
                tc_check_self_comparison(expr, line)
            },
            StmtKind::SConst(name, _) => {
                tc_lint_w109_shadowing(name, line)
            },
            StmtKind::SLet(name, _) => {
                tc_lint_w109_shadowing(name, line)
                tc_lint_w209_outer_shadow(name, line)
            },
            StmtKind::SLetMut(name, _) => {
                tc_lint_w109_shadowing(name, line)
                tc_lint_w209_outer_shadow(name, line)
            },
            _ => {}
        }
    }

    // Collect warnings from tc_warnings into result
    for w in tc_warnings {
        warnings.push(if typeof(w) == "string" { w } else { tc_format_diagnostic(w) })
    }
    warnings
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Enhanced Check Entry Point with Full Passes
// ═══════════════════════════════════════════════════════════════════

// Full type checking with all passes enabled
func check_full(program) {
    // Reset all state
    tc_scopes = []
    tc_functions = {"__s": true}
    tc_enums = {"__s": true}
    tc_structs = {"__s": true}
    tc_errors = []
    tc_warnings = []
    tc_loop_depth = 0
    tc_func_depth = 0
    tc_type_params = {"__s": true}
    tc_interfaces = {"__s": true}
    tc_non_null_vars = {"__s": true}
    tc_nullable_vars = {"__s": true}
    tc_resolving_types = {"__s": true}
    tc_modules = {"__s": true}
    tc_operator_overloads = {"__s": true}
    tc_mono_instances = {"__s": true}
    tc_type_methods = {"__s": true}

    const stmts = program.statements

    // Initialize global scope
    tc_push_scope()

    // Pass 1: Pre-register all declarations
    tc_preregister(stmts)

    // Pass 2: Validate imports
    tc_validate_imports(stmts)

    // Pass 3: Detect type cycles
    tc_detect_type_cycles(stmts)

    // Pass 4: Check all statements
    tc_check_stmts(stmts)

    // Pass 5: Post-analysis warnings
    tc_check_unused_imports(stmts)

    // Pop global scope (emits unused variable warnings)
    tc_pop_scope()

    // Return structured result
    let result = []
    result.push(tc_errors)
    result.push(tc_warnings)
    result
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Type Compatibility — Structural Subtyping
// ═══════════════════════════════════════════════════════════════════

// Deep type compatibility check (structural)
func tc_types_compatible_deep(expected, actual) {
    if expected == "unknown" || actual == "unknown" { return true }
    if expected == actual { return true }

    // Numeric widening
    if expected == "float" && actual == "int" { return true }
    if expected == "float64" && actual == "int64" { return true }

    // Null is compatible with optional
    if actual == "null" {
        if typeof(expected) == "map" && expected.has("kind") && expected["kind"] == "optional" {
            return true
        }
        return true // MAGI allows null anywhere
    }

    // Type parameter always compatible
    if tc_is_type_param(expected) || tc_is_type_param(actual) { return true }

    // Complex types
    if typeof(expected) == "map" && typeof(actual) == "map" {
        if !expected.has("kind") || !actual.has("kind") { return true }
        const ek = expected["kind"]
        const ak = actual["kind"]

        if ek != ak { return false }

        match ek {
            "array" => {
                return tc_types_compatible_deep(expected["element"], actual["element"])
            },
            "map" => {
                return tc_types_compatible_deep(expected["key"], actual["key"]) &&
                       tc_types_compatible_deep(expected["value"], actual["value"])
            },
            "function" => {
                // Check parameter count
                const ep = if expected.has("params") { expected["params"] } else { [] }
                const ap = if actual.has("params") { actual["params"] } else { [] }
                if len(ep) != len(ap) { return false }
                // Params are contravariant
                let i = 0
                while i < len(ep) {
                    if !tc_types_compatible_deep(ap[i], ep[i]) { return false }
                    i = i + 1
                }
                // Return type is covariant
                const er = if expected.has("return") { expected["return"] } else { "void" }
                const ar = if actual.has("return") { actual["return"] } else { "void" }
                return tc_types_compatible_deep(er, ar)
            },
            "optional" => {
                return tc_types_compatible_deep(expected["inner"], actual["inner"])
            },
            "tuple" => {
                const ee = if expected.has("elements") { expected["elements"] } else { [] }
                const ae = if actual.has("elements") { actual["elements"] } else { [] }
                if len(ee) != len(ae) { return false }
                let i = 0
                while i < len(ee) {
                    if !tc_types_compatible_deep(ee[i], ae[i]) { return false }
                    i = i + 1
                }
                return true
            },
            "generic" => {
                if expected["name"] != actual["name"] { return false }
                const ea = if expected.has("args") { expected["args"] } else { [] }
                const aa = if actual.has("args") { actual["args"] } else { [] }
                if len(ea) != len(aa) { return false }
                let i = 0
                while i < len(ea) {
                    if !tc_types_compatible_deep(ea[i], aa[i]) { return false }
                    i = i + 1
                }
                return true
            },
            _ => true
        }
    }

    false
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Type Unification (for generic inference)
// ═══════════════════════════════════════════════════════════════════

// Unify two types, producing substitutions for type parameters
func tc_unify(expected, actual, substitutions) {
    if expected == actual { return true }
    if expected == "unknown" || actual == "unknown" { return true }

    // If expected is a type parameter, bind it
    if typeof(expected) == "string" && tc_is_type_param(expected) {
        if substitutions.has(expected) {
            // Already bound: check consistency
            return tc_types_compatible_deep(substitutions[expected], actual)
        }
        substitutions[expected] = actual
        return true
    }

    // If actual is a type parameter, bind it
    if typeof(actual) == "string" && tc_is_type_param(actual) {
        if substitutions.has(actual) {
            return tc_types_compatible_deep(expected, substitutions[actual])
        }
        substitutions[actual] = expected
        return true
    }

    // Unify complex types
    if typeof(expected) == "map" && typeof(actual) == "map" {
        if !expected.has("kind") || !actual.has("kind") { return true }
        if expected["kind"] != actual["kind"] { return false }

        match expected["kind"] {
            "array" => tc_unify(expected["element"], actual["element"], substitutions),
            "map" => {
                tc_unify(expected["key"], actual["key"], substitutions) &&
                tc_unify(expected["value"], actual["value"], substitutions)
            },
            "function" => {
                const ep = if expected.has("params") { expected["params"] } else { [] }
                const ap = if actual.has("params") { actual["params"] } else { [] }
                if len(ep) != len(ap) { return false }
                let i = 0
                while i < len(ep) {
                    if !tc_unify(ep[i], ap[i], substitutions) { return false }
                    i = i + 1
                }
                const er = if expected.has("return") { expected["return"] } else { "void" }
                const ar = if actual.has("return") { actual["return"] } else { "void" }
                tc_unify(er, ar, substitutions)
            },
            "optional" => tc_unify(expected["inner"], actual["inner"], substitutions),
            "tuple" => {
                const ee = if expected.has("elements") { expected["elements"] } else { [] }
                const ae = if actual.has("elements") { actual["elements"] } else { [] }
                if len(ee) != len(ae) { return false }
                let i = 0
                while i < len(ee) {
                    if !tc_unify(ee[i], ae[i], substitutions) { return false }
                    i = i + 1
                }
                true
            },
            _ => true
        }
    } else {
        false
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Generic Function Call Type Inference
// ═══════════════════════════════════════════════════════════════════

// Infer type arguments for a generic function call from argument types
func tc_infer_type_args(func_name, arg_exprs, line) {
    if !tc_functions.has(func_name) { return [] }
    const sig = tc_functions[func_name]
    if !sig.has("type_params") || sig["type_params"] == null { return [] }
    const type_params = sig["type_params"]

    // Build substitution map by unifying parameter types with argument types
    let substitutions = {"__s": true}
    let i = 0
    const param_limit = if len(sig.params) < len(arg_exprs) { len(sig.params) } else { len(arg_exprs) }
    while i < param_limit {
        const param_type = if typeof(sig.params[i]) == "map" && sig.params[i].has("type") {
            sig.params[i]["type"]
        } else { "unknown" }
        const arg_type = tc_infer_expr_type_full(arg_exprs[i])
        tc_unify(param_type, arg_type, substitutions)
        i = i + 1
    }

    // Extract type arguments in order
    let type_args = []
    for tp in type_params {
        const name = if typeof(tp) == "string" { tp } else { tp[0] }
        if substitutions.has(name) {
            type_args.push(substitutions[name])
        } else {
            type_args.push("unknown")
        }
    }
    type_args
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Const Expression Evaluation (Constant Folding)
// ═══════════════════════════════════════════════════════════════════

// Evaluate a constant expression at compile time
func tc_eval_const_expr(expr) {
    if expr == null { return null }
    match expr.kind {
        ExprKind::ELiteral(lit) => {
            match lit {
                Literal::IntLit(n) => n,
                Literal::FloatLit(n) => n,
                Literal::StringLit(s) => s,
                Literal::BoolLit(b) => b,
                Literal::NullLit => null,
                _ => null
            }
        },
        ExprKind::EBinaryOp(op, left, right) => {
            const lv = tc_eval_const_expr(left)
            const rv = tc_eval_const_expr(right)
            if lv == null || rv == null { return null }
            match op {
                BinOp::Add => {
                    if typeof(lv) == "string" || typeof(rv) == "string" {
                        to_string(lv) + to_string(rv)
                    } else { lv + rv }
                },
                BinOp::Sub => lv - rv,
                BinOp::Mul => lv * rv,
                BinOp::Div => {
                    if rv == 0 || rv == 0.0 { null } else { lv / rv }
                },
                BinOp::Mod => lv % rv,
                BinOp::Eq => lv == rv,
                BinOp::Ne => lv != rv,
                BinOp::Lt => lv < rv,
                BinOp::Gt => lv > rv,
                BinOp::Le => lv <= rv,
                BinOp::Ge => lv >= rv,
                BinOp::And => lv && rv,
                BinOp::Or => lv || rv,
                _ => null
            }
        },
        ExprKind::EUnaryOp(op, operand) => {
            const v = tc_eval_const_expr(operand)
            if v == null { return null }
            match op {
                UnOp::Neg => 0 - v,
                UnOp::Not => !v,
                _ => null
            }
        },
        ExprKind::EVariable(name) => {
            // Check if variable is a known constant
            const info = tc_lookup_var(name)
            if info != null && !info.mutable {
                return info.const_val // Would need const_val tracking
            }
            null
        },
        _ => null
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Dead Code Detection
// ═══════════════════════════════════════════════════════════════════

// Track called functions
let tc_called_functions = {"__s": true}

// Collect all function calls in the program
func tc_collect_called_functions(stmts) {
    for stmt in stmts {
        tc_collect_calls_stmt(stmt)
    }
}

func tc_collect_calls_stmt(stmt) {
    if stmt == null { return null }
    match stmt.kind {
        StmtKind::SExprStmt(expr) => tc_collect_calls_expr(expr),
        StmtKind::SConst(_, expr) => { if expr != null { tc_collect_calls_expr(expr) } },
        StmtKind::SLet(_, expr) => { if expr != null { tc_collect_calls_expr(expr) } },
        StmtKind::SLetMut(_, expr) => { if expr != null { tc_collect_calls_expr(expr) } },
        StmtKind::SAssignment(_, expr) => { if expr != null { tc_collect_calls_expr(expr) } },
        StmtKind::SReturn(expr) => { if expr != null { tc_collect_calls_expr(expr) } },
        StmtKind::SOutput(expr) => { if expr != null { tc_collect_calls_expr(expr) } },
        StmtKind::SIf(cond, then_b, else_b) => {
            tc_collect_calls_expr(cond)
            if then_b != null { tc_collect_calls_block(then_b) }
            if else_b != null { tc_collect_calls_block(else_b) }
        },
        StmtKind::SWhileLoop(_, cond, body) => {
            tc_collect_calls_expr(cond)
            if body != null { tc_collect_calls_block(body) }
        },
        StmtKind::SForLoop(_, _, iterable, body) => {
            tc_collect_calls_expr(iterable)
            if body != null { tc_collect_calls_block(body) }
        },
        StmtKind::SFuncDef(fdef) => {
            if fdef.body != null { tc_collect_calls_block(fdef.body) }
        },
        StmtKind::SMatch(expr, arms) => {
            tc_collect_calls_expr(expr)
            for arm in arms { tc_collect_calls_expr(arm.body) }
        },
        _ => {}
    }
}

func tc_collect_calls_block(block) {
    if block == null { return null }
    for s in block.stmts { tc_collect_calls_stmt(s) }
    if block.tail_expr != null { tc_collect_calls_expr(block.tail_expr) }
}

func tc_collect_calls_expr(expr) {
    if expr == null { return null }
    match expr.kind {
        ExprKind::ECall(name, args, _) => {
            tc_called_functions[name] = true
            for arg in args { tc_collect_calls_expr(arg) }
        },
        ExprKind::EMethodCall(obj, _method, args, _) => {
            tc_collect_calls_expr(obj)
            for arg in args { tc_collect_calls_expr(arg) }
        },
        ExprKind::EBinaryOp(_, left, right) => {
            tc_collect_calls_expr(left)
            tc_collect_calls_expr(right)
        },
        ExprKind::EUnaryOp(_, operand) => tc_collect_calls_expr(operand),
        ExprKind::EFieldAccess(obj, _) => tc_collect_calls_expr(obj),
        ExprKind::EIndex(obj, idx) => {
            tc_collect_calls_expr(obj)
            tc_collect_calls_expr(idx)
        },
        ExprKind::EIfElse(cond, then_e, else_e) => {
            tc_collect_calls_expr(cond)
            tc_collect_calls_expr(then_e)
            if else_e != null { tc_collect_calls_expr(else_e) }
        },
        ExprKind::ELambda(_, body) => {
            tc_collect_calls_expr(body)
        },
        ExprKind::ELiteral(lit) => {
            match lit {
                Literal::ArrayLit(elems) => { for e in elems { tc_collect_calls_expr(e) } },
                Literal::MapLit(pairs) => {
                    for p in pairs { tc_collect_calls_expr(p[0]); tc_collect_calls_expr(p[1]) }
                },
                _ => {}
            }
        },
        ExprKind::EPipe(left, right) => {
            tc_collect_calls_expr(left)
            tc_collect_calls_expr(right)
        },
        ExprKind::EStringInterp(parts) => {
            for p in parts {
                match p {
                    StringPart::ExprPart(e) => tc_collect_calls_expr(e),
                    _ => {}
                }
            }
        },
        ExprKind::ENullCoalesce(left, right) => {
            tc_collect_calls_expr(left)
            tc_collect_calls_expr(right)
        },
        ExprKind::EBlock(block) => tc_collect_calls_block(block),
        _ => {}
    }
}

// Report unused functions (dead code)
func tc_report_dead_code(line) {
    for fn_name in tc_functions.keys() {
        if fn_name == "__s" { continue }
        if fn_name == "main" { continue } // main is always entry point
        if starts_with(fn_name, "_") { continue } // Private functions
        if starts_with(fn_name, "test_") { continue } // Test functions
        if starts_with(fn_name, "bench_") { continue } // Bench functions
        if !tc_called_functions.has(fn_name) {
            const sig = tc_functions[fn_name]
            tc_warn_at(sig.line, f"function '{fn_name}' is never called (W110)")
        }
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Scope Chain Type Narrowing
// ═══════════════════════════════════════════════════════════════════

// Track type narrowings through control flow
let tc_narrowings = {"__s": true}

func tc_narrow_type(var_name, narrowed_type) {
    tc_narrowings[var_name] = narrowed_type
}

func tc_get_narrowed_type(var_name) {
    if tc_narrowings.has(var_name) && var_name != "__s" {
        return tc_narrowings[var_name]
    }
    null
}

func tc_clear_narrowing(var_name) {
    if tc_narrowings.has(var_name) {
        tc_narrowings.delete(var_name)
    }
}

func tc_clear_all_narrowings() {
    tc_narrowings = {"__s": true}
}

// Narrow types based on typeof checks
func tc_analyze_typeof_narrowing(cond) {
    if cond == null { return null }
    match cond.kind {
        ExprKind::EBinaryOp(op, left, right) => {
            match op {
                BinOp::Eq => {
                    // typeof(x) == "string"
                    if tc_is_typeof_call(left) && tc_is_string_literal(right) {
                        match left.kind {
                            ExprKind::ECall(_, args, _) => {
                                if len(args) > 0 {
                                    match args[0].kind {
                                        ExprKind::EVariable(name) => {
                                            match right.kind {
                                                ExprKind::ELiteral(lit) => {
                                                    match lit {
                                                        Literal::StringLit(type_name) => {
                                                            return {"var": name, "type": type_name}
                                                        },
                                                        _ => {}
                                                    }
                                                },
                                                _ => {}
                                            }
                                        },
                                        _ => {}
                                    }
                                }
                            },
                            _ => {}
                        }
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
    null
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Impl Block Method Registration
// ═══════════════════════════════════════════════════════════════════

// Pre-register methods from impl blocks
func tc_preregister_impl_methods(stmts) {
    for stmt in stmts {
        match stmt.kind {
            StmtKind::SImplBlock(type_name, methods) => {
                for m in methods {
                    const full_name = f"{type_name}.{m.name}"
                    tc_register_func(m, stmt.span.start_line)
                    tc_register_method(type_name, m.name, [], "unknown")
                }
            },
            StmtKind::SImplTrait(trait_name, type_name, methods) => {
                for m in methods {
                    const full_name = f"{type_name}.{m.name}"
                    tc_register_func(m, stmt.span.start_line)
                    tc_register_method(type_name, m.name, [], "unknown")
                }
                // Check interface satisfaction
                tc_check_interface_satisfaction_full(type_name, trait_name, stmt.span.start_line)
            },
            StmtKind::SFuncDef(fdef) => {
                // Handle dot-receiver syntax: func TypeName.method(self)
                if fdef.name.contains(".") {
                    const dot_idx = fdef.name.index_of(".")
                    const recv_type = fdef.name.slice(0, dot_idx)
                    const method_name = fdef.name.slice(dot_idx + 1, len(fdef.name))
                    tc_register_method(recv_type, method_name, [], "unknown")
                }
            },
            _ => {}
        }
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Enum Variant Type Tracking
// ═══════════════════════════════════════════════════════════════════

// Track enum variant payloads: enum_name -> variant_name -> [types]
let tc_enum_variant_types = {"__s": true}

func tc_register_enum_variant_types(enum_name, variants) {
    let vt = {"__s": true}
    for v in variants {
        let payload_types = []
        if typeof(v) == "map" && v.has("fields") {
            for f in v["fields"] {
                if typeof(f) == "map" && f.has("type_ann") {
                    payload_types.push(f["type_ann"])
                } else {
                    payload_types.push("unknown")
                }
            }
        }
        vt[v.name] = payload_types
    }
    tc_enum_variant_types[enum_name] = vt
}

func tc_get_enum_variant_types(enum_name, variant_name) {
    if !tc_enum_variant_types.has(enum_name) || enum_name == "__s" { return [] }
    const vt = tc_enum_variant_types[enum_name]
    if vt.has(variant_name) && variant_name != "__s" { return vt[variant_name] }
    []
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Struct Field Type Tracking
// ═══════════════════════════════════════════════════════════════════

// Track struct field types: struct_name -> field_name -> type
let tc_struct_field_types = {"__s": true}

func tc_register_struct_field_types(struct_name, fields) {
    let ft = {"__s": true}
    for f in fields {
        const name = if typeof(f) == "string" { f } else { f.name }
        const ftype = if typeof(f) == "map" && f.has("type_ann") { f["type_ann"] } else { "unknown" }
        ft[name] = ftype
    }
    tc_struct_field_types[struct_name] = ft
}

func tc_get_struct_field_type(struct_name, field_name) {
    if !tc_struct_field_types.has(struct_name) || struct_name == "__s" { return "unknown" }
    const ft = tc_struct_field_types[struct_name]
    if ft.has(field_name) && field_name != "__s" { return ft[field_name] }
    "unknown"
}

// Enhanced field access type inference
func tc_infer_field_access_type(obj_expr, field_name) {
    const obj_type = tc_infer_expr_type_full(obj_expr)
    const type_str = tc_type_to_string(obj_type)

    // Check struct field types
    if tc_struct_field_types.has(type_str) && type_str != "__s" {
        return tc_get_struct_field_type(type_str, field_name)
    }

    // Built-in field access
    if type_str == "string" {
        if field_name == "length" { return "int" }
    }
    if type_str == "array" || (typeof(obj_type) == "map" && obj_type.has("kind") && obj_type["kind"] == "array") {
        if field_name == "length" { return "int" }
    }

    "unknown"
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Type Alias Resolution
// ═══════════════════════════════════════════════════════════════════

// Type aliases: alias_name -> resolved_type
let tc_type_aliases = {"__s": true}

func tc_register_type_alias(alias_name, resolved_type) {
    tc_type_aliases[alias_name] = resolved_type
}

func tc_resolve_type_alias(type_name) {
    if tc_type_aliases.has(type_name) && type_name != "__s" {
        const resolved = tc_type_aliases[type_name]
        // Recursive resolution (with cycle check)
        if resolved != type_name {
            return tc_resolve_type_alias(resolved)
        }
    }
    type_name
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Expression Type Checking Helpers
// ═══════════════════════════════════════════════════════════════════

// Check that an expression produces a boolean value
func tc_check_boolean_context(expr, line) {
    if expr == null { return null }
    const typ = tc_infer_expr_type_full(expr)
    // In MAGI, all values are truthy/falsy, so this is a soft warning
    if typ == "void" {
        tc_warn_at(line, "void expression used in boolean context")
    }
}

// Check array index expression
func tc_check_index_expr(obj_expr, idx_expr, line) {
    const idx_type = tc_infer_expr_type_full(idx_expr)
    const obj_type = tc_infer_expr_type_full(obj_expr)
    const obj_kind = if typeof(obj_type) == "map" && obj_type.has("kind") { obj_type["kind"] } else { tc_type_to_string(obj_type) }

    if obj_kind == "array" && idx_type != "unknown" && idx_type != "int" {
        tc_warn_at(line, f"array index should be int, got '{tc_type_to_string(idx_type)}'")
    }
    if obj_kind == "map" && idx_type != "unknown" && idx_type != "string" {
        // Maps accept any key
    }
    if obj_kind == "string" && idx_type != "unknown" && idx_type != "int" {
        tc_warn_at(line, f"string index should be int, got '{tc_type_to_string(idx_type)}'")
    }
}

// Check that a value is callable
func tc_check_callable(expr, line) {
    const typ = tc_infer_expr_type_full(expr)
    if typeof(typ) == "map" && typ.has("kind") && typ["kind"] == "function" {
        return true
    }
    if typeof(typ) == "string" {
        if tc_functions.has(typ) { return true }
        if tc_is_builtin(typ) { return true }
    }
    // Not definitively callable, but don't error (dynamic dispatch)
    true
}

// Check spread expression in proper context
func tc_check_spread_context(expr, line) {
    const typ = tc_infer_expr_type_full(expr)
    const type_str = tc_type_to_string(typ)
    if type_str != "unknown" && type_str != "array" {
        if typeof(typ) != "map" || !typ.has("kind") || typ["kind"] != "array" {
            tc_warn_at(line, f"spread operator used on non-array type '{type_str}'")
        }
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Async/Await Type Checking
// ═══════════════════════════════════════════════════════════════════

// Track async function contexts
let tc_async_depth = 0

func tc_check_await_context(line) {
    if tc_async_depth == 0 {
        tc_error_at(line, "await can only be used inside async functions")
    }
}

func tc_check_yield_context(line) {
    if tc_func_depth == 0 {
        tc_error_at(line, "yield can only be used inside generator functions")
    }
}

// Infer the inner type of a Promise/Future
func tc_infer_await_type(expr) {
    const typ = tc_infer_expr_type_full(expr)
    if typeof(typ) == "map" && typ.has("kind") && typ["kind"] == "promise" {
        return typ["inner"]
    }
    // If not a promise, await returns the value directly
    typ
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Exhaustive Check Entry Point with Dead Code Analysis
// ═══════════════════════════════════════════════════════════════════

func check_exhaustive(program) {
    // Run full type checking
    const result = check_full(program)

    // Additional: dead code analysis
    tc_called_functions = {"__s": true}
    tc_collect_called_functions(program.statements)
    tc_report_dead_code(0)

    // Additional: impl method registration
    tc_preregister_impl_methods(program.statements)

    result
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Type Graph — Dependency Analysis
// ═══════════════════════════════════════════════════════════════════

// Build a type dependency graph for ordering compilation
let tc_type_graph = {"__s": true}

func tc_build_type_graph(stmts) {
    for stmt in stmts {
        match stmt.kind {
            StmtKind::SStructDef(name, fields, _) => {
                let deps = []
                for f in fields {
                    const ft = if typeof(f) == "map" && f.has("type_ann") { f["type_ann"] } else { null }
                    if ft != null && typeof(ft) == "string" {
                        if tc_structs.has(ft) || tc_enums.has(ft) {
                            if !deps.contains(ft) { deps.push(ft) }
                        }
                    }
                }
                tc_type_graph[name] = deps
            },
            StmtKind::SEnumDef(name, variants, _) => {
                let deps = []
                for v in variants {
                    if typeof(v) == "map" && v.has("fields") {
                        for f in v["fields"] {
                            const ft = if typeof(f) == "map" && f.has("type_ann") { f["type_ann"] } else { null }
                            if ft != null && typeof(ft) == "string" {
                                if tc_structs.has(ft) || tc_enums.has(ft) {
                                    if !deps.contains(ft) { deps.push(ft) }
                                }
                            }
                        }
                    }
                }
                tc_type_graph[name] = deps
            },
            _ => {}
        }
    }
}

// Topological sort of type definitions
func tc_topological_sort_types() {
    let in_degree = {}
    for name in tc_type_graph.keys() {
        if name == "__s" { continue }
        if !in_degree.has(name) { in_degree[name] = 0 }
        for dep in tc_type_graph[name] {
            if !in_degree.has(dep) { in_degree[dep] = 0 }
            in_degree[dep] = in_degree[dep] + 1
        }
    }

    let queue = []
    for name in in_degree.keys() {
        if in_degree[name] == 0 { queue.push(name) }
    }

    let order = []
    while len(queue) > 0 {
        const current = queue[0]
        queue = queue.slice(1, len(queue))
        order.push(current)
        if tc_type_graph.has(current) {
            for dep in tc_type_graph[current] {
                in_degree[dep] = in_degree[dep] - 1
                if in_degree[dep] == 0 { queue.push(dep) }
            }
        }
    }
    order
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Trait Coherence Checking
// ═══════════════════════════════════════════════════════════════════

// Track trait implementations: trait_name -> [type_names]
let tc_trait_impls = {"__s": true}

func tc_register_trait_impl(trait_name, type_name) {
    if !tc_trait_impls.has(trait_name) {
        tc_trait_impls[trait_name] = []
    }
    let impls = tc_trait_impls[trait_name]
    if impls.contains(type_name) {
        // Duplicate implementation
        return false
    }
    impls.push(type_name)
    tc_trait_impls[trait_name] = impls
    true
}

// Check for orphan implementations
func tc_check_orphan_rules(trait_name, type_name, line) {
    // In MAGI, orphan rules are relaxed — just warn about duplicates
    if !tc_register_trait_impl(trait_name, type_name) {
        tc_error_at(line, f"duplicate implementation of '{trait_name}' for type '{type_name}'")
    }
}

// Check that all required trait methods are implemented
func tc_check_trait_completeness(trait_name, type_name, implemented_methods, line) {
    if !tc_interfaces.has(trait_name) || trait_name == "__s" { return null }
    const iface = tc_interfaces[trait_name]
    const required = iface["methods"]

    for req in required {
        const method_name = req["name"]
        let found = false
        for m in implemented_methods {
            if m == method_name { found = true; break }
        }
        if !found {
            tc_error_at(line, f"missing method '{method_name}' in implementation of '{trait_name}' for '{type_name}'")
        }
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Where-Clause Constraint Validation
// ═══════════════════════════════════════════════════════════════════

// Parse and validate where clauses on generic functions
func tc_validate_where_clause(where_clause, line) {
    if where_clause == null { return null }
    // where_clause is a list of: [type_param, constraint]
    for constraint in where_clause {
        if typeof(constraint) != "array" || len(constraint) < 2 { continue }
        const param_name = constraint[0]
        const bound = constraint[1]

        if !tc_is_type_param(param_name) {
            tc_error_at(line, f"where clause references unknown type parameter '{param_name}'")
        }
        tc_check_generic_constraint(param_name, bound, line)
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Variance Tracking
// ═══════════════════════════════════════════════════════════════════

// Track variance of type parameters: "covariant", "contravariant", "invariant"
let tc_param_variance = {"__s": true}

func tc_set_variance(type_name, param_name, variance) {
    const key = type_name + "." + param_name
    if tc_param_variance.has(key) {
        const existing = tc_param_variance[key]
        if existing != variance && existing != "invariant" {
            tc_param_variance[key] = "invariant"
        }
    } else {
        tc_param_variance[key] = variance
    }
}

func tc_get_variance(type_name, param_name) {
    const key = type_name + "." + param_name
    if tc_param_variance.has(key) { return tc_param_variance[key] }
    "covariant" // Default
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Accessibility Checking (pub/priv)
// ═══════════════════════════════════════════════════════════════════

// Track visibility: name -> "public" | "private" | "internal"
let tc_visibility = {"__s": true}

func tc_set_visibility(name, vis) {
    tc_visibility[name] = vis
}

func tc_get_visibility(name) {
    if tc_visibility.has(name) && name != "__s" { return tc_visibility[name] }
    "public" // Default
}

func tc_check_visibility(name, from_module, line) {
    const vis = tc_get_visibility(name)
    if vis == "private" && from_module != null {
        tc_error_at(line, f"cannot access private member '{name}' from module '{from_module}'")
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Comprehensive Flow Analysis
// ═══════════════════════════════════════════════════════════════════

// Track definite assignment: ensure variables are assigned before use
let tc_definitely_assigned = {"__s": true}

func tc_mark_assigned(name) {
    tc_definitely_assigned[name] = true
}

func tc_is_assigned(name) {
    tc_definitely_assigned.has(name) && name != "__s"
}

// Analyze definite assignment for an if-else
func tc_analyze_definite_assignment_if(var_name, then_assigns, else_assigns) {
    // Variable is definitely assigned if both branches assign it
    then_assigns && else_assigns
}

// Check for use before assignment
func tc_check_use_before_assign(name, line) {
    if !tc_is_assigned(name) && tc_is_defined(name) {
        const info = tc_lookup_var(name)
        if info != null && info.mutable {
            tc_warn_at(line, f"variable '{name}' may be used before assignment")
        }
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Annotation Processing
// ═══════════════════════════════════════════════════════════════════

// Known annotations
const KNOWN_ANNOTATIONS = [
    "test", "bench", "deprecated", "inline", "cold", "hot",
    "no_mangle", "export", "wasm_export", "derive",
    "allow", "warn", "deny", "cfg", "feature"
]

func tc_validate_annotation(name, line) {
    if !KNOWN_ANNOTATIONS.contains(name) {
        tc_warn_at(line, f"unknown annotation '#[{name}]' — did you mean one of: {KNOWN_ANNOTATIONS.join(', ')}?")
    }
}

// Process annotation effects
func tc_process_annotation(name, args, target_name, line) {
    match name {
        "deprecated" => {
            // Mark target as deprecated
            if tc_functions.has(target_name) {
                let sig = tc_functions[target_name]
                // Would mark deprecated flag
            }
        },
        "allow" => {
            // Suppress a specific lint rule
            if len(args) > 0 {
                lint_enabled_rules.delete(args[0])
            }
        },
        "deny" => {
            // Elevate a warning to an error
            if len(args) > 0 {
                // Would need severity escalation
            }
        },
        "test" => {
            // Mark as test function — validated elsewhere
        },
        "derive" => {
            // Auto-derive trait implementations
            for trait_name in args {
                tc_auto_derive_trait(target_name, trait_name, line)
            }
        },
        _ => {}
    }
}

// Auto-derive common traits
func tc_auto_derive_trait(type_name, trait_name, line) {
    match trait_name {
        "Debug" => {
            tc_register_method(type_name, "debug_string", [], "string")
        },
        "Display" => {
            tc_register_method(type_name, "to_string", [], "string")
        },
        "Clone" => {
            tc_register_method(type_name, "clone", [], type_name)
        },
        "PartialEq" | "Eq" => {
            tc_register_method(type_name, "eq", ["self"], "bool")
        },
        "Hash" => {
            tc_register_method(type_name, "hash", [], "int")
        },
        "Default" => {
            tc_register_method(type_name, "default", [], type_name)
        },
        _ => {
            tc_warn_at(line, f"cannot auto-derive '{trait_name}' for type '{type_name}'")
        }
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Suspicious Pattern Detection
// ═══════════════════════════════════════════════════════════════════

// Detect common bug patterns
func tc_detect_suspicious_patterns(stmts) {
    for stmt in stmts {
        const line = stmt.span.start_line
        match stmt.kind {
            StmtKind::SAssignment(name, expr) => {
                // Self-assignment: x = x
                if expr != null {
                    match expr.kind {
                        ExprKind::EVariable(var_name) => {
                            if var_name == name {
                                tc_warn_at(line, f"self-assignment: '{name} = {name}' has no effect")
                            }
                        },
                        _ => {}
                    }
                }
            },
            StmtKind::SExprStmt(expr) => {
                // Effectless expression (pure expression as statement)
                if tc_is_pure_expr(expr) {
                    tc_warn_at(line, "expression result is unused and has no side effects")
                }
            },
            StmtKind::SIf(cond, then_b, else_b) => {
                // if(x) return true else return false => return x
                if then_b != null && else_b != null {
                    if tc_is_trivial_bool_return(then_b, true) && tc_is_trivial_bool_return(else_b, false) {
                        tc_warn_at(line, "if/else returning true/false — simplify to return condition directly")
                    }
                }
            },
            _ => {}
        }
    }
}

func tc_is_pure_expr(expr) {
    if expr == null { return false }
    match expr.kind {
        ExprKind::ELiteral(_) => true,
        ExprKind::EVariable(_) => true,
        ExprKind::EBinaryOp(_, left, right) => tc_is_pure_expr(left) && tc_is_pure_expr(right),
        ExprKind::EUnaryOp(_, operand) => tc_is_pure_expr(operand),
        _ => false
    }
}

func tc_is_trivial_bool_return(block, expected_value) {
    if block == null { return false }
    if len(block.stmts) != 1 { return false }
    match block.stmts[0].kind {
        StmtKind::SReturn(expr) => {
            if expr == null { return false }
            match expr.kind {
                ExprKind::ELiteral(lit) => {
                    match lit {
                        Literal::BoolLit(v) => v == expected_value,
                        _ => false
                    }
                },
                _ => false
            }
        },
        _ => false
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Complexity Analysis
// ═══════════════════════════════════════════════════════════════════

// Compute cyclomatic complexity of a function
func tc_cyclomatic_complexity(fdef) {
    if fdef.body == null { return 1 }
    let complexity = 1
    complexity = complexity + tc_count_decision_points_block(fdef.body)
    complexity
}

func tc_count_decision_points_block(block) {
    if block == null { return 0 }
    let count = 0
    for s in block.stmts {
        count = count + tc_count_decision_points_stmt(s)
    }
    count
}

func tc_count_decision_points_stmt(stmt) {
    if stmt == null { return 0 }
    match stmt.kind {
        StmtKind::SIf(_, then_b, else_b) => {
            let count = 1
            count = count + tc_count_decision_points_block(then_b)
            if else_b != null { count = count + tc_count_decision_points_block(else_b) }
            count
        },
        StmtKind::SWhileLoop(_, _, body) => 1 + tc_count_decision_points_block(body),
        StmtKind::SDoWhile(_, _, body) => 1 + tc_count_decision_points_block(body),
        StmtKind::SForLoop(_, _, _, body) => 1 + tc_count_decision_points_block(body),
        StmtKind::SMatch(_, arms) => {
            let count = len(arms)
            for arm in arms {
                // Each arm with a guard adds complexity
                if arm.guard != null { count = count + 1 }
            }
            count
        },
        StmtKind::STryCatch(try_b, _, catch_b, finally_b) => {
            let count = 1
            count = count + tc_count_decision_points_block(try_b)
            count = count + tc_count_decision_points_block(catch_b)
            if finally_b != null { count = count + tc_count_decision_points_block(finally_b) }
            count
        },
        _ => 0
    }
}

// Warn on high complexity
func tc_check_complexity(fdef, line) {
    const complexity = tc_cyclomatic_complexity(fdef)
    if complexity > 15 {
        tc_warn_at(line, f"function '{fdef.name}' has high cyclomatic complexity ({complexity}) — consider splitting")
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Type Widening and Narrowing Rules
// ═══════════════════════════════════════════════════════════════════

// Widen a type to its most general form (for join points)
func tc_widen_type(a, b) {
    if a == "unknown" { return b }
    if b == "unknown" { return a }
    if a == b { return a }

    // Numeric widening
    if (a == "int" && b == "float") || (a == "float" && b == "int") { return "float" }
    if (a == "int64" && b == "float64") || (a == "float64" && b == "int64") { return "float64" }

    // Null widening: T | null = optional T
    if a == "null" { return {"kind": "optional", "inner": b} }
    if b == "null" { return {"kind": "optional", "inner": a} }

    // Array element widening
    if typeof(a) == "map" && typeof(b) == "map" {
        if a.has("kind") && b.has("kind") && a["kind"] == b["kind"] {
            match a["kind"] {
                "array" => {
                    const elem = tc_widen_type(a["element"], b["element"])
                    return {"kind": "array", "element": elem}
                },
                "map" => {
                    const key = tc_widen_type(a["key"], b["key"])
                    const val = tc_widen_type(a["value"], b["value"])
                    return {"kind": "map", "key": key, "value": val}
                },
                "optional" => {
                    const inner = tc_widen_type(a["inner"], b["inner"])
                    return {"kind": "optional", "inner": inner}
                },
                _ => {}
            }
        }
    }

    // Union type
    "unknown"
}

// Narrow a type based on a condition
func tc_narrow_from_condition(var_name, cond, narrowing_positive) {
    if cond == null { return null }
    match cond.kind {
        ExprKind::EBinaryOp(op, left, right) => {
            match op {
                BinOp::Ne => {
                    // x != null narrows x to non-null
                    match left.kind {
                        ExprKind::EVariable(name) => {
                            if name == var_name {
                                match right.kind {
                                    ExprKind::ELiteral(lit) => {
                                        match lit {
                                            Literal::NullLit => {
                                                if narrowing_positive {
                                                    tc_enter_null_checked(var_name)
                                                }
                                            },
                                            _ => {}
                                        }
                                    },
                                    _ => {}
                                }
                            }
                        },
                        _ => {}
                    }
                },
                BinOp::Eq => {
                    // x == null makes x definitely null in then-branch
                    match left.kind {
                        ExprKind::EVariable(name) => {
                            if name == var_name {
                                match right.kind {
                                    ExprKind::ELiteral(lit) => {
                                        match lit {
                                            Literal::NullLit => {
                                                if !narrowing_positive {
                                                    tc_enter_null_checked(var_name)
                                                }
                                            },
                                            _ => {}
                                        }
                                    },
                                    _ => {}
                                }
                            }
                        },
                        _ => {}
                    }
                },
                _ => {}
            }
        },
        ExprKind::ECall(name, args, _) => {
            // is_string(x), is_int(x), etc. narrow the type
            if len(args) > 0 {
                match args[0].kind {
                    ExprKind::EVariable(arg_name) => {
                        if arg_name == var_name && narrowing_positive {
                            match name {
                                "is_string" => tc_narrow_type(var_name, "string"),
                                "is_int" => tc_narrow_type(var_name, "int"),
                                "is_float" => tc_narrow_type(var_name, "float"),
                                "is_bool" => tc_narrow_type(var_name, "bool"),
                                "is_array" => tc_narrow_type(var_name, "array"),
                                "is_map" => tc_narrow_type(var_name, "map"),
                                "is_null" => {
                                    if !narrowing_positive {
                                        tc_enter_null_checked(var_name)
                                    }
                                },
                                "is_some" => tc_enter_null_checked(var_name),
                                _ => {}
                            }
                        }
                    },
                    _ => {}
                }
            }
        },
        ExprKind::EUnaryOp(UnOp::Not, inner) => {
            // !cond inverts the narrowing
            tc_narrow_from_condition(var_name, inner, !narrowing_positive)
        },
        _ => {}
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Error Code Registry
// ═══════════════════════════════════════════════════════════════════

// Map error codes to descriptions
func tc_error_description(code) {
    match code {
        "E100" => "Undefined variable",
        "E101" => "Assignment to immutable variable",
        "E102" => "Undefined function",
        "E103" => "Wrong number of arguments",
        "E104" => "Division by zero",
        "E105" => "Non-exhaustive match",
        "E106" => "Break outside of loop",
        "E107" => "Continue outside of loop",
        "E108" => "Return outside of function",
        "E109" => "Type mismatch",
        "E110" => "Duplicate definition",
        "E111" => "Invalid pattern",
        "E112" => "Recursive type cycle",
        "E113" => "Missing required field",
        "E114" => "Unknown enum variant",
        "E115" => "Missing interface method",
        "E116" => "Duplicate trait implementation",
        "E117" => "Await outside async function",
        "E118" => "Yield outside generator",
        "E119" => "Type parameter constraint not satisfied",
        "W100" => "Unused variable",
        "W101" => "Unused import",
        "W102" => "Write-only variable",
        "W103" => "Unnecessary mutable binding",
        "W104" => "Empty block",
        "W105" => "Infinite loop without break",
        "W106" => "Boolean literal comparison",
        "W107" => "Suspicious arithmetic",
        "W108" => "Unnecessary return",
        "W109" => "Same-scope shadowing",
        "W110" => "Unused function",
        "W111" => "Redundant else after return",
        "W112" => "Unreachable pattern",
        "W113" => "Redundant type annotation",
        "W114" => "Deprecated function usage",
        "W200" => "Non-snake_case naming",
        "W201" => "Non-PascalCase type naming",
        "W202" => "Too many parameters",
        "W203" => "Deep nesting",
        "W204" => "While-true loop",
        "W205" => "Self-comparison",
        "W206" => "Empty block",
        "W207" => "String-based type checking",
        "W208" => "Duplicate import",
        "W209" => "Outer scope shadowing",
        "W210" => "Unreachable code",
        "W211" => "Empty match",
        "W212" => "Unused match result",
        "W213" => "Missing else branch",
        "W214" => "Comparison chain simplification",
        "W220" => "Self-comparison",
        "W221" => "Extra semicolons",
        "W222" => "Unnecessary parentheses",
        "W223" => "Collapsible if",
        "W224" => "Single-iteration loop",
        "W225" => "Constant condition",
        "W230" => "Deep nesting",
        "W231" => "Too many match arms",
        "W232" => "Too many imports",
        "W233" => "Ignored error",
        "W234" => "Duplicate struct field",
        "W235" => "Duplicate enum variant",
        "W240" => "Long function",
        "W241" => "Mixed return types",
        "W242" => "Missing return type annotation",
        "W243" => "Missing recursive base case",
        "W250" => "Magic number",
        "W251" => "TODO/FIXME comment",
        "W260" => "Unchecked null access",
        _ => f"Unknown error code: {code}"
    }
}

// Get help text for an error code
func tc_error_help(code) {
    match code {
        "E100" => "Make sure the variable is defined before use. Check spelling and scope.",
        "E101" => "Declare the variable with 'let mut' instead of 'const' to allow reassignment.",
        "E102" => "Check that the function is defined or imported. Check spelling.",
        "E103" => "Check the function signature for the expected number of parameters.",
        "E104" => "Check that the divisor is not zero. Add a guard condition.",
        "E105" => "Add a wildcard '_' pattern or cover all possible values.",
        "W100" => "Prefix the name with '_' to suppress this warning, or remove the variable.",
        "W108" => "The last expression in a function is implicitly returned. Remove 'return'.",
        "W205" => "Comparing a value to itself is always true (==) or false (!=).",
        "W260" => "Use 'if x != null { ... }' or optional chaining 'x?.field'.",
        _ => null
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Did-You-Mean Suggestions for Type Errors
// ═══════════════════════════════════════════════════════════════════

func tc_suggest_similar_name(name, candidates) {
    let best = null
    let best_dist = 4 // Max distance threshold
    for c in candidates {
        if c == "__s" { continue }
        const dist = tc_levenshtein(name, c)
        if dist < best_dist {
            best_dist = dist
            best = c
        }
    }
    best
}

func tc_levenshtein(a, b) {
    const m = len(a)
    const n = len(b)
    if m == 0 { return n }
    if n == 0 { return m }
    let prev = []
    let i = 0
    while i <= n { prev.push(i); i = i + 1 }
    i = 1
    while i <= m {
        let curr = [i]
        let j = 1
        while j <= n {
            const cost = if a[i - 1] == b[j - 1] { 0 } else { 1 }
            const del = prev[j] + 1
            const ins = curr[j - 1] + 1
            const sub = prev[j - 1] + cost
            let min_val = del
            if ins < min_val { min_val = ins }
            if sub < min_val { min_val = sub }
            curr.push(min_val)
            j = j + 1
        }
        prev = curr
        i = i + 1
    }
    prev[n]
}

// Enhanced undefined variable error with suggestion
func tc_error_undefined_var(name, line) {
    // Collect all defined variable names
    let candidates = []
    let idx = len(tc_scopes) - 1
    while idx >= 0 {
        for k in tc_scopes[idx].keys() {
            if k != "__s" { candidates.push(k) }
        }
        idx = idx - 1
    }
    // Add function names and builtins
    for k in tc_functions.keys() { if k != "__s" { candidates.push(k) } }
    for k in tc_enums.keys() { if k != "__s" { candidates.push(k) } }
    for k in tc_structs.keys() { if k != "__s" { candidates.push(k) } }

    const suggestion = tc_suggest_similar_name(name, candidates)
    if suggestion != null {
        tc_error_at(line, f"undefined variable '{name}' — did you mean '{suggestion}'?")
    } else {
        tc_error_at(line, f"undefined variable '{name}'")
    }
}

// Enhanced undefined function error with suggestion
func tc_error_undefined_func(name, line) {
    let candidates = []
    for k in tc_functions.keys() { if k != "__s" { candidates.push(k) } }
    for k in KNOWN_BUILTINS { candidates.push(k) }
    for k in tc_enums.keys() { if k != "__s" { candidates.push(k) } }
    for k in tc_structs.keys() { if k != "__s" { candidates.push(k) } }

    const suggestion = tc_suggest_similar_name(name, candidates)
    if suggestion != null {
        tc_error_at(line, f"undefined function '{name}' — did you mean '{suggestion}'?")
    } else {
        tc_error_at(line, f"undefined function '{name}'")
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Complete Type Inference for ALL Expression Types
// ═══════════════════════════════════════════════════════════════════

// Type representation constants
const TYPE_NULL = "null"
const TYPE_INT = "int64"
const TYPE_FLOAT = "float64"
const TYPE_STRING = "string"
const TYPE_BOOL = "bool"
const TYPE_ARRAY = "array"
const TYPE_MAP = "map"
const TYPE_SET = "set"
const TYPE_BYTES = "bytes"
const TYPE_TUPLE = "tuple"
const TYPE_FUNCTION = "function"
const TYPE_FUTURE = "future"

// Infer the type of any expression
func tc_infer_expr(expr) {
    if expr == null { return TYPE_NULL }
    match expr.kind {
        ExprKind::ELiteral(lit) => tc_infer_literal(lit),
        ExprKind::EVariable(name) => tc_infer_variable(name, expr),
        ExprKind::EBinaryOp(op, left, right) => tc_infer_binop(op, left, right),
        ExprKind::EUnaryOp(op, operand) => tc_infer_unaryop(op, operand),
        ExprKind::ECall(name, args, _) => tc_infer_call(name, args, expr),
        ExprKind::EMethodCall(obj, method, args, _) => tc_infer_method_call(obj, method, args),
        ExprKind::EPipe(left, right) => tc_infer_expr(right),
        ExprKind::EIfElse(cond, then_block, else_block) => tc_infer_if_else(cond, then_block, else_block),
        ExprKind::EBlock(block) => tc_infer_block_type(block),
        ExprKind::EIndex(obj, idx) => tc_infer_index(obj, idx),
        ExprKind::EFieldAccess(obj, field) => tc_infer_field_access(obj, field),
        ExprKind::ERange(_, _, _) => TYPE_ARRAY,
        ExprKind::ELambda(_, _) => TYPE_FUNCTION,
        ExprKind::EMatch(subject, arms) => tc_infer_match(subject, arms),
        ExprKind::EStringInterp(_) => TYPE_STRING,
        ExprKind::ENullCoalesce(left, right) => tc_infer_null_coalesce(left, right),
        ExprKind::EOptionalChain(_, _) => TYPE_NULL,
        ExprKind::ESpread(inner) => tc_infer_expr(inner),
        ExprKind::EEnumConstruct(_, _, _) => TYPE_MAP,
        ExprKind::EStructConstruct(_, _) => TYPE_MAP,
        ExprKind::ETupleLiteral(_) => TYPE_TUPLE,
        ExprKind::ELoop(_) => TYPE_NULL,
        ExprKind::EListComp(_, _, _, _) => TYPE_ARRAY,
        ExprKind::EMapComp(_, _, _, _, _) => TYPE_MAP,
        ExprKind::EPlaceholder => TYPE_NULL,
        ExprKind::EAwait(inner) => tc_infer_expr(inner),
        ExprKind::ESpawn(_) => TYPE_FUTURE,
        ExprKind::EYield(_) => TYPE_NULL,
        ExprKind::ETryCatch(try_expr, _, _) => tc_infer_expr(try_expr),
        ExprKind::ETryPropagate(inner) => tc_infer_expr(inner),
        ExprKind::ECast(_, type_name) => type_name,
        ExprKind::EIs(_, _) => TYPE_BOOL,
        ExprKind::ETernary(_, then_expr, else_expr) => tc_unify_types(tc_infer_expr(then_expr), tc_infer_expr(else_expr)),
        ExprKind::EChain(exprs) => if len(exprs) > 0 { tc_infer_expr(exprs[len(exprs) - 1]) } else { TYPE_NULL },
        ExprKind::EPower(_, _) => TYPE_FLOAT,
        ExprKind::EStringMul(_, _) => TYPE_STRING,
        ExprKind::ESlice(obj, _, _) => tc_infer_expr(obj),
        ExprKind::EAssert(_, _) => TYPE_NULL,
        ExprKind::ETypeOf(_) => TYPE_STRING,
        _ => TYPE_NULL,
    }
}

func tc_infer_literal(lit) {
    match lit {
        Literal::IntLit(_) => TYPE_INT,
        Literal::FloatLit(_) => TYPE_FLOAT,
        Literal::StringLit(_) => TYPE_STRING,
        Literal::BoolLit(_) => TYPE_BOOL,
        Literal::NullLit => TYPE_NULL,
        Literal::ArrayLit(_) => TYPE_ARRAY,
        Literal::MapLit(_) => TYPE_MAP,
        Literal::SetLit(_) => TYPE_SET,
    }
}

func tc_infer_variable(name, expr) {
    if name == "None" || name == "null" { return TYPE_NULL }
    if name == "true" || name == "false" { return TYPE_BOOL }
    // Look up variable in scope stack
    let idx = len(tc_scopes) - 1
    while idx >= 0 {
        if tc_scopes[idx].has(name) {
            const info = tc_scopes[idx][name]
            info["used"] = true
            tc_scopes[idx][name] = info
            return info["typ"]
        }
        idx = idx - 1
    }
    // Check functions
    if tc_functions.has(name) { return TYPE_FUNCTION }
    // Check enums
    if tc_enums.has(name) { return TYPE_MAP }
    // Check structs
    if tc_structs.has(name) { return TYPE_MAP }
    TYPE_NULL
}

func tc_infer_binop(op, left, right) {
    const lt = tc_infer_expr(left)
    const rt = tc_infer_expr(right)
    match op {
        // Comparison operators always return bool
        BinOp::Eq | BinOp::NotEq | BinOp::Lt | BinOp::Gt |
        BinOp::LtEq | BinOp::GtEq | BinOp::In => TYPE_BOOL,
        // Logical operators return the type of the first truthy/falsy value
        BinOp::And | BinOp::Or => tc_unify_types(lt, rt),
        // Arithmetic with type promotion
        BinOp::Add => tc_infer_add(lt, rt),
        BinOp::Sub | BinOp::Div | BinOp::Mod => tc_infer_arithmetic(lt, rt),
        BinOp::Mul => tc_infer_mul(lt, rt),
        // Bitwise operations return int
        BinOp::BitAnd | BinOp::BitOr | BinOp::BitXor |
        BinOp::Shl | BinOp::Shr | BinOp::AndNot => TYPE_INT,
    }
}

func tc_infer_add(lt, rt) {
    // String + anything = string
    if lt == TYPE_STRING || rt == TYPE_STRING { return TYPE_STRING }
    // Array + array = array
    if lt == TYPE_ARRAY && rt == TYPE_ARRAY { return TYPE_ARRAY }
    // Map + map = map
    if lt == TYPE_MAP && rt == TYPE_MAP { return TYPE_MAP }
    // Numeric promotion
    tc_infer_arithmetic(lt, rt)
}

func tc_infer_mul(lt, rt) {
    // String * int = string repetition
    if lt == TYPE_STRING && rt == TYPE_INT { return TYPE_STRING }
    if lt == TYPE_INT && rt == TYPE_STRING { return TYPE_STRING }
    // Numeric
    tc_infer_arithmetic(lt, rt)
}

func tc_infer_arithmetic(lt, rt) {
    if lt == TYPE_FLOAT || rt == TYPE_FLOAT { return TYPE_FLOAT }
    if lt == TYPE_INT && rt == TYPE_INT { return TYPE_INT }
    if lt == TYPE_INT || rt == TYPE_INT { return TYPE_INT }
    TYPE_NULL
}

func tc_infer_unaryop(op, operand) {
    match op {
        UnOp::Not => TYPE_BOOL,
        UnOp::Neg => {
            const t = tc_infer_expr(operand)
            if t == TYPE_FLOAT { TYPE_FLOAT }
            else if t == TYPE_INT { TYPE_INT }
            else { TYPE_NULL }
        },
    }
}

func tc_infer_call(name, args, expr) {
    // User-defined function
    if tc_functions.has(name) {
        const fn_info = tc_functions[name]
        // Check arity
        const n_args = len(args)
        if fn_info.has("arity") {
            const expected = fn_info["arity"]
            const min_arity = if fn_info.has("min_arity") { fn_info["min_arity"] } else { expected }
            if n_args < min_arity || (n_args > expected && !fn_info.has("has_rest")) {
                const line = if expr.has("line") { expr["line"] } else { 0 }
                tc_error_at(line, f"function '{name}' expects {expected} arguments, got {n_args}")
            }
        }
        if fn_info.has("return_type") { return fn_info["return_type"] }
        return TYPE_NULL
    }
    // Built-in functions
    tc_infer_builtin_call(name, args)
}

func tc_infer_builtin_call(name, args) {
    match name {
        "len" => TYPE_INT,
        "typeof" | "type_name" => TYPE_STRING,
        "println" | "print" | "debug_log" | "output" => {
            if len(args) > 0 { tc_infer_expr(args[0]) } else { TYPE_NULL }
        },
        "assert" | "assert_eq" | "assert_ne" | "assert_throws" => TYPE_NULL,
        "to_string" | "format" | "to_json" => TYPE_STRING,
        "to_int" | "to_int64" | "parse_int" => TYPE_INT,
        "to_float" | "to_float64" | "parse_float" => TYPE_FLOAT,
        "to_bool" => TYPE_BOOL,
        "is_null" | "is_int" | "is_float" | "is_string" | "is_bool" |
        "is_array" | "is_map" | "is_some" | "is_none" | "is_ok" | "is_err" |
        "is_error" | "is_frozen" | "contains" | "contains_key" |
        "starts_with" | "ends_with" | "implements" => TYPE_BOOL,
        "abs" | "min" | "max" | "floor" | "ceil" | "round" => {
            if len(args) > 0 { tc_infer_expr(args[0]) } else { TYPE_NULL }
        },
        "sqrt" | "pow" | "log" | "log2" | "log10" | "sin" | "cos" | "tan" |
        "asin" | "acos" | "atan" | "atan2" | "exp" | "cbrt" | "hypot" => TYPE_FLOAT,
        "range" => TYPE_ARRAY,
        "map" | "filter" | "sort" | "reverse" | "append" | "slice" |
        "keys" | "values" | "chars" | "split" | "flatten" => TYPE_ARRAY,
        "reduce" => TYPE_NULL,
        "join" | "trim" | "replace" | "to_upper" | "to_lower" |
        "substring" | "repeat" | "char_at" => TYPE_STRING,
        "index_of" => TYPE_INT,
        "push" | "pop" => TYPE_NULL,
        "error" => TYPE_MAP,
        "unwrap" | "unwrap_or" => {
            if len(args) > 0 { tc_infer_expr(args[0]) } else { TYPE_NULL }
        },
        "Some" => if len(args) > 0 { tc_infer_expr(args[0]) } else { TYPE_NULL },
        "None" => TYPE_NULL,
        "Ok" | "Err" => TYPE_MAP,
        "Set" => TYPE_SET,
        "Tuple" | "tuple" => TYPE_TUPLE,
        "clone" | "freeze" => {
            if len(args) > 0 { tc_infer_expr(args[0]) } else { TYPE_NULL }
        },
        "hash" => TYPE_INT,
        "input" | "stdin_read" => TYPE_STRING,
        "channel" => TYPE_ARRAY,
        "spawn" => TYPE_FUTURE,
        // Known stdlib operations
        "json_parse" | "yaml_parse" | "toml_parse" => TYPE_MAP,
        "json_stringify" | "yaml_stringify" | "toml_stringify" => TYPE_STRING,
        "regex_match" | "regex_test" => TYPE_BOOL,
        "regex_find" | "regex_find_all" => TYPE_ARRAY,
        "regex_replace" => TYPE_STRING,
        "time_now" | "time_unix" => TYPE_INT,
        "time_format" => TYPE_STRING,
        "uuid" | "uuid_v4" => TYPE_STRING,
        "base64_encode" | "hex_encode" | "url_encode" => TYPE_STRING,
        "base64_decode" | "hex_decode" | "url_decode" => TYPE_STRING,
        "http_get" | "http_post" | "http_put" | "http_delete" |
        "http_patch" | "http_head" | "http_options" | "http_request" => TYPE_MAP,
        "env_get" | "getenv" | "os_getenv" => TYPE_STRING,
        "env_all" | "os_environ" => TYPE_MAP,
        "fs_read" | "read_file" | "file_read" => TYPE_STRING,
        "fs_readdir" | "readdir" => TYPE_ARRAY,
        "fs_exists" | "file_exists" | "path_exists" | "is_dir" | "is_file" => TYPE_BOOL,
        "fs_stat" | "file_stat" => TYPE_MAP,
        "path_join" | "path_dir" | "path_base" | "path_ext" | "path_abs" => TYPE_STRING,
        "exec" | "command" | "os_exec" => TYPE_MAP,
        "args" | "os_args" => TYPE_ARRAY,
        _ => TYPE_NULL,
    }
}

func tc_infer_method_call(obj, method, args) {
    const obj_type = tc_infer_expr(obj)
    tc_infer_method_return(obj_type, method, args)
}

func tc_infer_method_return(obj_type, method, args) {
    // String methods
    if obj_type == TYPE_STRING {
        return match method {
            "len" | "length" | "index_of" | "last_index_of" | "count" => TYPE_INT,
            "contains" | "starts_with" | "ends_with" | "is_empty" |
            "is_blank" | "is_numeric" | "is_alpha" | "is_alphanumeric" |
            "is_upper" | "is_lower" => TYPE_BOOL,
            "trim" | "trim_start" | "trim_end" | "to_upper" | "to_lower" |
            "replace" | "replace_all" | "replace_first" |
            "pad_start" | "pad_end" | "center" | "reverse" |
            "slice" | "substring" | "repeat" | "char_at" |
            "to_camel_case" | "to_snake_case" | "to_kebab_case" |
            "to_pascal_case" | "to_title_case" | "truncate" |
            "to_string" | "to_json" => TYPE_STRING,
            "split" | "lines" | "words" | "chars" | "bytes" |
            "matches" | "match_all" => TYPE_ARRAY,
            "to_int" | "to_int64" | "parse_int" => TYPE_INT,
            "to_float" | "to_float64" | "parse_float" => TYPE_FLOAT,
            _ => TYPE_NULL,
        }
    }
    // Array methods
    if obj_type == TYPE_ARRAY {
        return match method {
            "len" | "length" | "index_of" | "last_index_of" | "count" => TYPE_INT,
            "contains" | "is_empty" | "any" | "all" | "every" | "some" => TYPE_BOOL,
            "push" | "pop" | "shift" | "unshift" | "each" | "for_each" => TYPE_NULL,
            "map" | "filter" | "flat_map" | "sort" | "sort_by" | "reverse" |
            "slice" | "concat" | "flatten" | "unique" | "unique_by" |
            "take" | "skip" | "take_while" | "skip_while" |
            "enumerate" | "zip" | "chunk" | "window" |
            "scan" | "partition" | "keys" | "values" => TYPE_ARRAY,
            "join" | "to_string" | "to_json" => TYPE_STRING,
            "reduce" | "fold" | "find" | "first" | "last" | "min" | "max" |
            "min_by" | "max_by" | "sum" | "product" => TYPE_NULL,
            "group_by" => TYPE_MAP,
            _ => TYPE_NULL,
        }
    }
    // Map methods
    if obj_type == TYPE_MAP {
        return match method {
            "len" | "size" | "count" => TYPE_INT,
            "has" | "contains_key" | "is_empty" | "any" | "all" => TYPE_BOOL,
            "keys" | "values" | "entries" => TYPE_ARRAY,
            "get" | "get_or" | "delete" | "remove" => TYPE_NULL,
            "set" | "insert" | "merge" | "filter" | "map_values" |
            "map_keys" | "pick" | "omit" | "invert" | "clone" => TYPE_MAP,
            "to_string" | "to_json" => TYPE_STRING,
            _ => TYPE_NULL,
        }
    }
    // Numeric methods
    if obj_type == TYPE_INT || obj_type == TYPE_FLOAT {
        return match method {
            "to_string" => TYPE_STRING,
            "to_int" | "to_int64" => TYPE_INT,
            "to_float" | "to_float64" => TYPE_FLOAT,
            "to_bool" => TYPE_BOOL,
            "abs" | "sign" | "clamp" | "min" | "max" => obj_type,
            "pow" | "sqrt" | "cbrt" | "log" | "log2" | "log10" | "exp" => TYPE_FLOAT,
            "is_nan" | "is_infinite" | "is_finite" | "is_zero" | "is_positive" | "is_negative" => TYPE_BOOL,
            _ => TYPE_NULL,
        }
    }
    // Bool methods
    if obj_type == TYPE_BOOL {
        return match method {
            "to_string" => TYPE_STRING,
            "to_int" => TYPE_INT,
            _ => TYPE_NULL,
        }
    }
    TYPE_NULL
}

func tc_infer_if_else(cond, then_block, else_block) {
    // Check condition type
    tc_check_expr(cond)
    const then_type = tc_infer_block_type(then_block)
    if else_block == null { return TYPE_NULL }
    const else_type = tc_infer_block_type(else_block)
    tc_unify_types(then_type, else_type)
}

func tc_infer_block_type(block) {
    if block == null { return TYPE_NULL }
    if typeof(block) == "map" && block.has("statements") {
        const stmts = block["statements"]
        if len(stmts) > 0 {
            const last = stmts[len(stmts) - 1]
            if typeof(last) == "map" && last.has("kind") {
                match last.kind {
                    StmtKind::SExprStmt(expr) => { return tc_infer_expr(expr) },
                    StmtKind::SReturn(expr) => {
                        if expr != null { return tc_infer_expr(expr) }
                        return TYPE_NULL
                    },
                    _ => { return TYPE_NULL },
                }
            }
        }
    }
    TYPE_NULL
}

func tc_infer_index(obj, idx) {
    const obj_type = tc_infer_expr(obj)
    const idx_type = tc_infer_expr(idx)
    // Check array index should be int
    if obj_type == TYPE_ARRAY && idx_type != TYPE_INT && idx_type != TYPE_NULL {
        // Warn about non-integer index
    }
    if obj_type == TYPE_ARRAY { return TYPE_NULL }
    if obj_type == TYPE_MAP { return TYPE_NULL }
    if obj_type == TYPE_STRING { return TYPE_STRING }
    TYPE_NULL
}

func tc_infer_field_access(obj, field) {
    const obj_type = tc_infer_expr(obj)
    // String properties
    if obj_type == TYPE_STRING {
        if field == "length" { return TYPE_INT }
    }
    // Array properties
    if obj_type == TYPE_ARRAY {
        if field == "length" { return TYPE_INT }
    }
    // Map field access is always unknown type
    TYPE_NULL
}

func tc_infer_match(subject, arms) {
    const subject_type = tc_infer_expr(subject)
    let arm_types = []
    for arm in arms {
        if typeof(arm) == "map" && arm.has("body") {
            arm_types.push(tc_infer_block_type(arm["body"]))
        }
    }
    if len(arm_types) == 0 { return TYPE_NULL }
    // Unify all arm types
    let result = arm_types[0]
    let i = 1
    while i < len(arm_types) {
        result = tc_unify_types(result, arm_types[i])
        i = i + 1
    }
    result
}

func tc_infer_null_coalesce(left, right) {
    const lt = tc_infer_expr(left)
    const rt = tc_infer_expr(right)
    tc_unify_types(lt, rt)
}

// Type unification: given two types, produce a common supertype
func tc_unify_types(a, b) {
    if a == b { return a }
    if a == TYPE_NULL { return b }
    if b == TYPE_NULL { return a }
    // Numeric promotion: int + float = float
    if (a == TYPE_INT && b == TYPE_FLOAT) || (a == TYPE_FLOAT && b == TYPE_INT) {
        return TYPE_FLOAT
    }
    // If types are incompatible, return null (unknown)
    TYPE_NULL
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Generic Constraint Propagation Through Call Chains
// ═══════════════════════════════════════════════════════════════════

let tc_generic_params = {}
let tc_generic_constraints = {}

func tc_register_generic_param(name, constraints) {
    tc_generic_params[name] = true
    if len(constraints) > 0 {
        tc_generic_constraints[name] = constraints
    }
}

func tc_is_generic_param(name) {
    tc_generic_params.has(name)
}

func tc_resolve_generic(name) {
    if tc_generic_params.has(name) {
        // Check if we have a concrete binding
        if tc_generic_constraints.has(name) {
            const constraints = tc_generic_constraints[name]
            if len(constraints) > 0 { return constraints[0] }
        }
        return TYPE_NULL
    }
    name
}

func tc_propagate_generics(fn_name, type_args, arg_types) {
    if !tc_functions.has(fn_name) { return null }
    const fn_info = tc_functions[fn_name]
    if !fn_info.has("type_params") { return null }
    const type_params = fn_info["type_params"]
    // Bind type params to actual types from arguments
    let bindings = {}
    let i = 0
    while i < len(type_params) && i < len(arg_types) {
        bindings[type_params[i]] = arg_types[i]
        i = i + 1
    }
    // Override with explicit type args
    i = 0
    while i < len(type_args) && i < len(type_params) {
        bindings[type_params[i]] = type_args[i]
        i = i + 1
    }
    bindings
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Interface Method Resolution with This-Type Substitution
// ═══════════════════════════════════════════════════════════════════

let tc_traits = {}
let tc_trait_impls = {}

func tc_register_trait(name, methods) {
    tc_traits[name] = methods
}

func tc_register_trait_impl(type_name, trait_name, methods) {
    const key = f"{type_name}::{trait_name}"
    tc_trait_impls[key] = methods
}

func tc_check_trait_implementation(type_name, trait_name) {
    if !tc_traits.has(trait_name) { return true }
    const trait_methods = tc_traits[trait_name]
    const impl_key = f"{type_name}::{trait_name}"
    if !tc_trait_impls.has(impl_key) { return false }
    const impl_methods = tc_trait_impls[impl_key]
    // Check that all trait methods are implemented
    for method in trait_methods {
        const method_name = if typeof(method) == "map" { method["name"] } else { method }
        let found = false
        for impl_m in impl_methods {
            const impl_name = if typeof(impl_m) == "map" { impl_m["name"] } else { impl_m }
            if impl_name == method_name { found = true; break }
        }
        if !found { return false }
    }
    true
}

func tc_resolve_method_for_trait(type_name, method_name) {
    // Check if any trait impl for this type provides this method
    for key in tc_trait_impls.keys() {
        if key.starts_with(f"{type_name}::") {
            const impl_methods = tc_trait_impls[key]
            for m in impl_methods {
                const mname = if typeof(m) == "map" { m["name"] } else { m }
                if mname == method_name { return m }
            }
        }
    }
    null
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Null Flow Analysis Through If/Else/Match Branches
// ═══════════════════════════════════════════════════════════════════

// Track which variables are known to be non-null in a given branch
let tc_non_null_vars = {}

func tc_push_null_state() {
    // Save current null state
    let saved = {}
    for k in tc_non_null_vars.keys() {
        saved[k] = tc_non_null_vars[k]
    }
    saved
}

func tc_restore_null_state(saved) {
    tc_non_null_vars = saved
}

func tc_mark_non_null(name) {
    tc_non_null_vars[name] = true
}

func tc_is_known_non_null(name) {
    tc_non_null_vars.has(name)
}

// Analyze null checks in conditions to narrow types
func tc_analyze_null_check(cond) {
    if typeof(cond) != "map" || !cond.has("kind") { return null }
    match cond.kind {
        // x != null narrowing
        ExprKind::EBinaryOp(op, left, right) => {
            match op {
                BinOp::NotEq => {
                    // x != null
                    if typeof(right) == "map" {
                        match right.kind {
                            ExprKind::ELiteral(Literal::NullLit) => {
                                match left.kind {
                                    ExprKind::EVariable(name) => { return {"var": name, "non_null": true} },
                                    _ => {},
                                }
                            },
                            _ => {},
                        }
                    }
                    // null != x
                    if typeof(left) == "map" {
                        match left.kind {
                            ExprKind::ELiteral(Literal::NullLit) => {
                                match right.kind {
                                    ExprKind::EVariable(name) => { return {"var": name, "non_null": true} },
                                    _ => {},
                                }
                            },
                            _ => {},
                        }
                    }
                },
                BinOp::Eq => {
                    // x == null (in else branch, x is non-null)
                    if typeof(right) == "map" {
                        match right.kind {
                            ExprKind::ELiteral(Literal::NullLit) => {
                                match left.kind {
                                    ExprKind::EVariable(name) => { return {"var": name, "null_in_then": true} },
                                    _ => {},
                                }
                            },
                            _ => {},
                        }
                    }
                },
                _ => {},
            }
        },
        _ => {},
    }
    null
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Pattern Type Narrowing in Match Arms
// ═══════════════════════════════════════════════════════════════════

func tc_narrow_type_from_pattern(pattern, subject_type) {
    if typeof(pattern) != "map" || !pattern.has("kind") { return subject_type }
    // Literal patterns narrow to the literal type
    match pattern {
        // Integer literal pattern
        Pattern::Literal(Literal::IntLit(_)) => TYPE_INT,
        Pattern::Literal(Literal::FloatLit(_)) => TYPE_FLOAT,
        Pattern::Literal(Literal::StringLit(_)) => TYPE_STRING,
        Pattern::Literal(Literal::BoolLit(_)) => TYPE_BOOL,
        Pattern::Literal(Literal::NullLit) => TYPE_NULL,
        // Enum variant pattern narrows to the enum type
        Pattern::EnumVariant(_, _, _) => TYPE_MAP,
        // Struct pattern narrows to struct type
        Pattern::Struct(_, _) => TYPE_MAP,
        // Wildcard and variable patterns don't narrow
        _ => subject_type,
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Type Widening for Union-Like Assignments
// ═══════════════════════════════════════════════════════════════════

// When a variable is assigned different types in different branches,
// widen to a union-like type
func tc_widen_type(current, new_type) {
    if current == TYPE_NULL { return new_type }
    if new_type == TYPE_NULL { return current }
    if current == new_type { return current }
    // Numeric widening: int -> float
    if current == TYPE_INT && new_type == TYPE_FLOAT { return TYPE_FLOAT }
    if current == TYPE_FLOAT && new_type == TYPE_INT { return TYPE_FLOAT }
    // Incompatible types: return null (any)
    TYPE_NULL
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Complete Error Code Mapping (E100-E409)
// ═══════════════════════════════════════════════════════════════════

func tc_error_code_message(code) {
    match code {
        "E100" => "type error",
        "E101" => "condition must be boolean",
        "E102" => "undefined function or operation",
        "E103" => "type mismatch in operation argument",
        "E104" => "division by zero",
        "E105" => "non-exhaustive match expression",
        "E106" => "index into empty collection",
        "E107" => "duplicate key in map literal",
        "E108" => "break with value outside loop expression",
        "E200" => "undefined variable",
        "E201" => "undefined function",
        "E202" => "unknown method",
        "E300" => "break outside loop",
        "E301" => "continue outside loop",
        "E302" => "return outside function",
        "E303" => "placeholder outside pipe",
        "E304" => "yield outside generator",
        "E400" => "duplicate variable definition",
        "E401" => "duplicate function definition",
        "E402" => "duplicate enum variant",
        "E403" => "duplicate struct field",
        "E404" => "assignment to immutable variable",
        "E405" => "wrong number of arguments",
        "E406" => "missing required field",
        "E407" => "extra field in struct literal",
        "E408" => "duplicate parameter name",
        "E409" => "circular type alias",
        _ => f"error {code}",
    }
}

func tc_error_code_help_text(code) {
    match code {
        "E100" => "Check that the types are compatible. Use explicit conversion if needed.",
        "E101" => "Conditions must evaluate to a boolean value.",
        "E102" => "Make sure the function is defined or imported. Check spelling.",
        "E103" => "The argument type does not match the expected parameter type.",
        "E104" => "Check that the divisor is not zero. Add a guard condition.",
        "E105" => "Add a wildcard '_' pattern or cover all possible values.",
        "E106" => "The collection is empty, so indexing will always fail.",
        "E107" => "Each key in a map literal must be unique.",
        "E200" => "Make sure the variable is defined before use. Check spelling and scope.",
        "E201" => "Make sure the function is defined or imported. Check spelling.",
        "E202" => "The method is not available on this type. Check the type's available methods.",
        "E300" => "'break' can only be used inside a loop (for, while, loop).",
        "E301" => "'continue' can only be used inside a loop.",
        "E302" => "'return' can only be used inside a function body.",
        "E303" => "The placeholder '_' is only valid inside pipe expressions (|>).",
        "E400" => "Use a different name or remove the duplicate.",
        "E401" => "Each function name must be unique in the same scope.",
        "E404" => "Declare the variable with 'let' instead of 'const' to allow reassignment.",
        "E405" => "Check the function signature for the expected number of parameters.",
        "E409" => "A type alias cannot reference itself, directly or indirectly.",
        _ => null,
    }
}

func tc_emit_error(code, line, msg) {
    const help = tc_error_code_help_text(code)
    tc_errors.push({
        "code": code,
        "line": line,
        "message": msg,
        "help": help,
    })
}

func tc_emit_warning_code(code, line, msg) {
    const help = tc_error_code_help_text(code)
    tc_warnings.push({
        "code": code,
        "line": line,
        "message": msg,
        "help": help,
    })
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Circular Dependency Detection in Type Aliases
// ═══════════════════════════════════════════════════════════════════

let tc_type_alias_map = {}

func tc_register_type_alias(alias, target) {
    tc_type_alias_map[alias] = target
}

func tc_check_circular_alias(alias) {
    let visited = []
    let current = alias
    while tc_type_alias_map.has(current) {
        if visited.contains(current) {
            const chain = visited.join(" -> ") + " -> " + current
            tc_emit_error("E409", 0, f"circular type alias detected: {chain}")
            return true
        }
        visited.push(current)
        current = tc_type_alias_map[current]
    }
    false
}

func tc_resolve_type_alias(name) {
    let visited = []
    let current = name
    while tc_type_alias_map.has(current) {
        if visited.contains(current) { return name }
        visited.push(current)
        current = tc_type_alias_map[current]
    }
    current
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Lint Rule Integration with Configurable Severity
// ═══════════════════════════════════════════════════════════════════

const LINT_WARN = "warn"
const LINT_ERROR = "error"
const LINT_OFF = "off"

// Default lint configuration
let tc_lint_config = {
    "W100": LINT_WARN,   // unused variable
    "W101": LINT_WARN,   // unused import
    "W102": LINT_WARN,   // unused function
    "W103": LINT_WARN,   // dead code after return
    "W104": LINT_WARN,   // empty block
    "W105": LINT_WARN,   // while true without break
    "W106": LINT_WARN,   // double negation
    "W107": LINT_WARN,   // empty range
    "W108": LINT_WARN,   // unnecessary return
    "W109": LINT_WARN,   // unused parameter
    "W110": LINT_WARN,   // mutable but never reassigned
    "W111": LINT_WARN,   // implicit return
    "W112": LINT_WARN,   // default param type mismatch
    "W113": LINT_WARN,   // redundant type annotation
    "W114": LINT_WARN,   // deprecated item
    "W200": LINT_WARN,   // comparison to self
    "W201": LINT_WARN,   // assignment to same value
    "W202": LINT_WARN,   // unreachable pattern
    "W203": LINT_WARN,   // non-exhaustive match
    "W204": LINT_WARN,   // infinite loop without break
    "W205": LINT_WARN,   // self-comparison
    "W206": LINT_WARN,   // empty match/block
    "W260": LINT_WARN,   // null dereference
    "__s": true,
}

func tc_set_lint_severity(code, severity) {
    tc_lint_config[code] = severity
}

func tc_get_lint_severity(code) {
    if tc_lint_config.has(code) { tc_lint_config[code] } else { LINT_WARN }
}

func tc_should_report(code) {
    tc_get_lint_severity(code) != LINT_OFF
}

func tc_lint_emit(code, line, msg) {
    if !tc_should_report(code) { return null }
    const severity = tc_get_lint_severity(code)
    if severity == LINT_ERROR {
        tc_emit_error(code, line, msg)
    } else {
        tc_emit_warning_code(code, line, msg)
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Complete Statement Checking
// ═══════════════════════════════════════════════════════════════════

func tc_check_statement(stmt) {
    if typeof(stmt) != "map" || !stmt.has("kind") { return null }
    const line = if stmt.has("line") { stmt["line"] } else { 0 }
    match stmt.kind {
        StmtKind::SConst(name, expr) => {
            const typ = tc_infer_expr(expr)
            tc_define_var(name, false, typ, line)
        },
        StmtKind::SLet(name, expr) => {
            const typ = tc_infer_expr(expr)
            tc_define_var(name, false, typ, line)
        },
        StmtKind::SLetMut(name, expr) => {
            const typ = tc_infer_expr(expr)
            tc_define_var(name, true, typ, line)
        },
        StmtKind::SAssignment(name, expr) => {
            const typ = tc_infer_expr(expr)
            tc_check_assignment(name, typ, line)
        },
        StmtKind::SCompoundAssign(name, op, expr) => {
            tc_check_var_exists(name, line)
            tc_check_var_mutable(name, line)
            tc_infer_expr(expr)
        },
        StmtKind::SFieldAssign(obj_expr, field, val_expr) => {
            tc_infer_expr(obj_expr)
            tc_infer_expr(val_expr)
        },
        StmtKind::SIndexAssign(obj_expr, idx_expr, val_expr) => {
            tc_infer_expr(obj_expr)
            tc_infer_expr(idx_expr)
            tc_infer_expr(val_expr)
        },
        StmtKind::SFuncDef(fdef) => {
            tc_register_function(fdef)
            tc_check_function_body(fdef)
        },
        StmtKind::SAsyncFuncDef(fdef) => {
            tc_register_function(fdef)
            tc_check_function_body(fdef)
        },
        StmtKind::SReturn(expr) => {
            if tc_func_depth == 0 {
                tc_emit_error("E302", line, "'return' used outside of a function")
            }
            if expr != null { tc_infer_expr(expr) }
        },
        StmtKind::SBreak(_, _) => {
            if tc_loop_depth == 0 {
                tc_emit_error("E300", line, "'break' used outside of a loop")
            }
        },
        StmtKind::SContinue(_) => {
            if tc_loop_depth == 0 {
                tc_emit_error("E301", line, "'continue' used outside of a loop")
            }
        },
        StmtKind::SWhileLoop(_, cond, body) => {
            const cond_type = tc_infer_expr(cond)
            tc_loop_depth = tc_loop_depth + 1
            tc_push_scope()
            tc_check_block(body)
            tc_pop_scope()
            tc_loop_depth = tc_loop_depth - 1
        },
        StmtKind::SForLoop(_, var_expr, iter_expr, body) => {
            const iter_type = tc_infer_expr(iter_expr)
            tc_loop_depth = tc_loop_depth + 1
            tc_push_scope()
            const var_name = match var_expr {
                ExprKind::EVariable(n) => n,
                _ => "_",
            }
            tc_define_var(var_name, false, TYPE_NULL, line)
            tc_check_block(body)
            tc_pop_scope()
            tc_loop_depth = tc_loop_depth - 1
        },
        StmtKind::SDoWhile(_, body, cond) => {
            tc_loop_depth = tc_loop_depth + 1
            tc_push_scope()
            tc_check_block(body)
            tc_pop_scope()
            tc_infer_expr(cond)
            tc_loop_depth = tc_loop_depth - 1
        },
        StmtKind::SMatch(subject, arms) => {
            tc_infer_expr(subject)
            tc_check_match_arms(arms)
        },
        StmtKind::SOutput(expr) => { tc_infer_expr(expr) },
        StmtKind::SExprStmt(expr) => { tc_infer_expr(expr) },
        StmtKind::SStructDef(name, fields, _) => {
            tc_structs[name] = fields
        },
        StmtKind::SEnumDef(name, variants, _) => {
            tc_enums[name] = variants
            tc_check_enum_variants(name, variants, line)
        },
        StmtKind::SThrow(expr) => { tc_infer_expr(expr) },
        StmtKind::STryCatch(try_block, catch_var, catch_block, finally_block) => {
            tc_push_scope()
            tc_check_block(try_block)
            tc_pop_scope()
            tc_push_scope()
            if catch_var != null { tc_define_var(catch_var, false, TYPE_NULL, line) }
            tc_check_block(catch_block)
            tc_pop_scope()
            if finally_block != null {
                tc_push_scope()
                tc_check_block(finally_block)
                tc_pop_scope()
            }
        },
        StmtKind::STestDef(_, body) => {
            tc_push_scope()
            tc_check_block(body)
            tc_pop_scope()
        },
        StmtKind::SImplBlock(_, methods) => {
            for m in methods { tc_check_function_body(m) }
        },
        StmtKind::SImplTrait(_, _, methods) => {
            for m in methods { tc_check_function_body(m) }
        },
        StmtKind::STypeAlias(alias, target) => {
            tc_register_type_alias(alias, target)
            tc_check_circular_alias(alias)
        },
        StmtKind::SLetDestructure(pattern, _, expr) => {
            tc_infer_expr(expr)
        },
        StmtKind::SIncrement(name) => {
            tc_check_var_exists(name, line)
            tc_check_var_mutable(name, line)
        },
        StmtKind::SDecrement(name) => {
            tc_check_var_exists(name, line)
            tc_check_var_mutable(name, line)
        },
        _ => {},
    }
}

func tc_check_assignment(name, typ, line) {
    // Check existence
    let found = false
    let is_mutable = false
    let idx = len(tc_scopes) - 1
    while idx >= 0 {
        if tc_scopes[idx].has(name) {
            found = true
            const info = tc_scopes[idx][name]
            is_mutable = info["mutable"]
            // Update type and mark used/mutated
            info["typ"] = typ
            info["used"] = true
            tc_scopes[idx][name] = info
            break
        }
        idx = idx - 1
    }
    if !found {
        tc_error_undefined_var(name, line)
    } else if !is_mutable {
        tc_emit_error("E404", line, f"cannot assign to immutable variable '{name}'")
    }
}

func tc_check_var_exists(name, line) {
    let idx = len(tc_scopes) - 1
    while idx >= 0 {
        if tc_scopes[idx].has(name) {
            const info = tc_scopes[idx][name]
            info["used"] = true
            tc_scopes[idx][name] = info
            return true
        }
        idx = idx - 1
    }
    tc_error_undefined_var(name, line)
    false
}

func tc_check_var_mutable(name, line) {
    let idx = len(tc_scopes) - 1
    while idx >= 0 {
        if tc_scopes[idx].has(name) {
            const info = tc_scopes[idx][name]
            if !info["mutable"] {
                tc_emit_error("E404", line, f"cannot assign to immutable variable '{name}'")
                return false
            }
            return true
        }
        idx = idx - 1
    }
    false
}

func tc_register_function(fdef) {
    if fdef == null { return null }
    const name = fdef["name"]
    const params = if fdef.has("params") { fdef["params"] } else { [] }
    const n_params = len(params)
    // Count required params (no default value, not rest)
    let min_arity = 0
    let has_rest = false
    for p in params {
        if typeof(p) == "map" {
            if p.has("rest") && p["rest"] { has_rest = true }
            else if !p.has("default") || p["default"] == null { min_arity = min_arity + 1 }
        } else {
            min_arity = min_arity + 1
        }
    }
    tc_functions[name] = {
        "arity": n_params,
        "min_arity": min_arity,
        "has_rest": has_rest,
        "line": 0,
    }
}

func tc_check_function_body(fdef) {
    if fdef == null { return null }
    tc_push_scope()
    tc_func_depth = tc_func_depth + 1
    const saved_loop = tc_loop_depth
    tc_loop_depth = 0
    // Define params
    const params = if fdef.has("params") { fdef["params"] } else { [] }
    for p in params {
        const pname = if typeof(p) == "map" { p["name"] } else { to_string(p) }
        tc_define_var(pname, false, TYPE_NULL, 0)
    }
    // Check body
    if fdef.has("body") {
        tc_check_block(fdef["body"])
    }
    tc_loop_depth = saved_loop
    tc_func_depth = tc_func_depth - 1
    tc_pop_scope()
}

func tc_check_block(block) {
    if block == null { return null }
    if typeof(block) == "map" && block.has("statements") {
        for stmt in block["statements"] {
            tc_check_statement(stmt)
        }
    }
}

func tc_check_expr(expr) {
    tc_infer_expr(expr)
}

func tc_check_match_arms(arms) {
    let has_wildcard = false
    for arm in arms {
        if typeof(arm) == "map" {
            if arm.has("pattern") {
                const p = arm["pattern"]
                if p == "_" || p == "wildcard" { has_wildcard = true }
            }
            if arm.has("body") {
                tc_push_scope()
                tc_check_block(arm["body"])
                tc_pop_scope()
            }
        }
    }
    if !has_wildcard && len(arms) > 0 {
        tc_lint_emit("W203", 0, "non-exhaustive match: consider adding a wildcard '_' arm")
    }
}

func tc_check_enum_variants(name, variants, line) {
    let seen = []
    for v in variants {
        const vname = if typeof(v) == "map" && v.has("name") { v["name"] } else { to_string(v) }
        if seen.contains(vname) {
            tc_emit_error("E402", line, f"duplicate variant '{vname}' in enum '{name}'")
        }
        seen.push(vname)
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Complete Type Check Entry Point
// ═══════════════════════════════════════════════════════════════════

func tc_check_program(prog) {
    // Reset state
    tc_scopes = [tc_new_scope()]
    tc_errors = []
    tc_warnings = []
    tc_functions = {"__s": true}
    tc_enums = {"__s": true}
    tc_structs = {"__s": true}
    tc_loop_depth = 0
    tc_func_depth = 0
    tc_type_alias_map = {"__s": true}
    tc_generic_params = {"__s": true}
    tc_generic_constraints = {"__s": true}
    tc_traits = {"__s": true}
    tc_trait_impls = {"__s": true}
    tc_non_null_vars = {"__s": true}

    // First pass: collect all function definitions and type declarations
    if prog.has("statements") {
        for stmt in prog["statements"] {
            tc_collect_declarations(stmt)
        }
    }

    // Second pass: check all statements
    if prog.has("statements") {
        for stmt in prog["statements"] {
            tc_check_statement(stmt)
        }
    }

    // Pop global scope to generate unused variable warnings
    tc_pop_scope()

    {
        "errors": tc_errors,
        "warnings": tc_warnings,
    }
}

func tc_collect_declarations(stmt) {
    if typeof(stmt) != "map" || !stmt.has("kind") { return null }
    match stmt.kind {
        StmtKind::SFuncDef(fdef) => { tc_register_function(fdef) },
        StmtKind::SAsyncFuncDef(fdef) => { tc_register_function(fdef) },
        StmtKind::SStructDef(name, fields, _) => { tc_structs[name] = fields },
        StmtKind::SEnumDef(name, variants, _) => { tc_enums[name] = variants },
        StmtKind::SInterfaceDef(name, methods, _) => { tc_register_trait(name, methods) },
        StmtKind::STypeAlias(alias, target) => { tc_register_type_alias(alias, target) },
        _ => {},
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Dead Code Detection
// ═══════════════════════════════════════════════════════════════════

func tc_check_dead_code(stmts) {
    let found_terminator = false
    let terminator_line = 0
    for stmt in stmts {
        if found_terminator {
            const line = if typeof(stmt) == "map" && stmt.has("line") { stmt["line"] } else { 0 }
            tc_lint_emit("W103", line, f"unreachable code after line {terminator_line}")
            break
        }
        if typeof(stmt) == "map" && stmt.has("kind") {
            match stmt.kind {
                StmtKind::SReturn(_) => {
                    found_terminator = true
                    terminator_line = if stmt.has("line") { stmt["line"] } else { 0 }
                },
                StmtKind::SThrow(_) => {
                    found_terminator = true
                    terminator_line = if stmt.has("line") { stmt["line"] } else { 0 }
                },
                StmtKind::SBreak(_, _) => {
                    found_terminator = true
                    terminator_line = if stmt.has("line") { stmt["line"] } else { 0 }
                },
                StmtKind::SContinue(_) => {
                    found_terminator = true
                    terminator_line = if stmt.has("line") { stmt["line"] } else { 0 }
                },
                _ => {},
            }
        }
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Constant Folding / Propagation
// ═══════════════════════════════════════════════════════════════════

let tc_const_values = {}

func tc_register_const(name, value) {
    tc_const_values[name] = value
}

func tc_get_const(name) {
    if tc_const_values.has(name) { tc_const_values[name] } else { null }
}

func tc_try_fold_expr(expr) {
    if typeof(expr) != "map" || !expr.has("kind") { return null }
    match expr.kind {
        ExprKind::ELiteral(lit) => {
            match lit {
                Literal::IntLit(n) => n,
                Literal::FloatLit(f) => f,
                Literal::StringLit(s) => s,
                Literal::BoolLit(b) => b,
                _ => null,
            }
        },
        ExprKind::EVariable(name) => tc_get_const(name),
        ExprKind::EBinaryOp(op, left, right) => {
            const lv = tc_try_fold_expr(left)
            const rv = tc_try_fold_expr(right)
            if lv == null || rv == null { return null }
            tc_fold_binop(op, lv, rv)
        },
        ExprKind::EUnaryOp(op, operand) => {
            const v = tc_try_fold_expr(operand)
            if v == null { return null }
            match op {
                UnOp::Neg => 0 - v,
                UnOp::Not => !v,
            }
        },
        _ => null,
    }
}

func tc_fold_binop(op, lv, rv) {
    match op {
        BinOp::Add => lv + rv,
        BinOp::Sub => lv - rv,
        BinOp::Mul => lv * rv,
        BinOp::Div => if rv != 0 { lv / rv } else { null },
        BinOp::Mod => if rv != 0 { lv % rv } else { null },
        BinOp::Eq => lv == rv,
        BinOp::NotEq => lv != rv,
        BinOp::Lt => lv < rv,
        BinOp::Gt => lv > rv,
        BinOp::LtEq => lv <= rv,
        BinOp::GtEq => lv >= rv,
        _ => null,
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Binary Operation Literal Checks
// Warning on self-comparison, division by zero, etc.
// ═══════════════════════════════════════════════════════════════════

func tc_check_binop_literals(op, left, right, line) {
    // W205: comparing a value to itself
    if (op == BinOp::Eq || op == BinOp::NotEq || op == BinOp::Lt || op == BinOp::Gt) {
        if tc_exprs_identical(left, right) {
            tc_lint_emit("W205", line, "comparing a value to itself is always true (==) or false (!=)")
        }
    }
    // E104: division by zero literal
    if op == BinOp::Div || op == BinOp::Mod {
        if typeof(right) == "map" && right.has("kind") {
            match right.kind {
                ExprKind::ELiteral(Literal::IntLit(0)) => {
                    tc_emit_error("E104", line, "division by zero")
                },
                ExprKind::ELiteral(Literal::FloatLit(0.0)) => {
                    tc_emit_error("E104", line, "division by zero (float)")
                },
                _ => {},
            }
        }
    }
}

func tc_exprs_identical(a, b) {
    // Simple identity check: both are the same variable
    if typeof(a) == "map" && typeof(b) == "map" && a.has("kind") && b.has("kind") {
        match a.kind {
            ExprKind::EVariable(name_a) => {
                match b.kind {
                    ExprKind::EVariable(name_b) => { return name_a == name_b },
                    _ => {},
                }
            },
            _ => {},
        }
    }
    false
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Struct Field Validation
// ═══════════════════════════════════════════════════════════════════

func tc_check_struct_construct(name, fields, line) {
    if !tc_structs.has(name) { return null }
    const def_fields = tc_structs[name]
    if typeof(def_fields) != "array" { return null }
    // Check for missing required fields
    let provided = []
    for f in fields {
        const fname = if typeof(f) == "array" { f[0] } else { to_string(f) }
        provided.push(fname)
    }
    for df in def_fields {
        const dname = if typeof(df) == "map" && df.has("name") { df["name"] } else { to_string(df) }
        const has_default = typeof(df) == "map" && df.has("default") && df["default"] != null
        if !provided.contains(dname) && !has_default {
            tc_emit_error("E406", line, f"missing required field '{dname}' in struct '{name}'")
        }
    }
    // Check for extra fields
    let def_names = []
    for df in def_fields {
        const dname = if typeof(df) == "map" && df.has("name") { df["name"] } else { to_string(df) }
        def_names.push(dname)
    }
    for p in provided {
        if !def_names.contains(p) {
            tc_lint_emit("W114", line, f"extra field '{p}' not defined in struct '{name}'")
        }
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Enum Exhaustiveness Checking
// ═══════════════════════════════════════════════════════════════════

func tc_check_match_exhaustive(subject_type, arms) {
    // Check if all enum variants are covered
    if typeof(subject_type) != "string" { return true }
    // Look for the enum name from the subject type
    if !tc_enums.has(subject_type) { return true }
    const variants = tc_enums[subject_type]
    if typeof(variants) != "array" { return true }
    let covered = []
    let has_wildcard = false
    for arm in arms {
        if typeof(arm) != "map" { continue }
        if arm.has("pattern") {
            const p = arm["pattern"]
            if p == "_" || p == "wildcard" { has_wildcard = true }
            if typeof(p) == "map" && p.has("variant") {
                covered.push(p["variant"])
            }
        }
    }
    if has_wildcard { return true }
    // Check if all variants are covered
    for v in variants {
        const vname = if typeof(v) == "map" && v.has("name") { v["name"] } else { to_string(v) }
        if !covered.contains(vname) { return false }
    }
    true
}

func tc_check_bool_exhaustive(arms) {
    let has_true = false
    let has_false = false
    let has_wildcard = false
    for arm in arms {
        if typeof(arm) != "map" { continue }
        if arm.has("pattern") {
            const p = arm["pattern"]
            if p == "_" || p == "wildcard" { has_wildcard = true }
            if typeof(p) == "map" && p.has("kind") {
                match p.kind {
                    ExprKind::ELiteral(Literal::BoolLit(true)) => { has_true = true },
                    ExprKind::ELiteral(Literal::BoolLit(false)) => { has_false = true },
                    _ => {},
                }
            }
        }
    }
    has_wildcard || (has_true && has_false)
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Import Validation
// ═══════════════════════════════════════════════════════════════════

let tc_used_imports = {}
let tc_import_locations = {}

func tc_register_import(module_name, line) {
    // Check if it's a known stdlib module
    if !KNOWN_STDLIB_MODULES.contains(module_name) {
        tc_lint_emit("W101", line, f"unknown stdlib module '{module_name}'")
    }
    tc_import_locations[module_name] = line
}

func tc_mark_import_used(module_name) {
    tc_used_imports[module_name] = true
}

func tc_check_unused_imports() {
    for module in tc_import_locations.keys() {
        if module == "__s" { continue }
        if !tc_used_imports.has(module) {
            const line = tc_import_locations[module]
            tc_lint_emit("W101", line, f"unused import '{module}'")
        }
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Unused Function Detection
// ═══════════════════════════════════════════════════════════════════

let tc_used_functions = {}

func tc_mark_function_used(name) {
    tc_used_functions[name] = true
}

func tc_check_unused_functions() {
    for name in tc_functions.keys() {
        if name == "__s" { continue }
        if starts_with(name, "_") { continue }
        if starts_with(name, "test_") { continue }
        if name == "main" { continue }
        if !tc_used_functions.has(name) {
            const fn_info = tc_functions[name]
            const line = if typeof(fn_info) == "map" && fn_info.has("line") { fn_info["line"] } else { 0 }
            tc_lint_emit("W102", line, f"unused function '{name}'")
        }
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Type Annotation Resolution
// ═══════════════════════════════════════════════════════════════════

func tc_resolve_type_annotation(annotation) {
    if annotation == null { return TYPE_NULL }
    const s = to_string(annotation)
    // Check aliases first
    const resolved = tc_resolve_type_alias(s)
    match resolved {
        "int" | "Int" | "int64" | "Int64" | "i64" => TYPE_INT,
        "float" | "Float" | "float64" | "Float64" | "f64" => TYPE_FLOAT,
        "string" | "String" | "str" => TYPE_STRING,
        "bool" | "Bool" | "boolean" => TYPE_BOOL,
        "array" | "Array" | "List" => TYPE_ARRAY,
        "map" | "Map" | "Dict" | "Object" => TYPE_MAP,
        "null" | "Null" | "void" | "Void" | "()" => TYPE_NULL,
        "set" | "Set" => TYPE_SET,
        "bytes" | "Bytes" => TYPE_BYTES,
        "tuple" | "Tuple" => TYPE_TUPLE,
        _ => {
            // Check if it's a known struct or enum
            if tc_structs.has(resolved) { return TYPE_MAP }
            if tc_enums.has(resolved) { return TYPE_MAP }
            // Check generic params
            if tc_is_generic_param(resolved) { return tc_resolve_generic(resolved) }
            TYPE_NULL
        },
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Redundant Code Detection
// ═══════════════════════════════════════════════════════════════════

func tc_check_redundant_if(cond, line) {
    // Check for `if true` or `if false`
    if typeof(cond) == "map" && cond.has("kind") {
        match cond.kind {
            ExprKind::ELiteral(Literal::BoolLit(true)) => {
                tc_lint_emit("W204", line, "condition is always true")
            },
            ExprKind::ELiteral(Literal::BoolLit(false)) => {
                tc_lint_emit("W204", line, "condition is always false; code is unreachable")
            },
            _ => {},
        }
    }
}

func tc_check_redundant_assignment(name, expr, line) {
    // Check for `x = x` (self-assignment)
    if typeof(expr) == "map" && expr.has("kind") {
        match expr.kind {
            ExprKind::EVariable(rhs_name) => {
                if name == rhs_name {
                    tc_lint_emit("W201", line, f"assigning variable '{name}' to itself")
                }
            },
            _ => {},
        }
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Shadowing Detection
// ═══════════════════════════════════════════════════════════════════

func tc_check_shadowing(name, line) {
    // Check if this variable shadows one in an outer scope
    let depth = len(tc_scopes) - 2  // Skip current scope
    while depth >= 0 {
        if tc_scopes[depth].has(name) {
            const outer = tc_scopes[depth][name]
            const outer_line = outer["line"]
            // Don't warn for variables starting with _
            if !starts_with(name, "_") {
                tc_lint_emit("W113", line, f"variable '{name}' shadows outer variable declared at line {outer_line}")
            }
            return true
        }
        depth = depth - 1
    }
    false
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Unreachable Pattern Detection in Match
// ═══════════════════════════════════════════════════════════════════

func tc_check_unreachable_patterns(arms) {
    let seen_patterns = []
    let wildcard_idx = -1
    let idx = 0
    for arm in arms {
        if typeof(arm) != "map" { idx = idx + 1; continue }
        const p = if arm.has("pattern") { arm["pattern"] } else { null }
        if p == "_" || p == "wildcard" {
            if wildcard_idx >= 0 {
                tc_lint_emit("W202", 0, f"duplicate wildcard pattern in match arm {idx + 1}")
            }
            wildcard_idx = idx
        }
        // Check if subsequent arms after wildcard are unreachable
        if wildcard_idx >= 0 && idx > wildcard_idx {
            tc_lint_emit("W202", 0, f"unreachable pattern in match arm {idx + 1} (wildcard at arm {wildcard_idx + 1})")
        }
        // Check for duplicate literal patterns
        const p_str = to_string(p)
        if seen_patterns.contains(p_str) && p != "_" && p != "wildcard" {
            tc_lint_emit("W202", 0, f"duplicate pattern in match arm {idx + 1}")
        }
        seen_patterns.push(p_str)
        idx = idx + 1
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Method Resolution Lookup Table
// Maps (receiver_type, method_name) -> operation name for type checking
// ═══════════════════════════════════════════════════════════════════

const MUTATING_METHODS = [
    "push", "pop", "set", "remove", "insert",
    "delete", "merge", "sort", "reverse",
    "shift", "filter_nulls",
]

func tc_is_mutating_method(method) {
    MUTATING_METHODS.contains(method)
}

func tc_check_method_receiver_mutability(obj_expr, method, line) {
    if !tc_is_mutating_method(method) { return null }
    if typeof(obj_expr) == "map" && obj_expr.has("kind") {
        match obj_expr.kind {
            ExprKind::EVariable(name) => {
                let idx = len(tc_scopes) - 1
                while idx >= 0 {
                    if tc_scopes[idx].has(name) {
                        const info = tc_scopes[idx][name]
                        if !info["mutable"] {
                            tc_emit_error("E404", line, f"calling mutating method '.{method}()' on immutable variable '{name}'")
                        }
                        return null
                    }
                    idx = idx - 1
                }
            },
            _ => {},
        }
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Complete Finalize — check unused items
// ═══════════════════════════════════════════════════════════════════

func tc_finalize() {
    tc_check_unused_imports()
    tc_check_unused_functions()
    {
        "errors": tc_errors,
        "warnings": tc_warnings,
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Return Type Inference from Function Bodies
// ═══════════════════════════════════════════════════════════════════

func tc_infer_function_return_type(fdef) {
    if fdef == null { return TYPE_NULL }
    // If explicit return type is declared, use it
    if typeof(fdef) == "map" && fdef.has("return_type") && fdef["return_type"] != null {
        return tc_resolve_type_annotation(fdef["return_type"])
    }
    // Collect all return statement types and body tail type
    let return_types = []
    if fdef.has("body") {
        const body = fdef["body"]
        const body_type = tc_infer_block_type(body)
        if body_type != TYPE_NULL { return_types.push(body_type) }
        // Scan for return statements
        tc_collect_return_types(body, return_types)
    }
    if len(return_types) == 0 { return TYPE_NULL }
    // Unify all return types
    let result = return_types[0]
    let i = 1
    while i < len(return_types) {
        result = tc_unify_types(result, return_types[i])
        i = i + 1
    }
    result
}

func tc_collect_return_types(block, types) {
    if typeof(block) != "map" || !block.has("statements") { return null }
    for stmt in block["statements"] {
        if typeof(stmt) != "map" || !stmt.has("kind") { continue }
        match stmt.kind {
            StmtKind::SReturn(expr) => {
                if expr != null {
                    types.push(tc_infer_expr(expr))
                } else {
                    types.push(TYPE_NULL)
                }
            },
            StmtKind::SIf(_, then_block, else_block) => {
                tc_collect_return_types(then_block, types)
                if else_block != null { tc_collect_return_types(else_block, types) }
            },
            StmtKind::SWhileLoop(_, _, body) => {
                tc_collect_return_types(body, types)
            },
            StmtKind::SForLoop(_, _, _, body) => {
                tc_collect_return_types(body, types)
            },
            StmtKind::STryCatch(try_block, _, catch_block, _) => {
                tc_collect_return_types(try_block, types)
                tc_collect_return_types(catch_block, types)
            },
            _ => {},
        }
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Param-Argument Type Compatibility Checking
// ═══════════════════════════════════════════════════════════════════

func tc_check_arg_types(fn_name, params, args, line) {
    let i = 0
    while i < len(params) && i < len(args) {
        const param = params[i]
        const arg = args[i]
        const param_type = if typeof(param) == "map" && param.has("type") {
            tc_resolve_type_annotation(param["type"])
        } else { TYPE_NULL }
        if param_type == TYPE_NULL { i = i + 1; continue }
        const arg_type = tc_infer_expr(arg)
        if arg_type == TYPE_NULL { i = i + 1; continue }
        if arg_type != param_type && !tc_types_compatible(arg_type, param_type) {
            const pname = if typeof(param) == "map" && param.has("name") { param["name"] } else { f"arg{i}" }
            tc_emit_error("E103", line, f"type mismatch on '{pname}': got {arg_type} but expected {param_type}")
        }
        i = i + 1
    }
}

func tc_types_compatible(actual, expected) {
    if actual == expected { return true }
    if actual == TYPE_NULL || expected == TYPE_NULL { return true }
    // int is compatible with float
    if actual == TYPE_INT && expected == TYPE_FLOAT { return true }
    // array/tuple compatibility
    if actual == TYPE_TUPLE && expected == TYPE_ARRAY { return true }
    if actual == TYPE_ARRAY && expected == TYPE_TUPLE { return true }
    false
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Struct Method Resolution
// ═══════════════════════════════════════════════════════════════════

let tc_struct_methods = {}

func tc_register_struct_method(struct_name, method_name, params, return_type) {
    const key = f"{struct_name}.{method_name}"
    tc_struct_methods[key] = {
        "params": params,
        "return_type": return_type,
    }
}

func tc_resolve_struct_method(struct_name, method_name) {
    const key = f"{struct_name}.{method_name}"
    if tc_struct_methods.has(key) { return tc_struct_methods[key] }
    null
}

func tc_infer_struct_method_return(struct_name, method_name) {
    const m = tc_resolve_struct_method(struct_name, method_name)
    if m != null && m.has("return_type") { return m["return_type"] }
    TYPE_NULL
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Enum Variant Type Inference
// ═══════════════════════════════════════════════════════════════════

func tc_infer_enum_variant_type(enum_name, variant_name) {
    if !tc_enums.has(enum_name) { return TYPE_NULL }
    const variants = tc_enums[enum_name]
    if typeof(variants) != "array" { return TYPE_NULL }
    for v in variants {
        const vname = if typeof(v) == "map" && v.has("name") { v["name"] } else { to_string(v) }
        if vname == variant_name {
            // Enum variant with fields returns a map
            if typeof(v) == "map" && v.has("fields") && len(v["fields"]) > 0 {
                return TYPE_MAP
            }
            // Enum variant without fields returns a map with metadata
            return TYPE_MAP
        }
    }
    TYPE_NULL
}

func tc_check_enum_construct(enum_name, variant_name, args, line) {
    if !tc_enums.has(enum_name) {
        tc_emit_error("E201", line, f"undefined enum '{enum_name}'")
        return null
    }
    const variants = tc_enums[enum_name]
    if typeof(variants) != "array" { return null }
    let found = false
    let expected_fields = 0
    for v in variants {
        const vname = if typeof(v) == "map" && v.has("name") { v["name"] } else { to_string(v) }
        if vname == variant_name {
            found = true
            if typeof(v) == "map" && v.has("fields") {
                expected_fields = len(v["fields"])
            }
            break
        }
    }
    if !found {
        tc_emit_error("E201", line, f"undefined variant '{variant_name}' in enum '{enum_name}'")
        return null
    }
    if len(args) != expected_fields {
        tc_emit_error("E405", line, f"enum variant '{enum_name}::{variant_name}' expects {expected_fields} fields, got {len(args)}")
    }
    // Infer all arg types for side effects
    for a in args { tc_infer_expr(a) }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Integer Overflow Detection
// ═══════════════════════════════════════════════════════════════════

const MAX_SAFE_INT = 140737488355327
const MIN_SAFE_INT = -140737488355327

func tc_check_integer_overflow(val, line) {
    if typeof(val) == "int64" {
        if val > MAX_SAFE_INT || val < MIN_SAFE_INT {
            tc_lint_emit("W114", line, f"integer literal {val} may cause precision loss in some contexts")
        }
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Recursive Type Detection
// ═══════════════════════════════════════════════════════════════════

func tc_check_recursive_struct(name) {
    if !tc_structs.has(name) { return false }
    const fields = tc_structs[name]
    if typeof(fields) != "array" { return false }
    // Check if any field directly references this struct
    for f in fields {
        const ftype = if typeof(f) == "map" && f.has("type") { f["type"] } else { null }
        if ftype != null && to_string(ftype) == name {
            return true
        }
    }
    false
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Utility — diagnostic formatting
// ═══════════════════════════════════════════════════════════════════

func tc_format_diagnostic(diag) {
    const severity = if diag.has("code") && diag["code"].starts_with("W") { "warning" } else { "error" }
    const code = if diag.has("code") { f"[{diag[\"code\"]}] " } else { "" }
    const line = if diag.has("line") && diag["line"] > 0 { f"line {diag[\"line\"]}: " } else { "" }
    const msg = if diag.has("message") { diag["message"] } else { "unknown" }
    f"{severity}: {line}{code}{msg}"
}

func tc_format_all_diagnostics(result) {
    let lines = []
    if result.has("errors") {
        for e in result["errors"] {
            lines.push(tc_format_diagnostic(e))
        }
    }
    if result.has("warnings") {
        for w in result["warnings"] {
            lines.push(tc_format_diagnostic(w))
        }
    }
    lines.join("\n")
}

func tc_has_errors(result) {
    result.has("errors") && len(result["errors"]) > 0
}

func tc_error_count(result) {
    if result.has("errors") { len(result["errors"]) } else { 0 }
}

func tc_warning_count(result) {
    if result.has("warnings") { len(result["warnings"]) } else { 0 }
}

func tc_total_diagnostic_count(result) {
    tc_error_count(result) + tc_warning_count(result)
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Numeric Type Promotion Rules
// ═══════════════════════════════════════════════════════════════════

// Full numeric type lattice for promotion:
// int32 < int64 < float64
// uint32 < uint64 < float64
// float32 < float64

func tc_promote_numeric(a, b) {
    if a == b { return a }
    if a == TYPE_NULL || b == TYPE_NULL { return TYPE_NULL }
    // Float always wins
    if a == TYPE_FLOAT || b == TYPE_FLOAT { return TYPE_FLOAT }
    if a == "float32" || b == "float32" { return TYPE_FLOAT }
    // Int64 wins over smaller ints
    if a == TYPE_INT || b == TYPE_INT { return TYPE_INT }
    if a == "int32" || b == "int32" { return TYPE_INT }
    if a == "uint64" || b == "uint64" { return TYPE_INT }
    if a == "uint32" || b == "uint32" { return TYPE_INT }
    TYPE_NULL
}

func tc_is_numeric_type(t) {
    t == TYPE_INT || t == TYPE_FLOAT ||
    t == "int32" || t == "uint32" || t == "uint64" ||
    t == "float32" || t == "i32" || t == "u32" ||
    t == "u64" || t == "f32" || t == "f64"
}

func tc_is_integer_type(t) {
    t == TYPE_INT || t == "int32" || t == "uint32" || t == "uint64" ||
    t == "i32" || t == "u32" || t == "u64" || t == "i64"
}

func tc_is_float_type(t) {
    t == TYPE_FLOAT || t == "float32" || t == "f32" || t == "f64"
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Comprehensive Expression Checking with Side Effects
// ═══════════════════════════════════════════════════════════════════

func tc_check_all_exprs_in_block(block) {
    if block == null { return null }
    if typeof(block) != "map" || !block.has("statements") { return null }
    for stmt in block["statements"] {
        if typeof(stmt) != "map" || !stmt.has("kind") { continue }
        const line = if stmt.has("line") { stmt["line"] } else { 0 }
        match stmt.kind {
            StmtKind::SExprStmt(expr) => {
                // Check for pure expressions used as statements (no side effects)
                const is_pure = tc_is_pure_expr(expr)
                if is_pure {
                    tc_lint_emit("W111", line, "expression result is unused")
                }
                tc_infer_expr(expr)
            },
            _ => tc_check_statement(stmt),
        }
    }
}

func tc_is_pure_expr(expr) {
    if typeof(expr) != "map" || !expr.has("kind") { return false }
    match expr.kind {
        ExprKind::ELiteral(_) => true,
        ExprKind::EVariable(_) => true,
        ExprKind::EBinaryOp(_, _, _) => true,
        ExprKind::EUnaryOp(_, _) => true,
        ExprKind::EFieldAccess(_, _) => true,
        ExprKind::EIndex(_, _) => true,
        // Calls, method calls, assignments have side effects
        ExprKind::ECall(_, _, _) => false,
        ExprKind::EMethodCall(_, _, _, _) => false,
        // Blocks, ifs, matches may have side effects
        ExprKind::EBlock(_) => false,
        ExprKind::EIfElse(_, _, _) => false,
        _ => false,
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: For-Loop Variable Type Inference
// Infer the iteration variable type from the iterable
// ═══════════════════════════════════════════════════════════════════

func tc_infer_iteration_var_type(iterable_type) {
    match iterable_type {
        "array" => TYPE_NULL,      // Element type unknown
        "string" => TYPE_STRING,   // Characters are strings
        "map" => TYPE_MAP,         // Map entries are {key, value} maps
        "set" => TYPE_NULL,        // Element type unknown
        _ => TYPE_NULL,
    }
}

func tc_infer_range_element_type(start_type, end_type) {
    if start_type == TYPE_INT && end_type == TYPE_INT { return TYPE_INT }
    if tc_is_numeric_type(start_type) || tc_is_numeric_type(end_type) { return TYPE_INT }
    TYPE_INT
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: API — check a source string end-to-end
// ═══════════════════════════════════════════════════════════════════

func type_check_source(code) {
    const prog = parse(code)
    tc_check_program(prog)
}

func type_check_and_format(code) {
    const result = type_check_source(code)
    tc_format_all_diagnostics(result)
}

// ═══════════════════════════════════════════════════════════════════
// SECTION: Quick-check entry point — returns bool
// ═══════════════════════════════════════════════════════════════════

func type_check_ok(code) {
    const result = type_check_source(code)
    !tc_has_errors(result)
}
