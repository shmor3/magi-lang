func i_eval_operation(op_name, inputs) {
    const a = if inputs.has("a") { inputs["a"] } else { null }
    const b = if inputs.has("b") { inputs["b"] } else { null }
    const input = if inputs.has("input") { inputs["input"] }
        else if inputs.has("value") { inputs["value"] }
        else { null }

    if op_name == "Add" { return i_add(a, b) }
    if op_name == "Subtract" { return i_sub(a, b) }
    if op_name == "Multiply" { return i_mul(a, b) }
    if op_name == "Divide" { return i_div(a, b) }
    if op_name == "Modulo" { return i_mod(a, b) }
    if op_name == "Power" { return i_power(a, b) }
    if op_name == "Negate" {
        const v = if input != null { input } else { a }
        return apply_unaryop(UnOp::Neg, v)
    }
    if op_name == "Abs" {
        const v = if input != null { input } else { a }
        const vt = typeof(v)
        if vt == "int64" { return if v < 0 { 0 - v } else { v } }
        if vt == "float64" { return if v < 0.0 { 0.0 - v } else { v } }
        return v
    }
    if op_name == "FloorDiv" {
        if b == 0 { panic("division by zero") }
        return a / b
    }

    if op_name == "Equal" { return a == b }
    if op_name == "NotEqual" { return a != b }
    if op_name == "Greater" { return i_compare(a, b) > 0 }
    if op_name == "Less" { return i_compare(a, b) < 0 }
    if op_name == "GreaterEq" { return i_compare(a, b) >= 0 }
    if op_name == "LessEq" { return i_compare(a, b) <= 0 }
    if op_name == "Min" {
        return if i_compare(a, b) <= 0 { a } else { b }
    }
    if op_name == "Max" {
        return if i_compare(a, b) >= 0 { a } else { b }
    }
    if op_name == "Clamp" {
        const lo = b
        const hi = if inputs.has("c") { inputs["c"] } else { b }
        return i_clamp(input, lo, hi)
    }

    if op_name == "And" { return i_truthy(a) && i_truthy(b) }
    if op_name == "Or" { return i_truthy(a) || i_truthy(b) }
    if op_name == "Not" {
        const v = if input != null { input } else { a }
        return !i_truthy(v)
    }
    if op_name == "Xor" { return i_truthy(a) != i_truthy(b) }

    if op_name == "BitAnd" { return a & b }
    if op_name == "BitOr" { return i_bitop("or", a, b) }
    if op_name == "BitXor" { return a ^ b }
    if op_name == "BitNot" { return (if input != null { input } else { a }) ^ -1 }
    if op_name == "Shl" || op_name == "ShiftLeft" { return a << b }
    if op_name == "Shr" || op_name == "ShiftRight" { return a >> b }
    if op_name == "AndNot" { return a & (b ^ -1) }

    if op_name == "ToString" { return i_display(input) }
    if op_name == "ToInt" || op_name == "ToInt64" { return i_to_int64(input) }
    if op_name == "ToFloat" || op_name == "ToFloat64" { return i_to_float64(input) }
    if op_name == "ToBool" { return i_truthy(input) }
    if op_name == "ParseInt" {
        if typeof(input) == "string" { return parse_int(input) }
        return i_to_int64(input)
    }
    if op_name == "ParseFloat" {
        if typeof(input) == "string" { return parse_float(input) }
        return i_to_float64(input)
    }

    if op_name == "Concat" { return i_add(a, b) }
    if op_name == "StringLength" { return len(input) }
    if op_name == "Substring" {
        const start = if inputs.has("start") { inputs["start"] } else { 0 }
        const end_val = if inputs.has("end") { inputs["end"] } else { len(input) }
        return to_string(input).slice(start, end_val)
    }
    if op_name == "StringContains" { return to_string(a).contains(to_string(b)) }
    if op_name == "StringReplace" {
        const target = if inputs.has("target") { inputs["target"] } else { b }
        const replacement = if inputs.has("replacement") { inputs["replacement"] } else { "" }
        return to_string(input).replace(to_string(target), to_string(replacement))
    }
    if op_name == "StringSplit" { return to_string(input).split(to_string(b)) }
    if op_name == "StringTrim" { return to_string(input).trim() }
    if op_name == "StringUpper" || op_name == "ToUpper" { return to_string(input).to_upper() }
    if op_name == "StringLower" || op_name == "ToLower" { return to_string(input).to_lower() }
    if op_name == "StringStartsWith" { return to_string(input).starts_with(to_string(b)) }
    if op_name == "StringEndsWith" { return to_string(input).ends_with(to_string(b)) }
    if op_name == "StringRepeat" { return i_str_repeat(to_string(input), b) }
    if op_name == "StringReverse" { return to_string(input).reverse() }
    if op_name == "StringJoin" {
        if typeof(input) == "array" {
            const sep = if b != null { to_string(b) } else { "" }
            return input.map(x => i_display(x)).join(sep)
        }
        return i_display(input)
    }
    if op_name == "StringPad" || op_name == "StringPadLeft" { return i_pad_left(to_string(input), b) }
    if op_name == "StringPadRight" { return i_pad_right(to_string(input), b) }
    if op_name == "Capitalize" { return i_str_capitalize(to_string(input)) }
    if op_name == "TitleCase" { return i_str_title_case(to_string(input)) }
    if op_name == "Chars" { return to_string(input).chars() }
    if op_name == "CharAt" {
        const idx = if b != null { b } else { 0 }
        const s = to_string(input)
        if idx >= 0 && idx < len(s) { return s[idx] }
        return ""
    }

    if op_name == "ArrayLength" || op_name == "Length" { return len(input) }
    if op_name == "ArrayPush" || op_name == "Push" {
        if typeof(input) != "array" { return [input, b] }
        return input.append(b)
    }
    if op_name == "ArrayPop" || op_name == "Pop" {
        if typeof(input) != "array" || len(input) == 0 { return null }
        return input[len(input) - 1]
    }
    if op_name == "ArrayGet" || op_name == "Get" || op_name == "Index" {
        const idx = if b != null { b } else { 0 }
        return eval_index(input, idx)
    }
    if op_name == "ArraySlice" || op_name == "Slice" {
        const start = if inputs.has("start") { inputs["start"] } else { 0 }
        const end_val = if inputs.has("end") { inputs["end"] } else { len(input) }
        return input.slice(start, end_val)
    }
    if op_name == "ArrayConcat" { return i_add(input, b) }
    if op_name == "ArrayContains" || op_name == "Contains" {
        if typeof(input) == "array" { return input.contains(b) }
        if typeof(input) == "string" { return input.contains(to_string(b)) }
        return false
    }
    if op_name == "ArrayReverse" || op_name == "Reverse" { return input.reverse() }
    if op_name == "ArraySort" || op_name == "Sort" { return input.sort() }
    if op_name == "ArrayFlatten" || op_name == "Flatten" { return i_iter_flatten(input) }
    if op_name == "ArrayUnique" || op_name == "Unique" { return i_iter_unique(input) }
    if op_name == "ArrayZip" || op_name == "Zip" { return i_iter_zip(input, b) }
    if op_name == "ArrayChunks" || op_name == "Chunks" { return i_iter_chunks(input, b) }
    if op_name == "ArrayWindows" || op_name == "Windows" { return i_iter_windows(input, b) }
    if op_name == "ArrayEnumerate" || op_name == "Enumerate" { return i_iter_enumerate(input) }
    if op_name == "ArraySum" || op_name == "Sum" { return i_iter_sum(input) }
    if op_name == "ArrayProduct" || op_name == "Product" { return i_iter_product(input) }
    if op_name == "ArrayMin" { return i_iter_min(input) }
    if op_name == "ArrayMax" { return i_iter_max(input) }

    if op_name == "MapGet" {
        if typeof(input) == "map" { return eval_index(input, b) }
        return null
    }
    if op_name == "MapSet" || op_name == "MapInsert" {
        if typeof(input) != "map" { return input }
        const key = to_string(b)
        const val = if inputs.has("c") { inputs["c"] } else { null }
        input[key] = val
        return input
    }
    if op_name == "MapDelete" || op_name == "MapRemove" {
        if typeof(input) != "map" { return input }
        return input.delete(to_string(b))
    }
    if op_name == "MapKeys" || op_name == "Keys" {
        if typeof(input) == "map" { return input.keys() }
        return []
    }
    if op_name == "MapValues" || op_name == "Values" {
        if typeof(input) == "map" { return input.values() }
        return []
    }
    if op_name == "MapEntries" || op_name == "Entries" {
        if typeof(input) != "map" { return [] }
        let result = []
        for k in input.keys() { result.push([k, input[k]]) }
        return result
    }
    if op_name == "MapContainsKey" || op_name == "HasKey" {
        if typeof(input) == "map" { return input.has(to_string(b)) }
        return false
    }
    if op_name == "MapMerge" || op_name == "Merge" {
        if typeof(input) != "map" || typeof(b) != "map" { return input }
        let result = {}
        for k in input.keys() { result[k] = input[k] }
        for k in b.keys() { result[k] = b[k] }
        return result
    }
    if op_name == "MapSize" || op_name == "Size" { return len(input) }

    if op_name == "Sqrt" { return i_math_isqrt(input) }
    if op_name == "Floor" { return to_int64(input) }
    if op_name == "Ceil" {
        const v = to_int64(input)
        if to_float64(v) < to_float64(input) { return v + 1 }
        return v
    }
    if op_name == "Round" { return to_int64(to_float64(input) + 0.5) }
    if op_name == "Sign" { return i_math_sign(input) }
    if op_name == "Gcd" { return i_math_gcd(a, b) }
    if op_name == "Lcm" { return i_math_lcm(a, b) }
    if op_name == "Factorial" { return i_math_factorial(input) }
    if op_name == "IsPrime" { return i_math_is_prime(input) }

    if op_name == "IsNull" || op_name == "IsNone" { return input == null }
    if op_name == "IsInt" { return typeof(input) == "int64" }
    if op_name == "IsFloat" { return typeof(input) == "float64" }
    if op_name == "IsString" { return typeof(input) == "string" }
    if op_name == "IsBool" { return typeof(input) == "bool" }
    if op_name == "IsArray" { return typeof(input) == "array" }
    if op_name == "IsMap" { return typeof(input) == "map" }
    if op_name == "TypeOf" || op_name == "TypeName" { return typeof(input) }

    if op_name == "Range" { return eval_range(a, b, false) }
    if op_name == "RangeInclusive" { return eval_range(a, b, true) }

    if op_name == "Hash" { return i_hash(input) }

    if op_name == "Identity" { return input }
    if op_name == "Const" || op_name == "Constant" { return input }
    if op_name == "Debug" {
        println(i_debug_print(input))
        return input
    }
    if op_name == "Output" {
        println(i_display(input))
        return input
    }

    null
}
let i_heap_values = {"__init": true}
let i_heap_next_addr = 65536
let i_heap_alloc_count = 0
const I_HEAP_GC_THRESHOLD = 256
let i_gc_stats = {"cycles": 0, "swept": 0, "peak": 0}

func i_heap_alloc(value) {
    const addr = i_heap_next_addr
    i_heap_next_addr = i_heap_next_addr + 8
    const addr_key = to_string(addr)
    i_heap_values[addr_key] = value
    i_heap_alloc_count = i_heap_alloc_count + 1
    if i_heap_alloc_count >= I_HEAP_GC_THRESHOLD {
        i_heap_collect()
    }
    addr
}

func i_heap_read(addr) {
    const key = to_string(addr)
    if i_heap_values.has(key) { return i_heap_values[key] }
    null
}

func i_heap_write(addr, value) {
    const key = to_string(addr)
    i_heap_values[key] = value
}

func i_heap_collect() {
    let live = {"__init": true}
    for scope in i_scopes {
        for k in scope.keys() {
            if k != "__s" {
                const entry = scope[k]
                const v = entry["value"]
                i_heap_mark(v, live)
            }
        }
    }
    let swept = 0
    let to_remove = []
    for key in i_heap_values.keys() {
        if key != "__init" && !live.has(key) {
            to_remove.push(key)
        }
    }
    for key in to_remove {
        i_heap_values = i_heap_values.delete(key)
        swept = swept + 1
    }
    i_heap_alloc_count = 0
    i_gc_stats["cycles"] = i_gc_stats["cycles"] + 1
    i_gc_stats["swept"] = i_gc_stats["swept"] + swept
    const live_count = len(i_heap_values.keys()) - 1
    if live_count > i_gc_stats["peak"] { i_gc_stats["peak"] = live_count }
    swept
}

func i_heap_mark(val, live) {
    if val == null { return null }
    const t = typeof(val)
    if t == "int64" {
        const key = to_string(val)
        if i_heap_values.has(key) && !live.has(key) {
            live[key] = true
            const heap_val = i_heap_values[key]
            i_heap_mark(heap_val, live)
        }
    }
    if t == "array" {
        for item in val { i_heap_mark(item, live) }
    }
    if t == "map" {
        for k in val.keys() {
            if k != "__s" && k != "__init" {
                i_heap_mark(val[k], live)
            }
        }
    }
    null
}

func i_heap_gc_stats() {
    i_gc_stats
}

func i_heap_live_count() {
    len(i_heap_values.keys()) - 1
}

func i_heap_force_gc() {
    i_heap_collect()
}
func i_save_state() {
    {
        "scopes": i_scopes,
        "functions": i_functions,
        "structs": i_structs,
        "enums": i_enums,
        "impl_methods": i_impl_methods,
        "modules": i_modules,
        "defer_stack": i_defer_stack,
        "loop_labels": i_loop_labels,
        "heap_values": i_heap_values,
        "heap_next_addr": i_heap_next_addr,
    }
}

func i_restore_state(state) {
    i_scopes = state["scopes"]
    i_functions = state["functions"]
    i_structs = state["structs"]
    i_enums = state["enums"]
    i_impl_methods = state["impl_methods"]
    i_modules = state["modules"]
    i_defer_stack = state["defer_stack"]
    i_loop_labels = state["loop_labels"]
    i_heap_values = state["heap_values"]
    i_heap_next_addr = state["heap_next_addr"]
}

func i_push_call_frame(func_name) {
    i_push_scope()
    i_push_defer_frame()
}

func i_pop_call_frame() {
    i_pop_defer_frame()
    i_pop_scope()
}

func i_get_or(name, default_val) {
    let idx = len(i_scopes) - 1
    while idx >= 0 {
        const s = i_scopes[idx]
        if s.has(name) {
            const entry = s[name]
            return entry["value"]
        }
        idx = idx - 1
    }
    default_val
}

func i_has_var(name) {
    let idx = len(i_scopes) - 1
    while idx >= 0 {
        const s = i_scopes[idx]
        if s.has(name) { return true }
        idx = idx - 1
    }
    false
}

func i_scope_depth() {
    len(i_scopes)
}

func i_visible_vars() {
    let seen = {"__init": true}
    let names = []
    let idx = len(i_scopes) - 1
    while idx >= 0 {
        const s = i_scopes[idx]
        for k in s.keys() {
            if k != "__s" && !seen.has(k) {
                seen[k] = true
                names.push(k)
            }
        }
        idx = idx - 1
    }
    names
}

func i_is_mutable(name) {
    let idx = len(i_scopes) - 1
    while idx >= 0 {
        const s = i_scopes[idx]
        if s.has(name) {
            return s[name]["mutable"]
        }
        idx = idx - 1
    }
    false
}

func i_total_var_count() {
    let count = 0
    for scope in i_scopes {
        count = count + len(scope.keys()) - 1
    }
    count
}
func i_to_iterable(val) {
    const t = typeof(val)
    if t == "array" { return val }
    if t == "string" { return val.chars() }
    if t == "map" {
        if val.has("__range_start") {
            return i_eval_range_expr(
                val["__range_start"],
                val["__range_end"],
                if val.has("__range_inclusive") { val["__range_inclusive"] } else { false }
            )
        }
        if val.has("__struct") {
            const sname = val["__struct"]
            const iter_method = i_lookup_struct_method(sname, "__iter__")
            if iter_method != null {
                const result = call_user_func(iter_method, [val])
                if typeof(result) == "array" { return result }
                return [result]
            }
        }
        let result = []
        for k in val.keys() {
            if k != "__s" && k != "__init" {
                result.push({"key": k, "value": val[k]})
            }
        }
        return result
    }
    [val]
}

func eval_for_in_full(var_name, iter_expr, body) {
    const iter_val = eval_expr(iter_expr)
    const items = i_to_iterable(iter_val)
    let result = null
    for item in items {
        i_push_scope()
        i_set(var_name, item, true)
        const r = eval_block(body)
        i_pop_scope()
        if is_break(r) { break }
        if is_continue(r) { continue }
        if is_return(r) { return r }
        result = r
    }
    result
}

func eval_for_in_kv(key_name, val_name, iter_expr, body) {
    const iter_val = eval_expr(iter_expr)
    const t = typeof(iter_val)
    let result = null
    if t == "map" {
        for k in iter_val.keys() {
            if k == "__s" || k == "__init" { continue }
            i_push_scope()
            i_set(key_name, k, true)
            i_set(val_name, iter_val[k], true)
            const r = eval_block(body)
            i_pop_scope()
            if is_break(r) { break }
            if is_continue(r) { continue }
            if is_return(r) { return r }
            result = r
        }
    } else if t == "array" {
        let idx = 0
        for item in iter_val {
            i_push_scope()
            i_set(key_name, idx, true)
            i_set(val_name, item, true)
            const r = eval_block(body)
            i_pop_scope()
            if is_break(r) { break }
            if is_continue(r) { continue }
            if is_return(r) { return r }
            result = r
            idx = idx + 1
        }
    } else {
        panic("for-in with two variables requires map or array")
    }
    result
}

func eval_for_in_indexed(idx_name, val_name, iter_expr, body) {
    const iter_val = eval_expr(iter_expr)
    const items = i_to_iterable(iter_val)
    let result = null
    let idx = 0
    for item in items {
        i_push_scope()
        i_set(idx_name, idx, true)
        i_set(val_name, item, true)
        const r = eval_block(body)
        i_pop_scope()
        if is_break(r) { break }
        if is_continue(r) { continue }
        if is_return(r) { return r }
        result = r
        idx = idx + 1
    }
    result
}

func eval_c_style_for(init_stmt, cond_expr, update_stmt, body) {
    i_push_scope()
    eval_stmt(init_stmt)
    let result = null
    let iterations = 0
    const max_iter = 100000000
    while true {
        if iterations >= max_iter { panic("maximum loop iterations exceeded") }
        const cond_val = eval_expr(cond_expr)
        if !i_truthy(cond_val) { break }
        i_push_scope()
        const r = eval_block(body)
        i_pop_scope()
        if is_break(r) { break }
        if is_continue(r) {
            eval_stmt(update_stmt)
            iterations = iterations + 1
            continue
        }
        if is_return(r) {
            i_pop_scope()
            return r
        }
        result = r
        eval_stmt(update_stmt)
        iterations = iterations + 1
    }
    i_pop_scope()
    result
}
func eval_match_full(subject_val, arms) {
    for arm in arms {
        const bindings = match_pattern_full(arm.pattern, subject_val)
        if bindings != null {
            if arm.guard != null {
                i_push_scope()
                for k in bindings.keys() {
                    if k != "__matched" { i_set(k, bindings[k], true) }
                }
                const guard_result = eval_expr(arm.guard)
                i_pop_scope()
                if !i_truthy(guard_result) { continue }
            }
            i_push_scope()
            for k in bindings.keys() {
                if k != "__matched" { i_set(k, bindings[k], true) }
            }
            const result = eval_expr(arm.body)
            i_pop_scope()
            return result
        }
    }
    null
}

func match_pattern_full(pattern, value) {
    match pattern {
        Pattern::PWildcard => i_empty_bindings(),
        Pattern::PVariable(name) => {
            if name == "_" { return i_empty_bindings() }
            let b = i_empty_bindings()
            b[name] = value
            b
        },
        Pattern::PLiteral(lit_expr) => {
            const lit_val = eval_expr(lit_expr)
            if lit_val == value { i_empty_bindings() } else { null }
        },
        Pattern::PEnum(ename, vname, field_pats) => {
            match_enum_pattern_ext(ename, vname, field_pats, value)
        },
        Pattern::PArray(pats) => {
            match_array_pattern_ext(pats, value)
        },
        Pattern::POr(pats) => {
            match_or_pattern(pats, value)
        },
        Pattern::PType(name, type_name) => {
            const actual = typeof(value)
            let type_match = false
            if actual == type_name { type_match = true }
            if type_name == "int" && actual == "int64" { type_match = true }
            if type_name == "float" && actual == "float64" { type_match = true }
            if type_name == "number" && (actual == "int64" || actual == "float64") { type_match = true }
            if type_name == "any" || type_name == "_" { type_match = true }
            if i_is_struct(value) && i_struct_name(value) == type_name { type_match = true }
            if i_is_enum(value) && i_enum_name(value) == type_name { type_match = true }
            if type_match {
                let b = i_empty_bindings()
                if name != "_" { b[name] = value }
                b
            } else {
                null
            }
        },
        Pattern::PBinding(name, inner_pat) => {
            match_binding_pattern(name, inner_pat, value)
        },
        Pattern::PRest(name) => {
            let b = i_empty_bindings()
            if name != "_" { b[name] = value }
            b
        },
        Pattern::PMap(pair_patterns) => {
            match_map_pattern(pair_patterns, value)
        },
        Pattern::PRange(lo_expr, hi_expr, inclusive) => {
            match_range_pattern(lo_expr, hi_expr, inclusive, value)
        },
        Pattern::PTuple(pats) => {
            if typeof(value) != "array" { return null }
            if len(value) != len(pats) { return null }
            let bindings = i_empty_bindings()
            let idx = 0
            while idx < len(pats) {
                const sub = match_pattern_full(pats[idx], value[idx])
                if sub == null { return null }
                for k in sub.keys() { bindings[k] = sub[k] }
                idx = idx + 1
            }
            bindings
        },
        Pattern::PStruct(struct_name, field_pats) => {
            if !i_is_struct(value) { return null }
            if i_struct_name(value) != struct_name { return null }
            let bindings = i_empty_bindings()
            for pair in field_pats {
                const fname = pair[0]
                const fpat = pair[1]
                if !value.has(fname) { return null }
                const sub = match_pattern_full(fpat, value[fname])
                if sub == null { return null }
                for k in sub.keys() { bindings[k] = sub[k] }
            }
            bindings
        },
        _ => null,
    }
}
func i_coerce_add(left, right) {
    const lt = typeof(left)
    const rt = typeof(right)
    if lt == "int64" && rt == "int64" { return left + right }
    if lt == "int64" && rt == "float64" { return to_float64(left) + right }
    if lt == "float64" && rt == "int64" { return left + to_float64(right) }
    if lt == "float64" && rt == "float64" { return left + right }
    if lt == "string" || rt == "string" {
        return i_display(left) + i_display(right)
    }
    if lt == "bool" && rt == "int64" { return (if left { 1 } else { 0 }) + right }
    if lt == "int64" && rt == "bool" { return left + (if right { 1 } else { 0 }) }
    if lt == "bool" && rt == "bool" { return (if left { 1 } else { 0 }) + (if right { 1 } else { 0 }) }
    if lt == "array" && rt == "array" { return left.concat(right) }
    if left == null { return right }
    if right == null { return left }
    panic(f"cannot add {lt} and {rt}")
}

func i_coerce_sub(left, right) {
    const lt = typeof(left)
    const rt = typeof(right)
    if lt == "int64" && rt == "int64" { return left - right }
    if lt == "int64" && rt == "float64" { return to_float64(left) - right }
    if lt == "float64" && rt == "int64" { return left - to_float64(right) }
    if lt == "float64" && rt == "float64" { return left - right }
    if lt == "bool" { return (if left { 1 } else { 0 }) - (if typeof(right) == "bool" { if right { 1 } else { 0 } } else { right }) }
    if right == null { return left }
    if left == null { return 0 - right }
    panic(f"cannot subtract {lt} and {rt}")
}

func i_coerce_mul(left, right) {
    const lt = typeof(left)
    const rt = typeof(right)
    if lt == "int64" && rt == "int64" { return left * right }
    if lt == "int64" && rt == "float64" { return to_float64(left) * right }
    if lt == "float64" && rt == "int64" { return left * to_float64(right) }
    if lt == "float64" && rt == "float64" { return left * right }
    if lt == "string" && rt == "int64" { return i_str_repeat(left, right) }
    if lt == "int64" && rt == "string" { return i_str_repeat(right, left) }
    if lt == "bool" { return (if left { 1 } else { 0 }) * right }
    if rt == "bool" { return left * (if right { 1 } else { 0 }) }
    panic(f"cannot multiply {lt} and {rt}")
}

func i_coerce_div(left, right) {
    const lt = typeof(left)
    const rt = typeof(right)
    if rt == "int64" && right == 0 { panic("division by zero") }
    if rt == "float64" && right == 0.0 { panic("division by zero") }
    if lt == "int64" && rt == "int64" { return left / right }
    if lt == "int64" && rt == "float64" { return to_float64(left) / right }
    if lt == "float64" && rt == "int64" { return left / to_float64(right) }
    if lt == "float64" && rt == "float64" { return left / right }
    panic(f"cannot divide {lt} and {rt}")
}

func i_coerce_mod(left, right) {
    const lt = typeof(left)
    const rt = typeof(right)
    if rt == "int64" && right == 0 { panic("modulo by zero") }
    if lt == "int64" && rt == "int64" { return left % right }
    if lt == "float64" && rt == "float64" {
        const div = to_int64(left / right)
        return left - to_float64(div) * right
    }
    if lt == "int64" && rt == "float64" { return i_coerce_mod(to_float64(left), right) }
    if lt == "float64" && rt == "int64" { return i_coerce_mod(left, to_float64(right)) }
    panic(f"cannot modulo {lt} and {rt}")
}

func i_coerce_compare(left, right) {
    const lt = typeof(left)
    const rt = typeof(right)
    if lt == rt {
        if lt == "int64" || lt == "float64" || lt == "string" {
            if left < right { return -1 }
            if left > right { return 1 }
            return 0
        }
        if lt == "bool" {
            const li = if left { 1 } else { 0 }
            const ri = if right { 1 } else { 0 }
            return li - ri
        }
    }
    if (lt == "int64" || lt == "float64") && (rt == "int64" || rt == "float64") {
        const lf = to_float64(left)
        const rf = to_float64(right)
        if lf < rf { return -1 }
        if lf > rf { return 1 }
        return 0
    }
    if lt == "bool" { return i_coerce_compare(if left { 1 } else { 0 }, right) }
    if rt == "bool" { return i_coerce_compare(left, if right { 1 } else { 0 }) }
    if left == null && right == null { return 0 }
    if left == null { return -1 }
    if right == null { return 1 }
    const ls = i_display(left)
    const rs = i_display(right)
    if ls < rs { return -1 }
    if ls > rs { return 1 }
    0
}
func i_make_error(kind, message, context) {
    {
        "__error": true,
        "kind": kind,
        "message": message,
        "context": context,
    }
}

func i_type_error(expected, actual, context) {
    i_make_error("TypeError",
        f"expected {expected}, got {actual}",
        context)
}

func i_undefined_var_error(name) {
    const suggestion = i_suggest_name(name, i_visible_vars())
    let msg = f"undefined variable: {name}"
    if suggestion != "" { msg = msg + f" (did you mean '{suggestion}'?)" }
    i_make_error("UndefinedVariable", msg, "variable lookup")
}

func i_arity_error(func_name, expected, actual) {
    i_make_error("ArityMismatch",
        f"{func_name}() expects {expected} arguments, got {actual}",
        f"call to {func_name}")
}

func i_div_zero_error() {
    i_make_error("DivisionByZero", "division by zero", "arithmetic")
}

func i_index_error(index, length) {
    i_make_error("IndexOutOfBounds",
        f"index {index} out of bounds for length {length}",
        "index access")
}

func i_immutable_error(name) {
    i_make_error("ImmutableAssignment",
        f"cannot assign to immutable variable: {name}",
        "assignment")
}

func i_suggest_name(name, candidates) {
    let best = ""
    let best_dist = 999999
    for c in candidates {
        if c == "__s" || c == "__init" { continue }
        const dist = i_str_edit_distance(name, c)
        if dist < best_dist && dist <= 3 {
            best_dist = dist
            best = c
        }
    }
    best
}

func i_format_error(err) {
    if typeof(err) != "map" || !err.has("__error") {
        return i_display(err)
    }
    const kind = err["kind"]
    const message = err["message"]
    const context = err["context"]
    f"[{kind}] {message} (in {context})"
}
func eval_map_comp_expr(key_expr, val_expr, var_expr, iter_expr, cond_expr) {
    const iter_val = eval_expr(iter_expr)
    const var_name = match var_expr.kind {
        ExprKind::EVariable(n) => n,
        _ => "_",
    }
    i_eval_map_comp(key_expr, val_expr, var_name, iter_val, cond_expr)
}
func i_eval_spawn_value(val) {
    {"__future": true, "__resolved": true, "__value": val}
}

func i_is_future(val) {
    if val == null { return false }
    if typeof(val) != "map" { return false }
    val.has("__future")
}
func eval_call_enhanced(name, args) {
    const ext_result = eval_builtin_extended(name, args)
    if ext_result != "__not_builtin__" { return ext_result }

    const stdlib_result = eval_call_stdlib(name, args)
    if stdlib_result != "__not_builtin__" { return stdlib_result }

    if i_functions.has(name) {
        const func_info = i_functions[name]
        return call_user_func(func_info, args)
    }

    if i_structs.has(name) {
        let result = {"__struct": name}
        const fields = i_structs[name]
        let idx = 0
        while idx < len(fields) && idx < len(args) {
            result[fields[idx].name] = args[idx]
            idx = idx + 1
        }
        return result
    }

    if name.contains("::") {
        const parts = name.split("::")
        if len(parts) == 2 {
            const enum_name = parts[0]
            const variant = parts[1]
            if i_enums.has(enum_name) {
                return i_construct_enum(enum_name, variant, args)
            }
        }
    }

    let lambda_val = null
    let found_lambda = false
    let scope_idx = len(i_scopes) - 1
    while scope_idx >= 0 {
        const s = i_scopes[scope_idx]
        if s.has(name) {
            const entry = s[name]
            lambda_val = entry["value"]
            found_lambda = true
            break
        }
        scope_idx = scope_idx - 1
    }
    if found_lambda {
        if typeof(lambda_val) == "map" {
            if lambda_val.has("__lambda") { return call_lambda(lambda_val, args) }
            if lambda_val.has("__closure") { return i_call_closure(lambda_val, args) }
            if lambda_val.has("__memoized") { return i_call_memoized(lambda_val, args) }
            if lambda_val.has("__partial") { return i_call_partial(lambda_val, args) }
            if lambda_val.has("__pipe_chain") { return i_call_pipe_chain(lambda_val, args) }
            if lambda_val.has("__flipped") { return i_call_flipped(lambda_val, args) }
            if lambda_val.has("__negated") { return i_call_negated(lambda_val, args) }
            if lambda_val.has("__composed") { return i_call_composed(lambda_val, args) }
            if lambda_val.has("__fixed") { return i_call_fixed(lambda_val, args) }
            if lambda_val.has("params") && lambda_val.has("body") {
                return call_user_func(lambda_val, args)
            }
        }
        if typeof(lambda_val) == "string" {
            return eval_call_enhanced(lambda_val, args)
        }
    }

    const op_result = i_eval_operation(name, {"input": if len(args) > 0 { args[0] } else { null }, "a": if len(args) > 0 { args[0] } else { null }, "b": if len(args) > 1 { args[1] } else { null }})
    if op_result != null { return op_result }

    panic(f"undefined function: {name}")
}
func eval_int_method(obj, method, args) {
    if method == "abs" { return if obj < 0 { 0 - obj } else { obj } }
    if method == "to_string" || method == "str" { return to_string(obj) }
    if method == "to_float" || method == "to_float64" { return to_float64(obj) }
    if method == "clamp" {
        if len(args) < 2 { panic("clamp() takes 2 arguments") }
        return i_clamp(obj, args[0], args[1])
    }
    if method == "pow" || method == "power" {
        if len(args) != 1 { panic("pow() takes 1 argument") }
        return i_power(obj, args[0])
    }
    if method == "min" {
        if len(args) != 1 { panic("min() takes 1 argument") }
        return if obj < args[0] { obj } else { args[0] }
    }
    if method == "max" {
        if len(args) != 1 { panic("max() takes 1 argument") }
        return if obj > args[0] { obj } else { args[0] }
    }
    if method == "is_even" { return obj % 2 == 0 }
    if method == "is_odd" { return obj % 2 != 0 }
    if method == "is_positive" { return obj > 0 }
    if method == "is_negative" { return obj < 0 }
    if method == "is_zero" { return obj == 0 }
    if method == "sign" { return i_math_sign(obj) }
    if method == "hex" { return i_int_to_hex(obj) }
    if method == "bin" { return i_int_to_bin(obj) }
    if method == "oct" { return i_int_to_oct(obj) }
    if method == "gcd" {
        if len(args) != 1 { panic("gcd() takes 1 argument") }
        return i_math_gcd(obj, args[0])
    }
    if method == "lcm" {
        if len(args) != 1 { panic("lcm() takes 1 argument") }
        return i_math_lcm(obj, args[0])
    }
    if method == "factorial" { return i_math_factorial(obj) }
    if method == "is_prime" { return i_math_is_prime(obj) }
    null
}

func eval_float_method(obj, method, args) {
    if method == "abs" { return if obj < 0.0 { 0.0 - obj } else { obj } }
    if method == "to_string" || method == "str" { return to_string(obj) }
    if method == "to_int" || method == "to_int64" { return to_int64(obj) }
    if method == "floor" { return to_int64(obj) }
    if method == "ceil" {
        const v = to_int64(obj)
        if to_float64(v) < obj { return v + 1 }
        return v
    }
    if method == "round" { return to_int64(obj + 0.5) }
    if method == "clamp" {
        if len(args) < 2 { panic("clamp() takes 2 arguments") }
        return i_clamp(obj, args[0], args[1])
    }
    if method == "is_positive" { return obj > 0.0 }
    if method == "is_negative" { return obj < 0.0 }
    if method == "is_zero" { return obj == 0.0 }
    if method == "sign" { return i_math_sign(obj) }
    if method == "min" {
        if len(args) != 1 { panic("min() takes 1 argument") }
        return if obj < args[0] { obj } else { args[0] }
    }
    if method == "max" {
        if len(args) != 1 { panic("max() takes 1 argument") }
        return if obj > args[0] { obj } else { args[0] }
    }
    null
}

func eval_bool_method(obj, method, args) {
    if method == "to_string" || method == "str" { return if obj { "true" } else { "false" } }
    if method == "to_int" { return if obj { 1 } else { 0 } }
    if method == "then" {
        if len(args) != 1 { panic("then() takes 1 argument") }
        if obj { return i_call_any(args[0], []) }
        return null
    }
    if method == "then_some" {
        if len(args) != 1 { panic("then_some() takes 1 argument") }
        if obj { return args[0] }
        return null
    }
    null
}
func eval_string_method_full(obj, method, args) {
    if method == "trim_left" || method == "ltrim" || method == "trim_start" {
        let i = 0
        while i < len(obj) && (obj[i] == " " || obj[i] == "\t" || obj[i] == "\n" || obj[i] == "\r") {
            i = i + 1
        }
        return obj.slice(i, len(obj))
    }
    if method == "trim_right" || method == "rtrim" || method == "trim_end" {
        let i = len(obj) - 1
        while i >= 0 && (obj[i] == " " || obj[i] == "\t" || obj[i] == "\n" || obj[i] == "\r") {
            i = i - 1
        }
        return obj.slice(0, i + 1)
    }
    if method == "is_empty" || method == "isEmpty" { return len(obj) == 0 }
    if method == "is_blank" {
        return obj.trim() == ""
    }
    if method == "capitalize" { return i_str_capitalize(obj) }
    if method == "title" || method == "title_case" { return i_str_title_case(obj) }
    if method == "is_upper" || method == "is_uppercase" { return i_str_is_upper(obj) }
    if method == "is_lower" || method == "is_lowercase" { return i_str_is_lower(obj) }
    if method == "is_numeric" || method == "is_digit" { return i_str_is_numeric(obj) }
    if method == "is_alpha" {
        if len(obj) == 0 { return false }
        for c in obj.chars() {
            if !((c >= "a" && c <= "z") || (c >= "A" && c <= "Z")) { return false }
        }
        return true
    }
    if method == "is_alphanumeric" || method == "is_alnum" {
        if len(obj) == 0 { return false }
        for c in obj.chars() {
            if !((c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9")) { return false }
        }
        return true
    }
    if method == "strip_prefix" {
        if len(args) != 1 { panic("strip_prefix() takes 1 argument") }
        return i_str_strip_prefix(obj, to_string(args[0]))
    }
    if method == "strip_suffix" {
        if len(args) != 1 { panic("strip_suffix() takes 1 argument") }
        return i_str_strip_suffix(obj, to_string(args[0]))
    }
    if method == "repeat" {
        if len(args) != 1 { panic("repeat() takes 1 argument") }
        return i_str_repeat(obj, args[0])
    }
    if method == "center" {
        if len(args) != 1 { panic("center() takes 1 argument") }
        return i_str_center(obj, args[0])
    }
    if method == "truncate" {
        if len(args) != 1 { panic("truncate() takes 1 argument") }
        return i_str_truncate(obj, args[0])
    }
    if method == "word_wrap" || method == "wrap" {
        if len(args) != 1 { panic("wrap() takes 1 argument") }
        return i_str_word_wrap(obj, args[0])
    }
    if method == "lines" {
        return obj.split("\n")
    }
    if method == "words" {
        return obj.split(" ").filter(w => len(w) > 0)
    }
    if method == "bytes" || method == "byte_length" {
        return len(obj)
    }
    if method == "find" || method == "find_index" {
        if len(args) != 1 { panic("find() takes 1 argument") }
        const sub = to_string(args[0])
        const sub_len = len(sub)
        let i = 0
        while i + sub_len <= len(obj) {
            if obj.slice(i, i + sub_len) == sub { return i }
            i = i + 1
        }
        return -1
    }
    if method == "find_all" {
        if len(args) != 1 { panic("find_all() takes 1 argument") }
        return i_str_find_all(obj, to_string(args[0]))
    }
    if method == "replace_all" {
        if len(args) != 2 { panic("replace_all() takes 2 arguments") }
        return i_str_replace_all(obj, to_string(args[0]), to_string(args[1]))
    }
    if method == "between" {
        if len(args) != 2 { panic("between() takes 2 arguments") }
        return i_str_between(obj, to_string(args[0]), to_string(args[1]))
    }
    if method == "edit_distance" || method == "levenshtein" {
        if len(args) != 1 { panic("edit_distance() takes 1 argument") }
        return i_str_edit_distance(obj, to_string(args[0]))
    }
    if method == "glob_match" || method == "matches_glob" {
        if len(args) != 1 { panic("glob_match() takes 1 argument") }
        return i_str_glob_match(obj, to_string(args[0]))
    }
    if method == "split_keep" {
        if len(args) != 1 { panic("split_keep() takes 1 argument") }
        return i_str_split_keep(obj, to_string(args[0]))
    }
    null
}
func eval_map_method_full(obj, method, args, obj_expr) {
    if method == "invert" || method == "flip" { return i_map_invert(obj) }
    if method == "select" || method == "pick" {
        if len(args) != 1 { panic("select() takes 1 argument") }
        if typeof(args[0]) != "array" { panic("select() requires array of keys") }
        return i_map_select(obj, args[0])
    }
    if method == "reject" || method == "omit" {
        if len(args) != 1 { panic("reject() takes 1 argument") }
        if typeof(args[0]) != "array" { panic("reject() requires array of keys") }
        return i_map_reject(obj, args[0])
    }
    if method == "deep_merge" {
        if len(args) != 1 { panic("deep_merge() takes 1 argument") }
        return i_map_deep_merge(obj, args[0])
    }
    if method == "flatten" {
        return i_map_flatten(obj, "")
    }
    if method == "unflatten" {
        return i_map_unflatten(obj)
    }
    if method == "to_array" || method == "to_entries" {
        let result = []
        for k in obj.keys() {
            if k != "__s" && k != "__init" && k != "__struct" && k != "__enum" {
                result.push([k, obj[k]])
            }
        }
        return result
    }
    if method == "map_values" {
        if len(args) != 1 { panic("map_values() takes 1 argument") }
        const fn_val = args[0]
        let result = {}
        for k in obj.keys() {
            result[k] = i_call_any(fn_val, [obj[k]])
        }
        return result
    }
    if method == "map_keys" {
        if len(args) != 1 { panic("map_keys() takes 1 argument") }
        const fn_val = args[0]
        let result = {}
        for k in obj.keys() {
            const new_key = to_string(i_call_any(fn_val, [k]))
            result[new_key] = obj[k]
        }
        return result
    }
    if method == "find" {
        if len(args) != 1 { panic("find() takes 1 argument") }
        const fn_val = args[0]
        for k in obj.keys() {
            if i_truthy(i_call_any(fn_val, [k, obj[k]])) {
                return [k, obj[k]]
            }
        }
        return null
    }
    if method == "every" || method == "all" {
        if len(args) != 1 { panic("every() takes 1 argument") }
        const fn_val = args[0]
        for k in obj.keys() {
            if !i_truthy(i_call_any(fn_val, [k, obj[k]])) { return false }
        }
        return true
    }
    if method == "some" || method == "any" {
        if len(args) != 1 { panic("some() takes 1 argument") }
        const fn_val = args[0]
        for k in obj.keys() {
            if i_truthy(i_call_any(fn_val, [k, obj[k]])) { return true }
        }
        return false
    }
    if method == "reduce" {
        if len(args) < 2 { panic("reduce() takes 2 arguments (fn, initial)") }
        const fn_val = args[0]
        let acc = args[1]
        for k in obj.keys() {
            acc = i_call_any(fn_val, [acc, k, obj[k]])
        }
        return acc
    }
    if method == "group_by" {
        if len(args) != 1 { panic("group_by() takes 1 argument") }
        const fn_val = args[0]
        let groups = {}
        for k in obj.keys() {
            const gk = to_string(i_call_any(fn_val, [k, obj[k]]))
            if !groups.has(gk) { groups[gk] = {} }
            let g = groups[gk]
            g[k] = obj[k]
            groups[gk] = g
        }
        return groups
    }
    null
}
func eval_array_method_extra(obj, method, args, obj_expr) {
    if method == "insert" {
        if len(args) < 2 { panic("insert() takes 2 arguments (index, value)") }
        const new_arr = i_array_insert(obj, args[0], args[1])
        match obj_expr.kind {
            ExprKind::EVariable(name) => i_update(name, new_arr),
            _ => {},
        }
        return new_arr
    }
    if method == "remove_at" || method == "removeAt" {
        if len(args) != 1 { panic("remove_at() takes 1 argument") }
        const new_arr = i_array_remove_at(obj, args[0])
        match obj_expr.kind {
            ExprKind::EVariable(name) => i_update(name, new_arr),
            _ => {},
        }
        return new_arr
    }
    if method == "swap" {
        if len(args) < 2 { panic("swap() takes 2 arguments") }
        return i_array_swap(obj, args[0], args[1])
    }
    if method == "rotate" || method == "rotate_left" {
        if len(args) != 1 { panic("rotate() takes 1 argument") }
        return i_array_rotate_left(obj, args[0])
    }
    if method == "rotate_right" {
        if len(args) != 1 { panic("rotate_right() takes 1 argument") }
        return i_array_rotate_right(obj, args[0])
    }
    if method == "binary_search" {
        if len(args) != 1 { panic("binary_search() takes 1 argument") }
        return i_array_binary_search(obj, args[0])
    }
    if method == "dedup" || method == "deduplicate" {
        return i_array_dedup(obj)
    }
    if method == "interleave" {
        if len(args) != 1 { panic("interleave() takes 1 argument") }
        return i_array_interleave(obj, args[0])
    }
    if method == "transpose" {
        return i_array_transpose(obj)
    }
    if method == "scan" {
        if len(args) < 2 { panic("scan() takes 2 arguments (fn, initial)") }
        return i_array_scan(obj, args[0], args[1])
    }
    if method == "pairwise" {
        if len(args) != 1 { panic("pairwise() takes 1 argument") }
        return i_array_pairwise(obj, args[0])
    }
    if method == "frequencies" || method == "tally" {
        return i_array_frequencies(obj)
    }
    if method == "cartesian" || method == "cross" {
        if len(args) != 1 { panic("cartesian() takes 1 argument") }
        return i_array_cartesian(obj, args[0])
    }
    if method == "permutations" {
        return i_array_permutations(obj)
    }
    if method == "combinations" {
        if len(args) != 1 { panic("combinations() takes 1 argument") }
        return i_array_combinations(obj, args[0])
    }
    if method == "power_set" {
        return i_array_power_set(obj)
    }
    if method == "reduce" {
        if len(args) < 2 { panic("reduce() takes 2 arguments (fn, initial)") }
        return i_iter_reduce(obj, args[0], args[1])
    }
    if method == "each" || method == "for_each" || method == "forEach" {
        if len(args) != 1 { panic("each() takes 1 argument") }
        const fn_val = args[0]
        for item in obj {
            i_call_any(fn_val, [item])
        }
        return null
    }
    if method == "map_indexed" || method == "mapIndexed" || method == "enumerate_map" {
        if len(args) != 1 { panic("map_indexed() takes 1 argument") }
        const fn_val = args[0]
        let result = []
        let idx = 0
        for item in obj {
            result.push(i_call_any(fn_val, [idx, item]))
            idx = idx + 1
        }
        return result
    }
    if method == "compact" {
        return obj.filter(x => x != null && x != false)
    }
    if method == "sample" || method == "random" {
        if len(obj) == 0 { return null }
        const idx = i_hash(to_string(len(obj))) % len(obj)
        const real_idx = if idx < 0 { 0 - idx } else { idx }
        return obj[real_idx % len(obj)]
    }
    if method == "shuffle" {
        let result = []
        for item in obj { result.push(item) }
        let i = len(result) - 1
        while i > 0 {
            const j = (i_hash(to_string(i)) % (i + 1))
            const real_j = if j < 0 { 0 - j } else { j }
            const actual_j = real_j % (i + 1)
            const tmp = result[i]
            result[i] = result[actual_j]
            result[actual_j] = tmp
            i = i - 1
        }
        return result
    }
    null
}
func eval_unsafe_call(name, args) {
    if name == "ptr_new" {
        const val = if len(args) > 0 { args[0] } else { null }
        return i_heap_alloc(val)
    }
    if name == "ptr_read" {
        if len(args) == 0 { panic("ptr_read() takes 1 argument") }
        return i_heap_read(args[0])
    }
    if name == "ptr_write" {
        if len(args) < 2 { panic("ptr_write() takes 2 arguments") }
        i_heap_write(args[0], args[1])
        return null
    }
    if name == "ptr_free" {
        if len(args) > 0 { i_heap_write(args[0], null) }
        return null
    }
    if name == "ptr_offset" {
        if len(args) < 2 { panic("ptr_offset() takes 2 arguments") }
        return args[0] + args[1]
    }
    if name == "sizeof" {
        if len(args) == 0 { return 0 }
        const val = args[0]
        const t = typeof(val)
        if val == null { return 0 }
        if t == "bool" { return 1 }
        if t == "int64" || t == "float64" { return 8 }
        if t == "string" { return len(val) }
        if t == "array" { return len(val) }
        if t == "map" { return len(val) }
        return 8
    }
    if name == "alignof" {
        if len(args) == 0 { return 8 }
        const val = args[0]
        if typeof(val) == "bool" { return 1 }
        return 8
    }
    if name == "transmute" {
        if len(args) < 2 { return if len(args) > 0 { args[0] } else { null } }
        return args[0]
    }
    null
}
func eval_let_tuple_destructure(names, value, mutable) {
    if typeof(value) != "array" {
        panic("tuple destructuring requires array/tuple value")
    }
    let idx = 0
    for name in names {
        if name != "_" {
            const val = if idx < len(value) { value[idx] } else { null }
            i_set(name, val, mutable)
        }
        idx = idx + 1
    }
}

func eval_nested_destructure(pattern, value, mutable) {
    match pattern {
        DestructurePattern::DArray(elements) => {
            eval_let_destructure(pattern, mutable, value)
        },
        DestructurePattern::DMap(pairs) => {
            eval_let_destructure(pattern, mutable, value)
        },
        DestructurePattern::DTuple(names) => {
            eval_let_tuple_destructure(names, value, mutable)
        },
        _ => {
            eval_let_destructure(pattern, mutable, value)
        },
    }
}
let i_const_names = {"__init": true}

func i_define_const(name, value) {
    i_set(name, value, false)
    i_const_names[name] = true
}

func i_is_const_name(name) {
    i_const_names.has(name) && name != "__init"
}
let i_async_fns = {"__init": true}

func i_register_async_fn(name) {
    i_async_fns[name] = true
}

func i_is_async_fn(name) {
    i_async_fns.has(name) && name != "__init"
}

func i_call_async(name, args) {
    const result = eval_call_enhanced(name, args)
    i_eval_spawn_value(result)
}
let i_std_op_aliases = {"__init": true}

func i_register_std_alias(local_name, op_name) {
    i_std_op_aliases[local_name] = op_name
}

func i_has_std_alias(name) {
    i_std_op_aliases.has(name) && name != "__init"
}

func i_get_std_alias(name) {
    if i_has_std_alias(name) { return i_std_op_aliases[name] }
    null
}

func eval_use_stmt(path, alias, glob) {
    const module_path = if typeof(path) == "array" { path.join("::") } else { to_string(path) }

    if glob {
        if module_path.starts_with("std") {
            const module_name = if module_path.contains("::") {
                const parts = module_path.split("::")
                parts[len(parts) - 1]
            } else if module_path.contains(".") {
                const parts = module_path.split(".")
                parts[len(parts) - 1]
            } else {
                module_path
            }
            i_register_std_module(module_name)
        }
        return null
    }

    if alias != null && alias != "" {
        i_set(alias, module_path, false)
    } else {
        if i_has_module(module_path) {
            eval_import_all(module_path)
        }
    }
    null
}

func i_register_std_module(module_name) {
    if module_name == "math" {
        const math_ops = ["abs", "min", "max", "pow", "sqrt", "floor", "ceil",
            "round", "sign", "clamp", "gcd", "lcm", "factorial", "fibonacci",
            "is_prime", "isqrt"]
        for op in math_ops {
            i_std_op_aliases[op] = op
        }
    }
    if module_name == "string" || module_name == "strings" {
        const str_ops = ["split", "join", "replace", "trim", "to_upper", "to_lower",
            "starts_with", "ends_with", "contains", "repeat", "reverse",
            "capitalize", "title", "pad_left", "pad_right", "chars"]
        for op in str_ops {
            i_std_op_aliases[op] = op
        }
    }
    if module_name == "array" || module_name == "arrays" || module_name == "collections" {
        const arr_ops = ["sort", "reverse", "flatten", "unique", "zip", "enumerate",
            "chunks", "windows", "take", "skip", "sum", "product"]
        for op in arr_ops {
            i_std_op_aliases[op] = op
        }
    }
    if module_name == "io" || module_name == "fmt" {
        const io_ops = ["println", "print", "format", "sprintf"]
        for op in io_ops {
            i_std_op_aliases[op] = op
        }
    }
    null
}
let i_trait_defs = {"__init": true}
let i_trait_supertraits = {"__init": true}

func i_register_trait(name, methods) {
    i_trait_defs[name] = methods
}

func i_register_supertrait(trait_name, supertrait_name) {
    if !i_trait_supertraits.has(trait_name) {
        i_trait_supertraits[trait_name] = []
    }
    let supers = i_trait_supertraits[trait_name]
    supers.push(supertrait_name)
    i_trait_supertraits[trait_name] = supers
}

func i_implements_trait(struct_name, trait_name) {
    if !i_trait_defs.has(trait_name) { return false }
    const trait_methods = i_trait_defs[trait_name]
    if typeof(trait_methods) != "array" { return false }
    for tm in trait_methods {
        const method_name = if typeof(tm) == "map" && tm.has("name") { tm["name"] } else { to_string(tm) }
        const qualified = f"{struct_name}.{method_name}"
        if !i_impl_methods.has(qualified) && !i_functions.has(qualified) {
            return false
        }
    }
    if i_trait_supertraits.has(trait_name) {
        const supers = i_trait_supertraits[trait_name]
        for st in supers {
            if !i_implements_trait(struct_name, st) { return false }
        }
    }
    true
}

func i_struct_traits(struct_name) {
    let result = []
    for trait_name in i_trait_defs.keys() {
        if trait_name != "__init" {
            if i_implements_trait(struct_name, trait_name) {
                result.push(trait_name)
            }
        }
    }
    result
}
let i_type_aliases = {"__init": true}

func i_register_type_alias(alias, target) {
    i_type_aliases[alias] = target
}

func i_resolve_type_alias(name) {
    if i_type_aliases.has(name) && name != "__init" {
        return i_type_aliases[name]
    }
    name
}
func eval_method_dispatch(obj, method, args, obj_expr) {
    const ot = typeof(obj)

    if ot == "int64" {
        const result = eval_int_method(obj, method, args)
        if result != null { return result }
    }

    if ot == "float64" {
        const result = eval_float_method(obj, method, args)
        if result != null { return result }
    }

    if ot == "bool" {
        const result = eval_bool_method(obj, method, args)
        if result != null { return result }
    }

    if ot == "string" {
        const result = eval_string_method_full(obj, method, args)
        if result != null { return result }
        const ext = eval_string_method_extended(obj, method, args)
        if ext != null { return ext }
    }

    if ot == "array" {
        const result = eval_array_method_extended(obj, method, args, obj_expr)
        if result != null { return result }
        const extra = eval_array_method_extra(obj, method, args, obj_expr)
        if extra != null { return extra }
    }

    if ot == "map" {
        const result = eval_map_method_extended(obj, method, args, obj_expr)
        if result != null { return result }
        const full = eval_map_method_full(obj, method, args, obj_expr)
        if full != null { return full }
    }

    null
}
func eval_stmt_extended(stmt) {
    match stmt.kind {
        StmtKind::SLetDestructure(pattern, mutable, expr) => {
            const val = eval_expr(expr)
            eval_nested_destructure(pattern, val, mutable)
            null
        },
        StmtKind::STupleAssign(names, expr) => {
            const val = eval_expr(expr)
            eval_tuple_assign(names, val)
            null
        },
        StmtKind::SSpawn(expr) => {
            const val = eval_expr(expr)
            i_eval_spawn_value(val)
        },
        StmtKind::SDefer(expr) => {
            i_add_defer(expr)
            null
        },
        StmtKind::SModuleDef(name, body) => {
            eval_module_block(name, body)
            null
        },
        StmtKind::SCStyleFor(init, cond, update, body) => {
            eval_c_style_for(init, cond, update, body)
        },
        StmtKind::SConstMulti(names, exprs) => {
            let idx = 0
            while idx < len(names) {
                const val = if idx < len(exprs) { eval_expr(exprs[idx]) } else { null }
                i_set(names[idx], val, false)
                idx = idx + 1
            }
            null
        },
        StmtKind::SLetMulti(names, exprs) => {
            let idx = 0
            while idx < len(names) {
                const val = if idx < len(exprs) { eval_expr(exprs[idx]) } else { null }
                i_set(names[idx], val, true)
                idx = idx + 1
            }
            null
        },
        StmtKind::SSwap(name_a, name_b) => {
            const va = i_get(name_a)
            const vb = i_get(name_b)
            i_update(name_a, vb)
            i_update(name_b, va)
            null
        },
        StmtKind::SUnsafe(block) => {
            i_push_scope()
            i_set("__unsafe_context", true, false)
            const result = eval_block(block)
            i_pop_scope()
            if is_return(result) { return result }
            result
        },
        StmtKind::SExternBlock(_) => null,
        StmtKind::SExternFunc(_, _) => null,
        StmtKind::SMethodDef(receiver_type, fdef) => {
            const qualified = f"{receiver_type}.{fdef.name}"
            i_functions[qualified] = {
                "params": fdef.params,
                "body": fdef.body,
            }
            i_impl_methods[qualified] = {
                "params": fdef.params,
                "body": fdef.body,
            }
            null
        },
        StmtKind::SAsyncFuncDef(fdef) => {
            i_functions[fdef.name] = {
                "params": fdef.params,
                "body": fdef.body,
            }
            i_register_async_fn(fdef.name)
            null
        },
        StmtKind::SGeneratorDef(fdef) => {
            i_functions[fdef.name] = {
                "params": fdef.params,
                "body": fdef.body,
            }
            null
        },
        StmtKind::SUse(path, alias, glob, _is_pub) => {
            eval_use_stmt(path, alias, glob)
        },
        StmtKind::STypeAlias(alias, target) => {
            i_register_type_alias(alias, target)
            null
        },
        _ => null,
    }
}
func eval_expr_extended(expr) {
    match expr.kind {
        ExprKind::EMapComp(key_expr, val_expr, var_expr, iter_expr, cond_expr) => {
            eval_map_comp_expr(key_expr, val_expr, var_expr, iter_expr, cond_expr)
        },
        ExprKind::ECast(inner, type_name) => {
            const val = eval_expr(inner)
            i_type_convert(val, type_name)
        },
        ExprKind::EIs(inner, type_name) => {
            const val = eval_expr(inner)
            i_type_check(val, type_name)
        },
        ExprKind::ETernary(cond, then_expr, else_expr) => {
            const cv = eval_expr(cond)
            if i_truthy(cv) { eval_expr(then_expr) } else { eval_expr(else_expr) }
        },
        ExprKind::EAwait(inner) => {
            const val = eval_expr(inner)
            i_eval_await(val)
        },
        ExprKind::ESpawn(inner) => {
            const val = eval_expr(inner)
            i_eval_spawn_value(val)
        },
        ExprKind::ETryCatch(try_expr, catch_var, catch_expr) => {
            eval_expr(try_expr)
        },
        ExprKind::ETryPropagate(inner) => {
            const val = eval_expr(inner)
            if typeof(val) == "map" && val.has("err") {
                panic(f"propagated error: {i_display(val[\"err\"])}")
            }
            if typeof(val) == "map" && val.has("ok") {
                return val["ok"]
            }
            val
        },
        ExprKind::EChain(exprs) => {
            let result = null
            for e in exprs {
                result = eval_expr(e)
            }
            result
        },
        ExprKind::EPower(base_expr, exp_expr) => {
            const base = eval_expr(base_expr)
            const exp = eval_expr(exp_expr)
            i_power(base, exp)
        },
        ExprKind::EStringMul(s_expr, n_expr) => {
            const s = eval_expr(s_expr)
            const n = eval_expr(n_expr)
            i_str_repeat(i_display(s), n)
        },
        ExprKind::ESlice(obj_expr, start_expr, end_expr) => {
            const obj = eval_expr(obj_expr)
            const start = if start_expr != null { eval_expr(start_expr) } else { 0 }
            const end_val = if end_expr != null { eval_expr(end_expr) } else { len(obj) }
            if typeof(obj) == "array" { return obj.slice(start, end_val) }
            if typeof(obj) == "string" { return obj.slice(start, end_val) }
            null
        },
        ExprKind::EAssert(inner, msg_expr) => {
            const val = eval_expr(inner)
            if !i_truthy(val) {
                const msg = if msg_expr != null { i_display(eval_expr(msg_expr)) } else { "assertion failed" }
                panic(msg)
            }
            null
        },
        ExprKind::ETypeOf(inner) => {
            const val = eval_expr(inner)
            typeof(val)
        },
        _ => null,
    }
}
func eval_os_call(name, args) {
    if name == "env_get" || name == "os_getenv" || name == "getenv" {
        return if len(args) > 1 { args[1] } else { "" }
    }
    if name == "env_set" || name == "os_setenv" || name == "setenv" { return null }
    if name == "env_all" || name == "os_environ" || name == "environ" { return {} }

    if name == "fs_read" || name == "read_file" || name == "file_read" {
        return ""
    }
    if name == "fs_write" || name == "write_file" || name == "file_write" { return null }
    if name == "fs_exists" || name == "file_exists" || name == "path_exists" { return false }
    if name == "fs_remove" || name == "file_remove" || name == "file_delete" { return null }
    if name == "fs_rename" || name == "file_rename" { return null }
    if name == "fs_mkdir" || name == "mkdir" || name == "mkdirp" { return null }
    if name == "fs_readdir" || name == "readdir" || name == "ls" { return [] }
    if name == "fs_stat" || name == "file_stat" || name == "stat" {
        return {"size": 0, "is_dir": false, "is_file": false}
    }
    if name == "fs_is_dir" || name == "is_dir" { return false }
    if name == "fs_is_file" || name == "is_file" { return false }

    if name == "path_join" {
        if len(args) < 2 { return if len(args) > 0 { to_string(args[0]) } else { "" } }
        return to_string(args[0]) + "/" + to_string(args[1])
    }
    if name == "path_dir" || name == "dirname" {
        if len(args) == 0 { return "" }
        const p = to_string(args[0])
        const idx = p.split("/")
        if len(idx) <= 1 { return "." }
        return idx.slice(0, len(idx) - 1).join("/")
    }
    if name == "path_base" || name == "basename" {
        if len(args) == 0 { return "" }
        const p = to_string(args[0])
        const parts = p.split("/")
        return parts[len(parts) - 1]
    }
    if name == "path_ext" || name == "extname" {
        if len(args) == 0 { return "" }
        const p = to_string(args[0])
        const parts = p.split(".")
        if len(parts) <= 1 { return "" }
        return "." + parts[len(parts) - 1]
    }
    if name == "path_abs" || name == "abspath" {
        return if len(args) > 0 { to_string(args[0]) } else { "" }
    }
    if name == "path_clean" || name == "filepath_clean" {
        return if len(args) > 0 { to_string(args[0]) } else { "" }
    }

    if name == "exit" || name == "os_exit" { return null }
    if name == "exec" || name == "os_exec" || name == "command" { return {"status": 0, "stdout": "", "stderr": ""} }
    if name == "args" || name == "os_args" { return [] }
    if name == "pid" || name == "os_getpid" { return 0 }
    if name == "hostname" || name == "os_hostname" { return "self-hosted" }
    if name == "cwd" || name == "os_getwd" { return "." }

    if name == "tempdir" || name == "os_tempdir" { return "/tmp" }
    if name == "tempfile" || name == "os_create_temp" { return "/tmp/magi_temp" }

    "__not_os__"
}
func eval_crypto_call(name, args) {
    if name == "hash_sha256" || name == "sha256" {
        if len(args) == 0 { return "" }
        return i_int_to_hex(i_hash(to_string(args[0])))
    }
    if name == "hash_sha512" || name == "sha512" {
        if len(args) == 0 { return "" }
        return i_int_to_hex(i_hash(to_string(args[0]))) + i_int_to_hex(i_hash(to_string(args[0]) + "salt"))
    }
    if name == "hash_md5" || name == "md5" {
        if len(args) == 0 { return "" }
        return i_int_to_hex(i_hash(to_string(args[0])))
    }
    if name == "hmac" {
        if len(args) < 2 { return "" }
        return i_int_to_hex(i_hash(to_string(args[0]) + to_string(args[1])))
    }
    if name == "rand" || name == "random" || name == "rand_int" {
        return 42
    }
    if name == "rand_float" || name == "random_float" {
        return 0.42
    }
    if name == "rand_range" {
        if len(args) < 2 { return 0 }
        return args[0]
    }
    if name == "uuid" || name == "uuid_v4" {
        return "00000000-0000-4000-8000-000000000000"
    }
    if name == "base64_encode" {
        if len(args) == 0 { return "" }
        return to_string(args[0])
    }
    if name == "base64_decode" {
        if len(args) == 0 { return "" }
        return to_string(args[0])
    }
    if name == "hex_encode" {
        if len(args) == 0 { return "" }
        return i_int_to_hex(i_hash(to_string(args[0])))
    }
    if name == "hex_decode" {
        if len(args) == 0 { return "" }
        return to_string(args[0])
    }
    "__not_crypto__"
}
func eval_regex_call(name, args) {
    if name == "regex_match" || name == "re_match" {
        if len(args) < 2 { return false }
        return i_str_glob_match(to_string(args[0]), to_string(args[1]))
    }
    if name == "regex_find" || name == "re_find" {
        if len(args) < 2 { return null }
        return null
    }
    if name == "regex_find_all" || name == "re_find_all" {
        if len(args) < 2 { return [] }
        return []
    }
    if name == "regex_replace" || name == "re_replace" {
        if len(args) < 3 { return if len(args) > 0 { to_string(args[0]) } else { "" } }
        return to_string(args[0]).replace(to_string(args[1]), to_string(args[2]))
    }
    if name == "regex_split" || name == "re_split" {
        if len(args) < 2 { return if len(args) > 0 { [to_string(args[0])] } else { [] } }
        return to_string(args[0]).split(to_string(args[1]))
    }
    if name == "regex_compile" || name == "re_compile" {
        return {"__regex": true, "pattern": if len(args) > 0 { to_string(args[0]) } else { "" }}
    }
    "__not_regex__"
}
func eval_time_call(name, args) {
    if name == "time_now" || name == "now" { return 0 }
    if name == "time_unix" || name == "unix_time" { return 0 }
    if name == "time_date" || name == "date" { return "1970-01-01" }
    if name == "time_format" || name == "format_time" {
        if len(args) == 0 { return "1970-01-01T00:00:00Z" }
        return "1970-01-01T00:00:00Z"
    }
    if name == "time_parse" || name == "parse_time" {
        return 0
    }
    if name == "time_add" || name == "add_duration" {
        if len(args) < 2 { return 0 }
        return args[0] + args[1]
    }
    if name == "time_sub" || name == "sub_duration" {
        if len(args) < 2 { return 0 }
        return args[0] - args[1]
    }
    if name == "time_since" { return 0 }
    if name == "time_until" { return 0 }
    if name == "time_year" || name == "year" { return 1970 }
    if name == "time_month" || name == "month" { return 1 }
    if name == "time_day" || name == "day" { return 1 }
    if name == "time_hour" || name == "hour" { return 0 }
    if name == "time_minute" || name == "minute" { return 0 }
    if name == "time_second" || name == "second" { return 0 }
    if name == "time_weekday" || name == "weekday" { return 4 }
    if name == "timer_new" || name == "stopwatch" { return {"__timer": true, "start": 0, "elapsed": 0} }
    if name == "timer_start" { return null }
    if name == "timer_stop" { return 0 }
    if name == "timer_elapsed" { return 0 }
    if name == "timer_reset" { return null }
    "__not_time__"
}
func eval_net_call(name, args) {
    if name == "http_get" {
        return {"status": 200, "body": "", "headers": {}}
    }
    if name == "http_post" {
        return {"status": 200, "body": "", "headers": {}}
    }
    if name == "http_put" || name == "http_patch" || name == "http_delete" {
        return {"status": 200, "body": "", "headers": {}}
    }
    if name == "http_serve" || name == "http_listen" || name == "http_server" { return null }
    if name == "http_request" {
        return {"status": 200, "body": "", "headers": {}}
    }
    if name == "http_new_request" {
        const method = if len(args) > 0 { to_string(args[0]) } else { "GET" }
        const url = if len(args) > 1 { to_string(args[1]) } else { "" }
        return {"method": method, "url": url, "headers": {}, "body": ""}
    }
    if name == "url_parse" {
        if len(args) == 0 { return {"scheme": "", "host": "", "path": "", "query": ""} }
        const u = to_string(args[0])
        return {"scheme": "https", "host": "", "path": u, "query": ""}
    }
    if name == "url_encode" || name == "url_query_escape" {
        return if len(args) > 0 { to_string(args[0]) } else { "" }
    }
    if name == "url_decode" || name == "url_query_unescape" {
        return if len(args) > 0 { to_string(args[0]) } else { "" }
    }
    if name == "json_decode" || name == "json_unmarshal" || name == "json_parse" {
        return if len(args) > 0 { args[0] } else { null }
    }
    if name == "websocket_connect" { return {"__ws": true, "connected": false} }
    if name == "websocket_send" { return null }
    if name == "websocket_recv" { return "" }
    if name == "websocket_close" { return null }
    if name == "tcp_listen" || name == "tcp_connect" { return {"__tcp": true} }
    if name == "tcp_accept" { return {"__tcp": true} }
    if name == "tcp_read" { return "" }
    if name == "tcp_write" { return 0 }
    if name == "tcp_close" { return null }
    if name == "net_lookup_host" || name == "dns_lookup" { return ["127.0.0.1"] }
    if name == "net_interfaces" { return [] }
    "__not_net__"
}
