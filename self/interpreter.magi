            obj.slice(start, end_val)
        },
        "splice" => {
            const index = op_to_i64(args[0])
            const delete_count = if len(args) > 1 { op_to_i64(args[1]) } else { 0 }
            let new_items = if len(args) > 2 { args.slice(2, len(args)) } else { [] }
            let result = []
            let i = 0
            while i < index && i < len(obj) { result.push(obj[i]); i = i + 1 }
            for item in new_items { result.push(item) }
