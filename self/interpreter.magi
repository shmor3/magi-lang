            let i = 0
            for item in obj { if item == target { result = i }; i = i + 1 }
            result
        },
        "sort" => {
            if len(args) > 0 { i_sort_insertion(obj, args[0]) } else { obj.sort() }
        },
        "sort_by" => { i_stable_sort(obj, args[0]) },
        "reverse" => {
            let result = []
            let i = len(obj) - 1
            while i >= 0 { result.push(obj[i]); i = i - 1 }
            result
        },
        "concat" => obj.concat(args[0]),
        "slice" => {
