            for arg in args {
                const placeholder = "{}"
                const pos = result.index_of(placeholder)
                if pos >= 0 {
                    result = result.substring(0, pos) + i_display(arg) + result.substring(pos + 2, len(result))
                }
                idx = idx + 1
            }
            result
        },
        "template" => {
            let result = obj
            if len(args) > 0 && typeof(args[0]) == "map" {
                const ctx = args[0]
                for k in ctx.keys() {
                    if k == "__s" || k == "__struct" { continue }
                    const placeholder = "${" + k + "}"
                    result = result.replace(placeholder, i_display(ctx[k]))
                }
            }
            result
        },
        "to_int" => to_int(obj),
        "to_float" => to_float(obj),
        "to_bool" => obj == "true",
        "to_string" => obj,
        "char_code" => {
            if len(obj) > 0 { char_code(obj[0]) } else { 0 }
        },
        "char_code_at" => {
            const idx = op_to_i64(args[0])
            if idx >= 0 && idx < len(obj) { char_code(obj[idx]) } else { 0 }
        },
        "capitalize" => {
            if len(obj) == 0 { return "" }
            to_upper(obj[0]) + obj.substring(1, len(obj))
        },
        "title_case" => {
            let result = ""
            let capitalize_next = true
            for c in obj.chars() {
                if c == " " || c == "\t" || c == "-" || c == "_" {
                    result = result + c
                    capitalize_next = true
                } else if capitalize_next {
                    result = result + to_upper(c)
                    capitalize_next = false
                } else {
                    result = result + to_lower(c)
                }
            }
            result
        },
        "camel_case" => {
            let parts = []
            let current = ""
            for c in obj.chars() {
                if c == " " || c == "_" || c == "-" {
                    if len(current) > 0 { parts.push(current) }
                    current = ""
                } else {
                    current = current + c
                }
            }
            if len(current) > 0 { parts.push(current) }
            if len(parts) == 0 { return "" }
            let result = to_lower(parts[0])
            let i = 1
            while i < len(parts) {
                const p = parts[i]
                if len(p) > 0 {
                    result = result + to_upper(p[0]) + to_lower(p.substring(1, len(p)))
                }
                i = i + 1
            }
            result
        },
        "snake_case" => {
            let result = ""
            let prev_lower = false
            for c in obj.chars() {
                if c == " " || c == "-" {
                    result = result + "_"
                    prev_lower = false
                } else if c >= "A" && c <= "Z" {
                    if prev_lower { result = result + "_" }
                    result = result + to_lower(c)
                    prev_lower = false
                } else {
                    result = result + c
                    prev_lower = (c >= "a" && c <= "z")
                }
            }
            result
        },
        "kebab_case" => {
            let result = ""
            let prev_lower = false
            for c in obj.chars() {
                if c == " " || c == "_" {
                    result = result + "-"
                    prev_lower = false
                } else if c >= "A" && c <= "Z" {
                    if prev_lower { result = result + "-" }
                    result = result + to_lower(c)
                    prev_lower = false
                } else {
                    result = result + c
                    prev_lower = (c >= "a" && c <= "z")
                }
            }
            result
        },
        "match" => {
            if len(args) > 0 {
                regex_match(args[0], obj)
            } else {
                null
            }
        },
        "match_all" => {
            if len(args) > 0 {
                regex_match_all(args[0], obj)
            } else {
                []
            }
        },
        "encode_uri" => encode_uri(obj),
        "decode_uri" => decode_uri(obj),
        "encode_base64" => base64_encode(obj),
        "decode_base64" => base64_decode(obj),
        "md5" => md5(obj),
        "sha256" => sha256(obj),
        "slice" => {
            const start = op_to_i64(args[0])
            const end_val = if len(args) > 1 { op_to_i64(args[1]) } else { len(obj) }
            obj.substring(start, end_val)
        },
        "to_array" => obj.chars(),
        "is_ascii" => {
            let result = true
            for c in obj.chars() {
                if char_code(c) > 127 { result = false; break }
            }
            result
        },
        "is_numeric" => {
            if len(obj) == 0 { return false }
            let result = true
            let has_dot = false
            let i = 0
            if obj[0] == "-" { i = 1 }
            while i < len(obj) {
                const c = obj[i]
                if c == "." {
                    if has_dot { result = false; break }
                    has_dot = true
                } else if c < "0" || c > "9" {
                    result = false
                    break
                }
                i = i + 1
            }
            result
        },
        "is_alpha" => {
            if len(obj) == 0 { return false }
            let result = true
            for c in obj.chars() {
                if !((c >= "a" && c <= "z") || (c >= "A" && c <= "Z")) {
                    result = false; break
                }
            }
            result
        },
        "is_alphanumeric" => {
            if len(obj) == 0 { return false }
            let result = true
            for c in obj.chars() {
                if !((c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9")) {
                    result = false; break
                }
            }
            result
        },
        "is_whitespace" => {
            if len(obj) == 0 { return true }
            let result = true
            for c in obj.chars() {
                if c != " " && c != "\t" && c != "\n" && c != "\r" {
                    result = false; break
                }
            }
            result
        },
        "center" => {
            const width = op_to_i64(args[0])
            const fill = if len(args) > 1 { args[1] } else { " " }
            if len(obj) >= width { return obj }
            const padding = width - len(obj)
            const left_pad = padding / 2
            const right_pad = padding - left_pad
            let result = ""
            let i = 0
            while i < left_pad { result = result + fill; i = i + 1 }
            result = result + obj
            i = 0
            while i < right_pad { result = result + fill; i = i + 1 }
            result
        },
        "truncate" => {
            const max_len = op_to_i64(args[0])
            const suffix = if len(args) > 1 { args[1] } else { "..." }
            if len(obj) <= max_len { return obj }
            obj.substring(0, max_len - len(suffix)) + suffix
        },
        "remove_prefix" => {
            const prefix = args[0]
            if starts_with(obj, prefix) {
                obj.substring(len(prefix), len(obj))
            } else {
                obj
            }
        },
        "remove_suffix" => {
            const suffix = args[0]
            if ends_with(obj, suffix) {
                obj.substring(0, len(obj) - len(suffix))
            } else {
                obj
            }
        },
        _ => panic(f"string has no method '{method}'")
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 51: Complete Array Method Dispatch
