    const hex_chars = "0123456789abcdef"
    let result = ""
    for byte in b["__data"] { result = result + hex_chars[byte / 16] + hex_chars[byte % 16] }
    result
}

func i_bytes_equals(a, b) {
    const ad = a["__data"]
    const bd = b["__data"]
    if len(ad) != len(bd) { return false }
    let i = 0
    while i < len(ad) { if ad[i] != bd[i] { return false }
            i = i + 1 }
    true
}
func i_set_new() { {"__set": true, "__elements": {"__init": true}} }

func i_set_from(arr) {
    let elements = {"__init": true}
    for item in arr { elements[i_display(item)] = item }
    {"__set": true, "__elements": elements}
}

func i_set_add(s, val) {
    let elements = s["__elements"]
    elements[i_display(val)] = val
    s["__elements"] = elements
    s
}

func i_set_remove(s, val) {
    let elements = s["__elements"]
    const key = i_display(val)
    if elements.has(key) { elements = elements.delete(key); s["__elements"] = elements }
    s
}

func i_set_contains(s, val) { s["__elements"].has(i_display(val)) }

func i_set_size(s) {
    let count = 0
    for k in s["__elements"].keys() { if k != "__init" { count = count + 1 } }
    count
}

func i_set_to_array(s) {
    let result = []
    for k in s["__elements"].keys() {
        if k != "__init" { result.push(s["__elements"][k]) }
    }
    result
}

func i_set_union_set(a, b) {
    let result = i_set_new()
    for k in a["__elements"].keys() { if k != "__init" { i_set_add(result, a["__elements"][k]) } }
    for k in b["__elements"].keys() { if k != "__init" { i_set_add(result, b["__elements"][k]) } }
    result
}

func i_set_intersection_set(a, b) {
    let result = i_set_new()
    for k in a["__elements"].keys() {
        if k != "__init" && b["__elements"].has(k) { i_set_add(result, a["__elements"][k]) }
    }
    result
}

func i_set_difference_set(a, b) {
    let result = i_set_new()
    for k in a["__elements"].keys() {
        if k != "__init" && !b["__elements"].has(k) { i_set_add(result, a["__elements"][k]) }
    }
    result
}
func i_tuple_new(elements) { {"__tuple": true, "__elements": elements} }
func i_is_tuple(val) { typeof(val) == "map" && val.has("__tuple") }
func i_tuple_get(tup, idx) {
    const elements = tup["__elements"]
    if idx < 0 || idx >= len(elements) { panic("tuple index out of bounds") }
    elements[idx]
}
func i_tuple_len(tup) { len(tup["__elements"]) }
func i_tuple_to_array(tup) { let r = []; for item in tup["__elements"] { r.push(item) }
            r }
func i_future_new() {
    {"__future": true, "__state": "pending", "__value": null, "__error": null, "__callbacks": []}
}

func i_future_resolve(future, value) {
    if future["__state"] != "pending" { panic("cannot resolve a non-pending future") }
    future["__state"] = "resolved"
    future["__value"] = value
    for cb in future["__callbacks"] { i_call_any(cb, [value]) }
    future["__callbacks"] = []
    future
}

func i_future_reject(future, error) {
    if future["__state"] != "pending" { panic("cannot reject a non-pending future") }
    future["__state"] = "rejected"
    future["__error"] = error
    future
}

func i_future_is_pending(f) { f["__state"] == "pending" }
func i_future_is_resolved(f) { f["__state"] == "resolved" }
func i_future_is_rejected(f) { f["__state"] == "rejected" }
func i_future_value(f) { if f["__state"] != "resolved" { panic("not resolved") }
    f["__value"] }
func i_future_error(f) { if f["__state"] != "rejected" { panic("not rejected") }; f["__error"] }

func i_future_then(future, callback) {
    if future["__state"] == "resolved" {
        const result = i_call_any(callback, [future["__value"]])
        let nf = i_future_new()
        i_future_resolve(nf, result)
        return nf
    }
    let callbacks = future["__callbacks"]
    let nf = i_future_new()
    callbacks.push(val => {
        const result = i_call_any(callback, [val])
        i_future_resolve(nf, result)
    })
    future["__callbacks"] = callbacks
    nf
}

func i_future_all(futures) {
    let results = []
    for f in futures {
        if f["__state"] == "resolved" { results.push(f["__value"]) }
        else if f["__state"] == "rejected" {
            let r = i_future_new(); i_future_reject(r, f["__error"]); return r
        }
        else { results.push(null) }
    }
    let r = i_future_new()
    i_future_resolve(r, results)
    r
}
func i_make_error(message) { {"__error": true, "__message": message} }
func i_is_error_value(val) { typeof(val) == "map" && val.has("__error") }
func i_error_message(err) { if i_is_error_value(err) { err["__message"] } else { to_string(err) } }
func i_result_ok(value) { {"__result": true, "__ok": true, "__value": value} }
func i_result_err(error) { {"__result": true, "__ok": false, "__error": error} }
func i_result_is_ok(r) { typeof(r) == "map" && r.has("__result") && r["__ok"] }
func i_result_is_err(r) { typeof(r) == "map" && r.has("__result") && !r["__ok"] }
func i_result_unwrap(r) {
    if i_result_is_ok(r) { return r["__value"] }
    if i_result_is_err(r) { panic(f"unwrap on Err: {i_error_message(r['__error'])}") }
    r
}
func i_result_unwrap_or(r, default_val) { if i_result_is_ok(r) { r["__value"] } else { default_val } }
let i_module_cache = {"__init": true}

func i_resolve_module_path(module_path) {
    const parts = module_path.split(".")
    if len(parts) >= 2 && parts[0] == "std" {
        return {"kind": "stdlib", "name": parts[1]}
    }
    {"kind": "file", "path": parts.join("/") + ".magi"}
}

func i_load_module(module_path) {
    if i_module_cache.has(module_path) { return i_module_cache[module_path] }
    const resolved = i_resolve_module_path(module_path)
    const mod_result = {"__module": true, "__name": module_path, "__exports": {"__init": true}}
    i_module_cache[module_path] = mod_result
    mod_result
}
let i_repl_active = false

func i_repl_init() {
    i_repl_active = true
    i_scopes = [i_new_scope()]
    i_functions = {"__init": true}
    i_structs = {"__init": true}
    i_enums = {"__init": true}
}

func i_repl_evaluate(input_text) {
    if !i_repl_active { i_repl_init() }
    const save_tokens = p_tokens
    const save_pos = p_pos
    p_tokens = tokenize(input_text)
    p_pos = 0
    let result = null
    if len(p_tokens) > 0 {
        const program = parse_program()
        result = eval_program(program)
    }
    p_tokens = save_tokens
    p_pos = save_pos
    result
}

func i_repl_reset() {
    i_repl_active = false
    i_scopes = [i_new_scope()]
}

func i_repl_bindings() {
    let names = []
    for scope in i_scopes {
        for k in scope.keys() { if k != "__s" { names.push(k) } }
    }
    for k in i_functions.keys() {
        if k != "__init" { names.push(k) }
    }
    names
}
func i_stats_mean(arr) {
    if len(arr) == 0 { return 0.0 }
    let sum = 0.0
    for item in arr { sum = sum + to_float(item) }
    sum / to_float(len(arr))
}

func i_stats_median(arr) {
    if len(arr) == 0 { return 0.0 }
    let sorted = arr.sort()
    const n = len(sorted)
    if n % 2 == 1 { to_float(sorted[n / 2]) }
    else { (to_float(sorted[n / 2 - 1]) + to_float(sorted[n / 2])) / 2.0 }
}

func i_stats_variance(arr) {
    if len(arr) <= 1 { return 0.0 }
    const mean = i_stats_mean(arr)
    let sum_sq = 0.0
    for item in arr {
        const diff = to_float(item) - mean
        sum_sq = sum_sq + diff * diff
    }
    sum_sq / to_float(len(arr) - 1)
}

func i_stats_stddev(arr) { sqrt(i_stats_variance(arr)) }

func i_stats_covariance(xs, ys) {
    if len(xs) != len(ys) || len(xs) <= 1 { return 0.0 }
    const mx = i_stats_mean(xs)
    const my = i_stats_mean(ys)
    let sum = 0.0
    let i = 0
    while i < len(xs) {
        sum = sum + (to_float(xs[i]) - mx) * (to_float(ys[i]) - my)
        i = i + 1
    }
    sum / to_float(len(xs) - 1)
}

func i_stats_correlation(xs, ys) {
    const cov = i_stats_covariance(xs, ys)
    const sx = i_stats_stddev(xs)
    const sy = i_stats_stddev(ys)
    if sx == 0.0 || sy == 0.0 { return 0.0 }
    cov / (sx * sy)
}

func i_stats_percentile(arr, p) {
    if len(arr) == 0 { return 0.0 }
    let sorted = arr.sort()
    const idx = to_float(p) / 100.0 * to_float(len(sorted) - 1)
    const lower = floor(idx)
    const upper = ceil(idx)
    if lower == upper { return to_float(sorted[lower]) }
    const frac = idx - to_float(lower)
    to_float(sorted[lower]) * (1.0 - frac) + to_float(sorted[upper]) * frac
}

func i_stats_z_score(arr, value) {
    const mean = i_stats_mean(arr)
    const sd = i_stats_stddev(arr)
    if sd == 0.0 { return 0.0 }
    (to_float(value) - mean) / sd
}

func i_stats_mode(arr) {
    if len(arr) == 0 { return null }
    let counts = {"__init": true}
    for item in arr {
        const key = i_display(item)
        if counts.has(key) { counts[key] = counts[key] + 1 } else { counts[key] = 1 }
    }
    let best_count = 0
    let best_val = null
    for item in arr {
        if counts[i_display(item)] > best_count {
            best_count = counts[i_display(item)]
            best_val = item
        }
    }
    best_val
}

func i_stats_quartiles(arr) {
    [i_stats_percentile(arr, 25.0), i_stats_percentile(arr, 50.0), i_stats_percentile(arr, 75.0)]
}
func i_fmt_number(n, decimals) {
    const factor = power(10.0, to_float(decimals))
    to_string(round(to_float(n) * factor) / factor)
}

func i_fmt_bytes_size(n) {
    const units = ["B", "KB", "MB", "GB", "TB", "PB"]
    let val = to_float(n)
    let ui = 0
    while val >= 1024.0 && ui < len(units) - 1 { val = val / 1024.0; ui = ui + 1 }
    if ui == 0 { f"{to_int(val)} {units[ui]}" }
    else { f"{round(val * 100.0) / 100.0} {units[ui]}" }
}

func i_fmt_duration(ms) {
    const total = to_int(ms)
    if total < 1000 { return f"{total}ms" }
    const s = total / 1000
    if s < 60 { return f"{s}.{(total % 1000) / 100}s" }
    const m = s / 60
    if m < 60 { return f"{m}m {s % 60}s" }
    const h = m / 60
    if h < 24 { return f"{h}h {m % 60}m" }
    f"{h / 24}d {h % 24}h"
}

func i_fmt_hex(n) {
    const hex_chars = "0123456789abcdef"
    let val = to_int(n)
    if val == 0 { return "0x0" }
    let neg = val < 0
    if neg { val = 0 - val }
    let result = ""
    while val > 0 { result = hex_chars[val % 16] + result; val = val / 16 }
    if neg { "0x-" + result } else { "0x" + result }
}

func i_fmt_binary(n) {
    let val = to_int(n)
    if val == 0 { return "0b0" }
    let neg = val < 0
    if neg { val = 0 - val }
    let result = ""
    while val > 0 { result = to_string(val % 2) + result; val = val / 2 }
    if neg { "0b-" + result } else { "0b" + result }
}

func i_fmt_percent(n, decimals) { i_fmt_number(to_float(n) * 100.0, decimals) + "%" }

func i_fmt_with_commas(n) {
    const s = to_string(to_int(n))
    let result = ""
    let count = 0
    let i = len(s) - 1
    while i >= 0 {
        if count > 0 && count % 3 == 0 { result = "," + result }
        result = s[i] + result
        count = count + 1
        i = i - 1
    }
    result
}
func i_to_json(val) {
    if val == null { return "null" }
    const t = typeof(val)
    if t == "string" { return i_json_escape_string(val) }
    if t == "int64" || t == "int" { return to_string(val) }
    if t == "float64" || t == "float" { return to_string(val) }
    if t == "bool" { return if val { "true" } else { "false" } }
    if t == "array" {
        let parts = []
        for item in val { parts.push(i_to_json(item)) }
        return "[" + parts.join(",") + "]"
    }
    if t == "map" {
        let parts = []
        for k in val.keys() {
            if k == "__s" || k == "__init" || k == "__struct" || k == "__enum" { continue }
            parts.push(i_json_escape_string(k) + ":" + i_to_json(val[k]))
        }
        return "{" + parts.join(",") + "}"
    }
    to_string(val)
}

func i_json_escape_string(s) {
    let result = "\""
    for c in to_string(s).chars() {
        if c == "\"" { result = result + "\\\"" }
        else if c == "\\" { result = result + "\\\\" }
        else if c == "\n" { result = result + "\\n" }
        else if c == "\r" { result = result + "\\r" }
        else if c == "\t" { result = result + "\\t" }
        else { result = result + c }
    }
    result + "\""
}
func eval_call_stdlib(name, args) {
    if name == "assert_eq" {
        if len(args) < 2 { panic("assert_eq() takes at least 2 arguments") }
        if args[0] == args[1] { return null }
        const msg = if len(args) > 2 { i_display(args[2]) }
            else { f"assertion failed: expected values to be equal\n  left:  {i_display(args[0])}\n  right: {i_display(args[1])}" }
        panic(msg)
    }
    if name == "assert_ne" {
        if len(args) < 2 { panic("assert_ne() takes at least 2 arguments") }
        if args[0] != args[1] { return null }
        const msg = if len(args) > 2 { i_display(args[2]) }
            else { f"assertion failed: expected values to differ, both are: {i_display(args[0])}" }
        panic(msg)
    }
    if name == "assert_throws" {
        if len(args) < 1 { panic("assert_throws() takes at least 1 argument") }
        return null
    }

    if name == "Some" {
        return if len(args) > 0 { args[0] } else { null }
    }
    if name == "None" { return null }
    if name == "Ok" {
        const val = if len(args) > 0 { args[0] } else { null }
        return {"ok": val}
    }
    if name == "Err" {
        const val = if len(args) > 0 { args[0] } else { "error" }
        return {"err": val}
    }
    if name == "is_some" {
        return if len(args) > 0 { args[0] != null } else { false }
    }
    if name == "is_none" {
        return if len(args) > 0 { args[0] == null } else { true }
    }
    if name == "is_ok" {
        if len(args) == 0 { return false }
        if typeof(args[0]) == "map" && args[0].has("ok") { return true }
        return false
    }
    if name == "is_err" {
        if len(args) == 0 { return false }
        if typeof(args[0]) == "map" && args[0].has("err") { return true }
        return false
    }
    if name == "unwrap" {
        if len(args) == 0 { panic("unwrap() takes 1 argument") }
        const val = args[0]
        if val == null { panic("called unwrap on None value") }
        if typeof(val) == "map" {
            if val.has("ok") { return val["ok"] }
            if val.has("err") { panic(f"called unwrap on Err: {i_display(val[\"err\"])}") }
        }
        return val
    }
    if name == "unwrap_or" {
        if len(args) < 2 { panic("unwrap_or() takes 2 arguments") }
        const val = args[0]
        const default = args[1]
        if val == null { return default }
        if typeof(val) == "map" {
            if val.has("ok") { return val["ok"] }
            if val.has("err") { return default }
        }
        return val
    }

    if name == "Set" {
        if len(args) == 1 && typeof(args[0]) == "array" {
            return i_iter_unique(args[0])
        }
        return i_iter_unique(args)
    }
    if name == "Tuple" || name == "tuple" {
        if len(args) == 1 && typeof(args[0]) == "array" {
            return args[0]
        }
        return args
    }

    if name == "typeof" { return if len(args) > 0 { typeof(args[0]) } else { "null" } }
    if name == "implements" { return false }

    if name == "factorial" {
        if len(args) == 0 { panic("factorial() takes 1 argument") }
        return i_math_factorial(args[0])
    }
    if name == "fibonacci" {
        if len(args) == 0 { panic("fibonacci() takes 1 argument") }
        return i_math_fib(args[0])
    }
    if name == "is_prime" {
        if len(args) == 0 { panic("is_prime() takes 1 argument") }
        return i_math_is_prime(args[0])
    }
    if name == "gcd" {
        if len(args) < 2 { panic("gcd() takes 2 arguments") }
        return i_math_gcd(args[0], args[1])
    }
    if name == "lcm" {
        if len(args) < 2 { panic("lcm() takes 2 arguments") }
        return i_math_lcm(args[0], args[1])
    }
    if name == "sign" {
        if len(args) == 0 { panic("sign() takes 1 argument") }
        return i_math_sign(args[0])
    }
    if name == "isqrt" || name == "sqrt_int" {
        if len(args) == 0 { panic("isqrt() takes 1 argument") }
        return i_math_isqrt(args[0])
    }
    if name == "divmod" {
        if len(args) < 2 { panic("divmod() takes 2 arguments") }
        return i_math_divmod(args[0], args[1])
    }
    if name == "ncr" || name == "combinations" {
        if len(args) < 2 { panic("ncr() takes 2 arguments") }
        const n = args[0]
        const r = args[1]
        if n < 0 || r < 0 || r > n { return 0 }
        let result = 1
        let i = 0
        const r2 = if r < n - r { r } else { n - r }
        while i < r2 {
            result = result * (n - i) / (i + 1)
            i = i + 1
        }
        return result
    }
    if name == "npr" || name == "permutations" {
        if len(args) < 2 { panic("npr() takes 2 arguments") }
        const n = args[0]
        const r = args[1]
        if n < 0 || r < 0 || r > n { return 0 }
        let result = 1
        let i = 0
        while i < r {
            result = result * (n - i)
            i = i + 1
        }
        return result
    }

    if name == "math_pi" { return 3.141592653589793 }
    if name == "math_e" { return 2.718281828459045 }
    if name == "math_tau" { return 6.283185307179586 }
    if name == "math_ln2" { return 0.6931471805599453 }
    if name == "math_ln10" { return 2.302585092994046 }
    if name == "math_sqrt2" { return 1.4142135623730951 }
    if name == "math_inf" { return 1.0 / 0.0 }
    if name == "math_neg_inf" { return 0.0 - (1.0 / 0.0) }

    if name == "append" {
        if len(args) < 2 { panic("append() takes at least 2 arguments") }
        if typeof(args[0]) != "array" { panic("append() requires array as first argument") }
        let result = args[0]
        let i = 1
        while i < len(args) {
            result = result.append(args[i])
            i = i + 1
        }
        return result
    }
    if name == "copy" {
        if len(args) < 2 { panic("copy() takes 2 arguments") }
        if typeof(args[0]) != "array" || typeof(args[1]) != "array" { panic("copy() requires two arrays") }
        let result = args[0]
        const src = args[1]
        const count = if len(result) < len(src) { len(result) } else { len(src) }
        let i = 0
        while i < count {
            result[i] = src[i]
            i = i + 1
        }
        return result
    }
    if name == "delete" {
        if len(args) < 2 { panic("delete() takes 2 arguments") }
        if typeof(args[0]) != "map" { panic("delete() requires map") }
        return args[0].delete(to_string(args[1]))
    }
    if name == "clear" {
        if len(args) == 0 { panic("clear() takes 1 argument") }
        const t = typeof(args[0])
        if t == "array" { return [] }
        if t == "map" { return {} }
        if t == "string" { return "" }
        panic(f"clear() not supported for {t}")
    }
    if name == "cap" {
        if len(args) == 0 { panic("cap() takes 1 argument") }
        return len(args[0])
    }
    if name == "make" {
        if len(args) == 0 { panic("make() takes 1-2 arguments") }
        const type_name = to_string(args[0])
        const size = if len(args) > 1 { args[1] } else { 0 }
        if type_name == "array" || type_name == "Array" {
            let result = []
            let i = 0
            while i < size { result.push(null); i = i + 1 }
            return result
        }
        if type_name == "map" || type_name == "Map" { return {} }
        if type_name == "string" || type_name == "String" { return "" }
        panic(f"make: unknown type '{type_name}'")
    }

    if name == "split" {
        if len(args) < 2 { panic("split() takes 2 arguments") }
        return to_string(args[0]).split(to_string(args[1]))
    }
    if name == "join" {
        if len(args) < 2 { panic("join() takes 2 arguments") }
        if typeof(args[0]) != "array" { panic("join() requires array") }
        return args[0].map(x => i_display(x)).join(to_string(args[1]))
    }
    if name == "replace" {
        if len(args) < 3 { panic("replace() takes 3 arguments") }
        return to_string(args[0]).replace(to_string(args[1]), to_string(args[2]))
    }
    if name == "trim" {
        if len(args) == 0 { panic("trim() takes 1 argument") }
        return to_string(args[0]).trim()
    }
    if name == "trim_prefix" || name == "strip_prefix" {
        if len(args) < 2 { panic("trim_prefix() takes 2 arguments") }
        return i_str_strip_prefix(to_string(args[0]), to_string(args[1]))
    }
    if name == "trim_suffix" || name == "strip_suffix" {
        if len(args) < 2 { panic("trim_suffix() takes 2 arguments") }
        return i_str_strip_suffix(to_string(args[0]), to_string(args[1]))
    }
    if name == "to_upper" || name == "to_uppercase" {
        if len(args) == 0 { panic("to_upper() takes 1 argument") }
        return to_string(args[0]).to_upper()
    }
    if name == "to_lower" || name == "to_lowercase" {
