            for item in obj {
                if i_truthy(i_call_any(fn_val, [item])) { yes_list.push(item) }
                else { no_list.push(item) }
            }
            [yes_list, no_list]
        },
        "group_by" => {
            const key_fn = args[0]
            let groups = {"__init": true}
            for item in obj {
                const key = i_display(i_call_any(key_fn, [item]))
                if !groups.has(key) { groups[key] = [] }
                let g = groups[key]
                g.push(item)
                groups[key] = g
            }
            groups
        },
        "binary_search" => {
            const target = args[0]
            let lo = 0
            let hi = len(obj) - 1
            while lo <= hi {
                const mid = (lo + hi) / 2
                if obj[mid] == target { return mid }
                if obj[mid] < target { lo = mid + 1 } else { hi = mid - 1 }
            }
            -1
        },
        "min" => {
            if len(obj) == 0 { return null }
            let m = obj[0]
            for item in obj { if item < m { m = item } }
            m
        },
        "max" => {
            if len(obj) == 0 { return null }
            let m = obj[0]
            for item in obj { if item > m { m = item } }
            m
        },
        "min_by" => {
            if len(obj) == 0 { return null }
            const fn_val = args[0]
            let best = obj[0]
            let best_key = i_call_any(fn_val, [obj[0]])
            let i = 1
            while i < len(obj) {
                const key = i_call_any(fn_val, [obj[i]])
                if key < best_key { best = obj[i]; best_key = key }
                i = i + 1
            }
            best
        },
        "max_by" => {
            if len(obj) == 0 { return null }
            const fn_val = args[0]
            let best = obj[0]
            let best_key = i_call_any(fn_val, [obj[0]])
            let i = 1
            while i < len(obj) {
                const key = i_call_any(fn_val, [obj[i]])
                if key > best_key { best = obj[i]; best_key = key }
                i = i + 1
            }
            best
        },
        "sum" => { let t = 0; for item in obj { t = t + item }; t },
        "product" => { let t = 1; for item in obj { t = t * item }; t },
        "average" => {
            if len(obj) == 0 { return 0.0 }
            let t = 0.0
            for item in obj { t = t + to_float(item) }
            t / to_float(len(obj))
        },
        "take" => { const n = op_to_i64(args[0]); obj.slice(0, min(n, len(obj))) },
        "skip" => { const n = op_to_i64(args[0]); obj.slice(min(n, len(obj)), len(obj)) },
        "take_while" => {
