// ═══════════════════════════════════════════════════════════════════
// SECTION 52: Complete Map Method Dispatch
// ═══════════════════════════════════════════════════════════════════

func i_map_method(obj, method, args) {
    match method {
        "len" => {
            let count = 0
            for k in obj.keys() {
                if k != "__s" && k != "__init" && k != "__struct" && k != "__enum" { count = count + 1 }
            }
            count
        },
        "is_empty" => {
            let count = 0
            for k in obj.keys() {
                if k != "__s" && k != "__init" && k != "__struct" && k != "__enum" { count = count + 1 }
            }
            count == 0
        },
        "keys" => obj.keys(),
        "values" => obj.values(),
        "has" => obj.has(args[0]),
        "contains_key" => obj.has(args[0]),
