        },
        "rotate_left" => {
            const n = op_to_i64(args[0]) % len(obj)
            if n == 0 || len(obj) == 0 { return obj }
            obj.slice(n, len(obj)).concat(obj.slice(0, n))
        },
        "rotate_right" => {
            const n = op_to_i64(args[0]) % len(obj)
            if n == 0 || len(obj) == 0 { return obj }
            obj.slice(len(obj) - n, len(obj)).concat(obj.slice(0, len(obj) - n))
        },
        "interleave" => {
            const other = args[0]
            let result = []
            let i = 0
            while i < len(obj) || i < len(other) {
                if i < len(obj) { result.push(obj[i]) }
                if i < len(other) { result.push(other[i]) }
                i = i + 1
            }
