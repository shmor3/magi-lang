    }
    if name == "logger_new" || name == "new_logger" {
        return {"__logger": true, "level": "info", "fields": {}}
    }
    if name == "logger_with" {
        if len(args) < 2 { return if len(args) > 0 { args[0] } else { {"__logger": true} } }
        return args[0]
    }
    if name == "slog_new" || name == "slog_default" || name == "slog_text_handler" || name == "slog_json_handler" {
