}
func eval_test_call(name, args) {
    if name == "assert_contains" {
        if len(args) < 2 { panic("assert_contains() takes 2 arguments") }
        const haystack = args[0]
        const needle = args[1]
        const ht = typeof(haystack)
        let found = false
        if ht == "string" { found = haystack.contains(to_string(needle)) }
        else if ht == "array" { found = haystack.contains(needle) }
        else if ht == "map" { found = haystack.has(to_string(needle)) }
        if !found {
            const msg = if len(args) > 2 { i_display(args[2]) }
                else { f"assert_contains failed: {i_display(needle)} not in {i_display(haystack)}" }
            panic(msg)
        }
        return null
    }
    if name == "assert_not_contains" {
        if len(args) < 2 { panic("assert_not_contains() takes 2 arguments") }
        const haystack = args[0]
        const needle = args[1]
        const ht = typeof(haystack)
        let found = false
        if ht == "string" { found = haystack.contains(to_string(needle)) }
        else if ht == "array" { found = haystack.contains(needle) }
        else if ht == "map" { found = haystack.has(to_string(needle)) }
        if found {
            const msg = if len(args) > 2 { i_display(args[2]) }
                else { f"assert_not_contains failed: {i_display(needle)} found in {i_display(haystack)}" }
            panic(msg)
        }
        return null
    }
    if name == "assert_gt" || name == "assert_greater" {
        if len(args) < 2 { panic("assert_gt() takes 2 arguments") }
        if !(i_compare(args[0], args[1]) > 0) {
            panic(f"assert_gt failed: {i_display(args[0])} is not > {i_display(args[1])}")
        }
        return null
    }
    if name == "assert_lt" || name == "assert_less" {
        if len(args) < 2 { panic("assert_lt() takes 2 arguments") }
        if !(i_compare(args[0], args[1]) < 0) {
            panic(f"assert_lt failed: {i_display(args[0])} is not < {i_display(args[1])}")
        }
        return null
    }
    if name == "assert_gte" || name == "assert_ge" {
        if len(args) < 2 { panic("assert_gte() takes 2 arguments") }
        if !(i_compare(args[0], args[1]) >= 0) {
            panic(f"assert_gte failed: {i_display(args[0])} is not >= {i_display(args[1])}")
        }
        return null
    }
    if name == "assert_lte" || name == "assert_le" {
        if len(args) < 2 { panic("assert_lte() takes 2 arguments") }
        if !(i_compare(args[0], args[1]) <= 0) {
            panic(f"assert_lte failed: {i_display(args[0])} is not <= {i_display(args[1])}")
        }
        return null
    }
    if name == "assert_null" || name == "assert_none" {
        if len(args) == 0 { panic("assert_null() takes 1 argument") }
        if args[0] != null {
            panic(f"assert_null failed: got {i_display(args[0])}")
        }
        return null
    }
    if name == "assert_not_null" || name == "assert_some" {
        if len(args) == 0 { panic("assert_not_null() takes 1 argument") }
        if args[0] == null {
            panic("assert_not_null failed: got null")
        }
        return null
    }
    if name == "assert_type" {
        if len(args) < 2 { panic("assert_type() takes 2 arguments") }
        const actual = typeof(args[0])
        const expected = to_string(args[1])
        if actual != expected && !(expected == "int" && actual == "int64") && !(expected == "float" && actual == "float64") {
            panic(f"assert_type failed: expected {expected}, got {actual}")
        }
        return null
    }
    if name == "assert_deep_eq" {
        if len(args) < 2 { panic("assert_deep_eq() takes 2 arguments") }
        if !i_deep_eq(args[0], args[1]) {
            panic(f"assert_deep_eq failed:\n  left:  {i_display(args[0])}\n  right: {i_display(args[1])}")
        }
        return null
    }
    if name == "assert_approx" || name == "assert_close" {
        if len(args) < 2 { panic("assert_approx() takes 2-3 arguments") }
        const epsilon = if len(args) > 2 { to_float64(args[2]) } else { 0.0001 }
        const diff = to_float64(args[0]) - to_float64(args[1])
        const abs_diff = if diff < 0.0 { 0.0 - diff } else { diff }
        if abs_diff > epsilon {
            panic(f"assert_approx failed: {i_display(args[0])} != {i_display(args[1])} (epsilon: {epsilon})")
        }
        return null
    }
    if name == "bench" || name == "benchmark" {
        if len(args) > 0 {
            const fn_val = args[0]
            i_call_any(fn_val, [])
        }
        return {"iterations": 1, "elapsed_ms": 0}
    }
    "__not_test__"
}
func eval_call_master(name, args) {
    const os_result = eval_os_call(name, args)
    if os_result != "__not_os__" { return os_result }

    const crypto_result = eval_crypto_call(name, args)
    if crypto_result != "__not_crypto__" { return crypto_result }

    const regex_result = eval_regex_call(name, args)
    if regex_result != "__not_regex__" { return regex_result }

    const time_result = eval_time_call(name, args)
    if time_result != "__not_time__" { return time_result }

    const net_result = eval_net_call(name, args)
    if net_result != "__not_net__" { return net_result }

    const log_result = eval_log_call(name, args)
    if log_result != "__not_log__" { return log_result }

    const test_result = eval_test_call(name, args)
    if test_result != "__not_test__" { return test_result }

    const unsafe_result = eval_unsafe_call(name, args)
    if unsafe_result != null { return unsafe_result }

    "__not_dispatched__"
}
func eval_encoding_call(name, args) {
    if name == "csv_parse" || name == "csv_decode" {
        if len(args) == 0 { return [] }
        const s = to_string(args[0])
        const lines = s.split("\n")
        let result = []
        for line in lines {
            if len(line.trim()) > 0 {
                result.push(line.split(",").map(c => c.trim()))
            }
        }
        return result
    }
    if name == "csv_encode" || name == "csv_stringify" {
        if len(args) == 0 { return "" }
        if typeof(args[0]) != "array" { return i_display(args[0]) }
        let lines = []
        for row in args[0] {
            if typeof(row) == "array" {
                lines.push(row.map(c => i_display(c)).join(","))
            } else {
                lines.push(i_display(row))
            }
        }
        return lines.join("\n")
    }

    if name == "toml_parse" || name == "toml_decode" {
        return if len(args) > 0 { args[0] } else { {} }
    }
    if name == "toml_encode" || name == "toml_stringify" {
        return if len(args) > 0 { i_to_json(args[0]) } else { "" }
    }

    if name == "yaml_parse" || name == "yaml_decode" {
        return if len(args) > 0 { args[0] } else { {} }
    }
    if name == "yaml_encode" || name == "yaml_stringify" {
        return if len(args) > 0 { i_pretty_print(args[0], 0) } else { "" }
    }

    if name == "xml_parse" || name == "xml_decode" {
        return if len(args) > 0 { args[0] } else { {} }
    }
    if name == "xml_encode" || name == "xml_stringify" {
        return if len(args) > 0 { i_display(args[0]) } else { "" }
    }

    if name == "msgpack_encode" || name == "msgpack_decode" {
        return if len(args) > 0 { args[0] } else { null }
    }
    if name == "cbor_encode" || name == "cbor_decode" {
        return if len(args) > 0 { args[0] } else { null }
    }

    "__not_encoding__"
}
func i_builder_new(type_name) {
    {"__builder": true, "__type": type_name, "__config": {}}
}

func i_builder_set(builder, key, value) {
    let config = builder["__config"]
    config[key] = value
    builder["__config"] = config
    builder
}

func i_builder_get(builder, key) {
    const config = builder["__config"]
    if config.has(key) { return config[key] }
    null
}

func i_builder_build(builder) {
    const type_name = builder["__type"]
    let result = {"__struct": type_name}
    const config = builder["__config"]
    for k in config.keys() {
        result[k] = config[k]
    }
    result
}

func i_builder_reset(builder) {
    builder["__config"] = {}
    builder
}

func i_builder_has(builder, key) {
    builder["__config"].has(key)
}

func i_builder_merge(builder, other_config) {
    if typeof(other_config) != "map" { return builder }
    let config = builder["__config"]
    for k in other_config.keys() {
        config[k] = other_config[k]
    }
    builder["__config"] = config
    builder
}
func i_lazy_iter(arr) {
    {"__iter": true, "__source": arr, "__index": 0, "__transforms": []}
}

func i_lazy_map(iter, fn_val) {
    let transforms = iter["__transforms"]
    transforms.push({"type": "map", "fn": fn_val})
    iter["__transforms"] = transforms
    iter
}

func i_lazy_filter(iter, fn_val) {
    let transforms = iter["__transforms"]
    transforms.push({"type": "filter", "fn": fn_val})
    iter["__transforms"] = transforms
    iter
}

func i_lazy_take(iter, n) {
    let transforms = iter["__transforms"]
    transforms.push({"type": "take", "n": n})
    iter["__transforms"] = transforms
    iter
}

func i_lazy_skip(iter, n) {
    let transforms = iter["__transforms"]
    transforms.push({"type": "skip", "n": n})
    iter["__transforms"] = transforms
    iter
}

func i_lazy_collect(iter) {
    let source = iter["__source"]
    const transforms = iter["__transforms"]

    for t in transforms {
        if t["type"] == "map" {
            source = i_iter_map(source, t["fn"])
        }
        if t["type"] == "filter" {
            source = i_iter_filter(source, t["fn"])
        }
        if t["type"] == "take" {
            source = i_iter_take(source, t["n"])
        }
        if t["type"] == "skip" {
            source = i_iter_skip(source, t["n"])
        }
    }
    source
}

func i_lazy_reduce(iter, fn_val, initial) {
    const collected = i_lazy_collect(iter)
    i_iter_reduce(collected, fn_val, initial)
}

func i_lazy_first(iter) {
    const collected = i_lazy_collect(i_lazy_take(iter, 1))
    if len(collected) > 0 { collected[0] } else { null }
}

func i_lazy_count(iter) {
    len(i_lazy_collect(iter))
}
func i_await_all(futures) {
    let results = []
    for f in futures {
        results.push(i_eval_await(f))
    }
    results
}

func i_await_race(futures) {
    if len(futures) == 0 { return null }
    i_eval_await(futures[0])
}

func i_future_map(future, fn_val) {
    const val = i_eval_await(future)
    const result = i_call_any(fn_val, [val])
    i_eval_spawn_value(result)
}

func i_future_then(future, fn_val) {
    const val = i_eval_await(future)
    const next = i_call_any(fn_val, [val])
    if i_is_future(next) { return next }
    i_eval_spawn_value(next)
}

func i_future_catch(future, fn_val) {
    future
}

func i_future_resolve(value) {
    i_eval_spawn_value(value)
}

func i_future_reject(error) {
    {"__future": true, "__resolved": false, "__error": error}
}
func i_validate(value, schema) {
    if typeof(schema) != "map" { return true }

    if schema.has("type") {
        const expected_type = schema["type"]
        if !i_type_check(value, expected_type) {
            return false
        }
    }

    if schema.has("required") && typeof(value) == "map" {
        const required = schema["required"]
        for field in required {
            if !value.has(field) { return false }
        }
    }

    if schema.has("min") {
        if i_compare(value, schema["min"]) < 0 { return false }
    }
    if schema.has("max") {
        if i_compare(value, schema["max"]) > 0 { return false }
    }

    if schema.has("min_length") {
        if len(value) < schema["min_length"] { return false }
    }
    if schema.has("max_length") {
        if len(value) > schema["max_length"] { return false }
    }

    if schema.has("pattern") && typeof(value) == "string" {
        if !i_str_glob_match(value, schema["pattern"]) { return false }
    }

    if schema.has("enum") {
        const allowed = schema["enum"]
        if !allowed.contains(value) { return false }
    }

    if schema.has("items") && typeof(value) == "array" {
        const item_schema = schema["items"]
        for item in value {
            if !i_validate(item, item_schema) { return false }
        }
    }

    if schema.has("properties") && typeof(value) == "map" {
        const props = schema["properties"]
        for key in props.keys() {
            if value.has(key) {
                if !i_validate(value[key], props[key]) { return false }
            }
        }
    }

    true
}

func i_validate_errors(value, schema) {
    let errors = []
    if typeof(schema) != "map" { return errors }

    if schema.has("type") {
        if !i_type_check(value, schema["type"]) {
            errors.push(f"expected type {schema[\"type\"]}, got {typeof(value)}")
        }
    }

    if schema.has("required") && typeof(value) == "map" {
        for field in schema["required"] {
            if !value.has(field) {
                errors.push(f"missing required field: {field}")
            }
        }
    }

    if schema.has("min") && i_compare(value, schema["min"]) < 0 {
        errors.push(f"value {i_display(value)} is less than minimum {i_display(schema[\"min\"])}")
    }
    if schema.has("max") && i_compare(value, schema["max"]) > 0 {
        errors.push(f"value {i_display(value)} is greater than maximum {i_display(schema[\"max\"])}")
    }

    errors
}
func i_ring_buffer_new(capacity) {
    let buf = []
    let i = 0
    while i < capacity { buf.push(null); i = i + 1 }
    {"__ring": true, "__buf": buf, "__cap": capacity, "__head": 0, "__tail": 0, "__count": 0}
}

func i_ring_buffer_push(rb, val) {
    let buf = rb["__buf"]
    buf[rb["__tail"]] = val
    rb["__buf"] = buf
    rb["__tail"] = (rb["__tail"] + 1) % rb["__cap"]
    if rb["__count"] < rb["__cap"] {
        rb["__count"] = rb["__count"] + 1
    } else {
        rb["__head"] = (rb["__head"] + 1) % rb["__cap"]
    }
    rb
}

func i_ring_buffer_pop(rb) {
    if rb["__count"] == 0 { panic("pop from empty ring buffer") }
    const val = rb["__buf"][rb["__head"]]
    rb["__head"] = (rb["__head"] + 1) % rb["__cap"]
    rb["__count"] = rb["__count"] - 1
    val
}

func i_ring_buffer_peek(rb) {
    if rb["__count"] == 0 { return null }
    rb["__buf"][rb["__head"]]
}

func i_ring_buffer_size(rb) { rb["__count"] }
func i_ring_buffer_capacity(rb) { rb["__cap"] }
func i_ring_buffer_is_empty(rb) { rb["__count"] == 0 }
func i_ring_buffer_is_full(rb) { rb["__count"] == rb["__cap"] }

func i_ring_buffer_to_array(rb) {
    let result = []
    let i = 0
    let idx = rb["__head"]
    while i < rb["__count"] {
        result.push(rb["__buf"][idx])
        idx = (idx + 1) % rb["__cap"]
        i = i + 1
    }
    result
}

func i_ring_buffer_clear(rb) {
    rb["__head"] = 0
    rb["__tail"] = 0
    rb["__count"] = 0
    rb
}
func i_trie_new() {
    {"__trie": true, "__children": {}, "__is_end": false, "__value": null}
}

func i_trie_insert(trie, key, value) {
    let current = trie
    for ch in to_string(key).chars() {
        let children = current["__children"]
        if !children.has(ch) {
            children[ch] = {"__children": {}, "__is_end": false, "__value": null}
        }
        current["__children"] = children
        current = children[ch]
    }
    current["__is_end"] = true
    current["__value"] = value
    trie
}

func i_trie_search(trie, key) {
    let current = trie
    for ch in to_string(key).chars() {
        const children = current["__children"]
        if !children.has(ch) { return null }
        current = children[ch]
    }
    if current["__is_end"] { return current["__value"] }
    null
}

func i_trie_has(trie, key) {
    let current = trie
    for ch in to_string(key).chars() {
        const children = current["__children"]
        if !children.has(ch) { return false }
        current = children[ch]
    }
    current["__is_end"]
}

func i_trie_starts_with(trie, prefix) {
    let current = trie
    for ch in to_string(prefix).chars() {
        const children = current["__children"]
        if !children.has(ch) { return false }
        current = children[ch]
    }
    true
}

func i_trie_keys_with_prefix(trie, prefix) {
    let current = trie
    for ch in to_string(prefix).chars() {
        const children = current["__children"]
        if !children.has(ch) { return [] }
        current = children[ch]
    }
    let result = []
    i_trie_collect_keys(current, prefix, result)
    result
}

func i_trie_collect_keys(node, prefix, result) {
    if node["__is_end"] { result.push(prefix) }
    const children = node["__children"]
    for ch in children.keys() {
        i_trie_collect_keys(children[ch], prefix + ch, result)
    }
}
func i_lru_new(capacity) {
    {"__lru": true, "__cap": capacity, "__keys": [], "__data": {}}
}

func i_lru_get(cache, key) {
    const k = to_string(key)
    if !cache["__data"].has(k) { return null }
    let keys = cache["__keys"]
    let new_keys = [k]
    for existing in keys {
        if existing != k { new_keys.push(existing) }
    }
    cache["__keys"] = new_keys
    cache["__data"][k]
}

func i_lru_set(cache, key, value) {
    const k = to_string(key)
    let data = cache["__data"]
    let keys = cache["__keys"]

    let new_keys = [k]
    for existing in keys {
        if existing != k { new_keys.push(existing) }
    }

    while len(new_keys) > cache["__cap"] {
        const evicted = new_keys[len(new_keys) - 1]
        new_keys = new_keys.slice(0, len(new_keys) - 1)
        data = data.delete(evicted)
    }

    data[k] = value
    cache["__keys"] = new_keys
    cache["__data"] = data
    cache
}

func i_lru_has(cache, key) {
    cache["__data"].has(to_string(key))
}

func i_lru_size(cache) { len(cache["__keys"]) }
func i_lru_capacity(cache) { cache["__cap"] }

func i_lru_clear(cache) {
    cache["__keys"] = []
    cache["__data"] = {}
    cache
}

func i_lru_keys(cache) { cache["__keys"] }
func i_bloom_new(size) {
    let bits = []
    let i = 0
    while i < size { bits.push(false); i = i + 1 }
    {"__bloom": true, "__bits": bits, "__size": size, "__count": 0}
}

func i_bloom_add(bloom, value) {
    const key = i_display(value)
    const size = bloom["__size"]
    let bits = bloom["__bits"]
    const h1 = i_hash(key) % size
    const h2 = i_hash(key + "salt1") % size
    const h3 = i_hash(key + "salt2") % size
    const idx1 = if h1 < 0 { 0 - h1 } else { h1 }
    const idx2 = if h2 < 0 { 0 - h2 } else { h2 }
    const idx3 = if h3 < 0 { 0 - h3 } else { h3 }
    bits[idx1 % size] = true
    bits[idx2 % size] = true
    bits[idx3 % size] = true
    bloom["__bits"] = bits
    bloom["__count"] = bloom["__count"] + 1
    bloom
}

func i_bloom_may_contain(bloom, value) {
    const key = i_display(value)
    const size = bloom["__size"]
    const bits = bloom["__bits"]
    const h1 = i_hash(key) % size
    const h2 = i_hash(key + "salt1") % size
    const h3 = i_hash(key + "salt2") % size
    const idx1 = if h1 < 0 { 0 - h1 } else { h1 }
    const idx2 = if h2 < 0 { 0 - h2 } else { h2 }
    const idx3 = if h3 < 0 { 0 - h3 } else { h3 }
    bits[idx1 % size] && bits[idx2 % size] && bits[idx3 % size]
}

func i_bloom_count(bloom) { bloom["__count"] }
func i_uf_new(n) {
    let parent = []
    let rank = []
    let i = 0
    while i < n {
        parent.push(i)
        rank.push(0)
        i = i + 1
    }
    {"__uf": true, "__parent": parent, "__rank": rank, "__size": n}
}

func i_uf_find(uf, x) {
    let parent = uf["__parent"]
    let current = x
    while parent[current] != current {
        parent[current] = parent[parent[current]]
        current = parent[current]
    }
    uf["__parent"] = parent
    current
}

func i_uf_union(uf, x, y) {
    const rx = i_uf_find(uf, x)
    const ry = i_uf_find(uf, y)
    if rx == ry { return uf }
    let parent = uf["__parent"]
    let rank = uf["__rank"]
    if rank[rx] < rank[ry] {
        parent[rx] = ry
    } else if rank[rx] > rank[ry] {
        parent[ry] = rx
    } else {
        parent[ry] = rx
        rank[rx] = rank[rx] + 1
    }
    uf["__parent"] = parent
    uf["__rank"] = rank
    uf
}

func i_uf_connected(uf, x, y) {
    i_uf_find(uf, x) == i_uf_find(uf, y)
}

func i_uf_components(uf) {
    let seen = {"__init": true}
    let count = 0
    let i = 0
    while i < uf["__size"] {
        const root = i_uf_find(uf, i)
        const key = to_string(root)
        if !seen.has(key) {
            seen[key] = true
            count = count + 1
        }
        i = i + 1
    }
    count
}
func i_interval_new(lo, hi) {
    {"__interval": true, "lo": lo, "hi": hi}
}

func i_interval_contains(interval, value) {
    i_compare(value, interval["lo"]) >= 0 && i_compare(value, interval["hi"]) <= 0
}

func i_interval_overlaps(a, b) {
    i_compare(a["lo"], b["hi"]) <= 0 && i_compare(b["lo"], a["hi"]) <= 0
}

func i_interval_merge(a, b) {
    if !i_interval_overlaps(a, b) { return [a, b] }
    const lo = if i_compare(a["lo"], b["lo"]) <= 0 { a["lo"] } else { b["lo"] }
    const hi = if i_compare(a["hi"], b["hi"]) >= 0 { a["hi"] } else { b["hi"] }
    [i_interval_new(lo, hi)]
}

func i_interval_intersect(a, b) {
    if !i_interval_overlaps(a, b) { return null }
    const lo = if i_compare(a["lo"], b["lo"]) >= 0 { a["lo"] } else { b["lo"] }
    const hi = if i_compare(a["hi"], b["hi"]) <= 0 { a["hi"] } else { b["hi"] }
    i_interval_new(lo, hi)
}

func i_interval_length(interval) {
    i_sub(interval["hi"], interval["lo"])
}

func i_interval_merge_all(intervals) {
    if len(intervals) <= 1 { return intervals }
    const sorted = i_iter_sort_by(intervals, i => i["lo"])
    let result = [sorted[0]]
    let i = 1
    while i < len(sorted) {
        let last = result[len(result) - 1]
        const current = sorted[i]
        if i_compare(current["lo"], last["hi"]) <= 0 {
            const new_hi = if i_compare(current["hi"], last["hi"]) > 0 { current["hi"] } else { last["hi"] }
            result[len(result) - 1] = i_interval_new(last["lo"], new_hi)
        } else {
            result.push(current)
        }
        i = i + 1
    }
    result
}
func i_popcount(n) {
    let v = if n < 0 { 0 - n } else { n }
    let count = 0
    while v > 0 {
        count = count + (v % 2)
        v = v / 2
    }
    count
}

func i_clz(n) {
    if n == 0 { return 64 }
    let v = if n < 0 { 0 - n } else { n }
    let count = 0
    let bit = 1
    let highest = 0
    while bit <= v && bit > 0 {
        highest = highest + 1
        bit = bit * 2
    }
    64 - highest
}

func i_ctz(n) {
    if n == 0 { return 64 }
    let v = if n < 0 { 0 - n } else { n }
    let count = 0
    while v % 2 == 0 && v > 0 {
        count = count + 1
        v = v / 2
    }
    count
}

func i_is_power_of_2(n) {
    n > 0 && (n & (n - 1)) == 0
}

func i_next_power_of_2(n) {
    if n <= 1 { return 1 }
    let v = n - 1
    let p = 1
    while p < v { p = p * 2 }
    p
}

func i_reverse_bits_byte(n) {
    let result = 0
    let v = n
    let i = 0
    while i < 8 {
        result = result * 2 + (v % 2)
        v = v / 2
        i = i + 1
    }
    result
}

func i_rotl(n, shift, bits) {
    const mask = (1 << bits) - 1
    ((n << shift) & mask) | ((n >> (bits - shift)) & mask)
}

func i_rotr(n, shift, bits) {
    const mask = (1 << bits) - 1
    ((n >> shift) & mask) | ((n << (bits - shift)) & mask)
}
func i_extended_gcd(a, b) {
    if b == 0 { return [a, 1, 0] }
    const result = i_extended_gcd(b, a % b)
    const g = result[0]
    const x = result[1]
    const y = result[2]
    [g, y, x - (a / b) * y]
}

func i_mod_pow(base, exp, modulus) {
    if modulus == 1 { return 0 }
    let result = 1
    let b = base % modulus
    let e = exp
    while e > 0 {
        if e % 2 == 1 {
            result = (result * b) % modulus
        }
        e = e / 2
        b = (b * b) % modulus
    }
    result
}

func i_mod_inverse(a, m) {
    const result = i_extended_gcd(a, m)
    const g = result[0]
    const x = result[1]
    if g != 1 { panic("modular inverse does not exist") }
    ((x % m) + m) % m
}

func i_euler_totient(n) {
    let result = n
    let p = 2
    let num = n
    while p * p <= num {
        if num % p == 0 {
            while num % p == 0 { num = num / p }
            result = result - result / p
        }
        p = p + 1
    }
    if num > 1 {
        result = result - result / num
    }
    result
}

func i_sieve_of_eratosthenes(n) {
    if n < 2 { return [] }
    let is_prime = []
    let i = 0
    while i <= n { is_prime.push(true); i = i + 1 }
    is_prime[0] = false
    is_prime[1] = false
    let p = 2
    while p * p <= n {
        if is_prime[p] {
            let multiple = p * p
            while multiple <= n {
                is_prime[multiple] = false
                multiple = multiple + p
            }
        }
        p = p + 1
    }
    let primes = []
    i = 2
    while i <= n {
        if is_prime[i] { primes.push(i) }
        i = i + 1
    }
    primes
}

func i_prime_factors(n) {
    if n <= 1 { return [] }
    let factors = []
    let num = n
    let d = 2
    while d * d <= num {
        while num % d == 0 {
            factors.push(d)
            num = num / d
        }
        d = d + 1
    }
    if num > 1 { factors.push(num) }
    factors
}

func i_divisors(n) {
    if n <= 0 { return [] }
    let result = []
    let i = 1
    while i * i <= n {
        if n % i == 0 {
            result.push(i)
            if i != n / i { result.push(n / i) }
        }
        i = i + 1
    }
    result.sort()
}

func i_sum_of_divisors(n) {
    i_iter_sum(i_divisors(n))
}

func i_is_perfect(n) {
    if n <= 1 { return false }
    i_sum_of_divisors(n) - n == n
}

func i_crt(remainders, moduli) {
    if len(remainders) != len(moduli) { panic("CRT: arrays must have same length") }
    const n = len(remainders)
    let M = 1
    for m in moduli { M = M * m }
    let x = 0
    let i = 0
    while i < n {
        const Mi = M / moduli[i]
        const yi = i_mod_inverse(Mi, moduli[i])
        x = x + remainders[i] * Mi * yi
        i = i + 1
    }
    x % M
}
func i_point(x, y) { {"x": x, "y": y} }

func i_distance_sq(p1, p2) {
    const dx = p2["x"] - p1["x"]
    const dy = p2["y"] - p1["y"]
    dx * dx + dy * dy
}

func i_manhattan_distance(p1, p2) {
    const dx = p2["x"] - p1["x"]
    const dy = p2["y"] - p1["y"]
    const abs_dx = if dx < 0 { 0 - dx } else { dx }
    const abs_dy = if dy < 0 { 0 - dy } else { dy }
    abs_dx + abs_dy
}

func i_cross_2d(p1, p2, p3) {
    (p2["x"] - p1["x"]) * (p3["y"] - p1["y"]) - (p2["y"] - p1["y"]) * (p3["x"] - p1["x"])
}

func i_convex_hull(points) {
    if len(points) <= 3 { return points }

    let pivot_idx = 0
    let i = 1
    while i < len(points) {
        const p = points[i]
        const pv = points[pivot_idx]
        if p["y"] < pv["y"] || (p["y"] == pv["y"] && p["x"] < pv["x"]) {
            pivot_idx = i
        }
        i = i + 1
    }

    const tmp = points[0]
    points[0] = points[pivot_idx]
    points[pivot_idx] = tmp
    const pivot = points[0]

    let rest = points.slice(1, len(points))
    rest = i_iter_sort_by(rest, p => {
        const dx = p["x"] - pivot["x"]
        const dy = p["y"] - pivot["y"]
        const abs_dx = if dx < 0 { 0 - dx } else { dx }
        const abs_dy = if dy < 0 { 0 - dy } else { dy }
        if abs_dx + abs_dy == 0 { 0 } else { dy * 1000 / (abs_dx + abs_dy) }
    })

    let stack = [pivot, rest[0]]
    i = 1
    while i < len(rest) {
        while len(stack) > 1 {
            const top = stack[len(stack) - 1]
            const below = stack[len(stack) - 2]
            if i_cross_2d(below, top, rest[i]) <= 0 {
                stack = stack.slice(0, len(stack) - 1)
            } else {
                break
            }
        }
        stack.push(rest[i])
        i = i + 1
    }
    stack
}

func i_point_in_polygon(point, polygon) {
    const px = point["x"]
    const py = point["y"]
    let inside = false
    const n = len(polygon)
    let j = n - 1
    let i = 0
    while i < n {
        const xi = polygon[i]["x"]
        const yi = polygon[i]["y"]
        const xj = polygon[j]["x"]
        const yj = polygon[j]["y"]
        if (yi > py) != (yj > py) {
            const slope = (px - xi) * (yj - yi) - (xj - xi) * (py - yi)
            if slope < 0 != (yj < yi) {
                inside = !inside
            }
        }
        j = i
        i = i + 1
    }
    inside
}
func i_search_linear(arr, predicate) {
    let i = 0
    while i < len(arr) {
        if i_truthy(i_call_any(predicate, [arr[i]])) { return i }
        i = i + 1
    }
    -1
}

func i_search_binary(arr, target, cmp_fn) {
    let lo = 0
    let hi = len(arr) - 1
    while lo <= hi {
        const mid = lo + (hi - lo) / 2
        const cmp = i_call_any(cmp_fn, [arr[mid], target])
        if cmp == 0 { return mid }
        if cmp < 0 { lo = mid + 1 } else { hi = mid - 1 }
    }
    -1
}

func i_lower_bound(arr, target) {
    let lo = 0
    let hi = len(arr)
    while lo < hi {
        const mid = lo + (hi - lo) / 2
        if i_compare(arr[mid], target) < 0 { lo = mid + 1 } else { hi = mid }
    }
    lo
}

func i_upper_bound(arr, target) {
    let lo = 0
    let hi = len(arr)
    while lo < hi {
        const mid = lo + (hi - lo) / 2
        if i_compare(arr[mid], target) <= 0 { lo = mid + 1 } else { hi = mid }
    }
    lo
}

func i_equal_range(arr, target) {
    [i_lower_bound(arr, target), i_upper_bound(arr, target)]
}

func i_ternary_search_max(fn_val, lo, hi, iterations) {
    let l = lo
    let r = hi
    let i = 0
    while i < iterations {
        const m1 = l + (r - l) / 3
        const m2 = r - (r - l) / 3
        const f1 = i_call_any(fn_val, [m1])
        const f2 = i_call_any(fn_val, [m2])
        if i_compare(f1, f2) < 0 { l = m1 } else { r = m2 }
        i = i + 1
    }
    (l + r) / 2
}

func i_kmp_search(text, pattern) {
    const n = len(text)
    const m = len(pattern)
    if m == 0 { return [] }
    if m > n { return [] }

    let fail = [0]
    let k = 0
    let i = 1
    while i < m {
        while k > 0 && pattern[k] != pattern[i] {
            k = fail[k - 1]
        }
        if pattern[k] == pattern[i] { k = k + 1 }
        fail.push(k)
        i = i + 1
    }

    let matches = []
    k = 0
    i = 0
    while i < n {
        while k > 0 && pattern[k] != text[i] {
            k = fail[k - 1]
        }
        if pattern[k] == text[i] { k = k + 1 }
        if k == m {
            matches.push(i - m + 1)
            k = fail[k - 1]
        }
        i = i + 1
    }
    matches
}
func i_lcs_length(a, b) {
    const m = len(a)
    const n = len(b)
    let prev = []
    let i = 0
    while i <= n { prev.push(0); i = i + 1 }
    i = 1
    while i <= m {
        let curr = [0]
        let j = 1
        while j <= n {
            if a[i - 1] == b[j - 1] {
                curr.push(prev[j - 1] + 1)
            } else {
                const take_a = prev[j]
                const take_b = curr[j - 1]
                curr.push(if take_a > take_b { take_a } else { take_b })
            }
            j = j + 1
        }
        prev = curr
        i = i + 1
    }
    prev[n]
}

func i_lcs(a, b) {
    const m = len(a)
    const n = len(b)
    let dp = []
    let i = 0
    while i <= m {
        let row = []
        let j = 0
        while j <= n { row.push(0); j = j + 1 }
        dp.push(row)
        i = i + 1
    }
    i = 1
    while i <= m {
        let j = 1
        while j <= n {
            if a[i - 1] == b[j - 1] {
                dp[i][j] = dp[i - 1][j - 1] + 1
            } else {
                dp[i][j] = if dp[i - 1][j] > dp[i][j - 1] { dp[i - 1][j] } else { dp[i][j - 1] }
            }
            j = j + 1
        }
        i = i + 1
    }
    let result = []
    i = m
    let j = n
    while i > 0 && j > 0 {
        if a[i - 1] == b[j - 1] {
            result.push(a[i - 1])
            i = i - 1
            j = j - 1
        } else if dp[i - 1][j] > dp[i][j - 1] {
            i = i - 1
        } else {
            j = j - 1
        }
    }
    result.reverse()
}

func i_lis_length(arr) {
    if len(arr) == 0 { return 0 }
    let tails = []
    for x in arr {
        let lo = 0
        let hi = len(tails)
        while lo < hi {
            const mid = lo + (hi - lo) / 2
            if i_compare(tails[mid], x) < 0 { lo = mid + 1 } else { hi = mid }
        }
        if lo == len(tails) {
            tails.push(x)
        } else {
            tails[lo] = x
        }
    }
    len(tails)
}

func i_knapsack_01(weights, values, capacity) {
    const n = len(weights)
    let prev = []
    let i = 0
    while i <= capacity { prev.push(0); i = i + 1 }
    i = 0
    while i < n {
        let curr = []
        let w = 0
        while w <= capacity {
            if weights[i] > w {
                curr.push(prev[w])
            } else {
                const without = prev[w]
                const with_item = prev[w - weights[i]] + values[i]
                curr.push(if with_item > without { with_item } else { without })
            }
            w = w + 1
        }
        prev = curr
        i = i + 1
    }
    prev[capacity]
}

func i_coin_change(coins, amount) {
    if amount == 0 { return 0 }
    const INF = amount + 1
    let dp = []
    let i = 0
    while i <= amount { dp.push(INF); i = i + 1 }
    dp[0] = 0
    let a = 1
    while a <= amount {
        for coin in coins {
            if coin <= a && dp[a - coin] + 1 < dp[a] {
                dp[a] = dp[a - coin] + 1
            }
        }
        a = a + 1
    }
    if dp[amount] > amount { -1 } else { dp[amount] }
}

func i_max_subarray_sum(arr) {
    if len(arr) == 0 { return 0 }
    let max_ending_here = arr[0]
    let max_so_far = arr[0]
    let i = 1
    while i < len(arr) {
        const with_current = max_ending_here + arr[i]
        max_ending_here = if arr[i] > with_current { arr[i] } else { with_current }
        if max_ending_here > max_so_far { max_so_far = max_ending_here }
        i = i + 1
    }
    max_so_far
}
func eval_call_all_categories(name, args) {
    const enc_result = eval_encoding_call(name, args)
    if enc_result != "__not_encoding__" { return enc_result }

    const master_result = eval_call_master(name, args)
    if master_result != "__not_dispatched__" { return master_result }

    "__not_found__"
}
func i_call_depth_current() {
    len(i_scopes)
}

func i_all_function_names() {
    let names = []
    for k in i_functions.keys() {
        if k != "__init" { names.push(k) }
    }
    names
}

func i_all_type_names() {
    let names = []
    for k in i_structs.keys() {
        if k != "__init" { names.push(f"struct {k}") }
    }
    for k in i_enums.keys() {
        if k != "__init" { names.push(f"enum {k}") }
    }
    for k in i_type_aliases.keys() {
        if k != "__init" { names.push(f"type {k} = {i_type_aliases[k]}") }
    }
    names
}

func i_memory_summary() {
    {
        "scope_depth": len(i_scopes),
        "total_vars": i_total_var_count(),
        "functions": len(i_functions.keys()) - 1,
        "structs": len(i_structs.keys()) - 1,
        "enums": len(i_enums.keys()) - 1,
        "heap_live": i_heap_live_count(),
        "gc_cycles": i_gc_stats["cycles"],
        "gc_swept": i_gc_stats["swept"],
        "modules": len(i_modules.keys()) - 1,
        "defers_pending": i_defer_count(),
    }
}

func i_checkpoint() {
    {
        "scopes_depth": len(i_scopes),
        "functions_count": len(i_functions.keys()) - 1,
        "structs_count": len(i_structs.keys()) - 1,
        "enums_count": len(i_enums.keys()) - 1,
        "modules_count": len(i_modules.keys()) - 1,
        "heap_live": i_heap_live_count(),
    }
}

func i_checkpoint_diff(a, b) {
    let diffs = {}
    for k in a.keys() {
        if b.has(k) && a[k] != b[k] {
            diffs[k] = {"from": a[k], "to": b[k]}
        }
    }
    diffs
}

func i_status_report() {
    const mem = i_memory_summary()
    let lines = []
    lines.push("=== Interpreter Status ===")
    lines.push(f"Scope depth: {mem[\"scope_depth\"]}")
    lines.push(f"Total vars:  {mem[\"total_vars\"]}")
    lines.push(f"Functions:   {mem[\"functions\"]}")
    lines.push(f"Structs:     {mem[\"structs\"]}")
    lines.push(f"Enums:       {mem[\"enums\"]}")
    lines.push(f"Heap live:   {mem[\"heap_live\"]}")
    lines.push(f"GC cycles:   {mem[\"gc_cycles\"]}")
    lines.push(f"GC swept:    {mem[\"gc_swept\"]}")
    lines.push(f"Modules:     {mem[\"modules\"]}")
    lines.push(f"Defers:      {mem[\"defers_pending\"]}")
    lines.push("==========================")
    lines.join("\n")
}
func i_fnv1a(s) {
    const FNV_OFFSET = 2166136261
    const FNV_PRIME = 16777619
    let hash = FNV_OFFSET
    for ch in to_string(s).chars() {
        hash = (hash ^ char_code(ch)) * FNV_PRIME
    }
    hash
}

func i_djb2(s) {
    let hash = 5381
    for ch in to_string(s).chars() {
        hash = hash * 33 + char_code(ch)
    }
    hash
}

func i_adler32(s) {
    const MOD_ADLER = 65521
    let a = 1
    let b = 0
    for ch in to_string(s).chars() {
        a = (a + char_code(ch)) % MOD_ADLER
        b = (b + a) % MOD_ADLER
    }
    b * 65536 + a
}

func i_crc_simple(s) {
    let crc = 0
    for ch in to_string(s).chars() {
        crc = crc ^ char_code(ch)
        let i = 0
        while i < 8 {
            if crc % 2 == 1 {
                crc = (crc / 2) ^ 3988292384
            } else {
                crc = crc / 2
            }
            i = i + 1
        }
    }
    crc
}

func i_rot13(s) {
    let result = ""
    for ch in to_string(s).chars() {
        const code = char_code(ch)
        if code >= 65 && code <= 90 {
            result = result + from_char_code(((code - 65 + 13) % 26) + 65)
        } else if code >= 97 && code <= 122 {
            result = result + from_char_code(((code - 97 + 13) % 26) + 97)
        } else {
            result = result + ch
        }
    }
    result
}

func i_caesar(s, shift) {
    let result = ""
    const sh = shift % 26
    for ch in to_string(s).chars() {
        const code = char_code(ch)
        if code >= 65 && code <= 90 {
            result = result + from_char_code(((code - 65 + sh) % 26) + 65)
        } else if code >= 97 && code <= 122 {
            result = result + from_char_code(((code - 97 + sh) % 26) + 97)
        } else {
            result = result + ch
        }
    }
    result
}

func i_rle_encode(s) {
    if len(s) == 0 { return "" }
    let result = ""
    let count = 1
    let prev = s[0]
    let i = 1
    while i < len(s) {
        if s[i] == prev {
            count = count + 1
        } else {
            if count > 1 { result = result + to_string(count) }
            result = result + prev
            prev = s[i]
            count = 1
        }
        i = i + 1
    }
    if count > 1 { result = result + to_string(count) }
    result = result + prev
    result
}

func i_rle_decode(s) {
    let result = ""
    let count_str = ""
    for ch in to_string(s).chars() {
        if ch >= "0" && ch <= "9" {
            count_str = count_str + ch
        } else {
            const count = if len(count_str) > 0 { parse_int(count_str) } else { 1 }
            result = result + i_str_repeat(ch, count)
            count_str = ""
        }
    }
    result
}
func i_binary_strings(n) {
    if n <= 0 { return [""] }
    const smaller = i_binary_strings(n - 1)
    let result = []
    for s in smaller {
        result.push(s + "0")
        result.push(s + "1")
    }
    result
}

func i_subsets(arr) {
    i_array_power_set(arr)
}

func i_next_permutation(arr) {
    let a = []
    for item in arr { a.push(item) }
    const n = len(a)
    let i = n - 2
    while i >= 0 && i_compare(a[i], a[i + 1]) >= 0 {
        i = i - 1
    }
    if i < 0 { return a.reverse() }
    let j = n - 1
    while i_compare(a[i], a[j]) >= 0 { j = j - 1 }
    const tmp = a[i]
    a[i] = a[j]
    a[j] = tmp
    let left = i + 1
    let right = n - 1
    while left < right {
        const t = a[left]
        a[left] = a[right]
        a[right] = t
        left = left + 1
        right = right - 1
    }
    a
}

func i_catalan(n) {
    if n <= 1 { return 1 }
    i_math_factorial(2 * n) / (i_math_factorial(n + 1) * i_math_factorial(n))
}

func i_bell_number(n) {
    if n == 0 { return 1 }
    let prev_row = [1]
    let k = 1
    while k <= n {
        let row = [prev_row[len(prev_row) - 1]]
        let j = 1
        while j <= k {
            row.push(row[j - 1] + prev_row[j - 1])
            j = j + 1
        }
        prev_row = row
        k = k + 1
    }
    prev_row[0]
}

func i_stirling2(n, k) {
    if k == 0 { return if n == 0 { 1 } else { 0 } }
    if k == 1 || k == n { return 1 }
    if k > n { return 0 }
    k * i_stirling2(n - 1, k) + i_stirling2(n - 1, k - 1)
}

func i_derangement(n) {
    if n == 0 { return 1 }
    if n == 1 { return 0 }
    let a = 1
    let b = 0
    let i = 2
    while i <= n {
        const temp = (i - 1) * (a + b)
        a = b
        b = temp
        i = i + 1
    }
    b
}

func i_partition_count(n) {
    if n < 0 { return 0 }
    let dp = [1]
    let i = 1
    while i <= n { dp.push(0); i = i + 1 }
    let k = 1
    while k <= n {
        i = k
        while i <= n {
            dp[i] = dp[i] + dp[i - k]
            i = i + 1
        }
        k = k + 1
    }
    dp[n]
}
func i_longest_palindrome_length(s) {
    const n = len(s)
    if n <= 1 { return n }
    let max_len = 1
    let i = 0
    while i < n {
        let lo = i
        let hi = i
        while lo >= 0 && hi < n && s[lo] == s[hi] {
            const pal_len = hi - lo + 1
            if pal_len > max_len { max_len = pal_len }
            lo = lo - 1
            hi = hi + 1
        }
        lo = i
        hi = i + 1
        while lo >= 0 && hi < n && s[lo] == s[hi] {
            const pal_len = hi - lo + 1
            if pal_len > max_len { max_len = pal_len }
            lo = lo - 1
            hi = hi + 1
        }
        i = i + 1
    }
    max_len
}

func i_is_palindrome(s) {
    const n = len(s)
    let lo = 0
    let hi = n - 1
    while lo < hi {
        if s[lo] != s[hi] { return false }
        lo = lo + 1
        hi = hi - 1
    }
    true
}

func i_longest_common_prefix(strings) {
    if len(strings) == 0 { return "" }
    let prefix = strings[0]
    let i = 1
    while i < len(strings) {
        const s = strings[i]
        let j = 0
        while j < len(prefix) && j < len(s) && prefix[j] == s[j] {
            j = j + 1
        }
        prefix = prefix.slice(0, j)
        if len(prefix) == 0 { return "" }
        i = i + 1
    }
    prefix
}

func i_z_function(s) {
    const n = len(s)
    let z = []
    let i = 0
    while i < n { z.push(0); i = i + 1 }
    z[0] = n
    let l = 0
    let r = 0
    i = 1
    while i < n {
        if i < r { z[i] = if z[i - l] < r - i { z[i - l] } else { r - i } }
        while i + z[i] < n && s[z[i]] == s[i + z[i]] {
            z[i] = z[i] + 1
        }
        if i + z[i] > r { l = i; r = i + z[i] }
        i = i + 1
    }
    z
}
func i_bigint_add(a, b) {
    let result = ""
    let carry = 0
    let i = len(a) - 1
    let j = len(b) - 1
    while i >= 0 || j >= 0 || carry > 0 {
        let sum = carry
        if i >= 0 { sum = sum + (char_code(a[i]) - 48); i = i - 1 }
        if j >= 0 { sum = sum + (char_code(b[j]) - 48); j = j - 1 }
        result = from_char_code(48 + sum % 10) + result
        carry = sum / 10
    }
    if len(result) == 0 { return "0" }
    result
}

func i_bigint_mul(a, b) {
    const m = len(a)
    const n = len(b)
    let digits = []
    let k = 0
    while k < m + n { digits.push(0); k = k + 1 }
    let i = m - 1
    while i >= 0 {
        let j = n - 1
        while j >= 0 {
            const prod = (char_code(a[i]) - 48) * (char_code(b[j]) - 48)
            const p1 = i + j
            const p2 = i + j + 1
            const sum = prod + digits[p2]
            digits[p2] = sum % 10
            digits[p1] = digits[p1] + sum / 10
            j = j - 1
        }
        i = i - 1
    }
    let result = ""
    let leading = true
    for d in digits {
        if d == 0 && leading { continue }
        leading = false
        result = result + to_string(d)
    }
    if len(result) == 0 { return "0" }
    result
}

func i_bigint_compare(a, b) {
    if len(a) != len(b) { return if len(a) > len(b) { 1 } else { -1 } }
    if a < b { return -1 }
    if a > b { return 1 }
    0
}

func i_bigint_factorial(n) {
    if n <= 1 { return "1" }
    let result = "1"
    let i = 2
    while i <= n {
        result = i_bigint_mul(result, to_string(i))
        i = i + 1
    }
    result
}
const FIXED_SCALE = 1000000

func i_fixed_from_int(n) { n * FIXED_SCALE }
func i_fixed_from_float(f) { to_int64(f * to_float64(FIXED_SCALE)) }
func i_fixed_to_int(fp) { fp / FIXED_SCALE }
func i_fixed_to_float(fp) { to_float64(fp) / to_float64(FIXED_SCALE) }
func i_fixed_add(a, b) { a + b }
func i_fixed_sub(a, b) { a - b }
func i_fixed_mul(a, b) { (a * b) / FIXED_SCALE }
func i_fixed_div(a, b) {
    if b == 0 { panic("fixed-point division by zero") }
    (a * FIXED_SCALE) / b
}
func i_fixed_to_string(fp) {
    const whole = fp / FIXED_SCALE
    const frac_raw = fp % FIXED_SCALE
    const frac = if frac_raw < 0 { 0 - frac_raw } else { frac_raw }
    const frac_str = to_string(frac)
    let padded = frac_str
    while len(padded) < 6 { padded = "0" + padded }
    while len(padded) > 1 && padded[len(padded) - 1] == "0" {
        padded = padded.slice(0, len(padded) - 1)
    }
    f"{whole}.{padded}"
}
func i_fixed_compare(a, b) {
    if a < b { -1 } else if a > b { 1 } else { 0 }
}
func i_rational(num, den) {
    if den == 0 { panic("rational: denominator cannot be zero") }
    const g = i_math_gcd(if num < 0 { 0 - num } else { num }, if den < 0 { 0 - den } else { den })
    let n = num / g
    let d = den / g
    if d < 0 { n = 0 - n; d = 0 - d }
    {"__rational": true, "num": n, "den": d}
}

func i_rational_add(a, b) {
    i_rational(a["num"] * b["den"] + b["num"] * a["den"], a["den"] * b["den"])
}

func i_rational_sub(a, b) {
    i_rational(a["num"] * b["den"] - b["num"] * a["den"], a["den"] * b["den"])
}

func i_rational_mul(a, b) {
    i_rational(a["num"] * b["num"], a["den"] * b["den"])
}

func i_rational_div(a, b) {
    if b["num"] == 0 { panic("rational division by zero") }
    i_rational(a["num"] * b["den"], a["den"] * b["num"])
}

func i_rational_to_float(r) {
    to_float64(r["num"]) / to_float64(r["den"])
}

func i_rational_to_string(r) {
    if r["den"] == 1 { return to_string(r["num"]) }
    f"{r[\"num\"]}/{r[\"den\"]}"
}

func i_rational_compare(a, b) {
    const diff = a["num"] * b["den"] - b["num"] * a["den"]
    if diff < 0 { -1 } else if diff > 0 { 1 } else { 0 }
}

func i_rational_abs(r) {
    i_rational(if r["num"] < 0 { 0 - r["num"] } else { r["num"] }, r["den"])
}

func i_rational_is_zero(r) { r["num"] == 0 }
func i_rational_is_positive(r) { r["num"] > 0 }
func i_rational_is_negative(r) { r["num"] < 0 }
func i_rational_is_integer(r) { r["den"] == 1 }
func i_sparse_array_new(default_val) {
    {"__sparse": true, "__data": {}, "__default": default_val, "__size": 0}
}

func i_sparse_array_get(sa, idx) {
    const key = to_string(idx)
    if sa["__data"].has(key) { return sa["__data"][key] }
    sa["__default"]
}

func i_sparse_array_set(sa, idx, val) {
    let data = sa["__data"]
    data[to_string(idx)] = val
    sa["__data"] = data
    if idx >= sa["__size"] { sa["__size"] = idx + 1 }
    sa
}

func i_sparse_array_density(sa) {
    const data_count = len(sa["__data"].keys())
    const total = sa["__size"]
    if total == 0 { return 0.0 }
    to_float64(data_count) / to_float64(total)
}

func i_sparse_array_nonzero_indices(sa) {
    let indices = []
    for k in sa["__data"].keys() {
        indices.push(parse_int(k))
    }
    indices.sort()
}

func i_sparse_matrix_new(rows, cols, default_val) {
    {"__sparse_matrix": true, "__data": {}, "__rows": rows, "__cols": cols, "__default": default_val}
}

func i_sparse_matrix_get(sm, r, c) {
    const key = f"{r},{c}"
    if sm["__data"].has(key) { return sm["__data"][key] }
    sm["__default"]
}

func i_sparse_matrix_set(sm, r, c, val) {
    let data = sm["__data"]
    data[f"{r},{c}"] = val
    sm["__data"] = data
    sm
}

func i_sparse_matrix_nonzero_count(sm) {
    len(sm["__data"].keys())
}

func i_sparse_matrix_to_dense(sm) {
    const rows = sm["__rows"]
    const cols = sm["__cols"]
    let result = i_matrix_new(rows, cols, sm["__default"])
    for key in sm["__data"].keys() {
        const parts = key.split(",")
        if len(parts) == 2 {
            const r = parse_int(parts[0])
            const c = parse_int(parts[1])
            if r >= 0 && r < rows && c >= 0 && c < cols {
                result[r][c] = sm["__data"][key]
            }
        }
    }
    result
}
func i_segments_intersect(p1, p2, p3, p4) {
    const d1 = i_cross_2d(p3, p4, p1)
    const d2 = i_cross_2d(p3, p4, p2)
    const d3 = i_cross_2d(p1, p2, p3)
    const d4 = i_cross_2d(p1, p2, p4)
    if ((d1 > 0 && d2 < 0) || (d1 < 0 && d2 > 0)) &&
       ((d3 > 0 && d4 < 0) || (d3 < 0 && d4 > 0)) {
        return true
    }
    if d1 == 0 && i_on_segment(p3, p4, p1) { return true }
    if d2 == 0 && i_on_segment(p3, p4, p2) { return true }
    if d3 == 0 && i_on_segment(p1, p2, p3) { return true }
    if d4 == 0 && i_on_segment(p1, p2, p4) { return true }
    false
}

func i_on_segment(p, q, r) {
    const min_x = if p["x"] < q["x"] { p["x"] } else { q["x"] }
    const max_x = if p["x"] > q["x"] { p["x"] } else { q["x"] }
    const min_y = if p["y"] < q["y"] { p["y"] } else { q["y"] }
    const max_y = if p["y"] > q["y"] { p["y"] } else { q["y"] }
    r["x"] >= min_x && r["x"] <= max_x && r["y"] >= min_y && r["y"] <= max_y
}

func i_polygon_area(points) {
    const n = len(points)
    if n < 3 { return 0 }
    let area = 0
    let i = 0
    while i < n {
        const j = (i + 1) % n
        area = area + points[i]["x"] * points[j]["y"]
        area = area - points[j]["x"] * points[i]["y"]
        i = i + 1
    }
    const result = area / 2
    if result < 0 { 0 - result } else { result }
}

func i_polygon_perimeter(points) {
    const n = len(points)
    if n < 2 { return 0 }
    let total = 0
    let i = 0
    while i < n {
        const j = (i + 1) % n
        const dist_sq = i_distance_sq(points[i], points[j])
        total = total + i_math_isqrt(dist_sq)
        i = i + 1
    }
    total
}

func i_polygon_centroid(points) {
    const n = len(points)
    if n == 0 { return i_point(0, 0) }
    let cx = 0
    let cy = 0
    for p in points {
        cx = cx + p["x"]
        cy = cy + p["y"]
    }
    i_point(cx / n, cy / n)
}

func i_bounding_box(points) {
    if len(points) == 0 { return {"min": i_point(0, 0), "max": i_point(0, 0)} }
    let min_x = points[0]["x"]
    let min_y = points[0]["y"]
    let max_x = points[0]["x"]
    let max_y = points[0]["y"]
    for p in points {
        if p["x"] < min_x { min_x = p["x"] }
        if p["y"] < min_y { min_y = p["y"] }
        if p["x"] > max_x { max_x = p["x"] }
        if p["y"] > max_y { max_y = p["y"] }
    }
    {"min": i_point(min_x, min_y), "max": i_point(max_x, max_y)}
}

func i_search_interpolation(arr, target) {
    let lo = 0
    let hi = len(arr) - 1
    while lo <= hi && i_compare(target, arr[lo]) >= 0 && i_compare(target, arr[hi]) <= 0 {
        if lo == hi {
            if arr[lo] == target { return lo }
            return -1
        }
        const lo_val = i_to_int64(arr[lo])
        const hi_val = i_to_int64(arr[hi])
        const target_val = i_to_int64(target)
        const pos = if hi_val == lo_val { lo }
            else { lo + ((target_val - lo_val) * (hi - lo)) / (hi_val - lo_val) }
        if pos < lo || pos > hi { return -1 }
        const cmp = i_compare(arr[pos], target)
        if cmp == 0 { return pos }
        if cmp < 0 { lo = pos + 1 } else { hi = pos - 1 }
    }
    -1
}

func i_search_exponential(arr, target) {
    const n = len(arr)
    if n == 0 { return -1 }
    if arr[0] == target { return 0 }
    let bound = 1
    while bound < n && i_compare(arr[bound], target) <= 0 {
        bound = bound * 2
    }
    const lo = bound / 2
    const hi = if bound < n { bound } else { n - 1 }
    let l = lo
    let r = hi
    while l <= r {
        const mid = l + (r - l) / 2
        const cmp = i_compare(arr[mid], target)
        if cmp == 0 { return mid }
        if cmp < 0 { l = mid + 1 } else { r = mid - 1 }
    }
    -1
}
func i_counting_sort(arr, max_val) {
    let counts = []
    let i = 0
    while i <= max_val { counts.push(0); i = i + 1 }
    for x in arr {
        if x >= 0 && x <= max_val { counts[x] = counts[x] + 1 }
    }
    let result = []
    i = 0
    while i <= max_val {
        let j = 0
        while j < counts[i] { result.push(i); j = j + 1 }
        i = i + 1
    }
    result
}

func i_bucket_sort(arr, num_buckets) {
    if len(arr) == 0 { return [] }
    let min_val = arr[0]
    let max_val = arr[0]
    for x in arr {
        if x < min_val { min_val = x }
        if x > max_val { max_val = x }
    }
    const range = max_val - min_val + 1
    const bucket_size = if range / num_buckets > 0 { range / num_buckets } else { 1 }
    let buckets = []
    let i = 0
    while i < num_buckets { buckets.push([]); i = i + 1 }
    for x in arr {
        let bi = (x - min_val) / bucket_size
        if bi >= num_buckets { bi = num_buckets - 1 }
        let b = buckets[bi]
        b.push(x)
        buckets[bi] = b
    }
    let result = []
    for bucket in buckets {
        const sorted = bucket.sort()
        for x in sorted { result.push(x) }
    }
    result
}
func i_heap_sort(arr) {
    if len(arr) <= 1 { return arr }
    let a = []
    for item in arr { a.push(item) }
    const n = len(a)
    let i = n / 2 - 1
    while i >= 0 {
        i_heapify(a, n, i)
        i = i - 1
    }
    i = n - 1
    while i > 0 {
        const tmp = a[0]
        a[0] = a[i]
        a[i] = tmp
        i_heapify(a, i, 0)
        i = i - 1
    }
    a
}

func i_heapify(arr, n, root) {
    let largest = root
    const left = 2 * root + 1
    const right = 2 * root + 2
    if left < n && i_compare(arr[left], arr[largest]) > 0 { largest = left }
    if right < n && i_compare(arr[right], arr[largest]) > 0 { largest = right }
    if largest != root {
        const tmp = arr[root]
        arr[root] = arr[largest]
        arr[largest] = tmp
        i_heapify(arr, n, largest)
    }
}
func i_tree_preorder(node) {
    if node == null { return [] }
    if typeof(node) != "map" { return [node] }
    let result = []
    if node.has("value") { result.push(node["value"]) }
    if node.has("children") && typeof(node["children"]) == "array" {
        for child in node["children"] {
            result = result.concat(i_tree_preorder(child))
        }
    }
    result
}

func i_tree_postorder(node) {
    if node == null { return [] }
    if typeof(node) != "map" { return [node] }
    let result = []
    if node.has("children") && typeof(node["children"]) == "array" {
        for child in node["children"] {
            result = result.concat(i_tree_postorder(child))
        }
    }
    if node.has("value") { result.push(node["value"]) }
    result
}

func i_tree_levelorder(root) {
    if root == null { return [] }
    let queue = [root]
    let result = []
    while len(queue) > 0 {
        const node = queue[0]
        queue = queue.slice(1, len(queue))
        if typeof(node) == "map" {
            if node.has("value") { result.push(node["value"]) }
            if node.has("children") && typeof(node["children"]) == "array" {
                for child in node["children"] {
                    queue.push(child)
                }
            }
        } else {
            result.push(node)
        }
    }
    result
}

func i_tree_depth(node) {
    if node == null { return 0 }
    if typeof(node) != "map" { return 1 }
    if !node.has("children") || typeof(node["children"]) != "array" || len(node["children"]) == 0 {
        return 1
    }
    let max_child_depth = 0
    for child in node["children"] {
        const d = i_tree_depth(child)
        if d > max_child_depth { max_child_depth = d }
    }
    1 + max_child_depth
}

func i_tree_size(node) {
    if node == null { return 0 }
    if typeof(node) != "map" { return 1 }
    let count = 1
    if node.has("children") && typeof(node["children"]) == "array" {
        for child in node["children"] {
            count = count + i_tree_size(child)
        }
    }
    count
}

func i_tree_leaves(node) {
    if node == null { return 0 }
    if typeof(node) != "map" { return 1 }
    if !node.has("children") || typeof(node["children"]) != "array" || len(node["children"]) == 0 {
        return 1
    }
    let count = 0
    for child in node["children"] {
        count = count + i_tree_leaves(child)
    }
    count
}

func i_tree_find(node, target) {
    if node == null { return false }
    if typeof(node) != "map" { return node == target }
    if node.has("value") && node["value"] == target { return true }
    if node.has("children") && typeof(node["children"]) == "array" {
        for child in node["children"] {
            if i_tree_find(child, target) { return true }
        }
    }
    false
}

func i_tree_map(node, fn_val) {
    if node == null { return null }
    if typeof(node) != "map" { return i_call_any(fn_val, [node]) }
    let result = {}
    for k in node.keys() {
        if k == "value" {
            result["value"] = i_call_any(fn_val, [node["value"]])
        } else if k == "children" && typeof(node["children"]) == "array" {
            result["children"] = node["children"].map(c => i_tree_map(c, fn_val))
        } else {
            result[k] = node[k]
        }
    }
    result
}
const MAX_CALL_DEPTH = 512
const MAX_LOOP_ITERATIONS = 1000000
const MAX_ARRAY_ELEMENTS = 1000000
const MAX_STRING_LENGTH = 10000000
const MAX_MAP_ENTRIES = 100000
const MAX_EXPR_DEPTH = 256
const MAX_VARIABLES = 50000
const MAX_FUNCTIONS = 10000

let i_call_depth = 0
let i_expr_depth = 0
let i_total_iterations = 0

func i_check_call_depth(name) {
    i_call_depth = i_call_depth + 1
    if i_call_depth > MAX_CALL_DEPTH {
        i_call_depth = i_call_depth - 1
        panic(f"stack overflow: maximum call depth ({MAX_CALL_DEPTH}) exceeded in '{name}'")
    }
}

func i_release_call_depth() {
    i_call_depth = i_call_depth - 1
}

func i_check_expr_depth() {
    i_expr_depth = i_expr_depth + 1
    if i_expr_depth > MAX_EXPR_DEPTH {
        i_expr_depth = i_expr_depth - 1
        panic(f"expression nesting depth exceeded ({MAX_EXPR_DEPTH})")
    }
}

func i_release_expr_depth() {
    i_expr_depth = i_expr_depth - 1
}

func i_check_iterations(count) {
    if count > MAX_LOOP_ITERATIONS {
        panic(f"maximum loop iterations ({MAX_LOOP_ITERATIONS}) exceeded")
    }
}

func i_check_array_size(arr) {
    if typeof(arr) == "array" && len(arr) > MAX_ARRAY_ELEMENTS {
        panic(f"array size limit ({MAX_ARRAY_ELEMENTS}) exceeded: got {len(arr)}")
    }
}

func i_check_string_length(s) {
    if typeof(s) == "string" && len(s) > MAX_STRING_LENGTH {
        panic(f"string length limit ({MAX_STRING_LENGTH}) exceeded: got {len(s)}")
    }
}

func i_check_map_size(m) {
    if typeof(m) == "map" && len(m.keys()) > MAX_MAP_ENTRIES {
        panic(f"map entry limit ({MAX_MAP_ENTRIES}) exceeded")
    }
}
func i_str_repeat(s, n) {
    if typeof(n) != "int64" { panic("string repeat count must be int") }
    if n < 0 { return "" }
    if n == 0 { return "" }
    const result_len = len(s) * n
    if result_len > MAX_STRING_LENGTH {
        panic(f"string repetition would exceed limit: {result_len} > {MAX_STRING_LENGTH}")
    }
    let result = ""
    let i = 0
    while i < n {
        result = result + s
        i = i + 1
    }
    result
}

func i_mul_extended(left, right) {
    const lt = typeof(left)
    const rt = typeof(right)
    if lt == "string" && rt == "int64" { return i_str_repeat(left, right) }
    if lt == "int64" && rt == "string" { return i_str_repeat(right, left) }
    i_mul(left, right)
}

func i_add_extended(left, right) {
    if left == null { return right }
    if right == null { return left }
    const lt = typeof(left)
    const rt = typeof(right)
    if lt == "array" && rt == "array" {
        const result = left.concat(right)
        i_check_array_size(result)
        return result
    }
    if lt == "map" && rt == "map" {
        let result = {}
        for k in left.keys() { result[k] = left[k] }
        for k in right.keys() { result[k] = right[k] }
        return result
    }
    if lt == "float64" && rt == "int64" { return left + to_float64(right) }
    if lt == "int64" && rt == "float64" { return to_float64(left) + right }
    if lt == "string" { return left + i_display(right) }
    if rt == "string" { return i_display(left) + right }
    left + right
}

func i_sub_extended(left, right) {
    if left == null { return 0 - right }
    if right == null { return left }
    const lt = typeof(left)
    const rt = typeof(right)
    if lt == "float64" && rt == "int64" { return left - to_float64(right) }
    if lt == "int64" && rt == "float64" { return to_float64(left) - right }
    left - right
}

func i_div_extended(left, right) {
    if right == null || right == 0 || right == 0.0 {
        panic("division by zero")
    }
    const lt = typeof(left)
    const rt = typeof(right)
    if lt == "float64" && rt == "int64" { return left / to_float64(right) }
    if lt == "int64" && rt == "float64" { return to_float64(left) / right }
    left / right
}

func i_mod_extended(left, right) {
    if right == null || right == 0 { panic("modulo by zero") }
    left % right
}

func i_power(base, exp) {
    const bt = typeof(base)
    const et = typeof(exp)
    if et == "int64" && exp >= 0 {
        let result = 1
        let i = 0
        while i < exp {
            result = result * base
            i = i + 1
        }
        return result
    }
    power(to_float64(base), to_float64(exp))
}
func i_hof_map(arr, fn_val) {
    let result = []
    let idx = 0
    for item in arr {
        const r = i_call_any_safe(fn_val, [item, idx])
        result.push(r)
        idx = idx + 1
    }
    result
}

func i_hof_filter(arr, fn_val) {
    let result = []
    let idx = 0
    for item in arr {
        if i_truthy(i_call_any_safe(fn_val, [item, idx])) {
            result.push(item)
        }
        idx = idx + 1
    }
    result
}

func i_hof_reduce(arr, fn_val, initial) {
    let acc = initial
    let idx = 0
    for item in arr {
        acc = i_call_any_safe(fn_val, [acc, item, idx])
        idx = idx + 1
    }
    acc
}

func i_hof_reduce_no_init(arr, fn_val) {
    if len(arr) == 0 { panic("reduce on empty array without initial value") }
    let acc = arr[0]
    let idx = 1
    while idx < len(arr) {
        acc = i_call_any_safe(fn_val, [acc, arr[idx], idx])
        idx = idx + 1
    }
    acc
}

func i_call_any_safe(callable, args) {
    i_call_any(callable, args)
}

func i_hof_flat_map(arr, fn_val) {
    let result = []
    for item in arr {
        const mapped = i_call_any(fn_val, [item])
        if typeof(mapped) == "array" {
            for sub in mapped { result.push(sub) }
        } else {
            result.push(mapped)
        }
    }
    result
}

func i_hof_each(arr, fn_val) {
    let idx = 0
    for item in arr {
        i_call_any_safe(fn_val, [item, idx])
        idx = idx + 1
    }
    null
}

func i_hof_any(arr, fn_val) {
    for item in arr {
        if i_truthy(i_call_any(fn_val, [item])) { return true }
    }
    false
}

func i_hof_all(arr, fn_val) {
    for item in arr {
        if !i_truthy(i_call_any(fn_val, [item])) { return false }
    }
    true
}

func i_hof_find(arr, fn_val) {
    for item in arr {
        if i_truthy(i_call_any(fn_val, [item])) { return item }
    }
    null
}

func i_hof_find_index(arr, fn_val) {
    let idx = 0
    for item in arr {
        if i_truthy(i_call_any(fn_val, [item])) { return idx }
        idx = idx + 1
    }
    -1
}

func i_hof_sort_by(arr, fn_val) {
    let result = []
    for item in arr { result.push(item) }
    let i = 1
    while i < len(result) {
        const key = result[i]
        let j = i - 1
        while j >= 0 && i_truthy(i_call_any(fn_val, [result[j], key])) {
            result[j + 1] = result[j]
            j = j - 1
        }
        result[j + 1] = key
        i = i + 1
    }
    result
}

func i_hof_group_by(arr, fn_val) {
    let result = {}
    for item in arr {
        const key = i_display(i_call_any(fn_val, [item]))
        if !result.has(key) { result[key] = [] }
        let group = result[key]
        group.push(item)
        result[key] = group
    }
    result
}

func i_hof_partition(arr, fn_val) {
    let matches = []
    let non_matches = []
    for item in arr {
        if i_truthy(i_call_any(fn_val, [item])) {
            matches.push(item)
        } else {
            non_matches.push(item)
        }
    }
    [matches, non_matches]
}

func i_hof_scan(arr, fn_val, initial) {
    let acc = initial
    let result = [acc]
    for item in arr {
        acc = i_call_any(fn_val, [acc, item])
        result.push(acc)
    }
    result
}

func i_hof_take_while(arr, fn_val) {
    let result = []
    for item in arr {
        if !i_truthy(i_call_any(fn_val, [item])) { break }
        result.push(item)
    }
    result
}

func i_hof_skip_while(arr, fn_val) {
    let result = []
    let skipping = true
    for item in arr {
        if skipping && i_truthy(i_call_any(fn_val, [item])) { continue }
        skipping = false
        result.push(item)
    }
    result
}

func i_hof_min_by(arr, fn_val) {
    if len(arr) == 0 { return null }
    let best = arr[0]
    let best_key = i_call_any(fn_val, [best])
    let idx = 1
    while idx < len(arr) {
        const key = i_call_any(fn_val, [arr[idx]])
        if i_compare(key, best_key) < 0 {
            best = arr[idx]
            best_key = key
        }
        idx = idx + 1
    }
    best
}

func i_hof_max_by(arr, fn_val) {
    if len(arr) == 0 { return null }
    let best = arr[0]
    let best_key = i_call_any(fn_val, [best])
    let idx = 1
    while idx < len(arr) {
        const key = i_call_any(fn_val, [arr[idx]])
        if i_compare(key, best_key) > 0 {
            best = arr[idx]
            best_key = key
        }
        idx = idx + 1
    }
    best
}

func i_hof_chunk(arr, n) {
    if n <= 0 { panic("chunk size must be positive") }
    let result = []
    let i = 0
    while i < len(arr) {
        const end = if i + n > len(arr) { len(arr) } else { i + n }
        result.push(arr.slice(i, end))
        i = i + n
    }
    result
}

func i_hof_window(arr, n) {
    if n <= 0 { panic("window size must be positive") }
    let result = []
    let i = 0
    while i + n <= len(arr) {
        result.push(arr.slice(i, i + n))
        i = i + 1
    }
    result
}

func i_hof_unique(arr) {
    let result = []
    let seen = []
    for item in arr {
        if !seen.contains(item) {
            seen.push(item)
            result.push(item)
        }
    }
    result
}

func i_hof_unique_by(arr, fn_val) {
    let result = []
    let seen = []
    for item in arr {
        const key = i_call_any(fn_val, [item])
        if !seen.contains(key) {
            seen.push(key)
            result.push(item)
        }
    }
    result
}
func i_result_ok(value) {
    {"ok": value}
}

func i_result_err(msg) {
    {"err": msg}
}

func i_is_ok(val) {
    if typeof(val) != "map" { return false }
    val.has("ok")
}

func i_is_err(val) {
    if typeof(val) != "map" { return false }
    val.has("err")
}

func i_unwrap(val) {
    if val == null { panic("called unwrap on null value") }
    if typeof(val) == "map" {
        if val.has("ok") { return val["ok"] }
        if val.has("err") { panic(f"called unwrap on Err: {i_display(val[\"err\"])}") }
    }
    val
}

func i_unwrap_or(val, default_val) {
    if val == null { return default_val }
    if typeof(val) == "map" {
        if val.has("ok") { return val["ok"] }
        if val.has("err") { return default_val }
    }
    val
}

func i_unwrap_or_else(val, fn_val) {
    if val == null { return i_call_any(fn_val, []) }
    if typeof(val) == "map" {
        if val.has("ok") { return val["ok"] }
        if val.has("err") { return i_call_any(fn_val, [val["err"]]) }
    }
    val
}

func i_result_map(val, fn_val) {
    if typeof(val) == "map" {
        if val.has("ok") { return {"ok": i_call_any(fn_val, [val["ok"]])} }
        if val.has("err") { return val }
    }
    val
}

func i_result_map_err(val, fn_val) {
    if typeof(val) == "map" {
        if val.has("err") { return {"err": i_call_any(fn_val, [val["err"]])} }
        if val.has("ok") { return val }
    }
    val
}

func i_try_propagate(val) {
    if val == null { panic("try-propagate on null") }
    if typeof(val) == "map" {
        if val.has("err") {
            panic(f"propagated error: {i_display(val[\"err\"])}")
        }
        if val.has("ok") { return val["ok"] }
    }
    val
}
func i_null_safe_field(obj, field) {
    if obj == null { return null }
    if typeof(obj) != "map" { return null }
    if obj.has(field) { obj[field] } else { null }
}

func i_null_safe_index(obj, idx) {
    if obj == null { return null }
    const t = typeof(obj)
    if t == "array" {
        const i = if typeof(idx) == "int64" { idx } else { to_int64(idx) }
        const length = len(obj)
        const real_idx = if i < 0 { length + i } else { i }
        if real_idx < 0 || real_idx >= length { return null }
        return obj[real_idx]
    }
    if t == "map" {
        const key = if typeof(idx) == "string" { idx } else { to_string(idx) }
        if obj.has(key) { return obj[key] }
        return null
    }
    if t == "string" {
        const i = if typeof(idx) == "int64" { idx } else { to_int64(idx) }
        if i < 0 || i >= len(obj) { return null }
        return obj[i]
    }
    null
}

func i_null_safe_method(obj, method, args) {
    if obj == null { return null }
    eval_method_call_on(obj, method, args)
}

func i_null_coalesce_lazy(left, right_expr) {
    if left != null { return left }
    eval_expr(right_expr)
}
func i_string_pad_start(s, target_len, pad_char) {
    let result = s
    while len(result) < target_len {
        result = pad_char + result
    }
    result
}

func i_string_pad_end(s, target_len, pad_char) {
    let result = s
    while len(result) < target_len {
        result = result + pad_char
    }
    result
}

func i_string_center(s, width, fill_char) {
    const pad_total = width - len(s)
    if pad_total <= 0 { return s }
    const left_pad = pad_total / 2
    const right_pad = pad_total - left_pad
    let result = ""
    let i = 0
    while i < left_pad { result = result + fill_char; i = i + 1 }
    result = result + s
    i = 0
    while i < right_pad { result = result + fill_char; i = i + 1 }
    result
}

func i_string_count(s, substr) {
    if len(substr) == 0 { return len(s) + 1 }
    let count = 0
    let idx = 0
    while idx <= len(s) - len(substr) {
        if s.slice(idx, idx + len(substr)) == substr {
            count = count + 1
            idx = idx + len(substr)
        } else {
            idx = idx + 1
        }
    }
    count
}

func i_string_is_empty(s) { len(s) == 0 }
func i_string_is_blank(s) { len(s.trim()) == 0 }

func i_string_is_numeric(s) {
    if len(s) == 0 { return false }
    let i = 0
    let has_dot = false
    if s[0] == "-" || s[0] == "+" { i = 1 }
    if i >= len(s) { return false }
    while i < len(s) {
        const c = s[i]
        if c == "." {
            if has_dot { return false }
            has_dot = true
        } else if c < "0" || c > "9" {
            return false
        }
        i = i + 1
    }
    true
}

func i_string_is_alpha(s) {
    if len(s) == 0 { return false }
    let i = 0
    while i < len(s) {
        const c = s[i]
        const lower = c.to_lower()
        if lower < "a" || lower > "z" { return false }
        i = i + 1
    }
    true
}

func i_string_is_alphanumeric(s) {
    if len(s) == 0 { return false }
    let i = 0
    while i < len(s) {
        const c = s[i]
        const lower = c.to_lower()
        if (lower < "a" || lower > "z") && (c < "0" || c > "9") { return false }
        i = i + 1
    }
    true
}

func i_string_is_upper(s) {
    if len(s) == 0 { return false }
    s == s.to_upper()
}

func i_string_is_lower(s) {
    if len(s) == 0 { return false }
    s == s.to_lower()
}

func i_string_reverse(s) {
    const chars = s.chars()
    let result = ""
    let i = len(chars) - 1
    while i >= 0 {
        result = result + chars[i]
        i = i - 1
    }
    result
}

func i_string_truncate(s, max_len, suffix) {
    if len(s) <= max_len { return s }
    const cut = max_len - len(suffix)
    if cut <= 0 { return suffix.slice(0, max_len) }
    s.slice(0, cut) + suffix
}

func i_string_words(s) {
    const parts = s.split(" ")
    let result = []
    for p in parts {
        const trimmed = p.trim()
        if len(trimmed) > 0 { result.push(trimmed) }
    }
    result
}

func i_string_lines(s) {
    s.split("\n")
}

func i_string_char_code_at(s, idx) {
    if idx < 0 || idx >= len(s) { return -1 }
    const chars = s.chars()
    0
}

func i_string_to_camel_case(s) {
    const words = i_string_words(s.replace("_", " ").replace("-", " "))
    if len(words) == 0 { return "" }
    let result = words[0].to_lower()
    let i = 1
    while i < len(words) {
        const w = words[i]
        if len(w) > 0 {
            result = result + w[0].to_upper() + w.slice(1, len(w)).to_lower()
        }
        i = i + 1
    }
    result
}

func i_string_to_snake_case(s) {
    let result = ""
    let i = 0
    while i < len(s) {
        const c = s[i]
        if c >= "A" && c <= "Z" {
            if len(result) > 0 && result[len(result) - 1] != "_" {
                result = result + "_"
            }
            result = result + c.to_lower()
        } else if c == " " || c == "-" {
            if len(result) > 0 && result[len(result) - 1] != "_" {
                result = result + "_"
            }
        } else {
            result = result + c
        }
        i = i + 1
    }
    result
}

func i_string_to_kebab_case(s) {
    i_string_to_snake_case(s).replace("_", "-")
}

func i_string_to_pascal_case(s) {
    const words = i_string_words(s.replace("_", " ").replace("-", " "))
    let result = ""
    for w in words {
        if len(w) > 0 {
            result = result + w[0].to_upper() + w.slice(1, len(w)).to_lower()
        }
    }
    result
}

func i_string_to_title_case(s) {
    const words = s.split(" ")
    let result = []
    for w in words {
        if len(w) > 0 {
            result.push(w[0].to_upper() + w.slice(1, len(w)))
        } else {
            result.push(w)
        }
    }
    result.join(" ")
}

func i_string_repeat_n(s, n) {
    i_str_repeat(s, n)
}

func i_string_replace_all(s, old_str, new_str) {
    s.replace(old_str, new_str)
}

func i_string_replace_first(s, old_str, new_str) {
    const idx = s.index_of(old_str)
    if idx < 0 { return s }
    s.slice(0, idx) + new_str + s.slice(idx + len(old_str), len(s))
}
func i_map_merge(base, overlay) {
    let result = {}
    for k in base.keys() { result[k] = base[k] }
    for k in overlay.keys() { result[k] = overlay[k] }
    result
}

func i_map_filter(m, fn_val) {
    let result = {}
    for k in m.keys() {
        if i_truthy(i_call_any(fn_val, [k, m[k]])) {
            result[k] = m[k]
        }
    }
    result
}

func i_map_map_values(m, fn_val) {
    let result = {}
    for k in m.keys() {
        result[k] = i_call_any(fn_val, [m[k], k])
    }
    result
}

func i_map_map_keys(m, fn_val) {
    let result = {}
    for k in m.keys() {
        const new_key = i_display(i_call_any(fn_val, [k]))
        result[new_key] = m[k]
    }
    result
}

func i_map_entries(m) {
    let result = []
    for k in m.keys() {
        result.push([k, m[k]])
    }
    result
}

func i_map_from_entries(entries) {
    let result = {}
    for entry in entries {
        if typeof(entry) == "array" && len(entry) >= 2 {
            result[i_display(entry[0])] = entry[1]
        }
    }
    result
}

func i_map_get_or(m, key, default_val) {
    if typeof(m) == "map" && m.has(key) { m[key] } else { default_val }
}

func i_map_set_default(m, key, default_val) {
    if !m.has(key) { m[key] = default_val }
    m[key]
}

func i_map_invert(m) {
    let result = {}
    for k in m.keys() {
        result[i_display(m[k])] = k
    }
    result
}

func i_map_pick(m, keys_arr) {
    let result = {}
    for k in keys_arr {
        const key = if typeof(k) == "string" { k } else { to_string(k) }
        if m.has(key) { result[key] = m[key] }
    }
    result
}

func i_map_omit(m, keys_arr) {
    let result = {}
    for k in m.keys() {
        if !keys_arr.contains(k) { result[k] = m[k] }
    }
    result
}

func i_map_any(m, fn_val) {
    for k in m.keys() {
        if i_truthy(i_call_any(fn_val, [k, m[k]])) { return true }
    }
    false
}

func i_map_all(m, fn_val) {
    for k in m.keys() {
        if !i_truthy(i_call_any(fn_val, [k, m[k]])) { return false }
    }
    true
}

func i_map_count(m, fn_val) {
    let count = 0
    for k in m.keys() {
        if i_truthy(i_call_any(fn_val, [k, m[k]])) { count = count + 1 }
    }
    count
}
func eval_expr_checked(expr) {
    i_check_expr_depth()
    const result = eval_expr(expr)
    i_release_expr_depth()
    result
}
func eval_nested_destructure(pattern, val, mutable) {
    if typeof(pattern) != "map" {
        i_set(to_string(pattern), val, mutable)
        return null
    }
    if pattern.has("__array_destructure") {
        const elements = pattern["__elements"]
        let idx = 0
        for elem in elements {
            if typeof(elem) == "map" && elem.has("__rest") {
                const rest_name = elem["__name"]
                const remaining = if typeof(val) == "array" {
                    val.slice(idx, len(val))
                } else { [] }
                i_set(rest_name, remaining, mutable)
                break
            }
            const item_val = if typeof(val) == "array" && idx < len(val) { val[idx] } else { null }
            if typeof(elem) == "map" && elem.has("__nested") {
                eval_nested_destructure(elem["__pattern"], item_val, mutable)
            } else {
                const name = if typeof(elem) == "string" { elem } else { to_string(elem) }
                i_set(name, item_val, mutable)
            }
            idx = idx + 1
        }
        return null
    }
    if pattern.has("__map_destructure") {
        const entries = pattern["__entries"]
        for entry in entries {
            const key = entry[0]
            const alias = if len(entry) > 1 && entry[1] != null { entry[1] } else { key }
            const item_val = if typeof(val) == "map" && val.has(key) { val[key] } else { null }
            i_set(alias, item_val, mutable)
        }
        return null
    }
    i_set(to_string(pattern), val, mutable)
}

func eval_tuple_assign(names, val) {
    const items = if typeof(val) == "array" { val } else { [val] }
    let idx = 0
    for name in names {
        const v = if idx < len(items) { items[idx] } else { null }
        i_update(name, v)
        idx = idx + 1
    }
}
let i_modules = {}

func eval_module_block(name, body) {
    i_push_scope()
    const result = eval_block(body)
    i_pop_scope()
    i_modules[name] = true
}

func eval_use_stmt(path, alias, glob) {
    if typeof(path) == "array" {
        const full_path = path.join("::")
        if glob {
            const prefix = full_path + "::"
            let to_add = []
            for k in i_functions.keys() {
                if k.starts_with(prefix) {
                    const short = k.slice(len(prefix), len(k))
                    if !short.contains("::") {
                        to_add.push([short, i_functions[k]])
                    }
                }
            }
            for pair in to_add {
                i_functions[pair[0]] = pair[1]
            }
        } else {
            const item_name = path[len(path) - 1]
            const local_name = if alias != null { alias } else { item_name }
            if i_functions.has(full_path) {
                i_functions[local_name] = i_functions[full_path]
            }
        }
    }
    null
}
let i_deferred_stack = []

func i_add_defer(expr) {
    if len(i_deferred_stack) > 0 {
        let top = i_deferred_stack[len(i_deferred_stack) - 1]
        top.push(expr)
        i_deferred_stack[len(i_deferred_stack) - 1] = top
    }
}

func i_execute_deferred() {
    if len(i_deferred_stack) == 0 { return null }
    const defers = i_deferred_stack[len(i_deferred_stack) - 1]
    let i = len(defers) - 1
    while i >= 0 {
        eval_expr(defers[i])
        i = i - 1
    }
    null
}

func i_push_defer_scope() {
    i_deferred_stack.push([])
}

func i_pop_defer_scope() {
    i_execute_deferred()
    if len(i_deferred_stack) > 0 {
        i_deferred_stack.pop()
    }
}

func eval_c_style_for(init, cond, update, body) {
    i_push_scope()
    eval_stmt(init)
    let iterations = 0
    let result = null
    while true {
        i_check_iterations(iterations)
        const cond_val = eval_expr(cond)
        if !i_truthy(cond_val) { break }
        i_push_scope()
        const r = eval_block(body)
        i_pop_scope()
        if is_break(r) { result = signal_value(r); break }
        if is_continue(r) {
            eval_stmt(update)
            iterations = iterations + 1
            continue
        }
        if is_return(r) { i_pop_scope(); return r }
        result = r
        eval_stmt(update)
        iterations = iterations + 1
    }
    i_pop_scope()
    result
}
let i_impl_methods = {}
let i_type_aliases = {}
let i_async_fns = {}

func i_register_async_fn(name) {
    i_async_fns[name] = true
}

func i_is_async_fn(name) {
    i_async_fns.has(name)
}

func i_register_type_alias(alias, target) {
    i_type_aliases[alias] = target
}

func i_resolve_type_alias(name) {
    if i_type_aliases.has(name) { i_type_aliases[name] } else { name }
}

func eval_method_call_on(obj, method, args) {
    if typeof(obj) == "map" && obj.has("__struct") {
        const struct_name = obj["__struct"]
        const qualified = f"{struct_name}.{method}"
        if i_impl_methods.has(qualified) {
            const fn_info = i_impl_methods[qualified]
            const full_args = [obj].concat(args)
            return call_user_func(fn_info, full_args)
        }
        if i_functions.has(qualified) {
            const fn_info = i_functions[qualified]
            const full_args = [obj].concat(args)
            return call_user_func(fn_info, full_args)
        }
    }
    i_builtin_method(obj, method, args)
}

func i_eval_spawn_value(val) {
    {
        "__future": true,
        "__resolved": true,
        "__value": val,
    }
}
func i_type_convert(val, type_name) {
    match type_name {
        "int" | "int64" | "Int64" => {
            if typeof(val) == "int64" { return val }
            if typeof(val) == "float64" { return to_int64(val) }
            if typeof(val) == "string" { return parse_int(val) }
            if typeof(val) == "bool" { return if val { 1 } else { 0 } }
            0
        },
        "float" | "float64" | "Float64" => {
            if typeof(val) == "float64" { return val }
            if typeof(val) == "int64" { return to_float64(val) }
            if typeof(val) == "string" { return parse_float(val) }
            if typeof(val) == "bool" { return if val { 1.0 } else { 0.0 } }
            0.0
        },
        "string" | "String" => {
            i_display(val)
        },
        "bool" | "Bool" => {
            i_truthy(val)
        },
        "array" | "Array" => {
            if typeof(val) == "array" { return val }
            if typeof(val) == "string" { return val.chars() }
            [val]
        },
        _ => val,
    }
}

func i_type_check(val, type_name) {
    match type_name {
        "int" | "int64" | "Int64" => typeof(val) == "int64",
        "float" | "float64" | "Float64" => typeof(val) == "float64",
        "string" | "String" => typeof(val) == "string",
        "bool" | "Bool" => typeof(val) == "bool",
        "array" | "Array" => typeof(val) == "array",
        "map" | "Map" => typeof(val) == "map",
        "null" | "Null" => val == null,
        _ => {
            if typeof(val) == "map" && val.has("__struct") {
                return val["__struct"] == type_name
            }
            if typeof(val) == "map" && val.has("__enum") {
                return val["__enum"] == type_name
            }
            false
        },
    }
}
func eval_map_comp_expr(key_expr, val_expr, var_expr, iter_expr, cond_expr) {
    const iter_val = eval_expr(iter_expr)
    let result = {}
    const var_name = match var_expr.kind {
        ExprKind::EVariable(n) => n,
        _ => "_",
    }
    const items = if typeof(iter_val) == "array" { iter_val } else { i_iter_to_array(iter_val) }
    for item in items {
        i_push_scope()
        i_set(var_name, item, true)
        let include = true
        if cond_expr != null {
            include = i_truthy(eval_expr(cond_expr))
        }
        if include {
            const k = i_display(eval_expr(key_expr))
            const v = eval_expr(val_expr)
            result[k] = v
        }
        i_pop_scope()
    }
    result
}
func i_set_union(a, b) {
    let result = []
    for item in a { if !result.contains(item) { result.push(item) } }
    for item in b { if !result.contains(item) { result.push(item) } }
    result
}

func i_set_intersection(a, b) {
    let result = []
    for item in a {
        if b.contains(item) && !result.contains(item) { result.push(item) }
    }
    result
}

func i_set_difference(a, b) {
    let result = []
    for item in a {
        if !b.contains(item) { result.push(item) }
    }
    result
}

func i_set_symmetric_diff(a, b) {
    let result = []
    for item in a {
        if !b.contains(item) { result.push(item) }
    }
    for item in b {
        if !a.contains(item) && !result.contains(item) { result.push(item) }
    }
    result
}

func i_set_is_subset(a, b) {
    for item in a {
        if !b.contains(item) { return false }
    }
    true
}

func i_set_is_superset(a, b) {
    i_set_is_subset(b, a)
}
func i_bytes_to_string(bytes) {
    if typeof(bytes) == "string" { return bytes }
    if typeof(bytes) == "array" {
        let result = ""
        for b in bytes { result = result + to_string(b) }
        return result
    }
    to_string(bytes)
}

func i_string_to_bytes(s) {
    let result = []
    let i = 0
    while i < len(s) {
        result.push(s[i])
        i = i + 1
    }
    result
}
func i_math_sign(x) {
    if x > 0 { 1 } else if x < 0 { -1 } else { 0 }
}

func i_math_clamp(x, lo, hi) {
    if x < lo { lo } else if x > hi { hi } else { x }
}

func i_math_lerp(a, b, t) {
    a + (b - a) * t
}

func i_math_map_range(value, in_min, in_max, out_min, out_max) {
    if in_max == in_min { return out_min }
    out_min + (value - in_min) * (out_max - out_min) / (in_max - in_min)
}

func i_math_gcd(a, b) {
    let x = abs(a)
    let y = abs(b)
    while y != 0 {
        const temp = y
        y = x % y
        x = temp
    }
    x
}

func i_math_lcm(a, b) {
    if a == 0 || b == 0 { return 0 }
    abs(a * b) / i_math_gcd(a, b)
}

func i_math_is_prime(n) {
    if n < 2 { return false }
    if n < 4 { return true }
    if n % 2 == 0 || n % 3 == 0 { return false }
    let i = 5
    while i * i <= n {
        if n % i == 0 || n % (i + 2) == 0 { return false }
        i = i + 6
    }
    true
}

func i_math_factorial(n) {
    if n < 0 { panic("factorial of negative number") }
    if n <= 1 { return 1 }
    let result = 1
    let i = 2
    while i <= n {
        result = result * i
        i = i + 1
    }
    result
}

func i_math_fibonacci(n) {
    if n <= 0 { return 0 }
    if n == 1 { return 1 }
    let a = 0
    let b = 1
    let i = 2
    while i <= n {
        const temp = a + b
        a = b
        b = temp
        i = i + 1
    }
    b
}
func i_assert(val, msg) {
    if !i_truthy(val) {
        panic(if msg != null { msg } else { "assertion failed" })
    }
}

func i_assert_eq(left, right, msg) {
    if left != right {
        const default_msg = f"assertion failed: {i_display(left)} != {i_display(right)}"
        panic(if msg != null { msg } else { default_msg })
    }
}

func i_assert_ne(left, right, msg) {
    if left == right {
        const default_msg = f"assertion failed: values are equal: {i_display(left)}"
        panic(if msg != null { msg } else { default_msg })
    }
}

func i_assert_gt(left, right, msg) {
    if !(left > right) {
        const default_msg = f"assertion failed: {i_display(left)} is not > {i_display(right)}"
        panic(if msg != null { msg } else { default_msg })
    }
}

func i_assert_lt(left, right, msg) {
    if !(left < right) {
        const default_msg = f"assertion failed: {i_display(left)} is not < {i_display(right)}"
        panic(if msg != null { msg } else { default_msg })
    }
}

func i_assert_contains(haystack, needle, msg) {
    const ht = typeof(haystack)
    let found = false
    if ht == "array" { found = haystack.contains(needle) }
    else if ht == "string" { found = haystack.contains(needle) }
    else if ht == "map" { found = haystack.has(needle) }
    if !found {
        const default_msg = f"assertion failed: {i_display(haystack)} does not contain {i_display(needle)}"
        panic(if msg != null { msg } else { default_msg })
    }
}

func i_assert_type(val, expected_type, msg) {
    if !i_type_check(val, expected_type) {
        const default_msg = f"assertion failed: expected type {expected_type}, got {typeof(val)}"
        panic(if msg != null { msg } else { default_msg })
    }
}
func i_generator_new(fn_info) {
    {
        "__generator": true,
        "__fn": fn_info,
        "__started": false,
        "__done": false,
        "__yielded": [],
        "__index": 0,
    }
}

func i_generator_next(gen) {
    if gen["__done"] { return {"done": true, "value": null} }
    if !gen["__started"] {
        gen["__started"] = true
    }
    const idx = gen["__index"]
    if idx < len(gen["__yielded"]) {
        gen["__index"] = idx + 1
        return {"done": false, "value": gen["__yielded"][idx]}
    }
    gen["__done"] = true
    {"done": true, "value": null}
}

func i_generator_collect(gen) {
    let result = []
    while true {
        const item = i_generator_next(gen)
        if item["done"] { break }
        result.push(item["value"])
    }
    result
}
func i_glob_match(pattern, text) {
    const plen = len(pattern)
    const tlen = len(text)
    let pi = 0
    let ti = 0
    let star_pi = -1
    let star_ti = -1
    while ti < tlen {
        if pi < plen && (pattern[pi] == text[ti] || pattern[pi] == "?") {
            pi = pi + 1
            ti = ti + 1
        } else if pi < plen && pattern[pi] == "*" {
            star_pi = pi
            star_ti = ti
            pi = pi + 1
        } else if star_pi >= 0 {
            pi = star_pi + 1
            star_ti = star_ti + 1
            ti = star_ti
        } else {
            return false
        }
    }
    while pi < plen && pattern[pi] == "*" { pi = pi + 1 }
    pi == plen
}
func i_deep_clone(val) {
    if val == null { return null }
    const t = typeof(val)
    if t == "array" {
        let result = []
        for item in val { result.push(i_deep_clone(item)) }
        return result
    }
    if t == "map" {
        let result = {}
        for k in val.keys() {
            result[k] = i_deep_clone(val[k])
        }
        return result
    }
    val
}

func i_deep_equals(a, b) {
    if a == null && b == null { return true }
    if a == null || b == null { return false }
    const ta = typeof(a)
    const tb = typeof(b)
    if ta != tb { return false }
    if ta == "array" {
        if len(a) != len(b) { return false }
        let i = 0
        while i < len(a) {
            if !i_deep_equals(a[i], b[i]) { return false }
            i = i + 1
        }
        return true
    }
    if ta == "map" {
        const ka = a.keys()
        const kb = b.keys()
        if len(ka) != len(kb) { return false }
        for k in ka {
            if !b.has(k) { return false }
            if !i_deep_equals(a[k], b[k]) { return false }
        }
        return true
    }
    a == b
}

func i_deep_freeze(val) {
    if val == null { return null }
    if typeof(val) == "map" {
        let result = {}
        for k in val.keys() {
            result[k] = i_deep_freeze(val[k])
        }
        result["__frozen"] = true
        return result
    }
    if typeof(val) == "array" {
        return val.map(x => i_deep_freeze(x))
    }
    val
}

func i_is_frozen(val) {
    if typeof(val) == "map" && val.has("__frozen") { return val["__frozen"] }
    false
}
func i_json_serialize(val) {
    if val == null { return "null" }
    const t = typeof(val)
    if t == "bool" { return if val { "true" } else { "false" } }
    if t == "int64" { return to_string(val) }
    if t == "float64" { return to_string(val) }
    if t == "string" {
        let result = "\""
        let i = 0
        while i < len(val) {
            const c = val[i]
            if c == "\"" { result = result + "\\\"" }
            else if c == "\\" { result = result + "\\\\" }
            else if c == "\n" { result = result + "\\n" }
            else if c == "\r" { result = result + "\\r" }
            else if c == "\t" { result = result + "\\t" }
            else { result = result + c }
            i = i + 1
        }
        return result + "\""
    }
    if t == "array" {
        const parts = val.map(x => i_json_serialize(x))
        return "[" + parts.join(",") + "]"
    }
    if t == "map" {
        let parts = []
        for k in val.keys() {
            if k == "__s" { continue }
            parts.push(i_json_serialize(k) + ":" + i_json_serialize(val[k]))
        }
        return "{" + parts.join(",") + "}"
    }
    "null"
}

func i_json_serialize_pretty(val, indent) {
    if indent == null { indent = 0 }
    const pad = i_str_repeat("  ", indent)
    const inner_pad = i_str_repeat("  ", indent + 1)
    if val == null { return "null" }
    const t = typeof(val)
    if t == "bool" { return if val { "true" } else { "false" } }
    if t == "int64" || t == "float64" { return to_string(val) }
    if t == "string" { return i_json_serialize(val) }
    if t == "array" {
        if len(val) == 0 { return "[]" }
        let parts = []
        for item in val {
            parts.push(inner_pad + i_json_serialize_pretty(item, indent + 1))
        }
        return "[\n" + parts.join(",\n") + "\n" + pad + "]"
    }
    if t == "map" {
        let filtered_keys = []
        for k in val.keys() { if k != "__s" { filtered_keys.push(k) } }
        if len(filtered_keys) == 0 { return "{}" }
        let parts = []
        for k in filtered_keys {
            parts.push(inner_pad + i_json_serialize(k) + ": " + i_json_serialize_pretty(val[k], indent + 1))
        }
        return "{\n" + parts.join(",\n") + "\n" + pad + "}"
    }
    "null"
}
func i_promise_all(futures) {
    let results = []
    for f in futures {
        results.push(i_eval_await(f))
    }
    results
}

func i_promise_race(futures) {
    if len(futures) == 0 { return null }
    i_eval_await(futures[0])
}

func i_promise_any(futures) {
    let errors = []
    for f in futures {
        const result = i_eval_await(f)
        if typeof(result) != "map" || !result.has("err") {
            return result
        }
        errors.push(result)
    }
    {"err": "all promises rejected", "errors": errors}
}

func i_promise_all_settled(futures) {
    let results = []
    for f in futures {
        const val = i_eval_await(f)
        if typeof(val) == "map" && val.has("err") {
            results.push({"status": "rejected", "reason": val["err"]})
        } else {
            results.push({"status": "fulfilled", "value": val})
        }
    }
    results
}
func i_event_emitter_new() {
    {"__emitter": true, "__handlers": {}}
}

func i_event_on(emitter, event, handler) {
    if !emitter["__handlers"].has(event) {
        emitter["__handlers"][event] = []
    }
    let handlers = emitter["__handlers"][event]
    handlers.push(handler)
    emitter["__handlers"][event] = handlers
    emitter
}

func i_event_off(emitter, event, handler) {
    if !emitter["__handlers"].has(event) { return emitter }
    let handlers = emitter["__handlers"][event]
    emitter["__handlers"][event] = handlers.filter(h => h != handler)
    emitter
}

func i_event_emit(emitter, event, data) {
    if !emitter["__handlers"].has(event) { return null }
    const handlers = emitter["__handlers"][event]
    for h in handlers {
        i_call_any(h, [data])
    }
    null
}

func i_event_once(emitter, event, handler) {
    const wrapper = {
        "__closure": true,
        "__handler": handler,
        "__emitter": emitter,
        "__event": event,
    }
    i_event_on(emitter, event, wrapper)
}
func i_state_machine_new(initial_state, transitions) {
    {
        "__state_machine": true,
        "__state": initial_state,
        "__transitions": transitions,
        "__history": [initial_state],
    }
}

func i_state_machine_transition(sm, event) {
    const current = sm["__state"]
    const transitions = sm["__transitions"]
    const key = f"{current}:{event}"
    if transitions.has(key) {
        const new_state = transitions[key]
        sm["__state"] = new_state
        let hist = sm["__history"]
        hist.push(new_state)
        sm["__history"] = hist
        return new_state
    }
    null
}

func i_state_machine_current(sm) {
    sm["__state"]
}

func i_state_machine_history(sm) {
    sm["__history"]
}

func i_state_machine_can_transition(sm, event) {
    const key = f"{sm[\"__state\"]}:{event}"
    sm["__transitions"].has(key)
}
func i_observable_new(initial) {
    {
        "__observable": true,
        "__value": initial,
        "__subscribers": [],
    }
}

func i_observable_get(obs) {
    obs["__value"]
}

func i_observable_set(obs, new_val) {
    const old_val = obs["__value"]
    obs["__value"] = new_val
    for sub in obs["__subscribers"] {
        i_call_any(sub, [new_val, old_val])
    }
    new_val
}

func i_observable_subscribe(obs, handler) {
    let subs = obs["__subscribers"]
    subs.push(handler)
    obs["__subscribers"] = subs
    obs
}

func i_observable_unsubscribe(obs, handler) {
    obs["__subscribers"] = obs["__subscribers"].filter(h => h != handler)
    obs
}
func i_rate_limiter_new(max_calls, window_ms) {
    {
        "__rate_limiter": true,
        "__max": max_calls,
        "__window": window_ms,
        "__calls": [],
    }
}

func i_rate_limiter_allow(limiter) {
    const now = 0
    const calls = limiter["__calls"]
    let valid = calls.filter(c => now - c < limiter["__window"])
    if len(valid) >= limiter["__max"] {
        limiter["__calls"] = valid
        return false
    }
    valid.push(now)
    limiter["__calls"] = valid
    true
}

func i_throttle_new(fn_val, interval_ms) {
    {
        "__throttle": true,
        "__fn": fn_val,
        "__interval": interval_ms,
        "__last_call": 0,
    }
}

func i_debounce_new(fn_val, delay_ms) {
    {
        "__debounce": true,
        "__fn": fn_val,
        "__delay": delay_ms,
        "__pending": null,
    }
}
func i_retry(fn_val, max_retries, initial_delay_ms) {
    let attempts = 0
    let delay = initial_delay_ms
    while attempts <= max_retries {
        const result = i_call_any(fn_val, [])
        if typeof(result) != "map" || !result.has("err") {
            return result
        }
        attempts = attempts + 1
        if attempts > max_retries {
            return result
        }
        delay = delay * 2
    }
    {"err": "max retries exceeded"}
}
func i_circuit_breaker_new(threshold, reset_timeout) {
    {
        "__circuit_breaker": true,
        "__state": "closed",
        "__failure_count": 0,
        "__threshold": threshold,
        "__reset_timeout": reset_timeout,
        "__last_failure_time": 0,
    }
}

func i_circuit_breaker_call(cb, fn_val) {
    if cb["__state"] == "open" {
        return {"err": "circuit breaker is open"}
    }
    const result = i_call_any(fn_val, [])
    if typeof(result) == "map" && result.has("err") {
        cb["__failure_count"] = cb["__failure_count"] + 1
        if cb["__failure_count"] >= cb["__threshold"] {
            cb["__state"] = "open"
        }
        return result
    }
    cb["__failure_count"] = 0
    cb["__state"] = "closed"
    result
}

func i_circuit_breaker_reset(cb) {
    cb["__state"] = "closed"
    cb["__failure_count"] = 0
    cb
}
func i_validate_email(s) {
    if typeof(s) != "string" { return false }
    if len(s) == 0 { return false }
    const at_idx = s.index_of("@")
    if at_idx <= 0 { return false }
    if at_idx >= len(s) - 1 { return false }
    const domain = s.slice(at_idx + 1, len(s))
    const dot_idx = domain.index_of(".")
    if dot_idx <= 0 { return false }
    if dot_idx >= len(domain) - 1 { return false }
    true
}

func i_validate_url(s) {
    if typeof(s) != "string" { return false }
    if len(s) < 8 { return false }
    s.starts_with("http://") || s.starts_with("https://") ||
    s.starts_with("ws://") || s.starts_with("wss://")
}

func i_validate_ip_v4(s) {
    if typeof(s) != "string" { return false }
    const parts = s.split(".")
    if len(parts) != 4 { return false }
    for p in parts {
        if !i_string_is_numeric(p) { return false }
        const n = parse_int(p)
        if n < 0 || n > 255 { return false }
    }
    true
}

func i_validate_range(val, min_val, max_val) {
    val >= min_val && val <= max_val
}

func i_validate_length(s, min_len, max_len) {
    const l = len(s)
    l >= min_len && l <= max_len
}

func i_validate_not_empty(val) {
    if val == null { return false }
    if typeof(val) == "string" { return len(val) > 0 }
    if typeof(val) == "array" { return len(val) > 0 }
    if typeof(val) == "map" { return len(val.keys()) > 0 }
    true
}

func i_validate_matches(s, pattern) {
    i_glob_match(pattern, s)
}
func i_pipe_value(val, fns) {
    let result = val
    for fn_val in fns {
        result = i_call_any(fn_val, [result])
    }
    result
}

func i_compose_fns(fns) {
    {
        "__composed": true,
        "__fns": fns,
    }
}

func i_call_composed(composed, args) {
    const fns = composed["__fns"]
    if len(fns) == 0 { return if len(args) > 0 { args[0] } else { null } }
    let result = i_call_any(fns[len(fns) - 1], args)
    let i = len(fns) - 2
    while i >= 0 {
        result = i_call_any(fns[i], [result])
        i = i - 1
    }
    result
}
func i_template_render(template, context) {
    let result = template
    if typeof(context) != "map" { return result }
    for k in context.keys() {
        if k == "__s" { continue }
        const placeholder = "{{" + k + "}}"
        result = result.replace(placeholder, i_display(context[k]))
    }
    result
}
func eval_try_catch(try_body, catch_var, catch_body) {
    let result = null
    let error = null

    const try_result = eval_try_body(try_body)
    if try_result != null && typeof(try_result) == "map" && try_result.has("__error") {
        error = try_result["__error"]
        if catch_var != null {
            i_push_scope()
            i_set(catch_var, error, false)
            result = eval_block(catch_body)
            i_pop_scope()
        } else {
            result = eval_block(catch_body)
        }
    } else {
        result = try_result
    }

    result
}

func eval_try_body(body) {
    i_push_scope()
    let result = null
    if typeof(body) == "array" {
        for stmt in body {
            result = eval_stmt(stmt)
            if is_signal(result) { break }
        }
    } else {
        result = eval_expr(body)
    }
    i_pop_scope()
    result
}

func eval_multi_return_error(call_expr) {
    const result = eval_try_body(call_expr)
    if result != null && typeof(result) == "map" && result.has("__error") {
        [null, result["__error"]]
    } else {
        [result, null]
    }
}

func wrap_error(message, cause) {
    const err = {"__error": true, "message": message}
    if cause != null { err["cause"] = cause }
    err
}

func unwrap_error(err) {
    if err != null && typeof(err) == "map" && err.has("__error") {
        err["message"]
    } else {
        null
    }
}
func eval_inline_asm(asm_block) {
    if asm_block == null { return null }

    const template = if typeof(asm_block) == "map" && asm_block.has("template") {
        asm_block["template"]
    } else if typeof(asm_block) == "string" {
        asm_block
    } else {
        return null
    }

    const inputs = if typeof(asm_block) == "map" && asm_block.has("inputs") {
        asm_block["inputs"]
    } else {
        []
    }

    const outputs = if typeof(asm_block) == "map" && asm_block.has("outputs") {
        asm_block["outputs"]
    } else {
        []
    }

    if template.contains("nop") { return null }
    if template.contains("mov") {
        if len(inputs) > 0 { return inputs[0] }
        return 0
    }
    if template.contains("add") {
        if len(inputs) >= 2 { return inputs[0] + inputs[1] }
        return 0
    }
    if template.contains("sub") {
        if len(inputs) >= 2 { return inputs[0] - inputs[1] }
        return 0
    }
    if template.contains("mul") || template.contains("imul") {
        if len(inputs) >= 2 { return inputs[0] * inputs[1] }
        return 0
    }
    if template.contains("rdtsc") || template.contains("rdtscp") {
        return 0
    }
    if template.contains("cpuid") {
        return {"eax": 0, "ebx": 0, "ecx": 0, "edx": 0}
    }
    if template.contains("syscall") {
        return 0
    }
    if template.contains("int") {
        return null
    }

    null
}
func eval_unsafe_block(body) {
    i_push_scope()
    i_set("__unsafe", true, false)

    let result = null
    if typeof(body) == "array" {
        for stmt in body {
            result = eval_stmt(stmt)
            if is_signal(result) { break }
        }
    } else {
        result = eval_expr(body)
    }

    i_pop_scope()

    if is_return(result) { return result }
    if is_break(result) { return result }
    result
}

func is_unsafe_context() {
    let idx = len(i_scopes) - 1
    while idx >= 0 {
        if i_scopes[idx].has("__unsafe") { return true }
        idx = idx - 1
    }
    false
}

func eval_raw_ptr_deref(ptr) {
    if !is_unsafe_context() {
        panic("raw pointer dereference requires unsafe block")
    }
    if typeof(ptr) == "map" && ptr.has("__ptr") {
        const addr = ptr["__ptr"]
        i_heap_get(addr)
    } else {
        ptr
    }
}

func eval_raw_ptr_write(ptr, value) {
    if !is_unsafe_context() {
        panic("raw pointer write requires unsafe block")
    }
    if typeof(ptr) == "map" && ptr.has("__ptr") {
        const addr = ptr["__ptr"]
        i_heap_set(addr, value)
    }
    null
}

func eval_raw_ptr_offset(ptr, offset) {
    if !is_unsafe_context() {
        panic("pointer arithmetic requires unsafe block")
    }
    if typeof(ptr) == "map" && ptr.has("__ptr") {
        {"__ptr": ptr["__ptr"] + offset, "__type": "raw_ptr"}
    } else {
        ptr
    }
}
func eval_move_closure(params, body) {
    let captured = i_new_scope()
    for scope in i_scopes {
        for k in scope.keys() {
            if k == "__s" { continue }
            const entry = scope[k]
            captured[k] = {"value": deep_copy(entry["value"]), "mutable": entry["mutable"]}
        }
    }
    {"__lambda": true, "__move": true, "params": params, "body": body, "captured": captured}
}

func deep_copy(val) {
    if val == null { return null }
    const t = typeof(val)
    if t == "int64" || t == "float64" || t == "string" || t == "bool" { return val }
    if t == "array" {
        return val.map(v => deep_copy(v))
    }
    if t == "map" {
        let result = {"__s": true}
        for k in val.keys() {
            result[k] = deep_copy(val[k])
        }
        return result
    }
    val
}
func eval_dyn_trait(value, trait_name) {
    const vtable = build_vtable(value, trait_name)
    {
        "__dyn": true,
        "__trait": trait_name,
        "__value": value,
        "__vtable": vtable,
    }
}

func build_vtable(value, trait_name) {
    let vtable = {"__s": true}

    const type_name = if typeof(value) == "map" && value.has("__struct") {
        value["__struct"]
    } else {
        typeof(value)
    }

    let idx = len(i_scopes) - 1
    while idx >= 0 {
        const scope = i_scopes[idx]
        for k in scope.keys() {
            if k == "__s" { continue }
            if k.starts_with(type_name + ".") {
                const method_name = k.slice(len(type_name) + 1)
                vtable[method_name] = scope[k]["value"]
            }
        }
        idx = idx - 1
    }

    vtable
}

func eval_dyn_dispatch(dyn_obj, method_name, args) {
    if !dyn_obj.has("__vtable") {
        panic(f"not a dyn trait object")
    }
    const vtable = dyn_obj["__vtable"]
    if !vtable.has(method_name) {
        panic(f"method '{method_name}' not found in dyn {dyn_obj[\"__trait\"]}")
    }
    const method = vtable[method_name]
    let full_args = [dyn_obj["__value"]]
    for a in args { full_args.push(a) }
    i_call_any(method, full_args)
}
func eval_ref(value) {
    const addr = i_heap_alloc(value)
    {"__ref": true, "__addr": addr, "__mutable": false}
}

func eval_ref_mut(value) {
    const addr = i_heap_alloc(value)
    {"__ref": true, "__addr": addr, "__mutable": true}
}

func eval_deref(ref_val) {
    if typeof(ref_val) != "map" || !ref_val.has("__ref") {
        return ref_val
    }
    i_heap_get(ref_val["__addr"])
}

func eval_ref_assign(ref_val, new_value) {
    if typeof(ref_val) != "map" || !ref_val.has("__ref") {
        panic("cannot assign through non-reference")
    }
    if !ref_val["__mutable"] {
        panic("cannot assign through immutable reference")
    }
    i_heap_set(ref_val["__addr"], new_value)
}

let i_heap_store = {"__s": true}
let i_heap_next_addr = 1000

func i_heap_alloc(value) {
    const addr = i_heap_next_addr
    i_heap_next_addr = i_heap_next_addr + 1
    i_heap_store[to_string(addr)] = value
    addr
}

func i_heap_get(addr) {
    const key = to_string(addr)
    if i_heap_store.has(key) { i_heap_store[key] } else { null }
}

func i_heap_set(addr, value) {
    i_heap_store[to_string(addr)] = value
}

func i_heap_free(addr) {
    const key = to_string(addr)
    if i_heap_store.has(key) { i_heap_store.remove(key) }
}
let i_sandbox_enabled = false

func i_enable_sandbox() {
    i_sandbox_enabled = true
}

func i_disable_sandbox() {
    i_sandbox_enabled = false
}

func sandbox_check(operation) {
    if !i_sandbox_enabled { return true }

    const blocked_ops = [
        "fs_read", "fs_write", "fs_delete", "fs_mkdir", "fs_rmdir",
        "fs_rename", "fs_copy", "fs_stat", "fs_exists", "fs_read_dir",
        "fs_read_file", "fs_write_file", "fs_append_file",
        "fs_read_to_string", "read_file", "write_file",
        "net_listen", "net_dial", "net_connect", "net_bind",
        "http_get", "http_post", "http_put", "http_delete",
        "http_request", "http_serve", "http_fetch",
        "tcp_connect", "tcp_listen", "udp_bind", "udp_send",
        "websocket_connect", "websocket_listen",
        "process_exec", "process_spawn", "process_kill",
        "process_exit", "exec", "spawn", "shell",
        "command_run", "run_command",
        "env_get", "env_set", "env_vars",
        "get_env", "set_env",
        "system_info", "hostname", "username",
    ]

    if blocked_ops.contains(operation) {
        panic(f"operation '{operation}' is not allowed in sandbox mode")
    }
    true
}

func sandbox_call(name, args) {
    sandbox_check(name)
    i_call_builtin(name, args)
}
let i_timeout_ms = 0
let i_exec_start_time = 0
let i_step_count = 0
let i_step_check_interval = 10000

func i_set_timeout(ms) {
    i_timeout_ms = ms
    i_exec_start_time = timestamp_ms()
    i_step_count = 0
}

func i_clear_timeout() {
    i_timeout_ms = 0
}

func i_check_timeout() {
    if i_timeout_ms <= 0 { return }
    i_step_count = i_step_count + 1
    if i_step_count % i_step_check_interval != 0 { return }

    const now = timestamp_ms()
    const elapsed = now - i_exec_start_time
    if elapsed > i_timeout_ms {
        panic(f"execution timeout: exceeded {i_timeout_ms}ms (ran for {elapsed}ms)")
    }
}

func timestamp_ms() {
    0
}
let i_memory_limit = 0
let i_memory_used = 0

func i_set_memory_limit(bytes) {
    i_memory_limit = bytes
}

func i_sizeof(val) {
    if val == null { return 8 }
    const t = typeof(val)
    if t == "int64" { return 8 }
    if t == "float64" { return 8 }
    if t == "bool" { return 1 }
    if t == "string" { return 24 + len(val) }
    if t == "array" {
        let size = 24
        for item in val {
            size = size + i_sizeof(item)
        }
        return size
    }
    if t == "map" {
        let size = 48
        for k in val.keys() {
            size = size + i_sizeof(k) + i_sizeof(val[k]) + 16
        }
        return size
    }
    16
}

func i_track_alloc(size) {
    i_memory_used = i_memory_used + size
    if i_memory_limit > 0 && i_memory_used > i_memory_limit {
        panic(f"memory limit exceeded: {i_memory_used} bytes > {i_memory_limit} bytes")
    }
}

func i_track_dealloc(size) {
    i_memory_used = i_memory_used - size
    if i_memory_used < 0 { i_memory_used = 0 }
}

func i_memory_stats() {
    {
        "used": i_memory_used,
        "limit": i_memory_limit,
        "heap_objects": len(i_heap_store.keys()) - 1,
        "scope_depth": len(i_scopes),
    }
}
func i_format_number(value, format_spec) {
    if format_spec == null || format_spec == "" { return i_display(value) }

    const t = typeof(value)

    let spec = parse_format_spec(format_spec)

    let formatted = ""

    match spec["type"] {
        "d" => {
            formatted = to_string(to_int64(value))
        },
        "x" => {
            const n = to_int64(value)
            formatted = int_to_hex_str(n, false)
            if spec["alt"] { formatted = "0x" + formatted }
        },
        "X" => {
            const n = to_int64(value)
            formatted = int_to_hex_str(n, true)
            if spec["alt"] { formatted = "0X" + formatted }
        },
        "b" => {
            const n = to_int64(value)
            formatted = int_to_binary_str(n)
            if spec["alt"] { formatted = "0b" + formatted }
        },
        "o" => {
            const n = to_int64(value)
            formatted = int_to_octal_str(n)
            if spec["alt"] { formatted = "0o" + formatted }
        },
        "e" | "E" => {
            const f = to_float64(value)
            const prec = if spec["precision"] >= 0 { spec["precision"] } else { 6 }
            formatted = float_to_scientific(f, prec, spec["type"] == "E")
        },
        "f" | "F" => {
            const f = to_float64(value)
            const prec = if spec["precision"] >= 0 { spec["precision"] } else { 6 }
            formatted = float_to_fixed(f, prec)
        },
        "%" => {
            const f = to_float64(value) * 100.0
            const prec = if spec["precision"] >= 0 { spec["precision"] } else { 2 }
            formatted = float_to_fixed(f, prec) + "%"
        },
        _ => {
            formatted = i_display(value)
        },
    }

    if spec["sign"] == "+" && !formatted.starts_with("-") {
        formatted = "+" + formatted
    } else if spec["sign"] == " " && !formatted.starts_with("-") {
        formatted = " " + formatted
    }

    apply_width_align(formatted, spec)
}

func parse_format_spec(spec) {
    let result = {
        "fill": " ",
        "align": ">",
        "sign": "-",
        "alt": false,
        "zero": false,
        "width": 0,
        "precision": -1,
        "type": "",
    }

    if len(spec) == 0 { return result }

    let i = 0

    if len(spec) >= 2 {
        const second = spec[1]
        if second == "<" || second == ">" || second == "^" {
            result["fill"] = spec[0]
            result["align"] = second
            i = 2
        }
    }
    if i == 0 && len(spec) >= 1 {
        const first = spec[0]
        if first == "<" || first == ">" || first == "^" {
            result["align"] = first
            i = 1
        }
    }

    if i < len(spec) && (spec[i] == "+" || spec[i] == "-" || spec[i] == " ") {
        result["sign"] = spec[i]
        i = i + 1
    }

    if i < len(spec) && spec[i] == "#" {
        result["alt"] = true
        i = i + 1
    }

    if i < len(spec) && spec[i] == "0" {
        result["zero"] = true
        result["fill"] = "0"
        result["align"] = "="
        i = i + 1
    }

    let width_str = ""
    while i < len(spec) && spec[i] >= "0" && spec[i] <= "9" {
        width_str = width_str + spec[i]
        i = i + 1
    }
    if len(width_str) > 0 { result["width"] = to_int64(width_str) }

    if i < len(spec) && spec[i] == "." {
        i = i + 1
        let prec_str = ""
        while i < len(spec) && spec[i] >= "0" && spec[i] <= "9" {
            prec_str = prec_str + spec[i]
            i = i + 1
        }
        if len(prec_str) > 0 { result["precision"] = to_int64(prec_str) }
    }

    if i < len(spec) {
        result["type"] = spec[i]
    }

    result
}

func int_to_hex_str(n, upper) {
    if n == 0 { return "0" }
    const chars = if upper { "0123456789ABCDEF" } else { "0123456789abcdef" }
    let result = ""
    let v = if n < 0 { 0 - n } else { n }
    while v > 0 {
        result = chars[v % 16] + result
        v = v / 16
    }
    if n < 0 { "-" + result } else { result }
}

func int_to_binary_str(n) {
    if n == 0 { return "0" }
    let result = ""
    let v = if n < 0 { 0 - n } else { n }
    while v > 0 {
        result = to_string(v % 2) + result
        v = v / 2
    }
    if n < 0 { "-" + result } else { result }
}

func int_to_octal_str(n) {
    if n == 0 { return "0" }
    let result = ""
    let v = if n < 0 { 0 - n } else { n }
    while v > 0 {
        result = to_string(v % 8) + result
        v = v / 8
    }
    if n < 0 { "-" + result } else { result }
}

func float_to_scientific(f, precision, upper) {
    if f == 0.0 { return "0." + "0".repeat(precision) + (if upper { "E+00" } else { "e+00" }) }
    let v = if f < 0.0 { 0.0 - f } else { f }
    let exp = 0
    while v >= 10.0 { v = v / 10.0; exp = exp + 1 }
    while v < 1.0 && v > 0.0 { v = v * 10.0; exp = exp - 1 }
    const mantissa = float_to_fixed(v, precision)
    const e_char = if upper { "E" } else { "e" }
    const sign = if exp >= 0 { "+" } else { "-" }
    const abs_exp = if exp < 0 { 0 - exp } else { exp }
    const exp_str = if abs_exp < 10 { "0" + to_string(abs_exp) } else { to_string(abs_exp) }
    const result = mantissa + e_char + sign + exp_str
    if f < 0.0 { "-" + result } else { result }
}

func float_to_fixed(f, precision) {
    if precision == 0 { return to_string(to_int64(round(f))) }
    let s = to_string(f)
    const dot_idx = s.index_of(".")
    if dot_idx == null || dot_idx < 0 {
        s = s + "." + "0".repeat(precision)
    } else {
        const current_prec = len(s) - dot_idx - 1
        if current_prec < precision {
            s = s + "0".repeat(precision - current_prec)
        } else if current_prec > precision {
            s = s.slice(0, dot_idx + 1 + precision)
        }
    }
    s
}

func apply_width_align(s, spec) {
    const width = spec["width"]
    if width <= 0 || len(s) >= width { return s }
    const padding = width - len(s)
    const fill = spec["fill"]
    match spec["align"] {
        "<" => s + fill.repeat(padding),
        ">" | "=" => fill.repeat(padding) + s,
        "^" => {
            const left = padding / 2
            const right = padding - left
            fill.repeat(left) + s + fill.repeat(right)
        },
        _ => fill.repeat(padding) + s,
    }
}
func i_regex_dispatch(op, args) {
    match op {
        "regex_new" | "new_regex" => {
            if len(args) == 0 { panic("regex_new requires a pattern") }
            const pattern = to_string(args[0])
            const flags = if len(args) > 1 { to_string(args[1]) } else { "" }
            {"__regex": true, "pattern": pattern, "flags": flags}
        },
        "regex_match" | "is_match" => {
            if len(args) < 2 { panic("regex_match requires (regex, string)") }
            const re = args[0]
            const s = to_string(args[1])
            i_regex_is_match(re, s)
        },
        "regex_find" | "find_match" => {
            if len(args) < 2 { panic("regex_find requires (regex, string)") }
            i_regex_find(args[0], to_string(args[1]))
        },
        "regex_find_all" | "find_all_matches" => {
            if len(args) < 2 { return [] }
            i_regex_find_all(args[0], to_string(args[1]))
        },
        "regex_replace" | "replace_match" => {
            if len(args) < 3 { panic("regex_replace requires (regex, string, replacement)") }
            i_regex_replace(args[0], to_string(args[1]), to_string(args[2]))
        },
        "regex_replace_all" | "replace_all_matches" => {
            if len(args) < 3 { return to_string(args[1]) }
            i_regex_replace_all(args[0], to_string(args[1]), to_string(args[2]))
        },
        "regex_split" => {
            if len(args) < 2 { return [to_string(args[0])] }
            i_regex_split(args[0], to_string(args[1]))
        },
        "regex_captures" => {
            if len(args) < 2 { return [] }
            i_regex_captures(args[0], to_string(args[1]))
        },
        _ => null,
    }
}

func i_regex_is_match(re, s) {
    const pattern = if typeof(re) == "map" && re.has("pattern") { re["pattern"] } else { to_string(re) }
    s.contains(pattern)
}

func i_regex_find(re, s) {
    const pattern = if typeof(re) == "map" && re.has("pattern") { re["pattern"] } else { to_string(re) }
    const idx = s.index_of(pattern)
    if idx != null && idx >= 0 {
        {"start": idx, "end": idx + len(pattern), "text": pattern}
    } else {
        null
    }
}

func i_regex_find_all(re, s) {
    const pattern = if typeof(re) == "map" && re.has("pattern") { re["pattern"] } else { to_string(re) }
    let results = []
    let start = 0
    while start < len(s) {
        const idx = s.slice(start).index_of(pattern)
        if idx == null || idx < 0 { break }
        const abs_idx = start + idx
        results.push({"start": abs_idx, "end": abs_idx + len(pattern), "text": pattern})
        start = abs_idx + len(pattern)
    }
    results
}

func i_regex_replace(re, s, replacement) {
    const pattern = if typeof(re) == "map" && re.has("pattern") { re["pattern"] } else { to_string(re) }
    const idx = s.index_of(pattern)
    if idx != null && idx >= 0 {
        s.slice(0, idx) + replacement + s.slice(idx + len(pattern))
    } else {
        s
    }
}

func i_regex_replace_all(re, s, replacement) {
    const pattern = if typeof(re) == "map" && re.has("pattern") { re["pattern"] } else { to_string(re) }
    s.replace(pattern, replacement)
}

func i_regex_split(re, s) {
    const pattern = if typeof(re) == "map" && re.has("pattern") { re["pattern"] } else { to_string(re) }
    s.split(pattern)
}

func i_regex_captures(re, s) {
    const m = i_regex_find(re, s)
    if m != null { [m["text"]] } else { [] }
}
func eval_template_literal(parts) {
    let result = ""
    for part in parts {
        if typeof(part) == "string" {
            result = result + part
        } else if typeof(part) == "map" && part.has("expr") {
            const val = eval_expr(part["expr"])
            if part.has("format") {
                result = result + i_format_number(val, part["format"])
            } else {
                result = result + i_display(val)
            }
        } else {
            result = result + i_display(eval_expr(part))
        }
    }
    result
}

func eval_tagged_template(tag, strings, values) {
    const tag_fn = eval_expr(tag)
    let string_vals = strings.map(s => s)
    let expr_vals = values.map(v => eval_expr(v))
    i_call_any(tag_fn, [string_vals, expr_vals])
}
func eval_proxy_create(target, handler) {
    {
        "__proxy": true,
        "__target": target,
        "__handler": handler,
    }
}

func eval_proxy_get(proxy, prop) {
    const handler = proxy["__handler"]
    const target = proxy["__target"]

    if handler.has("get") {
        const get_fn = handler["get"]
        i_call_any(get_fn, [target, prop, proxy])
    } else {
        if typeof(target) == "map" && target.has(prop) {
            target[prop]
        } else {
            null
        }
    }
}

func eval_proxy_set(proxy, prop, value) {
    const handler = proxy["__handler"]
    const target = proxy["__target"]

    if handler.has("set") {
        const set_fn = handler["set"]
        i_call_any(set_fn, [target, prop, value, proxy])
    } else {
        if typeof(target) == "map" {
            target[prop] = value
        }
    }
    true
}

func eval_proxy_has(proxy, prop) {
    const handler = proxy["__handler"]
    const target = proxy["__target"]

    if handler.has("has") {
        const has_fn = handler["has"]
        i_call_any(has_fn, [target, prop])
    } else {
        typeof(target) == "map" && target.has(prop)
    }
}

func eval_proxy_delete(proxy, prop) {
    const handler = proxy["__handler"]
    const target = proxy["__target"]

    if handler.has("deleteProperty") {
        const del_fn = handler["deleteProperty"]
        i_call_any(del_fn, [target, prop])
    } else {
        if typeof(target) == "map" && target.has(prop) {
            target.remove(prop)
        }
    }
    true
}

func eval_proxy_apply(proxy, this_arg, args) {
    const handler = proxy["__handler"]
    const target = proxy["__target"]

    if handler.has("apply") {
        const apply_fn = handler["apply"]
        i_call_any(apply_fn, [target, this_arg, args])
    } else {
        i_call_any(target, args)
    }
}
func eval_weak_ref_create(target) {
    const id = i_heap_alloc(target)
    {"__weakref": true, "__id": id, "__alive": true}
}

func eval_weak_ref_deref(weak) {
    if !weak.has("__weakref") || !weak["__alive"] { return null }
    const val = i_heap_get(weak["__id"])
    val
}

func eval_weak_map_new() {
    {"__weakmap": true, "__entries": {"__s": true}, "__size": 0}
}

func eval_weak_map_set(wm, key, value) {
    if typeof(key) != "map" { panic("WeakMap keys must be objects") }
    const key_id = if key.has("__heap_id") { key["__heap_id"] } else {
        const id = i_heap_alloc(key)
        key["__heap_id"] = id
        id
    }
    wm["__entries"][to_string(key_id)] = value
    wm["__size"] = wm["__size"] + 1
    wm
}

func eval_weak_map_get(wm, key) {
    if typeof(key) != "map" || !key.has("__heap_id") { return null }
    const key_id = to_string(key["__heap_id"])
    if wm["__entries"].has(key_id) { wm["__entries"][key_id] } else { null }
}

func eval_weak_map_has(wm, key) {
    if typeof(key) != "map" || !key.has("__heap_id") { return false }
    wm["__entries"].has(to_string(key["__heap_id"]))
}

func eval_weak_map_delete(wm, key) {
    if typeof(key) != "map" || !key.has("__heap_id") { return false }
    const key_id = to_string(key["__heap_id"])
    if wm["__entries"].has(key_id) {
        wm["__entries"].remove(key_id)
        wm["__size"] = wm["__size"] - 1
        true
    } else {
        false
    }
}

func eval_weak_set_new() {
    {"__weakset": true, "__entries": {"__s": true}, "__size": 0}
}

func eval_weak_set_add(ws, value) {
    if typeof(value) != "map" { panic("WeakSet values must be objects") }
    const id = if value.has("__heap_id") { value["__heap_id"] } else {
        const new_id = i_heap_alloc(value)
        value["__heap_id"] = new_id
        new_id
    }
    ws["__entries"][to_string(id)] = true
    ws["__size"] = ws["__size"] + 1
    ws
}

func eval_weak_set_has(ws, value) {
    if typeof(value) != "map" || !value.has("__heap_id") { return false }
    ws["__entries"].has(to_string(value["__heap_id"]))
}

func eval_weak_set_delete(ws, value) {
    if typeof(value) != "map" || !value.has("__heap_id") { return false }
    const id = to_string(value["__heap_id"])
    if ws["__entries"].has(id) {
        ws["__entries"].remove(id)
        ws["__size"] = ws["__size"] - 1
        true
    } else {
        false
    }
}
let i_symbol_counter = 0
let i_symbol_registry = {"__s": true}

func eval_symbol_create(description) {
    i_symbol_counter = i_symbol_counter + 1
    {
        "__symbol": true,
        "__id": i_symbol_counter,
        "__description": if description != null { to_string(description) } else { "" },
    }
}

func eval_symbol_for(key) {
    const k = to_string(key)
    if i_symbol_registry.has(k) { return i_symbol_registry[k] }
    const sym = eval_symbol_create(k)
    i_symbol_registry[k] = sym
    sym
}

func eval_symbol_key_for(sym) {
    if typeof(sym) != "map" || !sym.has("__symbol") { return null }
    for k in i_symbol_registry.keys() {
        if k == "__s" { continue }
        if i_symbol_registry[k]["__id"] == sym["__id"] { return k }
    }
    null
}

func eval_symbol_iterator() { eval_symbol_for("Symbol.iterator") }
func eval_symbol_async_iterator() { eval_symbol_for("Symbol.asyncIterator") }
func eval_symbol_to_string_tag() { eval_symbol_for("Symbol.toStringTag") }
func eval_symbol_has_instance() { eval_symbol_for("Symbol.hasInstance") }
func eval_symbol_toPrimitive() { eval_symbol_for("Symbol.toPrimitive") }
func eval_async_iterator_create(iterable) {
    {
        "__async_iter": true,
        "__source": iterable,
        "__index": 0,
        "__done": false,
        "__buffer": [],
    }
}

func eval_async_iter_next(iter) {
    if iter["__done"] { return {"value": null, "done": true} }

    const source = iter["__source"]
    const idx = iter["__index"]

    if typeof(source) == "array" {
        if idx >= len(source) {
            iter["__done"] = true
            return {"value": null, "done": true}
        }
        iter["__index"] = idx + 1
        return {"value": source[idx], "done": false}
    }

    if typeof(source) == "map" && source.has("__channel") {
        const val = i_channel_receive(source)
        if val == null {
            iter["__done"] = true
            return {"value": null, "done": true}
        }
        return {"value": val, "done": false}
    }

    iter["__done"] = true
    {"value": null, "done": true}
}

func eval_async_iter_return(iter, value) {
    iter["__done"] = true
    {"value": value, "done": true}
}

func eval_async_iter_throw(iter, error) {
    iter["__done"] = true
    panic(f"async iterator error: {i_display(error)}")
}

func eval_for_await(iter_expr, var_name, body) {
    const iterable = eval_expr(iter_expr)
    const iter = eval_async_iterator_create(iterable)

    let result = null
    while true {
        const next = eval_async_iter_next(iter)
        if next["done"] { break }

        i_push_scope()
        i_set(var_name, next["value"], false)
        result = eval_block(body)
        i_pop_scope()

        if is_break(result) { break }
        if is_return(result) { return result }
        if is_continue(result) { continue }
    }
    result
}
func eval_generator_create(params, body) {
    let captured = i_new_scope()
    for scope in i_scopes {
        for k in scope.keys() {
            captured[k] = scope[k]
        }
    }
    {
        "__generator_fn": true,
        "params": params,
        "body": body,
        "captured": captured,
    }
}

func eval_generator_init(gen_fn, args) {
    {
        "__generator": true,
        "__fn": gen_fn,
        "__args": args,
        "__state": "suspended",
        "__yielded": [],
        "__yield_idx": 0,
        "__return_value": null,
    }
}

func eval_generator_next(gen, value) {
    if gen["__state"] == "completed" {
        return {"value": null, "done": true}
    }

    if gen["__yield_idx"] < len(gen["__yielded"]) {
        const val = gen["__yielded"][gen["__yield_idx"]]
        gen["__yield_idx"] = gen["__yield_idx"] + 1
        return {"value": val, "done": false}
    }

    if gen["__state"] == "suspended" {
        gen["__state"] = "executing"
        const gen_fn = gen["__fn"]

        i_push_scope()
        for k in gen_fn["captured"].keys() {
            if k == "__s" { continue }
            i_scopes[len(i_scopes) - 1][k] = gen_fn["captured"][k]
        }
        let pi = 0
        while pi < len(gen_fn["params"]) && pi < len(gen["__args"]) {
            i_set(gen_fn["params"][pi], gen["__args"][pi], false)
            pi = pi + 1
        }

        let yields = []
        const result = eval_generator_body(gen_fn["body"], yields)
        i_pop_scope()

        gen["__yielded"] = yields
        gen["__yield_idx"] = 0
        gen["__return_value"] = result
        gen["__state"] = "completed"

        if len(yields) > 0 {
            gen["__yield_idx"] = 1
            return {"value": yields[0], "done": false}
        }

        return {"value": result, "done": true}
    }

    {"value": null, "done": true}
}

func eval_generator_body(body, yields) {
    if typeof(body) == "array" {
        let result = null
        for stmt in body {
            result = eval_generator_stmt(stmt, yields)
            if is_return(result) { return signal_value(result) }
        }
        return result
    }
    eval_generator_stmt(body, yields)
}

func eval_generator_stmt(node, yields) {
    if node == null { return null }
    if typeof(node) == "map" && node.has("kind") {
        const kind = node["kind"]
        if kind == "yield" {
            const val = if node.has("expr") { eval_expr(node["expr"]) } else { null }
            yields.push(val)
            return val
        }
        if kind == "yield_star" {
            const iterable = eval_expr(node["expr"])
            if typeof(iterable) == "array" {
                for item in iterable { yields.push(item) }
            }
            return null
        }
    }
    eval_stmt(node)
}

func eval_generator_return(gen, value) {
    gen["__state"] = "completed"
    gen["__return_value"] = value
    {"value": value, "done": true}
}

func eval_generator_throw(gen, error) {
    gen["__state"] = "completed"
    panic(f"generator error: {i_display(error)}")
}
let i_event_queue = []
let i_microtask_queue = []
let i_timer_id = 0

func i_schedule_event(callback, delay) {
    i_timer_id = i_timer_id + 1
    i_event_queue.push({
        "id": i_timer_id,
        "callback": callback,
        "delay": delay,
        "scheduled_at": timestamp_ms(),
    })
    i_timer_id
}

func i_schedule_microtask(callback) {
    i_microtask_queue.push(callback)
}

func i_cancel_timer(id) {
    i_event_queue = i_event_queue.filter(e => e["id"] != id)
}

func i_event_loop_tick() {
    while len(i_microtask_queue) > 0 {
        const task = i_microtask_queue.shift()
        i_call_any(task, [])
    }

    if len(i_event_queue) > 0 {
        i_event_queue.sort((a, b) =>
            (a["scheduled_at"] + a["delay"]) - (b["scheduled_at"] + b["delay"])
        )
        const event = i_event_queue.shift()
        i_call_any(event["callback"], [])
        return true
    }

    false
}

func i_run_event_loop() {
    let iterations = 0
    const max_iterations = 10000
    while (len(i_event_queue) > 0 || len(i_microtask_queue) > 0) && iterations < max_iterations {
        i_event_loop_tick()
        iterations = iterations + 1
    }
    if iterations >= max_iterations {
        panic("event loop exceeded maximum iterations")
    }
}

func i_set_timeout(callback, delay) {
    i_schedule_event(callback, delay)
}

func i_set_interval(callback, interval) {
    const id = i_schedule_event(callback, interval)
    let wrapper = null
    wrapper = () => {
        i_call_any(callback, [])
        i_schedule_event(wrapper, interval)
    }
    i_schedule_event(wrapper, interval)
    id
}

func i_queue_microtask(callback) {
    i_schedule_microtask(callback)
}

func i_next_tick(callback) {
    i_schedule_microtask(callback)
}
func i_into_iterator(value) {
    const t = typeof(value)
    if t == "array" { return i_array_iterator(value) }
    if t == "string" { return i_string_iterator(value) }
    if t == "map" {
        if value.has("__iter") { return value }
        if value.has("__generator") { return value }
        if value.has("__stream") { return i_stream_iterator(value) }
        return i_map_iterator(value)
    }
    i_array_iterator([value])
}

func i_array_iterator(arr) {
    {"__iter": true, "__source": arr, "__index": 0, "__kind": "array"}
}

func i_string_iterator(s) {
    {"__iter": true, "__source": s, "__index": 0, "__kind": "string"}
}

func i_map_iterator(m) {
    const keys = m.keys().filter(k => k != "__s")
    {"__iter": true, "__source": m, "__keys": keys, "__index": 0, "__kind": "map"}
}

func i_stream_iterator(stream) {
    const items = stream_collect(stream)
    i_array_iterator(items)
}

func i_iter_next(iter) {
    const kind = iter["__kind"]
    const idx = iter["__index"]

    match kind {
        "array" => {
            const src = iter["__source"]
            if idx >= len(src) { return {"done": true, "value": null} }
            iter["__index"] = idx + 1
            {"done": false, "value": src[idx]}
        },
        "string" => {
            const src = iter["__source"]
            if idx >= len(src) { return {"done": true, "value": null} }
            iter["__index"] = idx + 1
            {"done": false, "value": src[idx]}
        },
        "map" => {
            const keys = iter["__keys"]
            if idx >= len(keys) { return {"done": true, "value": null} }
            const key = keys[idx]
            iter["__index"] = idx + 1
            {"done": false, "value": [key, iter["__source"][key]]}
        },
        _ => {"done": true, "value": null},
    }
}

func i_iter_collect(iter) {
    let result = []
    while true {
        const next = i_iter_next(iter)
        if next["done"] { break }
        result.push(next["value"])
    }
    result
}
