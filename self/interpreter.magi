                if k == "__s" || k == "__init" { continue }
                result.push({"key": k, "value": obj[k]})
            }
            result
        },
        "from_entries" => {
            let result = {"__init": true}
            const entries = args[0]
            for entry in entries {
                if typeof(entry) == "array" && len(entry) >= 2 {
                    result[to_string(entry[0])] = entry[1]
                } else if typeof(entry) == "map" && entry.has("key") {
                    result[entry["key"]] = entry["value"]
                }
            }
            result
        },
        "invert" => i_map_invert(obj),
        "select" => i_map_select(obj, args[0]),
        "reject" => i_map_reject(obj, args[0]),
        "flatten" => i_map_flatten(obj, ""),
        "unflatten" => i_map_unflatten(obj),
        "each" => {
            const fn_val = args[0]
            for k in obj.keys() {
                if k == "__s" || k == "__init" || k == "__struct" { continue }
                i_call_any(fn_val, [k, obj[k]])
            }
            obj
        },
        "reduce" => {
            const fn_val = args[0]
            let acc = if len(args) > 1 { args[1] } else { null }
            for k in obj.keys() {
                if k == "__s" || k == "__init" || k == "__struct" { continue }
                acc = i_call_any(fn_val, [acc, k, obj[k]])
            }
            acc
        },
        "find" => {
            const fn_val = args[0]
            for k in obj.keys() {
                if k == "__s" || k == "__init" || k == "__struct" { continue }
                if i_truthy(i_call_any(fn_val, [k, obj[k]])) { return [k, obj[k]] }
            }
            null
        },
        "every" => {
            const fn_val = args[0]
            for k in obj.keys() {
                if k == "__s" || k == "__init" || k == "__struct" { continue }
                if !i_truthy(i_call_any(fn_val, [k, obj[k]])) { return false }
            }
            true
        },
        "some" => {
            const fn_val = args[0]
            for k in obj.keys() {
                if k == "__s" || k == "__init" || k == "__struct" { continue }
                if i_truthy(i_call_any(fn_val, [k, obj[k]])) { return true }
            }
            false
        },
        "clone" => { let r = {}; for k in obj.keys() { r[k] = obj[k] }; r },
        "to_string" => i_display(obj),
        "to_json" => i_to_json(obj),
        "to_array" => {
            let result = []
            for k in obj.keys() {
                if k == "__s" || k == "__init" { continue }
                result.push([k, obj[k]])
            }
            result
        },
        "update" => {
            const key = args[0]
            const fn_val = args[1]
            let result = {}
            for k in obj.keys() { result[k] = obj[k] }
            if result.has(key) { result[key] = i_call_any(fn_val, [result[key]]) }
            result
        },
        "set" => {
            let result = {}
            for k in obj.keys() { result[k] = obj[k] }
            result[args[0]] = args[1]
            result
        },
        _ => panic(f"map has no method '{method}'")
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 53: Numeric Coercion for All Type Combinations
// ═══════════════════════════════════════════════════════════════════

func i_coerce_numeric(a, b) {
    const at = typeof(a)
    const bt = typeof(b)
    if at == bt { return [a, b] }
    if at == "int64" && bt == "float64" { return [to_float64(a), b] }
    if at == "float64" && bt == "int64" { return [a, to_float64(b)] }
    if at == "int32" && bt == "int64" { return [to_int64(a), b] }
    if at == "int64" && bt == "int32" { return [a, to_int64(b)] }
    if at == "int32" && bt == "float64" { return [to_float64(a), b] }
    if at == "float64" && bt == "int32" { return [a, to_float64(b)] }
    if at == "uint32" && bt == "int64" { return [to_int64(a), b] }
    if at == "int64" && bt == "uint32" { return [a, to_int64(b)] }
    if at == "uint64" && bt == "int64" { return [to_int64(a), b] }
    if at == "int64" && bt == "uint64" { return [a, to_int64(b)] }
    if at == "float32" && bt == "float64" { return [to_float64(a), b] }
    if at == "float64" && bt == "float32" { return [a, to_float64(b)] }
    [a, b]
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 54: Bytes Type Operations
// ═══════════════════════════════════════════════════════════════════

func i_bytes_new(size) {
    let data = []
    let i = 0
    while i < size { data.push(0); i = i + 1 }
    {"__bytes": true, "__data": data}
}

func i_bytes_from_array(arr) { {"__bytes": true, "__data": arr} }

func i_bytes_from_string(s) {
    let data = []
    for c in s.chars() { data.push(char_code(c)) }
    {"__bytes": true, "__data": data}
}

func i_is_bytes(val) { typeof(val) == "map" && val.has("__bytes") }
func i_bytes_len(b) { len(b["__data"]) }

func i_bytes_get(b, idx) {
    const data = b["__data"]
    if idx < 0 || idx >= len(data) { panic("bytes index out of bounds") }
    data[idx]
}

func i_bytes_set(b, idx, val) {
    let data = b["__data"]
    if idx < 0 || idx >= len(data) { panic("bytes index out of bounds") }
    data[idx] = val & 255
    b["__data"] = data
    b
}

func i_bytes_slice(b, start, end_val) {
    {"__bytes": true, "__data": b["__data"].slice(start, end_val)}
}

func i_bytes_concat(a, b) {
    {"__bytes": true, "__data": a["__data"].concat(b["__data"])}
}

func i_bytes_to_string(b) {
    let result = ""
    for byte in b["__data"] { result = result + from_char_code(byte) }
    result
}

func i_bytes_to_hex(b) {
    const hex_chars = "0123456789abcdef"
    let result = ""
    for byte in b["__data"] { result = result + hex_chars[byte / 16] + hex_chars[byte % 16] }
    result
}

func i_bytes_equals(a, b) {
    const ad = a["__data"]
    const bd = b["__data"]
    if len(ad) != len(bd) { return false }
    let i = 0
    while i < len(ad) { if ad[i] != bd[i] { return false }; i = i + 1 }
    true
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 55: Set Operations (using maps as backing store)
// ═══════════════════════════════════════════════════════════════════

func i_set_new() { {"__set": true, "__elements": {"__init": true}} }

func i_set_from(arr) {
    let elements = {"__init": true}
    for item in arr { elements[i_display(item)] = item }
    {"__set": true, "__elements": elements}
}

func i_set_add(s, val) {
    let elements = s["__elements"]
    elements[i_display(val)] = val
    s["__elements"] = elements
    s
}

func i_set_remove(s, val) {
    let elements = s["__elements"]
    const key = i_display(val)
    if elements.has(key) { elements = elements.delete(key); s["__elements"] = elements }
    s
}

func i_set_contains(s, val) { s["__elements"].has(i_display(val)) }

func i_set_size(s) {
    let count = 0
    for k in s["__elements"].keys() { if k != "__init" { count = count + 1 } }
    count
}

func i_set_to_array(s) {
    let result = []
    for k in s["__elements"].keys() {
        if k != "__init" { result.push(s["__elements"][k]) }
    }
    result
}

func i_set_union_set(a, b) {
    let result = i_set_new()
    for k in a["__elements"].keys() { if k != "__init" { i_set_add(result, a["__elements"][k]) } }
    for k in b["__elements"].keys() { if k != "__init" { i_set_add(result, b["__elements"][k]) } }
    result
}

func i_set_intersection_set(a, b) {
    let result = i_set_new()
    for k in a["__elements"].keys() {
        if k != "__init" && b["__elements"].has(k) { i_set_add(result, a["__elements"][k]) }
    }
    result
}

func i_set_difference_set(a, b) {
    let result = i_set_new()
    for k in a["__elements"].keys() {
        if k != "__init" && !b["__elements"].has(k) { i_set_add(result, a["__elements"][k]) }
    }
    result
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 56: Tuple Operations
// ═══════════════════════════════════════════════════════════════════

func i_tuple_new(elements) { {"__tuple": true, "__elements": elements} }
func i_is_tuple(val) { typeof(val) == "map" && val.has("__tuple") }
func i_tuple_get(tup, idx) {
    const elements = tup["__elements"]
    if idx < 0 || idx >= len(elements) { panic("tuple index out of bounds") }
    elements[idx]
}
func i_tuple_len(tup) { len(tup["__elements"]) }
func i_tuple_to_array(tup) { let r = []; for item in tup["__elements"] { r.push(item) }; r }

// ═══════════════════════════════════════════════════════════════════
// SECTION 57: Future/Promise State Handling
// ═══════════════════════════════════════════════════════════════════

func i_future_new() {
    {"__future": true, "__state": "pending", "__value": null, "__error": null, "__callbacks": []}
}

func i_future_resolve(future, value) {
    if future["__state"] != "pending" { panic("cannot resolve a non-pending future") }
    future["__state"] = "resolved"
    future["__value"] = value
    for cb in future["__callbacks"] { i_call_any(cb, [value]) }
    future["__callbacks"] = []
    future
}

func i_future_reject(future, error) {
    if future["__state"] != "pending" { panic("cannot reject a non-pending future") }
    future["__state"] = "rejected"
    future["__error"] = error
    future
}

func i_future_is_pending(f) { f["__state"] == "pending" }
func i_future_is_resolved(f) { f["__state"] == "resolved" }
func i_future_is_rejected(f) { f["__state"] == "rejected" }
func i_future_value(f) { if f["__state"] != "resolved" { panic("not resolved") }; f["__value"] }
func i_future_error(f) { if f["__state"] != "rejected" { panic("not rejected") }; f["__error"] }

func i_future_then(future, callback) {
    if future["__state"] == "resolved" {
        const result = i_call_any(callback, [future["__value"]])
        let nf = i_future_new()
        i_future_resolve(nf, result)
        return nf
    }
    let callbacks = future["__callbacks"]
    let nf = i_future_new()
    callbacks.push(val => {
        const result = i_call_any(callback, [val])
        i_future_resolve(nf, result)
    })
    future["__callbacks"] = callbacks
    nf
}

func i_future_all(futures) {
    let results = []
    for f in futures {
        if f["__state"] == "resolved" { results.push(f["__value"]) }
        else if f["__state"] == "rejected" {
            let r = i_future_new(); i_future_reject(r, f["__error"]); return r
        }
        else { results.push(null) }
    }
    let r = i_future_new()
    i_future_resolve(r, results)
    r
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 58: Error Boundary and Result Types
// ═══════════════════════════════════════════════════════════════════

func i_make_error(message) { {"__error": true, "__message": message} }
func i_is_error_value(val) { typeof(val) == "map" && val.has("__error") }
func i_error_message(err) { if i_is_error_value(err) { err["__message"] } else { to_string(err) } }
func i_result_ok(value) { {"__result": true, "__ok": true, "__value": value} }
func i_result_err(error) { {"__result": true, "__ok": false, "__error": error} }
func i_result_is_ok(r) { typeof(r) == "map" && r.has("__result") && r["__ok"] }
func i_result_is_err(r) { typeof(r) == "map" && r.has("__result") && !r["__ok"] }
func i_result_unwrap(r) {
    if i_result_is_ok(r) { return r["__value"] }
    if i_result_is_err(r) { panic(f"unwrap on Err: {i_error_message(r['__error'])}") }
    r
}
func i_result_unwrap_or(r, default_val) { if i_result_is_ok(r) { r["__value"] } else { default_val } }

// ═══════════════════════════════════════════════════════════════════
// SECTION 59: Import Resolution
// ═══════════════════════════════════════════════════════════════════

let i_module_cache = {"__init": true}

func i_resolve_module_path(module_path) {
    const parts = module_path.split(".")
    if len(parts) >= 2 && parts[0] == "std" {
        return {"kind": "stdlib", "name": parts[1]}
    }
    {"kind": "file", "path": parts.join("/") + ".magi"}
}

func i_load_module(module_path) {
    if i_module_cache.has(module_path) { return i_module_cache[module_path] }
    const resolved = i_resolve_module_path(module_path)
    const mod_result = {"__module": true, "__name": module_path, "__exports": {"__init": true}}
    i_module_cache[module_path] = mod_result
    mod_result
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 60: REPL Mode Support
// ═══════════════════════════════════════════════════════════════════

let i_repl_active = false

func i_repl_init() {
    i_repl_active = true
    i_scopes = [i_new_scope()]
    i_functions = {"__init": true}
    i_structs = {"__init": true}
    i_enums = {"__init": true}
}

func i_repl_evaluate(input_text) {
    if !i_repl_active { i_repl_init() }
    const save_tokens = p_tokens
    const save_pos = p_pos
    p_tokens = tokenize(input_text)
    p_pos = 0
    let result = null
    if len(p_tokens) > 0 {
        const program = parse_program()
        result = eval_program(program)
    }
    p_tokens = save_tokens
    p_pos = save_pos
    result
}

func i_repl_reset() {
    i_repl_active = false
    i_scopes = [i_new_scope()]
}

func i_repl_bindings() {
    let names = []
    for scope in i_scopes {
        for k in scope.keys() { if k != "__s" { names.push(k) } }
    }
    for k in i_functions.keys() {
        if k != "__init" { names.push(k) }
    }
    names
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 61: Statistics Operations
// ═══════════════════════════════════════════════════════════════════

func i_stats_mean(arr) {
    if len(arr) == 0 { return 0.0 }
    let sum = 0.0
    for item in arr { sum = sum + to_float(item) }
    sum / to_float(len(arr))
}

func i_stats_median(arr) {
    if len(arr) == 0 { return 0.0 }
    let sorted = arr.sort()
    const n = len(sorted)
    if n % 2 == 1 { to_float(sorted[n / 2]) }
    else { (to_float(sorted[n / 2 - 1]) + to_float(sorted[n / 2])) / 2.0 }
}

func i_stats_variance(arr) {
    if len(arr) <= 1 { return 0.0 }
    const mean = i_stats_mean(arr)
    let sum_sq = 0.0
    for item in arr {
        const diff = to_float(item) - mean
        sum_sq = sum_sq + diff * diff
    }
    sum_sq / to_float(len(arr) - 1)
}

func i_stats_stddev(arr) { sqrt(i_stats_variance(arr)) }

func i_stats_covariance(xs, ys) {
    if len(xs) != len(ys) || len(xs) <= 1 { return 0.0 }
    const mx = i_stats_mean(xs)
    const my = i_stats_mean(ys)
    let sum = 0.0
    let i = 0
    while i < len(xs) {
        sum = sum + (to_float(xs[i]) - mx) * (to_float(ys[i]) - my)
        i = i + 1
    }
    sum / to_float(len(xs) - 1)
}

func i_stats_correlation(xs, ys) {
    const cov = i_stats_covariance(xs, ys)
    const sx = i_stats_stddev(xs)
    const sy = i_stats_stddev(ys)
    if sx == 0.0 || sy == 0.0 { return 0.0 }
    cov / (sx * sy)
}

func i_stats_percentile(arr, p) {
    if len(arr) == 0 { return 0.0 }
    let sorted = arr.sort()
    const idx = to_float(p) / 100.0 * to_float(len(sorted) - 1)
    const lower = floor(idx)
    const upper = ceil(idx)
    if lower == upper { return to_float(sorted[lower]) }
    const frac = idx - to_float(lower)
    to_float(sorted[lower]) * (1.0 - frac) + to_float(sorted[upper]) * frac
}

func i_stats_z_score(arr, value) {
    const mean = i_stats_mean(arr)
    const sd = i_stats_stddev(arr)
    if sd == 0.0 { return 0.0 }
    (to_float(value) - mean) / sd
}

func i_stats_mode(arr) {
    if len(arr) == 0 { return null }
    let counts = {"__init": true}
    for item in arr {
        const key = i_display(item)
        if counts.has(key) { counts[key] = counts[key] + 1 } else { counts[key] = 1 }
    }
    let best_count = 0
    let best_val = null
    for item in arr {
        if counts[i_display(item)] > best_count {
            best_count = counts[i_display(item)]
            best_val = item
        }
    }
    best_val
}

func i_stats_quartiles(arr) {
    [i_stats_percentile(arr, 25.0), i_stats_percentile(arr, 50.0), i_stats_percentile(arr, 75.0)]
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 62: Format Operations
// ═══════════════════════════════════════════════════════════════════

func i_fmt_number(n, decimals) {
    const factor = power(10.0, to_float(decimals))
    to_string(round(to_float(n) * factor) / factor)
}

func i_fmt_bytes_size(n) {
    const units = ["B", "KB", "MB", "GB", "TB", "PB"]
    let val = to_float(n)
    let ui = 0
    while val >= 1024.0 && ui < len(units) - 1 { val = val / 1024.0; ui = ui + 1 }
    if ui == 0 { f"{to_int(val)} {units[ui]}" }
    else { f"{round(val * 100.0) / 100.0} {units[ui]}" }
}

func i_fmt_duration(ms) {
    const total = to_int(ms)
    if total < 1000 { return f"{total}ms" }
    const s = total / 1000
    if s < 60 { return f"{s}.{(total % 1000) / 100}s" }
    const m = s / 60
    if m < 60 { return f"{m}m {s % 60}s" }
    const h = m / 60
    if h < 24 { return f"{h}h {m % 60}m" }
    f"{h / 24}d {h % 24}h"
}

func i_fmt_hex(n) {
    const hex_chars = "0123456789abcdef"
    let val = to_int(n)
    if val == 0 { return "0x0" }
    let neg = val < 0
    if neg { val = 0 - val }
    let result = ""
    while val > 0 { result = hex_chars[val % 16] + result; val = val / 16 }
    if neg { "0x-" + result } else { "0x" + result }
}

func i_fmt_binary(n) {
    let val = to_int(n)
    if val == 0 { return "0b0" }
    let neg = val < 0
    if neg { val = 0 - val }
    let result = ""
    while val > 0 { result = to_string(val % 2) + result; val = val / 2 }
    if neg { "0b-" + result } else { "0b" + result }
}

func i_fmt_percent(n, decimals) { i_fmt_number(to_float(n) * 100.0, decimals) + "%" }

func i_fmt_with_commas(n) {
    const s = to_string(to_int(n))
    let result = ""
    let count = 0
    let i = len(s) - 1
    while i >= 0 {
        if count > 0 && count % 3 == 0 { result = "," + result }
        result = s[i] + result
        count = count + 1
        i = i - 1
    }
    result
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 63: JSON Serialization
// ═══════════════════════════════════════════════════════════════════

func i_to_json(val) {
    if val == null { return "null" }
    const t = typeof(val)
    if t == "string" { return i_json_escape_string(val) }
    if t == "int64" || t == "int" { return to_string(val) }
    if t == "float64" || t == "float" { return to_string(val) }
    if t == "bool" { return if val { "true" } else { "false" } }
    if t == "array" {
        let parts = []
        for item in val { parts.push(i_to_json(item)) }
        return "[" + parts.join(",") + "]"
    }
    if t == "map" {
        let parts = []
        for k in val.keys() {
            if k == "__s" || k == "__init" || k == "__struct" || k == "__enum" { continue }
            parts.push(i_json_escape_string(k) + ":" + i_to_json(val[k]))
        }
        return "{" + parts.join(",") + "}"
    }
    to_string(val)
}

func i_json_escape_string(s) {
    let result = "\""
    for c in to_string(s).chars() {
        if c == "\"" { result = result + "\\\"" }
        else if c == "\\" { result = result + "\\\\" }
        else if c == "\n" { result = result + "\\n" }
        else if c == "\r" { result = result + "\\r" }
        else if c == "\t" { result = result + "\\t" }
        else { result = result + c }
    }
    result + "\""
}
