            }
            let start = if len(args) > 1 { 0 } else { 1 }
            let i = start
            while i < len(obj) {
                acc = i_call_any(fn_val, [acc, obj[i], i])
                i = i + 1
            }
            acc
        },
        "find" => {
            const fn_val = args[0]
