// MAGI Self-Hosted Compiler — Tree-Walking Interpreter
//
// Takes an AST from parse() and executes it directly.
// Uses module-level mutable state for the scope stack (same pattern as parser).

// ── Signals ──────────────────────────────────────────────────────

const RETURN_SIGNAL = "__return__"
const BREAK_SIGNAL = "__break__"
const CONTINUE_SIGNAL = "__continue__"

func is_signal(val) {
    if val == null { return false }
    if typeof(val) != "map" { return false }
    val.has("__signal")
}

func is_return(val) {
    if !is_signal(val) { return false }
    val["__signal"] == RETURN_SIGNAL
}

func is_break(val) {
    if !is_signal(val) { return false }
    val["__signal"] == BREAK_SIGNAL
}

func is_continue(val) {
    if !is_signal(val) { return false }
    val["__signal"] == CONTINUE_SIGNAL
}

func signal_value(val) {
    if typeof(val) != "map" { return null }
    if val.has("value") { val["value"] } else { null }
}

func make_return_signal(value) {
    {"__signal": RETURN_SIGNAL, "value": value}
}

func make_break_signal() {
    {"__signal": BREAK_SIGNAL}
}

func make_continue_signal() {
    {"__signal": CONTINUE_SIGNAL}
}

// ── Scope Stack (module-level mutable) ───────────────────────────

// Note: empty map {} is null in MAGI, so use sentinel to create real map
func i_new_scope() {
    {"__s": true}
}

let i_scopes = [i_new_scope()]

func i_push_scope() {
    i_scopes.push(i_new_scope())
}

func i_pop_scope() {
    i_scopes.pop()
}

func i_get(name) {
    let idx = len(i_scopes) - 1
    while idx >= 0 {
        const s = i_scopes[idx]
        if s.has(name) {
            const entry = s[name]
            return entry["value"]
        }
        idx = idx - 1
    }
    panic(f"undefined variable: {name}")
}

func i_set(name, value, mutable) {
    const idx = len(i_scopes) - 1
    let s = i_scopes[idx]
    s[name] = {"value": value, "mutable": mutable}
    i_scopes[idx] = s
}

func i_update(name, value) {
    let idx = len(i_scopes) - 1
    while idx >= 0 {
        let s = i_scopes[idx]
        if s.has(name) {
            const entry = s[name]
            if !entry["mutable"] {
                panic(f"cannot assign to immutable variable: {name}")
            }
            s[name] = {"value": value, "mutable": true}
            i_scopes[idx] = s
            return null
        }
        idx = idx - 1
    }
    panic(f"undefined variable: {name}")
}

// ── Function & Type Storage ─────────────────────────────────────

let i_functions = {}
let i_structs = {}
let i_enums = {}

// ── Entry Points ─────────────────────────────────────────────────

func eval_source(code) {
    const save_scopes = i_scopes
    const save_functions = i_functions
    const save_structs = i_structs
    const save_enums = i_enums

    i_scopes = [i_new_scope()]
    i_functions = {"__init": true}
    i_structs = {"__init": true}
    i_enums = {"__init": true}

    const prog = parse(code)
    const result = eval_program(prog)

    i_scopes = save_scopes
    i_functions = save_functions
    i_structs = save_structs
    i_enums = save_enums

    result
}

func eval_program(prog) {
    let last = null
    for s in prog.statements {
        last = eval_stmt(s)
        if is_signal(last) {
            if is_return(last) {
                return signal_value(last)
            }
            return last
        }
    }
    last
}

// ── Statement Evaluation ─────────────────────────────────────────

func eval_stmt(stmt) {
    match stmt.kind {
        StmtKind::SConst(name, expr) => {
            const val = eval_expr(expr)
            i_set(name, val, false)
            null
        },
        StmtKind::SLet(name, expr) => {
            const val = eval_expr(expr)
            i_set(name, val, false)
            null
        },
        StmtKind::SLetMut(name, expr) => {
            const val = eval_expr(expr)
            i_set(name, val, true)
            null
        },
        StmtKind::SAssignment(name, expr) => {
            const val = eval_expr(expr)
            i_update(name, val)
            null
        },
        StmtKind::SCompoundAssign(name, op, expr) => {
            const current = i_get(name)
            const rhs = eval_expr(expr)
            const result = apply_binop(op, current, rhs)
            i_update(name, result)
            null
        },
        StmtKind::SFieldAssign(obj_expr, field, val_expr) => {
            const val = eval_expr(val_expr)
            i_field_assign(obj_expr, field, val)
            null
        },
        StmtKind::SIndexAssign(obj_expr, idx_expr, val_expr) => {
            const idx = eval_expr(idx_expr)
            const val = eval_expr(val_expr)
            i_index_assign(obj_expr, idx, val)
            null
        },
        StmtKind::SFuncDef(fdef) => {
            // Store function definition: capture params and body
            i_functions[fdef.name] = {
                "params": fdef.params,
                "body": fdef.body,
            }
            null
        },
        StmtKind::SAsyncFuncDef(fdef) => {
            i_functions[fdef.name] = {
                "params": fdef.params,
                "body": fdef.body,
            }
            null
        },
        StmtKind::SReturn(expr) => {
            let val = null
            if expr != null {
                val = eval_expr(expr)
            }
            make_return_signal(val)
        },
        StmtKind::SBreak(_, _) => {
            make_break_signal()
        },
        StmtKind::SContinue(_) => {
            make_continue_signal()
        },
        StmtKind::SIf(cond, then_block, else_block) => {
            const cond_val = eval_expr(cond)
            if i_truthy(cond_val) {
                eval_block(then_block)
            } else if else_block != null {
                eval_block(else_block)
            } else {
                null
            }
        },
        StmtKind::SWhileLoop(_, cond, body) => {
            let result = null
            while true {
                const cond_val = eval_expr(cond)
                if !i_truthy(cond_val) { break }
                const r = eval_block(body)
                if is_break(r) { break }
                if is_continue(r) { continue }
                if is_return(r) { return r }
                result = r
            }
            result
        },
        StmtKind::SDoWhile(_, body, cond) => {
            let result = null
            while true {
                const r = eval_block(body)
                if is_break(r) { break }
                if is_continue(r) { continue }
                if is_return(r) { return r }
                result = r
                const cond_val = eval_expr(cond)
                if !i_truthy(cond_val) { break }
            }
            result
        },
        StmtKind::SForLoop(_, var_expr, iter_expr, body) => {
            const iter_val = eval_expr(iter_expr)
            let result = null
            // var_expr is a string (variable name) or an expression for the binding
            const var_name = match var_expr {
                ExprKind::EVariable(n) => n,
                _ => {
                    // var_expr is actually a string in the parser encoding
                    to_string(var_expr)
                },
            }
            const iter_t = typeof(iter_val)
            if iter_t == "array" {
                for item in iter_val {
                    i_push_scope()
                    i_set(var_name, item, true)
                    const r = eval_block(body)
                    i_pop_scope()
                    if is_break(r) { break }
                    if is_continue(r) { continue }
                    if is_return(r) { return r }
                    result = r
                }
            } else if iter_t == "map" {
                const keys = iter_val.keys()
                for k in keys {
                    i_push_scope()
                    i_set(var_name, k, true)
                    const r = eval_block(body)
                    i_pop_scope()
                    if is_break(r) { break }
                    if is_continue(r) { continue }
                    if is_return(r) { return r }
                    result = r
                }
            } else {
                panic("for-in requires array or map")
            }
            result
        },
        StmtKind::SMatch(subject, arms) => {
            const subject_val = eval_expr(subject)
            eval_match(subject_val, arms)
        },
        StmtKind::SOutput(expr) => {
            const val = eval_expr(expr)
            println(i_display(val))
            val
        },
        StmtKind::SExprStmt(expr) => {
            eval_expr(expr)
        },
        StmtKind::SStructDef(name, fields, _methods) => {
            i_structs[name] = fields
            null
        },
        StmtKind::SEnumDef(name, variants, _methods) => {
            i_enums[name] = variants
            null
        },
        StmtKind::SInterfaceDef(_, _, _) => null,
        StmtKind::SImplBlock(_, methods) => {
            for m in methods {
                i_functions[m.name] = {
                    "params": m.params,
                    "body": m.body,
                }
            }
            null
        },
        StmtKind::SImplTrait(_, _, methods) => {
            for m in methods {
                i_functions[m.name] = {
                    "params": m.params,
                    "body": m.body,
                }
            }
            null
        },
        StmtKind::SImport(_) => null,
        StmtKind::SImportModule(_, _, _) => null,
        StmtKind::STypeAlias(_, _) => null,
        StmtKind::SDefer(_) => null,
        StmtKind::SThrow(expr) => {
            const val = eval_expr(expr)
            panic(f"throw: {i_display(val)}")
        },
        StmtKind::STryCatch(try_block, catch_var, catch_block, _finally) => {
            // Simplified: just eval try block (no real try-catch in the host)
            eval_block(try_block)
        },
        StmtKind::STestDef(name, body) => {
            // Store as function
            i_functions[f"test_{name}"] = {
                "params": [],
                "body": body,
            }
            null
        },
        StmtKind::SModuleDef(_, _) => null,
        StmtKind::SLetDestructure(_, _, _) => null,
        StmtKind::STupleAssign(_, _) => null,
        StmtKind::SSpawn(_) => null,
        StmtKind::SIncrement(name) => {
            const current = i_get(name)
            const next = apply_binop(BinOp::Add, current, 1)
            i_update(name, next)
            null
        },
        StmtKind::SDecrement(name) => {
            const current = i_get(name)
            const next = apply_binop(BinOp::Sub, current, 1)
            i_update(name, next)
            null
        },
        _ => {
            panic(f"unhandled statement kind")
        },
    }
}

// ── Field/Index Assignment Helpers ────────────────────────────────

func i_field_assign(obj_expr, field, val) {
    let obj = eval_expr(obj_expr)
    if typeof(obj) == "map" {
        obj[field] = val
        match obj_expr.kind {
            ExprKind::EVariable(name) => i_update(name, obj),
            _ => {},
        }
    } else {
        panic("cannot set field on non-map")
    }
}

func i_index_assign(obj_expr, idx, val) {
    let obj = eval_expr(obj_expr)
    const obj_t = typeof(obj)
    if obj_t == "array" {
        obj[idx] = val
        match obj_expr.kind {
            ExprKind::EVariable(name) => i_update(name, obj),
            _ => {},
        }
    } else if obj_t == "map" {
        const k = if typeof(idx) == "string" { idx } else { to_string(idx) }
        obj[k] = val
        match obj_expr.kind {
            ExprKind::EVariable(name) => i_update(name, obj),
            _ => {},
        }
    } else {
        panic("cannot index-assign on this type")
    }
}

// ── Block Evaluation ─────────────────────────────────────────────

func eval_block(block) {
    i_push_scope()
    let result = null
    for s in block.stmts {
        result = eval_stmt(s)
        if is_signal(result) {
            i_pop_scope()
            return result
        }
    }
    if block.tail_expr != null {
        result = eval_expr(block.tail_expr)
    }
    i_pop_scope()
    result
}

// ── Expression Evaluation ────────────────────────────────────────

func eval_expr(expr) {
    match expr.kind {
        ExprKind::ELiteral(lit) => eval_literal(lit),
        ExprKind::EVariable(name) => i_get(name),
        ExprKind::EBinaryOp(op, left, right) => {
            // Short-circuit for && and ||
            match op {
                BinOp::And => {
                    const lv = eval_expr(left)
                    if !i_truthy(lv) { return lv }
                    return eval_expr(right)
                },
                BinOp::Or => {
                    const lv = eval_expr(left)
                    if i_truthy(lv) { return lv }
                    return eval_expr(right)
                },
                _ => {},
            }
            const lv = eval_expr(left)
            const rv = eval_expr(right)
            apply_binop(op, lv, rv)
        },
        ExprKind::EUnaryOp(op, operand) => {
            const val = eval_expr(operand)
            apply_unaryop(op, val)
        },
        ExprKind::ECall(name, args, _type_args) => {
            const arg_vals = args.map(a => eval_expr(a))
            eval_call(name, arg_vals)
        },
        ExprKind::EMethodCall(obj_expr, method, args, _type_args) => {
            const obj = eval_expr(obj_expr)
            const arg_vals = args.map(a => eval_expr(a))
            eval_method_call(obj, method, arg_vals, obj_expr)
        },
        ExprKind::EPipe(left, right) => {
            const lv = eval_expr(left)
            // Pipe: right should be a call — inject lv as first arg
            match right.kind {
                ExprKind::ECall(name, args, _) => {
                    const arg_vals = args.map(a => eval_expr(a))
                    eval_call(name, [lv] + arg_vals)
                },
                ExprKind::EVariable(name) => {
                    eval_call(name, [lv])
                },
                _ => {
                    const rv = eval_expr(right)
                    rv
                },
            }
        },
        ExprKind::EIfElse(cond, then_block, else_block) => {
            const cond_val = eval_expr(cond)
            if i_truthy(cond_val) {
                eval_block(then_block)
            } else if else_block != null {
                eval_block(else_block)
            } else {
                null
            }
        },
        ExprKind::EBlock(block) => {
            eval_block(block)
        },
        ExprKind::EIndex(obj_expr, idx_expr) => {
            const obj = eval_expr(obj_expr)
            const idx = eval_expr(idx_expr)
            eval_index(obj, idx)
        },
        ExprKind::EFieldAccess(obj_expr, field) => {
            const obj = eval_expr(obj_expr)
            eval_field_access(obj, field)
        },
        ExprKind::ERange(start_expr, end_expr, inclusive) => {
            const s = eval_expr(start_expr)
            const e = eval_expr(end_expr)
            eval_range(s, e, inclusive)
        },
        ExprKind::ELambda(params, body) => {
            // Capture the current scope for closures
            let captured = i_new_scope()
            for scope in i_scopes {
                for k in scope.keys() {
                    captured[k] = scope[k]
                }
            }
            {"__lambda": true, "params": params, "body": body, "captured": captured}
        },
        ExprKind::EMatch(subject, arms) => {
            const subject_val = eval_expr(subject)
            eval_match(subject_val, arms)
        },
        ExprKind::EStringInterp(parts) => {
            let result = ""
            for part in parts {
                match part {
                    StringPart::LiteralPart(s) => {
                        result = result + s
                    },
                    StringPart::ExprPart(expr) => {
                        const val = eval_expr(expr)
                        result = result + i_display(val)
                    },
                }
            }
            result
        },
        ExprKind::ENullCoalesce(left, right) => {
            const lv = eval_expr(left)
            if lv == null {
                eval_expr(right)
            } else {
                lv
            }
        },
        ExprKind::EOptionalChain(obj_expr, field) => {
            const obj = eval_expr(obj_expr)
            if obj == null { return null }
            eval_field_access(obj, field)
        },
        ExprKind::ESpread(inner) => {
            eval_expr(inner)
        },
        ExprKind::EEnumConstruct(enum_name, variant, args) => {
            const arg_vals = args.map(a => eval_expr(a))
            {"__enum": enum_name, "__variant": variant, "__fields": arg_vals}
        },
        ExprKind::EStructConstruct(name, field_pairs) => {
            let result = {"__struct": name}
            for pair in field_pairs {
                const fname = pair[0]
                const fval = eval_expr(pair[1])
                result[fname] = fval
            }
            result
        },
        ExprKind::ETupleLiteral(elems) => {
            const vals = elems.map(e => eval_expr(e))
            vals
        },
        ExprKind::ELoop(body) => {
            let result = null
            while true {
                const r = eval_block(body)
                if is_break(r) {
                    result = signal_value(r)
                    break
                }
                if is_return(r) { return r }
                result = r
            }
            result
        },
        ExprKind::EListComp(elem_expr, var_expr, iter_expr, cond_expr) => {
            const iter_val = eval_expr(iter_expr)
            let result = []
            const var_name = match var_expr.kind {
                ExprKind::EVariable(n) => n,
                _ => "_",
            }
            if typeof(iter_val) != "array" { panic("list comprehension requires array") }
            for item in iter_val {
                i_push_scope()
                i_set(var_name, item, true)
                let include = true
                if cond_expr != null {
                    include = i_truthy(eval_expr(cond_expr))
                }
                if include {
                    result.push(eval_expr(elem_expr))
                }
                i_pop_scope()
            }
            result
        },
        ExprKind::EPlaceholder => null,
        ExprKind::EAwait(inner) => eval_expr(inner),
        ExprKind::ESpawn(inner) => eval_expr(inner),
        ExprKind::EYield(inner) => {
            if inner != null { eval_expr(inner) } else { null }
        },
        ExprKind::ETryCatch(try_expr, _catch_var, catch_expr) => {
            eval_expr(try_expr)
        },
        ExprKind::ETryPropagate(inner) => eval_expr(inner),
        ExprKind::EMapComp(_, _, _, _, _) => null,
        _ => {
            panic(f"unhandled expression kind")
        },
    }
}

// ── Literal Evaluation ───────────────────────────────────────────

func eval_literal(lit) {
    match lit {
        Literal::IntLit(n) => n,
        Literal::FloatLit(f) => f,
        Literal::StringLit(s) => s,
        Literal::BoolLit(b) => b,
        Literal::NullLit => null,
        Literal::ArrayLit(elements) => {
            elements.map(e => eval_expr(e))
        },
        Literal::MapLit(pairs) => {
            let result = {}
            for pair in pairs {
                const k = eval_expr(pair[0])
                const v = eval_expr(pair[1])
                const key = if typeof(k) == "string" { k } else { to_string(k) }
                result[key] = v
            }
            result
        },
        Literal::SetLit(elements) => {
            elements.map(e => eval_expr(e))
        },
    }
}

// ── Binary Operators ─────────────────────────────────────────────

func apply_binop(op, left, right) {
    match op {
        BinOp::Add => i_add(left, right),
        BinOp::Sub => i_sub(left, right),
        BinOp::Mul => i_mul(left, right),
        BinOp::Div => i_div(left, right),
        BinOp::Mod => i_mod(left, right),
        BinOp::Eq => left == right,
        BinOp::NotEq => left != right,
        BinOp::Lt => i_compare(left, right) < 0,
        BinOp::Gt => i_compare(left, right) > 0,
        BinOp::LtEq => i_compare(left, right) <= 0,
        BinOp::GtEq => i_compare(left, right) >= 0,
        BinOp::And => {
            if i_truthy(left) { right } else { left }
        },
        BinOp::Or => {
            if i_truthy(left) { left } else { right }
        },
        BinOp::In => {
            const rt = typeof(right)
            if rt == "array" { return right.contains(left) }
            if rt == "map" {
                if typeof(left) == "string" { return right.has(left) }
                return false
            }
            if rt == "string" {
                if typeof(left) == "string" { return right.contains(left) }
                return false
            }
            false
        },
        BinOp::BitAnd => i_bitop("and", left, right),
        BinOp::BitOr => i_bitop("or", left, right),
        BinOp::BitXor => i_bitop("xor", left, right),
        BinOp::Shl => i_bitop("shl", left, right),
        BinOp::Shr => i_bitop("shr", left, right),
        BinOp::AndNot => i_bitop("andnot", left, right),
    }
}

// ── Arithmetic Helpers ───────────────────────────────────────────
// Values are native MAGI host values (int64, float64, string, array, map),
// NOT wrapped in DataType enum. Use typeof() for type dispatch.

func i_add(left, right) {
    const lt = typeof(left)
    const rt = typeof(right)
    if lt == "int64" && rt == "int64" { return left + right }
    if lt == "int64" && rt == "float64" { return to_float64(left) + right }
    if lt == "float64" && rt == "int64" { return left + to_float64(right) }
    if lt == "float64" && rt == "float64" { return left + right }
    if lt == "string" && rt == "string" { return left + right }
    if lt == "string" && rt == "int64" { return left + to_string(right) }
    if lt == "string" && rt == "float64" { return left + to_string(right) }
    if lt == "int64" && rt == "string" { return to_string(left) + right }
    if lt == "array" && rt == "array" { return left.concat(right) }
    panic(f"cannot add {lt} and {rt}")
}

func i_sub(left, right) {
    const lt = typeof(left)
    const rt = typeof(right)
    if lt == "int64" && rt == "int64" { return left - right }
    if lt == "int64" && rt == "float64" { return to_float64(left) - right }
    if lt == "float64" && rt == "int64" { return left - to_float64(right) }
    if lt == "float64" && rt == "float64" { return left - right }
    panic("cannot subtract")
}

func i_mul(left, right) {
    const lt = typeof(left)
    const rt = typeof(right)
    if lt == "int64" && rt == "int64" { return left * right }
    if lt == "int64" && rt == "float64" { return to_float64(left) * right }
    if lt == "float64" && rt == "int64" { return left * to_float64(right) }
    if lt == "float64" && rt == "float64" { return left * right }
    panic("cannot multiply")
}

func i_div(left, right) {
    const lt = typeof(left)
    const rt = typeof(right)
    if lt == "int64" && rt == "int64" {
        if right == 0 { panic("division by zero") }
        return left / right
    }
    if lt == "int64" && rt == "float64" {
        if right == 0.0 { panic("division by zero") }
        return to_float64(left) / right
    }
    if lt == "float64" && rt == "int64" {
        if right == 0 { panic("division by zero") }
        return left / to_float64(right)
    }
    if lt == "float64" && rt == "float64" {
        if right == 0.0 { panic("division by zero") }
        return left / right
    }
    panic("cannot divide")
}

func i_mod(left, right) {
    const lt = typeof(left)
    const rt = typeof(right)
    if lt == "int64" && rt == "int64" { return left % right }
    panic("cannot modulo")
}

// ── Bitwise Operations ───────────────────────────────────────────

func i_bitop(op_name, left, right) {
    if op_name == "and" { return left & right }
    if op_name == "or" { return (left ^ right) + (left & right) }
    if op_name == "xor" { return left ^ right }
    if op_name == "shl" { return left << right }
    if op_name == "shr" { return left >> right }
    if op_name == "andnot" { return left & (right ^ -1) }
    panic(f"unknown bitwise op: {op_name}")
}

// ── Unary Operators ──────────────────────────────────────────────

func apply_unaryop(op, val) {
    match op {
        UnOp::Neg => {
            const t = typeof(val)
            if t == "int64" { return 0 - val }
            if t == "float64" { return 0.0 - val }
            panic("cannot negate")
        },
        UnOp::Not => {
            !i_truthy(val)
        },
    }
}

// ── Comparison ───────────────────────────────────────────────────

func i_compare(left, right) {
    const lt = typeof(left)
    const rt = typeof(right)
    // Int vs Int
    if lt == "int64" && rt == "int64" {
        if left < right { return -1 }
        if left > right { return 1 }
        return 0
    }
    // Float vs Float
    if lt == "float64" && rt == "float64" {
        if left < right { return -1 }
        if left > right { return 1 }
        return 0
    }
    // Int vs Float
    if lt == "int64" && rt == "float64" {
        const lf = to_float64(left)
        if lf < right { return -1 }
        if lf > right { return 1 }
        return 0
    }
    // Float vs Int
    if lt == "float64" && rt == "int64" {
        const rf = to_float64(right)
        if left < rf { return -1 }
        if left > rf { return 1 }
        return 0
    }
    // String vs String
    if lt == "string" && rt == "string" {
        if left < right { return -1 }
        if left > right { return 1 }
        return 0
    }
    panic(f"cannot compare {lt} and {rt}")
}

// ── Truthiness ───────────────────────────────────────────────────

func i_truthy(val) {
    if val == null { return false }
    const t = typeof(val)
    if t == "bool" { return val }
    if t == "int64" { return val != 0 }
    if t == "float64" { return val != 0.0 }
    if t == "string" { return len(val) > 0 }
    if t == "array" { return len(val) > 0 }
    if t == "map" { return len(val) > 0 }
    true
}

// ── Display ──────────────────────────────────────────────────────

func i_display(val) {
    if val == null { return "null" }
    const t = typeof(val)
    if t == "bool" {
        if val { return "true" } else { return "false" }
    }
    if t == "int64" { return to_string(val) }
    if t == "float64" { return to_string(val) }
    if t == "string" { return val }
    if t == "array" {
        const parts = val.map(x => i_display(x))
        const joined = parts.join(", ")
        return f"[{joined}]"
    }
    if t == "map" {
        if val.has("__enum") {
            const ename = val["__enum"]
            const vname = val["__variant"]
            const flds = val["__fields"]
            if len(flds) == 0 {
                return f"{ename}::{vname}"
            } else {
                const parts = flds.map(fv => i_display(fv))
                const joined = parts.join(", ")
                return f"{ename}::{vname}({joined})"
            }
        } else if val.has("__struct") {
            const sname = val["__struct"]
            let parts = []
            for k in val.keys() {
                if k != "__struct" {
                    parts.push(f"{k}: {i_display(val[k])}")
                }
            }
            const joined = parts.join(", ")
            return f"{sname} {{ {joined} }}"
        } else {
            let parts = []
            for k in val.keys() {
                parts.push(f"{k}: {i_display(val[k])}")
            }
            const joined = parts.join(", ")
            return f"{{{joined}}}"
        }
    }
    to_string(val)
}

// ── Function Calls ───────────────────────────────────────────────

func eval_call(name, args) {
    // Built-in functions first
    if name == "println" {
        const parts = args.map(a => i_display(a))
        println(parts.join(" "))
        return null
    }
    if name == "print" {
        const parts = args.map(a => i_display(a))
        print(parts.join(" "))
        return null
    }
    if name == "len" {
        if len(args) != 1 { panic("len() takes 1 argument") }
        return i_len(args[0])
    }
    if name == "to_string" {
        if len(args) != 1 { panic("to_string() takes 1 argument") }
        return i_display(args[0])
    }
    if name == "to_int" {
        if len(args) != 1 { panic("to_int64() takes 1 argument") }
        return i_to_int64(args[0])
    }
    if name == "to_float" {
        if len(args) != 1 { panic("to_float64() takes 1 argument") }
        return i_to_float64(args[0])
    }
    if name == "type_of" {
        if len(args) != 1 { panic("typeof() takes 1 argument") }
        return typeof(args[0])
    }
    if name == "assert" {
        if len(args) < 1 { panic("assert() takes at least 1 argument") }
        if !i_truthy(args[0]) {
            if len(args) > 1 {
                panic(f"assertion failed: {i_display(args[1])}")
            }
            panic("assertion failed")
        }
        return null
    }
    if name == "panic" {
        const msg = if len(args) > 0 { i_display(args[0]) } else { "panic" }
        panic(msg)
    }
    if name == "abs" {
        if len(args) != 1 { panic("abs() takes 1 argument") }
        const v = args[0]
        const vt = typeof(v)
        if vt == "int64" { return if v < 0 { 0 - v } else { v } }
        if vt == "float64" { return if v < 0.0 { 0.0 - v } else { v } }
        panic("abs() requires number")
    }
    if name == "min" {
        if len(args) != 2 { panic("min() takes 2 arguments") }
        return if i_compare(args[0], args[1]) <= 0 { args[0] } else { args[1] }
    }
    if name == "max" {
        if len(args) != 2 { panic("max() takes 2 arguments") }
        return if i_compare(args[0], args[1]) >= 0 { args[0] } else { args[1] }
    }
    if name == "range" {
        if len(args) == 1 {
            return eval_range(0, args[0], false)
        }
        if len(args) == 2 {
            return eval_range(args[0], args[1], false)
        }
        panic("range() takes 1 or 2 arguments")
    }
    if name == "output" {
        if len(args) == 1 {
            const val = args[0]
            println(i_display(val))
            return val
        }
        panic("output() takes 1 argument")
    }

    // User-defined functions
    if i_functions.has(name) {
        const func_info = i_functions[name]
        return call_user_func(func_info, args)
    }

    // Struct constructors
    if i_structs.has(name) {
        let result = {"__struct": name}
        const fields = i_structs[name]
        let idx = 0
        while idx < len(fields) && idx < len(args) {
            result[fields[idx].name] = args[idx]
            idx = idx + 1
        }
        return result
    }

    // Check if name is a variable holding a lambda
    let lambda_val = null
    let found_lambda = false
    let scope_idx = len(i_scopes) - 1
    while scope_idx >= 0 {
        const s = i_scopes[scope_idx]
        if s.has(name) {
            const entry = s[name]
            lambda_val = entry["value"]
            found_lambda = true
            break
        }
        scope_idx = scope_idx - 1
    }
    if found_lambda && typeof(lambda_val) == "map" && lambda_val.has("__lambda") {
        return call_lambda(lambda_val, args)
    }

    panic(f"undefined function: {name}")
}

func call_user_func(func_info, args) {
    i_push_scope()
    const params = func_info["params"]
    let idx = 0
    while idx < len(params) {
        const p = params[idx]
        let val = null
        if idx < len(args) {
            val = args[idx]
        } else if p.default_val != null {
            val = eval_expr(p.default_val)
        }
        if p.rest {
            // Rest parameter collects remaining args
            val = args.slice(idx, len(args))
        }
        i_set(p.name, val, true)
        idx = idx + 1
    }
    const result = eval_block(func_info["body"])
    i_pop_scope()
    if is_return(result) {
        return signal_value(result)
    }
    result
}

func call_lambda(lambda, args) {
    // Restore captured scope
    const save_scopes = i_scopes
    let restored = []
    restored.push(lambda["captured"])
    i_scopes = restored

    i_push_scope()
    const params = lambda["params"]
    let idx = 0
    while idx < len(params) {
        const p = params[idx]
        let val = null
        if idx < len(args) {
            val = args[idx]
        }
        i_set(p.name, val, true)
        idx = idx + 1
    }
    const result = eval_block(lambda["body"])
    i_pop_scope()

    i_scopes = save_scopes

    if is_return(result) {
        return signal_value(result)
    }
    result
}

// ── Method Calls ─────────────────────────────────────────────────

func eval_method_call(obj, method, args, obj_expr) {
    const ot = typeof(obj)

    // Array methods
    if ot == "array" {
        if method == "push" {
            if len(args) != 1 { panic("push() takes 1 argument") }
            const new_arr = obj.append(args[0])
            match obj_expr.kind {
                ExprKind::EVariable(name) => i_update(name, new_arr),
                _ => {},
            }
            return null
        }
        if method == "pop" {
            if len(obj) == 0 { panic("pop from empty array") }
            const val = obj[len(obj) - 1]
            const new_arr = obj.slice(0, len(obj) - 1)
            match obj_expr.kind {
                ExprKind::EVariable(name) => i_update(name, new_arr),
                _ => {},
            }
            return val
        }
        if method == "len" || method == "length" {
            return len(obj)
        }
        if method == "map" {
            if len(args) != 1 { panic("map() takes 1 argument") }
            const fn_val = args[0]
            return obj.map(item => {
                if typeof(fn_val) == "map" && fn_val.has("__lambda") {
                    call_lambda(fn_val, [item])
                } else {
                    item
                }
            })
        }
        if method == "filter" {
            if len(args) != 1 { panic("filter() takes 1 argument") }
            const fn_val = args[0]
            return obj.filter(item => {
                if typeof(fn_val) == "map" && fn_val.has("__lambda") {
                    i_truthy(call_lambda(fn_val, [item]))
                } else {
                    i_truthy(item)
                }
            })
        }
        if method == "contains" {
            if len(args) != 1 { panic("contains() takes 1 argument") }
            return obj.contains(args[0])
        }
        if method == "join" {
            if len(args) != 1 { panic("join() takes 1 argument") }
            const sep = if typeof(args[0]) == "string" { args[0] } else { to_string(args[0]) }
            const parts = obj.map(x => i_display(x))
            return parts.join(sep)
        }
        if method == "slice" {
            if len(args) == 2 {
                return obj.slice(args[0], args[1])
            }
            if len(args) == 1 {
                return obj.slice(args[0], len(obj))
            }
            panic("slice() takes 1 or 2 arguments")
        }
        if method == "reverse" {
            return obj.reverse()
        }
        if method == "sort" {
            return obj.sort()
        }
        if method == "concat" {
            if len(args) != 1 { panic("concat() takes 1 argument") }
            return obj.concat(args[0])
        }
        if method == "append" {
            if len(args) != 1 { panic("append() takes 1 argument") }
            return obj.append(args[0])
        }
        if method == "flat" || method == "flatten" {
            return obj.flat()
        }
        if method == "enumerate" {
            let result = []
            let i = 0
            for item in obj {
                result.push([i, item])
                i = i + 1
            }
            return result
        }
        if method == "reduce" {
            if len(args) != 2 { panic("reduce() takes 2 arguments (fn, initial)") }
            const fn_val = args[0]
            let acc = args[1]
            for item in obj {
                if typeof(fn_val) == "map" && fn_val.has("__lambda") {
                    acc = call_lambda(fn_val, [acc, item])
                }
            }
            return acc
        }
    }

    // String methods
    if ot == "string" {
        if method == "len" || method == "length" { return len(obj) }
        if method == "contains" {
            if len(args) != 1 { panic("contains() takes 1 argument") }
            const sub = if typeof(args[0]) == "string" { args[0] } else { to_string(args[0]) }
            return obj.contains(sub)
        }
        if method == "starts_with" {
            if len(args) != 1 { panic("starts_with() takes 1 argument") }
            const prefix = if typeof(args[0]) == "string" { args[0] } else { to_string(args[0]) }
            return obj.starts_with(prefix)
        }
        if method == "ends_with" {
            if len(args) != 1 { panic("ends_with() takes 1 argument") }
            const suffix = if typeof(args[0]) == "string" { args[0] } else { to_string(args[0]) }
            return obj.ends_with(suffix)
        }
        if method == "split" {
            if len(args) != 1 { panic("split() takes 1 argument") }
            const sep = if typeof(args[0]) == "string" { args[0] } else { to_string(args[0]) }
            return obj.split(sep)
        }
        if method == "trim" { return obj.trim() }
        if method == "to_upper" || method == "upper" || method == "to_uppercase" { return obj.to_upper() }
        if method == "to_lower" || method == "lower" || method == "to_lowercase" { return obj.to_lower() }
        if method == "replace" {
            if len(args) != 2 { panic("replace() takes 2 arguments") }
            const from = if typeof(args[0]) == "string" { args[0] } else { to_string(args[0]) }
            const to_str = if typeof(args[1]) == "string" { args[1] } else { to_string(args[1]) }
            return obj.replace(from, to_str)
        }
        if method == "chars" {
            return obj.chars()
        }
        if method == "slice" {
            if len(args) == 2 {
                return obj.slice(args[0], args[1])
            }
            panic("slice() takes 2 arguments for strings")
        }
    }

    // Map methods
    if ot == "map" {
        if method == "keys" { return obj.keys() }
        if method == "values" { return obj.values() }
        if method == "contains_key" || method == "has" {
            if len(args) != 1 { panic("contains_key() takes 1 argument") }
            const key = if typeof(args[0]) == "string" { args[0] } else { to_string(args[0]) }
            return obj.has(key)
        }
        if method == "len" || method == "length" { return len(obj) }
        if method == "remove" || method == "delete" {
            if len(args) != 1 { panic("remove() takes 1 argument") }
            const key = if typeof(args[0]) == "string" { args[0] } else { to_string(args[0]) }
            const new_map = obj.delete(key)
            match obj_expr.kind {
                ExprKind::EVariable(name) => i_update(name, new_map),
                _ => {},
            }
            return null
        }
    }

    // Check for Type.method style functions
    const obj_type_name = typeof(obj)
    const qualified_name = f"{obj_type_name}.{method}"
    if i_functions.has(qualified_name) {
        const func_info = i_functions[qualified_name]
        return call_user_func(func_info, [obj] + args)
    }

    // Check for struct/enum method: StructName.method or EnumName.method
    if ot == "map" {
        if obj.has("__struct") {
            const sname = obj["__struct"]
            const smethod = f"{sname}.{method}"
            if i_functions.has(smethod) {
                const func_info = i_functions[smethod]
                return call_user_func(func_info, [obj] + args)
            }
        }
        if obj.has("__enum") {
            const ename = obj["__enum"]
            const emethod = f"{ename}.{method}"
            if i_functions.has(emethod) {
                const func_info = i_functions[emethod]
                return call_user_func(func_info, [obj] + args)
            }
        }
    }

    // Try as a plain function with obj as first arg
    if i_functions.has(method) {
        const func_info = i_functions[method]
        return call_user_func(func_info, [obj] + args)
    }

    panic(f"unknown method: {method} on {typeof(obj)}")
}

// ── Index Access ─────────────────────────────────────────────────

func eval_index(obj, idx) {
    const ot = typeof(obj)
    if ot == "array" {
        if idx < 0 {
            const real_idx = len(obj) + idx
            if real_idx < 0 || real_idx >= len(obj) { panic("index out of bounds") }
            return obj[real_idx]
        }
        if idx >= len(obj) { panic("index out of bounds") }
        return obj[idx]
    }
    if ot == "string" {
        if idx < 0 {
            const real_idx = len(obj) + idx
            if real_idx < 0 || real_idx >= len(obj) { panic("index out of bounds") }
            return obj[real_idx]
        }
        if idx >= len(obj) { panic("index out of bounds") }
        return obj[idx]
    }
    if ot == "map" {
        const k = if typeof(idx) == "string" { idx } else { to_string(idx) }
        if obj.has(k) { return obj[k] }
        return null
    }
    panic(f"cannot index {ot}")
}

// ── Field Access ─────────────────────────────────────────────────

func eval_field_access(obj, field) {
    const ot = typeof(obj)
    if ot == "map" {
        if obj.has(field) { return obj[field] }
        if field == "length" || field == "len" { return len(obj) }
        return null
    }
    if ot == "array" {
        if field == "length" || field == "len" { return len(obj) }
        return null
    }
    if ot == "string" {
        if field == "length" || field == "len" { return len(obj) }
        return null
    }
    null
}

// ── Range ────────────────────────────────────────────────────────

func eval_range(start, end_val, inclusive) {
    let s = start
    let e = end_val
    let result = []
    if inclusive {
        let i = s
        while i <= e {
            result.push(i)
            i = i + 1
        }
    } else {
        let i = s
        while i < e {
            result.push(i)
            i = i + 1
        }
    }
    result
}

// ── Match Evaluation ─────────────────────────────────────────────

func eval_match(subject, arms) {
    for arm in arms {
        const bindings = match_pattern(arm.pattern, subject)
        if bindings != null {
            i_push_scope()
            for k in bindings.keys() {
                if k != "__matched" {
                    i_set(k, bindings[k], true)
                }
            }
            const result = eval_expr(arm.body)
            i_pop_scope()
            return result
        }
    }
    null
}

// Empty bindings map (cannot use {} as it equals null in MAGI)
func i_empty_bindings() {
    {"__matched": true}
}

func match_pattern(pattern, value) {
    match pattern {
        Pattern::PWildcard => {
            return i_empty_bindings()
        },
        Pattern::PVariable(name) => {
            if name == "_" { return i_empty_bindings() }
            let bindings = i_empty_bindings()
            bindings[name] = value
            return bindings
        },
        Pattern::PLiteral(lit_expr) => {
            const lit_val = eval_expr(lit_expr)
            if lit_val == value {
                return i_empty_bindings()
            }
            return null
        },
        Pattern::PEnum(ename, vname, field_pats) => {
            if typeof(value) != "map" { return null }
            if !value.has("__enum") { return null }
            if value["__enum"] != ename { return null }
            if value["__variant"] != vname { return null }
            let bindings = i_empty_bindings()
            const fields = value["__fields"]
            let idx = 0
            while idx < len(field_pats) {
                if idx >= len(fields) { return null }
                const sub = match_pattern(field_pats[idx], fields[idx])
                if sub == null { return null }
                for k in sub.keys() {
                    bindings[k] = sub[k]
                }
                idx = idx + 1
            }
            return bindings
        },
        Pattern::PArray(pats) => {
            if typeof(value) != "array" { return null }
            let bindings = i_empty_bindings()
            let idx = 0
            while idx < len(pats) {
                match pats[idx] {
                    Pattern::PRest(name) => {
                        const rest = value.slice(idx, len(value))
                        if name != "_" {
                            bindings[name] = rest
                        }
                        return bindings
                    },
                    _ => {
                        if idx >= len(value) { return null }
                        const sub = match_pattern(pats[idx], value[idx])
                        if sub == null { return null }
                        for k in sub.keys() {
                            bindings[k] = sub[k]
                        }
                    },
                }
                idx = idx + 1
            }
            if len(value) != len(pats) { return null }
            return bindings
        },
        Pattern::POr(pats) => {
            for p in pats {
                const result = match_pattern(p, value)
                if result != null { return result }
            }
            return null
        },
        Pattern::PType(name, type_name) => {
            const actual = typeof(value)
            if actual == type_name || type_name == "_" {
                let bindings = i_empty_bindings()
                bindings[name] = value
                return bindings
            }
            return null
        },
        Pattern::PBinding(name, inner_pat) => {
            const result = match_pattern(inner_pat, value)
            if result != null {
                result[name] = value
                return result
            }
            return null
        },
        _ => null,
    }
}

// ── Helper Builtins ──────────────────────────────────────────────

func i_len(val) {
    const t = typeof(val)
    if t == "array" || t == "string" || t == "map" { return len(val) }
    panic(f"len() not supported for {t}")
}

func i_to_int64(val) {
    const t = typeof(val)
    if t == "int64" { return val }
    if t == "float64" { return to_int64(val) }
    if t == "string" { return parse_int(val) }
    if t == "bool" { return if val { 1 } else { 0 } }
    panic("cannot convert to int")
}

func i_to_float64(val) {
    const t = typeof(val)
    if t == "int64" { return to_float64(val) }
    if t == "float64" { return val }
    if t == "string" { return parse_float(val) }
    panic("cannot convert to float")
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 1: Struct Support — construction, field access, update/spread,
//            impl method registration, method dispatch
// ═══════════════════════════════════════════════════════════════════

// Module-level mutable: impl method registry
// Maps "TypeName.method_name" → {params, body}
let i_impl_methods = {"__init": true}

// Register methods from an impl block into i_impl_methods
func i_register_impl_methods(type_name, methods) {
    for m in methods {
        const method_name = m.name
        // If the method name already contains a dot, keep as-is
        // Otherwise qualify it as TypeName.method
        const qualified = if method_name.contains(".") {
            method_name
        } else {
            f"{type_name}.{method_name}"
        }
        i_impl_methods[qualified] = {
            "params": m.params,
            "body": m.body,
        }
        // Also store in i_functions for plain dispatch
        i_functions[qualified] = {
            "params": m.params,
            "body": m.body,
        }
    }
}

// Construct a struct value from a name and field-value pairs
// Returns a map with __struct key and all field values
func i_construct_struct(name, field_pairs) {
    let result = {"__struct": name}
    for pair in field_pairs {
        const fname = pair[0]
        const fval = pair[1]
        result[fname] = fval
    }
    result
}

// Construct a struct with default field values from the definition
func i_construct_struct_defaults(name) {
    let result = {"__struct": name}
    if i_structs.has(name) {
        const fields = i_structs[name]
        for f in fields {
            if f.default_val != null {
                result[f.name] = eval_expr(f.default_val)
            } else {
                result[f.name] = null
            }
        }
    }
    result
}

// Spread/update struct: create a new struct by copying base and overriding fields
func i_struct_spread(base, overrides) {
    if typeof(base) != "map" { panic("spread requires a struct/map value") }
    let result = {"__struct": "unknown"}
    // Copy the __struct name from base if present
    if base.has("__struct") {
        result["__struct"] = base["__struct"]
    }
    // Copy all fields from base
    for k in base.keys() {
        result[k] = base[k]
    }
    // Apply overrides
    for k in overrides.keys() {
        result[k] = overrides[k]
    }
    result
}

// Check if a value is a struct instance
func i_is_struct(val) {
    if val == null { return false }
    if typeof(val) != "map" { return false }
    val.has("__struct")
}

// Get the struct type name from a struct value
func i_struct_name(val) {
    if !i_is_struct(val) { return "" }
    val["__struct"]
}

// Get a field from a struct value, with proper error handling
func i_struct_field(val, field) {
    if !i_is_struct(val) {
        panic(f"cannot access field '{field}' on non-struct value")
    }
    if val.has(field) {
        return val[field]
    }
    null
}

// Set a field on a struct value, returning the updated struct
func i_struct_set_field(val, field, new_val) {
    if !i_is_struct(val) {
        panic(f"cannot set field '{field}' on non-struct value")
    }
    val[field] = new_val
    val
}

// Look up a method for a struct type in the impl registry
func i_lookup_struct_method(struct_name, method_name) {
    const qualified = f"{struct_name}.{method_name}"
    if i_impl_methods.has(qualified) {
        return i_impl_methods[qualified]
    }
    if i_functions.has(qualified) {
        return i_functions[qualified]
    }
    null
}

// Dispatch a method call on a struct instance
// Binds self to the struct value and calls the method body
func i_dispatch_struct_method(obj, method_name, args) {
    const sname = i_struct_name(obj)
    if sname == "" {
        panic(f"cannot dispatch method '{method_name}' on non-struct")
    }
    const method_info = i_lookup_struct_method(sname, method_name)
    if method_info == null {
        panic(f"no method '{method_name}' on struct '{sname}'")
    }
    // Call with self as first argument
    call_user_func(method_info, [obj] + args)
}

// Validate struct construction against its definition
func i_validate_struct_fields(name, field_names) {
    if !i_structs.has(name) { return true }
    const def_fields = i_structs[name]
    // Check that all provided fields exist in the definition
    for fname in field_names {
        let found = false
        for df in def_fields {
            if df.name == fname {
                found = true
                break
            }
        }
        if !found {
            panic(f"struct '{name}' has no field '{fname}'")
        }
    }
    true
}

// Convert a struct to a printable string representation
func i_struct_to_string(val) {
    if !i_is_struct(val) { return to_string(val) }
    const sname = val["__struct"]
    let parts = []
    for k in val.keys() {
        if k != "__struct" {
            parts.push(f"{k}: {i_display(val[k])}")
        }
    }
    const joined = parts.join(", ")
    f"{sname} {{ {joined} }}"
}

// Compare two struct values for equality
func i_struct_eq(a, b) {
    if !i_is_struct(a) || !i_is_struct(b) { return false }
    if a["__struct"] != b["__struct"] { return false }
    const keys_a = a.keys()
    const keys_b = b.keys()
    if len(keys_a) != len(keys_b) { return false }
    for k in keys_a {
        if !b.has(k) { return false }
        if a[k] != b[k] { return false }
    }
    true
}

// Clone a struct (deep copy)
func i_struct_clone(val) {
    if !i_is_struct(val) { return val }
    let result = {"__struct": val["__struct"]}
    for k in val.keys() {
        if k != "__struct" {
            const v = val[k]
            if i_is_struct(v) {
                result[k] = i_struct_clone(v)
            } else {
                result[k] = v
            }
        }
    }
    result
}

// Get all field names from a struct (excluding __struct)
func i_struct_fields(val) {
    if !i_is_struct(val) { return [] }
    let fields = []
    for k in val.keys() {
        if k != "__struct" {
            fields.push(k)
        }
    }
    fields
}

// Check if a struct has a particular field
func i_struct_has_field(val, field) {
    if !i_is_struct(val) { return false }
    if field == "__struct" { return false }
    val.has(field)
}

// Get struct definition info
func i_struct_def_fields(name) {
    if !i_structs.has(name) { return [] }
    i_structs[name]
}

// List all registered struct types
func i_all_struct_names() {
    let names = []
    for k in i_structs.keys() {
        if k != "__init" {
            names.push(k)
        }
    }
    names
}

// Check if a type name is a registered struct
func i_is_struct_type(name) {
    i_structs.has(name) && name != "__init"
}

// Create a struct builder (returns a partial struct that can be incrementally filled)
func i_struct_builder(name) {
    let result = {"__struct": name, "__builder": true}
    if i_structs.has(name) {
        const fields = i_structs[name]
        for f in fields {
            if f.default_val != null {
                result[f.name] = eval_expr(f.default_val)
            }
        }
    }
    result
}

// Finalize a builder into a regular struct
func i_struct_build(builder) {
    if typeof(builder) != "map" || !builder.has("__builder") {
        panic("not a struct builder")
    }
    let result = {}
    for k in builder.keys() {
        if k != "__builder" {
            result[k] = builder[k]
        }
    }
    result
}

// Convert a map to a struct of a given type
func i_map_to_struct(name, m) {
    let result = {"__struct": name}
    for k in m.keys() {
        result[k] = m[k]
    }
    result
}

// Convert a struct to a plain map (strip __struct)
func i_struct_to_map(val) {
    if !i_is_struct(val) { return val }
    let result = {}
    for k in val.keys() {
        if k != "__struct" {
            result[k] = val[k]
        }
    }
    result
}

// Merge two structs (second overrides first, keeps type from first)
func i_struct_merge(a, b) {
    let result = {"__struct": a["__struct"]}
    for k in a.keys() {
        result[k] = a[k]
    }
    for k in b.keys() {
        if k != "__struct" {
            result[k] = b[k]
        }
    }
    result
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 2: Enum Support — construction, matching, method dispatch
// ═══════════════════════════════════════════════════════════════════

// Construct an enum variant value
// Returns a map with __enum, __variant, __fields, __iota
func i_construct_enum(enum_name, variant_name, fields) {
    let iota = 0
    // Look up iota from the definition if available
    if i_enums.has(enum_name) {
        const variants = i_enums[enum_name]
        let idx = 0
        for v in variants {
            if v.name == variant_name {
                iota = idx
                break
            }
            idx = idx + 1
        }
    }
    {
        "__enum": enum_name,
        "__variant": variant_name,
        "__fields": fields,
        "__iota": iota,
    }
}

// Check if a value is an enum instance
func i_is_enum(val) {
    if val == null { return false }
    if typeof(val) != "map" { return false }
    val.has("__enum")
}

// Get the enum type name from an enum value
func i_enum_name(val) {
    if !i_is_enum(val) { return "" }
    val["__enum"]
}

// Get the variant name from an enum value
func i_enum_variant(val) {
    if !i_is_enum(val) { return "" }
    val["__variant"]
}

// Get the fields/data from an enum value
func i_enum_fields(val) {
    if !i_is_enum(val) { return [] }
    if val.has("__fields") { return val["__fields"] }
    []
}

// Get the iota (ordinal) value of an enum variant
func i_enum_iota(val) {
    if !i_is_enum(val) { return -1 }
    if val.has("__iota") { return val["__iota"] }
    0
}

// Check if two enum values are equal
func i_enum_eq(a, b) {
    if !i_is_enum(a) || !i_is_enum(b) { return false }
    if a["__enum"] != b["__enum"] { return false }
    if a["__variant"] != b["__variant"] { return false }
    const af = i_enum_fields(a)
    const bf = i_enum_fields(b)
    if len(af) != len(bf) { return false }
    let idx = 0
    while idx < len(af) {
        if af[idx] != bf[idx] { return false }
        idx = idx + 1
    }
    true
}

// Match an enum value against a variant name, returning fields or null
func i_enum_match_variant(val, variant_name) {
    if !i_is_enum(val) { return null }
    if val["__variant"] != variant_name { return null }
    i_enum_fields(val)
}

// Look up a method for an enum type in the impl registry
func i_lookup_enum_method(enum_name, method_name) {
    const qualified = f"{enum_name}.{method_name}"
    if i_impl_methods.has(qualified) {
        return i_impl_methods[qualified]
    }
    if i_functions.has(qualified) {
        return i_functions[qualified]
    }
    null
}

// Dispatch a method call on an enum instance
func i_dispatch_enum_method(obj, method_name, args) {
    const ename = i_enum_name(obj)
    if ename == "" {
        panic(f"cannot dispatch method '{method_name}' on non-enum")
    }
    const method_info = i_lookup_enum_method(ename, method_name)
    if method_info == null {
        panic(f"no method '{method_name}' on enum '{ename}'")
    }
    call_user_func(method_info, [obj] + args)
}

// Convert an enum variant to a displayable string
func i_enum_to_string(val) {
    if !i_is_enum(val) { return to_string(val) }
    const ename = val["__enum"]
    const vname = val["__variant"]
    const flds = i_enum_fields(val)
    if len(flds) == 0 {
        return f"{ename}::{vname}"
    }
    const parts = flds.map(fv => i_display(fv))
    const joined = parts.join(", ")
    f"{ename}::{vname}({joined})"
}

// List all variants of a registered enum type
func i_enum_variants(enum_name) {
    if !i_enums.has(enum_name) { return [] }
    const variants = i_enums[enum_name]
    variants.map(v => v.name)
}

// Check if a variant exists in a registered enum
func i_enum_has_variant(enum_name, variant_name) {
    if !i_enums.has(enum_name) { return false }
    const variants = i_enums[enum_name]
    for v in variants {
        if v.name == variant_name { return true }
    }
    false
}

// Get the number of fields a variant expects
func i_enum_variant_arity(enum_name, variant_name) {
    if !i_enums.has(enum_name) { return 0 }
    const variants = i_enums[enum_name]
    for v in variants {
        if v.name == variant_name {
            return len(v.fields)
        }
    }
    0
}

// List all registered enum type names
func i_all_enum_names() {
    let names = []
    for k in i_enums.keys() {
        if k != "__init" {
            names.push(k)
        }
    }
    names
}

// Check if a type name is a registered enum
func i_is_enum_type(name) {
    i_enums.has(name) && name != "__init"
}

// Create all unit variants of an enum as a convenience
func i_enum_all_variants(enum_name) {
    if !i_enums.has(enum_name) { return [] }
    const variants = i_enums[enum_name]
    let result = []
    let idx = 0
    for v in variants {
        if len(v.fields) == 0 {
            result.push({
                "__enum": enum_name,
                "__variant": v.name,
                "__fields": [],
                "__iota": idx,
            })
        }
        idx = idx + 1
    }
    result
}

// Pattern match an enum value with data extraction
func i_enum_extract(val, enum_name, variant_name) {
    if !i_is_enum(val) { return null }
    if val["__enum"] != enum_name { return null }
    if val["__variant"] != variant_name { return null }
    // Return the fields for extraction
    let result = {"__matched": true}
    const fields = i_enum_fields(val)
    result["__fields"] = fields
    result
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 3: Closures — arrow function evaluation, capture, call
// ═══════════════════════════════════════════════════════════════════

// Create a closure value by capturing current scope variables
// Returns a map with __closure, __params, __body, __captures
func i_make_closure(params, body) {
    let captured = i_new_scope()
    // Flatten all scopes into one captured scope
    for scope in i_scopes {
        for k in scope.keys() {
            if k != "__s" {
                captured[k] = scope[k]
            }
        }
    }
    {
        "__closure": true,
        "__params": params,
        "__body": body,
        "__captures": captured,
    }
}

// Check if a value is a closure
func i_is_closure(val) {
    if val == null { return false }
    if typeof(val) != "map" { return false }
    val.has("__closure") || val.has("__lambda")
}

// Call a closure value with given arguments
func i_call_closure(closure, args) {
    if closure.has("__lambda") {
        return call_lambda(closure, args)
    }
    // Save current scopes
    const save_scopes = i_scopes

    // Restore captured scope and push a new frame
    let restored = []
    restored.push(closure["__captures"])
    i_scopes = restored

    i_push_scope()
    const params = closure["__params"]
    let idx = 0
    while idx < len(params) {
        const p = params[idx]
        let val = null
        if idx < len(args) {
            val = args[idx]
        } else if p.default_val != null {
            val = eval_expr(p.default_val)
        }
        if p.rest {
            val = args.slice(idx, len(args))
        }
        i_set(p.name, val, true)
        idx = idx + 1
    }

    const result = eval_block(closure["__body"])
    i_pop_scope()

    // Restore original scopes
    i_scopes = save_scopes

    if is_return(result) {
        return signal_value(result)
    }
    result
}

// Create a closure that captures specific named variables from the current scope
func i_capture_vars(var_names) {
    let captured = i_new_scope()
    for name in var_names {
        let found = false
        let scope_idx = len(i_scopes) - 1
        while scope_idx >= 0 {
            const s = i_scopes[scope_idx]
            if s.has(name) {
                captured[name] = s[name]
                found = true
                break
            }
            scope_idx = scope_idx - 1
        }
        if !found {
            captured[name] = {"value": null, "mutable": false}
        }
    }
    captured
}

// Build a closure from a lambda-like expression with explicit capture list
func i_make_closure_with_captures(params, body, capture_names) {
    const captured = i_capture_vars(capture_names)
    {
        "__closure": true,
        "__params": params,
        "__body": body,
        "__captures": captured,
    }
}

// Compose two closures: returns a new closure that applies f then g
func i_compose_closures(f_closure, g_closure) {
    // We cannot easily create a new body node at runtime,
    // so we store both closures and dispatch manually
    {
        "__composed": true,
        "__first": f_closure,
        "__second": g_closure,
    }
}

// Call a composed closure
func i_call_composed(composed, args) {
    const first_result = i_call_any(composed["__first"], args)
    i_call_any(composed["__second"], [first_result])
}

// Unified callable dispatcher: handles closures, lambdas, composed, and function names
func i_call_any(callable, args) {
    if callable == null { panic("cannot call null") }
    const ct = typeof(callable)
    if ct == "string" {
        // callable is a function name
        return eval_call(callable, args)
    }
    if ct == "map" {
        if callable.has("__composed") {
            return i_call_composed(callable, args)
        }
        if callable.has("__closure") {
            return i_call_closure(callable, args)
        }
        if callable.has("__lambda") {
            return call_lambda(callable, args)
        }
        // Might be a func_info {params, body}
        if callable.has("params") && callable.has("body") {
            return call_user_func(callable, args)
        }
    }
    panic(f"not callable: {typeof(callable)}")
}

// Apply a closure partially (currying)
func i_partial_apply(closure, partial_args) {
    {
        "__partial": true,
        "__inner": closure,
        "__partial_args": partial_args,
    }
}

// Call a partially applied closure
func i_call_partial(partial, args) {
    const full_args = partial["__partial_args"].concat(args)
    i_call_any(partial["__inner"], full_args)
}

// Higher-order: apply a callable to each element of an array
func i_apply_each(callable, arr) {
    let results = []
    for item in arr {
        results.push(i_call_any(callable, [item]))
    }
    results
}

// Higher-order: filter array using a callable predicate
func i_filter_with(callable, arr) {
    let results = []
    for item in arr {
        if i_truthy(i_call_any(callable, [item])) {
            results.push(item)
        }
    }
    results
}

// Higher-order: reduce array using a callable
func i_reduce_with(callable, arr, initial) {
    let acc = initial
    for item in arr {
        acc = i_call_any(callable, [acc, item])
    }
    acc
}

// Higher-order: find first element matching predicate
func i_find_with(callable, arr) {
    for item in arr {
        if i_truthy(i_call_any(callable, [item])) {
            return item
        }
    }
    null
}

// Higher-order: check if any element satisfies predicate
func i_any_with(callable, arr) {
    for item in arr {
        if i_truthy(i_call_any(callable, [item])) {
            return true
        }
    }
    false
}

// Higher-order: check if all elements satisfy predicate
func i_all_with(callable, arr) {
    for item in arr {
        if !i_truthy(i_call_any(callable, [item])) {
            return false
        }
    }
    true
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 4: String Interpolation — f-string evaluation with {expr}
// ═══════════════════════════════════════════════════════════════════

// Parse and evaluate an f-string template
// The parser has already split f-strings into StringPart::LiteralPart and StringPart::ExprPart
// This section provides additional runtime support for dynamic string interpolation

// Evaluate a string with embedded expressions at runtime
// Takes a raw template string like "Hello {name}, age {age}"
// and evaluates each {expr} within the current scope
func i_eval_fstring(template) {
    let result = ""
    let i = 0
    const n = len(template)
    while i < n {
        const ch = template[i]
        if ch == "{" {
            // Check for escaped brace
            if i + 1 < n && template[i + 1] == "{" {
                result = result + "{"
                i = i + 2
                continue
            }
            // Find matching closing brace
            let depth = 1
            let j = i + 1
            while j < n && depth > 0 {
                if template[j] == "{" { depth = depth + 1 }
                if template[j] == "}" { depth = depth - 1 }
                if depth > 0 { j = j + 1 }
            }
            if depth != 0 {
                panic("unmatched '{' in f-string")
            }
            // Extract and evaluate the expression
            const expr_str = template.slice(i + 1, j)
            const val = eval_source(expr_str)
            result = result + i_display(val)
            i = j + 1
        } else if ch == "}" {
            // Check for escaped brace
            if i + 1 < n && template[i + 1] == "}" {
                result = result + "}"
                i = i + 2
                continue
            }
            result = result + ch
            i = i + 1
        } else {
            result = result + ch
            i = i + 1
        }
    }
    result
}

// Format a value for string interpolation with a format specifier
func i_format_value(val, spec) {
    if spec == "" { return i_display(val) }
    const t = typeof(val)
    // Numeric formatting
    if t == "int64" || t == "float64" {
        if spec == "x" || spec == "hex" {
            // Hexadecimal format
            if t == "int64" {
                return i_int_to_hex(val)
            }
            return i_display(val)
        }
        if spec == "b" || spec == "bin" {
            // Binary format
            if t == "int64" {
                return i_int_to_bin(val)
            }
            return i_display(val)
        }
        if spec == "o" || spec == "oct" {
            // Octal format
            if t == "int64" {
                return i_int_to_oct(val)
            }
            return i_display(val)
        }
        // Decimal places spec like ".2"
        if spec.starts_with(".") {
            const places_str = spec.slice(1, len(spec))
            return i_display(val)
        }
    }
    // Padding spec like ">10" or "<10"
    if spec.starts_with(">") {
        const width_str = spec.slice(1, len(spec))
        const width = parse_int(width_str)
        const s = i_display(val)
        return i_pad_right(s, width)
    }
    if spec.starts_with("<") {
        const width_str = spec.slice(1, len(spec))
        const width = parse_int(width_str)
        const s = i_display(val)
        return i_pad_left(s, width)
    }
    i_display(val)
}

// Convert int to hexadecimal string
func i_int_to_hex(n) {
    if n == 0 { return "0" }
    const hex_digits = "0123456789abcdef"
    let is_neg = false
    let v = n
    if v < 0 {
        is_neg = true
        v = 0 - v
    }
    let result = ""
    while v > 0 {
        const digit = v % 16
        result = hex_digits[digit] + result
        v = v / 16
    }
    if is_neg { return "-" + result }
    result
}

// Convert int to binary string
func i_int_to_bin(n) {
    if n == 0 { return "0" }
    let v = n
    let is_neg = false
    if v < 0 {
        is_neg = true
        v = 0 - v
    }
    let result = ""
    while v > 0 {
        const bit = v % 2
        result = to_string(bit) + result
        v = v / 2
    }
    if is_neg { return "-" + result }
    result
}

// Convert int to octal string
func i_int_to_oct(n) {
    if n == 0 { return "0" }
    let v = n
    let is_neg = false
    if v < 0 {
        is_neg = true
        v = 0 - v
    }
    let result = ""
    while v > 0 {
        const digit = v % 8
        result = to_string(digit) + result
        v = v / 8
    }
    if is_neg { return "-" + result }
    result
}

// Pad a string on the left to reach a given width
func i_pad_left(s, width) {
    let result = s
    while len(result) < width {
        result = result + " "
    }
    result
}

// Pad a string on the right (prepend spaces) to reach a given width
func i_pad_right(s, width) {
    let result = s
    while len(result) < width {
        result = " " + result
    }
    result
}

// Repeat a string n times
func i_str_repeat(s, n) {
    let result = ""
    let i = 0
    while i < n {
        result = result + s
        i = i + 1
    }
    result
}

// Center a string within a given width
func i_str_center(s, width) {
    const padding = width - len(s)
    if padding <= 0 { return s }
    const left_pad = padding / 2
    const right_pad = padding - left_pad
    i_str_repeat(" ", left_pad) + s + i_str_repeat(" ", right_pad)
}

// Truncate a string to a maximum length with ellipsis
func i_str_truncate(s, max_len) {
    if len(s) <= max_len { return s }
    if max_len <= 3 { return s.slice(0, max_len) }
    s.slice(0, max_len - 3) + "..."
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 5: Advanced Pattern Matching — enum variant patterns,
//            array patterns, or-patterns, guard clauses, wildcards,
//            variable binding, range patterns, map patterns
// ═══════════════════════════════════════════════════════════════════

// Extended match evaluation with guard support
func eval_match_extended(subject_val, arms) {
    for arm in arms {
        const bindings = match_pattern(arm.pattern, subject_val)
        if bindings != null {
            // Check guard if present
            if arm.guard != null {
                i_push_scope()
                for k in bindings.keys() {
                    if k != "__matched" {
                        i_set(k, bindings[k], true)
                    }
                }
                const guard_result = eval_expr(arm.guard)
                i_pop_scope()
                if !i_truthy(guard_result) {
                    continue
                }
            }
            // Execute the arm body with bindings in scope
            i_push_scope()
            for k in bindings.keys() {
                if k != "__matched" {
                    i_set(k, bindings[k], true)
                }
            }
            const result = eval_expr(arm.body)
            i_pop_scope()
            return result
        }
    }
    null
}

// Match a range pattern: checks if value falls within [lo, hi] or [lo, hi)
func match_range_pattern(lo_expr, hi_expr, inclusive, value) {
    const lo = eval_expr(lo_expr)
    const hi = eval_expr(hi_expr)
    const cmp_lo = i_compare(value, lo)
    if cmp_lo < 0 { return null }
    if inclusive {
        const cmp_hi = i_compare(value, hi)
        if cmp_hi > 0 { return null }
    } else {
        const cmp_hi = i_compare(value, hi)
        if cmp_hi >= 0 { return null }
    }
    i_empty_bindings()
}

// Match an array pattern with rest element support
// Patterns: [first, second, ...rest] or [a, b, c]
func match_array_pattern_ext(patterns, value) {
    if typeof(value) != "array" { return null }
    let bindings = i_empty_bindings()
    let pat_idx = 0
    let val_idx = 0
    let has_rest = false
    let rest_name = "_"

    // First pass: find if there's a rest pattern and where it is
    let rest_pos = -1
    let i = 0
    while i < len(patterns) {
        match patterns[i] {
            Pattern::PRest(name) => {
                rest_pos = i
                rest_name = name
                has_rest = true
            },
            _ => {},
        }
        i = i + 1
    }

    if has_rest {
        // Match elements before rest
        while pat_idx < rest_pos {
            if val_idx >= len(value) { return null }
            const sub = match_pattern(patterns[pat_idx], value[val_idx])
            if sub == null { return null }
            for k in sub.keys() {
                bindings[k] = sub[k]
            }
            pat_idx = pat_idx + 1
            val_idx = val_idx + 1
        }

        // Calculate how many elements after rest
        const after_rest_count = len(patterns) - rest_pos - 1
        const rest_end = len(value) - after_rest_count

        // Bind rest elements
        if rest_name != "_" {
            bindings[rest_name] = value.slice(val_idx, rest_end)
        }
        val_idx = rest_end
        pat_idx = rest_pos + 1

        // Match elements after rest
        while pat_idx < len(patterns) {
            if val_idx >= len(value) { return null }
            const sub = match_pattern(patterns[pat_idx], value[val_idx])
            if sub == null { return null }
            for k in sub.keys() {
                bindings[k] = sub[k]
            }
            pat_idx = pat_idx + 1
            val_idx = val_idx + 1
        }
    } else {
        // No rest: exact length match required
        if len(value) != len(patterns) { return null }
        while pat_idx < len(patterns) {
            const sub = match_pattern(patterns[pat_idx], value[pat_idx])
            if sub == null { return null }
            for k in sub.keys() {
                bindings[k] = sub[k]
            }
            pat_idx = pat_idx + 1
        }
    }
    bindings
}

// Match a map/struct pattern: {key: pattern, ...}
func match_map_pattern(pair_patterns, value) {
    if typeof(value) != "map" { return null }
    let bindings = i_empty_bindings()
    for pair in pair_patterns {
        const key = pair[0]
        const pat = pair[1]
        if !value.has(key) { return null }
        const sub = match_pattern(pat, value[key])
        if sub == null { return null }
        for k in sub.keys() {
            bindings[k] = sub[k]
        }
    }
    bindings
}

// Match an or-pattern: try each sub-pattern until one matches
func match_or_pattern(patterns, value) {
    for p in patterns {
        const result = match_pattern(p, value)
        if result != null { return result }
    }
    null
}

// Match a binding pattern: name @ inner_pattern
func match_binding_pattern(name, inner_pattern, value) {
    const result = match_pattern(inner_pattern, value)
    if result != null {
        result[name] = value
        return result
    }
    null
}

// Match an enum variant pattern with data extraction
func match_enum_pattern_ext(enum_name, variant_name, field_patterns, value) {
    if typeof(value) != "map" { return null }
    if !value.has("__enum") { return null }
    if value["__enum"] != enum_name { return null }
    if value["__variant"] != variant_name { return null }
    let bindings = i_empty_bindings()
    const fields = i_enum_fields(value)
    let idx = 0
    while idx < len(field_patterns) {
        if idx >= len(fields) { return null }
        const sub = match_pattern(field_patterns[idx], fields[idx])
        if sub == null { return null }
        for k in sub.keys() {
            bindings[k] = sub[k]
        }
        idx = idx + 1
    }
    bindings
}

// Check if a pattern is irrefutable (always matches)
func i_pattern_is_irrefutable(pattern) {
    match pattern {
        Pattern::PWildcard => true,
        Pattern::PVariable(_) => true,
        Pattern::PBinding(_, inner) => i_pattern_is_irrefutable(inner),
        _ => false,
    }
}

// Count the number of bindings in a pattern
func i_pattern_binding_count(pattern) {
    match pattern {
        Pattern::PWildcard => 0,
        Pattern::PVariable(name) => {
            if name == "_" { 0 } else { 1 }
        },
        Pattern::PLiteral(_) => 0,
        Pattern::PEnum(_, _, pats) => {
            let count = 0
            for p in pats {
                count = count + i_pattern_binding_count(p)
            }
            count
        },
        Pattern::PArray(pats) => {
            let count = 0
            for p in pats {
                count = count + i_pattern_binding_count(p)
            }
            count
        },
        Pattern::POr(pats) => {
            // All branches should bind the same variables
            if len(pats) > 0 {
                i_pattern_binding_count(pats[0])
            } else {
                0
            }
        },
        Pattern::PRest(name) => {
            if name == "_" { 0 } else { 1 }
        },
        Pattern::PBinding(_, inner) => {
            1 + i_pattern_binding_count(inner)
        },
        _ => 0,
    }
}

// Extract all binding names from a pattern
func i_pattern_bindings(pattern) {
    match pattern {
        Pattern::PWildcard => [],
        Pattern::PVariable(name) => {
            if name == "_" { [] } else { [name] }
        },
        Pattern::PLiteral(_) => [],
        Pattern::PEnum(_, _, pats) => {
            let names = []
            for p in pats {
                names = names.concat(i_pattern_bindings(p))
            }
            names
        },
        Pattern::PArray(pats) => {
            let names = []
            for p in pats {
                names = names.concat(i_pattern_bindings(p))
            }
            names
        },
        Pattern::POr(pats) => {
            if len(pats) > 0 {
                i_pattern_bindings(pats[0])
            } else {
                []
            }
        },
        Pattern::PRest(name) => {
            if name == "_" { [] } else { [name] }
        },
        Pattern::PBinding(name, inner) => {
            [name].concat(i_pattern_bindings(inner))
        },
        _ => [],
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 6: Advanced Expressions — pipe, null coalesce, optional
//            chaining, spread, list comprehension, range, map comp,
//            type checking, type conversion, power operator
// ═══════════════════════════════════════════════════════════════════

// Pipe operator evaluation: data |> func → func(data)
func i_eval_pipe(left_val, right_expr) {
    match right_expr.kind {
        ExprKind::ECall(name, args, _) => {
            const arg_vals = args.map(a => eval_expr(a))
            eval_call(name, [left_val] + arg_vals)
        },
        ExprKind::EVariable(name) => {
            eval_call(name, [left_val])
        },
        ExprKind::EMethodCall(_, method, args, _) => {
            const arg_vals = args.map(a => eval_expr(a))
            eval_method_call(left_val, method, arg_vals, right_expr)
        },
        ExprKind::ELambda(_, _) => {
            const fn_val = eval_expr(right_expr)
            i_call_any(fn_val, [left_val])
        },
        _ => {
            const fn_val = eval_expr(right_expr)
            if i_is_closure(fn_val) {
                i_call_any(fn_val, [left_val])
            } else {
                fn_val
            }
        },
    }
}

// Null coalescing: x ?? default → if x is null, return default
func i_eval_null_coalesce(left_val, right_expr) {
    if left_val == null {
        eval_expr(right_expr)
    } else {
        left_val
    }
}

// Optional chaining: obj?.field → null if obj is null, else obj.field
func i_eval_optional_chain(obj_val, field) {
    if obj_val == null { return null }
    eval_field_access(obj_val, field)
}

// Optional method call: obj?.method(args) → null if obj is null
func i_eval_optional_method(obj_val, method, args) {
    if obj_val == null { return null }
    eval_method_call(obj_val, method, args, null)
}

// Spread in array: [1, ...arr, 2] → flatten spreads into array
func i_eval_array_with_spreads(elements) {
    let result = []
    for elem in elements {
        match elem.kind {
            ExprKind::ESpread(inner) => {
                const val = eval_expr(inner)
                if typeof(val) == "array" {
                    for item in val {
                        result.push(item)
                    }
                } else {
                    result.push(val)
                }
            },
            _ => {
                result.push(eval_expr(elem))
            },
        }
    }
    result
}

// Spread in map: {key: val, ...other} → merge maps
func i_eval_map_with_spreads(pairs, spreads) {
    let result = {}
    for pair in pairs {
        const k = eval_expr(pair[0])
        const v = eval_expr(pair[1])
        const key = if typeof(k) == "string" { k } else { to_string(k) }
        result[key] = v
    }
    for s in spreads {
        const val = eval_expr(s)
        if typeof(val) == "map" {
            for k in val.keys() {
                result[k] = val[k]
            }
        }
    }
    result
}

// List comprehension: [expr for x in arr if cond]
func i_eval_list_comp(elem_expr, var_name, iter_val, cond_expr) {
    let result = []
    if typeof(iter_val) != "array" {
        panic("list comprehension requires array")
    }
    for item in iter_val {
        i_push_scope()
        i_set(var_name, item, true)
        let include = true
        if cond_expr != null {
            include = i_truthy(eval_expr(cond_expr))
        }
        if include {
            result.push(eval_expr(elem_expr))
        }
        i_pop_scope()
    }
    result
}

// Map comprehension: {key_expr: val_expr for x in arr if cond}
func i_eval_map_comp(key_expr, val_expr, var_name, iter_val, cond_expr) {
    let result = {}
    if typeof(iter_val) != "array" {
        panic("map comprehension requires array")
    }
    for item in iter_val {
        i_push_scope()
        i_set(var_name, item, true)
        let include = true
        if cond_expr != null {
            include = i_truthy(eval_expr(cond_expr))
        }
        if include {
            const k = eval_expr(key_expr)
            const v = eval_expr(val_expr)
            const key = if typeof(k) == "string" { k } else { to_string(k) }
            result[key] = v
        }
        i_pop_scope()
    }
    result
}

// Range creation: 0..10 → [0, 1, 2, ..., 9], 0..=10 → [0, ..., 10]
func i_eval_range_expr(start, end_val, inclusive) {
    let result = []
    let i = start
    if inclusive {
        while i <= end_val {
            result.push(i)
            i = i + 1
        }
    } else {
        while i < end_val {
            result.push(i)
            i = i + 1
        }
    }
    result
}

// Range with step: 0..10 step 2 → [0, 2, 4, 6, 8]
func i_eval_range_step(start, end_val, step) {
    let result = []
    if step == 0 { panic("range step cannot be zero") }
    let i = start
    if step > 0 {
        while i < end_val {
            result.push(i)
            i = i + step
        }
    } else {
        while i > end_val {
            result.push(i)
            i = i + step
        }
    }
    result
}

// Type checking runtime function: val is Type
func i_type_check(val, type_name) {
    if type_name == "int" || type_name == "int64" {
        return typeof(val) == "int64"
    }
    if type_name == "float" || type_name == "float64" {
        return typeof(val) == "float64"
    }
    if type_name == "string" { return typeof(val) == "string" }
    if type_name == "bool" { return typeof(val) == "bool" }
    if type_name == "array" { return typeof(val) == "array" }
    if type_name == "map" { return typeof(val) == "map" }
    if type_name == "null" { return val == null }
    if type_name == "function" || type_name == "callable" {
        return i_is_closure(val) || (typeof(val) == "map" && val.has("params"))
    }
    // Check struct type
    if i_is_struct(val) {
        return i_struct_name(val) == type_name
    }
    // Check enum type
    if i_is_enum(val) {
        return i_enum_name(val) == type_name
    }
    false
}

// Type conversion runtime function
func i_type_convert(val, target_type) {
    if target_type == "string" { return i_display(val) }
    if target_type == "int" || target_type == "int64" { return i_to_int64(val) }
    if target_type == "float" || target_type == "float64" { return i_to_float64(val) }
    if target_type == "bool" { return i_truthy(val) }
    if target_type == "array" {
        const t = typeof(val)
        if t == "array" { return val }
        if t == "string" { return val.chars() }
        if t == "map" {
            let result = []
            for k in val.keys() {
                result.push([k, val[k]])
            }
            return result
        }
        return [val]
    }
    panic(f"cannot convert to {target_type}")
}

// Power operator: base ** exp for integers
func i_power(base, exp) {
    const bt = typeof(base)
    const et = typeof(exp)
    if bt == "int64" && et == "int64" {
        if exp < 0 { return 0 }
        if exp == 0 { return 1 }
        let result = 1
        let i = 0
        while i < exp {
            result = result * base
            i = i + 1
        }
        return result
    }
    if (bt == "float64" || bt == "int64") && (et == "float64" || et == "int64") {
        let b = if bt == "int64" { to_float64(base) } else { base }
        let e = if et == "int64" { to_float64(exp) } else { exp }
        // Simple integer exponent for float base
        if e == to_float64(to_int64(e)) {
            let result = 1.0
            let ie = to_int64(e)
            let i = 0
            while i < ie {
                result = result * b
                i = i + 1
            }
            return result
        }
        panic("fractional exponents not supported in self-hosted interpreter")
    }
    panic(f"cannot exponentiate {bt} ** {et}")
}

// Clamp a number to a range
func i_clamp(val, lo, hi) {
    if i_compare(val, lo) < 0 { return lo }
    if i_compare(val, hi) > 0 { return hi }
    val
}

// Check if value is within a range
func i_in_range(val, lo, hi) {
    i_compare(val, lo) >= 0 && i_compare(val, hi) <= 0
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 7: Concurrency — delegate to stage 0 host runtime
// ═══════════════════════════════════════════════════════════════════

// Spawn an expression: delegate to stage 0 spawn runtime
// In the self-hosted interpreter, spawn evaluates the expression eagerly
// and wraps it in a future-like map.
func i_eval_spawn(expr) {
    // Evaluate the expression in a new scope to simulate task isolation
    i_push_scope()
    const result = eval_expr(expr)
    i_pop_scope()
    {
        "__future": true,
        "__resolved": true,
        "__value": result,
    }
}

// Await a future: extract the value from a spawned task
func i_eval_await(val) {
    if typeof(val) == "map" && val.has("__future") {
        if val["__resolved"] {
            return val["__value"]
        }
        panic("cannot await unresolved future in self-hosted interpreter")
    }
    // If not a future, just return the value (transparent await)
    val
}

// Channel: create a simple synchronous channel
func i_make_channel() {
    {
        "__channel": true,
        "__buffer": [],
        "__closed": false,
    }
}

// Send to channel
func i_channel_send(ch, value) {
    if typeof(ch) != "map" || !ch.has("__channel") {
        panic("send: not a channel")
    }
    if ch["__closed"] { panic("send on closed channel") }
    let buf = ch["__buffer"]
    buf.push(value)
    ch["__buffer"] = buf
    null
}

// Receive from channel
func i_channel_recv(ch) {
    if typeof(ch) != "map" || !ch.has("__channel") {
        panic("recv: not a channel")
    }
    const buf = ch["__buffer"]
    if len(buf) == 0 {
        if ch["__closed"] { return null }
        panic("recv: channel is empty")
    }
    const val = buf[0]
    ch["__buffer"] = buf.slice(1, len(buf))
    val
}

// Close a channel
func i_channel_close(ch) {
    if typeof(ch) != "map" || !ch.has("__channel") {
        panic("close: not a channel")
    }
    ch["__closed"] = true
    null
}

// Check if a channel is empty
func i_channel_is_empty(ch) {
    if typeof(ch) != "map" || !ch.has("__channel") { return true }
    len(ch["__buffer"]) == 0
}

// Check if a channel is closed
func i_channel_is_closed(ch) {
    if typeof(ch) != "map" || !ch.has("__channel") { return true }
    ch["__closed"]
}

// Drain all values from a channel into an array
func i_channel_drain(ch) {
    if typeof(ch) != "map" || !ch.has("__channel") {
        panic("drain: not a channel")
    }
    const result = ch["__buffer"]
    ch["__buffer"] = []
    result
}

// Simple select: try multiple channel receives, return first available
func i_channel_select(channels) {
    for ch in channels {
        if typeof(ch) == "map" && ch.has("__channel") {
            const buf = ch["__buffer"]
            if len(buf) > 0 {
                return i_channel_recv(ch)
            }
        }
    }
    null
}

// Create a buffered channel with max capacity
func i_make_buffered_channel(capacity) {
    {
        "__channel": true,
        "__buffer": [],
        "__closed": false,
        "__capacity": capacity,
    }
}

// Send to buffered channel (check capacity)
func i_buffered_send(ch, value) {
    if typeof(ch) != "map" || !ch.has("__channel") {
        panic("send: not a channel")
    }
    if ch["__closed"] { panic("send on closed channel") }
    if ch.has("__capacity") {
        const cap = ch["__capacity"]
        if len(ch["__buffer"]) >= cap {
            panic("channel buffer full")
        }
    }
    let buf = ch["__buffer"]
    buf.push(value)
    ch["__buffer"] = buf
    null
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 8: Iterator Protocol — for-in, map, filter, reduce,
//            enumerate, zip, flatten, take, skip, chain, chunks
// ═══════════════════════════════════════════════════════════════════

// Iterate over a value (arrays, maps, strings, ranges)
func i_iter_to_array(val) {
    const t = typeof(val)
    if t == "array" { return val }
    if t == "string" { return val.chars() }
    if t == "map" {
        if val.has("__range_start") {
            return i_eval_range_expr(val["__range_start"], val["__range_end"], val["__range_inclusive"])
        }
        let result = []
        for k in val.keys() {
            result.push([k, val[k]])
        }
        return result
    }
    [val]
}

// Map: apply a function to each element
func i_iter_map(arr, fn_val) {
    let result = []
    for item in arr {
        result.push(i_call_any(fn_val, [item]))
    }
    result
}

// Filter: keep elements that satisfy a predicate
func i_iter_filter(arr, fn_val) {
    let result = []
    for item in arr {
        if i_truthy(i_call_any(fn_val, [item])) {
            result.push(item)
        }
    }
    result
}

// Reduce: fold an array into a single value
func i_iter_reduce(arr, fn_val, initial) {
    let acc = initial
    for item in arr {
        acc = i_call_any(fn_val, [acc, item])
    }
    acc
}

// Enumerate: pair each element with its index
func i_iter_enumerate(arr) {
    let result = []
    let i = 0
    for item in arr {
        result.push([i, item])
        i = i + 1
    }
    result
}

// Zip: combine two arrays into pairs
func i_iter_zip(a, b) {
    let result = []
    const min_len = if len(a) < len(b) { len(a) } else { len(b) }
    let i = 0
    while i < min_len {
        result.push([a[i], b[i]])
        i = i + 1
    }
    result
}

// Flatten: flatten one level of nesting
func i_iter_flatten(arr) {
    let result = []
    for item in arr {
        if typeof(item) == "array" {
            for sub in item {
                result.push(sub)
            }
        } else {
            result.push(item)
        }
    }
    result
}

// Take: return first n elements
func i_iter_take(arr, n) {
    if n >= len(arr) { return arr }
    arr.slice(0, n)
}

// Skip/Drop: skip first n elements
func i_iter_skip(arr, n) {
    if n >= len(arr) { return [] }
    arr.slice(n, len(arr))
}

// Take while predicate is true
func i_iter_take_while(arr, fn_val) {
    let result = []
    for item in arr {
        if !i_truthy(i_call_any(fn_val, [item])) { break }
        result.push(item)
    }
    result
}

// Skip while predicate is true
func i_iter_skip_while(arr, fn_val) {
    let result = []
    let skipping = true
    for item in arr {
        if skipping {
            if !i_truthy(i_call_any(fn_val, [item])) {
                skipping = false
                result.push(item)
            }
        } else {
            result.push(item)
        }
    }
    result
}

// Chain: concatenate multiple arrays
func i_iter_chain(arrays) {
    let result = []
    for arr in arrays {
        if typeof(arr) == "array" {
            for item in arr {
                result.push(item)
            }
        } else {
            result.push(arr)
        }
    }
    result
}

// Chunks: split array into sub-arrays of size n
func i_iter_chunks(arr, size) {
    if size <= 0 { panic("chunk size must be positive") }
    let result = []
    let i = 0
    while i < len(arr) {
        const end = if i + size < len(arr) { i + size } else { len(arr) }
        result.push(arr.slice(i, end))
        i = i + size
    }
    result
}

// Windows: sliding window of size n
func i_iter_windows(arr, size) {
    if size <= 0 { panic("window size must be positive") }
    if size > len(arr) { return [] }
    let result = []
    let i = 0
    while i + size <= len(arr) {
        result.push(arr.slice(i, i + size))
        i = i + 1
    }
    result
}

// Unique/Distinct: remove duplicates (preserving first occurrence order)
func i_iter_unique(arr) {
    let seen = {"__init": true}
    let result = []
    for item in arr {
        const key = i_display(item)
        if !seen.has(key) {
            seen[key] = true
            result.push(item)
        }
    }
    result
}

// Group by: group elements by a key function
func i_iter_group_by(arr, fn_val) {
    let groups = {}
    for item in arr {
        const key = i_display(i_call_any(fn_val, [item]))
        if !groups.has(key) {
            groups[key] = []
        }
        let g = groups[key]
        g.push(item)
        groups[key] = g
    }
    groups
}

// Sort by: sort using a key function
func i_iter_sort_by(arr, fn_val) {
    // Simple insertion sort using the key function
    let keyed = []
    for item in arr {
        const key = i_call_any(fn_val, [item])
        keyed.push([key, item])
    }
    // Insertion sort on keys
    let i = 1
    while i < len(keyed) {
        let j = i
        while j > 0 && i_compare(keyed[j - 1][0], keyed[j][0]) > 0 {
            const tmp = keyed[j - 1]
            keyed[j - 1] = keyed[j]
            keyed[j] = tmp
            j = j - 1
        }
        i = i + 1
    }
    keyed.map(pair => pair[1])
}

// Flat map: map then flatten
func i_iter_flat_map(arr, fn_val) {
    i_iter_flatten(i_iter_map(arr, fn_val))
}

// Sum: sum all numeric elements
func i_iter_sum(arr) {
    let total = 0
    for item in arr {
        total = i_add(total, item)
    }
    total
}

// Product: multiply all numeric elements
func i_iter_product(arr) {
    let total = 1
    for item in arr {
        total = i_mul(total, item)
    }
    total
}

// Min element
func i_iter_min(arr) {
    if len(arr) == 0 { return null }
    let m = arr[0]
    let i = 1
    while i < len(arr) {
        if i_compare(arr[i], m) < 0 {
            m = arr[i]
        }
        i = i + 1
    }
    m
}

// Max element
func i_iter_max(arr) {
    if len(arr) == 0 { return null }
    let m = arr[0]
    let i = 1
    while i < len(arr) {
        if i_compare(arr[i], m) > 0 {
            m = arr[i]
        }
        i = i + 1
    }
    m
}

// Count elements matching a predicate
func i_iter_count(arr, fn_val) {
    let c = 0
    for item in arr {
        if i_truthy(i_call_any(fn_val, [item])) {
            c = c + 1
        }
    }
    c
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 9: Labeled Loops — track loop labels, break/continue 'label
// ═══════════════════════════════════════════════════════════════════

// Loop label stack: each entry is a label string
let i_loop_labels = []

// Push a loop label onto the stack
func i_push_loop_label(label) {
    i_loop_labels.push(label)
}

// Pop the top loop label
func i_pop_loop_label() {
    if len(i_loop_labels) > 0 {
        i_loop_labels.pop()
    }
}

// Get the current (innermost) loop label
func i_current_loop_label() {
    if len(i_loop_labels) > 0 {
        return i_loop_labels[len(i_loop_labels) - 1]
    }
    ""
}

// Check if a label exists in the loop label stack
func i_has_loop_label(label) {
    if label == "" { return true }
    for l in i_loop_labels {
        if l == label { return true }
    }
    false
}

// Create a break signal with an optional label
func make_labeled_break_signal(label) {
    {"__signal": BREAK_SIGNAL, "__label": label}
}

// Create a continue signal with an optional label
func make_labeled_continue_signal(label) {
    {"__signal": CONTINUE_SIGNAL, "__label": label}
}

// Check if a break signal targets a specific label
func is_labeled_break(val, label) {
    if !is_break(val) { return false }
    if label == "" { return true }
    if typeof(val) != "map" { return false }
    if !val.has("__label") { return true }
    val["__label"] == "" || val["__label"] == label
}

// Check if a continue signal targets a specific label
func is_labeled_continue(val, label) {
    if !is_continue(val) { return false }
    if label == "" { return true }
    if typeof(val) != "map" { return false }
    if !val.has("__label") { return true }
    val["__label"] == "" || val["__label"] == label
}

// Evaluate a labeled while loop
func eval_labeled_while(label, cond, body) {
    i_push_loop_label(label)
    let result = null
    while true {
        const cond_val = eval_expr(cond)
        if !i_truthy(cond_val) { break }
        const r = eval_block(body)
        if is_labeled_break(r, label) { break }
        if is_labeled_continue(r, label) { continue }
        if is_return(r) {
            i_pop_loop_label()
            return r
        }
        // If it's a break/continue for an outer label, propagate
        if is_break(r) || is_continue(r) {
            i_pop_loop_label()
            return r
        }
        result = r
    }
    i_pop_loop_label()
    result
}

// Evaluate a labeled for loop
func eval_labeled_for(label, var_name, iter_val, body) {
    i_push_loop_label(label)
    let result = null
    if typeof(iter_val) != "array" {
        const converted = i_iter_to_array(iter_val)
        for item in converted {
            i_push_scope()
            i_set(var_name, item, true)
            const r = eval_block(body)
            i_pop_scope()
            if is_labeled_break(r, label) { break }
            if is_labeled_continue(r, label) { continue }
            if is_return(r) {
                i_pop_loop_label()
                return r
            }
            if is_break(r) || is_continue(r) {
                i_pop_loop_label()
                return r
            }
            result = r
        }
    } else {
        for item in iter_val {
            i_push_scope()
            i_set(var_name, item, true)
            const r = eval_block(body)
            i_pop_scope()
            if is_labeled_break(r, label) { break }
            if is_labeled_continue(r, label) { continue }
            if is_return(r) {
                i_pop_loop_label()
                return r
            }
            if is_break(r) || is_continue(r) {
                i_pop_loop_label()
                return r
            }
            result = r
        }
    }
    i_pop_loop_label()
    result
}

// Evaluate a labeled loop (infinite)
func eval_labeled_loop(label, body) {
    i_push_loop_label(label)
    let result = null
    while true {
        const r = eval_block(body)
        if is_labeled_break(r, label) {
            result = signal_value(r)
            break
        }
        if is_labeled_continue(r, label) { continue }
        if is_return(r) {
            i_pop_loop_label()
            return r
        }
        if is_break(r) || is_continue(r) {
            i_pop_loop_label()
            return r
        }
        result = r
    }
    i_pop_loop_label()
    result
}

// Get the depth of nested labeled loops
func i_loop_depth() {
    len(i_loop_labels)
}

// Clear all loop labels (for error recovery)
func i_clear_loop_labels() {
    i_loop_labels = []
}

// Check if we are inside any loop
func i_in_loop() {
    len(i_loop_labels) > 0
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 10: Defer — track deferred expressions, execute on exit
// ═══════════════════════════════════════════════════════════════════

// Defer stack: each function frame has a list of deferred expressions
let i_defer_stack = []

// Push a new defer frame (called on function entry)
func i_push_defer_frame() {
    i_defer_stack.push([])
}

// Pop and execute all deferred expressions (called on function exit)
func i_pop_defer_frame() {
    if len(i_defer_stack) == 0 { return null }
    const deferred = i_defer_stack.pop()
    let last = null
    // Execute in reverse order (LIFO)
    let i = len(deferred) - 1
    while i >= 0 {
        last = eval_expr(deferred[i])
        i = i - 1
    }
    last
}

// Add a deferred expression to the current frame
func i_add_defer(expr) {
    if len(i_defer_stack) == 0 {
        // If no frame, create one at the top level
        i_defer_stack.push([])
    }
    const idx = len(i_defer_stack) - 1
    let frame = i_defer_stack[idx]
    frame.push(expr)
    i_defer_stack[idx] = frame
}

// Execute deferred expressions without popping the frame (for early return)
func i_execute_defers() {
    if len(i_defer_stack) == 0 { return null }
    const idx = len(i_defer_stack) - 1
    const deferred = i_defer_stack[idx]
    let last = null
    let i = len(deferred) - 1
    while i >= 0 {
        last = eval_expr(deferred[i])
        i = i - 1
    }
    last
}

// Call a user function with defer support
func call_user_func_with_defer(func_info, args) {
    i_push_defer_frame()
    i_push_scope()
    const params = func_info["params"]
    let idx = 0
    while idx < len(params) {
        const p = params[idx]
        let val = null
        if idx < len(args) {
            val = args[idx]
        } else if p.default_val != null {
            val = eval_expr(p.default_val)
        }
        if p.rest {
            val = args.slice(idx, len(args))
        }
        i_set(p.name, val, true)
        idx = idx + 1
    }
    const result = eval_block(func_info["body"])
    i_pop_scope()
    // Execute deferred expressions
    i_pop_defer_frame()
    if is_return(result) {
        return signal_value(result)
    }
    result
}

// Check if there are any pending deferred expressions
func i_has_defers() {
    if len(i_defer_stack) == 0 { return false }
    const idx = len(i_defer_stack) - 1
    len(i_defer_stack[idx]) > 0
}

// Count pending deferred expressions
func i_defer_count() {
    if len(i_defer_stack) == 0 { return 0 }
    const idx = len(i_defer_stack) - 1
    len(i_defer_stack[idx])
}

// Clear all deferred expressions in the current frame
func i_clear_defers() {
    if len(i_defer_stack) == 0 { return null }
    const idx = len(i_defer_stack) - 1
    i_defer_stack[idx] = []
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 11: Let Destructuring — array, map, tuple destructuring
// ═══════════════════════════════════════════════════════════════════

// Evaluate a let destructure statement
func eval_let_destructure(pattern, mutable, value) {
    match pattern {
        DestructurePattern::DArray(elements) => {
            if typeof(value) != "array" {
                panic("cannot destructure non-array value with array pattern")
            }
            let idx = 0
            for elem in elements {
                match elem {
                    DestructureElement::DName(name) => {
                        if name != "_" {
                            const val = if idx < len(value) { value[idx] } else { null }
                            i_set(name, val, mutable)
                        }
                        idx = idx + 1
                    },
                    DestructureElement::DRest(name) => {
                        if name != "_" {
                            const rest = value.slice(idx, len(value))
                            i_set(name, rest, mutable)
                        }
                        idx = len(value)
                    },
                }
            }
        },
        DestructurePattern::DMap(pairs) => {
            if typeof(value) != "map" {
                panic("cannot destructure non-map value with map pattern")
            }
            for pair in pairs {
                const key = pair[0]
                const name = pair[1]
                if name != "_" {
                    const val = if value.has(key) { value[key] } else { null }
                    i_set(name, val, mutable)
                }
            }
        },
        DestructurePattern::DTuple(names) => {
            if typeof(value) != "array" {
                panic("cannot destructure non-tuple value with tuple pattern")
            }
            let idx = 0
            for name in names {
                if name != "_" {
                    const val = if idx < len(value) { value[idx] } else { null }
                    i_set(name, val, mutable)
                }
                idx = idx + 1
            }
        },
    }
}

// Evaluate a tuple assignment: (a, b) = expr
func eval_tuple_assign(names, value) {
    if typeof(value) != "array" {
        panic("tuple assignment requires array value")
    }
    let idx = 0
    for name in names {
        if name != "_" {
            const val = if idx < len(value) { value[idx] } else { null }
            i_update(name, val)
        }
        idx = idx + 1
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 12: Extended Builtins — additional built-in functions
//             for the self-hosted interpreter
// ═══════════════════════════════════════════════════════════════════

// Extended eval_call: additional built-in functions
func eval_builtin_extended(name, args) {
    if name == "typeof" || name == "type_of" {
        if len(args) != 1 { panic("typeof() takes 1 argument") }
        const val = args[0]
        if i_is_struct(val) { return i_struct_name(val) }
        if i_is_enum(val) { return i_enum_name(val) }
        if i_is_closure(val) { return "function" }
        return typeof(val)
    }

    if name == "is_null" {
        if len(args) != 1 { panic("is_null() takes 1 argument") }
        return args[0] == null
    }

    if name == "is_int" {
        if len(args) != 1 { panic("is_int() takes 1 argument") }
        return typeof(args[0]) == "int64"
    }

    if name == "is_float" {
        if len(args) != 1 { panic("is_float() takes 1 argument") }
        return typeof(args[0]) == "float64"
    }

    if name == "is_string" {
        if len(args) != 1 { panic("is_string() takes 1 argument") }
        return typeof(args[0]) == "string"
    }

    if name == "is_bool" {
        if len(args) != 1 { panic("is_bool() takes 1 argument") }
        return typeof(args[0]) == "bool"
    }

    if name == "is_array" {
        if len(args) != 1 { panic("is_array() takes 1 argument") }
        return typeof(args[0]) == "array"
    }

    if name == "is_map" {
        if len(args) != 1 { panic("is_map() takes 1 argument") }
        return typeof(args[0]) == "map"
    }

    if name == "keys" {
        if len(args) != 1 { panic("keys() takes 1 argument") }
        if typeof(args[0]) != "map" { panic("keys() requires map") }
        return args[0].keys()
    }

    if name == "values" {
        if len(args) != 1 { panic("values() takes 1 argument") }
        if typeof(args[0]) != "map" { panic("values() requires map") }
        return args[0].values()
    }

    if name == "entries" {
        if len(args) != 1 { panic("entries() takes 1 argument") }
        if typeof(args[0]) != "map" { panic("entries() requires map") }
        let result = []
        const m = args[0]
        for k in m.keys() {
            result.push([k, m[k]])
        }
        return result
    }

    if name == "from_entries" {
        if len(args) != 1 { panic("from_entries() takes 1 argument") }
        if typeof(args[0]) != "array" { panic("from_entries() requires array of pairs") }
        let result = {}
        for pair in args[0] {
            if typeof(pair) == "array" && len(pair) >= 2 {
                const k = if typeof(pair[0]) == "string" { pair[0] } else { to_string(pair[0]) }
                result[k] = pair[1]
            }
        }
        return result
    }

    if name == "zip" {
        if len(args) != 2 { panic("zip() takes 2 arguments") }
        return i_iter_zip(args[0], args[1])
    }

    if name == "enumerate" {
        if len(args) != 1 { panic("enumerate() takes 1 argument") }
        return i_iter_enumerate(args[0])
    }

    if name == "flatten" {
        if len(args) != 1 { panic("flatten() takes 1 argument") }
        return i_iter_flatten(args[0])
    }

    if name == "sum" {
        if len(args) != 1 { panic("sum() takes 1 argument") }
        return i_iter_sum(args[0])
    }

    if name == "product" {
        if len(args) != 1 { panic("product() takes 1 argument") }
        return i_iter_product(args[0])
    }

    if name == "reversed" {
        if len(args) != 1 { panic("reversed() takes 1 argument") }
        if typeof(args[0]) == "array" { return args[0].reverse() }
        if typeof(args[0]) == "string" { return args[0].reverse() }
        panic("reversed() requires array or string")
    }

    if name == "sorted" {
        if len(args) != 1 { panic("sorted() takes 1 argument") }
        if typeof(args[0]) == "array" { return args[0].sort() }
        panic("sorted() requires array")
    }

    if name == "chunks" {
        if len(args) != 2 { panic("chunks() takes 2 arguments") }
        return i_iter_chunks(args[0], args[1])
    }

    if name == "take" {
        if len(args) != 2 { panic("take() takes 2 arguments") }
        return i_iter_take(args[0], args[1])
    }

    if name == "skip" {
        if len(args) != 2 { panic("skip() takes 2 arguments") }
        return i_iter_skip(args[0], args[1])
    }

    if name == "unique" {
        if len(args) != 1 { panic("unique() takes 1 argument") }
        return i_iter_unique(args[0])
    }

    if name == "repeat" {
        if len(args) == 2 {
            const val = args[0]
            const count = args[1]
            if typeof(val) == "string" { return i_str_repeat(val, count) }
            let result = []
            let i = 0
            while i < count {
                result.push(val)
                i = i + 1
            }
            return result
        }
        panic("repeat() takes 2 arguments")
    }

    if name == "power" || name == "pow" {
        if len(args) != 2 { panic("pow() takes 2 arguments") }
        return i_power(args[0], args[1])
    }

    if name == "clamp" {
        if len(args) != 3 { panic("clamp() takes 3 arguments") }
        return i_clamp(args[0], args[1], args[2])
    }

    if name == "hex" {
        if len(args) != 1 { panic("hex() takes 1 argument") }
        return i_int_to_hex(args[0])
    }

    if name == "bin" {
        if len(args) != 1 { panic("bin() takes 1 argument") }
        return i_int_to_bin(args[0])
    }

    // Return a sentinel to indicate "not a builtin"
    "__not_builtin__"
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 13: Extended Method Dispatch — find_index, every, some,
//             flat_map, index_of, last_index_of, count, partition
// ═══════════════════════════════════════════════════════════════════

// Extended method dispatch for arrays
func eval_array_method_extended(obj, method, args, obj_expr) {
    if method == "find" {
        if len(args) != 1 { panic("find() takes 1 argument") }
        const fn_val = args[0]
        return i_find_with(fn_val, obj)
    }
    if method == "find_index" {
        if len(args) != 1 { panic("find_index() takes 1 argument") }
        const fn_val = args[0]
        let idx = 0
        for item in obj {
            if i_truthy(i_call_any(fn_val, [item])) { return idx }
            idx = idx + 1
        }
        return -1
    }
    if method == "every" || method == "all" {
        if len(args) != 1 { panic("every() takes 1 argument") }
        return i_all_with(args[0], obj)
    }
    if method == "some" || method == "any" {
        if len(args) != 1 { panic("some() takes 1 argument") }
        return i_any_with(args[0], obj)
    }
    if method == "flat_map" || method == "flatMap" {
        if len(args) != 1 { panic("flat_map() takes 1 argument") }
        return i_iter_flat_map(obj, args[0])
    }
    if method == "index_of" || method == "indexOf" {
        if len(args) != 1 { panic("index_of() takes 1 argument") }
        let idx = 0
        for item in obj {
            if item == args[0] { return idx }
            idx = idx + 1
        }
        return -1
    }
    if method == "last_index_of" || method == "lastIndexOf" {
        if len(args) != 1 { panic("last_index_of() takes 1 argument") }
        let last = -1
        let idx = 0
        for item in obj {
            if item == args[0] { last = idx }
            idx = idx + 1
        }
        return last
    }
    if method == "count" {
        if len(args) == 0 { return len(obj) }
        if len(args) == 1 {
            return i_iter_count(obj, args[0])
        }
        panic("count() takes 0 or 1 argument")
    }
    if method == "partition" {
        if len(args) != 1 { panic("partition() takes 1 argument") }
        const fn_val = args[0]
        let yes = []
        let no = []
        for item in obj {
            if i_truthy(i_call_any(fn_val, [item])) {
                yes.push(item)
            } else {
                no.push(item)
            }
        }
        return [yes, no]
    }
    if method == "take" {
        if len(args) != 1 { panic("take() takes 1 argument") }
        return i_iter_take(obj, args[0])
    }
    if method == "skip" || method == "drop" {
        if len(args) != 1 { panic("skip() takes 1 argument") }
        return i_iter_skip(obj, args[0])
    }
    if method == "take_while" || method == "takeWhile" {
        if len(args) != 1 { panic("take_while() takes 1 argument") }
        return i_iter_take_while(obj, args[0])
    }
    if method == "skip_while" || method == "skipWhile" {
        if len(args) != 1 { panic("skip_while() takes 1 argument") }
        return i_iter_skip_while(obj, args[0])
    }
    if method == "chunks" {
        if len(args) != 1 { panic("chunks() takes 1 argument") }
        return i_iter_chunks(obj, args[0])
    }
    if method == "windows" {
        if len(args) != 1 { panic("windows() takes 1 argument") }
        return i_iter_windows(obj, args[0])
    }
    if method == "unique" || method == "distinct" {
        return i_iter_unique(obj)
    }
    if method == "group_by" || method == "groupBy" {
        if len(args) != 1 { panic("group_by() takes 1 argument") }
        return i_iter_group_by(obj, args[0])
    }
    if method == "sort_by" || method == "sortBy" {
        if len(args) != 1 { panic("sort_by() takes 1 argument") }
        return i_iter_sort_by(obj, args[0])
    }
    if method == "sum" {
        return i_iter_sum(obj)
    }
    if method == "product" {
        return i_iter_product(obj)
    }
    if method == "min" {
        return i_iter_min(obj)
    }
    if method == "max" {
        return i_iter_max(obj)
    }
    if method == "zip" {
        if len(args) != 1 { panic("zip() takes 1 argument") }
        return i_iter_zip(obj, args[0])
    }
    if method == "flat" || method == "flatten" {
        return i_iter_flatten(obj)
    }
    if method == "first" {
        if len(obj) == 0 { return null }
        return obj[0]
    }
    if method == "last" {
        if len(obj) == 0 { return null }
        return obj[len(obj) - 1]
    }
    if method == "is_empty" || method == "isEmpty" {
        return len(obj) == 0
    }
    // Not handled
    null
}

// Extended method dispatch for strings
func eval_string_method_extended(obj, method, args) {
    if method == "repeat" {
        if len(args) != 1 { panic("repeat() takes 1 argument") }
        return i_str_repeat(obj, args[0])
    }
    if method == "center" {
        if len(args) != 1 { panic("center() takes 1 argument") }
        return i_str_center(obj, args[0])
    }
    if method == "truncate" {
        if len(args) != 1 { panic("truncate() takes 1 argument") }
        return i_str_truncate(obj, args[0])
    }
    if method == "pad_left" || method == "padStart" {
        if len(args) != 1 { panic("pad_left() takes 1 argument") }
        return i_pad_left(obj, args[0])
    }
    if method == "pad_right" || method == "padEnd" {
        if len(args) != 1 { panic("pad_right() takes 1 argument") }
        return i_pad_right(obj, args[0])
    }
    if method == "is_empty" || method == "isEmpty" {
        return len(obj) == 0
    }
    if method == "reverse" {
        return obj.reverse()
    }
    if method == "index_of" || method == "indexOf" {
        if len(args) != 1 { panic("index_of() takes 1 argument") }
        // Linear scan for substring
        const sub = if typeof(args[0]) == "string" { args[0] } else { to_string(args[0]) }
        const sub_len = len(sub)
        let i = 0
        while i + sub_len <= len(obj) {
            if obj.slice(i, i + sub_len) == sub { return i }
            i = i + 1
        }
        return -1
    }
    if method == "count" {
        if len(args) != 1 { panic("count() takes 1 argument") }
        const sub = if typeof(args[0]) == "string" { args[0] } else { to_string(args[0]) }
        if len(sub) == 0 { return 0 }
        let c = 0
        let i = 0
        while i + len(sub) <= len(obj) {
            if obj.slice(i, i + len(sub)) == sub {
                c = c + 1
                i = i + len(sub)
            } else {
                i = i + 1
            }
        }
        return c
    }
    // Not handled
    null
}

// Extended method dispatch for maps
func eval_map_method_extended(obj, method, args, obj_expr) {
    if method == "entries" {
        let result = []
        for k in obj.keys() {
            result.push([k, obj[k]])
        }
        return result
    }
    if method == "merge" || method == "extend" {
        if len(args) != 1 { panic("merge() takes 1 argument") }
        const other = args[0]
        if typeof(other) != "map" { panic("merge() requires map argument") }
        let result = {}
        for k in obj.keys() { result[k] = obj[k] }
        for k in other.keys() { result[k] = other[k] }
        return result
    }
    if method == "get" {
        if len(args) < 1 { panic("get() requires at least 1 argument") }
        const key = if typeof(args[0]) == "string" { args[0] } else { to_string(args[0]) }
        if obj.has(key) { return obj[key] }
        if len(args) > 1 { return args[1] }
        return null
    }
    if method == "set" {
        if len(args) != 2 { panic("set() takes 2 arguments") }
        const key = if typeof(args[0]) == "string" { args[0] } else { to_string(args[0]) }
        obj[key] = args[1]
        match obj_expr.kind {
            ExprKind::EVariable(name) => i_update(name, obj),
            _ => {},
        }
        return obj
    }
    if method == "is_empty" || method == "isEmpty" {
        return len(obj) == 0
    }
    if method == "count" {
        return len(obj)
    }
    if method == "filter" {
        if len(args) != 1 { panic("filter() takes 1 argument") }
        const fn_val = args[0]
        let result = {}
        for k in obj.keys() {
            if i_truthy(i_call_any(fn_val, [k, obj[k]])) {
                result[k] = obj[k]
            }
        }
        return result
    }
    if method == "map" {
        if len(args) != 1 { panic("map() takes 1 argument") }
        const fn_val = args[0]
        let result = {}
        for k in obj.keys() {
            result[k] = i_call_any(fn_val, [k, obj[k]])
        }
        return result
    }
    // Not handled
    null
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 14: For-in Pattern Destructuring — [k, v] in map, etc.
// ═══════════════════════════════════════════════════════════════════

// Evaluate for-in with destructuring patterns
func eval_for_destructure(pattern, iter_val, body) {
    let result = null
    match pattern {
        ForPattern::Single(name) => {
            const items = i_iter_to_array(iter_val)
            for item in items {
                i_push_scope()
                i_set(name, item, true)
                const r = eval_block(body)
                i_pop_scope()
                if is_break(r) { break }
                if is_continue(r) { continue }
                if is_return(r) { return r }
                result = r
            }
        },
        ForPattern::ArrayDestructure(names) => {
            const items = i_iter_to_array(iter_val)
            for item in items {
                i_push_scope()
                if typeof(item) == "array" {
                    let idx = 0
                    for n in names {
                        if n != "_" {
                            const val = if idx < len(item) { item[idx] } else { null }
                            i_set(n, val, true)
                        }
                        idx = idx + 1
                    }
                } else {
                    // Single value, bind to first name
                    if len(names) > 0 && names[0] != "_" {
                        i_set(names[0], item, true)
                    }
                }
                const r = eval_block(body)
                i_pop_scope()
                if is_break(r) { break }
                if is_continue(r) { continue }
                if is_return(r) { return r }
                result = r
            }
        },
        ForPattern::MapDestructure(names) => {
            const items = i_iter_to_array(iter_val)
            for item in items {
                i_push_scope()
                if typeof(item) == "array" && len(item) >= 2 {
                    if len(names) > 0 && names[0] != "_" {
                        i_set(names[0], item[0], true)
                    }
                    if len(names) > 1 && names[1] != "_" {
                        i_set(names[1], item[1], true)
                    }
                }
                const r = eval_block(body)
                i_pop_scope()
                if is_break(r) { break }
                if is_continue(r) { continue }
                if is_return(r) { return r }
                result = r
            }
        },
    }
    result
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 15: String Methods Extended — additional string operations
// ═══════════════════════════════════════════════════════════════════

// Check if a string matches a simple glob pattern (supports * and ?)
func i_str_glob_match(s, pattern) {
    let si = 0
    let pi = 0
    let star_p = -1
    let star_s = -1

    while si < len(s) {
        if pi < len(pattern) && (pattern[pi] == s[si] || pattern[pi] == "?") {
            si = si + 1
            pi = pi + 1
        } else if pi < len(pattern) && pattern[pi] == "*" {
            star_p = pi
            star_s = si
            pi = pi + 1
        } else if star_p != -1 {
            pi = star_p + 1
            star_s = star_s + 1
            si = star_s
        } else {
            return false
        }
    }

    while pi < len(pattern) && pattern[pi] == "*" {
        pi = pi + 1
    }

    pi == len(pattern)
}

// Capitalize first letter of string
func i_str_capitalize(s) {
    if len(s) == 0 { return s }
    const first = s[0]
    const rest = if len(s) > 1 { s.slice(1, len(s)) } else { "" }
    first.to_upper() + rest
}

// Title case: capitalize first letter of each word
func i_str_title_case(s) {
    const words = s.split(" ")
    const titled = words.map(w => i_str_capitalize(w))
    titled.join(" ")
}

// Check if string is all uppercase
func i_str_is_upper(s) {
    s == s.to_upper()
}

// Check if string is all lowercase
func i_str_is_lower(s) {
    s == s.to_lower()
}

// Check if string is numeric
func i_str_is_numeric(s) {
    if len(s) == 0 { return false }
    let has_dot = false
    let i = 0
    if s[0] == "-" || s[0] == "+" { i = 1 }
    while i < len(s) {
        const ch = s[i]
        if ch == "." {
            if has_dot { return false }
            has_dot = true
        } else if ch < "0" || ch > "9" {
            return false
        }
        i = i + 1
    }
    true
}

// Strip prefix from string
func i_str_strip_prefix(s, prefix) {
    if s.starts_with(prefix) {
        return s.slice(len(prefix), len(s))
    }
    s
}

// Strip suffix from string
func i_str_strip_suffix(s, suffix) {
    if s.ends_with(suffix) {
        return s.slice(0, len(s) - len(suffix))
    }
    s
}

// Left trim specific characters
func i_str_ltrim(s, chars) {
    let i = 0
    while i < len(s) && chars.contains(s[i]) {
        i = i + 1
    }
    s.slice(i, len(s))
}

// Right trim specific characters
func i_str_rtrim(s, chars) {
    let i = len(s) - 1
    while i >= 0 && chars.contains(s[i]) {
        i = i - 1
    }
    s.slice(0, i + 1)
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 16: Math Builtins — numeric operations for the interpreter
// ═══════════════════════════════════════════════════════════════════

// Greatest common divisor
func i_math_gcd(a, b) {
    let x = if a < 0 { 0 - a } else { a }
    let y = if b < 0 { 0 - b } else { b }
    while y != 0 {
        const temp = y
        y = x % y
        x = temp
    }
    x
}

// Least common multiple
func i_math_lcm(a, b) {
    if a == 0 || b == 0 { return 0 }
    const g = i_math_gcd(a, b)
    let a_abs = if a < 0 { 0 - a } else { a }
    (a_abs / g) * (if b < 0 { 0 - b } else { b })
}

// Factorial
func i_math_factorial(n) {
    if n < 0 { panic("factorial of negative number") }
    if n <= 1 { return 1 }
    let result = 1
    let i = 2
    while i <= n {
        result = result * i
        i = i + 1
    }
    result
}

// Fibonacci
func i_math_fib(n) {
    if n <= 0 { return 0 }
    if n == 1 { return 1 }
    let a = 0
    let b = 1
    let i = 2
    while i <= n {
        const temp = a + b
        a = b
        b = temp
        i = i + 1
    }
    b
}

// Is prime check
func i_math_is_prime(n) {
    if n < 2 { return false }
    if n < 4 { return true }
    if n % 2 == 0 { return false }
    if n % 3 == 0 { return false }
    let i = 5
    while i * i <= n {
        if n % i == 0 { return false }
        if n % (i + 2) == 0 { return false }
        i = i + 6
    }
    true
}

// Integer square root (floor)
func i_math_isqrt(n) {
    if n < 0 { panic("sqrt of negative number") }
    if n == 0 { return 0 }
    let x = n
    let y = (x + 1) / 2
    while y < x {
        x = y
        y = (x + n / x) / 2
    }
    x
}

// Sign function: returns -1, 0, or 1
func i_math_sign(n) {
    if n > 0 { return 1 }
    if n < 0 { return -1 }
    0
}

// Divmod: returns [quotient, remainder]
func i_math_divmod(a, b) {
    if b == 0 { panic("division by zero") }
    [a / b, a % b]
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 17: Error Handling — try/catch, result types, error propagation
// ═══════════════════════════════════════════════════════════════════

// Create an Ok result value
func i_ok(val) {
    {"__result": true, "__ok": true, "__value": val}
}

// Create an Err result value
func i_err(msg) {
    {"__result": true, "__ok": false, "__error": msg}
}

// Check if a value is a Result
func i_is_result(val) {
    if val == null { return false }
    if typeof(val) != "map" { return false }
    val.has("__result")
}

// Check if a Result is Ok
func i_is_ok(val) {
    if !i_is_result(val) { return false }
    val["__ok"]
}

// Check if a Result is Err
func i_is_err(val) {
    if !i_is_result(val) { return false }
    !val["__ok"]
}

// Unwrap an Ok result (panics on Err)
func i_unwrap(val) {
    if !i_is_result(val) { return val }
    if val["__ok"] { return val["__value"] }
    panic(f"unwrap on Err: {val[\"__error\"]}")
}

// Unwrap an Ok result or return a default
func i_unwrap_or(val, default_val) {
    if !i_is_result(val) { return val }
    if val["__ok"] { return val["__value"] }
    default_val
}

// Map over an Ok result
func i_result_map(val, fn_val) {
    if !i_is_result(val) { return val }
    if val["__ok"] {
        return i_ok(i_call_any(fn_val, [val["__value"]]))
    }
    val
}

// Map over an Err result
func i_result_map_err(val, fn_val) {
    if !i_is_result(val) { return val }
    if !val["__ok"] {
        return i_err(i_call_any(fn_val, [val["__error"]]))
    }
    val
}

// Flat map (and_then) for Result
func i_result_and_then(val, fn_val) {
    if !i_is_result(val) { return val }
    if val["__ok"] {
        return i_call_any(fn_val, [val["__value"]])
    }
    val
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 18: Module/Import Support — module eval, import resolution
// ═══════════════════════════════════════════════════════════════════

// Module registry: maps module paths to their exported values
let i_modules = {"__init": true}

// Register a module with its exports
func i_register_module(path, exports) {
    i_modules[path] = exports
}

// Check if a module is registered
func i_has_module(path) {
    i_modules.has(path) && path != "__init"
}

// Get exports from a module
func i_get_module(path) {
    if !i_has_module(path) {
        panic(f"module not found: {path}")
    }
    i_modules[path]
}

// Evaluate a module block and collect its exports
func eval_module_block(name, body) {
    i_push_scope()
    let exports = {"__module": name}

    for s in body.stmts {
        const result = eval_stmt(s)
        if is_signal(result) { break }
    }

    // Collect all bindings from the module scope as exports
    const scope = i_scopes[len(i_scopes) - 1]
    for k in scope.keys() {
        if k != "__s" {
            const entry = scope[k]
            exports[k] = entry["value"]
        }
    }

    // Also collect functions defined in the module
    for k in i_functions.keys() {
        if k != "__init" {
            exports[k] = i_functions[k]
        }
    }

    i_pop_scope()

    // Register the module
    i_register_module(name, exports)
    exports
}

// Import specific items from a module into the current scope
func eval_import_items(module_path, items) {
    const exports = i_get_module(module_path)
    for item in items {
        if exports.has(item) {
            i_set(item, exports[item], false)
        } else {
            panic(f"module '{module_path}' does not export '{item}'")
        }
    }
}

// Import all items from a module into the current scope
func eval_import_all(module_path) {
    const exports = i_get_module(module_path)
    for k in exports.keys() {
        if k != "__module" {
            i_set(k, exports[k], false)
        }
    }
}

// Import a module with an alias
func eval_import_alias(module_path, alias) {
    const exports = i_get_module(module_path)
    i_set(alias, exports, false)
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 19: Utility and Introspection — type info, debug helpers
// ═══════════════════════════════════════════════════════════════════

// Get type info as a map
func i_type_info(val) {
    let info = {"type": typeof(val)}
    if i_is_struct(val) {
        info["struct_name"] = i_struct_name(val)
        info["fields"] = i_struct_fields(val)
    } else if i_is_enum(val) {
        info["enum_name"] = i_enum_name(val)
        info["variant"] = i_enum_variant(val)
        info["fields"] = i_enum_fields(val)
        info["iota"] = i_enum_iota(val)
    } else if i_is_closure(val) {
        info["type"] = "function"
        if val.has("__params") {
            const params = val["__params"]
            info["arity"] = len(params)
        } else if val.has("params") {
            const params = val["params"]
            info["arity"] = len(params)
        }
    } else if typeof(val) == "array" {
        info["length"] = len(val)
    } else if typeof(val) == "string" {
        info["length"] = len(val)
    } else if typeof(val) == "map" {
        info["length"] = len(val)
    }
    info
}

// Pretty print a value with indentation
func i_pretty_print(val, indent) {
    const t = typeof(val)
    const pad = i_str_repeat("  ", indent)

    if val == null { return "null" }
    if t == "bool" { return if val { "true" } else { "false" } }
    if t == "int64" { return to_string(val) }
    if t == "float64" { return to_string(val) }
    if t == "string" { return f"\"{val}\"" }

    if t == "array" {
        if len(val) == 0 { return "[]" }
        let parts = []
        for item in val {
            parts.push(f"{pad}  {i_pretty_print(item, indent + 1)}")
        }
        const joined = parts.join(",\n")
        return f"[\n{joined}\n{pad}]"
    }

    if t == "map" {
        if i_is_struct(val) {
            const sname = val["__struct"]
            let parts = []
            for k in val.keys() {
                if k != "__struct" {
                    parts.push(f"{pad}  {k}: {i_pretty_print(val[k], indent + 1)}")
                }
            }
            const joined = parts.join(",\n")
            return f"{sname} {{\n{joined}\n{pad}}}"
        }
        if i_is_enum(val) {
            return i_enum_to_string(val)
        }
        if len(val) == 0 { return "{}" }
        let parts = []
        for k in val.keys() {
            parts.push(f"{pad}  {k}: {i_pretty_print(val[k], indent + 1)}")
        }
        const joined = parts.join(",\n")
        return f"{{\n{joined}\n{pad}}}"
    }

    to_string(val)
}

// Debug print: prints with type information
func i_debug_print(val) {
    const info = i_type_info(val)
    const repr = i_pretty_print(val, 0)
    f"[{info[\"type\"]}] {repr}"
}

// Scope dump: print all variables in all scopes (for debugging)
func i_dump_scopes() {
    let scope_idx = 0
    for scope in i_scopes {
        let vars = []
        for k in scope.keys() {
            if k != "__s" {
                const entry = scope[k]
                const mut_str = if entry["mutable"] { "mut" } else { "const" }
                vars.push(f"  {mut_str} {k} = {i_display(entry[\"value\"])}")
            }
        }
        if len(vars) > 0 {
            const joined = vars.join("\n")
            println(f"Scope {scope_idx}:\n{joined}")
        }
        scope_idx = scope_idx + 1
    }
}

// Function dump: print all registered functions
func i_dump_functions() {
    let funcs = []
    for k in i_functions.keys() {
        if k != "__init" {
            const info = i_functions[k]
            const param_count = len(info["params"])
            funcs.push(f"  {k}({param_count} params)")
        }
    }
    const joined = funcs.join("\n")
    println(f"Functions:\n{joined}")
}

// Struct dump: print all registered structs
func i_dump_structs() {
    let structs = []
    for k in i_structs.keys() {
        if k != "__init" {
            const fields = i_structs[k]
            const field_names = fields.map(f => f.name)
            const joined_fields = field_names.join(", ")
            structs.push(f"  {k} {{ {joined_fields} }}")
        }
    }
    const joined = structs.join("\n")
    println(f"Structs:\n{joined}")
}

// Enum dump: print all registered enums
func i_dump_enums() {
    let enums = []
    for k in i_enums.keys() {
        if k != "__init" {
            const variants = i_enums[k]
            const vnames = variants.map(v => v.name)
            const joined_variants = vnames.join(", ")
            enums.push(f"  {k} {{ {joined_variants} }}")
        }
    }
    const joined = enums.join("\n")
    println(f"Enums:\n{joined}")
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 20: Extended eval_source — save/restore impl_methods, modules
// ═══════════════════════════════════════════════════════════════════

// A fuller eval_source that saves/restores all interpreter state
func eval_source_full(code) {
    const save_scopes = i_scopes
    const save_functions = i_functions
    const save_structs = i_structs
    const save_enums = i_enums
    const save_impl_methods = i_impl_methods
    const save_modules = i_modules
    const save_defer_stack = i_defer_stack
    const save_loop_labels = i_loop_labels

    i_scopes = [i_new_scope()]
    i_functions = {"__init": true}
    i_structs = {"__init": true}
    i_enums = {"__init": true}
    i_impl_methods = {"__init": true}
    i_modules = {"__init": true}
    i_defer_stack = []
    i_loop_labels = []

    const prog = parse(code)
    const result = eval_program(prog)

    i_scopes = save_scopes
    i_functions = save_functions
    i_structs = save_structs
    i_enums = save_enums
    i_impl_methods = save_impl_methods
    i_modules = save_modules
    i_defer_stack = save_defer_stack
    i_loop_labels = save_loop_labels

    result
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 21: Collection Operations — comprehensive array/map/set ops
// ═══════════════════════════════════════════════════════════════════

// Array: insert at index
func i_array_insert(arr, idx, val) {
    if idx < 0 || idx > len(arr) { panic("insert index out of bounds") }
    let left = arr.slice(0, idx)
    let right = arr.slice(idx, len(arr))
    left.concat([val]).concat(right)
}

// Array: remove at index
func i_array_remove_at(arr, idx) {
    if idx < 0 || idx >= len(arr) { panic("remove index out of bounds") }
    let left = arr.slice(0, idx)
    let right = arr.slice(idx + 1, len(arr))
    left.concat(right)
}

// Array: swap elements at two indices
func i_array_swap(arr, i, j) {
    if i < 0 || i >= len(arr) { panic("swap index i out of bounds") }
    if j < 0 || j >= len(arr) { panic("swap index j out of bounds") }
    let result = []
    let idx = 0
    while idx < len(arr) {
        if idx == i {
            result.push(arr[j])
        } else if idx == j {
            result.push(arr[i])
        } else {
            result.push(arr[idx])
        }
        idx = idx + 1
    }
    result
}

// Array: rotate left by n positions
func i_array_rotate_left(arr, n) {
    if len(arr) == 0 { return arr }
    const shift = n % len(arr)
    if shift == 0 { return arr }
    const left = arr.slice(shift, len(arr))
    const right = arr.slice(0, shift)
    left.concat(right)
}

// Array: rotate right by n positions
func i_array_rotate_right(arr, n) {
    if len(arr) == 0 { return arr }
    const shift = n % len(arr)
    if shift == 0 { return arr }
    i_array_rotate_left(arr, len(arr) - shift)
}

// Array: binary search (assumes sorted array)
func i_array_binary_search(arr, target) {
    let lo = 0
    let hi = len(arr) - 1
    while lo <= hi {
        const mid = lo + (hi - lo) / 2
        const cmp = i_compare(arr[mid], target)
        if cmp == 0 { return mid }
        if cmp < 0 {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    -1
}

// Array: remove duplicates preserving order
func i_array_dedup(arr) {
    let seen = {"__init": true}
    let result = []
    for item in arr {
        const key = i_display(item)
        if !seen.has(key) {
            seen[key] = true
            result.push(item)
        }
    }
    result
}

// Array: interleave two arrays [a1, b1, a2, b2, ...]
func i_array_interleave(a, b) {
    let result = []
    let max_len = if len(a) > len(b) { len(a) } else { len(b) }
    let i = 0
    while i < max_len {
        if i < len(a) { result.push(a[i]) }
        if i < len(b) { result.push(b[i]) }
        i = i + 1
    }
    result
}

// Array: transpose a 2D array
func i_array_transpose(arr) {
    if len(arr) == 0 { return [] }
    const rows = len(arr)
    let cols = 0
    for row in arr {
        if typeof(row) == "array" && len(row) > cols {
            cols = len(row)
        }
    }
    if cols == 0 { return [] }
    let result = []
    let c = 0
    while c < cols {
        let col = []
        let r = 0
        while r < rows {
            if typeof(arr[r]) == "array" && c < len(arr[r]) {
                col.push(arr[r][c])
            } else {
                col.push(null)
            }
            r = r + 1
        }
        result.push(col)
        c = c + 1
    }
    result
}

// Array: scan (cumulative reduce)
func i_array_scan(arr, fn_val, initial) {
    let result = [initial]
    let acc = initial
    for item in arr {
        acc = i_call_any(fn_val, [acc, item])
        result.push(acc)
    }
    result
}

// Array: pairwise - apply fn to consecutive pairs
func i_array_pairwise(arr, fn_val) {
    if len(arr) < 2 { return [] }
    let result = []
    let i = 0
    while i < len(arr) - 1 {
        result.push(i_call_any(fn_val, [arr[i], arr[i + 1]]))
        i = i + 1
    }
    result
}

// Array: frequencies - count occurrences of each element
func i_array_frequencies(arr) {
    let counts = {}
    for item in arr {
        const key = i_display(item)
        if counts.has(key) {
            counts[key] = counts[key] + 1
        } else {
            counts[key] = 1
        }
    }
    counts
}

// Array: cartesian product of two arrays
func i_array_cartesian(a, b) {
    let result = []
    for ai in a {
        for bi in b {
            result.push([ai, bi])
        }
    }
    result
}

// Array: power set
func i_array_power_set(arr) {
    if len(arr) == 0 { return [[]] }
    let result = [[]]
    for item in arr {
        let new_subsets = []
        for subset in result {
            new_subsets.push(subset.concat([item]))
        }
        result = result.concat(new_subsets)
    }
    result
}

// Array: permutations (for small arrays only)
func i_array_permutations(arr) {
    if len(arr) <= 1 { return [arr] }
    let result = []
    let i = 0
    while i < len(arr) {
        const rest = arr.slice(0, i).concat(arr.slice(i + 1, len(arr)))
        const sub_perms = i_array_permutations(rest)
        for perm in sub_perms {
            result.push([arr[i]].concat(perm))
        }
        i = i + 1
    }
    result
}

// Array: combinations of size k
func i_array_combinations(arr, k) {
    if k == 0 { return [[]] }
    if k > len(arr) { return [] }
    if k == len(arr) { return [arr] }
    let result = []
    let i = 0
    while i <= len(arr) - k {
        const rest = arr.slice(i + 1, len(arr))
        const sub_combos = i_array_combinations(rest, k - 1)
        for combo in sub_combos {
            result.push([arr[i]].concat(combo))
        }
        i = i + 1
    }
    result
}

// Map: invert keys and values
func i_map_invert(m) {
    let result = {}
    for k in m.keys() {
        const v = m[k]
        const new_key = if typeof(v) == "string" { v } else { to_string(v) }
        result[new_key] = k
    }
    result
}

// Map: select only the specified keys
func i_map_select(m, keys) {
    let result = {}
    for k in keys {
        const key = if typeof(k) == "string" { k } else { to_string(k) }
        if m.has(key) {
            result[key] = m[key]
        }
    }
    result
}

// Map: reject the specified keys
func i_map_reject(m, keys) {
    let reject_set = {"__init": true}
    for k in keys {
        const key = if typeof(k) == "string" { k } else { to_string(k) }
        reject_set[key] = true
    }
    let result = {}
    for k in m.keys() {
        if !reject_set.has(k) {
            result[k] = m[k]
        }
    }
    result
}

// Map: deep merge two maps recursively
func i_map_deep_merge(a, b) {
    let result = {}
    for k in a.keys() {
        result[k] = a[k]
    }
    for k in b.keys() {
        if result.has(k) && typeof(result[k]) == "map" && typeof(b[k]) == "map" {
            result[k] = i_map_deep_merge(result[k], b[k])
        } else {
            result[k] = b[k]
        }
    }
    result
}

// Map: flatten nested maps with dot-separated keys
func i_map_flatten(m, prefix) {
    let result = {}
    for k in m.keys() {
        const full_key = if len(prefix) > 0 { f"{prefix}.{k}" } else { k }
        const v = m[k]
        if typeof(v) == "map" && !v.has("__struct") && !v.has("__enum") {
            const sub = i_map_flatten(v, full_key)
            for sk in sub.keys() {
                result[sk] = sub[sk]
            }
        } else {
            result[full_key] = v
        }
    }
    result
}

// Map: unflatten dot-separated keys into nested maps
func i_map_unflatten(m) {
    let result = {}
    for k in m.keys() {
        const parts = k.split(".")
        let current = result
        let i = 0
        while i < len(parts) - 1 {
            const part = parts[i]
            if !current.has(part) || typeof(current[part]) != "map" {
                current[part] = {}
            }
            current = current[part]
            i = i + 1
        }
        current[parts[len(parts) - 1]] = m[k]
    }
    result
}

// Set operations on arrays
func i_set_union(a, b) {
    let seen = {"__init": true}
    let result = []
    for item in a {
        const key = i_display(item)
        if !seen.has(key) {
            seen[key] = true
            result.push(item)
        }
    }
    for item in b {
        const key = i_display(item)
        if !seen.has(key) {
            seen[key] = true
            result.push(item)
        }
    }
    result
}

func i_set_intersection(a, b) {
    let set_b = {"__init": true}
    for item in b {
        set_b[i_display(item)] = true
    }
    let result = []
    for item in a {
        if set_b.has(i_display(item)) {
            result.push(item)
        }
    }
    result
}

func i_set_difference(a, b) {
    let set_b = {"__init": true}
    for item in b {
        set_b[i_display(item)] = true
    }
    let result = []
    for item in a {
        if !set_b.has(i_display(item)) {
            result.push(item)
        }
    }
    result
}

func i_set_symmetric_difference(a, b) {
    let in_a = {"__init": true}
    let in_b = {"__init": true}
    for item in a { in_a[i_display(item)] = true }
    for item in b { in_b[i_display(item)] = true }
    let result = []
    for item in a {
        if !in_b.has(i_display(item)) { result.push(item) }
    }
    for item in b {
        if !in_a.has(i_display(item)) { result.push(item) }
    }
    result
}

func i_set_is_subset(a, b) {
    let set_b = {"__init": true}
    for item in b { set_b[i_display(item)] = true }
    for item in a {
        if !set_b.has(i_display(item)) { return false }
    }
    true
}

func i_set_is_superset(a, b) {
    i_set_is_subset(b, a)
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 22: Sorting Algorithms — multiple sort implementations
// ═══════════════════════════════════════════════════════════════════

// Insertion sort with custom comparator
func i_sort_insertion(arr, cmp_fn) {
    let result = []
    for item in arr { result.push(item) }
    let i = 1
    while i < len(result) {
        let j = i
        while j > 0 {
            const cmp = i_call_any(cmp_fn, [result[j - 1], result[j]])
            if cmp <= 0 { break }
            const tmp = result[j - 1]
            result[j - 1] = result[j]
            result[j] = tmp
            j = j - 1
        }
        i = i + 1
    }
    result
}

// Selection sort
func i_sort_selection(arr) {
    let result = []
    for item in arr { result.push(item) }
    let i = 0
    while i < len(result) {
        let min_idx = i
        let j = i + 1
        while j < len(result) {
            if i_compare(result[j], result[min_idx]) < 0 {
                min_idx = j
            }
            j = j + 1
        }
        if min_idx != i {
            const tmp = result[i]
            result[i] = result[min_idx]
            result[min_idx] = tmp
        }
        i = i + 1
    }
    result
}

// Bubble sort (useful for nearly sorted arrays)
func i_sort_bubble(arr) {
    let result = []
    for item in arr { result.push(item) }
    let n = len(result)
    let swapped = true
    while swapped {
        swapped = false
        let i = 1
        while i < n {
            if i_compare(result[i - 1], result[i]) > 0 {
                const tmp = result[i - 1]
                result[i - 1] = result[i]
                result[i] = tmp
                swapped = true
            }
            i = i + 1
        }
        n = n - 1
    }
    result
}

// Merge sort
func i_sort_merge(arr) {
    if len(arr) <= 1 { return arr }
    const mid = len(arr) / 2
    const left = i_sort_merge(arr.slice(0, mid))
    const right = i_sort_merge(arr.slice(mid, len(arr)))
    i_merge_sorted(left, right)
}

func i_merge_sorted(a, b) {
    let result = []
    let i = 0
    let j = 0
    while i < len(a) && j < len(b) {
        if i_compare(a[i], b[j]) <= 0 {
            result.push(a[i])
            i = i + 1
        } else {
            result.push(b[j])
            j = j + 1
        }
    }
    while i < len(a) {
        result.push(a[i])
        i = i + 1
    }
    while j < len(b) {
        result.push(b[j])
        j = j + 1
    }
    result
}

// Stable sort: merge sort preserving equal-element order
func i_stable_sort(arr, key_fn) {
    if len(arr) <= 1 { return arr }
    const mid = len(arr) / 2
    const left = i_stable_sort(arr.slice(0, mid), key_fn)
    const right = i_stable_sort(arr.slice(mid, len(arr)), key_fn)

    let result = []
    let i = 0
    let j = 0
    while i < len(left) && j < len(right) {
        const lk = i_call_any(key_fn, [left[i]])
        const rk = i_call_any(key_fn, [right[j]])
        if i_compare(lk, rk) <= 0 {
            result.push(left[i])
            i = i + 1
        } else {
            result.push(right[j])
            j = j + 1
        }
    }
    while i < len(left) {
        result.push(left[i])
        i = i + 1
    }
    while j < len(right) {
        result.push(right[j])
        j = j + 1
    }
    result
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 23: Data Structures — stack, queue, priority queue, linked list
// ═══════════════════════════════════════════════════════════════════

// Stack: LIFO data structure
func i_stack_new() {
    {"__stack": true, "__items": []}
}

func i_stack_push(stack, val) {
    let items = stack["__items"]
    items.push(val)
    stack["__items"] = items
    stack
}

func i_stack_pop(stack) {
    let items = stack["__items"]
    if len(items) == 0 { panic("pop from empty stack") }
    const val = items[len(items) - 1]
    stack["__items"] = items.slice(0, len(items) - 1)
    val
}

func i_stack_peek(stack) {
    const items = stack["__items"]
    if len(items) == 0 { return null }
    items[len(items) - 1]
}

func i_stack_size(stack) {
    len(stack["__items"])
}

func i_stack_is_empty(stack) {
    len(stack["__items"]) == 0
}

func i_stack_to_array(stack) {
    stack["__items"].reverse()
}

// Queue: FIFO data structure
func i_queue_new() {
    {"__queue": true, "__items": []}
}

func i_queue_enqueue(queue, val) {
    let items = queue["__items"]
    items.push(val)
    queue["__items"] = items
    queue
}

func i_queue_dequeue(queue) {
    let items = queue["__items"]
    if len(items) == 0 { panic("dequeue from empty queue") }
    const val = items[0]
    queue["__items"] = items.slice(1, len(items))
    val
}

func i_queue_peek(queue) {
    const items = queue["__items"]
    if len(items) == 0 { return null }
    items[0]
}

func i_queue_size(queue) {
    len(queue["__items"])
}

func i_queue_is_empty(queue) {
    len(queue["__items"]) == 0
}

func i_queue_to_array(queue) {
    queue["__items"]
}

// Deque: double-ended queue
func i_deque_new() {
    {"__deque": true, "__items": []}
}

func i_deque_push_front(deque, val) {
    let items = deque["__items"]
    deque["__items"] = [val].concat(items)
    deque
}

func i_deque_push_back(deque, val) {
    let items = deque["__items"]
    items.push(val)
    deque["__items"] = items
    deque
}

func i_deque_pop_front(deque) {
    let items = deque["__items"]
    if len(items) == 0 { panic("pop_front from empty deque") }
    const val = items[0]
    deque["__items"] = items.slice(1, len(items))
    val
}

func i_deque_pop_back(deque) {
    let items = deque["__items"]
    if len(items) == 0 { panic("pop_back from empty deque") }
    const val = items[len(items) - 1]
    deque["__items"] = items.slice(0, len(items) - 1)
    val
}

func i_deque_size(deque) {
    len(deque["__items"])
}

// Priority Queue (min-heap using array)
func i_pq_new() {
    {"__pq": true, "__items": []}
}

func i_pq_push(pq, priority, val) {
    let items = pq["__items"]
    items.push([priority, val])
    pq["__items"] = items
    // Bubble up
    let idx = len(items) - 1
    while idx > 0 {
        const parent = (idx - 1) / 2
        if i_compare(items[parent][0], items[idx][0]) <= 0 { break }
        const tmp = items[parent]
        items[parent] = items[idx]
        items[idx] = tmp
        pq["__items"] = items
        idx = parent
    }
    pq
}

func i_pq_pop(pq) {
    let items = pq["__items"]
    if len(items) == 0 { panic("pop from empty priority queue") }
    const result = items[0]
    const last = items[len(items) - 1]
    items = items.slice(0, len(items) - 1)
    if len(items) > 0 {
        items[0] = last
        // Bubble down
        let idx = 0
        while true {
            let smallest = idx
            const left_child = 2 * idx + 1
            const right_child = 2 * idx + 2
            if left_child < len(items) && i_compare(items[left_child][0], items[smallest][0]) < 0 {
                smallest = left_child
            }
            if right_child < len(items) && i_compare(items[right_child][0], items[smallest][0]) < 0 {
                smallest = right_child
            }
            if smallest == idx { break }
            const tmp = items[idx]
            items[idx] = items[smallest]
            items[smallest] = tmp
            idx = smallest
        }
    }
    pq["__items"] = items
    result[1]
}

func i_pq_peek(pq) {
    const items = pq["__items"]
    if len(items) == 0 { return null }
    items[0][1]
}

func i_pq_size(pq) {
    len(pq["__items"])
}

func i_pq_is_empty(pq) {
    len(pq["__items"]) == 0
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 24: Graph Algorithms — BFS, DFS, topological sort, shortest path
// ═══════════════════════════════════════════════════════════════════

// Graph represented as adjacency list: {node: [neighbors]}
func i_graph_new() {
    {"__graph": true, "__adj": {}}
}

func i_graph_add_edge(g, from, to) {
    let adj = g["__adj"]
    const fk = to_string(from)
    const tk = to_string(to)
    if !adj.has(fk) { adj[fk] = [] }
    let neighbors = adj[fk]
    neighbors.push(tk)
    adj[fk] = neighbors
    if !adj.has(tk) { adj[tk] = [] }
    g["__adj"] = adj
    g
}

func i_graph_add_undirected_edge(g, a, b) {
    i_graph_add_edge(g, a, b)
    i_graph_add_edge(g, b, a)
}

func i_graph_neighbors(g, node) {
    const adj = g["__adj"]
    const nk = to_string(node)
    if adj.has(nk) { return adj[nk] }
    []
}

func i_graph_nodes(g) {
    g["__adj"].keys()
}

// BFS: breadth-first search
func i_graph_bfs(g, start) {
    let visited = {"__init": true}
    let queue = [to_string(start)]
    let order = []
    visited[to_string(start)] = true

    while len(queue) > 0 {
        const node = queue[0]
        queue = queue.slice(1, len(queue))
        order.push(node)
        const neighbors = i_graph_neighbors(g, node)
        for n in neighbors {
            if !visited.has(n) {
                visited[n] = true
                queue.push(n)
            }
        }
    }
    order
}

// DFS: depth-first search
func i_graph_dfs(g, start) {
    let visited = {"__init": true}
    let stack = [to_string(start)]
    let order = []

    while len(stack) > 0 {
        const node = stack[len(stack) - 1]
        stack = stack.slice(0, len(stack) - 1)
        if visited.has(node) { continue }
        visited[node] = true
        order.push(node)
        const neighbors = i_graph_neighbors(g, node)
        let i = len(neighbors) - 1
        while i >= 0 {
            if !visited.has(neighbors[i]) {
                stack.push(neighbors[i])
            }
            i = i - 1
        }
    }
    order
}

// Topological sort (Kahn's algorithm)
func i_graph_topo_sort(g) {
    let adj = g["__adj"]
    let in_degree = {}
    let all_nodes = adj.keys()

    // Initialize in-degrees
    for n in all_nodes {
        if !in_degree.has(n) { in_degree[n] = 0 }
        const neighbors = i_graph_neighbors(g, n)
        for neighbor in neighbors {
            if in_degree.has(neighbor) {
                in_degree[neighbor] = in_degree[neighbor] + 1
            } else {
                in_degree[neighbor] = 1
            }
        }
    }

    // Find nodes with in-degree 0
    let queue = []
    for n in all_nodes {
        if in_degree.has(n) && in_degree[n] == 0 {
            queue.push(n)
        }
    }

    let order = []
    while len(queue) > 0 {
        const node = queue[0]
        queue = queue.slice(1, len(queue))
        order.push(node)
        const neighbors = i_graph_neighbors(g, node)
        for n in neighbors {
            in_degree[n] = in_degree[n] - 1
            if in_degree[n] == 0 {
                queue.push(n)
            }
        }
    }

    if len(order) != len(all_nodes) {
        panic("graph has a cycle, topological sort not possible")
    }
    order
}

// Has path: check if a path exists between two nodes
func i_graph_has_path(g, start, end_node) {
    let visited = {"__init": true}
    let queue = [to_string(start)]
    const target = to_string(end_node)
    visited[to_string(start)] = true

    while len(queue) > 0 {
        const node = queue[0]
        queue = queue.slice(1, len(queue))
        if node == target { return true }
        const neighbors = i_graph_neighbors(g, node)
        for n in neighbors {
            if !visited.has(n) {
                visited[n] = true
                queue.push(n)
            }
        }
    }
    false
}

// Shortest path (unweighted BFS)
func i_graph_shortest_path(g, start, end_node) {
    let visited = {"__init": true}
    let parent = {}
    let queue = [to_string(start)]
    const target = to_string(end_node)
    visited[to_string(start)] = true

    while len(queue) > 0 {
        const node = queue[0]
        queue = queue.slice(1, len(queue))
        if node == target {
            // Reconstruct path
            let path = [node]
            let current = node
            while parent.has(current) {
                current = parent[current]
                path.push(current)
            }
            return path.reverse()
        }
        const neighbors = i_graph_neighbors(g, node)
        for n in neighbors {
            if !visited.has(n) {
                visited[n] = true
                parent[n] = node
                queue.push(n)
            }
        }
    }
    []
}

// Connected components (undirected graph)
func i_graph_components(g) {
    let visited = {"__init": true}
    let components = []
    const nodes = i_graph_nodes(g)

    for node in nodes {
        if !visited.has(node) {
            let component = []
            let queue = [node]
            visited[node] = true
            while len(queue) > 0 {
                const n = queue[0]
                queue = queue.slice(1, len(queue))
                component.push(n)
                const neighbors = i_graph_neighbors(g, n)
                for nb in neighbors {
                    if !visited.has(nb) {
                        visited[nb] = true
                        queue.push(nb)
                    }
                }
            }
            components.push(component)
        }
    }
    components
}

// Is connected: check if graph is fully connected
func i_graph_is_connected(g) {
    const nodes = i_graph_nodes(g)
    if len(nodes) <= 1 { return true }
    const reachable = i_graph_bfs(g, nodes[0])
    len(reachable) == len(nodes)
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 25: JSON-like Serialization — serialize/deserialize values
// ═══════════════════════════════════════════════════════════════════

// Serialize a MAGI value to a JSON-like string
func i_serialize(val) {
    if val == null { return "null" }
    const t = typeof(val)
    if t == "bool" { return if val { "true" } else { "false" } }
    if t == "int64" { return to_string(val) }
    if t == "float64" { return to_string(val) }
    if t == "string" {
        // Escape special characters
        let result = "\""
        for ch in val.chars() {
            if ch == "\"" {
                result = result + "\\\""
            } else if ch == "\\" {
                result = result + "\\\\"
            } else if ch == "\n" {
                result = result + "\\n"
            } else if ch == "\t" {
                result = result + "\\t"
            } else {
                result = result + ch
            }
        }
        return result + "\""
    }
    if t == "array" {
        let parts = []
        for item in val {
            parts.push(i_serialize(item))
        }
        return "[" + parts.join(", ") + "]"
    }
    if t == "map" {
        if i_is_struct(val) {
            // Serialize struct with type info
            let parts = [f"\"__struct\": \"{val[\"__struct\"]}\""]
            for k in val.keys() {
                if k != "__struct" {
                    parts.push(f"\"{k}\": {i_serialize(val[k])}")
                }
            }
            return "{" + parts.join(", ") + "}"
        }
        if i_is_enum(val) {
            let parts = [
                f"\"__enum\": \"{val[\"__enum\"]}\"",
                f"\"__variant\": \"{val[\"__variant\"]}\"",
                f"\"__fields\": {i_serialize(i_enum_fields(val))}",
            ]
            return "{" + parts.join(", ") + "}"
        }
        let parts = []
        for k in val.keys() {
            parts.push(f"\"{k}\": {i_serialize(val[k])}")
        }
        return "{" + parts.join(", ") + "}"
    }
    to_string(val)
}

// Deep clone a value
func i_deep_clone(val) {
    if val == null { return null }
    const t = typeof(val)
    if t == "int64" || t == "float64" || t == "string" || t == "bool" {
        return val
    }
    if t == "array" {
        return val.map(item => i_deep_clone(item))
    }
    if t == "map" {
        let result = {}
        for k in val.keys() {
            result[k] = i_deep_clone(val[k])
        }
        return result
    }
    val
}

// Deep equality check
func i_deep_eq(a, b) {
    if a == null && b == null { return true }
    if a == null || b == null { return false }
    const ta = typeof(a)
    const tb = typeof(b)
    if ta != tb { return false }
    if ta == "int64" || ta == "float64" || ta == "string" || ta == "bool" {
        return a == b
    }
    if ta == "array" {
        if len(a) != len(b) { return false }
        let i = 0
        while i < len(a) {
            if !i_deep_eq(a[i], b[i]) { return false }
            i = i + 1
        }
        return true
    }
    if ta == "map" {
        const ka = a.keys()
        const kb = b.keys()
        if len(ka) != len(kb) { return false }
        for k in ka {
            if !b.has(k) { return false }
            if !i_deep_eq(a[k], b[k]) { return false }
        }
        return true
    }
    a == b
}

// Hash a value (simple hash for use in hash sets/maps)
func i_hash(val) {
    if val == null { return 0 }
    const t = typeof(val)
    if t == "int64" { return val }
    if t == "bool" { return if val { 1 } else { 0 } }
    if t == "string" {
        let h = 0
        for ch in val.chars() {
            // Simple polynomial rolling hash
            h = h * 31 + char_code(ch)
        }
        return h
    }
    if t == "float64" { return to_int64(val * 1000000.0) }
    // For complex types, use display string hash
    i_hash(i_display(val))
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 26: Functional Programming — compose, curry, memoize, pipe chain
// ═══════════════════════════════════════════════════════════════════

// Identity function
func i_identity(x) { x }

// Constant function: always returns the same value
func i_const_fn(val) {
    {"__lambda": true, "params": [param_new("_", null)], "body": null, "captured": {"__s": true, "__val": {"value": val, "mutable": false}}, "__const_val": val}
}

// Negate a predicate function
func i_negate_fn(fn_val) {
    // Returns a new function that negates the result of fn_val
    {"__negated": true, "__inner": fn_val}
}

// Call a negated function
func i_call_negated(negated, args) {
    !i_truthy(i_call_any(negated["__inner"], args))
}

// Memoize: cache function results
func i_memoize(fn_val) {
    {"__memoized": true, "__inner": fn_val, "__cache": {"__init": true}}
}

func i_call_memoized(memo, args) {
    const key = i_serialize(args)
    let cache = memo["__cache"]
    if cache.has(key) {
        return cache[key]
    }
    const result = i_call_any(memo["__inner"], args)
    cache[key] = result
    memo["__cache"] = cache
    result
}

// Pipe chain: compose multiple functions left to right
func i_pipe_chain(fns) {
    if len(fns) == 0 { panic("pipe_chain requires at least one function") }
    if len(fns) == 1 { return fns[0] }
    {"__pipe_chain": true, "__fns": fns}
}

func i_call_pipe_chain(chain, args) {
    const fns = chain["__fns"]
    let result = i_call_any(fns[0], args)
    let i = 1
    while i < len(fns) {
        result = i_call_any(fns[i], [result])
        i = i + 1
    }
    result
}

// Compose chain: compose multiple functions right to left
func i_compose_chain(fns) {
    i_pipe_chain(fns.reverse())
}

// Flip: swap the first two arguments of a function
func i_flip(fn_val) {
    {"__flipped": true, "__inner": fn_val}
}

func i_call_flipped(flipped, args) {
    if len(args) < 2 { panic("flipped function requires at least 2 arguments") }
    let new_args = [args[1], args[0]]
    if len(args) > 2 {
        new_args = new_args.concat(args.slice(2, len(args)))
    }
    i_call_any(flipped["__inner"], new_args)
}

// Fixed-point combinator (for recursive lambdas)
func i_fix(fn_val) {
    {"__fixed": true, "__inner": fn_val}
}

func i_call_fixed(fixed, args) {
    // Y combinator: f(fix(f))(args)
    const inner = fixed["__inner"]
    i_call_any(inner, [fixed].concat(args))
}

// Apply: call a function with an array of arguments
func i_apply(fn_val, args_array) {
    i_call_any(fn_val, args_array)
}

// Juxt: apply multiple functions to the same arguments
func i_juxt(fns, args) {
    fns.map(fn_val => i_call_any(fn_val, args))
}

// Thread first: pipe a value through a series of [fn, extra_args...]
func i_thread_first(val, steps) {
    let current = val
    for step in steps {
        if typeof(step) == "array" && len(step) > 0 {
            const fn_val = step[0]
            const extra = step.slice(1, len(step))
            current = i_call_any(fn_val, [current].concat(extra))
        } else {
            current = i_call_any(step, [current])
        }
    }
    current
}

// Thread last: same as thread_first but inserts value as last arg
func i_thread_last(val, steps) {
    let current = val
    for step in steps {
        if typeof(step) == "array" && len(step) > 0 {
            const fn_val = step[0]
            const extra = step.slice(1, len(step))
            current = i_call_any(fn_val, extra.concat([current]))
        } else {
            current = i_call_any(step, [current])
        }
    }
    current
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 27: String Builder — efficient string construction
// ═══════════════════════════════════════════════════════════════════

// Create a new string builder
func i_sb_new() {
    {"__sb": true, "__parts": []}
}

// Append to string builder
func i_sb_append(sb, s) {
    let parts = sb["__parts"]
    parts.push(if typeof(s) == "string" { s } else { i_display(s) })
    sb["__parts"] = parts
    sb
}

// Append a line to string builder
func i_sb_line(sb, s) {
    i_sb_append(sb, s)
    i_sb_append(sb, "\n")
}

// Build the final string
func i_sb_build(sb) {
    sb["__parts"].join("")
}

// Get current length
func i_sb_length(sb) {
    let total = 0
    for part in sb["__parts"] {
        total = total + len(part)
    }
    total
}

// Clear the builder
func i_sb_clear(sb) {
    sb["__parts"] = []
    sb
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 28: Regex-like Pattern Matching — simple pattern matching on strings
// ═══════════════════════════════════════════════════════════════════

// Match a simple pattern against a string
// Supports: * (any chars), ? (single char), [abc] (char class)
func i_pattern_match_str(s, pattern) {
    i_str_glob_match(s, pattern)
}

// Find all indices where a substring occurs
func i_str_find_all(s, sub) {
    let indices = []
    if len(sub) == 0 { return indices }
    let i = 0
    while i + len(sub) <= len(s) {
        if s.slice(i, i + len(sub)) == sub {
            indices.push(i)
        }
        i = i + 1
    }
    indices
}

// Replace all occurrences (non-overlapping)
func i_str_replace_all(s, from, to_str) {
    if len(from) == 0 { return s }
    let result = ""
    let i = 0
    while i < len(s) {
        if i + len(from) <= len(s) && s.slice(i, i + len(from)) == from {
            result = result + to_str
            i = i + len(from)
        } else {
            result = result + s[i]
            i = i + 1
        }
    }
    result
}

// Extract substring between delimiters
func i_str_between(s, start_delim, end_delim) {
    let results = []
    let i = 0
    while i < len(s) {
        if i + len(start_delim) <= len(s) && s.slice(i, i + len(start_delim)) == start_delim {
            let j = i + len(start_delim)
            while j + len(end_delim) <= len(s) {
                if s.slice(j, j + len(end_delim)) == end_delim {
                    results.push(s.slice(i + len(start_delim), j))
                    i = j + len(end_delim) - 1
                    break
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    results
}

// Split string preserving delimiters
func i_str_split_keep(s, sep) {
    let result = []
    let current = ""
    let i = 0
    while i < len(s) {
        if i + len(sep) <= len(s) && s.slice(i, i + len(sep)) == sep {
            if len(current) > 0 { result.push(current) }
            result.push(sep)
            current = ""
            i = i + len(sep)
        } else {
            current = current + s[i]
            i = i + 1
        }
    }
    if len(current) > 0 { result.push(current) }
    result
}

// Word wrap text to a given width
func i_str_word_wrap(s, width) {
    const words = s.split(" ")
    let lines = []
    let current_line = ""
    for word in words {
        if len(current_line) == 0 {
            current_line = word
        } else if len(current_line) + 1 + len(word) <= width {
            current_line = current_line + " " + word
        } else {
            lines.push(current_line)
            current_line = word
        }
    }
    if len(current_line) > 0 {
        lines.push(current_line)
    }
    lines.join("\n")
}

// Levenshtein distance between two strings
func i_str_edit_distance(a, b) {
    const m = len(a)
    const n = len(b)
    // Build matrix as flat array
    let prev_row = []
    let i = 0
    while i <= n {
        prev_row.push(i)
        i = i + 1
    }
    i = 1
    while i <= m {
        let curr_row = [i]
        let j = 1
        while j <= n {
            const cost = if a[i - 1] == b[j - 1] { 0 } else { 1 }
            const del = prev_row[j] + 1
            const ins = curr_row[j - 1] + 1
            const sub = prev_row[j - 1] + cost
            let min_val = del
            if ins < min_val { min_val = ins }
            if sub < min_val { min_val = sub }
            curr_row.push(min_val)
            j = j + 1
        }
        prev_row = curr_row
        i = i + 1
    }
    prev_row[n]
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 29: Table/Matrix Operations
// ═══════════════════════════════════════════════════════════════════

// Create a matrix (2D array) filled with a value
func i_matrix_new(rows, cols, fill) {
    let result = []
    let r = 0
    while r < rows {
        let row = []
        let c = 0
        while c < cols {
            row.push(fill)
            c = c + 1
        }
        result.push(row)
        r = r + 1
    }
    result
}

// Identity matrix
func i_matrix_identity(size) {
    let result = i_matrix_new(size, size, 0)
    let i = 0
    while i < size {
        result[i][i] = 1
        i = i + 1
    }
    result
}

// Matrix addition
func i_matrix_add(a, b) {
    const rows = len(a)
    let result = []
    let r = 0
    while r < rows {
        let row = []
        let c = 0
        while c < len(a[r]) {
            row.push(i_add(a[r][c], b[r][c]))
            c = c + 1
        }
        result.push(row)
        r = r + 1
    }
    result
}

// Matrix multiplication
func i_matrix_mul(a, b) {
    const rows_a = len(a)
    const cols_a = len(a[0])
    const cols_b = len(b[0])
    let result = i_matrix_new(rows_a, cols_b, 0)
    let r = 0
    while r < rows_a {
        let c = 0
        while c < cols_b {
            let sum = 0
            let k = 0
            while k < cols_a {
                sum = i_add(sum, i_mul(a[r][k], b[k][c]))
                k = k + 1
            }
            result[r][c] = sum
            c = c + 1
        }
        r = r + 1
    }
    result
}

// Matrix scalar multiplication
func i_matrix_scale(m, scalar) {
    m.map(row => row.map(v => i_mul(v, scalar)))
}

// Matrix transpose
func i_matrix_transpose(m) {
    i_array_transpose(m)
}

// Matrix element-wise operation
func i_matrix_map(m, fn_val) {
    m.map(row => row.map(v => i_call_any(fn_val, [v])))
}

// Get matrix dimensions
func i_matrix_shape(m) {
    if len(m) == 0 { return [0, 0] }
    [len(m), len(m[0])]
}

// Matrix row sum
func i_matrix_row_sums(m) {
    m.map(row => i_iter_sum(row))
}

// Matrix column sums
func i_matrix_col_sums(m) {
    const t = i_matrix_transpose(m)
    t.map(col => i_iter_sum(col))
}

// Dot product of two vectors (1D arrays)
func i_dot_product(a, b) {
    if len(a) != len(b) { panic("dot product requires equal-length vectors") }
    let sum = 0
    let i = 0
    while i < len(a) {
        sum = i_add(sum, i_mul(a[i], b[i]))
        i = i + 1
    }
    sum
}

// Cross product of two 3D vectors
func i_cross_product(a, b) {
    if len(a) != 3 || len(b) != 3 { panic("cross product requires 3D vectors") }
    [
        i_sub(i_mul(a[1], b[2]), i_mul(a[2], b[1])),
        i_sub(i_mul(a[2], b[0]), i_mul(a[0], b[2])),
        i_sub(i_mul(a[0], b[1]), i_mul(a[1], b[0])),
    ]
}

// Vector magnitude (squared, to avoid needing sqrt)
func i_vector_magnitude_sq(v) {
    i_dot_product(v, v)
}

// Vector addition
func i_vector_add(a, b) {
    if len(a) != len(b) { panic("vector addition requires equal-length vectors") }
    let result = []
    let i = 0
    while i < len(a) {
        result.push(i_add(a[i], b[i]))
        i = i + 1
    }
    result
}

// Vector subtraction
func i_vector_sub(a, b) {
    if len(a) != len(b) { panic("vector subtraction requires equal-length vectors") }
    let result = []
    let i = 0
    while i < len(a) {
        result.push(i_sub(a[i], b[i]))
        i = i + 1
    }
    result
}

// Vector scalar multiplication
func i_vector_scale(v, scalar) {
    v.map(x => i_mul(x, scalar))
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 30: State Machine — simple finite state machine
// ═══════════════════════════════════════════════════════════════════

// Create a new state machine
func i_fsm_new(initial_state) {
    {
        "__fsm": true,
        "__state": initial_state,
        "__transitions": {},
        "__on_enter": {},
        "__on_exit": {},
        "__history": [initial_state],
    }
}

// Add a transition
func i_fsm_add_transition(fsm, from_state, event, to_state) {
    let transitions = fsm["__transitions"]
    const key = f"{from_state}:{event}"
    transitions[key] = to_state
    fsm["__transitions"] = transitions
    fsm
}

// Send an event to the state machine
func i_fsm_send(fsm, event) {
    const current = fsm["__state"]
    const key = f"{current}:{event}"
    const transitions = fsm["__transitions"]
    if !transitions.has(key) {
        panic(f"no transition from state '{current}' on event '{event}'")
    }
    const next_state = transitions[key]

    // Execute on_exit callback
    const on_exit = fsm["__on_exit"]
    if on_exit.has(current) {
        i_call_any(on_exit[current], [current, event])
    }

    fsm["__state"] = next_state

    // Record history
    let history = fsm["__history"]
    history.push(next_state)
    fsm["__history"] = history

    // Execute on_enter callback
    const on_enter = fsm["__on_enter"]
    if on_enter.has(next_state) {
        i_call_any(on_enter[next_state], [next_state, event])
    }

    fsm
}

// Get current state
func i_fsm_state(fsm) {
    fsm["__state"]
}

// Get state history
func i_fsm_history(fsm) {
    fsm["__history"]
}

// Check if a transition is valid
func i_fsm_can_send(fsm, event) {
    const current = fsm["__state"]
    const key = f"{current}:{event}"
    fsm["__transitions"].has(key)
}

// Add on_enter callback for a state
func i_fsm_on_enter(fsm, state, callback) {
    let on_enter = fsm["__on_enter"]
    on_enter[state] = callback
    fsm["__on_enter"] = on_enter
    fsm
}

// Add on_exit callback for a state
func i_fsm_on_exit(fsm, state, callback) {
    let on_exit = fsm["__on_exit"]
    on_exit[state] = callback
    fsm["__on_exit"] = on_exit
    fsm
}

// Reset state machine to initial state
func i_fsm_reset(fsm) {
    const history = fsm["__history"]
    if len(history) > 0 {
        fsm["__state"] = history[0]
        fsm["__history"] = [history[0]]
    }
    fsm
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 31: Event Emitter — pub/sub pattern
// ═══════════════════════════════════════════════════════════════════

// Create a new event emitter
func i_emitter_new() {
    {"__emitter": true, "__handlers": {}}
}

// Subscribe to an event
func i_emitter_on(emitter, event, handler) {
    let handlers = emitter["__handlers"]
    if !handlers.has(event) {
        handlers[event] = []
    }
    let h = handlers[event]
    h.push(handler)
    handlers[event] = h
    emitter["__handlers"] = handlers
    emitter
}

// Emit an event with data
func i_emitter_emit(emitter, event, data) {
    const handlers = emitter["__handlers"]
    if !handlers.has(event) { return emitter }
    const h = handlers[event]
    for handler in h {
        i_call_any(handler, [data])
    }
    emitter
}

// Remove all handlers for an event
func i_emitter_off(emitter, event) {
    let handlers = emitter["__handlers"]
    if handlers.has(event) {
        handlers = handlers.delete(event)
        emitter["__handlers"] = handlers
    }
    emitter
}

// Subscribe to an event for one-time only
func i_emitter_once(emitter, event, handler) {
    // Mark with __once flag
    let handlers = emitter["__handlers"]
    if !handlers.has(event) {
        handlers[event] = []
    }
    let h = handlers[event]
    h.push({"__once": true, "__handler": handler})
    handlers[event] = h
    emitter["__handlers"] = handlers
    emitter
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 32: Observable/Reactive Values
// ═══════════════════════════════════════════════════════════════════

// Create a reactive value
func i_reactive_new(initial) {
    {
        "__reactive": true,
        "__value": initial,
        "__watchers": [],
    }
}

// Get reactive value
func i_reactive_get(r) {
    r["__value"]
}

// Set reactive value and notify watchers
func i_reactive_set(r, new_val) {
    const old_val = r["__value"]
    r["__value"] = new_val
    const watchers = r["__watchers"]
    for watcher in watchers {
        i_call_any(watcher, [new_val, old_val])
    }
    r
}

// Watch for changes
func i_reactive_watch(r, callback) {
    let watchers = r["__watchers"]
    watchers.push(callback)
    r["__watchers"] = watchers
    r
}

// Create a computed reactive value
func i_reactive_computed(deps, compute_fn) {
    const initial = i_call_any(compute_fn, deps.map(d => i_reactive_get(d)))
    let computed = i_reactive_new(initial)
    // Watch all dependencies
    for dep in deps {
        i_reactive_watch(dep, (new_val, old_val) => {
            const new_computed = i_call_any(compute_fn, deps.map(d => i_reactive_get(d)))
            i_reactive_set(computed, new_computed)
        })
    }
    computed
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 33: Trie (Prefix Tree) — for string lookups
// ═══════════════════════════════════════════════════════════════════

// Create a new trie node
func i_trie_new() {
    {"__trie": true, "__children": {}, "__end": false, "__value": null}
}

// Insert a key-value pair into the trie
func i_trie_insert(trie, key, value) {
    let current = trie
    for ch in key.chars() {
        let children = current["__children"]
        if !children.has(ch) {
            children[ch] = i_trie_new()
        }
        current["__children"] = children
        current = children[ch]
    }
    current["__end"] = true
    current["__value"] = value
    trie
}

// Search for a key in the trie, returns value or null
func i_trie_search(trie, key) {
    let current = trie
    for ch in key.chars() {
        const children = current["__children"]
        if !children.has(ch) { return null }
        current = children[ch]
    }
    if current["__end"] { return current["__value"] }
    null
}

// Check if a prefix exists in the trie
func i_trie_has_prefix(trie, prefix) {
    let current = trie
    for ch in prefix.chars() {
        const children = current["__children"]
        if !children.has(ch) { return false }
        current = children[ch]
    }
    true
}

// Collect all keys with a given prefix
func i_trie_keys_with_prefix(trie, prefix) {
    let current = trie
    for ch in prefix.chars() {
        const children = current["__children"]
        if !children.has(ch) { return [] }
        current = children[ch]
    }
    // DFS to collect all keys from current node
    let results = []
    i_trie_collect(current, prefix, results)
    results
}

// Helper: collect all keys in subtrie
func i_trie_collect(node, prefix, results) {
    if node["__end"] {
        results.push(prefix)
    }
    const children = node["__children"]
    for ch in children.keys() {
        i_trie_collect(children[ch], prefix + ch, results)
    }
}

// Delete a key from the trie
func i_trie_delete(trie, key) {
    i_trie_delete_helper(trie, key, 0)
    trie
}

func i_trie_delete_helper(node, key, depth) {
    if depth == len(key) {
        if !node["__end"] { return false }
        node["__end"] = false
        node["__value"] = null
        return len(node["__children"]) == 0
    }
    const ch = key[depth]
    let children = node["__children"]
    if !children.has(ch) { return false }
    const should_delete = i_trie_delete_helper(children[ch], key, depth + 1)
    if should_delete {
        children = children.delete(ch)
        node["__children"] = children
        return !node["__end"] && len(children) == 0
    }
    false
}

// Count total keys in the trie
func i_trie_count(node) {
    let count = 0
    if node["__end"] { count = 1 }
    const children = node["__children"]
    for ch in children.keys() {
        count = count + i_trie_count(children[ch])
    }
    count
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 34: LRU Cache — bounded cache with eviction
// ═══════════════════════════════════════════════════════════════════

// Create an LRU cache with a maximum capacity
func i_lru_new(capacity) {
    {
        "__lru": true,
        "__capacity": capacity,
        "__map": {},
        "__order": [],
    }
}

// Get a value from the LRU cache (moves to front)
func i_lru_get(cache, key) {
    const k = if typeof(key) == "string" { key } else { to_string(key) }
    let m = cache["__map"]
    if !m.has(k) { return null }
    // Move to front of order
    let order = cache["__order"]
    let new_order = [k]
    for item in order {
        if item != k { new_order.push(item) }
    }
    cache["__order"] = new_order
    m[k]
}

// Put a value into the LRU cache
func i_lru_put(cache, key, value) {
    const k = if typeof(key) == "string" { key } else { to_string(key) }
    let m = cache["__map"]
    let order = cache["__order"]

    // Remove old position if exists
    if m.has(k) {
        let new_order = []
        for item in order {
            if item != k { new_order.push(item) }
        }
        order = new_order
    }

    // Add to front
    order = [k].concat(order)
    m[k] = value

    // Evict if over capacity
    while len(order) > cache["__capacity"] {
        const evicted = order[len(order) - 1]
        order = order.slice(0, len(order) - 1)
        m = m.delete(evicted)
    }

    cache["__map"] = m
    cache["__order"] = order
    cache
}

// Check if key exists in LRU
func i_lru_has(cache, key) {
    const k = if typeof(key) == "string" { key } else { to_string(key) }
    cache["__map"].has(k)
}

// Get the size of the LRU cache
func i_lru_size(cache) {
    len(cache["__order"])
}

// Clear the LRU cache
func i_lru_clear(cache) {
    cache["__map"] = {}
    cache["__order"] = []
    cache
}

// Get all keys in LRU order (most recent first)
func i_lru_keys(cache) {
    cache["__order"]
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 35: Interpreter Execution Statistics and Profiling
// ═══════════════════════════════════════════════════════════════════

// Execution counter for profiling
let i_exec_stats = {"__init": true}

// Reset execution statistics
func i_stats_reset() {
    i_exec_stats = {
        "__init": true,
        "stmt_count": 0,
        "expr_count": 0,
        "call_count": 0,
        "scope_pushes": 0,
        "scope_pops": 0,
        "match_count": 0,
        "loop_iterations": 0,
    }
}

// Increment a stat counter
func i_stats_inc(key) {
    if !i_exec_stats.has(key) {
        i_exec_stats[key] = 0
    }
    i_exec_stats[key] = i_exec_stats[key] + 1
}

// Get all execution stats
func i_stats_get() {
    let result = {}
    for k in i_exec_stats.keys() {
        if k != "__init" {
            result[k] = i_exec_stats[k]
        }
    }
    result
}

// Print execution stats summary
func i_stats_summary() {
    const stats = i_stats_get()
    let sb = i_sb_new()
    i_sb_line(sb, "Execution Statistics:")
    for k in stats.keys() {
        i_sb_line(sb, f"  {k}: {stats[k]}")
    }
    println(i_sb_build(sb))
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 36: Test Framework — lightweight test runner
// ═══════════════════════════════════════════════════════════════════

// Test registry
let i_test_registry = []

// Register a test
func i_test_register(name, fn_val) {
    i_test_registry.push({"name": name, "fn": fn_val})
}

// Run all registered tests
func i_test_run_all() {
    let passed = 0
    let failed = 0
    let errors = []

    for test_entry in i_test_registry {
        const name = test_entry["name"]
        const fn_val = test_entry["fn"]
        let success = true
        // In the self-hosted interpreter we cannot catch panics,
        // so tests that panic will halt execution.
        // This is a best-effort test runner.
        i_call_any(fn_val, [])
        if success {
            passed = passed + 1
            println(f"  PASS: {name}")
        }
    }

    println(f"\n{passed} passed, {failed} failed out of {passed + failed} tests")

    if len(errors) > 0 {
        println("\nFailed tests:")
        for err in errors {
            println(f"  - {err}")
        }
    }

    failed == 0
}

// Assert helpers for tests
func i_assert_eq(actual, expected, msg) {
    if actual != expected {
        panic(f"assertion failed: {msg}\n  expected: {i_display(expected)}\n  actual: {i_display(actual)}")
    }
}

func i_assert_ne(actual, unexpected, msg) {
    if actual == unexpected {
        panic(f"assertion failed: {msg}\n  expected not: {i_display(unexpected)}\n  actual: {i_display(actual)}")
    }
}

func i_assert_true(val, msg) {
    if !i_truthy(val) {
        panic(f"assertion failed: expected truthy, got {i_display(val)}: {msg}")
    }
}

func i_assert_false(val, msg) {
    if i_truthy(val) {
        panic(f"assertion failed: expected falsy, got {i_display(val)}: {msg}")
    }
}

func i_assert_null(val, msg) {
    if val != null {
        panic(f"assertion failed: expected null, got {i_display(val)}: {msg}")
    }
}

func i_assert_not_null(val, msg) {
    if val == null {
        panic(f"assertion failed: expected non-null: {msg}")
    }
}

func i_assert_contains(container, item, msg) {
    const ct = typeof(container)
    if ct == "array" {
        if !container.contains(item) {
            panic(f"assertion failed: array does not contain {i_display(item)}: {msg}")
        }
    } else if ct == "string" {
        if !container.contains(if typeof(item) == "string" { item } else { to_string(item) }) {
            panic(f"assertion failed: string does not contain {i_display(item)}: {msg}")
        }
    } else if ct == "map" {
        const k = if typeof(item) == "string" { item } else { to_string(item) }
        if !container.has(k) {
            panic(f"assertion failed: map does not contain key {i_display(item)}: {msg}")
        }
    } else {
        panic(f"assertion failed: cannot check containment on {ct}: {msg}")
    }
}

func i_assert_deep_eq(actual, expected, msg) {
    if !i_deep_eq(actual, expected) {
        panic(f"assertion failed (deep equality): {msg}\n  expected: {i_display(expected)}\n  actual: {i_display(actual)}")
    }
}

func i_assert_throws(fn_val, msg) {
    // In self-hosted interpreter we cannot catch panics
    // This is a placeholder for documentation
    null
}

func i_assert_type(val, expected_type, msg) {
    const actual_type = typeof(val)
    if actual_type != expected_type {
        if i_is_struct(val) {
            if i_struct_name(val) == expected_type { return null }
        }
        if i_is_enum(val) {
            if i_enum_name(val) == expected_type { return null }
        }
        panic(f"assertion failed: expected type '{expected_type}', got '{actual_type}': {msg}")
    }
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 37: Async Simulation — promise-like patterns
// ═══════════════════════════════════════════════════════════════════

// Create a resolved promise
func i_promise_resolve(val) {
    {"__promise": true, "__status": "resolved", "__value": val}
}

// Create a rejected promise
func i_promise_reject(err) {
    {"__promise": true, "__status": "rejected", "__error": err}
}

// Chain a then handler
func i_promise_then(promise, fn_val) {
    if promise["__status"] == "resolved" {
        const result = i_call_any(fn_val, [promise["__value"]])
        if typeof(result) == "map" && result.has("__promise") {
            return result
        }
        return i_promise_resolve(result)
    }
    promise
}

// Chain a catch handler
func i_promise_catch(promise, fn_val) {
    if promise["__status"] == "rejected" {
        const result = i_call_any(fn_val, [promise["__error"]])
        return i_promise_resolve(result)
    }
    promise
}

// Promise.all: resolve when all promises resolve
func i_promise_all(promises) {
    let results = []
    for p in promises {
        if p["__status"] == "rejected" {
            return p
        }
        results.push(p["__value"])
    }
    i_promise_resolve(results)
}

// Promise.race: resolve with the first resolved promise
func i_promise_race(promises) {
    for p in promises {
        if p["__status"] == "resolved" {
            return p
        }
    }
    for p in promises {
        if p["__status"] == "rejected" {
            return p
        }
    }
    i_promise_resolve(null)
}

// Promise.any: resolve with the first resolved, reject if all rejected
func i_promise_any(promises) {
    for p in promises {
        if p["__status"] == "resolved" {
            return p
        }
    }
    i_promise_reject("all promises rejected")
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 38: Extended Scope Operations — scope snapshots, closures
// ═══════════════════════════════════════════════════════════════════

// Take a snapshot of the current scope stack
func i_scope_snapshot() {
    let snapshot = []
    for scope in i_scopes {
        let s = {}
        for k in scope.keys() {
            s[k] = scope[k]
        }
        snapshot.push(s)
    }
    snapshot
}

// Restore a scope snapshot
func i_scope_restore(snapshot) {
    i_scopes = snapshot
}

// Get all variable names visible in the current scope
func i_scope_all_vars() {
    let vars = {"__init": true}
    for scope in i_scopes {
        for k in scope.keys() {
            if k != "__s" {
                vars[k] = true
            }
        }
    }
    let result = []
    for k in vars.keys() {
        if k != "__init" {
            result.push(k)
        }
    }
    result
}

// Check if a variable is defined in any scope
func i_scope_has_var(name) {
    let idx = len(i_scopes) - 1
    while idx >= 0 {
        if i_scopes[idx].has(name) { return true }
        idx = idx - 1
    }
    false
}

// Get the scope depth
func i_scope_depth() {
    len(i_scopes)
}

// Get variables in the current (innermost) scope only
func i_scope_current_vars() {
    let vars = []
    const scope = i_scopes[len(i_scopes) - 1]
    for k in scope.keys() {
        if k != "__s" {
            vars.push(k)
        }
    }
    vars
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 39: Error Recovery — resilient evaluation
// ═══════════════════════════════════════════════════════════════════

// Evaluate an expression with a default fallback on error
// Note: MAGI self-hosted does not have try-catch, so this is best-effort
func i_eval_or_default(expr, default_val) {
    // In the self-hosted interpreter, we cannot catch panics
    // This will evaluate the expression and panic if it fails
    eval_expr(expr)
}

// Validate that a value matches expected type
func i_validate_type(val, expected) {
    const actual = typeof(val)
    if expected == "any" { return true }
    if actual == expected { return true }
    if expected == "number" && (actual == "int64" || actual == "float64") { return true }
    if expected == "callable" && i_is_closure(val) { return true }
    if expected == "struct" && i_is_struct(val) { return true }
    if expected == "enum" && i_is_enum(val) { return true }
    false
}

// Validate function arguments
func i_validate_args(func_name, args, expected_types) {
    if len(args) != len(expected_types) {
        panic(f"{func_name}: expected {len(expected_types)} arguments, got {len(args)}")
    }
    let idx = 0
    while idx < len(args) {
        if !i_validate_type(args[idx], expected_types[idx]) {
            const actual = typeof(args[idx])
            panic(f"{func_name}: argument {idx} expected {expected_types[idx]}, got {actual}")
        }
        idx = idx + 1
    }
    true
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 40: Number Formatting and Parsing
// ═══════════════════════════════════════════════════════════════════

// Format number with thousands separator
func i_num_format_thousands(n) {
    const s = to_string(if n < 0 { 0 - n } else { n })
    let result = ""
    let count = 0
    let i = len(s) - 1
    while i >= 0 {
        if count > 0 && count % 3 == 0 {
            result = "," + result
        }
        result = s[i] + result
        count = count + 1
        i = i - 1
    }
    if n < 0 { result = "-" + result }
    result
}

// Format as percentage
func i_num_format_percent(n, decimals) {
    const pct = i_mul(n, 100)
    const s = to_string(pct)
    s + "%"
}

// Format with fixed decimal places (integer approximation)
func i_num_format_fixed(n, places) {
    const t = typeof(n)
    if t == "int64" {
        let result = to_string(n)
        if places > 0 {
            result = result + "."
            let i = 0
            while i < places {
                result = result + "0"
                i = i + 1
            }
        }
        return result
    }
    to_string(n)
}

// Parse a number string with various formats
func i_num_parse(s) {
    const trimmed = s.trim()
    // Remove thousands separators
    const cleaned = trimmed.replace(",", "")
    // Check for hex
    if cleaned.starts_with("0x") || cleaned.starts_with("0X") {
        return i_parse_hex(cleaned.slice(2, len(cleaned)))
    }
    // Check for binary
    if cleaned.starts_with("0b") || cleaned.starts_with("0B") {
        return i_parse_bin(cleaned.slice(2, len(cleaned)))
    }
    // Check for octal
    if cleaned.starts_with("0o") || cleaned.starts_with("0O") {
        return i_parse_oct(cleaned.slice(2, len(cleaned)))
    }
    // Try float
    if cleaned.contains(".") {
        return parse_float(cleaned)
    }
    // Try int
    parse_int(cleaned)
}

// Parse hexadecimal string to int
func i_parse_hex(s) {
    let result = 0
    for ch in s.chars() {
        result = result * 16
        if ch >= "0" && ch <= "9" {
            result = result + char_code(ch) - char_code("0")
        } else if ch >= "a" && ch <= "f" {
            result = result + char_code(ch) - char_code("a") + 10
        } else if ch >= "A" && ch <= "F" {
            result = result + char_code(ch) - char_code("A") + 10
        } else {
            panic(f"invalid hex digit: {ch}")
        }
    }
    result
}

// Parse binary string to int
func i_parse_bin(s) {
    let result = 0
    for ch in s.chars() {
        result = result * 2
        if ch == "0" {
            // nothing
        } else if ch == "1" {
            result = result + 1
        } else {
            panic(f"invalid binary digit: {ch}")
        }
    }
    result
}

// Parse octal string to int
func i_parse_oct(s) {
    let result = 0
    for ch in s.chars() {
        result = result * 8
        const digit = char_code(ch) - char_code("0")
        if digit < 0 || digit > 7 {
            panic(f"invalid octal digit: {ch}")
        }
        result = result + digit
    }
    result
}

// Roman numeral conversion
func i_to_roman(n) {
    if n <= 0 || n > 3999 { panic("roman numerals: value must be 1-3999") }
    let result = ""
    let remaining = n
    const values = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
    const symbols = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
    let i = 0
    while i < len(values) {
        while remaining >= values[i] {
            result = result + symbols[i]
            remaining = remaining - values[i]
        }
        i = i + 1
    }
    result
}

// Convert English word for a digit
func i_digit_word(n) {
    const words = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine"]
    if n >= 0 && n <= 9 { return words[n] }
    to_string(n)
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 41: Generic Iteration Combinators — zip_with, scan, unfold,
//             iterate, repeat_fn, cycle, interpose, partition_by
// ═══════════════════════════════════════════════════════════════════

// Zip two arrays with a combining function
func i_zip_with(fn_val, a, b) {
    let result = []
    const min_len = if len(a) < len(b) { len(a) } else { len(b) }
    let i = 0
    while i < min_len {
        result.push(i_call_any(fn_val, [a[i], b[i]]))
        i = i + 1
    }
    result
}

// Scan: like reduce but collects all intermediate values
func i_scan(fn_val, initial, arr) {
    let result = [initial]
    let acc = initial
    for item in arr {
        acc = i_call_any(fn_val, [acc, item])
        result.push(acc)
    }
    result
}

// Unfold: generate a sequence from a seed value
// fn takes seed, returns [value, next_seed] or null to stop
func i_unfold(fn_val, seed) {
    let result = []
    let current = seed
    let max_iters = 10000
    let count = 0
    while count < max_iters {
        const step = i_call_any(fn_val, [current])
        if step == null { break }
        if typeof(step) != "array" || len(step) < 2 { break }
        result.push(step[0])
        current = step[1]
        count = count + 1
    }
    result
}

// Iterate: generate a sequence by repeatedly applying a function
// Returns first n values: [seed, f(seed), f(f(seed)), ...]
func i_iterate(fn_val, seed, n) {
    let result = [seed]
    let current = seed
    let i = 1
    while i < n {
        current = i_call_any(fn_val, [current])
        result.push(current)
        i = i + 1
    }
    result
}

// Repeat a function call n times, collecting results
func i_repeat_fn(fn_val, n) {
    let result = []
    let i = 0
    while i < n {
        result.push(i_call_any(fn_val, [i]))
        i = i + 1
    }
    result
}

// Cycle: repeat an array n times
func i_cycle(arr, n) {
    let result = []
    let i = 0
    while i < n {
        for item in arr {
            result.push(item)
        }
        i = i + 1
    }
    result
}

// Interpose: insert a separator between each element
func i_interpose(arr, sep) {
    if len(arr) <= 1 { return arr }
    let result = [arr[0]]
    let i = 1
    while i < len(arr) {
        result.push(sep)
        result.push(arr[i])
        i = i + 1
    }
    result
}

// Partition by: split array when predicate result changes
func i_partition_by(arr, fn_val) {
    if len(arr) == 0 { return [] }
    let result = []
    let current_group = [arr[0]]
    let current_key = i_call_any(fn_val, [arr[0]])
    let i = 1
    while i < len(arr) {
        const key = i_call_any(fn_val, [arr[i]])
        if key == current_key {
            current_group.push(arr[i])
        } else {
            result.push(current_group)
            current_group = [arr[i]]
            current_key = key
        }
        i = i + 1
    }
    if len(current_group) > 0 {
        result.push(current_group)
    }
    result
}

// Map with index: apply function that receives (item, index)
func i_map_indexed(arr, fn_val) {
    let result = []
    let i = 0
    for item in arr {
        result.push(i_call_any(fn_val, [item, i]))
        i = i + 1
    }
    result
}

// Reduce with index: fold with function that receives (acc, item, index)
func i_reduce_indexed(arr, fn_val, initial) {
    let acc = initial
    let i = 0
    for item in arr {
        acc = i_call_any(fn_val, [acc, item, i])
        i = i + 1
    }
    acc
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 42: Bitwise and Numeric Utilities
// ═══════════════════════════════════════════════════════════════════

// Count set bits (population count)
func i_popcount(n) {
    let count = 0
    let v = if n < 0 { 0 - n } else { n }
    while v > 0 {
        count = count + (v % 2)
        v = v / 2
    }
    count
}

// Count leading zeros (in a 64-bit representation)
func i_clz(n) {
    if n == 0 { return 64 }
    let count = 0
    let v = if n < 0 { 0 - n } else { n }
    // Find highest set bit
    let bits = 0
    let temp = v
    while temp > 0 {
        bits = bits + 1
        temp = temp / 2
    }
    64 - bits
}

// Count trailing zeros
func i_ctz(n) {
    if n == 0 { return 64 }
    let count = 0
    let v = if n < 0 { 0 - n } else { n }
    while v % 2 == 0 {
        count = count + 1
        v = v / 2
    }
    count
}

// Check if a number is a power of two
func i_is_power_of_two(n) {
    if n <= 0 { return false }
    (n & (n - 1)) == 0
}

// Next power of two >= n
func i_next_power_of_two(n) {
    if n <= 0 { return 1 }
    let p = 1
    while p < n {
        p = p * 2
    }
    p
}

// Bit test: check if bit at position is set
func i_bit_test(n, pos) {
    (n >> pos) & 1 == 1
}

// Bit set: set bit at position
func i_bit_set(n, pos) {
    n | (1 << pos)
}

// Bit clear: clear bit at position
func i_bit_clear(n, pos) {
    n & ((1 << pos) ^ -1)
}

// Bit toggle: toggle bit at position
func i_bit_toggle(n, pos) {
    n ^ (1 << pos)
}

// Rotate bits left
func i_rotate_left(n, shift, bits) {
    ((n << shift) | (n >> (bits - shift))) & ((1 << bits) - 1)
}

// Rotate bits right
func i_rotate_right(n, shift, bits) {
    ((n >> shift) | (n << (bits - shift))) & ((1 << bits) - 1)
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 43: Table Formatting — format data as ASCII tables
// ═══════════════════════════════════════════════════════════════════

// Format a 2D array as an ASCII table
func i_format_table(headers, rows) {
    // Calculate column widths
    let widths = headers.map(h => len(i_display(h)))
    for row in rows {
        let i = 0
        while i < len(row) && i < len(widths) {
            const cell_len = len(i_display(row[i]))
            if cell_len > widths[i] {
                widths[i] = cell_len
            }
            i = i + 1
        }
    }

    let sb = i_sb_new()

    // Header separator
    let sep_parts = []
    for w in widths {
        sep_parts.push(i_str_repeat("-", w + 2))
    }
    const sep_line = "+" + sep_parts.join("+") + "+"

    // Header row
    i_sb_line(sb, sep_line)
    let header_parts = []
    let i = 0
    while i < len(headers) {
        const cell = i_display(headers[i])
        header_parts.push(" " + i_pad_left(cell, widths[i]) + " ")
        i = i + 1
    }
    i_sb_line(sb, "|" + header_parts.join("|") + "|")
    i_sb_line(sb, sep_line)

    // Data rows
    for row in rows {
        let row_parts = []
        let j = 0
        while j < len(headers) {
            const val = if j < len(row) { i_display(row[j]) } else { "" }
            row_parts.push(" " + i_pad_left(val, widths[j]) + " ")
            j = j + 1
        }
        i_sb_line(sb, "|" + row_parts.join("|") + "|")
    }
    i_sb_line(sb, sep_line)

    i_sb_build(sb)
}

// Format a map as a key-value table
func i_format_kv_table(m) {
    let headers = ["Key", "Value"]
    let rows = []
    for k in m.keys() {
        rows.push([k, m[k]])
    }
    i_format_table(headers, rows)
}

// Format an array of maps as a table
func i_format_record_table(records) {
    if len(records) == 0 { return "" }
    // Collect all keys
    let all_keys = {"__init": true}
    for record in records {
        if typeof(record) == "map" {
            for k in record.keys() {
                if k != "__struct" && k != "__enum" {
                    all_keys[k] = true
                }
            }
        }
    }
    let headers = []
    for k in all_keys.keys() {
        if k != "__init" { headers.push(k) }
    }

    let rows = []
    for record in records {
        let row = []
        for h in headers {
            if typeof(record) == "map" && record.has(h) {
                row.push(record[h])
            } else {
                row.push("")
            }
        }
        rows.push(row)
    }
    i_format_table(headers, rows)
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 44: Ring Buffer — fixed-size circular buffer
// ═══════════════════════════════════════════════════════════════════

func i_ring_new(capacity) {
    let items = []
    let i = 0
    while i < capacity {
        items.push(null)
        i = i + 1
    }
    {
        "__ring": true,
        "__items": items,
        "__capacity": capacity,
        "__head": 0,
        "__size": 0,
    }
}

func i_ring_push(ring, val) {
    const cap = ring["__capacity"]
    const head = ring["__head"]
    const size = ring["__size"]
    const write_idx = (head + size) % cap
    let items = ring["__items"]
    items[write_idx] = val
    ring["__items"] = items
    if size < cap {
        ring["__size"] = size + 1
    } else {
        ring["__head"] = (head + 1) % cap
    }
    ring
}

func i_ring_get(ring, idx) {
    const cap = ring["__capacity"]
    const head = ring["__head"]
    const size = ring["__size"]
    if idx < 0 || idx >= size { panic("ring buffer index out of bounds") }
    const real_idx = (head + idx) % cap
    ring["__items"][real_idx]
}

func i_ring_size(ring) {
    ring["__size"]
}

func i_ring_is_full(ring) {
    ring["__size"] == ring["__capacity"]
}

func i_ring_to_array(ring) {
    let result = []
    let i = 0
    while i < ring["__size"] {
        result.push(i_ring_get(ring, i))
        i = i + 1
    }
    result
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 45: Interval and Timer Utilities
// ═══════════════════════════════════════════════════════════════════

// Range check: is value in [lo, hi]
func i_range_contains(lo, hi, val) {
    i_compare(val, lo) >= 0 && i_compare(val, hi) <= 0
}

// Range overlap: do [a_lo, a_hi] and [b_lo, b_hi] overlap?
func i_range_overlaps(a_lo, a_hi, b_lo, b_hi) {
    i_compare(a_lo, b_hi) <= 0 && i_compare(b_lo, a_hi) <= 0
}

// Merge overlapping intervals (array of [lo, hi] pairs)
func i_merge_intervals(intervals) {
    if len(intervals) <= 1 { return intervals }
    // Sort by lo
    let sorted = i_sort_insertion(intervals, (a, b) => i_compare(a[0], b[0]))
    let merged = [sorted[0]]
    let i = 1
    while i < len(sorted) {
        const last = merged[len(merged) - 1]
        const current = sorted[i]
        if i_compare(current[0], last[1]) <= 0 {
            // Overlap: extend the last interval
            const new_hi = if i_compare(current[1], last[1]) > 0 { current[1] } else { last[1] }
            merged[len(merged) - 1] = [last[0], new_hi]
        } else {
            merged.push(current)
        }
        i = i + 1
    }
    merged
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 46: Codec — Base64, URL encoding (simplified)
// ═══════════════════════════════════════════════════════════════════

// Base64 alphabet
const I_B64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

// Simple base64 encode for ASCII strings
func i_base64_encode(s) {
    let result = ""
    let i = 0
    const n = len(s)
    while i < n {
        const b0 = char_code(s[i])
        const b1 = if i + 1 < n { char_code(s[i + 1]) } else { 0 }
        const b2 = if i + 2 < n { char_code(s[i + 2]) } else { 0 }

        const idx0 = b0 >> 2
        const idx1 = ((b0 & 3) << 4) | (b1 >> 4)
        const idx2 = ((b1 & 15) << 2) | (b2 >> 6)
        const idx3 = b2 & 63

        result = result + I_B64_CHARS[idx0]
        result = result + I_B64_CHARS[idx1]

        if i + 1 < n {
            result = result + I_B64_CHARS[idx2]
        } else {
            result = result + "="
        }
        if i + 2 < n {
            result = result + I_B64_CHARS[idx3]
        } else {
            result = result + "="
        }
        i = i + 3
    }
    result
}

// URL encode a string (percent encoding for non-alphanumeric chars)
func i_url_encode(s) {
    let result = ""
    for ch in s.chars() {
        const code = char_code(ch)
        if (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || (code >= 48 && code <= 57) || ch == "-" || ch == "_" || ch == "." || ch == "~" {
            result = result + ch
        } else if ch == " " {
            result = result + "+"
        } else {
            const hex = i_int_to_hex(code)
            const padded = if len(hex) < 2 { "0" + hex } else { hex }
            result = result + "%" + padded.to_upper()
        }
    }
    result
}

// Simple CSV line parser (does not handle quoted fields with commas)
func i_csv_parse_line(line) {
    line.split(",").map(cell => cell.trim())
}

// Format array of arrays as CSV
func i_csv_format(rows) {
    let lines = []
    for row in rows {
        lines.push(row.map(cell => i_display(cell)).join(","))
    }
    lines.join("\n")
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 47: Path and URI Utilities
// ═══════════════════════════════════════════════════════════════════

// Split a dot-separated path into parts
func i_path_split(path) {
    path.split(".")
}

// Join path parts with dots
func i_path_join(parts) {
    parts.join(".")
}

// Get value at a dot-separated path in a nested map
func i_path_get(obj, path) {
    const parts = i_path_split(path)
    let current = obj
    for part in parts {
        if typeof(current) != "map" { return null }
        if !current.has(part) { return null }
        current = current[part]
    }
    current
}

// Set value at a dot-separated path in a nested map
func i_path_set(obj, path, value) {
    const parts = i_path_split(path)
    if len(parts) == 0 { return obj }
    if len(parts) == 1 {
        obj[parts[0]] = value
        return obj
    }
    let current = obj
    let i = 0
    while i < len(parts) - 1 {
        const part = parts[i]
        if !current.has(part) || typeof(current[part]) != "map" {
            current[part] = {}
        }
        current = current[part]
        i = i + 1
    }
    current[parts[len(parts) - 1]] = value
    obj
}

// Check if a path exists in a nested map
func i_path_exists(obj, path) {
    const parts = i_path_split(path)
    let current = obj
    for part in parts {
        if typeof(current) != "map" { return false }
        if !current.has(part) { return false }
        current = current[part]
    }
    true
}

// Delete a value at a dot-separated path
func i_path_delete(obj, path) {
    const parts = i_path_split(path)
    if len(parts) == 0 { return obj }
    if len(parts) == 1 {
        if typeof(obj) == "map" && obj.has(parts[0]) {
            return obj.delete(parts[0])
        }
        return obj
    }
    let current = obj
    let i = 0
    while i < len(parts) - 1 {
        const part = parts[i]
        if typeof(current) != "map" || !current.has(part) { return obj }
        current = current[part]
        i = i + 1
    }
    if typeof(current) == "map" {
        current = current.delete(parts[len(parts) - 1])
    }
    obj
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 48: Interpreter Pipeline — chain parse and eval steps
// ═══════════════════════════════════════════════════════════════════

// Parse source code into AST
func i_parse_to_ast(code) {
    parse(code)
}

// Evaluate an AST program node
func i_eval_ast(prog) {
    eval_program(prog)
}

// Parse and evaluate in one step (alias for eval_source)
func i_run(code) {
    eval_source(code)
}

// Run with custom initial bindings
func i_run_with_bindings(code, bindings) {
    const save_scopes = i_scopes
    const save_functions = i_functions
    const save_structs = i_structs
    const save_enums = i_enums

    i_scopes = [i_new_scope()]
    i_functions = {"__init": true}
    i_structs = {"__init": true}
    i_enums = {"__init": true}

    // Inject bindings
    for k in bindings.keys() {
        i_set(k, bindings[k], false)
    }

    const prog = parse(code)
    const result = eval_program(prog)

    i_scopes = save_scopes
    i_functions = save_functions
    i_structs = save_structs
    i_enums = save_enums

    result
}

// Run multiple code snippets in sequence, sharing state
func i_run_sequence(snippets) {
    const save_scopes = i_scopes
    const save_functions = i_functions
    const save_structs = i_structs
    const save_enums = i_enums

    i_scopes = [i_new_scope()]
    i_functions = {"__init": true}
    i_structs = {"__init": true}
    i_enums = {"__init": true}

    let last = null
    for code in snippets {
        const prog = parse(code)
        last = eval_program(prog)
    }

    i_scopes = save_scopes
    i_functions = save_functions
    i_structs = save_structs
    i_enums = save_enums

    last
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 49: Miscellaneous Helpers
// ═══════════════════════════════════════════════════════════════════

// Create a counter that increments each time it is called
func i_counter_new(start) {
    {"__counter": true, "__value": start}
}

func i_counter_next(counter) {
    const val = counter["__value"]
    counter["__value"] = val + 1
    val
}

func i_counter_peek(counter) {
    counter["__value"]
}

func i_counter_reset(counter, val) {
    counter["__value"] = val
    counter
}

// Create a unique ID generator
func i_id_gen_new() {
    i_counter_new(1)
}

func i_id_gen_next(gen) {
    i_counter_next(gen)
}

// Memoization cache with bounded size
func i_bounded_memo(fn_val, max_size) {
    let cache = i_lru_new(max_size)
    {"__bounded_memo": true, "__fn": fn_val, "__cache": cache}
}

func i_call_bounded_memo(memo, args) {
    const key = i_serialize(args)
    let cache = memo["__cache"]
    const cached = i_lru_get(cache, key)
    if cached != null { return cached }
    const result = i_call_any(memo["__fn"], args)
    i_lru_put(cache, key, result)
    result
}

// Retry: call a function up to n times until it succeeds
func i_retry(fn_val, max_attempts) {
    let attempt = 0
    while attempt < max_attempts {
        // In self-hosted interpreter we cannot catch panics,
        // so this just calls once
        return i_call_any(fn_val, [attempt])
    }
    panic("all retry attempts failed")
}

// Default map: a map with a default value for missing keys
func i_default_map(default_val) {
    {"__default_map": true, "__inner": {}, "__default": default_val}
}

func i_default_map_get(dm, key) {
    const k = if typeof(key) == "string" { key } else { to_string(key) }
    const inner = dm["__inner"]
    if inner.has(k) { return inner[k] }
    dm["__default"]
}

func i_default_map_set(dm, key, value) {
    const k = if typeof(key) == "string" { key } else { to_string(key) }
    let inner = dm["__inner"]
    inner[k] = value
    dm["__inner"] = inner
    dm
}

// Multi-map: a map where each key maps to an array of values
func i_multi_map_new() {
    {"__multi_map": true, "__inner": {}}
}

func i_multi_map_add(mm, key, value) {
    const k = if typeof(key) == "string" { key } else { to_string(key) }
    let inner = mm["__inner"]
    if !inner.has(k) { inner[k] = [] }
    let arr = inner[k]
    arr.push(value)
    inner[k] = arr
    mm["__inner"] = inner
    mm
}

func i_multi_map_get(mm, key) {
    const k = if typeof(key) == "string" { key } else { to_string(key) }
    const inner = mm["__inner"]
    if inner.has(k) { return inner[k] }
    []
}

func i_multi_map_keys(mm) {
    mm["__inner"].keys()
}

// Bidirectional map: lookup by either key or value
func i_bimap_new() {
    {"__bimap": true, "__forward": {}, "__reverse": {}}
}

func i_bimap_put(bm, key, value) {
    const k = if typeof(key) == "string" { key } else { to_string(key) }
    const v = if typeof(value) == "string" { value } else { to_string(value) }
    let fwd = bm["__forward"]
    let rev = bm["__reverse"]
    // Remove old mappings if they exist
    if fwd.has(k) {
        const old_v = fwd[k]
        rev = rev.delete(old_v)
    }
    if rev.has(v) {
        const old_k = rev[v]
        fwd = fwd.delete(old_k)
    }
    fwd[k] = v
    rev[v] = k
    bm["__forward"] = fwd
    bm["__reverse"] = rev
    bm
}

func i_bimap_get(bm, key) {
    const k = if typeof(key) == "string" { key } else { to_string(key) }
    const fwd = bm["__forward"]
    if fwd.has(k) { return fwd[k] }
    null
}

func i_bimap_get_reverse(bm, value) {
    const v = if typeof(value) == "string" { value } else { to_string(value) }
    const rev = bm["__reverse"]
    if rev.has(v) { return rev[v] }
    null
}

// ═══════════════════════════════════════════════════════════════════
// SECTION 50: Complete String Method Dispatch
// All string methods from src/syntax/interpreter.rs
// ═══════════════════════════════════════════════════════════════════

func i_string_method(obj, method, args) {
    match method {
        "len" => len(obj),
        "length" => len(obj),
        "is_empty" => len(obj) == 0,
        "trim" => obj.trim(),
        "trim_start" => {
            let s = obj
            while len(s) > 0 && (s[0] == " " || s[0] == "\t" || s[0] == "\n" || s[0] == "\r") {
                s = s.substring(1, len(s))
            }
            s
        },
        "trim_end" => {
            let s = obj
            while len(s) > 0 {
                const last = s[len(s) - 1]
                if last == " " || last == "\t" || last == "\n" || last == "\r" {
                    s = s.substring(0, len(s) - 1)
                } else {
                    break
                }
            }
            s
        },
        "to_upper" => to_upper(obj),
        "to_lower" => to_lower(obj),
        "to_uppercase" => to_upper(obj),
        "to_lowercase" => to_lower(obj),
        "split" => {
            const sep = if len(args) > 0 { args[0] } else { " " }
            obj.split(sep)
        },
        "contains" => {
            const sub = args[0]
            obj.contains(sub)
        },
        "starts_with" => starts_with(obj, args[0]),
        "ends_with" => ends_with(obj, args[0]),
        "replace" => {
            const from_str = args[0]
            const to_str = args[1]
            obj.replace(from_str, to_str)
        },
        "replace_first" => {
            const from_str = args[0]
            const to_str = args[1]
            const idx = obj.index_of(from_str)
            if idx < 0 { return obj }
            obj.substring(0, idx) + to_str + obj.substring(idx + len(from_str), len(obj))
        },
        "substring" => {
            const start = op_to_i64(args[0])
            const end_val = if len(args) > 1 { op_to_i64(args[1]) } else { len(obj) }
            obj.substring(start, end_val)
        },
        "substr" => {
            const start = op_to_i64(args[0])
            const length = if len(args) > 1 { op_to_i64(args[1]) } else { len(obj) - start }
            obj.substring(start, start + length)
        },
        "char_at" => {
            const idx = op_to_i64(args[0])
            if idx < 0 || idx >= len(obj) { return null }
            obj[idx]
        },
        "index_of" => {
            const sub = args[0]
            const start = if len(args) > 1 { op_to_i64(args[1]) } else { 0 }
            let i = start
            while i <= len(obj) - len(sub) {
                if obj.substring(i, i + len(sub)) == sub { return i }
                i = i + 1
            }
            -1
        },
        "last_index_of" => {
            const sub = args[0]
            let i = len(obj) - len(sub)
            while i >= 0 {
                if obj.substring(i, i + len(sub)) == sub { return i }
                i = i - 1
            }
            -1
        },
        "pad_start" => {
            const target_len = op_to_i64(args[0])
            const fill_char = if len(args) > 1 { args[1] } else { " " }
            let result = obj
            while len(result) < target_len {
                result = fill_char + result
            }
            result
        },
        "pad_end" => {
            const target_len = op_to_i64(args[0])
            const fill_char = if len(args) > 1 { args[1] } else { " " }
            let result = obj
            while len(result) < target_len {
                result = result + fill_char
            }
            result
        },
        "pad_left" => {
            const target_len = op_to_i64(args[0])
            const fill_char = if len(args) > 1 { args[1] } else { " " }
            let result = obj
            while len(result) < target_len {
                result = fill_char + result
            }
            result
        },
        "pad_right" => {
            const target_len = op_to_i64(args[0])
            const fill_char = if len(args) > 1 { args[1] } else { " " }
            let result = obj
            while len(result) < target_len {
                result = result + fill_char
            }
            result
        },
        "repeat" => {
            const count = op_to_i64(args[0])
            let result = ""
            let i = 0
            while i < count {
                result = result + obj
                i = i + 1
            }
            result
        },
        "reverse" => {
            let result = ""
            let i = len(obj) - 1
            while i >= 0 {
                result = result + obj[i]
                i = i - 1
            }
            result
        },
        "lines" => {
            obj.split("\n")
        },
        "words" => {
            let result = []
            let current = ""
            for c in obj.chars() {
                if c == " " || c == "\t" || c == "\n" || c == "\r" {
                    if len(current) > 0 {
                        result.push(current)
                        current = ""
                    }
                } else {
                    current = current + c
                }
            }
            if len(current) > 0 { result.push(current) }
            result
        },
        "chars" => obj.chars(),
        "bytes" => {
            let result = []
            for c in obj.chars() {
                result.push(char_code(c))
            }
            result
        },
        "count" => {
            const sub = args[0]
            if len(sub) == 0 { return len(obj) + 1 }
            let count = 0
            let i = 0
            while i <= len(obj) - len(sub) {
                if obj.substring(i, i + len(sub)) == sub {
                    count = count + 1
                    i = i + len(sub)
                } else {
                    i = i + 1
                }
            }
            count
        },
        "join" => {
            if len(args) > 0 && typeof(args[0]) == "array" {
                return args[0].join(obj)
            }
            obj
        },
        "format" => {
            let result = obj
