// MAGI Self-Hosted Compiler — Platform FFI
//
// Provides OS-level access: terminal raw mode, SDL2 graphics, PulseAudio audio.
// All operations delegate to stage 0 builtins.

// ── Terminal (Termios FFI) ──────────────────────────────────────────

func platform_raw_mode_enable() { raw_mode_enable() }
func platform_raw_mode_disable() { raw_mode_disable() }
func platform_read_byte() { read_byte() }
func platform_read_byte_timeout(deciseconds) { read_byte_timeout(deciseconds) }

// ── SDL2 Graphics ───────────────────────────────────────────────────

func platform_sdl_init(title, width, height) { sdl_init(title, width, height) }
func platform_sdl_set_color(handle, r, g, b) { sdl_set_color(handle, r, g, b) }
func platform_sdl_clear(handle) { sdl_clear(handle) }
func platform_sdl_present(handle) { sdl_present(handle) }
func platform_sdl_draw_pixel(handle, x, y) { sdl_draw_pixel(handle, x, y) }
func platform_sdl_draw_line(handle, x1, y1, x2, y2) { sdl_draw_line(handle, x1, y1, x2, y2) }
func platform_sdl_fill_rect(handle, x, y, w, h) { sdl_fill_rect(handle, x, y, w, h) }
func platform_sdl_poll_event(handle) { sdl_poll_event(handle) }
func platform_sdl_delay(ms) { sdl_delay(ms) }
func platform_sdl_ticks(handle) { sdl_ticks(handle) }
func platform_sdl_destroy(handle) { sdl_destroy(handle) }

// SDL event constants
const SDL_QUIT_EVENT = 256
const SDL_KEYDOWN = 768
const SDL_KEYUP = 769

// ── PulseAudio Streaming ────────────────────────────────────────────

func platform_audio_stream_new(sample_rate) { audio_stream_new(sample_rate) }
func platform_audio_write_samples(handle, samples) { audio_write_samples(handle, samples) }
func platform_audio_drain(handle) { audio_drain(handle) }
func platform_audio_close(handle) { audio_close(handle) }

// ── WebGPU (WASM target) ────────────────────────────────────────────

func platform_gpu_init(canvas) { gpu_init(canvas) }
func platform_gpu_create_buffer(device, size, usage) { gpu_create_buffer(device, size, usage) }
func platform_gpu_create_shader(device, code) { gpu_create_shader(device, code) }
func platform_gpu_create_pipeline(device, vertex, fragment) { gpu_create_pipeline(device, vertex, fragment) }
func platform_gpu_begin_render_pass(encoder, descriptor) { gpu_begin_render_pass(encoder, descriptor) }
func platform_gpu_draw(pass, vertex_count) { gpu_draw(pass, vertex_count) }
func platform_gpu_end_render_pass(pass) { gpu_end_render_pass(pass) }
func platform_gpu_submit(device, commands) { gpu_submit(device, commands) }
func platform_gpu_present(device) { gpu_present(device) }
func platform_gpu_write_buffer(device, buffer, data) { gpu_write_buffer(device, buffer, data) }
func platform_gpu_create_texture(device, width, height, format) { gpu_create_texture(device, width, height, format) }
func platform_gpu_destroy(device) { gpu_destroy(device) }

// ── OS Detection ────────────────────────────────────────────────────

func platform_os() { os_name() }
func platform_arch() { env_get("MAGI_BUILD_TARGET") ?? "unknown" }
func platform_is_linux() { platform_os() == "linux" }
func platform_is_macos() { platform_os() == "macos" }
func platform_is_windows() { platform_os() == "windows" }
