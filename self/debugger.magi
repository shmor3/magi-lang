// MAGI Self-Hosted Compiler — Step-Through Debugger
//
// Provides interactive debugging of MAGI programs:
//   - Set/remove breakpoints by line number
//   - Step, next, continue commands
//   - Variable inspection at current scope
//   - Stack trace display
//   - Expression evaluation in debug context
//
// Uses the self-hosted interpreter's scope stack for variable inspection.

// ══════════════════════════════════════════════════════════════════════
// ── Helpers ──────────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func pad_left(s, width) {
    let result = s
    while len(result) < width {
        result = " " + result
    }
    result
}

// ══════════════════════════════════════════════════════════════════════
// ── Debugger State ───────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

let dbg_breakpoints = {"__s": true}  // line_number -> true
let dbg_step_mode = true
let dbg_running = true
let dbg_source_lines = []
let dbg_current_line = 0
let dbg_call_stack = []  // stack of {"name": fn_name, "line": line}
let dbg_watch_exprs = []  // list of expression strings to evaluate each step

// ══════════════════════════════════════════════════════════════════════
// ── Breakpoint Management ────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func dbg_set_breakpoint(line) {
    dbg_breakpoints[to_string(line)] = true
    println(f"Breakpoint set at line {line}")
}

func dbg_remove_breakpoint(line) {
    const key = to_string(line)
    if dbg_breakpoints.has(key) {
        dbg_breakpoints[key] = false
        println(f"Breakpoint removed at line {line}")
    } else {
        println(f"No breakpoint at line {line}")
    }
}

func dbg_has_breakpoint(line) {
    const key = to_string(line)
    dbg_breakpoints.has(key) && dbg_breakpoints[key] == true
}

func dbg_list_breakpoints() {
    let bps = []
    for key in keys(dbg_breakpoints) {
        if key == "__s" { continue }
        if dbg_breakpoints[key] == true {
            bps.push(to_int(key))
        }
    }
    if len(bps) == 0 {
        println("No breakpoints set.")
    } else {
        bps = sort(bps)
        println("Breakpoints: " + bps.join(", "))
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Source Display ───────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func dbg_show_context(line, context_lines) {
    const total = len(dbg_source_lines)
    const start = max(0, line - context_lines)
    const end_line = min(total, line + context_lines + 1)

    let i = start
    while i < end_line {
        const marker = if i + 1 == line { ">>>" } else { "   " }
        const bp_marker = if dbg_has_breakpoint(i + 1) { "*" } else { " " }
        const line_text = if i < total { dbg_source_lines[i] } else { "" }
        const line_num = to_string(i + 1)
        const padded = pad_left(line_num, 4)
        println(marker + bp_marker + padded + " | " + line_text)
        i = i + 1
    }
}

func dbg_show_current() {
    dbg_show_context(dbg_current_line, 2)
}

// ══════════════════════════════════════════════════════════════════════
// ── Variable Inspection ──────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func dbg_show_locals() {
    // Read from the interpreter's scope stack
    if len(i_scopes) == 0 {
        println("No active scope.")
        return
    }
    const current_scope = i_scopes[len(i_scopes) - 1]
    let count = 0
    for name in keys(current_scope) {
        if name == "__s" { continue }
        const val = current_scope[name]
        println(f"  {name} = {val}")
        count = count + 1
    }
    if count == 0 {
        println("  (no local variables)")
    }
}

func dbg_show_all_vars() {
    // Show variables from all scopes (innermost first)
    let scope_idx = len(i_scopes) - 1
    while scope_idx >= 0 {
        const scope = i_scopes[scope_idx]
        const label = if scope_idx == 0 { "global" } else { f"scope {scope_idx}" }
        println(f"[{label}]")
        for name in keys(scope) {
            if name == "__s" { continue }
            const val = scope[name]
            println(f"  {name} = {val}")
        }
        scope_idx = scope_idx - 1
    }
}

func dbg_inspect_var(name) {
    // Search scopes from innermost to outermost
    let scope_idx = len(i_scopes) - 1
    while scope_idx >= 0 {
        const scope = i_scopes[scope_idx]
        if scope.has(name) {
            const val = scope[name]
            const t = typeof(val)
            println(f"  {name}: {t} = {val}")
            return
        }
        scope_idx = scope_idx - 1
    }
    println("  Variable " + name + " not found in any scope.")
}

// ══════════════════════════════════════════════════════════════════════
// ── Stack Trace ──────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func dbg_push_frame(name, line) {
    dbg_call_stack.push({"name": name, "line": line})
}

func dbg_pop_frame() {
    if len(dbg_call_stack) > 0 {
        dbg_call_stack = dbg_call_stack[0..len(dbg_call_stack) - 1]
    }
}

func dbg_show_stack_trace() {
    if len(dbg_call_stack) == 0 {
        println("  <top-level>")
        return
    }
    println("Stack trace (most recent first):")
    let i = len(dbg_call_stack) - 1
    while i >= 0 {
        const frame = dbg_call_stack[i]
        println("  #" + to_string(len(dbg_call_stack) - i) + " " + frame["name"] + " at line " + to_string(frame["line"]))
        i = i - 1
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Watch Expressions ────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func dbg_add_watch(expr) {
    dbg_watch_exprs.push(expr)
    println(f"Watch added: {expr}")
}

func dbg_remove_watch(index) {
    if index >= 0 && index < len(dbg_watch_exprs) {
        const removed = dbg_watch_exprs[index]
        let new_watches = []
        let i = 0
        while i < len(dbg_watch_exprs) {
            if i != index {
                new_watches.push(dbg_watch_exprs[i])
            }
            i = i + 1
        }
        dbg_watch_exprs = new_watches
        println(f"Watch removed: {removed}")
    } else {
        println(f"Invalid watch index: {index}")
    }
}

func dbg_show_watches() {
    if len(dbg_watch_exprs) == 0 {
        return
    }
    println("Watches:")
    let i = 0
    for expr in dbg_watch_exprs {
        // Try to look up simple variable names
        let val = "<cannot evaluate>"
        let scope_idx = len(i_scopes) - 1
        while scope_idx >= 0 {
            if i_scopes[scope_idx].has(expr) {
                val = to_string(i_scopes[scope_idx][expr])
                break
            }
            scope_idx = scope_idx - 1
        }
        println(f"  [{i}] {expr} = {val}")
        i = i + 1
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Debug Command Processing ─────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func dbg_process_command(cmd) {
    const trimmed = cmd.trim()
    if trimmed == "" || trimmed == "s" || trimmed == "step" || trimmed == "n" || trimmed == "next" {
        dbg_step_mode = true
        return "step"
    }
    if trimmed == "c" || trimmed == "continue" {
        dbg_step_mode = false
        return "continue"
    }
    if trimmed == "q" || trimmed == "quit" {
        dbg_running = false
        return "quit"
    }
    if trimmed == "h" || trimmed == "help" {
        dbg_print_help()
        return "help"
    }
    if trimmed == "w" || trimmed == "where" {
        dbg_show_current()
        return "where"
    }
    if trimmed == "l" || trimmed == "locals" {
        dbg_show_locals()
        return "locals"
    }
    if trimmed == "a" || trimmed == "all" {
        dbg_show_all_vars()
        return "all"
    }
    if trimmed == "bt" || trimmed == "backtrace" {
        dbg_show_stack_trace()
        return "backtrace"
    }
    if trimmed == "bl" || trimmed == "breakpoints" {
        dbg_list_breakpoints()
        return "breakpoints"
    }
    if trimmed == "watches" {
        dbg_show_watches()
        return "watches"
    }
    // b <N> — set breakpoint
    if trimmed.starts_with("b ") {
        const num_str = trimmed[2..len(trimmed)].trim()
        const line_num = to_int(num_str)
        if line_num > 0 {
            dbg_set_breakpoint(line_num)
        } else {
            println(f"Invalid line number: {num_str}")
        }
        return "breakpoint"
    }
    // d <N> — delete breakpoint
    if trimmed.starts_with("d ") {
        const num_str = trimmed[2..len(trimmed)].trim()
        const line_num = to_int(num_str)
        if line_num > 0 {
            dbg_remove_breakpoint(line_num)
        }
        return "delete"
    }
    // p <name> — print variable
    if trimmed.starts_with("p ") {
        const var_name = trimmed[2..len(trimmed)].trim()
        dbg_inspect_var(var_name)
        return "print"
    }
    // watch <expr> — add watch expression
    if trimmed.starts_with("watch ") {
        const expr = trimmed[6..len(trimmed)].trim()
        dbg_add_watch(expr)
        return "watch"
    }
    // unwatch <N> — remove watch by index
    if trimmed.starts_with("unwatch ") {
        const idx_str = trimmed[8..len(trimmed)].trim()
        dbg_remove_watch(to_int(idx_str))
        return "unwatch"
    }
    // ctx <N> — show context with N lines
    if trimmed.starts_with("ctx ") {
        const n_str = trimmed[4..len(trimmed)].trim()
        const n = to_int(n_str)
        if n > 0 {
            dbg_show_context(dbg_current_line, n)
        }
        return "ctx"
    }

    println("Unknown command: " + trimmed + ". Type h for help.")
    "unknown"
}

func dbg_print_help() {
    println("MAGI Debugger Commands:")
    println("  s/step/n/next     Step one statement")
    println("  c/continue        Continue to next breakpoint")
    println("  q/quit            Quit debugger")
    println("  w/where           Show current location")
    println("  l/locals          Show local variables")
    println("  a/all             Show all variables (all scopes)")
    println("  bt/backtrace      Show stack trace")
    println("  b <N>             Set breakpoint at line N")
    println("  d <N>             Delete breakpoint at line N")
    println("  bl/breakpoints    List all breakpoints")
    println("  p <name>          Print variable value")
    println("  watch <expr>      Add watch expression")
    println("  unwatch <N>       Remove watch by index")
    println("  watches           Show all watch expressions")
    println("  ctx <N>           Show N lines of context")
    println("  h/help            Show this help")
}

// ══════════════════════════════════════════════════════════════════════
// ── Debug Prompt Loop ────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func dbg_prompt() {
    dbg_show_current()
    dbg_show_watches()

    while true {
        print("(dbg) ")
        const line = input()
        if line == null {
            dbg_running = false
            return "quit"
        }
        const action = dbg_process_command(line)
        if action == "step" || action == "continue" || action == "quit" {
            return action
        }
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Statement Classification ─────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func dbg_is_definition(stmt) {
    const sk = stmt.kind
    match sk {
        StmtKind::SFuncDef(_) => true,
        StmtKind::SAsyncFuncDef(_) => true,
        StmtKind::SEnumDef(_, _, _) => true,
        StmtKind::SStructDef(_, _, _) => true,
        StmtKind::SInterfaceDef(_, _, _) => true,
        StmtKind::SImplBlock(_, _) => true,
        StmtKind::SImplTrait(_, _, _) => true,
        StmtKind::SModuleDef(_, _) => true,
        _ => false
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Main Debug Entry Point ───────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func debug_run(source) {
    // Reset state
    dbg_breakpoints = {"__s": true}
    dbg_step_mode = true
    dbg_running = true
    dbg_call_stack = []
    dbg_watch_exprs = []

    // Parse source
    const program = parse(source)
    if program == null {
        println("Parse error — cannot debug.")
        return null
    }

    dbg_source_lines = source.split("\n")

    println("MAGI Debugger")
    println("Type 'h' for help. Stepping through program.")
    println("")

    // Reset interpreter state
    i_scopes = [i_new_scope()]

    // Pass 1: register definitions
    for stmt in program.statements {
        if dbg_is_definition(stmt) {
            eval_stmt(stmt)
        }
    }

    // Pass 2: execute with debug control
    for stmt in program.statements {
        if !dbg_running { break }

        // Skip definitions (already registered)
        if dbg_is_definition(stmt) { continue }

        const line = stmt.span.start_line
        dbg_current_line = line

        // Check if we should break here
        if dbg_step_mode || dbg_has_breakpoint(line) {
            const action = dbg_prompt()
            if action == "quit" { break }
        }

        // Execute the statement
        const result = eval_stmt(stmt)

        // Check for signals
        if is_signal(result) {
            if is_return(result) {
                println(f"Return value: {signal_value(result)}")
            }
        }
    }

    println("Program finished.")
}

// ══════════════════════════════════════════════════════════════════════
// ── Debug a Source File ──────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func debug_source(source) {
    debug_run(source)
}

// ══════════════════════════════════════════════════════════════════════
// ── Conditional Breakpoints (future extension) ──────────────────────
// ══════════════════════════════════════════════════════════════════════

let dbg_conditional_breakpoints = {"__s": true}  // line -> condition_expr_string

func dbg_set_conditional_breakpoint(line, condition) {
    dbg_breakpoints[to_string(line)] = true
    dbg_conditional_breakpoints[to_string(line)] = condition
    println(f"Conditional breakpoint at line {line}: {condition}")
}

func dbg_should_break(line) {
    if !dbg_has_breakpoint(line) { return false }
    const key = to_string(line)
    if dbg_conditional_breakpoints.has(key) {
        const condition = dbg_conditional_breakpoints[key]
        // Try to evaluate the condition as a variable name
        let scope_idx = len(i_scopes) - 1
        while scope_idx >= 0 {
            if i_scopes[scope_idx].has(condition) {
                const val = i_scopes[scope_idx][condition]
                // Truthy check
                if val == false || val == null || val == 0 {
                    return false
                }
                return true
            }
            scope_idx = scope_idx - 1
        }
        return true  // condition not evaluable, break anyway
    }
    true
}

// ══════════════════════════════════════════════════════════════════════
// ── Breakpoint Hit Counts ──────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

let dbg_hit_counts = {"__s": true}         // line -> count of times hit
let dbg_hit_conditions = {"__s": true}     // line -> required hit count before breaking

func dbg_increment_hit_count(line) {
    const key = to_string(line)
    if dbg_hit_counts.has(key) {
        dbg_hit_counts[key] = dbg_hit_counts[key] + 1
    } else {
        dbg_hit_counts[key] = 1
    }
    dbg_hit_counts[key]
}

func dbg_set_hit_condition(line, count) {
    dbg_hit_conditions[to_string(line)] = count
    println(f"Breakpoint at line {line} will trigger after {count} hits")
}

func dbg_get_hit_count(line) {
    const key = to_string(line)
    if dbg_hit_counts.has(key) { dbg_hit_counts[key] } else { 0 }
}

func dbg_should_break_hit(line) {
    const key = to_string(line)
    if !dbg_hit_conditions.has(key) { return true }
    const required = dbg_hit_conditions[key]
    const current = dbg_get_hit_count(line)
    current >= required
}

// ══════════════════════════════════════════════════════════════════════
// ── Function Breakpoints ───────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

let dbg_func_breakpoints = {"__s": true}  // func_name -> true

func dbg_set_func_breakpoint(name) {
    dbg_func_breakpoints[name] = true
    println(f"Breakpoint set on function: {name}")
}

func dbg_remove_func_breakpoint(name) {
    if dbg_func_breakpoints.has(name) {
        dbg_func_breakpoints[name] = false
        println(f"Function breakpoint removed: {name}")
    } else {
        println(f"No breakpoint on function: {name}")
    }
}

func dbg_has_func_breakpoint(name) {
    dbg_func_breakpoints.has(name) && dbg_func_breakpoints[name] == true
}

func dbg_list_func_breakpoints() {
    let bps = []
    for key in keys(dbg_func_breakpoints) {
        if key == "__s" { continue }
        if dbg_func_breakpoints[key] == true {
            bps.push(key)
        }
    }
    if len(bps) == 0 {
        println("No function breakpoints set.")
    } else {
        println("Function breakpoints: " + bps.join(", "))
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Step Into / Step Over / Step Out ───────────────────────────────
// ══════════════════════════════════════════════════════════════════════

let dbg_step_into = false     // step into function calls
let dbg_step_over = false     // step over function calls (same depth)
let dbg_step_out = false      // step out of current function
let dbg_step_depth = 0        // call stack depth at step command
let dbg_current_depth = 0     // current call stack depth

func dbg_enter_call(name, line) {
    dbg_push_frame(name, line)
    dbg_current_depth = dbg_current_depth + 1
    // Check function breakpoints
    if dbg_has_func_breakpoint(name) {
        dbg_step_mode = true
    }
}

func dbg_exit_call() {
    dbg_pop_frame()
    if dbg_current_depth > 0 {
        dbg_current_depth = dbg_current_depth - 1
    }
    // Step out: break when we return to the previous depth
    if dbg_step_out && dbg_current_depth <= dbg_step_depth {
        dbg_step_out = false
        dbg_step_mode = true
    }
}

func dbg_should_stop_at(line) {
    // Always stop in step mode
    if dbg_step_mode { return true }

    // Check line breakpoint with hit count
    if dbg_has_breakpoint(line) {
        dbg_increment_hit_count(line)
        if dbg_should_break_hit(line) {
            if dbg_should_break(line) {
                return true
            }
        }
    }

    // Step over: stop at same or shallower depth
    if dbg_step_over && dbg_current_depth <= dbg_step_depth {
        dbg_step_over = false
        return true
    }

    false
}

// ══════════════════════════════════════════════════════════════════════
// ── Call Stack Navigation ──────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

let dbg_selected_frame = -1  // -1 means top (current), 0..N for specific frame

func dbg_frame_up() {
    if len(dbg_call_stack) == 0 {
        println("Already at top-level.")
        return
    }
    if dbg_selected_frame == -1 {
        dbg_selected_frame = len(dbg_call_stack) - 2
    } else if dbg_selected_frame > 0 {
        dbg_selected_frame = dbg_selected_frame - 1
    } else {
        println("Already at the outermost frame.")
        return
    }
    dbg_show_selected_frame()
}

func dbg_frame_down() {
    if dbg_selected_frame == -1 {
        println("Already at the innermost frame.")
        return
    }
    if dbg_selected_frame < len(dbg_call_stack) - 1 {
        dbg_selected_frame = dbg_selected_frame + 1
    } else {
        dbg_selected_frame = -1
    }
    dbg_show_selected_frame()
}

func dbg_show_selected_frame() {
    const idx = if dbg_selected_frame == -1 {
        len(dbg_call_stack) - 1
    } else {
        dbg_selected_frame
    }
    if idx < 0 || idx >= len(dbg_call_stack) {
        println("  <top-level>")
        return
    }
    const frame = dbg_call_stack[idx]
    const frame_num = len(dbg_call_stack) - idx
    println(f"Frame #{frame_num}: {frame[\"name\"]} at line {frame[\"line\"]}")
    if frame["line"] > 0 {
        dbg_show_context(frame["line"], 2)
    }
}

func dbg_frame_select(n) {
    if n < 0 || n >= len(dbg_call_stack) {
        println(f"Invalid frame number: {n}")
        return
    }
    dbg_selected_frame = n
    dbg_show_selected_frame()
}

// ══════════════════════════════════════════════════════════════════════
// ── Variable Inspection at Selected Frame ──────────────────────────
// ══════════════════════════════════════════════════════════════════════

func dbg_show_frame_locals(frame_idx) {
    if frame_idx < 0 || frame_idx >= len(i_scopes) {
        println("Invalid frame index.")
        return
    }
    const scope = i_scopes[frame_idx]
    let count = 0
    for name in keys(scope) {
        if name == "__s" { continue }
        const val = scope[name]
        println(f"  {name} = {val}")
        count = count + 1
    }
    if count == 0 {
        println("  (no local variables)")
    }
}

func dbg_inspect_at_frame(name, frame_idx) {
    if frame_idx < 0 || frame_idx >= len(i_scopes) {
        println("Invalid frame index.")
        return
    }
    const scope = i_scopes[frame_idx]
    if scope.has(name) {
        const val = scope[name]
        const t = typeof(val)
        println(f"  {name}: {t} = {val}")
    } else {
        println(f"  Variable {name} not found in frame {frame_idx}.")
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Expression Evaluation in Current Scope ─────────────────────────
// ══════════════════════════════════════════════════════════════════════

func dbg_eval_expr(expr_str) {
    // First try simple variable lookup
    let scope_idx = len(i_scopes) - 1
    while scope_idx >= 0 {
        if i_scopes[scope_idx].has(expr_str) {
            const val = i_scopes[scope_idx][expr_str]
            println(f"  = {val}")
            return val
        }
        scope_idx = scope_idx - 1
    }

    // Try parsing as an expression and evaluating
    const wrapped = "const __dbg_result = " + expr_str
    const prog = parse(wrapped)
    if prog == null {
        println(f"  Cannot parse expression: {expr_str}")
        return null
    }

    const result = eval_program(prog)
    if result != null {
        println(f"  = {result}")
    } else {
        // Look up __dbg_result from scope
        let si = len(i_scopes) - 1
        while si >= 0 {
            if i_scopes[si].has("__dbg_result") {
                const val = i_scopes[si]["__dbg_result"]
                println(f"  = {val}")
                return val
            }
            si = si - 1
        }
        println(f"  = null")
    }
    result
}

func dbg_eval_watch_expr(expr_str) {
    // Evaluate without printing, return value as string
    let scope_idx = len(i_scopes) - 1
    while scope_idx >= 0 {
        if i_scopes[scope_idx].has(expr_str) {
            return to_string(i_scopes[scope_idx][expr_str])
        }
        scope_idx = scope_idx - 1
    }

    // Try to parse and evaluate
    const wrapped = "const __dbg_w = " + expr_str
    const prog = parse(wrapped)
    if prog == null { return "<error>" }
    eval_program(prog)
    let si = len(i_scopes) - 1
    while si >= 0 {
        if i_scopes[si].has("__dbg_w") {
            return to_string(i_scopes[si]["__dbg_w"])
        }
        si = si - 1
    }
    "<cannot evaluate>"
}

// ══════════════════════════════════════════════════════════════════════
// ── Enhanced Watch Display ─────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func dbg_show_watches_enhanced() {
    if len(dbg_watch_exprs) == 0 { return }
    println("Watches:")
    let i = 0
    for expr in dbg_watch_exprs {
        const val = dbg_eval_watch_expr(expr)
        println(f"  [{i}] {expr} = {val}")
        i = i + 1
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Stack Trace with Full Frame Info ───────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func dbg_show_full_stack_trace() {
    if len(dbg_call_stack) == 0 {
        println("Stack trace:")
        println("  #0 <top-level> at line " + to_string(dbg_current_line))
        return
    }
    println("Stack trace (most recent first):")
    let i = len(dbg_call_stack) - 1
    while i >= 0 {
        const frame = dbg_call_stack[i]
        const frame_num = len(dbg_call_stack) - i
        const marker = if i == dbg_selected_frame || (dbg_selected_frame == -1 && i == len(dbg_call_stack) - 1) { ">" } else { " " }
        let vars_str = ""
        // Show local variables in this frame if we have scope info
        if i < len(i_scopes) {
            let var_names = []
            for name in keys(i_scopes[i]) {
                if name == "__s" { continue }
                var_names.push(name)
            }
            if len(var_names) > 0 {
                vars_str = " [" + var_names.join(", ") + "]"
            }
        }
        println(f"{marker} #{frame_num} {frame[\"name\"]} at line {frame[\"line\"]}{vars_str}")
        i = i - 1
    }
    println(f"  #0 <top-level> at line {dbg_current_line}")
}

// ══════════════════════════════════════════════════════════════════════
// ── Source Display with Highlighting ───────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func dbg_list_source(start_line, end_line) {
    const total = len(dbg_source_lines)
    let i = max(0, start_line - 1)
    const end_idx = min(total, end_line)
    while i < end_idx {
        const marker = if i + 1 == dbg_current_line { ">>>" } else { "   " }
        const bp_marker = if dbg_has_breakpoint(i + 1) { "*" } else { " " }
        const line_text = if i < total { dbg_source_lines[i] } else { "" }
        const line_num = to_string(i + 1)
        const padded = pad_left(line_num, 4)
        println(marker + bp_marker + padded + " | " + line_text)
        i = i + 1
    }
}

func dbg_list_around(n) {
    const start = max(1, dbg_current_line - n)
    const end_line = min(len(dbg_source_lines), dbg_current_line + n)
    dbg_list_source(start, end_line)
}

func dbg_list_function(name) {
    // Search for function definition in source
    let found = false
    let i = 0
    while i < len(dbg_source_lines) {
        const line_text = dbg_source_lines[i]
        if line_text.contains("func " + name) {
            // Show 20 lines starting from the function
            dbg_list_source(i + 1, min(len(dbg_source_lines), i + 21))
            found = true
            break
        }
        i = i + 1
    }
    if !found {
        println(f"Function '{name}' not found in source.")
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Program State Serialization (Checkpoint/Restore) ───────────────
// ══════════════════════════════════════════════════════════════════════

let dbg_checkpoints = []  // list of serialized states

func dbg_checkpoint() {
    // Serialize current debugger and interpreter state
    let scope_snapshot = []
    for scope in i_scopes {
        let snapshot = {"__s": true}
        for name in keys(scope) {
            if name == "__s" { continue }
            snapshot[name] = scope[name]
        }
        scope_snapshot.push(snapshot)
    }

    let stack_snapshot = []
    for frame in dbg_call_stack {
        stack_snapshot.push({
            "name": frame["name"],
            "line": frame["line"]
        })
    }

    let bp_snapshot = {"__s": true}
    for key in keys(dbg_breakpoints) {
        bp_snapshot[key] = dbg_breakpoints[key]
    }

    let watch_snapshot = []
    for expr in dbg_watch_exprs {
        watch_snapshot.push(expr)
    }

    const state = {
        "scopes": scope_snapshot,
        "call_stack": stack_snapshot,
        "breakpoints": bp_snapshot,
        "watches": watch_snapshot,
        "current_line": dbg_current_line,
        "step_mode": dbg_step_mode,
        "current_depth": dbg_current_depth,
        "hit_counts": dbg_hit_counts
    }
    dbg_checkpoints.push(state)
    println(f"Checkpoint #{len(dbg_checkpoints)} saved at line {dbg_current_line}")
}

func dbg_restore(index) {
    if index < 0 || index >= len(dbg_checkpoints) {
        println(f"Invalid checkpoint index: {index}. Have {len(dbg_checkpoints)} checkpoints.")
        return false
    }
    const state = dbg_checkpoints[index]

    // Restore scopes
    i_scopes = []
    for snapshot in state["scopes"] {
        let scope = i_new_scope()
        for name in keys(snapshot) {
            if name == "__s" { continue }
            scope[name] = snapshot[name]
        }
        i_scopes.push(scope)
    }

    // Restore call stack
    dbg_call_stack = []
    for frame in state["call_stack"] {
        dbg_call_stack.push({"name": frame["name"], "line": frame["line"]})
    }

    // Restore breakpoints
    dbg_breakpoints = {"__s": true}
    for key in keys(state["breakpoints"]) {
        dbg_breakpoints[key] = state["breakpoints"][key]
    }

    // Restore watches
    dbg_watch_exprs = []
    for expr in state["watches"] {
        dbg_watch_exprs.push(expr)
    }

    dbg_current_line = state["current_line"]
    dbg_step_mode = state["step_mode"]
    dbg_current_depth = state["current_depth"]
    dbg_hit_counts = state["hit_counts"]

    println(f"Restored checkpoint #{index + 1} at line {dbg_current_line}")
    true
}

func dbg_list_checkpoints() {
    if len(dbg_checkpoints) == 0 {
        println("No checkpoints saved.")
        return
    }
    println("Checkpoints:")
    let i = 0
    for state in dbg_checkpoints {
        const line = state["current_line"]
        const depth = len(state["call_stack"])
        println(f"  [{i}] line {line}, call depth {depth}")
        i = i + 1
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Info Command (GDB-style) ───────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func dbg_info(what) {
    match what {
        "breakpoints" => {
            dbg_list_breakpoints()
            dbg_list_func_breakpoints()
        },
        "locals" => dbg_show_locals(),
        "args" => {
            // Show arguments of current function
            if len(dbg_call_stack) > 0 {
                const frame = dbg_call_stack[len(dbg_call_stack) - 1]
                println(f"In function: {frame[\"name\"]}")
                dbg_show_locals()
            } else {
                println("Not in a function.")
            }
        },
        "stack" => dbg_show_full_stack_trace(),
        "watches" => dbg_show_watches_enhanced(),
        "checkpoints" => dbg_list_checkpoints(),
        "line" => println(f"Current line: {dbg_current_line}"),
        "frame" => dbg_show_selected_frame(),
        "depth" => println(f"Call depth: {dbg_current_depth}"),
        _ => {
            println("info <what>: breakpoints, locals, args, stack, watches, checkpoints, line, frame, depth")
        }
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Enhanced Command Parser ────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func dbg_process_command_v2(cmd) {
    const trimmed = cmd.trim()
    if trimmed == "" || trimmed == "s" || trimmed == "step" {
        dbg_step_mode = true
        dbg_step_into = true
        dbg_step_over = false
        dbg_step_out = false
        return "step"
    }
    if trimmed == "n" || trimmed == "next" {
        // Step over: execute next line, skipping into function calls
        dbg_step_mode = false
        dbg_step_over = true
        dbg_step_out = false
        dbg_step_depth = dbg_current_depth
        return "step"
    }
    if trimmed == "si" || trimmed == "stepin" {
        dbg_step_mode = true
        dbg_step_into = true
        return "step"
    }
    if trimmed == "finish" || trimmed == "fin" || trimmed == "so" || trimmed == "stepout" {
        // Step out: continue until current function returns
        dbg_step_mode = false
        dbg_step_out = true
        dbg_step_depth = dbg_current_depth - 1
        return "continue"
    }
    if trimmed == "c" || trimmed == "continue" {
        dbg_step_mode = false
        dbg_step_over = false
        dbg_step_out = false
        return "continue"
    }
    if trimmed == "q" || trimmed == "quit" {
        dbg_running = false
        return "quit"
    }
    if trimmed == "h" || trimmed == "help" {
        dbg_print_help_v2()
        return "help"
    }
    if trimmed == "w" || trimmed == "where" {
        dbg_show_current()
        return "where"
    }
    if trimmed == "l" || trimmed == "locals" {
        dbg_show_locals()
        return "locals"
    }
    if trimmed == "a" || trimmed == "all" {
        dbg_show_all_vars()
        return "all"
    }
    if trimmed == "bt" || trimmed == "backtrace" {
        dbg_show_full_stack_trace()
        return "backtrace"
    }
    if trimmed == "bl" || trimmed == "breakpoints" {
        dbg_list_breakpoints()
        return "breakpoints"
    }
    if trimmed == "up" {
        dbg_frame_up()
        return "up"
    }
    if trimmed == "down" {
        dbg_frame_down()
        return "down"
    }
    if trimmed == "checkpoint" || trimmed == "cp" {
        dbg_checkpoint()
        return "checkpoint"
    }
    if trimmed == "watches" {
        dbg_show_watches_enhanced()
        return "watches"
    }

    // b <N> — set breakpoint at line
    if trimmed.starts_with("b ") {
        const rest = trimmed[2..len(trimmed)].trim()
        const line_num = to_int(rest)
        if line_num > 0 {
            dbg_set_breakpoint(line_num)
        } else {
            // Try as function name
            dbg_set_func_breakpoint(rest)
        }
        return "breakpoint"
    }
    // break <N> or break <func_name>
    if trimmed.starts_with("break ") {
        const rest = trimmed[6..len(trimmed)].trim()
        const line_num = to_int(rest)
        if line_num > 0 {
            dbg_set_breakpoint(line_num)
        } else {
            dbg_set_func_breakpoint(rest)
        }
        return "breakpoint"
    }
    // cond <N> <expr> — set conditional breakpoint
    if trimmed.starts_with("cond ") {
        const rest = trimmed[5..len(trimmed)].trim()
        const space_idx = rest.indexOf(" ")
        if space_idx > 0 {
            const line_str = rest[0..space_idx].trim()
            const condition = rest[space_idx + 1..len(rest)].trim()
            const line_num = to_int(line_str)
            if line_num > 0 {
                dbg_set_conditional_breakpoint(line_num, condition)
            }
        }
        return "cond"
    }
    // hit <N> <count> — set hit count condition
    if trimmed.starts_with("hit ") {
        const rest = trimmed[4..len(trimmed)].trim()
        const space_idx = rest.indexOf(" ")
        if space_idx > 0 {
            const line_str = rest[0..space_idx].trim()
            const count_str = rest[space_idx + 1..len(rest)].trim()
            const line_num = to_int(line_str)
            const count = to_int(count_str)
            if line_num > 0 && count > 0 {
                dbg_set_hit_condition(line_num, count)
            }
        }
        return "hit"
    }
    // d <N> — delete breakpoint
    if trimmed.starts_with("d ") {
        const num_str = trimmed[2..len(trimmed)].trim()
        const line_num = to_int(num_str)
        if line_num > 0 {
            dbg_remove_breakpoint(line_num)
        } else {
            dbg_remove_func_breakpoint(num_str)
        }
        return "delete"
    }
    // delete <N> or delete <func_name>
    if trimmed.starts_with("delete ") {
        const rest = trimmed[7..len(trimmed)].trim()
        const line_num = to_int(rest)
        if line_num > 0 {
            dbg_remove_breakpoint(line_num)
        } else {
            dbg_remove_func_breakpoint(rest)
        }
        return "delete"
    }
    // p <expr> — print/evaluate expression
    if trimmed.starts_with("p ") {
        const expr = trimmed[2..len(trimmed)].trim()
        dbg_eval_expr(expr)
        return "print"
    }
    // print <expr>
    if trimmed.starts_with("print ") {
        const expr = trimmed[6..len(trimmed)].trim()
        dbg_eval_expr(expr)
        return "print"
    }
    // eval <expr>
    if trimmed.starts_with("eval ") {
        const expr = trimmed[5..len(trimmed)].trim()
        dbg_eval_expr(expr)
        return "eval"
    }
    // watch <expr>
    if trimmed.starts_with("watch ") {
        const expr = trimmed[6..len(trimmed)].trim()
        dbg_add_watch(expr)
        return "watch"
    }
    // unwatch <N>
    if trimmed.starts_with("unwatch ") {
        const idx_str = trimmed[8..len(trimmed)].trim()
        dbg_remove_watch(to_int(idx_str))
        return "unwatch"
    }
    // list <start> <end> — show source range
    if trimmed.starts_with("list ") {
        const rest = trimmed[5..len(trimmed)].trim()
        const space_idx = rest.indexOf(" ")
        if space_idx > 0 {
            const start_str = rest[0..space_idx].trim()
            const end_str = rest[space_idx + 1..len(rest)].trim()
            dbg_list_source(to_int(start_str), to_int(end_str))
        } else {
            const n = to_int(rest)
            if n > 0 { dbg_list_around(n) }
            else { dbg_list_function(rest) }
        }
        return "list"
    }
    if trimmed == "list" {
        dbg_list_around(5)
        return "list"
    }
    // ctx <N> — show context with N lines
    if trimmed.starts_with("ctx ") {
        const n_str = trimmed[4..len(trimmed)].trim()
        const n = to_int(n_str)
        if n > 0 {
            dbg_show_context(dbg_current_line, n)
        }
        return "ctx"
    }
    // info <what>
    if trimmed.starts_with("info ") {
        const what = trimmed[5..len(trimmed)].trim()
        dbg_info(what)
        return "info"
    }
    if trimmed == "info" {
        dbg_info("")
        return "info"
    }
    // frame <N> — select frame
    if trimmed.starts_with("frame ") {
        const n_str = trimmed[6..len(trimmed)].trim()
        dbg_frame_select(to_int(n_str))
        return "frame"
    }
    // restore <N> — restore checkpoint
    if trimmed.starts_with("restore ") {
        const idx_str = trimmed[8..len(trimmed)].trim()
        dbg_restore(to_int(idx_str))
        return "restore"
    }

    println("Unknown command: " + trimmed + ". Type h for help.")
    "unknown"
}

func dbg_print_help_v2() {
    println("MAGI Debugger Commands:")
    println("")
    println("  Execution:")
    println("    s/step            Step into (one statement, entering calls)")
    println("    n/next            Step over (one statement, skipping calls)")
    println("    si/stepin         Step into function call")
    println("    finish/stepout    Step out of current function")
    println("    c/continue        Continue to next breakpoint")
    println("    q/quit            Quit debugger")
    println("")
    println("  Breakpoints:")
    println("    b <N>             Set breakpoint at line N")
    println("    b <func>          Set breakpoint on function name")
    println("    break <N|func>    Set breakpoint (alias)")
    println("    cond <N> <expr>   Set conditional breakpoint")
    println("    hit <N> <count>   Break after N-th hit at line")
    println("    d <N>             Delete breakpoint at line N")
    println("    d <func>          Delete function breakpoint")
    println("    bl/breakpoints    List all breakpoints")
    println("")
    println("  Inspection:")
    println("    p <expr>          Print expression value")
    println("    print <expr>      Print expression value (alias)")
    println("    eval <expr>       Evaluate expression in current scope")
    println("    l/locals          Show local variables")
    println("    a/all             Show all variables (all scopes)")
    println("    info <what>       Show info (breakpoints, locals, args, stack, watches, checkpoints)")
    println("")
    println("  Navigation:")
    println("    w/where           Show current location")
    println("    bt/backtrace      Show full stack trace")
    println("    up                Move up one stack frame")
    println("    down              Move down one stack frame")
    println("    frame <N>         Select stack frame N")
    println("    list [N|func]     Show source (N lines around current, or function)")
    println("    list <M> <N>      Show source lines M through N")
    println("    ctx <N>           Show N lines of context")
    println("")
    println("  Watches:")
    println("    watch <expr>      Add watch expression")
    println("    unwatch <N>       Remove watch by index")
    println("    watches           Show all watch expressions")
    println("")
    println("  State:")
    println("    checkpoint/cp     Save program state")
    println("    restore <N>       Restore checkpoint N")
    println("    h/help            Show this help")
}

// ══════════════════════════════════════════════════════════════════════
// ── Enhanced Debug Prompt Loop ─────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func dbg_prompt_v2() {
    dbg_show_current()
    dbg_show_watches_enhanced()

    while true {
        const frame_info = if len(dbg_call_stack) > 0 {
            const top = dbg_call_stack[len(dbg_call_stack) - 1]
            top["name"] + ":" + to_string(dbg_current_line)
        } else {
            "<main>:" + to_string(dbg_current_line)
        }
        print(f"(dbg {frame_info}) ")
        const line = input()
        if line == null {
            dbg_running = false
            return "quit"
        }
        const action = dbg_process_command_v2(line)
        if action == "step" || action == "continue" || action == "quit" {
            return action
        }
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Enhanced Debug Entry Point ─────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func debug_run_v2(source) {
    // Reset all state
    dbg_breakpoints = {"__s": true}
    dbg_conditional_breakpoints = {"__s": true}
    dbg_hit_counts = {"__s": true}
    dbg_hit_conditions = {"__s": true}
    dbg_func_breakpoints = {"__s": true}
    dbg_step_mode = true
    dbg_step_into = false
    dbg_step_over = false
    dbg_step_out = false
    dbg_step_depth = 0
    dbg_current_depth = 0
    dbg_running = true
    dbg_call_stack = []
    dbg_watch_exprs = []
    dbg_selected_frame = -1
    dbg_checkpoints = []

    // Parse source
    const program = parse(source)
    if program == null {
        println("Parse error — cannot debug.")
        return null
    }

    dbg_source_lines = source.split("\n")

    println("MAGI Debugger v2")
    println("Type 'h' for help. Stepping through program.")
    println(f"Source: {len(dbg_source_lines)} lines")
    println("")

    // Reset interpreter state
    i_scopes = [i_new_scope()]

    // Pass 1: register definitions
    for stmt in program.statements {
        if dbg_is_definition(stmt) {
            eval_stmt(stmt)
        }
    }

    // Pass 2: execute with debug control
    for stmt in program.statements {
        if !dbg_running { break }
        if dbg_is_definition(stmt) { continue }

        const line = stmt.span.start_line
        dbg_current_line = line

        if dbg_should_stop_at(line) {
            const action = dbg_prompt_v2()
            if action == "quit" { break }
        }

        // Execute the statement
        const result = eval_stmt(stmt)

        // Check for signals
        if is_signal(result) {
            if is_return(result) {
                println(f"Return value: {signal_value(result)}")
            }
        }
    }

    println("Program finished.")
}

// ══════════════════════════════════════════════════════════════════════
// ── REPL Mode ──────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func dbg_repl() {
    println("MAGI Debug REPL")
    println("Type expressions to evaluate, or debugger commands.")
    println("Type 'quit' to exit.")
    println("")

    i_scopes = [i_new_scope()]

    while true {
        print("(dbg-repl) ")
        const line = input()
        if line == null { break }
        const trimmed = line.trim()
        if trimmed == "" { continue }
        if trimmed == "quit" || trimmed == "q" { break }
        if trimmed == "help" || trimmed == "h" {
            dbg_print_help_v2()
            continue
        }

        // Try to evaluate as expression
        const prog = parse(trimmed)
        if prog != null {
            const result = eval_program(prog)
            if result != null {
                println(f"  => {result}")
            }
        } else {
            println("  Parse error.")
        }
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Breakpoint Persistence ─────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func dbg_export_breakpoints() {
    let lines = []
    for key in keys(dbg_breakpoints) {
        if key == "__s" { continue }
        if dbg_breakpoints[key] == true {
            let entry = "b " + key
            if dbg_conditional_breakpoints.has(key) {
                entry = "cond " + key + " " + dbg_conditional_breakpoints[key]
            }
            if dbg_hit_conditions.has(key) {
                entry = entry + "\nhit " + key + " " + to_string(dbg_hit_conditions[key])
            }
            lines.push(entry)
        }
    }
    for key in keys(dbg_func_breakpoints) {
        if key == "__s" { continue }
        if dbg_func_breakpoints[key] == true {
            lines.push("b " + key)
        }
    }
    lines.join("\n")
}

func dbg_import_breakpoints(text) {
    const lines = text.split("\n")
    let count = 0
    for line in lines {
        const trimmed = line.trim()
        if trimmed == "" { continue }
        if trimmed[0] == "#" { continue }
        dbg_process_command_v2(trimmed)
        count = count + 1
    }
    println(f"Imported {count} breakpoint commands.")
}

// ══════════════════════════════════════════════════════════════════════
// ── Variable Type Inspection ───────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func dbg_type_of(name) {
    let scope_idx = len(i_scopes) - 1
    while scope_idx >= 0 {
        const scope = i_scopes[scope_idx]
        if scope.has(name) {
            const val = scope[name]
            const t = typeof(val)
            println(f"  {name}: {t}")
            return t
        }
        scope_idx = scope_idx - 1
    }
    println(f"  Variable {name} not found.")
    null
}

func dbg_show_locals_with_types() {
    if len(i_scopes) == 0 {
        println("No active scope.")
        return
    }
    const current_scope = i_scopes[len(i_scopes) - 1]
    let count = 0
    for name in keys(current_scope) {
        if name == "__s" { continue }
        const val = current_scope[name]
        const t = typeof(val)
        const val_str = to_string(val)
        const display = if len(val_str) > 60 { val_str[0..57] + "..." } else { val_str }
        println(f"  {name}: {t} = {display}")
        count = count + 1
    }
    if count == 0 {
        println("  (no local variables)")
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Memory/Object Inspection ───────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func dbg_inspect_deep(name, max_depth) {
    let scope_idx = len(i_scopes) - 1
    while scope_idx >= 0 {
        if i_scopes[scope_idx].has(name) {
            const val = i_scopes[scope_idx][name]
            dbg_print_value(name, val, 0, max_depth)
            return
        }
        scope_idx = scope_idx - 1
    }
    println(f"  Variable {name} not found.")
}

func dbg_print_value(name, val, depth, max_depth) {
    const indent = "  ".repeat(depth + 1)
    const t = typeof(val)
    if depth >= max_depth {
        println(f"{indent}{name}: {t} = ...")
        return
    }
    if t == "map" {
        println(f"{indent}{name}: map")
        for key in keys(val) {
            if key == "__s" { continue }
            dbg_print_value(key, val[key], depth + 1, max_depth)
        }
    } else if t == "array" {
        println(f"{indent}{name}: array[{len(val)}]")
        let i = 0
        while i < len(val) && i < 10 {
            dbg_print_value(f"[{i}]", val[i], depth + 1, max_depth)
            i = i + 1
        }
        if len(val) > 10 {
            println(f"{indent}  ... ({len(val) - 10} more)")
        }
    } else {
        println(f"{indent}{name}: {t} = {val}")
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Execution Timing ───────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

let dbg_stmt_count = 0
let dbg_start_time = 0

func dbg_reset_stats() {
    dbg_stmt_count = 0
    dbg_start_time = time_now()
}

func dbg_record_stmt() {
    dbg_stmt_count = dbg_stmt_count + 1
}

func dbg_show_stats() {
    const elapsed = time_now() - dbg_start_time
    println(f"Statements executed: {dbg_stmt_count}")
    println(f"Elapsed time: {elapsed}ms")
    if dbg_stmt_count > 0 && elapsed > 0 {
        const rate = dbg_stmt_count * 1000 / elapsed
        println(f"Rate: ~{rate} stmts/sec")
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Memory Inspection ───────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

let dbg_heap_snapshots = []

// Take a snapshot of the current heap state
func dbg_snapshot_heap(scopes) {
    let snapshot = {
        "timestamp": time_now(),
        "scope_count": len(scopes),
        "variables": {},
    }

    let total_vars = 0
    for scope in scopes {
        for key in scope.keys() {
            if key.starts_with("__") { continue }
            snapshot["variables"][key] = {
                "type": typeof(scope[key]),
                "size": dbg_estimate_size(scope[key]),
            }
            total_vars = total_vars + 1
        }
    }
    snapshot["total_variables"] = total_vars
    snapshot["estimated_total_bytes"] = dbg_total_heap_size(snapshot["variables"])

    dbg_heap_snapshots.push(snapshot)
    snapshot
}

// Estimate memory size of a value
func dbg_estimate_size(val) {
    if val == null { return 8 }
    const t = typeof(val)
    match t {
        "int" | "int64" => 8,
        "float" | "float64" => 8,
        "bool" => 1,
        "string" => 24 + len(to_string(val)),
        "array" => {
            let size = 24  // array header
            for item in val {
                size = size + dbg_estimate_size(item) + 8  // 8 for pointer
            }
            size
        },
        "map" => {
            let size = 48  // map header
            for key in val.keys() {
                size = size + dbg_estimate_size(key) + dbg_estimate_size(val[key]) + 16
            }
            size
        },
        "function" | "closure" => 64,
        _ => 16,
    }
}

func dbg_total_heap_size(variables) {
    let total = 0
    for key in variables.keys() {
        total = total + variables[key]["size"]
    }
    total
}

// Display memory usage report
func dbg_memory_report() {
    if len(dbg_heap_snapshots) == 0 {
        println("No heap snapshots taken. Use 'heap' command to take a snapshot.")
        return null
    }
    const latest = dbg_heap_snapshots[len(dbg_heap_snapshots) - 1]
    println(f"=== Memory Report ===")
    println(f"Timestamp: {latest[\"timestamp\"]}")
    println(f"Scopes: {latest[\"scope_count\"]}")
    println(f"Variables: {latest[\"total_variables\"]}")
    println(f"Estimated heap: {format_bytes(latest[\"estimated_total_bytes\"])}")

    // Show top 10 largest variables
    let vars = []
    for key in latest["variables"].keys() {
        vars.push({"name": key, "size": latest["variables"][key]["size"], "type": latest["variables"][key]["type"]})
    }
    vars = sort_by_desc(vars, v => v["size"])

    println(f"\nTop variables by size:")
    let shown = 0
    for v in vars {
        if shown >= 10 { break }
        println(f"  {v[\"name\"]}: {v[\"type\"]} ({format_bytes(v[\"size\"])})")
        shown = shown + 1
    }

    // Show growth if we have multiple snapshots
    if len(dbg_heap_snapshots) > 1 {
        const prev = dbg_heap_snapshots[len(dbg_heap_snapshots) - 2]
        const delta = latest["estimated_total_bytes"] - prev["estimated_total_bytes"]
        const sign = if delta >= 0 { "+" } else { "" }
        println(f"\nHeap delta since last snapshot: {sign}{format_bytes(delta)}")
    }
}

func format_bytes(bytes) {
    if bytes < 1024 { return f"{bytes}B" }
    if bytes < 1024 * 1024 { return f"{bytes / 1024}KB" }
    f"{bytes / (1024 * 1024)}MB"
}

func sort_by_desc(arr, key_fn) {
    let sorted = []
    for item in arr { sorted.push(item) }
    let i = 1
    while i < len(sorted) {
        let j = i
        while j > 0 {
            if key_fn(sorted[j]) > key_fn(sorted[j - 1]) {
                const tmp = sorted[j]
                sorted[j] = sorted[j - 1]
                sorted[j - 1] = tmp
            }
            j = j - 1
        }
        i = i + 1
    }
    sorted
}

// ══════════════════════════════════════════════════════════════════════
// ── Profiler Integration ─────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

let dbg_profile_data = {"__s": true}  // func_name -> {calls, total_time, min_time, max_time}
let dbg_profiling = false
let dbg_profile_stack = []  // stack of {name, start_time}

func dbg_profiler_start() {
    dbg_profiling = true
    dbg_profile_data = {"__s": true}
    println("Profiler started.")
}

func dbg_profiler_stop() {
    dbg_profiling = false
    println("Profiler stopped.")
}

func dbg_profiler_enter(func_name) {
    if !dbg_profiling { return null }
    dbg_profile_stack.push({"name": func_name, "start_time": time_now()})
}

func dbg_profiler_exit(func_name) {
    if !dbg_profiling { return null }
    if len(dbg_profile_stack) == 0 { return null }
    const frame = dbg_profile_stack.pop()
    if frame["name"] != func_name { return null }

    const elapsed = time_now() - frame["start_time"]

    if !dbg_profile_data.has(func_name) {
        dbg_profile_data[func_name] = {"calls": 0, "total_time": 0, "min_time": 999999999, "max_time": 0}
    }
    const entry = dbg_profile_data[func_name]
    entry["calls"] = entry["calls"] + 1
    entry["total_time"] = entry["total_time"] + elapsed
    if elapsed < entry["min_time"] { entry["min_time"] = elapsed }
    if elapsed > entry["max_time"] { entry["max_time"] = elapsed }
    dbg_profile_data[func_name] = entry
}

func dbg_profiler_report() {
    println("=== Profiler Report ===")
    println(f"{'Function':-30} {'Calls':>8} {'Total(ms)':>10} {'Avg(ms)':>10} {'Min(ms)':>10} {'Max(ms)':>10}")
    println("-".repeat(80))

    let entries = []
    for name in dbg_profile_data.keys() {
        if name == "__s" { continue }
        const data = dbg_profile_data[name]
        entries.push({"name": name, "data": data})
    }

    // Sort by total time descending
    entries = sort_by_desc(entries, e => e["data"]["total_time"])

    for entry in entries {
        const d = entry["data"]
        const avg = if d["calls"] > 0 { d["total_time"] / d["calls"] } else { 0 }
        const name_padded = entry["name"]
        println(f"{name_padded:-30} {d[\"calls\"]:>8} {d[\"total_time\"]:>10} {avg:>10} {d[\"min_time\"]:>10} {d[\"max_time\"]:>10}")
    }

    // Summary
    let total_calls = 0
    let total_time = 0
    for entry in entries {
        total_calls = total_calls + entry["data"]["calls"]
        total_time = total_time + entry["data"]["total_time"]
    }
    println(f"\nTotal: {total_calls} calls, {total_time}ms")
}

// ══════════════════════════════════════════════════════════════════════
// ── Thread Debugging ─────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

let dbg_threads = {"__s": true}  // thread_id -> {name, state, stack, created_at}

func dbg_register_thread(thread_id, name) {
    dbg_threads[thread_id] = {
        "name": name,
        "state": "running",
        "stack": [],
        "created_at": time_now(),
        "paused_at": null,
    }
}

func dbg_unregister_thread(thread_id) {
    if dbg_threads.has(thread_id) {
        dbg_threads[thread_id] = null
    }
}

func dbg_thread_push_frame(thread_id, frame_name, line) {
    if !dbg_threads.has(thread_id) { return null }
    const thread = dbg_threads[thread_id]
    if thread == null { return null }
    thread["stack"].push({"name": frame_name, "line": line, "time": time_now()})
}

func dbg_thread_pop_frame(thread_id) {
    if !dbg_threads.has(thread_id) { return null }
    const thread = dbg_threads[thread_id]
    if thread == null { return null }
    if len(thread["stack"]) > 0 { thread["stack"].pop() }
}

func dbg_pause_thread(thread_id) {
    if !dbg_threads.has(thread_id) { return null }
    const thread = dbg_threads[thread_id]
    if thread == null { return null }
    thread["state"] = "paused"
    thread["paused_at"] = time_now()
    println(f"Thread {thread_id} ({thread[\"name\"]}) paused")
}

func dbg_resume_thread(thread_id) {
    if !dbg_threads.has(thread_id) { return null }
    const thread = dbg_threads[thread_id]
    if thread == null { return null }
    thread["state"] = "running"
    thread["paused_at"] = null
    println(f"Thread {thread_id} ({thread[\"name\"]}) resumed")
}

func dbg_list_threads() {
    println("=== Active Threads ===")
    let count = 0
    for tid in dbg_threads.keys() {
        if tid == "__s" { continue }
        const thread = dbg_threads[tid]
        if thread == null { continue }
        const stack_depth = len(thread["stack"])
        const top_frame = if stack_depth > 0 { thread["stack"][stack_depth - 1]["name"] } else { "<idle>" }
        const age = time_now() - thread["created_at"]
        println(f"  [{tid}] {thread[\"name\"]} - {thread[\"state\"]} ({stack_depth} frames, top: {top_frame}, age: {age}ms)")
        count = count + 1
    }
    if count == 0 {
        println("  No active threads.")
    }
}

func dbg_thread_backtrace(thread_id) {
    if !dbg_threads.has(thread_id) {
        println(f"Thread {thread_id} not found")
        return null
    }
    const thread = dbg_threads[thread_id]
    if thread == null {
        println(f"Thread {thread_id} not found")
        return null
    }
    println(f"=== Thread {thread_id} ({thread[\"name\"]}) Backtrace ===")
    let i = len(thread["stack"]) - 1
    let frame_num = 0
    while i >= 0 {
        const frame = thread["stack"][i]
        println(f"  #{frame_num} {frame[\"name\"]} at line {frame[\"line\"]}")
        i = i - 1
        frame_num = frame_num + 1
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Remote Debugging Protocol ────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// DAP-like (Debug Adapter Protocol) message handling
let dbg_remote_connected = false
let dbg_remote_seq = 1

func dbg_remote_start(port) {
    println(f"Debug server starting on port {port}...")
    // Delegate to stage 0 for actual TCP server
    const server = tcp_listen("127.0.0.1", port)
    if server == null {
        println("Failed to start debug server")
        return null
    }
    dbg_remote_connected = true
    println(f"Debug server listening on 127.0.0.1:{port}")
    println("Waiting for debugger to connect...")

    // Main debug loop
    while dbg_remote_connected {
        const conn = tcp_accept(server)
        if conn == null { continue }
        dbg_remote_handle_connection(conn)
    }
}

func dbg_remote_handle_connection(conn) {
    println("Debugger connected")

    // Send initialize response
    dbg_remote_send(conn, "event", "initialized", {})

    while dbg_remote_connected {
        const msg = dbg_remote_receive(conn)
        if msg == null { break }

        const command = msg["command"]
        match command {
            "initialize" => {
                dbg_remote_send(conn, "response", "initialize", {
                    "supportsConfigurationDoneRequest": true,
                    "supportsEvaluateForHovers": true,
                    "supportsStepBack": false,
                    "supportsSetVariable": true,
                    "supportsRestartFrame": false,
                    "supportsBreakpointLocationsRequest": true,
                })
            },
            "configurationDone" => {
                dbg_remote_send(conn, "response", "configurationDone", {})
            },
            "setBreakpoints" => {
                const source = msg["arguments"]["source"]["path"]
                const breakpoints = msg["arguments"]["breakpoints"]
                let verified = []
                for bp in breakpoints {
                    const line = bp["line"]
                    dbg_set_breakpoint(line)
                    verified.push({"verified": true, "line": line})
                }
                dbg_remote_send(conn, "response", "setBreakpoints", {"breakpoints": verified})
            },
            "threads" => {
                let thread_list = [{"id": 1, "name": "main"}]
                for tid in dbg_threads.keys() {
                    if tid == "__s" { continue }
                    const thread = dbg_threads[tid]
                    if thread != null {
                        thread_list.push({"id": parse_int(tid), "name": thread["name"]})
                    }
                }
                dbg_remote_send(conn, "response", "threads", {"threads": thread_list})
            },
            "stackTrace" => {
                let frames = []
                let frame_id = 0
                for entry in dbg_call_stack {
                    frames.push({
                        "id": frame_id,
                        "name": entry["name"],
                        "line": entry["line"],
                        "column": 0,
                        "source": {"name": "program.magi"},
                    })
                    frame_id = frame_id + 1
                }
                dbg_remote_send(conn, "response", "stackTrace", {"stackFrames": frames, "totalFrames": len(frames)})
            },
            "scopes" => {
                dbg_remote_send(conn, "response", "scopes", {
                    "scopes": [
                        {"name": "Local", "variablesReference": 1, "expensive": false},
                        {"name": "Global", "variablesReference": 2, "expensive": false},
                    ]
                })
            },
            "continue" => {
                dbg_step_mode = false
                dbg_remote_send(conn, "response", "continue", {"allThreadsContinued": true})
            },
            "next" => {
                dbg_step_mode = true
                dbg_remote_send(conn, "response", "next", {})
            },
            "stepIn" => {
                dbg_step_mode = true
                dbg_remote_send(conn, "response", "stepIn", {})
            },
            "stepOut" => {
                dbg_step_mode = true
                dbg_remote_send(conn, "response", "stepOut", {})
            },
            "evaluate" => {
                const expression = msg["arguments"]["expression"]
                const result = eval_source(expression)
                dbg_remote_send(conn, "response", "evaluate", {"result": to_string(result), "variablesReference": 0})
            },
            "disconnect" => {
                dbg_remote_send(conn, "response", "disconnect", {})
                dbg_remote_connected = false
            },
            _ => {
                dbg_remote_send(conn, "response", command, {})
            },
        }
    }

    println("Debugger disconnected")
}

func dbg_remote_send(conn, msg_type, command, body) {
    const msg = {
        "seq": dbg_remote_seq,
        "type": msg_type,
        "command": command,
        "body": body,
        "success": true,
    }
    dbg_remote_seq = dbg_remote_seq + 1
    const json_str = to_json(msg)
    const header = f"Content-Length: {len(json_str)}\r\n\r\n"
    tcp_write(conn, header + json_str)
}

func dbg_remote_receive(conn) {
    // Read Content-Length header
    const header = tcp_read_line(conn)
    if header == null { return null }
    // Parse content length
    if !header.starts_with("Content-Length:") { return null }
    const len_str = header[15..len(header)].trim()
    const content_length = parse_int(len_str)
    if content_length == null || content_length <= 0 { return null }
    // Skip empty line
    tcp_read_line(conn)
    // Read body
    const body = tcp_read(conn, content_length)
    if body == null { return null }
    json_parse(body)
}

// ══════════════════════════════════════════════════════════════════════
// ── Extended Debugger Commands ───────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Conditional breakpoint
let dbg_conditional_bps = {"__s": true}  // line -> expression_string

func dbg_set_conditional_breakpoint(line, condition) {
    dbg_set_breakpoint(line)
    dbg_conditional_bps[to_string(line)] = condition
    println(f"Conditional breakpoint set at line {line}: {condition}")
}

func dbg_check_conditional_bp(line, eval_fn) {
    const key = to_string(line)
    if !dbg_conditional_bps.has(key) { return true }
    const condition = dbg_conditional_bps[key]
    const result = eval_fn(condition)
    result == true
}

// Hit count breakpoint
let dbg_hit_counts = {"__s": true}  // line -> {target, current}

func dbg_set_hit_count_breakpoint(line, count) {
    dbg_set_breakpoint(line)
    dbg_hit_counts[to_string(line)] = {"target": count, "current": 0}
    println(f"Hit count breakpoint set at line {line}: break after {count} hits")
}

func dbg_check_hit_count_bp(line) {
    const key = to_string(line)
    if !dbg_hit_counts.has(key) { return true }
    const entry = dbg_hit_counts[key]
    entry["current"] = entry["current"] + 1
    dbg_hit_counts[key] = entry
    entry["current"] >= entry["target"]
}

// Log point (non-breaking breakpoint that logs a message)
let dbg_log_points = {"__s": true}  // line -> format_string

func dbg_set_log_point(line, format_str) {
    dbg_set_breakpoint(line)
    dbg_log_points[to_string(line)] = format_str
    println(f"Log point set at line {line}: {format_str}")
}

func dbg_check_log_point(line) {
    const key = to_string(line)
    dbg_log_points.has(key)
}

func dbg_format_log_point(line, eval_fn) {
    const key = to_string(line)
    if !dbg_log_points.has(key) { return null }
    const format_str = dbg_log_points[key]
    // Simple interpolation: replace {expr} with evaluated result
    let result = format_str
    let i = 0
    while i < len(result) {
        if result[i] == "{" {
            const end = result[i..len(result)].index_of("}")
            if end > 0 {
                const expr = result[i + 1..i + end]
                const val = eval_fn(expr)
                const val_str = to_string(val)
                result = result[0..i] + val_str + result[i + end + 1..len(result)]
                i = i + len(val_str)
                continue
            }
        }
        i = i + 1
    }
    result
}
