    const src = "try { risky() } catch e { handle(e) }"
    const prog = parse(src)
    assert(len(prog.statements) == 1)
    assert(desc_sk(prog.statements[0]) == "try-catch")
    println("PASS: parse try-catch")
}

func test_parse_attribute() {
