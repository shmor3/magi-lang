func test_parse_multi_statement() {
    const src = "const x = 1\nconst y = 2\nconst z = x + y"
    const prog = parse(src)
    assert(len(prog.statements) == 3)
    println("PASS: parse multi statement")
}

func test_parse_realistic_function() {
    const src = "func max(a, b) { if a > b { a } else { b } }"
    const prog = parse(src)
    assert(len(prog.statements) == 1)
    assert(desc_sk(prog.statements[0]) == "func")
    println("PASS: parse realistic function")
}

