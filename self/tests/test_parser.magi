// Tests for self/parser.magi
// Run: cat self/types.magi self/lexer.magi self/ast.magi self/parser.magi self/tests/test_parser.magi > /tmp/_parser_test.magi && cargo run --bin magi -- run /tmp/_parser_test.magi

// ── Helpers ───────────────────────────────────────────────────────

func desc_ek(e) {
    const k = e.kind
    k.describe()
}

func desc_sk(s) {
    const k = s.kind
    k.describe()
}

// ── Basic Statement Tests ─────────────────────────────────────────

func test_parse_const() {
    const prog = parse("const x = 42")
    assert(len(prog.statements) == 1)
    assert(desc_sk(prog.statements[0]) == "const x")
    println("PASS: parse const")
}

func test_parse_let() {
    const prog = parse("let y = 10")
    assert(len(prog.statements) == 1)
    println("PASS: parse let")
}

func test_parse_const_string() {
    const prog = parse("const name = \"hello\"")
    assert(len(prog.statements) == 1)
    assert(desc_sk(prog.statements[0]) == "const name")
    println("PASS: parse const string")
}

func test_parse_const_bool() {
    const prog = parse("const flag = true")
    assert(len(prog.statements) == 1)
    println("PASS: parse const bool")
}

func test_parse_const_null() {
    const prog = parse("const n = null")
    assert(len(prog.statements) == 1)
    println("PASS: parse const null")
}

// ── Expression Tests ──────────────────────────────────────────────

func test_parse_binary_add() {
    const prog = parse("const r = 1 + 2")
    assert(len(prog.statements) == 1)
    println("PASS: parse binary add")
}

func test_parse_binary_precedence() {
    // 1 + 2 * 3 should parse as 1 + (2 * 3)
    const prog = parse("const r = 1 + 2 * 3")
    assert(len(prog.statements) == 1)
    println("PASS: parse binary precedence")
}

func test_parse_comparison() {
    const prog = parse("const r = x == 42")
    assert(len(prog.statements) == 1)
    println("PASS: parse comparison")
}

func test_parse_logical() {
    const prog = parse("const r = a && b || c")
    assert(len(prog.statements) == 1)
    println("PASS: parse logical")
}

func test_parse_unary_neg() {
    const prog = parse("const r = -5")
    assert(len(prog.statements) == 1)
    println("PASS: parse unary neg")
}

func test_parse_unary_not() {
    const prog = parse("const r = !flag")
    assert(len(prog.statements) == 1)
    println("PASS: parse unary not")
}

// ── Function Tests ────────────────────────────────────────────────

func test_parse_function() {
    const prog = parse("func add(a, b) { a + b }")
    assert(len(prog.statements) == 1)
    assert(desc_sk(prog.statements[0]) == "func")
    println("PASS: parse function")
}

func test_parse_function_no_params() {
    const prog = parse("func greet() { 42 }")
    assert(len(prog.statements) == 1)
    println("PASS: parse function no params")
}

func test_parse_method() {
    const prog = parse("func Foo.bar(self) { self.x }")
    assert(len(prog.statements) == 1)
    println("PASS: parse method")
}

// ── Control Flow Tests ────────────────────────────────────────────

func test_parse_if_else() {
    const prog = parse("const x = if true { 1 } else { 2 }")
    assert(len(prog.statements) == 1)
    println("PASS: parse if-else")
}

func test_parse_if_no_else() {
    const prog = parse("if x > 0 { println(x) }")
    assert(len(prog.statements) == 1)
    println("PASS: parse if no else")
}

func test_parse_while() {
    const prog = parse("while x > 0 { x = x - 1 }")
    assert(len(prog.statements) == 1)
    println("PASS: parse while")
}

func test_parse_for_loop() {
    const prog = parse("for i in 0..10 { println(i) }")
    assert(len(prog.statements) == 1)
    println("PASS: parse for loop")
}

func test_parse_return() {
    const prog = parse("return 42")
    assert(len(prog.statements) == 1)
    println("PASS: parse return")
}

func test_parse_break_continue() {
    const prog = parse("break")
    assert(len(prog.statements) == 1)
    const prog2 = parse("continue")
    assert(len(prog2.statements) == 1)
    println("PASS: parse break/continue")
}

// ── Match Tests ───────────────────────────────────────────────────

func test_parse_match() {
    const src = "match x { 1 => \"one\", 2 => \"two\", _ => \"other\" }"
    const prog = parse(src)
    assert(len(prog.statements) == 1)
    println("PASS: parse match")
}

func test_parse_match_enum() {
    const src = "match val { Color::Red => 1, Color::Blue => 2, _ => 0 }"
    const prog = parse(src)
    assert(len(prog.statements) == 1)
    println("PASS: parse match enum")
}

