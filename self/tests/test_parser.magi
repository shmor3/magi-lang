    assert(len(prog.statements) == 1)
    println("PASS: parse for destructure")
}

func test_parse_do_while() {
    const src = "do { x = x + 1 } while x < 10"
    const prog = parse(src)
    assert(len(prog.statements) == 1)
    assert(desc_sk(prog.statements[0]) == "do-while")
    println("PASS: parse do-while")
}

