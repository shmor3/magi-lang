// ── LSP: Word at Position ────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func test_word_at_position() {
    const source = "let hello = 42"
    const w = word_at_position(source, 0, 5)
    assert(w != null)
    assert(w["word"] == "hello")
    assert(w["start"] == 4)
    assert(w["end"] == 9)
    println("PASS: word_at_position")
}

func test_word_at_position_boundary() {
    const source = "a b c"
    const w = word_at_position(source, 0, 0)
    assert(w != null)
    assert(w["word"] == "a")
    println("PASS: word_at_position boundary")
}

