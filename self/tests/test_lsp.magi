// ══════════════════════════════════════════════════════════════════════
// ── LSP: JSON Encode/Decode ──────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func test_json_encode() {
    assert(json_encode(null) == "null")
    assert(json_encode(42) == "42")
    assert(json_encode(true) == "true")
    assert(json_encode(false) == "false")
    assert(json_encode("hello") == "\"hello\"")
    assert(json_encode([1, 2, 3]) == "[1, 2, 3]")
    println("PASS: json_encode")
}

func test_json_parse() {
    assert(json_parse("null") == null)
    assert(json_parse("42") == 42)
    assert(json_parse("true") == true)
    assert(json_parse("false") == false)
    assert(json_parse("\"hello\"") == "hello")
    println("PASS: json_parse")
}

// ══════════════════════════════════════════════════════════════════════
// ── LSP: Folding Ranges ─────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func test_folding_ranges() {
    const uri = "file:///fold.magi"
    lsp_cache_document(uri, "// Header\n// More header\nfunc foo() \{\n    let x = 1\n    let y = 2\n\}")

    const params = { "textDocument": {"uri": uri} }
    const result = handle_folding_range(params)
    // Should find at least the comment block
    assert(result != null)
    assert(len(result) >= 1)
    println("PASS: folding ranges")
}

