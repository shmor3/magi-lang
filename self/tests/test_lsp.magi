// ══════════════════════════════════════════════════════════════════════
// ── Registry: Semver ─────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func test_semver_parse() {
    const v = semver_parse("1.2.3")
    assert(v["major"] == 1)
    assert(v["minor"] == 2)
    assert(v["patch"] == 3)
    assert(v["pre"] == "")
    println("PASS: semver parse")
}

func test_semver_parse_prerelease() {
    const v = semver_parse("1.0.0-beta")
    assert(v["major"] == 1)
    assert(v["minor"] == 0)
    assert(v["patch"] == 0)
    assert(v["pre"] == "beta")
    println("PASS: semver parse prerelease")
}

func test_semver_compare() {
    const a = semver_parse("1.2.3")
    const b = semver_parse("1.2.4")
    assert(semver_compare(a, b) < 0)
    assert(semver_compare(b, a) > 0)
    assert(semver_compare(a, a) == 0)
    println("PASS: semver compare")
}

func test_semver_satisfies() {
    const v = semver_parse("1.5.0")
    assert(semver_satisfies(v, ">=1.0.0") == true)
    assert(semver_satisfies(v, "<2.0.0") == true)
    assert(semver_satisfies(v, ">=2.0.0") == false)
    assert(semver_satisfies(v, "*") == true)
    assert(semver_satisfies(v, "") == true)
    println("PASS: semver satisfies")
}

func test_semver_caret() {
    const v = semver_parse("1.5.3")
    assert(semver_satisfies(v, "^1.0.0") == true)
    assert(semver_satisfies(v, "^1.5.0") == true)
    assert(semver_satisfies(v, "^2.0.0") == false)
    println("PASS: semver caret")
}

func test_semver_tilde() {
    const v = semver_parse("1.2.5")
    assert(semver_satisfies(v, "~1.2.0") == true)
    assert(semver_satisfies(v, "~1.3.0") == false)
    println("PASS: semver tilde")
}

// ══════════════════════════════════════════════════════════════════════
// ── Registry: TOML Parsing ───────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func test_toml_parse() {
    const text = "[package]\nname = \"my-app\"\nversion = \"1.0.0\"\n\n[dependencies]\nhttp = \">=1.0.0\"\njson = \"^2.0.0\""
    const config = toml_parse(text)
    assert(config.has("package"))
    assert(config["package"]["name"] == "my-app")
    assert(config["package"]["version"] == "1.0.0")
    assert(config.has("dependencies"))
    assert(config["dependencies"]["http"] == ">=1.0.0")
    assert(config["dependencies"]["json"] == "^2.0.0")
    println("PASS: TOML parse")
}

func test_parse_magispace() {
    const text = "[package]\nname = \"my-app\"\nversion = \"1.0.0\"\ndescription = \"My app\"\n\n[dependencies]\nhttp = \">=1.0.0\""
    const config = parse_magispace(text)
    assert(config["name"] == "my-app")
    assert(config["version"] == "1.0.0")
    assert(config["description"] == "My app")
    assert(len(config["dependencies"]) == 1)
    assert(config["dependencies"][0]["name"] == "http")
    assert(config["dependencies"][0]["constraint"] == ">=1.0.0")
    println("PASS: parse magispace")
}

// ══════════════════════════════════════════════════════════════════════
// ── Registry: Lock File ──────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func test_lockfile_generate() {
    const deps = [
        {"name": "http", "version": "1.2.0"},
        {"name": "json", "version": "2.1.0"}
    ]
    const lock = generate_lockfile(deps)
    assert(lock.contains("http"))
    assert(lock.contains("1.2.0"))
    assert(lock.contains("json"))
    assert(lock.contains("2.1.0"))
    println("PASS: lockfile generate")
}

func test_lockfile_roundtrip() {
    const deps = [
        {"name": "http", "version": "1.2.0"},
        {"name": "json", "version": "2.1.0"}
    ]
    const lock = generate_lockfile(deps)
    const parsed = parse_lockfile(lock)
    assert(len(parsed) == 2)
    assert(parsed[0]["name"] == "http")
    assert(parsed[0]["version"] == "1.2.0")
    assert(parsed[1]["name"] == "json")
    assert(parsed[1]["version"] == "2.1.0")
    println("PASS: lockfile roundtrip")
}

// ══════════════════════════════════════════════════════════════════════
// ── Registry: MVS ────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func test_mvs() {
    const requirements = [
        {"name": "http", "constraint": ">=1.0.0"},
        {"name": "json", "constraint": "^2.0.0"}
    ]
    const available = {
        "__s": true,
        "http": ["0.9.0", "1.0.0", "1.1.0", "1.2.0"],
        "json": ["1.0.0", "2.0.0", "2.1.0", "3.0.0"]
    }
    const resolved = resolve_mvs(requirements, available)
    assert(len(resolved) == 2)

    // MVS should pick minimum satisfying versions
    let http_ver = ""
    let json_ver = ""
    for dep in resolved {
        if dep["name"] == "http" { http_ver = dep["version"] }
        if dep["name"] == "json" { json_ver = dep["version"] }
    }
    assert(http_ver == "1.0.0")  // minimum >= 1.0.0
    assert(json_ver == "2.0.0")  // minimum ^2.0.0
    println("PASS: MVS resolution")
}

// ══════════════════════════════════════════════════════════════════════
// ── Debugger: Breakpoints ────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func test_debugger_breakpoints() {
    // Reset
    dbg_breakpoints = {"__s": true}

    dbg_set_breakpoint(10)
    assert(dbg_has_breakpoint(10) == true)
    assert(dbg_has_breakpoint(5) == false)

    dbg_remove_breakpoint(10)
    assert(dbg_has_breakpoint(10) == false)
    println("PASS: debugger breakpoints")
}

func test_debugger_command_parsing() {
    dbg_step_mode = false
    dbg_running = true

    const r1 = dbg_process_command("s")
    assert(r1 == "step")
    assert(dbg_step_mode == true)

    dbg_step_mode = true
    const r2 = dbg_process_command("c")
    assert(r2 == "continue")
    assert(dbg_step_mode == false)

    const r3 = dbg_process_command("q")
    assert(r3 == "quit")
    assert(dbg_running == false)

    // Reset
    dbg_running = true
    dbg_step_mode = true
    println("PASS: debugger command parsing")
}

func test_debugger_is_definition() {
    const source = "func hello() { 1 }\nlet x = 42"
    const program = parse(source)
    assert(dbg_is_definition(program.statements[0]) == true)
    assert(dbg_is_definition(program.statements[1]) == false)
    println("PASS: debugger is_definition")
}

