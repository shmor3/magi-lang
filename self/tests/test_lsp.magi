// Tests for self/lsp.magi, self/mcp.magi, self/debugger.magi, self/registry.magi
// Run: cat self/types.magi self/lexer.magi self/ast.magi self/parser.magi self/type_checker.magi self/optimizer.magi self/linter.magi self/formatter.magi self/interpreter.magi self/cli.magi self/lsp.magi self/mcp.magi self/debugger.magi self/registry.magi self/tests/test_lsp.magi > /tmp/_lsp_test.magi && RUST_MIN_STACK=33554432 cargo run --bin magi -- run /tmp/_lsp_test.magi

// ══════════════════════════════════════════════════════════════════════
// ── LSP: Document Symbol Extraction ──────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func test_collect_symbols() {
    const source = "func hello() { println(\"hi\") }\nlet x = 42\nconst Y = true"
    const program = parse(source)
    const symbols = collect_symbols(program)
    assert(len(symbols) == 3)
    assert(symbols[0]["name"] == "hello")
    assert(symbols[0]["kind"] == SK_FUNCTION)
    assert(symbols[1]["name"] == "x")
    assert(symbols[1]["kind"] == SK_VARIABLE)
    assert(symbols[2]["name"] == "Y")
    assert(symbols[2]["kind"] == SK_CONSTANT)
    println("PASS: collect_symbols")
}

func test_collect_symbols_empty() {
    const program = parse("")
    const symbols = collect_symbols(program)
    assert(len(symbols) == 0)
    println("PASS: collect_symbols empty")
}

func test_collect_symbols_enum_struct() {
    const source = "enum Color { Red, Green, Blue }\nstruct Point { x, y }"
    const program = parse(source)
    const symbols = collect_symbols(program)
    assert(len(symbols) == 2)
    assert(symbols[0]["name"] == "Color")
    assert(symbols[0]["kind"] == SK_ENUM)
    assert(symbols[1]["name"] == "Point")
    assert(symbols[1]["kind"] == SK_STRUCT)
    println("PASS: collect_symbols enum/struct")
}

// ══════════════════════════════════════════════════════════════════════
// ── LSP: Find Definition ─────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func test_find_definition() {
    const source = "func greet(name) { println(name) }\nlet x = 10"
    const program = parse(source)
    const def = find_definition(program, "greet")
    assert(def != null)
    assert(def["name"] == "greet")
    assert(def["kind"] == "function")
    assert(def["line"] == 0)
    println("PASS: find_definition function")
}

func test_find_definition_variable() {
    const source = "let x = 42\nlet y = x + 1"
    const program = parse(source)
    const def = find_definition(program, "x")
    assert(def != null)
    assert(def["name"] == "x")
    assert(def["kind"] == "variable")
    println("PASS: find_definition variable")
}

func test_find_definition_not_found() {
    const source = "let x = 42"
    const program = parse(source)
    const def = find_definition(program, "nonexistent")
    assert(def == null)
    println("PASS: find_definition not found")
}

// ══════════════════════════════════════════════════════════════════════
// ── LSP: Find References ─────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func test_find_references() {
    const source = "let x = 1\nlet y = x + 2\nlet z = x * 3"
    const program = parse(source)
    const refs = find_references(program, "x")
    // definition + 2 references
    assert(len(refs) >= 3)
    println("PASS: find_references")
}

// ══════════════════════════════════════════════════════════════════════
// ── LSP: Completion Items ────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func test_completion() {
    const uri = "file:///test.magi"
    lsp_cache_document(uri, "func hello() { 1 }\nlet world = 42\n")

    const params = {
        "textDocument": {"uri": uri},
        "position": {"line": 1, "character": 0}
    }
    const result = handle_completion(params)
    assert(result != null)
    assert(result.has("items"))
    const items = result["items"]
    // Should have keywords + builtins + document symbols
    assert(len(items) > 10)

    // Check that document symbols are in the list
    let has_hello = false
    let has_world = false
    for item in items {
        if item["label"] == "hello" { has_hello = true }
        if item["label"] == "world" { has_world = true }
    }
    assert(has_hello)
    assert(has_world)
    println("PASS: completion items")
}

func test_completion_with_prefix() {
    const uri = "file:///test2.magi"
    lsp_cache_document(uri, "func hello_world() { 1 }\nfunc hello_magi() { 2 }\nfunc greet() { 3 }\n")

    const params = {
        "textDocument": {"uri": uri},
        "position": {"line": 2, "character": 5}  // "hello" prefix
    }
    const result = handle_completion(params)
    assert(result != null)
    println("PASS: completion with prefix")
}

// ══════════════════════════════════════════════════════════════════════
// ── LSP: Hover Info ──────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func test_hover_keyword() {
    const uri = "file:///hover.magi"
    lsp_cache_document(uri, "func test() { return 42 }")

    const params = {
        "textDocument": {"uri": uri},
        "position": {"line": 0, "character": 1}  // "func" keyword
    }
    const result = handle_hover(params)
    assert(result != null)
    assert(result.has("contents"))
    assert(result["contents"]["value"].contains("keyword"))
    println("PASS: hover keyword")
}

func test_hover_builtin() {
    const uri = "file:///hover2.magi"
    lsp_cache_document(uri, "println(42)")

    const params = {
        "textDocument": {"uri": uri},
        "position": {"line": 0, "character": 3}  // "println"
    }
    const result = handle_hover(params)
    assert(result != null)
    assert(result["contents"]["value"].contains("builtin"))
    println("PASS: hover builtin")
}

// ══════════════════════════════════════════════════════════════════════
// ── LSP: Document Symbol ─────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func test_document_symbol() {
    const uri = "file:///sym.magi"
    lsp_cache_document(uri, "func a() { 1 }\nfunc b() { 2 }\nconst C = 3")

    const params = { "textDocument": {"uri": uri} }
    const result = handle_document_symbol(params)
    assert(result != null)
    assert(len(result) == 3)
    assert(result[0]["name"] == "a")
    assert(result[1]["name"] == "b")
    assert(result[2]["name"] == "C")
    println("PASS: document symbol")
}

// ══════════════════════════════════════════════════════════════════════
// ── LSP: Initialize ──────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func test_initialize() {
    const result = handle_initialize({"rootUri": "file:///workspace"})
    assert(result.has("capabilities"))
    assert(result.has("serverInfo"))
    assert(result["serverInfo"]["name"] == "magi-lsp-self")
    assert(result["capabilities"]["hoverProvider"] == true)
    assert(result["capabilities"]["definitionProvider"] == true)
    assert(result["capabilities"]["completionProvider"] != null)
    println("PASS: initialize")
}

// ══════════════════════════════════════════════════════════════════════
// ── LSP: Dispatch ────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func test_dispatch() {
    const result = lsp_dispatch("initialize", {"rootUri": null})
    assert(result != null)
    assert(result.has("capabilities"))

    const shutdown_result = lsp_dispatch("shutdown", null)
    assert(shutdown_result == null)  // shutdown returns null

    const unknown = lsp_dispatch("unknown/method", null)
    assert(unknown == null)
    println("PASS: dispatch")
}

