// MAGI Self-Hosted Compiler — Recursive Descent Parser
//
// Takes tokens from tokenize() and produces an AST (Program).
// Uses Pratt parsing (precedence climbing) for expressions.
//
// Parser state is module-level mutable variables because MAGI
// uses value semantics — struct methods cannot mutate the caller.

// ── Parser State (module-level mutable) ───────────────────────────

let p_tokens = []
let p_pos = 0

// ── Token helpers ─────────────────────────────────────────────────

func p_peek() {
    if p_pos < len(p_tokens) {
        p_tokens[p_pos]
    } else {
        Token { kind: TokenKind::Eof, text: "", line: 0, col: 0 }
    }
}

func p_peek_kind() {
    p_peek().kind
}

func p_at(kind) {
    p_peek_kind() == kind
}

func p_at_eof() {
    p_at(TokenKind::Eof)
}

func p_advance() {
    const tok = p_peek()
    p_pos = p_pos + 1
    tok
}

func p_expect(kind) {
    const tok = p_peek()
    if tok.kind != kind {
        panic(f"parse error: expected {kind}, got '{tok.text}' at {tok.line}:{tok.col}")
    }
    p_pos = p_pos + 1
    tok
}

func p_expect_ident() {
    const tok = p_expect(TokenKind::Ident)
    tok.text
}

func p_current_span() {
    const tok = p_peek()
    span_new(tok.line, tok.col)
}

func p_skip_semis() {
    while p_at(TokenKind::Semicolon) {
        p_advance()
    }
}

// ── Entry Point ───────────────────────────────────────────────────

func parse(source) {
    // Save and restore state for re-entrant parsing (f-strings)
    const save_tokens = p_tokens
    const save_pos = p_pos

    p_tokens = tokenize(source)
    p_pos = 0
    const result = parse_program()

    p_tokens = save_tokens
    p_pos = save_pos
    result
}

func parse_program() {
    const span = p_current_span()
    let stmts = []
    while !p_at_eof() {
        p_skip_semis()
        if p_at_eof() { break }
        const s = parse_statement()
        stmts.push(s)
        p_skip_semis()
    }
    program_new(stmts, span)
}

// ── Statement Parsing ─────────────────────────────────────────────

func parse_statement() {
    const kind = p_peek_kind()

    if kind == TokenKind::Hash { return parse_attribute_stmt() }
    if kind == TokenKind::Const { return parse_const_stmt() }
    if kind == TokenKind::Let { return parse_let_stmt() }
    if kind == TokenKind::Func { return parse_func_stmt() }
    if kind == TokenKind::Async { return parse_async_func_stmt() }
    if kind == TokenKind::Struct { return parse_struct_stmt() }
    if kind == TokenKind::Enum { return parse_enum_stmt() }
    if kind == TokenKind::Interface { return parse_interface_stmt() }
    if kind == TokenKind::Impl { return parse_impl_stmt() }
    if kind == TokenKind::Type { return parse_type_alias_stmt() }
    if kind == TokenKind::If { return parse_if_stmt() }
    if kind == TokenKind::For { return parse_for_stmt() }
    if kind == TokenKind::While { return parse_while_stmt() }
    if kind == TokenKind::Do { return parse_do_while_stmt() }
    if kind == TokenKind::Loop { return parse_loop_stmt() }
    if kind == TokenKind::Match { return parse_match_stmt() }
    if kind == TokenKind::Select { return parse_select_stmt() }
    if kind == TokenKind::Return { return parse_return_stmt() }
    if kind == TokenKind::Break { return parse_break_stmt() }
    if kind == TokenKind::Continue { return parse_continue_stmt() }
    if kind == TokenKind::Import { return parse_import_stmt() }
    if kind == TokenKind::Defer { return parse_defer_stmt() }
    if kind == TokenKind::Throw { return parse_throw_stmt() }
    if kind == TokenKind::Try { return parse_try_catch_stmt() }
    if kind == TokenKind::Test { return parse_test_stmt() }
    if kind == TokenKind::Label { return parse_labeled_stmt() }

    // Expression statement (including assignments)
    parse_expr_or_assign_stmt()
}

// ── const name = expr ─────────────────────────────────────────────

func parse_const_stmt() {
    const span = p_current_span()
    p_expect(TokenKind::Const)

    // Destructuring: const [a, b] = expr
    if p_at(TokenKind::LBracket) {
        const pat = parse_destructure_array()
        p_expect(TokenKind::Eq)
        const value = parse_expression(0)
        return stmt_new(StmtKind::SLetDestructure(pat, false, value), span)
    }
    // Destructuring: const {x, y} = expr
    if p_at(TokenKind::LBrace) {
        const pat = parse_destructure_map()
        p_expect(TokenKind::Eq)
        const value = parse_expression(0)
        return stmt_new(StmtKind::SLetDestructure(pat, false, value), span)
    }
    // Destructuring: const (a, b) = expr
    if p_at(TokenKind::LParen) {
        const pat = parse_destructure_tuple_paren()
        p_expect(TokenKind::Eq)
        const value = parse_expression(0)
        return stmt_new(StmtKind::SLetDestructure(pat, false, value), span)
    }

    const name = p_expect_ident()

    // Bare tuple destructuring: const a, b = expr
    if p_at(TokenKind::Comma) {
        let elems = [DestructureElement::DName(name)]
        while p_at(TokenKind::Comma) {
            p_advance()
            const n = p_expect_ident()
            elems.push(DestructureElement::DName(n))
        }
        p_expect(TokenKind::Eq)
        const value = parse_expression(0)
        return stmt_new(StmtKind::SLetDestructure(DestructurePattern::DTuple(elems), false, value), span)
    }

    // Optional type annotation
    if p_at(TokenKind::Colon) {
        p_advance()
        parse_type_annotation()
    }

    p_expect(TokenKind::Eq)
    const value = parse_expression(0)
    make_const(name, value, span)
}

// ── let name = expr ───────────────────────────────────────────────

func parse_let_stmt() {
    const span = p_current_span()
    p_expect(TokenKind::Let)

    // Destructuring: let [a, b] = expr
    if p_at(TokenKind::LBracket) {
        const pat = parse_destructure_array()
        p_expect(TokenKind::Eq)
        const value = parse_expression(0)
        return stmt_new(StmtKind::SLetDestructure(pat, true, value), span)
    }
    // Destructuring: let {x, y} = expr
    if p_at(TokenKind::LBrace) {
        const pat = parse_destructure_map()
        p_expect(TokenKind::Eq)
        const value = parse_expression(0)
        return stmt_new(StmtKind::SLetDestructure(pat, true, value), span)
    }
    // Destructuring: let (a, b) = expr
    if p_at(TokenKind::LParen) {
        const pat = parse_destructure_tuple_paren()
        p_expect(TokenKind::Eq)
        const value = parse_expression(0)
        return stmt_new(StmtKind::SLetDestructure(pat, true, value), span)
    }

    const name = p_expect_ident()

    // Bare tuple destructuring: let a, b = expr
    if p_at(TokenKind::Comma) {
        let elems = [DestructureElement::DName(name)]
        while p_at(TokenKind::Comma) {
            p_advance()
            const n = p_expect_ident()
            elems.push(DestructureElement::DName(n))
        }
        p_expect(TokenKind::Eq)
        const value = parse_expression(0)
        return stmt_new(StmtKind::SLetDestructure(DestructurePattern::DTuple(elems), true, value), span)
    }

    // Optional type annotation
    if p_at(TokenKind::Colon) {
        p_advance()
        parse_type_annotation()
    }

    p_expect(TokenKind::Eq)
    const value = parse_expression(0)
    stmt_new(StmtKind::SLetMut(name, value), span)
}

// ── Destructure Helpers ──────────────────────────────────────────

func parse_destructure_array() {
    p_expect(TokenKind::LBracket)
    let elems = []
    while !p_at(TokenKind::RBracket) && !p_at_eof() {
        if p_at(TokenKind::DotDotDot) {
            p_advance()
            const rest_name = p_expect_ident()
            elems.push(DestructureElement::DRest(rest_name))
        } else {
            const n = p_expect_ident()
            elems.push(DestructureElement::DName(n))
        }
        if p_at(TokenKind::Comma) { p_advance() }
    }
    p_expect(TokenKind::RBracket)
    DestructurePattern::DArray(elems)
}

func parse_destructure_map() {
    p_expect(TokenKind::LBrace)
    let elems = []
    while !p_at(TokenKind::RBrace) && !p_at_eof() {
        const n = p_expect_ident()
        elems.push(DestructureElement::DName(n))
        if p_at(TokenKind::Comma) { p_advance() }
    }
    p_expect(TokenKind::RBrace)
    DestructurePattern::DMap(elems)
}

func parse_destructure_tuple_paren() {
    p_expect(TokenKind::LParen)
    let elems = []
    while !p_at(TokenKind::RParen) && !p_at_eof() {
        const n = p_expect_ident()
        elems.push(DestructureElement::DName(n))
        if p_at(TokenKind::Comma) { p_advance() }
    }
    p_expect(TokenKind::RParen)
    DestructurePattern::DTuple(elems)
}

// ── func name(params) { body } ────────────────────────────────────

func parse_func_stmt() {
    const span = p_current_span()
    p_expect(TokenKind::Func)
    let name = p_expect_ident()

    // Check for Type.method syntax
    if p_at(TokenKind::Dot) {
        const type_name = name
        p_advance()
        const method_name = p_expect_ident()
        name = f"{type_name}.{method_name}"
    }

    // Generic type parameters: func max<T: Compare>(...)
    let type_params = []
    if p_at(TokenKind::Lt) {
        p_advance()
        while !p_at(TokenKind::Gt) && !p_at_eof() {
            const tp_name = p_expect_ident()
            // Optional bound: T: Bound
            if p_at(TokenKind::Colon) {
                p_advance()
                parse_type_annotation()
            }
            type_params.push(tp_name)
            if p_at(TokenKind::Comma) { p_advance() }
        }
        p_expect(TokenKind::Gt)
    }

    const params = parse_func_params()
    const body = parse_block()
    let fdef = funcdef_new(name, params, body, span)
    fdef.type_params = type_params
    stmt_new(StmtKind::SFuncDef(fdef), span)
}

func parse_func_params() {
    p_expect(TokenKind::LParen)
    let params = []
    while !p_at(TokenKind::RParen) && !p_at_eof() {
        const pspan = p_current_span()
        let is_rest = false
        if p_at(TokenKind::DotDotDot) {
            p_advance()
            is_rest = true
        }
        const pname = p_expect_ident()
        let type_ann = ""
        if p_at(TokenKind::Colon) {
            p_advance()
            type_ann = parse_type_annotation()
        }
        let default_val = null
        if p_at(TokenKind::Eq) {
            p_advance()
            default_val = parse_expression(0)
        }
        let fp = param_new(pname, pspan)
        fp.type_ann = type_ann
        fp.default_val = default_val
        fp.rest = is_rest
        params.push(fp)
        if p_at(TokenKind::Comma) { p_advance() }
    }
    p_expect(TokenKind::RParen)

    // Optional return type annotation
    if p_at(TokenKind::Arrow) {
        p_advance()
        parse_type_annotation()
    }

    params
}

func parse_type_annotation() {
    // Simple type: ident (or keyword used as type name)
    const tok = p_peek()
    let name = tok.text
    p_advance()
    if p_at(TokenKind::Lt) {
        // Generic: Type<Param>
        p_advance()
        let depth = 1
        while depth > 0 && !p_at_eof() {
            if p_at(TokenKind::Lt) { depth = depth + 1 }
            if p_at(TokenKind::Gt) { depth = depth - 1 }
            if depth > 0 { p_advance() }
        }
        p_expect(TokenKind::Gt)
    }
    name
}

// ── struct Name { fields } ────────────────────────────────────────

func parse_struct_stmt() {
    const span = p_current_span()
    p_expect(TokenKind::Struct)
    const name = p_expect_ident()
    p_expect(TokenKind::LBrace)
    let fields = []
    while !p_at(TokenKind::RBrace) && !p_at_eof() {
        const fspan = p_current_span()
        const fname = p_expect_ident()
        p_expect(TokenKind::Colon)
        const ftype = parse_type_annotation()
        let fdefault = null
        if p_at(TokenKind::Eq) {
            p_advance()
            fdefault = parse_expression(0)
        }
        fields.push(StructFieldDef { name: fname, type_ann: ftype, default_val: fdefault, span: fspan })
        if p_at(TokenKind::Comma) { p_advance() }
    }
    p_expect(TokenKind::RBrace)
    stmt_new(StmtKind::SStructDef(name, fields, []), span)
}

// ── enum Name { variants } ────────────────────────────────────────

func parse_enum_stmt() {
    const span = p_current_span()
    p_expect(TokenKind::Enum)
    const name = p_expect_ident()
    p_expect(TokenKind::LBrace)
    let variants = []
    while !p_at(TokenKind::RBrace) && !p_at_eof() {
        const vspan = p_current_span()
        const vname = p_expect_ident()
        let vfields = []
        if p_at(TokenKind::LParen) {
            p_advance()
            while !p_at(TokenKind::RParen) && !p_at_eof() {
                const ft = p_peek().text
                p_advance()
                vfields.push(ft)
                if p_at(TokenKind::Comma) { p_advance() }
            }
            p_expect(TokenKind::RParen)
        }
        // Iota value: Variant = 0
        if p_at(TokenKind::Eq) {
            p_advance()
            // Skip the value expression (used for iota)
            parse_expression(0)
        }
        variants.push(EnumVariantDef { name: vname, fields: vfields, span: vspan })
        if p_at(TokenKind::Comma) { p_advance() }
    }
    p_expect(TokenKind::RBrace)
    stmt_new(StmtKind::SEnumDef(name, variants, []), span)
}

// ── interface Name { methods } ────────────────────────────────────

func parse_interface_stmt() {
    const span = p_current_span()
    p_expect(TokenKind::Interface)
    const name = p_expect_ident()
    p_expect(TokenKind::LBrace)
    let methods = []
    while !p_at(TokenKind::RBrace) && !p_at_eof() {
        p_expect(TokenKind::Func)
        const mname = p_expect_ident()
        const mparams = parse_func_params()
        const mspan = p_current_span()
        const mbody = block_empty(mspan)
        methods.push(funcdef_new(mname, mparams, mbody, mspan))
        p_skip_semis()
    }
    p_expect(TokenKind::RBrace)
    stmt_new(StmtKind::SInterfaceDef(name, [], methods), span)
}

// ── if cond { } else { } ─────────────────────────────────────────

func parse_if_stmt() {
    const span = p_current_span()
    const expr = parse_if_expr()
    match expr.kind {
        ExprKind::EIfElse(cond, then_b, else_b) => {
            stmt_new(StmtKind::SIf(cond, then_b, else_b), span)
        },
        _ => make_expr_stmt(expr, span),
    }
}

// ── for pattern in expr { body } ──────────────────────────────────

func parse_for_stmt_with_label(label) {
    const span = p_current_span()
    p_expect(TokenKind::For)

    // Array destructuring: for [k, v] in ...
    if p_at(TokenKind::LBracket) {
        p_advance()
        let elems = []
        while !p_at(TokenKind::RBracket) && !p_at_eof() {
            if p_at(TokenKind::DotDotDot) {
                p_advance()
                const rest_name = p_expect_ident()
                elems.push(DestructureElement::DRest(rest_name))
            } else {
                const n = p_expect_ident()
                elems.push(DestructureElement::DName(n))
            }
            if p_at(TokenKind::Comma) { p_advance() }
        }
        p_expect(TokenKind::RBracket)
        p_expect(TokenKind::In)
        const iter_expr = parse_expression(0)
        const body = parse_block()
        return stmt_new(StmtKind::SForLoop(label, ForPattern::ArrayDestructure(elems), iter_expr, body), span)
    }

    const var_name = p_expect_ident()
    p_expect(TokenKind::In)
    const iter_expr = parse_expression(0)
    const body = parse_block()
    stmt_new(StmtKind::SForLoop(label, ForPattern::Single(var_name), iter_expr, body), span)
}

func parse_for_stmt() {
    parse_for_stmt_with_label("")
}

// ── while cond { body } ──────────────────────────────────────────

func parse_while_stmt_with_label(label) {
    const span = p_current_span()
    p_expect(TokenKind::While)
    const cond = parse_expression(0)
    const body = parse_block()
    stmt_new(StmtKind::SWhileLoop(label, cond, body), span)
}

func parse_while_stmt() {
    parse_while_stmt_with_label("")
}

// ── match expr { arms } ──────────────────────────────────────────

func parse_match_stmt() {
    const span = p_current_span()
    const expr = parse_match_expr()
    match expr.kind {
        ExprKind::EMatch(subject, arms) => {
            stmt_new(StmtKind::SMatch(subject, arms), span)
        },
        _ => make_expr_stmt(expr, span),
    }
}

// ── return expr ──────────────────────────────────────────────────

func parse_return_stmt() {
    const span = p_current_span()
    p_expect(TokenKind::Return)
    let value = null
    if !p_at(TokenKind::RBrace) && !p_at(TokenKind::Semicolon) && !p_at_eof() {
        const first = parse_expression(0)
        // Multi-return: return a, b => TupleLiteral
        if p_at(TokenKind::Comma) {
            let exprs = [first]
            while p_at(TokenKind::Comma) {
                p_advance()
                exprs.push(parse_expression(0))
            }
            value = expr_new(ExprKind::ETupleLiteral(exprs), span)
        } else {
            value = first
        }
    }
    make_return(value, span)
}

// ── break / continue ─────────────────────────────────────────────

func parse_break_stmt() {
    const span = p_current_span()
    p_expect(TokenKind::Break)
    let label = ""
    if p_at(TokenKind::Label) {
        label = p_advance().text
    }
    let value = null
    if !p_at(TokenKind::RBrace) && !p_at(TokenKind::Semicolon) && !p_at_eof() {
        value = parse_expression(0)
    }
    stmt_new(StmtKind::SBreak(label, value), span)
}

func parse_continue_stmt() {
    const span = p_current_span()
    p_expect(TokenKind::Continue)
    let label = ""
    if p_at(TokenKind::Label) {
        label = p_advance().text
    }
    stmt_new(StmtKind::SContinue(label), span)
}

// ── import std.module ────────────────────────────────────────────

func parse_import_stmt() {
    const span = p_current_span()
    p_expect(TokenKind::Import)

    // String literal import: import "plugin-id"
    if p_at(TokenKind::StringLit) {
        const tok = p_advance()
        return stmt_new(StmtKind::SImport(tok.text), span)
    }

    let path_parts = [p_expect_ident()]
    let multi = []

    while p_at(TokenKind::Dot) {
        p_advance()
        // Multi-import: import std.{fs, json}
        if p_at(TokenKind::LBrace) {
            p_advance()
            while !p_at(TokenKind::RBrace) && !p_at_eof() {
                multi.push(p_expect_ident())
                if p_at(TokenKind::Comma) { p_advance() }
            }
            p_expect(TokenKind::RBrace)
            break
        }
        path_parts.push(p_expect_ident())
    }

    // Alias: import std.math as m
    let alias = ""
    if p_at(TokenKind::As) {
        p_advance()
        alias = p_expect_ident()
    }

    if len(multi) > 0 || len(alias) > 0 {
        stmt_new(StmtKind::SImportModule(path_parts, alias, multi), span)
    } else {
        const path = path_parts.join(".")
        stmt_new(StmtKind::SImport(path), span)
    }
}

// ── async func name(params) { body } ─────────────────────────────

func parse_async_func_stmt() {
    const span = p_current_span()
    p_expect(TokenKind::Async)
    p_expect(TokenKind::Func)
    const name = p_expect_ident()
    const params = parse_func_params()
    const body = parse_block()
    const fdef = funcdef_new(name, params, body, span)
    stmt_new(StmtKind::SAsyncFuncDef(fdef), span)
}

// ── impl Type { methods } ────────────────────────────────────────

func parse_impl_stmt() {
    const span = p_current_span()
    p_expect(TokenKind::Impl)
    const type_name = p_expect_ident()

    // impl Trait for Type { ... }
    if p_at(TokenKind::For) {
        p_advance()
        const target_type = p_expect_ident()
        p_expect(TokenKind::LBrace)
        let methods = []
        while !p_at(TokenKind::RBrace) && !p_at_eof() {
            p_skip_semis()
            if p_at(TokenKind::RBrace) { break }
            const m = parse_statement()
            methods.push(m)
            p_skip_semis()
        }
        p_expect(TokenKind::RBrace)
        return stmt_new(StmtKind::SImplTrait(type_name, target_type, methods), span)
    }

    p_expect(TokenKind::LBrace)
    let methods = []
    while !p_at(TokenKind::RBrace) && !p_at_eof() {
        p_skip_semis()
        if p_at(TokenKind::RBrace) { break }
        const m = parse_statement()
        methods.push(m)
        p_skip_semis()
    }
    p_expect(TokenKind::RBrace)
    stmt_new(StmtKind::SImplBlock(type_name, methods), span)
}

// ── type Name = TargetType ───────────────────────────────────────

func parse_type_alias_stmt() {
    const span = p_current_span()
    p_expect(TokenKind::Type)
    const name = p_expect_ident()
    p_expect(TokenKind::Eq)
    const target = parse_type_annotation()
    stmt_new(StmtKind::STypeAlias(name, target), span)
}

// ── do { body } while cond ───────────────────────────────────────

func parse_do_while_stmt() {
    const span = p_current_span()
    p_expect(TokenKind::Do)
    const body = parse_block()
    p_expect(TokenKind::While)
    const cond = parse_expression(0)
    stmt_new(StmtKind::SDoWhile("", cond, body), span)
}

// ── loop { body } ────────────────────────────────────────────────

func parse_loop_stmt() {
    const span = p_current_span()
    p_expect(TokenKind::Loop)
    const body = parse_block()
    const loop_expr = expr_new(ExprKind::ELoop(body), span)
    make_expr_stmt(loop_expr, span)
}

// ── select { arms } ─────────────────────────────────────────────

func parse_select_stmt() {
    const span = p_current_span()
    p_expect(TokenKind::Select)
    p_expect(TokenKind::LBrace)
    let arms = []
    while !p_at(TokenKind::RBrace) && !p_at_eof() {
        const arm = parse_match_arm()
        arms.push(arm)
        if p_at(TokenKind::Comma) { p_advance() }
        p_skip_semis()
    }
    p_expect(TokenKind::RBrace)
    // Represent select as a match with null subject
    const subject = make_null_lit(span)
    stmt_new(StmtKind::SMatch(subject, arms), span)
}

// ── defer expr ───────────────────────────────────────────────────

func parse_defer_stmt() {
    const span = p_current_span()
    p_expect(TokenKind::Defer)
    let expr = null
    if p_at(TokenKind::LBrace) {
        const blk = parse_block()
        expr = expr_new(ExprKind::EBlock(blk), span)
    } else {
        expr = parse_expression(0)
    }
    stmt_new(StmtKind::SDefer(expr), span)
}

// ── throw expr ───────────────────────────────────────────────────

func parse_throw_stmt() {
    const span = p_current_span()
    p_expect(TokenKind::Throw)
    const expr = parse_expression(0)
    stmt_new(StmtKind::SThrow(expr), span)
}

// ── try { body } catch e { handler } ─────────────────────────────

func parse_try_catch_stmt() {
    const span = p_current_span()
    p_expect(TokenKind::Try)
    const try_block = parse_block()
    const try_expr = expr_new(ExprKind::EBlock(try_block), span)

    let catch_var = "_"
    let catch_body = null
    let finally_body = null

    if p_at(TokenKind::Ident) && p_peek().text == "catch" {
        p_advance()
        if p_at(TokenKind::Ident) {
            catch_var = p_advance().text
        }
        const cb = parse_block()
        catch_body = expr_new(ExprKind::EBlock(cb), span)
    }

    if p_at(TokenKind::Ident) && p_peek().text == "finally" {
        p_advance()
        const fb = parse_block()
        finally_body = expr_new(ExprKind::EBlock(fb), span)
    }

    stmt_new(StmtKind::STryCatch(try_expr, catch_var, catch_body, finally_body), span)
}

// ── test "name" { body } ─────────────────────────────────────────

func parse_test_stmt() {
    const span = p_current_span()
    p_expect(TokenKind::Test)
    const name = p_expect(TokenKind::StringLit).text
    const body = parse_block()
    stmt_new(StmtKind::STestDef(name, body), span)
}

// ── 'label: for/while/loop ──────────────────────────────────────

func parse_labeled_stmt() {
    const span = p_current_span()
    const label_tok = p_advance()
    const label = label_tok.text
    p_expect(TokenKind::Colon)
    const kind = p_peek_kind()
    if kind == TokenKind::For {
        return parse_for_stmt_with_label(label)
    }
    if kind == TokenKind::While {
        return parse_while_stmt_with_label(label)
    }
    if kind == TokenKind::Loop {
        p_expect(TokenKind::Loop)
        const body = parse_block()
        const loop_expr = expr_new(ExprKind::ELoop(body), span)
        return make_expr_stmt(loop_expr, span)
    }
    if kind == TokenKind::Do {
        p_expect(TokenKind::Do)
        const body = parse_block()
        p_expect(TokenKind::While)
        const cond = parse_expression(0)
        return stmt_new(StmtKind::SDoWhile(label, cond, body), span)
    }
    panic(f"expected 'for', 'while', 'loop', or 'do' after label at {label_tok.line}:{label_tok.col}")
}

// ── #[attr] def ─────────────────────────────────────────────────

func parse_attribute_stmt() {
    const span = p_current_span()
    p_expect(TokenKind::Hash)
    p_expect(TokenKind::LBracket)
    const attr_name = p_expect_ident()
    // Optional args: #[deprecated("msg")] or #[cfg(condition)]
    if p_at(TokenKind::LParen) {
        p_advance()
        let depth = 1
        while depth > 0 && !p_at_eof() {
            if p_at(TokenKind::LParen) { depth = depth + 1 }
            if p_at(TokenKind::RParen) { depth = depth - 1 }
            if depth > 0 { p_advance() }
        }
        p_expect(TokenKind::RParen)
    }
    p_expect(TokenKind::RBracket)
    // Parse the definition that follows the attribute
    parse_statement()
}

// ── Expression statement or assignment ───────────────────────────

func parse_expr_or_assign_stmt() {
    const span = p_current_span()
    const expr = parse_expression(0)

    // Check for assignment: name = expr
    if p_at(TokenKind::Eq) {
        p_advance()
        const value = parse_expression(0)
        match expr.kind {
            ExprKind::EVariable(name) => {
                return stmt_new(StmtKind::SAssignment(name, value), span)
            },
            ExprKind::EFieldAccess(obj, field) => {
                return stmt_new(StmtKind::SFieldAssign(obj, field, value), span)
            },
            ExprKind::EIndex(obj, idx) => {
                return stmt_new(StmtKind::SIndexAssign(obj, idx, value), span)
            },
            _ => {
                panic(f"invalid assignment target at {span.start_line}:{span.start_col}")
            },
        }
    }

    // Compound assignments: += -= *= /= %=
    if p_at(TokenKind::PlusEq) {
        p_advance()
        const value = parse_expression(0)
        match expr.kind {
            ExprKind::EVariable(name) => {
                return stmt_new(StmtKind::SCompoundAssign(name, BinOp::Add, value), span)
            },
            _ => panic("invalid compound assignment target"),
        }
    }
    if p_at(TokenKind::MinusEq) {
        p_advance()
        const value = parse_expression(0)
        match expr.kind {
            ExprKind::EVariable(name) => {
                return stmt_new(StmtKind::SCompoundAssign(name, BinOp::Sub, value), span)
            },
            _ => panic("invalid compound assignment target"),
        }
    }
    if p_at(TokenKind::StarEq) {
        p_advance()
        const value = parse_expression(0)
        match expr.kind {
            ExprKind::EVariable(name) => {
                return stmt_new(StmtKind::SCompoundAssign(name, BinOp::Mul, value), span)
            },
            _ => panic("invalid compound assignment target"),
        }
    }
    if p_at(TokenKind::SlashEq) {
        p_advance()
        const value = parse_expression(0)
        match expr.kind {
            ExprKind::EVariable(name) => {
                return stmt_new(StmtKind::SCompoundAssign(name, BinOp::Div, value), span)
            },
            _ => panic("invalid compound assignment target"),
        }
    }
    if p_at(TokenKind::PercentEq) {
        p_advance()
        const value = parse_expression(0)
        match expr.kind {
            ExprKind::EVariable(name) => {
                return stmt_new(StmtKind::SCompoundAssign(name, BinOp::Mod, value), span)
            },
            _ => panic("invalid compound assignment target"),
        }
    }

    make_expr_stmt(expr, span)
}

// ── Block Parsing ─────────────────────────────────────────────────

func parse_block() {
    const span = p_current_span()
    p_expect(TokenKind::LBrace)
    let stmts = []
    let tail_expr = null

    while !p_at(TokenKind::RBrace) && !p_at_eof() {
        p_skip_semis()
        if p_at(TokenKind::RBrace) { break }

        const s = parse_statement()
        stmts.push(s)
        p_skip_semis()
    }

    // Check if last statement is an expression that can be a tail expr
    if len(stmts) > 0 {
        const last = stmts[len(stmts) - 1]
        match last.kind {
            StmtKind::SExprStmt(e) => {
                tail_expr = e
                stmts = stmts.slice(0, len(stmts) - 1)
            },
            _ => {},
        }
    }

    p_expect(TokenKind::RBrace)
    block_new(stmts, tail_expr, span)
}

// ── Expression Parsing (Pratt / Precedence Climbing) ──────────────

func parse_expression(min_prec) {
    let left = parse_unary()

    while true {
        const op = token_to_binop(p_peek_kind())
        if op == null { break }

        const prec = op.precedence()
        if prec < min_prec { break }

        p_advance()
        const span = left.span
        const right = parse_expression(prec + 1)
        left = make_binop(op, left, right, span)
    }

    // Pipe operator |>
    while p_at(TokenKind::Pipe) {
        p_advance()
        const span = left.span
        const right = parse_unary()
        left = expr_new(ExprKind::EPipe(left, right), span)
    }

    // Range operator ..
    if p_at(TokenKind::DotDot) {
        p_advance()
        const span = left.span
        const end_expr = parse_expression(0)
        left = expr_new(ExprKind::ERange(left, end_expr, false), span)
    }
    if p_at(TokenKind::DotDotEq) {
        p_advance()
        const span = left.span
        const end_expr = parse_expression(0)
        left = expr_new(ExprKind::ERange(left, end_expr, true), span)
    }

    // Null coalescing ??
    if p_at(TokenKind::QuestionQuestion) {
        p_advance()
        const span = left.span
        const right = parse_expression(0)
        left = expr_new(ExprKind::ENullCoalesce(left, right), span)
    }

    left
}

func token_to_binop(kind) {
    if kind == TokenKind::PipePipe { return BinOp::Or }
    if kind == TokenKind::AndAnd { return BinOp::And }
    if kind == TokenKind::EqEq { return BinOp::Eq }
    if kind == TokenKind::NotEq { return BinOp::NotEq }
    if kind == TokenKind::Lt { return BinOp::Lt }
    if kind == TokenKind::Gt { return BinOp::Gt }
    if kind == TokenKind::LtEq { return BinOp::LtEq }
    if kind == TokenKind::GtEq { return BinOp::GtEq }
    if kind == TokenKind::Plus { return BinOp::Add }
    if kind == TokenKind::Minus { return BinOp::Sub }
    if kind == TokenKind::Star { return BinOp::Mul }
    if kind == TokenKind::Slash { return BinOp::Div }
    if kind == TokenKind::Percent { return BinOp::Mod }
    if kind == TokenKind::Amp { return BinOp::BitAnd }
    if kind == TokenKind::Caret { return BinOp::BitXor }
    if kind == TokenKind::Bar { return BinOp::BitOr }
    if kind == TokenKind::Shl { return BinOp::Shl }
    if kind == TokenKind::Shr { return BinOp::Shr }
    null
}

// ── Unary Expressions ─────────────────────────────────────────────

func parse_unary() {
    const span = p_current_span()

    if p_at(TokenKind::Minus) {
        p_advance()
        const operand = parse_unary()
        return make_unaryop(UnOp::Neg, operand, span)
    }

    if p_at(TokenKind::Bang) {
        p_advance()
        const operand = parse_unary()
        return make_unaryop(UnOp::Not, operand, span)
    }

    // await expr
    if p_at(TokenKind::Await) {
        p_advance()
        const operand = parse_unary()
        return expr_new(ExprKind::EAwait(operand), span)
    }

    // spawn expr / spawn { block }
    if p_at(TokenKind::Spawn) {
        p_advance()
        let operand = null
        if p_at(TokenKind::LBrace) {
            const blk = parse_block()
            operand = expr_new(ExprKind::EBlock(blk), span)
        } else {
            operand = parse_unary()
        }
        return expr_new(ExprKind::ESpawn(operand), span)
    }

    // yield expr
    if p_at(TokenKind::Yield) {
        p_advance()
        const operand = parse_unary()
        return expr_new(ExprKind::EYield(operand), span)
    }

    parse_postfix()
}

// ── Postfix: calls, field access, indexing ─────────────────────────

func parse_postfix() {
    let expr = parse_primary()

    while true {
        if p_at(TokenKind::LParen) {
            // Function call or method call
            const span = expr.span
            match expr.kind {
                ExprKind::EVariable(name) => {
                    const args = parse_call_args()
                    expr = make_call(name, args, span)
                },
                ExprKind::EFieldAccess(obj, method) => {
                    const args = parse_call_args()
                    expr = make_method_call(obj, method, args, span)
                },
                _ => {
                    const args = parse_call_args()
                    expr = expr_new(ExprKind::ECall("__call", [expr] + args, []), span)
                },
            }
        } else if p_at(TokenKind::Dot) {
            p_advance()
            const span = expr.span
            const field = p_expect_ident()
            expr = make_field_access(expr, field, span)
        } else if p_at(TokenKind::LBracket) {
            p_advance()
            const span = expr.span
            const idx = parse_expression(0)
            p_expect(TokenKind::RBracket)
            expr = make_index(expr, idx, span)
        } else if p_at(TokenKind::QuestionDot) {
            p_advance()
            const span = expr.span
            const field = p_expect_ident()
            expr = expr_new(ExprKind::EOptionalChain(expr, field), span)
        } else if p_at(TokenKind::ColonColon) {
            // Enum::Variant or Enum::Variant(args)
            p_advance()
            const span = expr.span
            match expr.kind {
                ExprKind::EVariable(enum_name) => {
                    const variant = p_expect_ident()
                    let args = []
                    if p_at(TokenKind::LParen) {
                        args = parse_call_args()
                    }
                    expr = expr_new(ExprKind::EEnumConstruct(enum_name, variant, args), span)
                },
                _ => {
                    panic("expected enum name before ::")
                },
            }
        } else if p_at(TokenKind::Question) {
            // Try-propagate: expr?
            p_advance()
            const span = expr.span
            expr = expr_new(ExprKind::ETryPropagate(expr), span)
        } else {
            break
        }
    }

    expr
}

func parse_call_args() {
    p_expect(TokenKind::LParen)
    let args = []
    while !p_at(TokenKind::RParen) && !p_at_eof() {
        const arg = parse_expression(0)
        args.push(arg)
        if p_at(TokenKind::Comma) { p_advance() }
    }
    p_expect(TokenKind::RParen)
    args
}

// ── Primary Expressions ───────────────────────────────────────────

func parse_primary() {
    const tok = p_peek()
    const span = p_current_span()
    const kind = tok.kind

    // Integer literal
    if kind == TokenKind::IntLit {
        p_advance()
        return make_int_lit(parse_int(tok.text), span)
    }

    // Float literal
    if kind == TokenKind::FloatLit {
        p_advance()
        return make_float_lit(parse_float(tok.text), span)
    }

    // String literal
    if kind == TokenKind::StringLit {
        p_advance()
        return make_str_lit(tok.text, span)
    }

    // F-string interpolation
    if kind == TokenKind::FStringStart {
        return parse_fstring()
    }

    // Boolean literals
    if kind == TokenKind::True {
        p_advance()
        return make_bool_lit(true, span)
    }
    if kind == TokenKind::False {
        p_advance()
        return make_bool_lit(false, span)
    }

    // Null literal
    if kind == TokenKind::Null {
        p_advance()
        return make_null_lit(span)
    }

    // If expression
    if kind == TokenKind::If {
        return parse_if_expr()
    }

    // Match expression
    if kind == TokenKind::Match {
        return parse_match_expr()
    }

    // Loop expression
    if kind == TokenKind::Loop {
        p_advance()
        const body = parse_block()
        return expr_new(ExprKind::ELoop(body), span)
    }

    // Try expression: try { body } catch e { handler }
    if kind == TokenKind::Try {
        p_advance()
        const try_block = parse_block()
        const try_e = expr_new(ExprKind::EBlock(try_block), span)
        let catch_var = "_"
        let catch_body = null
        if p_at(TokenKind::Ident) && p_peek().text == "catch" {
            p_advance()
            if p_at(TokenKind::Ident) {
                catch_var = p_advance().text
            }
            const cb = parse_block()
            catch_body = expr_new(ExprKind::EBlock(cb), span)
        }
        return expr_new(ExprKind::ETryCatch(try_e, catch_var, catch_body), span)
    }

    // Array literal or list comprehension
    if kind == TokenKind::LBracket {
        return parse_array_literal()
    }

    // Parenthesized expression, tuple, or arrow function params
    if kind == TokenKind::LParen {
        return parse_paren_or_lambda()
    }

    // Block expression
    if kind == TokenKind::LBrace {
        const blk = parse_block()
        return expr_new(ExprKind::EBlock(blk), span)
    }

    // Underscore (placeholder)
    if kind == TokenKind::Underscore {
        p_advance()
        return expr_new(ExprKind::EPlaceholder, span)
    }

    // Identifier — could be variable, arrow function, or struct construct
    if kind == TokenKind::Ident {
        p_advance()
        const name = tok.text

        // Arrow function: name => body
        if p_at(TokenKind::FatArrow) {
            p_advance()
            const body_expr = parse_expression(0)
            const body = block_new([], body_expr, span)
            const params = [param_new(name, span)]
            return make_lambda(params, body, span)
        }

        // Struct construction: Name { field: val, ... }
        if p_at(TokenKind::LBrace) && len(name) > 0 && name[0] >= "A" && name[0] <= "Z" {
            return parse_struct_construct(name, span)
        }

        return make_var(name, span)
    }

    // Spread operator
    if kind == TokenKind::DotDotDot {
        p_advance()
        const inner = parse_expression(0)
        return expr_new(ExprKind::ESpread(inner), span)
    }

    panic(f"unexpected token '{tok.text}' at {tok.line}:{tok.col}")
}

// ── F-string Interpolation ────────────────────────────────────────

func parse_fstring() {
    const span = p_current_span()
    const tok = p_advance()
    const raw = tok.text
    let parts = []
    let i = 0
    let current = ""

    while i < len(raw) {
        if raw[i] == "{" {
            if len(current) > 0 {
                parts.push(StringPart::LiteralPart(current))
                current = ""
            }
            i = i + 1
            let expr_str = ""
            let depth = 1
            while i < len(raw) && depth > 0 {
                if raw[i] == "{" { depth = depth + 1 }
                if raw[i] == "}" { depth = depth - 1 }
                if depth > 0 {
                    expr_str = expr_str + raw[i]
                }
                i = i + 1
            }
            // Parse the inner expression via re-entrant parse()
            const inner_prog = parse(expr_str)
            if len(inner_prog.statements) > 0 {
                match inner_prog.statements[0].kind {
                    StmtKind::SExprStmt(e) => {
                        parts.push(StringPart::ExprPart(e))
                    },
                    _ => {
                        parts.push(StringPart::LiteralPart(expr_str))
                    },
                }
            }
        } else {
            current = current + raw[i]
            i = i + 1
        }
    }
    if len(current) > 0 {
        parts.push(StringPart::LiteralPart(current))
    }

    expr_new(ExprKind::EStringInterp(parts), span)
}

// ── If Expression ─────────────────────────────────────────────────

func parse_if_expr() {
    const span = p_current_span()
    p_expect(TokenKind::If)
    const cond = parse_expression(0)
    const then_block = parse_block()
    let else_block = null
    if p_at(TokenKind::Else) {
        p_advance()
        if p_at(TokenKind::If) {
            // else if chain
            const else_if = parse_if_expr()
            const else_span = else_if.span
            else_block = block_new([], else_if, else_span)
        } else {
            else_block = parse_block()
        }
    }
    make_if(cond, then_block, else_block, span)
}

// ── Match Expression ──────────────────────────────────────────────

func parse_match_expr() {
    const span = p_current_span()
    p_expect(TokenKind::Match)
    const subject = parse_expression(0)
    p_expect(TokenKind::LBrace)
    let arms = []
    while !p_at(TokenKind::RBrace) && !p_at_eof() {
        const arm = parse_match_arm()
        arms.push(arm)
        if p_at(TokenKind::Comma) { p_advance() }
        p_skip_semis()
    }
    p_expect(TokenKind::RBrace)
    expr_new(ExprKind::EMatch(subject, arms), span)
}

func parse_match_arm() {
    const span = p_current_span()
    const pattern = parse_pattern()
    p_expect(TokenKind::FatArrow)

    let body = null
    if p_at(TokenKind::LBrace) {
        const blk = parse_block()
        body = expr_new(ExprKind::EBlock(blk), span)
    } else {
        body = parse_expression(0)
    }

    match_arm_new(pattern, body, span)
}

func parse_pattern() {
    const tok = p_peek()
    const kind = tok.kind

    // Wildcard
    if kind == TokenKind::Underscore {
        p_advance()
        return Pattern::PWildcard
    }

    // Boolean literals
    if kind == TokenKind::True {
        p_advance()
        return Pattern::PLiteral(make_bool_lit(true, p_current_span()))
    }
    if kind == TokenKind::False {
        p_advance()
        return Pattern::PLiteral(make_bool_lit(false, p_current_span()))
    }

    // Null
    if kind == TokenKind::Null {
        p_advance()
        return Pattern::PLiteral(make_null_lit(p_current_span()))
    }

    // Numeric literals
    if kind == TokenKind::IntLit {
        p_advance()
        return Pattern::PLiteral(make_int_lit(parse_int(tok.text), p_current_span()))
    }
    if kind == TokenKind::FloatLit {
        p_advance()
        return Pattern::PLiteral(make_float_lit(parse_float(tok.text), p_current_span()))
    }

    // String literal
    if kind == TokenKind::StringLit {
        p_advance()
        return Pattern::PLiteral(make_str_lit(tok.text, p_current_span()))
    }

    // Negative numeric literal
    if kind == TokenKind::Minus {
        p_advance()
        const num_tok = p_peek()
        if num_tok.kind == TokenKind::IntLit {
            p_advance()
            return Pattern::PLiteral(make_int_lit(0 - parse_int(num_tok.text), p_current_span()))
        }
        if num_tok.kind == TokenKind::FloatLit {
            p_advance()
            return Pattern::PLiteral(make_float_lit(0.0 - parse_float(num_tok.text), p_current_span()))
        }
        panic("expected number after - in pattern")
    }

    // Array pattern
    if kind == TokenKind::LBracket {
        p_advance()
        let pats = []
        while !p_at(TokenKind::RBracket) && !p_at_eof() {
            if p_at(TokenKind::DotDotDot) {
                p_advance()
                let rest_name = "_"
                if p_at(TokenKind::Ident) { rest_name = p_advance().text }
                pats.push(Pattern::PRest(rest_name))
            } else {
                pats.push(parse_pattern())
            }
            if p_at(TokenKind::Comma) { p_advance() }
        }
        p_expect(TokenKind::RBracket)
        return Pattern::PArray(pats)
    }

    // Rest pattern
    if kind == TokenKind::DotDotDot {
        p_advance()
        let rest_name = "_"
        if p_at(TokenKind::Ident) { rest_name = p_advance().text }
        return Pattern::PRest(rest_name)
    }

    // Identifier — variable, enum pattern, or or-pattern
    if kind == TokenKind::Ident {
        p_advance()
        const name = tok.text

        // Enum pattern: Name::Variant or Name::Variant(bindings)
        if p_at(TokenKind::ColonColon) {
            p_advance()
            const variant = p_expect_ident()
            let fields = []
            if p_at(TokenKind::LParen) {
                p_advance()
                while !p_at(TokenKind::RParen) && !p_at_eof() {
                    fields.push(parse_pattern())
                    if p_at(TokenKind::Comma) { p_advance() }
                }
                p_expect(TokenKind::RParen)
            }
            const pat = Pattern::PEnum(name, variant, fields)
            if p_at(TokenKind::Bar) {
                return parse_or_pattern(pat)
            }
            return pat
        }

        // Type pattern: name: Type
        if p_at(TokenKind::Colon) {
            p_advance()
            const type_name = p_expect_ident()
            return Pattern::PType(name, type_name)
        }

        const var_pat = Pattern::PVariable(name)
        if p_at(TokenKind::Bar) {
            return parse_or_pattern(var_pat)
        }
        return var_pat
    }

    panic(f"unexpected token in pattern: '{tok.text}' at {tok.line}:{tok.col}")
}

func parse_or_pattern(first) {
    let pats = [first]
    while p_at(TokenKind::Bar) {
        p_advance()
        pats.push(parse_pattern())
    }
    Pattern::POr(pats)
}

// ── Array Literal ─────────────────────────────────────────────────

func parse_array_literal() {
    const span = p_current_span()
    p_expect(TokenKind::LBracket)

    // Empty array
    if p_at(TokenKind::RBracket) {
        p_expect(TokenKind::RBracket)
        return expr_new(ExprKind::ELiteral(Literal::ArrayLit([])), span)
    }

    const first = parse_expression(0)

    // List comprehension: [expr for var in iterable]
    if p_at(TokenKind::For) {
        p_advance()
        const var_pattern = parse_comprehension_pattern()
        p_expect(TokenKind::In)
        const iterable = parse_expression(0)
        let condition = null
        if p_at(TokenKind::If) {
            p_advance()
            condition = parse_expression(0)
        }
        p_expect(TokenKind::RBracket)
        return expr_new(ExprKind::EListComp(first, var_pattern, iterable, condition), span)
    }

    let elements = [first]
    while p_at(TokenKind::Comma) {
        p_advance()
        if p_at(TokenKind::RBracket) { break }
        elements.push(parse_expression(0))
    }
    p_expect(TokenKind::RBracket)
    expr_new(ExprKind::ELiteral(Literal::ArrayLit(elements)), span)
}

func parse_comprehension_pattern() {
    // Simple: x or destructured: [a, b]
    if p_at(TokenKind::LBracket) {
        p_advance()
        let names = []
        while !p_at(TokenKind::RBracket) && !p_at_eof() {
            names.push(make_var(p_expect_ident(), p_current_span()))
            if p_at(TokenKind::Comma) { p_advance() }
        }
        p_expect(TokenKind::RBracket)
        return expr_new(ExprKind::ELiteral(Literal::ArrayLit(names)), p_current_span())
    }
    make_var(p_expect_ident(), p_current_span())
}

// ── Paren Expression or Lambda ────────────────────────────────────

func parse_paren_or_lambda() {
    const span = p_current_span()
    p_expect(TokenKind::LParen)

    // Empty parens: () => body
    if p_at(TokenKind::RParen) {
        p_advance()
        if p_at(TokenKind::FatArrow) {
            p_advance()
            const body_expr = parse_expression(0)
            const body = block_new([], body_expr, span)
            return make_lambda([], body, span)
        }
        return make_null_lit(span)
    }

    // Lookahead to detect lambda: (a, b) => ...
    let is_lambda = false
    let look_pos = p_pos
    let depth = 1
    while look_pos < len(p_tokens) && depth > 0 {
        const look_tok = p_tokens[look_pos]
        if look_tok.kind == TokenKind::LParen { depth = depth + 1 }
        if look_tok.kind == TokenKind::RParen { depth = depth - 1 }
        if depth == 0 {
            if look_pos + 1 < len(p_tokens) && p_tokens[look_pos + 1].kind == TokenKind::FatArrow {
                is_lambda = true
            }
        }
        look_pos = look_pos + 1
    }

    if is_lambda {
        let params = []
        while !p_at(TokenKind::RParen) && !p_at_eof() {
            const pspan = p_current_span()
            const pname = p_expect_ident()
            let fp = param_new(pname, pspan)
            if p_at(TokenKind::Colon) {
                p_advance()
                fp.type_ann = parse_type_annotation()
            }
            params.push(fp)
            if p_at(TokenKind::Comma) { p_advance() }
        }
        p_expect(TokenKind::RParen)
        p_expect(TokenKind::FatArrow)

        let body = null
        if p_at(TokenKind::LBrace) {
            body = parse_block()
        } else {
            const body_expr = parse_expression(0)
            body = block_new([], body_expr, span)
        }
        return make_lambda(params, body, span)
    }

    // Regular parenthesized expression or tuple literal
    const expr = parse_expression(0)

    // Tuple literal: (a, b, c)
    if p_at(TokenKind::Comma) {
        let elements = [expr]
        while p_at(TokenKind::Comma) {
            p_advance()
            if p_at(TokenKind::RParen) { break }
            elements.push(parse_expression(0))
        }
        p_expect(TokenKind::RParen)
        return expr_new(ExprKind::ETupleLiteral(elements), span)
    }

    p_expect(TokenKind::RParen)
    expr
}

// ── Struct Construction ───────────────────────────────────────────

func parse_struct_construct(name, span) {
    p_expect(TokenKind::LBrace)
    let fields = []
    while !p_at(TokenKind::RBrace) && !p_at_eof() {
        // Spread: ...expr
        if p_at(TokenKind::DotDotDot) {
            p_advance()
            const spread_expr = parse_expression(0)
            fields.push(["__spread", spread_expr])
            if p_at(TokenKind::Comma) { p_advance() }
            continue
        }
        const fname = p_expect_ident()
        p_expect(TokenKind::Colon)
        const fval = parse_expression(0)
        fields.push([fname, fval])
        if p_at(TokenKind::Comma) { p_advance() }
    }
    p_expect(TokenKind::RBrace)
    expr_new(ExprKind::EStructConstruct(name, fields), span)
}

// ══════════════════════════════════════════════════════════════════════
// ── Generic Parsing with Bounds and Where Clauses ───────────────────
// ══════════════════════════════════════════════════════════════════════

// Parse generic type parameters: <T, U: Trait, V: A + B>
func parse_type_params() {
    let params = []
    if !p_at(TokenKind::Less) { return params }
    p_advance() // skip <

    while !p_at(TokenKind::Greater) && !p_at_eof() {
        const name = p_expect_ident()
        let constraints = []

        // Check for bounds: T: Trait or T: A + B
        if p_at(TokenKind::Colon) {
            p_advance()
            constraints.push(p_expect_ident())
            while p_at(TokenKind::Plus) {
                p_advance()
                constraints.push(p_expect_ident())
            }
        }

        if len(constraints) > 0 {
            params.push([name].concat(constraints))
        } else {
            params.push(name)
        }

        if p_at(TokenKind::Comma) { p_advance() }
    }

    if p_at(TokenKind::Greater) { p_advance() }
    params
}

// Parse where clause: where T: Trait, U: OtherTrait
func parse_where_clause() {
    let clauses = []
    if !p_at_keyword("where") { return clauses }
    p_advance() // skip "where"

    while !p_at(TokenKind::LBrace) && !p_at_eof() {
        const type_name = p_expect_ident()
        p_expect(TokenKind::Colon)
        let bounds = [p_expect_ident()]
        while p_at(TokenKind::Plus) {
            p_advance()
            bounds.push(p_expect_ident())
        }
        clauses.push({"type": type_name, "bounds": bounds})
        if p_at(TokenKind::Comma) { p_advance() }
    }
    clauses
}

// Check if current token is a specific keyword
func p_at_keyword(keyword) {
    const tok = p_peek()
    tok.kind == TokenKind::Ident && tok.text == keyword
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Type Annotation Parsing ────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Parse a type annotation: int, string, Array<T>, Map<K, V>, (A, B) -> C, T?
func parse_type_annotation() {
    let base_type = parse_base_type()

    // Optional: T?
    if p_at(TokenKind::Question) {
        p_advance()
        base_type = {"kind": "optional", "inner": base_type}
    }

    // Function type: (A, B) -> C
    if p_at(TokenKind::Arrow) {
        p_advance()
        const return_type = parse_type_annotation()
        base_type = {"kind": "function", "params": [base_type], "return": return_type}
    }

    base_type
}

func parse_base_type() {
    // Tuple type: (A, B, C)
    if p_at(TokenKind::LParen) {
        p_advance()
        let types = []
        while !p_at(TokenKind::RParen) && !p_at_eof() {
            types.push(parse_type_annotation())
            if p_at(TokenKind::Comma) { p_advance() }
        }
        p_expect(TokenKind::RParen)
        return {"kind": "tuple", "elements": types}
    }

    // Array shorthand: [T]
    if p_at(TokenKind::LBracket) {
        p_advance()
        const elem_type = parse_type_annotation()
        p_expect(TokenKind::RBracket)
        return {"kind": "array", "element": elem_type}
    }

    // Named type, possibly generic: Name<T, U>
    const name = p_expect_ident()

    // Check for generic arguments: Name<T, U>
    if p_at(TokenKind::Less) {
        p_advance()
        let args = []
        while !p_at(TokenKind::Greater) && !p_at_eof() {
            args.push(parse_type_annotation())
            if p_at(TokenKind::Comma) { p_advance() }
        }
        if p_at(TokenKind::Greater) { p_advance() }
        return {"kind": "generic", "name": name, "args": args}
    }

    name
}

// Parse return type annotation: -> Type
func parse_return_type() {
    if p_at(TokenKind::Arrow) {
        p_advance()
        return parse_type_annotation()
    }
    null
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Attribute Parsing ──────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Parse #[attr] or #[attr(args)]
func parse_attribute() {
    // Assumes we just saw '#'
    p_expect(TokenKind::LBracket)
    const name = p_expect_ident()
    let args = []

    // Check for arguments: #[attr(arg1, arg2)]
    if p_at(TokenKind::LParen) {
        p_advance()
        while !p_at(TokenKind::RParen) && !p_at_eof() {
            const tok = p_peek()
            if tok.kind == TokenKind::StringLit {
                args.push(p_advance().text)
            } else if tok.kind == TokenKind::Ident {
                args.push(p_advance().text)
            } else if tok.kind == TokenKind::IntLit {
                args.push(p_advance().text)
            } else {
                p_advance() // skip unknown
            }
            if p_at(TokenKind::Comma) { p_advance() }
        }
        p_expect(TokenKind::RParen)
    }

    p_expect(TokenKind::RBracket)
    {"name": name, "args": args}
}

// Parse multiple attributes before a declaration
func parse_attributes() {
    let attrs = []
    while p_at(TokenKind::Hash) {
        p_advance() // skip #
        attrs.push(parse_attribute())
    }
    attrs
}

// Known attributes
const KNOWN_ATTRIBUTES = [
    "test", "deprecated", "ignore", "inline", "cold", "hot",
    "allow", "deny", "warn", "cfg", "feature", "doc",
    "derive", "repr", "no_mangle", "export", "wasm_bindgen"
]

// ══════════════════════════════════════════════════════════════════════
// ── Async Function Parsing ──────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Parse: async func name(params) { body }
func parse_async_func(span) {
    // 'async' already consumed
    p_expect(TokenKind::Func)
    const name = p_expect_ident()

    // Optional generic params
    let type_params = parse_type_params()

    p_expect(TokenKind::LParen)
    let params = parse_param_list()
    p_expect(TokenKind::RParen)

    const return_type = parse_return_type()
    const body = parse_block()

    let fdef = {
        "name": name,
        "params": params,
        "body": body,
        "type_params": type_params,
        "return_type": if return_type != null { to_string(return_type) } else { "" },
    }
    stmt_new(StmtKind::SAsyncFuncDef(fdef), span)
}

// Parse parameter list with default values and rest params
func parse_param_list() {
    let params = []
    while !p_at(TokenKind::RParen) && !p_at_eof() {
        let rest = false
        if p_at(TokenKind::DotDotDot) {
            p_advance()
            rest = true
        }

        const name = p_expect_ident()
        let type_ann = ""
        let default_val = null

        // Type annotation: param: Type
        if p_at(TokenKind::Colon) {
            p_advance()
            type_ann = to_string(parse_type_annotation())
        }

        // Default value: param = expr
        if p_at(TokenKind::Eq) {
            p_advance()
            default_val = parse_expression(0)
        }

        params.push({
            "name": name,
            "type_ann": type_ann,
            "default_val": default_val,
            "rest": rest,
        })

        if p_at(TokenKind::Comma) { p_advance() }
    }
    params
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Destructuring in All Positions ─────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Parse destructuring pattern: [a, b, ...rest] or {x, y} or (a, b)
func parse_destructure_pattern() {
    // Array destructuring: [a, b, ...rest]
    if p_at(TokenKind::LBracket) {
        p_advance()
        let elements = []
        while !p_at(TokenKind::RBracket) && !p_at_eof() {
            if p_at(TokenKind::DotDotDot) {
                p_advance()
                const rest_name = p_expect_ident()
                elements.push({"kind": "rest", "name": rest_name})
            } else {
                const name = p_expect_ident()
                elements.push({"kind": "name", "name": name})
            }
            if p_at(TokenKind::Comma) { p_advance() }
        }
        p_expect(TokenKind::RBracket)
        return {"kind": "array", "elements": elements}
    }

    // Map/object destructuring: {x, y, z: alias}
    if p_at(TokenKind::LBrace) {
        p_advance()
        let fields = []
        while !p_at(TokenKind::RBrace) && !p_at_eof() {
            if p_at(TokenKind::DotDotDot) {
                p_advance()
                const rest_name = p_expect_ident()
                fields.push({"kind": "rest", "name": rest_name})
            } else {
                const key = p_expect_ident()
                let alias = key
                if p_at(TokenKind::Colon) {
                    p_advance()
                    alias = p_expect_ident()
                }
                fields.push({"kind": "field", "key": key, "alias": alias})
            }
            if p_at(TokenKind::Comma) { p_advance() }
        }
        p_expect(TokenKind::RBrace)
        return {"kind": "map", "fields": fields}
    }

    // Tuple destructuring: (a, b, c)
    if p_at(TokenKind::LParen) {
        p_advance()
        let elements = []
        while !p_at(TokenKind::RParen) && !p_at_eof() {
            const name = p_expect_ident()
            elements.push({"kind": "name", "name": name})
            if p_at(TokenKind::Comma) { p_advance() }
        }
        p_expect(TokenKind::RParen)
        return {"kind": "tuple", "elements": elements}
    }

    // Simple name
    const name = p_expect_ident()
    {"kind": "simple", "name": name}
}

// ══════════════════════════════════════════════════════════════════════
// ── Error Recovery (Synchronize on Statement Boundaries) ────────────
// ══════════════════════════════════════════════════════════════════════

// Synchronize parser state after an error by skipping to the next statement
func p_synchronize() {
    while !p_at_eof() {
        const tok = p_peek()
        // Statement boundary tokens
        if tok.kind == TokenKind::Func { return }
        if tok.kind == TokenKind::Let { return }
        if tok.kind == TokenKind::Const { return }
        if tok.kind == TokenKind::If { return }
        if tok.kind == TokenKind::While { return }
        if tok.kind == TokenKind::For { return }
        if tok.kind == TokenKind::Return { return }
        if tok.kind == TokenKind::Match { return }
        if tok.kind == TokenKind::Enum { return }
        if tok.kind == TokenKind::Struct { return }
        if tok.kind == TokenKind::Trait { return }
        if tok.kind == TokenKind::Impl { return }
        if tok.kind == TokenKind::Import { return }
        if tok.kind == TokenKind::Break { return }
        if tok.kind == TokenKind::Continue { return }
        // Skip past semicolons and closing braces
        if tok.kind == TokenKind::Semicolon || tok.kind == TokenKind::RBrace {
            p_advance()
            return
        }
        p_advance()
    }
}

// Accumulated parse errors for recovery mode
let p_errors = []

func p_error(msg) {
    const tok = p_peek()
    p_errors.push(f"parse error at {tok.line}:{tok.col}: {msg}")
}

func p_recover_error(msg) {
    p_error(msg)
    p_synchronize()
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Pattern Parsing (All Pattern Types) ────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Parse a match arm pattern
func parse_pattern() {
    // Wildcard: _
    if p_at(TokenKind::Ident) && p_peek().text == "_" {
        p_advance()
        return {"kind": "wildcard"}
    }

    // Literal patterns
    if p_at(TokenKind::IntLit) {
        const tok = p_advance()
        let value = to_int(tok.text)
        return {"kind": "literal", "value": value}
    }
    if p_at(TokenKind::FloatLit) {
        const tok = p_advance()
        return {"kind": "literal", "value": to_float(tok.text)}
    }
    if p_at(TokenKind::StringLit) {
        const tok = p_advance()
        return {"kind": "literal", "value": tok.text}
    }
    if p_at(TokenKind::True) {
        p_advance()
        return {"kind": "literal", "value": true}
    }
    if p_at(TokenKind::False) {
        p_advance()
        return {"kind": "literal", "value": false}
    }
    if p_at(TokenKind::Null) {
        p_advance()
        return {"kind": "literal", "value": null}
    }

    // Array pattern: [a, b, ...rest]
    if p_at(TokenKind::LBracket) {
        p_advance()
        let elements = []
        while !p_at(TokenKind::RBracket) && !p_at_eof() {
            if p_at(TokenKind::DotDotDot) {
                p_advance()
                const rest_name = p_expect_ident()
                elements.push({"kind": "rest", "name": rest_name})
            } else {
                elements.push(parse_pattern())
            }
            if p_at(TokenKind::Comma) { p_advance() }
        }
        p_expect(TokenKind::RBracket)
        return {"kind": "array", "elements": elements}
    }

    // Tuple pattern: (a, b)
    if p_at(TokenKind::LParen) {
        p_advance()
        let elements = []
        while !p_at(TokenKind::RParen) && !p_at_eof() {
            elements.push(parse_pattern())
            if p_at(TokenKind::Comma) { p_advance() }
        }
        p_expect(TokenKind::RParen)
        return {"kind": "tuple", "elements": elements}
    }

    // Named pattern (variable binding, enum variant, or struct pattern)
    if p_at(TokenKind::Ident) {
        const name = p_advance().text

        // Enum variant: Name::Variant or Name::Variant(a, b)
        if p_at(TokenKind::ColonColon) {
            p_advance()
            const variant = p_expect_ident()
            let bindings = []

            if p_at(TokenKind::LParen) {
                p_advance()
                while !p_at(TokenKind::RParen) && !p_at_eof() {
                    bindings.push(parse_pattern())
                    if p_at(TokenKind::Comma) { p_advance() }
                }
                p_expect(TokenKind::RParen)
            }

            let pat = {"kind": "enum", "enum": name, "variant": variant}
            if len(bindings) > 0 { pat["bindings"] = bindings }

            // Guard: if condition
            if p_at_keyword("if") {
                p_advance()
                const guard_expr = parse_expression(0)
                pat = {"kind": "guard", "inner": pat, "guard": guard_expr}
            }

            return pat
        }

        // Struct pattern: Name { field: pattern, ... }
        if p_at(TokenKind::LBrace) {
            p_advance()
            let fields = []
            while !p_at(TokenKind::RBrace) && !p_at_eof() {
                if p_at(TokenKind::DotDotDot) {
                    p_advance()
                    fields.push({"kind": "rest"})
                } else {
                    const fname = p_expect_ident()
                    let fpat = {"kind": "binding", "name": fname}
                    if p_at(TokenKind::Colon) {
                        p_advance()
                        fpat = parse_pattern()
                    }
                    fields.push({"field": fname, "pattern": fpat})
                }
                if p_at(TokenKind::Comma) { p_advance() }
            }
            p_expect(TokenKind::RBrace)
            return {"kind": "struct", "struct": name, "fields": fields}
        }

        // Or pattern: A | B
        let pat = {"kind": "binding", "name": name}
        if p_at(TokenKind::Pipe) {
            p_advance()
            const right = parse_pattern()
            pat = {"kind": "or", "left": pat, "right": right}
        }

        // Guard: if condition
        if p_at_keyword("if") {
            p_advance()
            const guard_expr = parse_expression(0)
            pat = {"kind": "guard", "inner": pat, "guard": guard_expr}
        }

        return pat
    }

    // Range pattern: 1..10 or 1..=10
    // (Would need to handle after parsing the literal)

    {"kind": "wildcard"}
}

// ══════════════════════════════════════════════════════════════════════
// ── String Interpolation Parsing with Nested Expressions ────────────
// ══════════════════════════════════════════════════════════════════════

// Parse a string interpolation f"text {expr} text"
// The lexer has already tokenized the parts; here we handle nested expressions
func parse_string_interp_parts(parts) {
    let result = []
    for part in parts {
        match part {
            StringPart::LiteralPart(s) => result.push(part),
            StringPart::ExprPart(expr) => {
                // The expr is already parsed by the lexer/parser combo
                result.push(part)
            },
        }
    }
    result
}

// ══════════════════════════════════════════════════════════════════════
// ── Operator Precedence for All Operators ───────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Full precedence table (matches src/syntax/parser.rs)
const PREC_ASSIGNMENT = 1     // =, +=, -=, etc.
const PREC_PIPE = 2           // |>
const PREC_NULL_COALESCE = 3  // ??
const PREC_OR = 4             // ||
const PREC_AND = 5            // &&
const PREC_BIT_OR = 6         // |
const PREC_BIT_XOR = 7        // ^
const PREC_BIT_AND = 8        // &
const PREC_EQUALITY = 9       // ==, !=
const PREC_COMPARISON = 10    // <, >, <=, >=
const PREC_IN = 11            // in
const PREC_RANGE = 12         // .., ..=
const PREC_SHIFT = 13         // <<, >>
const PREC_ADD = 14           // +, -
const PREC_MUL = 15           // *, /, %
const PREC_POWER = 16         // **
const PREC_UNARY = 17         // !, -, ~
const PREC_CALL = 18          // (), [], .
const PREC_PRIMARY = 19       // literals, identifiers

// Get infix operator precedence
func get_infix_precedence(tok_kind) {
    match tok_kind {
        TokenKind::PipeArrow => PREC_PIPE,
        TokenKind::QuestionQuestion => PREC_NULL_COALESCE,
        TokenKind::OrOr => PREC_OR,
        TokenKind::AndAnd => PREC_AND,
        TokenKind::Pipe => PREC_BIT_OR,
        TokenKind::Caret => PREC_BIT_XOR,
        TokenKind::Ampersand => PREC_BIT_AND,
        TokenKind::EqEq => PREC_EQUALITY,
        TokenKind::BangEq => PREC_EQUALITY,
        TokenKind::Less => PREC_COMPARISON,
        TokenKind::Greater => PREC_COMPARISON,
        TokenKind::LessEq => PREC_COMPARISON,
        TokenKind::GreaterEq => PREC_COMPARISON,
        TokenKind::In => PREC_IN,
        TokenKind::DotDot => PREC_RANGE,
        TokenKind::DotDotEq => PREC_RANGE,
        TokenKind::ShiftLeft => PREC_SHIFT,
        TokenKind::ShiftRight => PREC_SHIFT,
        TokenKind::Plus => PREC_ADD,
        TokenKind::Minus => PREC_ADD,
        TokenKind::Star => PREC_MUL,
        TokenKind::Slash => PREC_MUL,
        TokenKind::Percent => PREC_MUL,
        TokenKind::StarStar => PREC_POWER,
        _ => 0
    }
}

// Check if an operator is right-associative
func is_right_associative(tok_kind) {
    match tok_kind {
        TokenKind::StarStar => true,
        TokenKind::QuestionQuestion => true,
        _ => false
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Precedence-Based Expression Parser ─────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Pratt parser using full precedence table (17 levels).
// Replaces the simpler parse_expression when full operator coverage is needed.
func parse_expression_pratt(min_prec) {
    let left = parse_prefix_expr()

    while true {
        const tok = p_peek()
        const prec = get_infix_precedence(tok.kind)
        if prec == 0 || prec < min_prec { break }

        const op_kind = tok.kind
        p_advance()
        const span = left.span

        // Right-associative operators use min_prec = prec, left-associative use prec + 1
        const next_prec = if is_right_associative(op_kind) { prec } else { prec + 1 }

        // Special handling for different operator types
        match op_kind {
            TokenKind::PipeArrow => {
                const right = parse_prefix_expr()
                left = expr_new(ExprKind::EPipe(left, right), span)
            },
            TokenKind::QuestionQuestion => {
                const right = parse_expression_pratt(next_prec)
                left = expr_new(ExprKind::ENullCoalesce(left, right), span)
            },
            TokenKind::DotDot => {
                const right = parse_expression_pratt(next_prec)
                left = expr_new(ExprKind::ERange(left, right, false), span)
            },
            TokenKind::DotDotEq => {
                const right = parse_expression_pratt(next_prec)
                left = expr_new(ExprKind::ERange(left, right, true), span)
            },
            TokenKind::In => {
                const right = parse_expression_pratt(next_prec)
                left = make_binop(BinOp::In, left, right, span)
            },
            _ => {
                const op = token_kind_to_binop(op_kind)
                if op != null {
                    const right = parse_expression_pratt(next_prec)
                    left = make_binop(op, left, right, span)
                }
            }
        }
    }
    left
}

// Map token kinds to binary operators (complete mapping).
func token_kind_to_binop(kind) {
    match kind {
        TokenKind::PipePipe => BinOp::Or,
        TokenKind::AndAnd => BinOp::And,
        TokenKind::EqEq => BinOp::Eq,
        TokenKind::NotEq => BinOp::NotEq,
        TokenKind::Lt => BinOp::Lt,
        TokenKind::Gt => BinOp::Gt,
        TokenKind::LtEq => BinOp::LtEq,
        TokenKind::GtEq => BinOp::GtEq,
        TokenKind::Plus => BinOp::Add,
        TokenKind::Minus => BinOp::Sub,
        TokenKind::Star => BinOp::Mul,
        TokenKind::Slash => BinOp::Div,
        TokenKind::Percent => BinOp::Mod,
        TokenKind::StarStar => BinOp::Pow,
        TokenKind::Amp => BinOp::BitAnd,
        TokenKind::Bar => BinOp::BitOr,
        TokenKind::Caret => BinOp::BitXor,
        TokenKind::Shl => BinOp::Shl,
        TokenKind::Shr => BinOp::Shr,
        _ => null
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Prefix Expression Parser ───────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Parse prefix expressions: unary ops, await, spawn, yield, typeof
func parse_prefix_expr() {
    const span = p_current_span()

    // Unary minus
    if p_at(TokenKind::Minus) {
        p_advance()
        const operand = parse_prefix_expr()
        return make_unaryop(UnOp::Neg, operand, span)
    }

    // Logical not
    if p_at(TokenKind::Bang) {
        p_advance()
        const operand = parse_prefix_expr()
        return make_unaryop(UnOp::Not, operand, span)
    }

    // Bitwise not
    if p_at(TokenKind::Tilde) {
        p_advance()
        const operand = parse_prefix_expr()
        return make_unaryop(UnOp::BitNot, operand, span)
    }

    // await expr
    if p_at(TokenKind::Await) {
        p_advance()
        const operand = parse_prefix_expr()
        return expr_new(ExprKind::EAwait(operand), span)
    }

    // spawn expr
    if p_at(TokenKind::Spawn) {
        p_advance()
        let operand = null
        if p_at(TokenKind::LBrace) {
            const blk = parse_block()
            operand = expr_new(ExprKind::EBlock(blk), span)
        } else {
            operand = parse_prefix_expr()
        }
        return expr_new(ExprKind::ESpawn(operand), span)
    }

    // yield expr
    if p_at(TokenKind::Yield) {
        p_advance()
        const operand = parse_prefix_expr()
        return expr_new(ExprKind::EYield(operand), span)
    }

    // typeof expr (soft keyword)
    if p_at(TokenKind::Ident) && p_peek().text == "typeof" {
        const saved = p_pos
        p_advance()
        if p_at(TokenKind::LParen) {
            p_advance()
            const inner = parse_expression_pratt(0)
            p_expect(TokenKind::RParen)
            return make_call("typeof", [inner], span)
        }
        p_pos = saved
    }

    parse_postfix_expr()
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Postfix Expression Parser ──────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Parse postfix: calls, field access, indexing, optional chaining, try-propagate
func parse_postfix_expr() {
    let expr = parse_primary_expr()

    while true {
        // Function call: expr(args)
        if p_at(TokenKind::LParen) {
            const span = expr.span
            match expr.kind {
                ExprKind::EVariable(name) => {
                    const result = parse_call_args_full()
                    expr = expr_new(ExprKind::ECall(name, result.args, result.kwargs), span)
                },
                ExprKind::EFieldAccess(obj, method) => {
                    const result = parse_call_args_full()
                    expr = expr_new(ExprKind::EMethodCall(obj, method, result.args, result.kwargs), span)
                },
                _ => {
                    const result = parse_call_args_full()
                    expr = expr_new(ExprKind::ECall("__call", [expr] + result.args, result.kwargs), span)
                }
            }
        }
        // Field access: expr.field
        else if p_at(TokenKind::Dot) {
            p_advance()
            const span = expr.span
            const field = p_expect_ident()
            expr = make_field_access(expr, field, span)
        }
        // Index: expr[index]
        else if p_at(TokenKind::LBracket) {
            p_advance()
            const span = expr.span
            const idx = parse_expression_pratt(0)
            p_expect(TokenKind::RBracket)
            expr = make_index(expr, idx, span)
        }
        // Optional chaining: expr?.field
        else if p_at(TokenKind::QuestionDot) {
            p_advance()
            const span = expr.span
            const field = p_expect_ident()
            expr = expr_new(ExprKind::EOptionalChain(expr, field), span)
        }
        // Enum construct: Name::Variant
        else if p_at(TokenKind::ColonColon) {
            p_advance()
            const span = expr.span
            match expr.kind {
                ExprKind::EVariable(enum_name) => {
                    const variant = p_expect_ident()
                    let args = []
                    if p_at(TokenKind::LParen) {
                        const result = parse_call_args_full()
                        args = result.args
                    }
                    expr = expr_new(ExprKind::EEnumConstruct(enum_name, variant, args), span)
                },
                _ => { panic("expected enum name before ::") }
            }
        }
        // Try propagate: expr?
        else if p_at(TokenKind::Question) {
            p_advance()
            const span = expr.span
            expr = expr_new(ExprKind::ETryPropagate(expr), span)
        }
        else {
            break
        }
    }
    expr
}

// Parse call arguments with both positional and keyword args.
func parse_call_args_full() {
    p_expect(TokenKind::LParen)
    let args = []
    let kwargs = []

    while !p_at(TokenKind::RParen) && !p_at_eof() {
        // Check for keyword argument: name: value
        if p_at(TokenKind::Ident) {
            const saved = p_pos
            const name = p_peek().text
            p_advance()
            if p_at(TokenKind::Colon) {
                // Keyword argument
                p_advance()
                const value = parse_expression_pratt(0)
                kwargs.push([name, value])
                if p_at(TokenKind::Comma) { p_advance() }
                continue
            }
            // Not a keyword arg, restore position
            p_pos = saved
        }

        // Spread argument: ...expr
        if p_at(TokenKind::DotDotDot) {
            p_advance()
            const inner = parse_expression_pratt(0)
            args.push(expr_new(ExprKind::ESpread(inner), inner.span))
        } else {
            const arg = parse_expression_pratt(0)
            args.push(arg)
        }
        if p_at(TokenKind::Comma) { p_advance() }
    }

    p_expect(TokenKind::RParen)
    {"args": args, "kwargs": kwargs}
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Primary Expression Parser ──────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func parse_primary_expr() {
    const tok = p_peek()
    const span = p_current_span()
    const kind = tok.kind

    // Integer literal
    if kind == TokenKind::IntLit {
        p_advance()
        return make_int_lit(parse_int(tok.text), span)
    }

    // Float literal
    if kind == TokenKind::FloatLit {
        p_advance()
        return make_float_lit(parse_float(tok.text), span)
    }

    // String literal
    if kind == TokenKind::StringLit {
        p_advance()
        return make_str_lit(tok.text, span)
    }

    // F-string interpolation
    if kind == TokenKind::FStringStart {
        return parse_fstring()
    }

    // Boolean literals
    if kind == TokenKind::True {
        p_advance()
        return make_bool_lit(true, span)
    }
    if kind == TokenKind::False {
        p_advance()
        return make_bool_lit(false, span)
    }

    // Null literal
    if kind == TokenKind::Null {
        p_advance()
        return make_null_lit(span)
    }

    // If expression
    if kind == TokenKind::If { return parse_if_expr() }

    // Match expression
    if kind == TokenKind::Match { return parse_match_expr() }

    // Loop expression
    if kind == TokenKind::Loop {
        p_advance()
        const body = parse_block()
        return expr_new(ExprKind::ELoop(body), span)
    }

    // Try expression
    if kind == TokenKind::Try {
        p_advance()
        const try_block = parse_block()
        const try_e = expr_new(ExprKind::EBlock(try_block), span)
        let catch_var = "_"
        let catch_body = null
        let finally_body = null
        if p_at(TokenKind::Ident) && p_peek().text == "catch" {
            p_advance()
            if p_at(TokenKind::Ident) && p_peek().text != "{" {
                catch_var = p_advance().text
            }
            const cb = parse_block()
            catch_body = expr_new(ExprKind::EBlock(cb), span)
        }
        if p_at(TokenKind::Ident) && p_peek().text == "finally" {
            p_advance()
            const fb = parse_block()
            finally_body = expr_new(ExprKind::EBlock(fb), span)
        }
        return expr_new(ExprKind::ETryCatch(try_e, catch_var, catch_body), span)
    }

    // Array literal or list comprehension
    if kind == TokenKind::LBracket { return parse_array_literal_full() }

    // Map literal: { key: value, ... }
    if kind == TokenKind::LBrace {
        // Disambiguate between block and map literal
        // If next is ident/string followed by ':', it's a map
        if p_is_map_literal() {
            return parse_map_literal()
        }
        const blk = parse_block()
        return expr_new(ExprKind::EBlock(blk), span)
    }

    // Parenthesized expression, tuple, or arrow function
    if kind == TokenKind::LParen { return parse_paren_or_lambda_full() }

    // Underscore (placeholder)
    if kind == TokenKind::Underscore {
        p_advance()
        return expr_new(ExprKind::EPlaceholder, span)
    }

    // Identifier
    if kind == TokenKind::Ident {
        p_advance()
        const name = tok.text

        // Arrow function: name => body
        if p_at(TokenKind::FatArrow) {
            p_advance()
            let body_block = null
            if p_at(TokenKind::LBrace) {
                body_block = parse_block()
            } else {
                const body_expr = parse_expression_pratt(0)
                body_block = block_new([], body_expr, span)
            }
            const params = [param_new(name, span)]
            return make_lambda(params, body_block, span)
        }

        // Struct construction: Name { field: val, ... }
        if p_at(TokenKind::LBrace) && len(name) > 0 && name[0] >= "A" && name[0] <= "Z" {
            return parse_struct_construct(name, span)
        }

        return make_var(name, span)
    }

    // Spread operator
    if kind == TokenKind::DotDotDot {
        p_advance()
        const inner = parse_expression_pratt(0)
        return expr_new(ExprKind::ESpread(inner), span)
    }

    // Hash set literal: #{...}
    if kind == TokenKind::Hash {
        p_advance()
        if p_at(TokenKind::LBrace) {
            return parse_set_literal(span)
        }
        // Could be attribute context, fall through
    }

    panic(f"unexpected token '{tok.text}' at {tok.line}:{tok.col}")
}

// ══════════════════════════════════════════════════════════════════════
// ── Map Literal Detection and Parsing ───────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func p_is_map_literal() {
    // Peek ahead: { ident/string : ... } or { }
    if !p_at(TokenKind::LBrace) { return false }
    const saved = p_pos
    p_advance() // skip {
    // Empty map
    if p_at(TokenKind::RBrace) { p_pos = saved; return true }
    // Check first token
    const first = p_peek()
    if first.kind == TokenKind::Ident || first.kind == TokenKind::StringLit || first.kind == TokenKind::IntLit {
        p_advance()
        const is_map = p_at(TokenKind::Colon)
        p_pos = saved
        return is_map
    }
    p_pos = saved
    false
}

func parse_map_literal() {
    const span = p_current_span()
    p_expect(TokenKind::LBrace)
    let entries = []
    while !p_at(TokenKind::RBrace) && !p_at_eof() {
        // Key: string or identifier
        let key = ""
        if p_at(TokenKind::StringLit) {
            key = "\"" + p_advance().text + "\""
        } else {
            key = "\"" + p_expect_ident() + "\""
        }
        p_expect(TokenKind::Colon)
        const value = parse_expression_pratt(0)
        entries.push([key, value])
        if p_at(TokenKind::Comma) { p_advance() }
    }
    p_expect(TokenKind::RBrace)
    expr_new(ExprKind::ELiteral(Literal::MapLit(entries)), span)
}

func parse_set_literal(span) {
    p_expect(TokenKind::LBrace)
    let elements = []
    while !p_at(TokenKind::RBrace) && !p_at_eof() {
        elements.push(parse_expression_pratt(0))
        if p_at(TokenKind::Comma) { p_advance() }
    }
    p_expect(TokenKind::RBrace)
    expr_new(ExprKind::ELiteral(Literal::SetLit(elements)), span)
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Array Literal / Comprehension Parser ───────────────────────
// ══════════════════════════════════════════════════════════════════════

func parse_array_literal_full() {
    const span = p_current_span()
    p_expect(TokenKind::LBracket)

    // Empty array
    if p_at(TokenKind::RBracket) {
        p_expect(TokenKind::RBracket)
        return expr_new(ExprKind::ELiteral(Literal::ArrayLit([])), span)
    }

    const first = parse_expression_pratt(0)

    // List comprehension: [expr for var in iterable if cond]
    if p_at(TokenKind::For) {
        p_advance()
        const pattern = parse_comprehension_pattern_full()
        p_expect(TokenKind::In)
        const iterable = parse_expression_pratt(0)
        let condition = null
        if p_at(TokenKind::If) {
            p_advance()
            condition = parse_expression_pratt(0)
        }
        p_expect(TokenKind::RBracket)
        return expr_new(ExprKind::EListComp(first, pattern, iterable, condition), span)
    }

    // Regular array literal
    let elements = [first]
    while p_at(TokenKind::Comma) {
        p_advance()
        if p_at(TokenKind::RBracket) { break } // trailing comma
        // Spread element
        if p_at(TokenKind::DotDotDot) {
            p_advance()
            const inner = parse_expression_pratt(0)
            elements.push(expr_new(ExprKind::ESpread(inner), span))
        } else {
            elements.push(parse_expression_pratt(0))
        }
    }
    p_expect(TokenKind::RBracket)
    expr_new(ExprKind::ELiteral(Literal::ArrayLit(elements)), span)
}

func parse_comprehension_pattern_full() {
    // Destructured: [a, b]
    if p_at(TokenKind::LBracket) {
        p_advance()
        let names = []
        while !p_at(TokenKind::RBracket) && !p_at_eof() {
            names.push(make_var(p_expect_ident(), p_current_span()))
            if p_at(TokenKind::Comma) { p_advance() }
        }
        p_expect(TokenKind::RBracket)
        return expr_new(ExprKind::ELiteral(Literal::ArrayLit(names)), p_current_span())
    }
    // Destructured: (a, b)
    if p_at(TokenKind::LParen) {
        p_advance()
        let names = []
        while !p_at(TokenKind::RParen) && !p_at_eof() {
            names.push(make_var(p_expect_ident(), p_current_span()))
            if p_at(TokenKind::Comma) { p_advance() }
        }
        p_expect(TokenKind::RParen)
        return expr_new(ExprKind::ETupleLiteral(names), p_current_span())
    }
    // Simple variable
    make_var(p_expect_ident(), p_current_span())
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Paren/Lambda Parser ────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func parse_paren_or_lambda_full() {
    const span = p_current_span()
    p_expect(TokenKind::LParen)

    // Empty parens: () or () =>
    if p_at(TokenKind::RParen) {
        p_advance()
        if p_at(TokenKind::FatArrow) {
            p_advance()
            let body = null
            if p_at(TokenKind::LBrace) {
                body = parse_block()
            } else {
                const body_expr = parse_expression_pratt(0)
                body = block_new([], body_expr, span)
            }
            return make_lambda([], body, span)
        }
        // Unit value (empty tuple)
        return expr_new(ExprKind::ETupleLiteral([]), span)
    }

    // Lookahead for lambda: (params) => body
    let is_lambda = false
    let look_pos = p_pos
    let depth = 1
    while look_pos < len(p_tokens) && depth > 0 {
        const look_tok = p_tokens[look_pos]
        if look_tok.kind == TokenKind::LParen { depth = depth + 1 }
        if look_tok.kind == TokenKind::RParen { depth = depth - 1 }
        if depth == 0 {
            if look_pos + 1 < len(p_tokens) && p_tokens[look_pos + 1].kind == TokenKind::FatArrow {
                is_lambda = true
            }
        }
        look_pos = look_pos + 1
    }

    if is_lambda {
        let params = []
        while !p_at(TokenKind::RParen) && !p_at_eof() {
            const pspan = p_current_span()
            let is_rest = false
            if p_at(TokenKind::DotDotDot) {
                p_advance()
                is_rest = true
            }
            const pname = p_expect_ident()
            let fp = param_new(pname, pspan)
            if p_at(TokenKind::Colon) {
                p_advance()
                fp.type_ann = to_string(parse_type_annotation())
            }
            if p_at(TokenKind::Eq) {
                p_advance()
                fp.default_val = parse_expression_pratt(0)
            }
            fp.rest = is_rest
            params.push(fp)
            if p_at(TokenKind::Comma) { p_advance() }
        }
        p_expect(TokenKind::RParen)
        p_expect(TokenKind::FatArrow)

        let body = null
        if p_at(TokenKind::LBrace) {
            body = parse_block()
        } else {
            const body_expr = parse_expression_pratt(0)
            body = block_new([], body_expr, span)
        }
        return make_lambda(params, body, span)
    }

    // Regular parenthesized expression or tuple
    const first = parse_expression_pratt(0)

    // Tuple literal: (a, b, c)
    if p_at(TokenKind::Comma) {
        let elements = [first]
        while p_at(TokenKind::Comma) {
            p_advance()
            if p_at(TokenKind::RParen) { break }
            elements.push(parse_expression_pratt(0))
        }
        p_expect(TokenKind::RParen)
        return expr_new(ExprKind::ETupleLiteral(elements), span)
    }

    p_expect(TokenKind::RParen)
    first
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Match Pattern Parser ───────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Parse a full match pattern with nested patterns, binding, guards, or-patterns.
func parse_full_pattern() {
    let pat = parse_single_pattern()

    // Or-patterns: pattern1 | pattern2 | ...
    if p_at(TokenKind::Bar) {
        let alternatives = [pat]
        while p_at(TokenKind::Bar) {
            p_advance()
            alternatives.push(parse_single_pattern())
        }
        pat = Pattern::POr(alternatives)
    }

    // Guard: pattern if condition
    if p_at_keyword("if") {
        p_advance()
        const guard = parse_expression_pratt(0)
        pat = {"kind": "guard", "inner": pat, "guard": guard}
    }

    // Binding: pattern @ name
    if p_at(TokenKind::At) {
        p_advance()
        const binding_name = p_expect_ident()
        pat = Pattern::PBinding(binding_name, pat)
    }

    pat
}

func parse_single_pattern() {
    const tok = p_peek()
    const kind = tok.kind

    // Wildcard: _
    if kind == TokenKind::Underscore {
        p_advance()
        return Pattern::PWildcard
    }

    // Boolean literals
    if kind == TokenKind::True { p_advance(); return Pattern::PLiteral(make_bool_lit(true, p_current_span())) }
    if kind == TokenKind::False { p_advance(); return Pattern::PLiteral(make_bool_lit(false, p_current_span())) }
    if kind == TokenKind::Null { p_advance(); return Pattern::PLiteral(make_null_lit(p_current_span())) }

    // Numeric literals
    if kind == TokenKind::IntLit {
        p_advance()
        const value = parse_int(tok.text)
        const lit = make_int_lit(value, p_current_span())
        // Range pattern: 1..10 or 1..=10
        if p_at(TokenKind::DotDot) {
            p_advance()
            const hi_tok = p_peek()
            if hi_tok.kind == TokenKind::IntLit {
                p_advance()
                return Pattern::PRange(Pattern::PLiteral(lit), Pattern::PLiteral(make_int_lit(parse_int(hi_tok.text), p_current_span())), false)
            }
        }
        if p_at(TokenKind::DotDotEq) {
            p_advance()
            const hi_tok = p_peek()
            if hi_tok.kind == TokenKind::IntLit {
                p_advance()
                return Pattern::PRange(Pattern::PLiteral(lit), Pattern::PLiteral(make_int_lit(parse_int(hi_tok.text), p_current_span())), true)
            }
        }
        return Pattern::PLiteral(lit)
    }
    if kind == TokenKind::FloatLit {
        p_advance()
        return Pattern::PLiteral(make_float_lit(parse_float(tok.text), p_current_span()))
    }

    // String literal
    if kind == TokenKind::StringLit {
        p_advance()
        const lit = make_str_lit(tok.text, p_current_span())
        // Range pattern for strings
        if p_at(TokenKind::DotDot) {
            p_advance()
            const hi_tok = p_peek()
            if hi_tok.kind == TokenKind::StringLit {
                p_advance()
                return Pattern::PRange(Pattern::PLiteral(lit), Pattern::PLiteral(make_str_lit(hi_tok.text, p_current_span())), false)
            }
        }
        return Pattern::PLiteral(lit)
    }

    // Negative numeric literal
    if kind == TokenKind::Minus {
        p_advance()
        const num_tok = p_peek()
        if num_tok.kind == TokenKind::IntLit {
            p_advance()
            return Pattern::PLiteral(make_int_lit(0 - parse_int(num_tok.text), p_current_span()))
        }
        if num_tok.kind == TokenKind::FloatLit {
            p_advance()
            return Pattern::PLiteral(make_float_lit(0.0 - parse_float(num_tok.text), p_current_span()))
        }
        panic("expected number after - in pattern")
    }

    // Array pattern
    if kind == TokenKind::LBracket {
        p_advance()
        let pats = []
        while !p_at(TokenKind::RBracket) && !p_at_eof() {
            if p_at(TokenKind::DotDotDot) {
                p_advance()
                let rest_name = "_"
                if p_at(TokenKind::Ident) { rest_name = p_advance().text }
                pats.push(Pattern::PRest(rest_name))
            } else {
                pats.push(parse_full_pattern())
            }
            if p_at(TokenKind::Comma) { p_advance() }
        }
        p_expect(TokenKind::RBracket)
        return Pattern::PArray(pats)
    }

    // Tuple pattern
    if kind == TokenKind::LParen {
        p_advance()
        let pats = []
        while !p_at(TokenKind::RParen) && !p_at_eof() {
            pats.push(parse_full_pattern())
            if p_at(TokenKind::Comma) { p_advance() }
        }
        p_expect(TokenKind::RParen)
        return Pattern::PTuple(pats)
    }

    // Map pattern
    if kind == TokenKind::LBrace {
        p_advance()
        let entries = []
        while !p_at(TokenKind::RBrace) && !p_at_eof() {
            if p_at(TokenKind::DotDotDot) {
                p_advance()
                entries.push(Pattern::PRest("_"))
            } else {
                const key = p_expect_ident()
                let value_pat = Pattern::PVariable(key)
                if p_at(TokenKind::Colon) {
                    p_advance()
                    value_pat = parse_full_pattern()
                }
                entries.push({"key": key, "pattern": value_pat})
            }
            if p_at(TokenKind::Comma) { p_advance() }
        }
        p_expect(TokenKind::RBrace)
        return Pattern::PMap(entries)
    }

    // Rest pattern
    if kind == TokenKind::DotDotDot {
        p_advance()
        let rest_name = "_"
        if p_at(TokenKind::Ident) { rest_name = p_advance().text }
        return Pattern::PRest(rest_name)
    }

    // Identifier: variable, enum variant, type, struct
    if kind == TokenKind::Ident {
        p_advance()
        const name = tok.text

        // Enum pattern: Name::Variant(bindings)
        if p_at(TokenKind::ColonColon) {
            p_advance()
            const variant = p_expect_ident()
            let bindings = []
            if p_at(TokenKind::LParen) {
                p_advance()
                while !p_at(TokenKind::RParen) && !p_at_eof() {
                    bindings.push(parse_full_pattern())
                    if p_at(TokenKind::Comma) { p_advance() }
                }
                p_expect(TokenKind::RParen)
            }
            return Pattern::PEnum(name, variant, bindings)
        }

        // Struct pattern: Name { field: pat, ... }
        if p_at(TokenKind::LBrace) && len(name) > 0 && name[0] >= "A" && name[0] <= "Z" {
            p_advance()
            let fields = []
            while !p_at(TokenKind::RBrace) && !p_at_eof() {
                if p_at(TokenKind::DotDotDot) {
                    p_advance()
                    fields.push({"kind": "rest"})
                } else {
                    const fname = p_expect_ident()
                    let fpat = Pattern::PVariable(fname)
                    if p_at(TokenKind::Colon) {
                        p_advance()
                        fpat = parse_full_pattern()
                    }
                    fields.push({"field": fname, "pattern": fpat})
                }
                if p_at(TokenKind::Comma) { p_advance() }
            }
            p_expect(TokenKind::RBrace)
            return Pattern::PStruct(name, fields)
        }

        // Type pattern: name: Type
        if p_at(TokenKind::Colon) {
            p_advance()
            const type_name = p_expect_ident()
            return Pattern::PType(name, type_name)
        }

        return Pattern::PVariable(name)
    }

    Pattern::PWildcard
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Match Arm Parser ───────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func parse_match_arm_full() {
    const span = p_current_span()
    const pattern = parse_full_pattern()

    // Optional guard: if cond
    let guard = null
    if p_at_keyword("if") {
        p_advance()
        guard = parse_expression_pratt(0)
    }

    p_expect(TokenKind::FatArrow)

    let body = null
    if p_at(TokenKind::LBrace) {
        const blk = parse_block()
        body = expr_new(ExprKind::EBlock(blk), span)
    } else {
        body = parse_expression_pratt(0)
    }

    let arm = match_arm_new(pattern, body, span)
    arm.guard = guard
    arm
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Error Recovery Parser ──────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Statement boundary tokens for error recovery.
const SYNC_TOKENS = [
    TokenKind::Func, TokenKind::Let, TokenKind::Const,
    TokenKind::If, TokenKind::While, TokenKind::For,
    TokenKind::Return, TokenKind::Match, TokenKind::Enum,
    TokenKind::Struct, TokenKind::Trait, TokenKind::Impl,
    TokenKind::Import, TokenKind::Break, TokenKind::Continue,
    TokenKind::Test, TokenKind::Async, TokenKind::Try,
    TokenKind::Throw, TokenKind::Defer, TokenKind::Type,
    TokenKind::Do, TokenKind::Loop, TokenKind::Select,
    TokenKind::Interface, TokenKind::Output
]

// Skip tokens until we hit a statement boundary.
func p_synchronize_full() {
    // Skip past the problematic token
    p_advance()
    while !p_at_eof() {
        // After a semicolon or closing brace, we're at a boundary
        const prev = p_tokens[p_pos - 1]
        if prev.kind == TokenKind::Semicolon || prev.kind == TokenKind::RBrace {
            return null
        }
        // If current token starts a new statement, stop
        const current = p_peek_kind()
        for sync_tok in SYNC_TOKENS {
            if current == sync_tok { return null }
        }
        p_advance()
    }
}

// Parse a full program with error recovery.
func parse_program_recovering() {
    const span = p_current_span()
    let stmts = []
    let errors = []

    while !p_at_eof() {
        p_skip_semis()
        if p_at_eof() { break }

        // Try to parse a statement
        let success = true
        let stmt = null
        // In MAGI we use try/catch for error recovery
        try {
            stmt = parse_statement()
        } catch e {
            errors.push(to_string(e))
            p_synchronize_full()
            success = false
        }

        if success && stmt != null {
            stmts.push(stmt)
        }
        p_skip_semis()
    }

    const program = program_new(stmts, span)
    {"program": program, "errors": errors}
}

// ══════════════════════════════════════════════════════════════════════
// ── Async/Spawn/Await/Select/Defer Parsing ──────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Parse select expression: select { pattern => body, ... }
func parse_select_expr() {
    const span = p_current_span()
    p_expect(TokenKind::Select)
    p_expect(TokenKind::LBrace)
    let arms = []
    while !p_at(TokenKind::RBrace) && !p_at_eof() {
        const arm = parse_match_arm_full()
        arms.push(arm)
        if p_at(TokenKind::Comma) { p_advance() }
        p_skip_semis()
    }
    p_expect(TokenKind::RBrace)
    // Model select as match on null (channels resolved at runtime)
    expr_new(ExprKind::EMatch(make_null_lit(span), arms), span)
}

// Parse defer statement with block or expression.
func parse_defer_full() {
    const span = p_current_span()
    p_expect(TokenKind::Defer)
    let expr = null
    if p_at(TokenKind::LBrace) {
        const blk = parse_block()
        expr = expr_new(ExprKind::EBlock(blk), span)
    } else {
        expr = parse_expression_pratt(0)
    }
    stmt_new(StmtKind::SDefer(expr), span)
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Union Type Parsing ─────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Parse union types: A | B | C
func parse_union_type() {
    let base = parse_type_annotation()
    if p_at(TokenKind::Bar) {
        let alternatives = [base]
        while p_at(TokenKind::Bar) {
            p_advance()
            alternatives.push(parse_type_annotation())
        }
        return {"kind": "union", "types": alternatives}
    }
    base
}

// Parse map type: Map<K, V> or {string: int}
func parse_map_type() {
    if p_at(TokenKind::LBrace) {
        p_advance()
        const key_type = parse_type_annotation()
        p_expect(TokenKind::Colon)
        const value_type = parse_type_annotation()
        p_expect(TokenKind::RBrace)
        return {"kind": "map", "key": key_type, "value": value_type}
    }
    parse_type_annotation()
}

// ══════════════════════════════════════════════════════════════════════
// ── Complete Statement Parser with All Statement Kinds ──────────────
// ══════════════════════════════════════════════════════════════════════

// Parse use statement: use path::to::module or use path::to::* or use path as alias
func parse_use_stmt() {
    const span = p_current_span()
    p_expect(TokenKind::Ident) // 'use' is a soft keyword
    let path = [p_expect_ident()]
    while p_at(TokenKind::ColonColon) {
        p_advance()
        if p_at(TokenKind::Star) {
            p_advance()
            return stmt_new(StmtKind::SUse(path, "", true, false), span)
        }
        if p_at(TokenKind::LBrace) {
            // Multi-use: use path::{A, B, C}
            p_advance()
            let names = []
            while !p_at(TokenKind::RBrace) && !p_at_eof() {
                names.push(p_expect_ident())
                if p_at(TokenKind::Comma) { p_advance() }
            }
            p_expect(TokenKind::RBrace)
            // Emit multiple use statements
            return stmt_new(StmtKind::SUse(path, "", false, false), span)
        }
        path.push(p_expect_ident())
    }
    let alias = ""
    if p_at(TokenKind::As) {
        p_advance()
        alias = p_expect_ident()
    }
    stmt_new(StmtKind::SUse(path, alias, false, false), span)
}

// Parse module definition: mod name { body }
func parse_mod_stmt() {
    const span = p_current_span()
    p_expect(TokenKind::Ident) // 'mod'
    const name = p_expect_ident()
    const body = parse_block()
    stmt_new(StmtKind::SModDef(name, body), span)
}

// Parse static definition: static name: Type = value
func parse_static_stmt() {
    const span = p_current_span()
    p_expect(TokenKind::Ident) // 'static'
    let mutable = false
    if p_at_keyword("mut") {
        p_advance()
        mutable = true
    }
    const name = p_expect_ident()
    let type_ann = ""
    if p_at(TokenKind::Colon) {
        p_advance()
        type_ann = to_string(parse_type_annotation())
    }
    p_expect(TokenKind::Eq)
    const value = parse_expression_pratt(0)
    stmt_new(StmtKind::SStaticDef(name, type_ann, value, mutable), span)
}

// Parse unsafe block: unsafe { body }
func parse_unsafe_stmt() {
    const span = p_current_span()
    p_expect(TokenKind::Ident) // 'unsafe'
    const body = parse_block()
    const block_expr = expr_new(ExprKind::EBlock(body), span)
    make_expr_stmt(block_expr, span)
}

// Parse inline assembly: asm { ... }
func parse_asm_stmt() {
    const span = p_current_span()
    p_expect(TokenKind::Ident) // 'asm'
    p_expect(TokenKind::LBrace)
    let instructions = []
    while !p_at(TokenKind::RBrace) && !p_at_eof() {
        if p_at(TokenKind::StringLit) {
            instructions.push(p_advance().text)
        } else {
            p_advance() // skip non-string tokens
        }
        if p_at(TokenKind::Comma) || p_at(TokenKind::Semicolon) { p_advance() }
    }
    p_expect(TokenKind::RBrace)
    const asm_expr = expr_new(ExprKind::ELiteral(Literal::StringLit(instructions.join("\n"))), span)
    make_expr_stmt(asm_expr, span)
}

// ══════════════════════════════════════════════════════════════════════
// ── Trait Definition Parsing ────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Parse trait/interface with supertraits and default method bodies.
func parse_trait_def_full() {
    const span = p_current_span()
    const keyword = p_advance().text // 'trait' or 'interface'
    const name = p_expect_ident()

    // Optional supertraits: trait Name: Super1 + Super2
    let supertraits = []
    if p_at(TokenKind::Colon) {
        p_advance()
        supertraits.push(p_expect_ident())
        while p_at(TokenKind::Plus) {
            p_advance()
            supertraits.push(p_expect_ident())
        }
    }

    p_expect(TokenKind::LBrace)
    let methods = []
    while !p_at(TokenKind::RBrace) && !p_at_eof() {
        p_skip_semis()
        if p_at(TokenKind::RBrace) { break }

        p_expect(TokenKind::Func)
        const mname = p_expect_ident()
        const mparams = parse_func_params()
        const mspan = p_current_span()

        // Optional default body
        let mbody = null
        if p_at(TokenKind::LBrace) {
            mbody = parse_block()
        } else {
            mbody = block_empty(mspan)
        }

        methods.push(funcdef_new(mname, mparams, mbody, mspan))
        p_skip_semis()
    }
    p_expect(TokenKind::RBrace)
    stmt_new(StmtKind::SInterfaceDef(name, supertraits, methods), span)
}

// ══════════════════════════════════════════════════════════════════════
// ── C-Style For Loop Parsing ────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Parse: for (init; cond; update) { body }
func parse_cstyle_for(span) {
    p_expect(TokenKind::LParen)
    const init = parse_statement()
    p_expect(TokenKind::Semicolon)
    const cond = parse_expression_pratt(0)
    p_expect(TokenKind::Semicolon)
    const update = parse_statement()
    p_expect(TokenKind::RParen)
    const body = parse_block()
    stmt_new(StmtKind::SCStyleFor(init, cond, update, body), span)
}

// ══════════════════════════════════════════════════════════════════════
// ── Map Comprehension Parsing ───────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Parse: {key: value for pattern in iterable if condition}
func parse_map_comprehension(key_expr, span) {
    p_expect(TokenKind::Colon)
    const value_expr = parse_expression_pratt(0)
    p_expect(TokenKind::For)
    const pattern = parse_comprehension_pattern_full()
    p_expect(TokenKind::In)
    const iterable = parse_expression_pratt(0)
    let condition = null
    if p_at(TokenKind::If) {
        p_advance()
        condition = parse_expression_pratt(0)
    }
    p_expect(TokenKind::RBrace)
    expr_new(ExprKind::EMapComp(key_expr, value_expr, pattern, iterable, condition), span)
}

// ══════════════════════════════════════════════════════════════════════
// ── Multiple Return Value Parsing ───────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Parse multiple return: let a, b = func()
func parse_multi_return_let(span, mutable) {
    let names = []
    names.push(p_expect_ident())
    while p_at(TokenKind::Comma) {
        p_advance()
        names.push(p_expect_ident())
    }
    p_expect(TokenKind::Eq)
    const value = parse_expression_pratt(0)
    // Convert to tuple destructuring
    let elems = []
    for name in names {
        elems.push(DestructureElement::DName(name))
    }
    stmt_new(StmtKind::SLetDestructure(DestructurePattern::DTuple(elems), mutable, value), span)
}

// ══════════════════════════════════════════════════════════════════════
// ── Increment/Decrement Statement Parsing ───────────────────────────
// ══════════════════════════════════════════════════════════════════════

func parse_increment_stmt(name, span) {
    // name++ already consumed name, peek at ++
    p_advance() // skip ++
    stmt_new(StmtKind::SCompoundAssign(name, BinOp::Add, make_int_lit(1, span)), span)
}

func parse_decrement_stmt(name, span) {
    p_advance() // skip --
    stmt_new(StmtKind::SCompoundAssign(name, BinOp::Sub, make_int_lit(1, span)), span)
}

// ══════════════════════════════════════════════════════════════════════
// ── Pub Modifier Parsing ────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func parse_pub_stmt() {
    const span = p_current_span()
    p_advance() // skip 'pub'

    // Accept pub(crate) / pub(super) syntax
    if p_at(TokenKind::LParen) {
        p_advance()
        p_advance() // skip crate/super
        p_expect(TokenKind::RParen)
    }

    // Parse the inner definition
    const kind = p_peek_kind()
    if kind == TokenKind::Func { return parse_func_stmt() }
    if kind == TokenKind::Async { return parse_async_func_stmt() }
    if kind == TokenKind::Enum { return parse_enum_stmt() }
    if kind == TokenKind::Struct { return parse_struct_stmt() }
    if kind == TokenKind::Const { return parse_const_stmt() }
    if kind == TokenKind::Type { return parse_type_alias_stmt() }
    if kind == TokenKind::Interface { return parse_interface_stmt() }
    if kind == TokenKind::Impl { return parse_impl_stmt() }

    panic(f"'pub' can only be applied to fn, enum, struct, const, type, interface, or impl at line {span.start_line}")
}

// ══════════════════════════════════════════════════════════════════════
// ── String Template Literal Parsing ─────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Parse raw string literal: r"..."
func parse_raw_string() {
    const span = p_current_span()
    const tok = p_advance()
    // Raw string: no escape processing
    make_str_lit(tok.text, span)
}

// Parse multi-line string literal: """..."""
func parse_multiline_string() {
    const span = p_current_span()
    const tok = p_advance()
    make_str_lit(tok.text, span)
}

// ══════════════════════════════════════════════════════════════════════
// ── Expression List Parsing (for tuples, args, etc.) ────────────────
// ══════════════════════════════════════════════════════════════════════

func parse_expression_list(terminator) {
    let exprs = []
    while !p_at(terminator) && !p_at_eof() {
        exprs.push(parse_expression_pratt(0))
        if p_at(TokenKind::Comma) { p_advance() }
    }
    exprs
}

func parse_expression_list_with_spread(terminator) {
    let exprs = []
    while !p_at(terminator) && !p_at_eof() {
        if p_at(TokenKind::DotDotDot) {
            p_advance()
            const inner = parse_expression_pratt(0)
            exprs.push(expr_new(ExprKind::ESpread(inner), inner.span))
        } else {
            exprs.push(parse_expression_pratt(0))
        }
        if p_at(TokenKind::Comma) { p_advance() }
    }
    exprs
}

// ══════════════════════════════════════════════════════════════════════
// ── Pattern Guard Parsing ───────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Parse match arm with guard: pattern if condition => body
func parse_guarded_match_arm() {
    const span = p_current_span()
    const pattern = parse_full_pattern()

    let guard = null
    if p_at_keyword("if") {
        p_advance()
        guard = parse_expression_pratt(0)
    }

    p_expect(TokenKind::FatArrow)

    let body = null
    if p_at(TokenKind::LBrace) {
        const blk = parse_block()
        body = expr_new(ExprKind::EBlock(blk), span)
    } else {
        body = parse_expression_pratt(0)
    }

    {"pattern": pattern, "guard": guard, "body": body, "span": span}
}

// ══════════════════════════════════════════════════════════════════════
// ── Range Expression Parsing ────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Parse range: start..end or start..=end
func parse_range_expr(start) {
    const span = start.span

    // Exclusive range: ..
    if p_at(TokenKind::DotDot) {
        p_advance()
        const end_expr = parse_expression_pratt(PREC_RANGE + 1)
        return expr_new(ExprKind::ERange(start, end_expr, false), span)
    }

    // Inclusive range: ..=
    if p_at(TokenKind::DotDotEq) {
        p_advance()
        const end_expr = parse_expression_pratt(PREC_RANGE + 1)
        return expr_new(ExprKind::ERange(start, end_expr, true), span)
    }

    start
}

// ══════════════════════════════════════════════════════════════════════
// ── Spread Operator in All Positions ────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Parse spread in function call: f(...args)
func parse_spread_arg() {
    const span = p_current_span()
    p_expect(TokenKind::DotDotDot)
    const inner = parse_expression_pratt(0)
    expr_new(ExprKind::ESpread(inner), span)
}

// Parse spread in array: [...a, ...b]
func parse_spread_element() {
    const span = p_current_span()
    p_expect(TokenKind::DotDotDot)
    const inner = parse_expression_pratt(0)
    expr_new(ExprKind::ESpread(inner), span)
}

// Parse spread in struct: MyStruct { ...base, field: value }
func parse_spread_field() {
    const span = p_current_span()
    p_expect(TokenKind::DotDotDot)
    const inner = parse_expression_pratt(0)
    ["__spread", inner]
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Nested Match Pattern with Range ────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Check if a pattern is irrefutable (always matches).
func pattern_is_irrefutable(pat) {
    match pat {
        Pattern::PWildcard => true,
        Pattern::PVariable(_) => true,
        Pattern::PArray(elems) => {
            for e in elems {
                if !pattern_is_irrefutable(e) { return false }
            }
            true
        },
        Pattern::PTuple(elems) => {
            for e in elems {
                if !pattern_is_irrefutable(e) { return false }
            }
            true
        },
        _ => false
    }
}

// Check if a pattern set is exhaustive for a given type.
func patterns_are_exhaustive(patterns, enum_defs) {
    for pat in patterns {
        match pat {
            Pattern::PWildcard => { return true },
            Pattern::PVariable(_) => { return true },
            _ => {}
        }
    }
    // Check if enum variants are fully covered
    let enum_name = ""
    let covered = {}
    for pat in patterns {
        match pat {
            Pattern::PEnum(en, variant, _) => {
                if enum_name == "" { enum_name = en }
                if en == enum_name { covered[variant] = true }
            },
            _ => {}
        }
    }
    if enum_name != "" {
        for edef in enum_defs {
            if edef[0] == enum_name {
                for v in edef[1] {
                    if !covered.has(v) { return false }
                }
                return true
            }
        }
    }
    false
}

// ══════════════════════════════════════════════════════════════════════
// ── Parser Utilities ────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Peek N tokens ahead (for complex lookahead).
func p_peek_at(offset) {
    const idx = p_pos + offset
    if idx < len(p_tokens) { p_tokens[idx] } else { Token { kind: TokenKind::Eof, text: "", line: 0, col: 0 } }
}

// Check if the next N tokens match a pattern.
func p_check_sequence(kinds) {
    let i = 0
    while i < len(kinds) {
        const tok = p_peek_at(i)
        if tok.kind != kinds[i] { return false }
        i = i + 1
    }
    true
}

// Save and restore parser position (for backtracking).
func p_save() { p_pos }
func p_restore(saved) { p_pos = saved }

// Count remaining tokens.
func p_remaining() { len(p_tokens) - p_pos }

// Get current token text.
func p_current_text() { p_peek().text }

// Get current token line.
func p_current_line() { p_peek().line }

// Check if at end of block (RBrace or EOF).
func p_at_block_end() { p_at(TokenKind::RBrace) || p_at_eof() }

// Skip optional semicolons and newlines.
func p_skip_terminators() {
    while p_at(TokenKind::Semicolon) || p_at(TokenKind::Newline) {
        p_advance()
    }
}

// Expect one of several token kinds.
func p_expect_one_of(kinds) {
    for kind in kinds {
        if p_at(kind) { return p_advance() }
    }
    const tok = p_peek()
    const expected = kinds.map(k => to_string(k)).join(", ")
    panic(f"expected one of [{expected}] but got '{tok.text}' at {tok.line}:{tok.col}")
}

// ══════════════════════════════════════════════════════════════════════
// ── AST Validation Helpers ──────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Validate that a parsed program has no obvious structural issues.
func validate_program(program) {
    let errors = []
    for stmt in program.statements {
        validate_stmt(stmt, errors)
    }
    errors
}

func validate_stmt(stmt, errors) {
    const sk = stmt.kind
    match sk {
        StmtKind::SFuncDef(fd) => {
            // Check for duplicate parameter names
            let param_names = {}
            for p in fd.params {
                if param_names.has(p.name) {
                    errors.push(f"duplicate parameter '{p.name}' in function '{fd.name}' at line {stmt.span.start_line}")
                }
                param_names[p.name] = true
            }
            // Validate body
            if fd.body != null {
                for s in fd.body.stmts { validate_stmt(s, errors) }
            }
        },
        StmtKind::SEnumDef(name, variants, _) => {
            // Check for duplicate variant names
            let variant_names = {}
            for v in variants {
                if variant_names.has(v.name) {
                    errors.push(f"duplicate variant '{v.name}' in enum '{name}' at line {stmt.span.start_line}")
                }
                variant_names[v.name] = true
            }
        },
        StmtKind::SStructDef(name, fields, _) => {
            // Check for duplicate field names
            let field_names = {}
            for f in fields {
                if field_names.has(f.name) {
                    errors.push(f"duplicate field '{f.name}' in struct '{name}' at line {stmt.span.start_line}")
                }
                field_names[f.name] = true
            }
        },
        StmtKind::SForLoop(_, _, _, body) => {
            if body != null { for s in body.stmts { validate_stmt(s, errors) } }
        },
        StmtKind::SWhileLoop(_, _, body) => {
            if body != null { for s in body.stmts { validate_stmt(s, errors) } }
        },
        StmtKind::SIf(_, then_b, else_b) => {
            if then_b != null { for s in then_b.stmts { validate_stmt(s, errors) } }
            if else_b != null { for s in else_b.stmts { validate_stmt(s, errors) } }
        },
        _ => {}
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── AST Pretty-Print (Debug) ────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Pretty-print an AST node for debugging.
func ast_debug_expr(expr, depth) {
    if expr == null { return "null" }
    const ind = "  ".repeat(depth)
    const ek = expr.kind
    match ek {
        ExprKind::ELiteral(lit) => ind + "Literal(" + to_string(lit) + ")",
        ExprKind::EVariable(name) => ind + "Var(" + name + ")",
        ExprKind::EBinaryOp(op, left, right) => {
            ind + "BinOp(" + op.symbol() + ")\n" + ast_debug_expr(left, depth + 1) + "\n" + ast_debug_expr(right, depth + 1)
        },
        ExprKind::EUnaryOp(op, operand) => {
            ind + "UnaryOp(" + op.symbol() + ")\n" + ast_debug_expr(operand, depth + 1)
        },
        ExprKind::ECall(name, args, _) => {
            let s = ind + "Call(" + name + ")\n"
            for a in args { s = s + ast_debug_expr(a, depth + 1) + "\n" }
            s
        },
        ExprKind::EIfElse(cond, then_b, else_b) => {
            let s = ind + "IfElse\n"
            s = s + ind + "  cond: " + ast_debug_expr(cond, depth + 1) + "\n"
            s = s + ind + "  then: <block>\n"
            if else_b != null { s = s + ind + "  else: <block>\n" }
            s
        },
        ExprKind::EMatch(subject, arms) => {
            let s = ind + "Match\n"
            s = s + ind + "  subject: " + ast_debug_expr(subject, depth + 1) + "\n"
            s = s + ind + f"  arms: {len(arms)}\n"
            s
        },
        _ => ind + "<expr>"
    }
}

func ast_debug_stmt(stmt, depth) {
    const ind = "  ".repeat(depth)
    const sk = stmt.kind
    match sk {
        StmtKind::SLet(name, _) => ind + "Let(" + name + ")",
        StmtKind::SLetMut(name, _) => ind + "LetMut(" + name + ")",
        StmtKind::SConst(name, _) => ind + "Const(" + name + ")",
        StmtKind::SFuncDef(fd) => ind + "FuncDef(" + fd.name + ")",
        StmtKind::SEnumDef(name, _, _) => ind + "EnumDef(" + name + ")",
        StmtKind::SStructDef(name, _, _) => ind + "StructDef(" + name + ")",
        StmtKind::SReturn(_) => ind + "Return",
        StmtKind::SBreak(_, _) => ind + "Break",
        StmtKind::SContinue(_) => ind + "Continue",
        StmtKind::SExprStmt(_) => ind + "ExprStmt",
        StmtKind::SOutput(_) => ind + "Output",
        _ => ind + "<stmt>"
    }
}

func ast_debug_program(program) {
    let lines = []
    for stmt in program.statements {
        lines.push(ast_debug_stmt(stmt, 0))
    }
    lines.join("\n")
}

// ══════════════════════════════════════════════════════════════════════
// ── Error Recovery with Synchronization Points ──────────────────────
// ══════════════════════════════════════════════════════════════════════

let p_errors = []
let p_recovering = false

func p_error(msg) {
    const tok = p_peek()
    const err = {
        "message": msg,
        "line": tok.line,
        "col": tok.col,
        "token": tok.text,
    }
    p_errors.push(err)
    p_recovering = true
}

// Synchronization points: statement boundaries
func p_synchronize() {
    p_recovering = false
    while !p_at_eof() {
        const kind = p_peek_kind()
        // Stop at statement-starting tokens
        if kind == TokenKind::Semicolon {
            p_advance()
            return null
        }
        // Check for tokens that begin a new statement
        const text = p_peek().text
        if text == "func" || text == "let" || text == "const" || text == "if" ||
           text == "for" || text == "while" || text == "loop" || text == "match" ||
           text == "return" || text == "break" || text == "continue" ||
           text == "import" || text == "use" || text == "struct" || text == "enum" ||
           text == "interface" || text == "test" || text == "try" || text == "throw" ||
           text == "async" || text == "spawn" || text == "pub" || text == "type" {
            return null
        }
        // Check for closing delimiters (might be end of block)
        if kind == TokenKind::RBrace || kind == TokenKind::RParen || kind == TokenKind::RBracket {
            return null
        }
        p_advance()
    }
}

// Error-recovering parse: collects errors instead of panicking
func parse_recovering(source) {
    const save_tokens = p_tokens
    const save_pos = p_pos
    const save_errors = p_errors
    const save_recovering = p_recovering

    p_tokens = tokenize(source)
    p_pos = 0
    p_errors = []
    p_recovering = false

    let stmts = []
    const span = p_current_span()

    while !p_at_eof() {
        p_skip_semis()
        if p_at_eof() { break }
        const result = parse_statement_safe()
        if result != null {
            stmts.push(result)
        }
        p_skip_semis()
    }

    const program = program_new(stmts, span)
    const errors = p_errors

    p_tokens = save_tokens
    p_pos = save_pos
    p_errors = save_errors
    p_recovering = save_recovering

    {"program": program, "errors": errors}
}

func parse_statement_safe() {
    // Try to parse a statement; on error, synchronize
    const kind = p_peek_kind()
    const text = p_peek().text

    // If we're in recovery mode and hit a sync point, recover
    if p_recovering {
        p_synchronize()
        if p_at_eof() { return null }
    }

    // Attempt parse with error catching
    const start_pos = p_pos
    const result = try_parse_statement()
    if result != null {
        return result
    }

    // Parse failed: emit error and synchronize
    if p_pos == start_pos {
        // Didn't advance — force advance to avoid infinite loop
        const tok = p_advance()
        p_error(f"unexpected token '{tok.text}'")
    }
    p_synchronize()
    null
}

func try_parse_statement() {
    // Delegates to parse_statement but catches panics
    // In the self-hosted compiler, we can't truly catch panics,
    // so we check for known valid statement starters
    const kind = p_peek_kind()
    const text = p_peek().text

    if kind == TokenKind::Eof { return null }

    if text == "func" || text == "let" || text == "const" || text == "if" ||
       text == "for" || text == "while" || text == "loop" || text == "match" ||
       text == "return" || text == "break" || text == "continue" ||
       text == "import" || text == "use" || text == "struct" || text == "enum" ||
       text == "interface" || text == "test" || text == "try" || text == "throw" ||
       text == "async" || text == "spawn" || text == "pub" || text == "type" ||
       text == "output" || text == "do" {
        return parse_statement()
    }

    // Try as expression statement
    if kind == TokenKind::Ident || kind == TokenKind::IntLit || kind == TokenKind::FloatLit ||
       kind == TokenKind::StringLit || kind == TokenKind::LParen || kind == TokenKind::LBracket ||
       kind == TokenKind::LBrace || text == "!" || text == "-" || text == "true" ||
       text == "false" || text == "null" {
        return parse_statement()
    }

    null
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Type Annotation Parser for All Type Forms ──────────────────
// ══════════════════════════════════════════════════════════════════════

// Parse a full type annotation: T, [T], {K: V}, (T, T) -> R, T?, T | U
func parse_type_annotation() {
    let ty = parse_type_primary()

    // Handle postfix type operators
    while !p_at_eof() {
        if p_at(TokenKind::Question) {
            p_advance()
            ty = type_optional(ty)
        } else if p_at(TokenKind::Pipe) {
            p_advance()
            const right = parse_type_primary()
            ty = type_union(ty, right)
        } else if p_at(TokenKind::Ampersand) {
            p_advance()
            const right = parse_type_primary()
            ty = type_intersection(ty, right)
        } else {
            break
        }
    }

    // Check for function type: (T, U) -> R
    if p_peek().text == "->" {
        p_advance()
        const return_type = parse_type_annotation()
        ty = type_function(ty, return_type)
    }

    ty
}

func parse_type_primary() {
    const kind = p_peek_kind()
    const text = p_peek().text

    // Parenthesized type or tuple type
    if kind == TokenKind::LParen {
        p_advance()
        if p_at(TokenKind::RParen) {
            p_advance()
            return type_unit()
        }
        let types = [parse_type_annotation()]
        while p_at(TokenKind::Comma) {
            p_advance()
            types.push(parse_type_annotation())
        }
        p_expect(TokenKind::RParen)
        if len(types) == 1 {
            return types[0]  // Just parenthesized
        }
        return type_tuple(types)
    }

    // Array type: [T]
    if kind == TokenKind::LBracket {
        p_advance()
        const elem_type = parse_type_annotation()
        p_expect(TokenKind::RBracket)
        return type_array(elem_type)
    }

    // Map type: {K: V}
    if kind == TokenKind::LBrace {
        p_advance()
        const key_type = parse_type_annotation()
        p_expect(TokenKind::Colon)
        const val_type = parse_type_annotation()
        p_expect(TokenKind::RBrace)
        return type_map(key_type, val_type)
    }

    // Named type with optional generic parameters
    if kind == TokenKind::Ident {
        const name = p_expect_ident()
        // Check for generic parameters: Name<T, U>
        if p_at(TokenKind::Lt) {
            p_advance()
            let type_args = [parse_type_annotation()]
            while p_at(TokenKind::Comma) {
                p_advance()
                type_args.push(parse_type_annotation())
            }
            p_expect(TokenKind::Gt)
            return type_generic(name, type_args)
        }
        // Check for qualified name: module.Type
        if p_at(TokenKind::Dot) {
            p_advance()
            const member = p_expect_ident()
            return type_qualified(name, member)
        }
        return type_named(name)
    }

    // Primitive types as keywords
    if text == "int" || text == "float" || text == "string" || text == "bool" || text == "null" || text == "any" || text == "void" || text == "never" {
        p_advance()
        return type_named(text)
    }

    p_error(f"expected type annotation, got '{text}'")
    type_named("any")  // Error recovery: return 'any'
}

// Type constructors
func type_named(name) { {"kind": "named", "name": name} }
func type_array(elem) { {"kind": "array", "element": elem} }
func type_map(key, val) { {"kind": "map", "key": key, "value": val} }
func type_tuple(types) { {"kind": "tuple", "types": types} }
func type_optional(inner) { {"kind": "optional", "inner": inner} }
func type_union(left, right) { {"kind": "union", "left": left, "right": right} }
func type_intersection(left, right) { {"kind": "intersection", "left": left, "right": right} }
func type_function(params, ret) { {"kind": "function", "params": params, "return": ret} }
func type_generic(name, args) { {"kind": "generic", "name": name, "args": args} }
func type_qualified(module, name) { {"kind": "qualified", "module": module, "name": name} }
func type_unit() { {"kind": "unit"} }

// Format a type annotation back to string
func type_to_string(ty) {
    if ty == null { return "any" }
    match ty["kind"] {
        "named" => ty["name"],
        "array" => "[" + type_to_string(ty["element"]) + "]",
        "map" => "{" + type_to_string(ty["key"]) + ": " + type_to_string(ty["value"]) + "}",
        "tuple" => "(" + ty["types"].map(t => type_to_string(t)).join(", ") + ")",
        "optional" => type_to_string(ty["inner"]) + "?",
        "union" => type_to_string(ty["left"]) + " | " + type_to_string(ty["right"]),
        "intersection" => type_to_string(ty["left"]) + " & " + type_to_string(ty["right"]),
        "function" => type_to_string(ty["params"]) + " -> " + type_to_string(ty["return"]),
        "generic" => ty["name"] + "<" + ty["args"].map(a => type_to_string(a)).join(", ") + ">",
        "qualified" => ty["module"] + "." + ty["name"],
        "unit" => "()",
        _ => "any",
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Generic Bounds with Where Clauses ──────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Parse generic parameters: <T, U: Comparable, V: Hash + Eq>
func parse_generic_params() {
    if !p_at(TokenKind::Lt) { return [] }
    p_advance()
    let params = []

    while !p_at(TokenKind::Gt) && !p_at_eof() {
        const name = p_expect_ident()
        let bounds = []

        // Check for bounds: T: Bound1 + Bound2
        if p_at(TokenKind::Colon) {
            p_advance()
            bounds.push(parse_type_annotation())
            while p_peek().text == "+" {
                p_advance()
                bounds.push(parse_type_annotation())
            }
        }

        params.push({"name": name, "bounds": bounds})

        if p_at(TokenKind::Comma) {
            p_advance()
        } else {
            break
        }
    }

    p_expect(TokenKind::Gt)
    params
}

// Parse where clause: where T: Hash + Eq, U: Display
func parse_where_clause() {
    if p_peek().text != "where" { return [] }
    p_advance()

    let constraints = []

    while !p_at_eof() {
        const type_name = p_expect_ident()
        p_expect(TokenKind::Colon)
        let bounds = [parse_type_annotation()]
        while p_peek().text == "+" {
            p_advance()
            bounds.push(parse_type_annotation())
        }
        constraints.push({"type": type_name, "bounds": bounds})

        if p_at(TokenKind::Comma) {
            p_advance()
        } else {
            break
        }
    }

    constraints
}

// ══════════════════════════════════════════════════════════════════════
// ── Async/Await Expression Parsing ──────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func parse_async_expr() {
    const span = p_current_span()
    p_advance()  // consume 'async'

    if p_peek().text == "func" {
        // async func definition
        return parse_async_func_def(span)
    }

    // async block: async { ... }
    if p_at(TokenKind::LBrace) {
        const body = parse_block()
        return expr_new(ExprKind::EAsync(body), span)
    }

    p_error("expected 'func' or '{' after 'async'")
    null
}

func parse_await_expr() {
    const span = p_current_span()
    p_advance()  // consume 'await'
    const operand = parse_unary()
    expr_new(ExprKind::EAwait(operand), span)
}

func parse_async_func_def(span) {
    p_advance()  // consume 'func'
    const name = p_expect_ident()
    const type_params = parse_generic_params()
    p_expect(TokenKind::LParen)
    const params = parse_param_list()
    p_expect(TokenKind::RParen)

    let ret_type = null
    if p_peek().text == "->" {
        p_advance()
        ret_type = parse_type_annotation()
    }

    const where_clause = parse_where_clause()
    const body = parse_block()

    const fd = FuncDef {
        name: name,
        type_params: type_params,
        params: params,
        return_type: ret_type,
        body: body,
        span: span,
        is_async: true,
        is_getter: false,
        is_setter: false,
        where_clause: where_clause,
    }
    stmt_new(StmtKind::SFuncDef(fd), span)
}

// ══════════════════════════════════════════════════════════════════════
// ── Select Statement Parsing ────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func parse_select_stmt() {
    const span = p_current_span()
    p_advance()  // consume 'select'
    p_expect(TokenKind::LBrace)

    let cases = []
    while !p_at(TokenKind::RBrace) && !p_at_eof() {
        const case_item = parse_select_case()
        cases.push(case_item)
        if p_at(TokenKind::Comma) { p_advance() }
    }
    p_expect(TokenKind::RBrace)

    expr_new(ExprKind::ESelect(cases), span)
}

func parse_select_case() {
    const span = p_current_span()
    const text = p_peek().text

    if text == "default" {
        p_advance()
        p_expect(TokenKind::FatArrow)
        const body = parse_expr_or_block()
        return {"kind": "default", "body": body, "span": span}
    }

    // Channel operation: ch <- val  or  val = <- ch
    const op = parse_expression()
    p_expect(TokenKind::FatArrow)
    const body = parse_expr_or_block()
    {"kind": "case", "operation": op, "body": body, "span": span}
}

func parse_expr_or_block() {
    if p_at(TokenKind::LBrace) {
        const block = parse_block()
        expr_new(ExprKind::EBlock(block), p_current_span())
    } else {
        parse_expression()
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Attribute Argument Parsing ─────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Parse: #[attr_name(arg1, arg2, key = value)]
func parse_attribute() {
    const span = p_current_span()
    p_advance()  // consume '#'
    p_expect(TokenKind::LBracket)

    const name = p_expect_ident()
    let args = []
    let kwargs = {"__s": true}

    if p_at(TokenKind::LParen) {
        p_advance()
        while !p_at(TokenKind::RParen) && !p_at_eof() {
            // Check for key = value
            if p_at(TokenKind::Ident) {
                const save = p_pos
                const maybe_key = p_advance()
                if p_at(TokenKind::Eq) {
                    p_advance()
                    const value = parse_expression()
                    kwargs[maybe_key.text] = value
                } else {
                    // Not a kwarg, rewind and parse as positional
                    p_pos = save
                    const val = parse_expression()
                    args.push(val)
                }
            } else {
                const val = parse_expression()
                args.push(val)
            }
            if p_at(TokenKind::Comma) { p_advance() }
        }
        p_expect(TokenKind::RParen)
    }

    p_expect(TokenKind::RBracket)
    {"name": name, "args": args, "kwargs": kwargs, "span": span}
}

// ══════════════════════════════════════════════════════════════════════
// ── Full String Interpolation with Nested Complex Expressions ───────
// ══════════════════════════════════════════════════════════════════════

// Parse f-string: f"text {expr} text {expr:format} text"
func parse_fstring_interpolation(text) {
    let parts = []
    let i = 0
    let current = ""

    while i < len(text) {
        const c = text[i]

        if c == "\\" && i + 1 < len(text) {
            current = current + text[i + 1]
            i = i + 2
            continue
        }

        if c == "{" {
            // Start of interpolation
            if len(current) > 0 {
                parts.push({"kind": "text", "value": current})
                current = ""
            }
            i = i + 1
            // Parse the expression inside { }
            let expr_text = ""
            let format_spec = ""
            let brace_depth = 1
            while i < len(text) && brace_depth > 0 {
                const ic = text[i]
                if ic == "{" { brace_depth = brace_depth + 1 }
                if ic == "}" { brace_depth = brace_depth - 1; if brace_depth == 0 { break } }
                if ic == ":" && brace_depth == 1 {
                    // Format specifier
                    i = i + 1
                    while i < len(text) && text[i] != "}" {
                        format_spec = format_spec + text[i]
                        i = i + 1
                    }
                    break
                }
                expr_text = expr_text + ic
                i = i + 1
            }
            i = i + 1  // skip closing }

            parts.push({
                "kind": "expr",
                "text": expr_text.trim(),
                "format": format_spec,
            })
            continue
        }

        current = current + c
        i = i + 1
    }

    if len(current) > 0 {
        parts.push({"kind": "text", "value": current})
    }

    parts
}

// ══════════════════════════════════════════════════════════════════════
// ── Operator Overloading Syntax in Interface Declarations ───────────
// ══════════════════════════════════════════════════════════════════════

// Parse operator declarations in interfaces:
// interface Addable {
//     operator +(self, other: Self) -> Self
//     operator ==(self, other: Self) -> bool
// }
func parse_interface_operator() {
    const span = p_current_span()
    p_advance()  // consume 'operator'

    // Read the operator symbol
    const op_tok = p_advance()
    const op = op_tok.text

    p_expect(TokenKind::LParen)
    const params = parse_param_list()
    p_expect(TokenKind::RParen)

    let ret_type = null
    if p_peek().text == "->" {
        p_advance()
        ret_type = parse_type_annotation()
    }

    {
        "kind": "operator",
        "op": op,
        "params": params,
        "return_type": ret_type,
        "span": span,
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Complete Postfix Parsing ────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Full postfix chain: obj.field.method(a).items[0]?.name
func parse_postfix(expr) {
    let result = expr

    while !p_at_eof() {
        // Field access: .field
        if p_at(TokenKind::Dot) {
            p_advance()
            const field = p_expect_ident()
            // Check for method call: .method(args)
            if p_at(TokenKind::LParen) {
                p_advance()
                let args = []
                let kwargs = {"__s": true}
                while !p_at(TokenKind::RParen) && !p_at_eof() {
                    // Check for named argument
                    if p_at(TokenKind::Ident) {
                        const save = p_pos
                        const maybe_name = p_advance()
                        if p_at(TokenKind::Eq) {
                            p_advance()
                            const val = parse_expression()
                            kwargs[maybe_name.text] = val
                        } else {
                            p_pos = save
                            args.push(parse_expression())
                        }
                    } else {
                        args.push(parse_expression())
                    }
                    if p_at(TokenKind::Comma) { p_advance() }
                }
                p_expect(TokenKind::RParen)
                const span = result.span
                result = expr_new(ExprKind::EMethodCall(result, field, args, kwargs), span)
            } else {
                const span = result.span
                result = expr_new(ExprKind::EFieldAccess(result, field), span)
            }
            continue
        }

        // Index: [expr]
        if p_at(TokenKind::LBracket) {
            p_advance()
            // Check for slice: [start..end]
            if p_at(TokenKind::DotDot) {
                p_advance()
                const end_expr = parse_expression()
                p_expect(TokenKind::RBracket)
                const span = result.span
                result = expr_new(ExprKind::ESlice(result, null, end_expr), span)
            } else {
                const idx = parse_expression()
                if p_at(TokenKind::DotDot) {
                    p_advance()
                    let end_expr = null
                    if !p_at(TokenKind::RBracket) {
                        end_expr = parse_expression()
                    }
                    p_expect(TokenKind::RBracket)
                    const span = result.span
                    result = expr_new(ExprKind::ESlice(result, idx, end_expr), span)
                } else {
                    p_expect(TokenKind::RBracket)
                    const span = result.span
                    result = expr_new(ExprKind::EIndex(result, idx), span)
                }
            }
            continue
        }

        // Optional chaining: ?.field
        if p_peek().text == "?" && p_pos + 1 < len(p_tokens) && p_tokens[p_pos + 1].kind == TokenKind::Dot {
            p_advance()  // skip ?
            p_advance()  // skip .
            const field = p_expect_ident()
            if p_at(TokenKind::LParen) {
                p_advance()
                let args = []
                while !p_at(TokenKind::RParen) && !p_at_eof() {
                    args.push(parse_expression())
                    if p_at(TokenKind::Comma) { p_advance() }
                }
                p_expect(TokenKind::RParen)
                const span = result.span
                result = expr_new(ExprKind::EOptionalMethodCall(result, field, args), span)
            } else {
                const span = result.span
                result = expr_new(ExprKind::EOptionalField(result, field), span)
            }
            continue
        }

        // Function call: expr(args) — only if no space before (
        if p_at(TokenKind::LParen) {
            // Only chain call if previous token was an ident or closing bracket
            const prev_kind = result.kind
            const is_callable = match prev_kind {
                ExprKind::EVariable(_) => true,
                ExprKind::EFieldAccess(_, _) => true,
                ExprKind::EMethodCall(_, _, _, _) => true,
                ExprKind::EIndex(_, _) => true,
                _ => false,
            }
            if !is_callable { break }

            p_advance()
            let args = []
            while !p_at(TokenKind::RParen) && !p_at_eof() {
                args.push(parse_expression())
                if p_at(TokenKind::Comma) { p_advance() }
            }
            p_expect(TokenKind::RParen)
            const span = result.span
            result = expr_new(ExprKind::ECall("__call__", args, null), span)
            continue
        }

        break
    }
    result
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Error Message Generation with Suggestions ──────────────────
// ══════════════════════════════════════════════════════════════════════

// Generate a detailed error message with fix suggestions
func p_error_with_suggestion(msg, suggestion) {
    const tok = p_peek()
    const base = f"parse error at {tok.line}:{tok.col}: {msg}"
    const full = if suggestion != null { f"{base}\n  hint: {suggestion}" } else { base }
    p_errors.push(full)
}

// Error for unexpected token
func p_error_unexpected(expected) {
    const tok = p_peek()
    const got = if tok.text != "" { f"'{tok.text}'" } else { token_kind_name(tok.kind) }
    const msg = f"expected {expected}, got {got}"

    let suggestion = null
    // Common mistake suggestions
    if expected == "';'" && tok.kind == TokenKind::LBrace {
        suggestion = "did you forget a semicolon before this block?"
    }
    if expected == "')'" && tok.kind == TokenKind::Semicolon {
        suggestion = "unmatched parenthesis — check for missing ')'"
    }
    if expected == "'{'" && tok.kind == TokenKind::FatArrow {
        suggestion = "use '{' for block bodies, not '=>'"
    }
    if expected == "identifier" && tok.kind == TokenKind::Let {
        suggestion = "'let' is a keyword; choose a different variable name"
    }
    if expected == "identifier" && tok.kind == TokenKind::Func {
        suggestion = "unexpected 'func' — maybe a missing closing brace above?"
    }
    if expected == "expression" && tok.kind == TokenKind::RBrace {
        suggestion = "empty block or missing expression before '}'"
    }
    if expected == "expression" && tok.kind == TokenKind::Eof {
        suggestion = "unexpected end of file — check for unclosed braces/parens"
    }

    p_error_with_suggestion(msg, suggestion)
}

// Error for mismatched delimiters
func p_error_mismatched(open, close, open_line, open_col) {
    const tok = p_peek()
    const msg = f"expected closing '{close}' to match '{open}' opened at {open_line}:{open_col}"
    p_error_with_suggestion(msg, f"add '{close}' to close the {open}...{close} pair")
}

// Error for invalid expression
func p_error_invalid_expr(context) {
    const tok = p_peek()
    const got = if tok.text != "" { f"'{tok.text}'" } else { token_kind_name(tok.kind) }
    let suggestion = null
    match got {
        "'='" => {
            suggestion = "use '==' for comparison, '=' is for assignment"
        },
        "'!'" => {
            suggestion = "use 'not' or '!' before an expression, not standalone"
        },
        "'=>'" => {
            suggestion = "'=>' is only valid in match arms or arrow functions"
        },
        _ => {},
    }
    p_error_with_suggestion(f"invalid expression in {context}: unexpected {got}", suggestion)
}

// Error for duplicate declaration
func p_error_duplicate(name, kind) {
    p_error_with_suggestion(
        f"duplicate {kind} '{name}' in this scope",
        f"rename one of the '{name}' declarations or use a different scope"
    )
}

// Error for invalid pattern in match arm
func p_error_invalid_pattern() {
    const tok = p_peek()
    const got = if tok.text != "" { f"'{tok.text}'" } else { token_kind_name(tok.kind) }
    p_error_with_suggestion(
        f"invalid match pattern: unexpected {got}",
        "valid patterns: literal, variable, Enum::Variant, [a, b, ..], {{key: val}}, _"
    )
}

// Get human-readable name for token kind
func token_kind_name(kind) {
    match kind {
        TokenKind::Eof => "end of file",
        TokenKind::Ident => "identifier",
        TokenKind::IntLit => "integer",
        TokenKind::FloatLit => "float",
        TokenKind::StringLit => "string",
        TokenKind::LParen => "'('",
        TokenKind::RParen => "')'",
        TokenKind::LBrace => "'{'",
        TokenKind::RBrace => "'}'",
        TokenKind::LBracket => "'['",
        TokenKind::RBracket => "']'",
        TokenKind::Comma => "','",
        TokenKind::Semicolon => "';'",
        TokenKind::Colon => "':'",
        TokenKind::Dot => "'.'",
        TokenKind::Eq => "'='",
        TokenKind::EqEq => "'=='",
        TokenKind::FatArrow => "'=>'",
        TokenKind::Arrow => "'->'",
        TokenKind::Func => "'func'",
        TokenKind::Let => "'let'",
        TokenKind::Const => "'const'",
        TokenKind::If => "'if'",
        TokenKind::Else => "'else'",
        TokenKind::While => "'while'",
        TokenKind::For => "'for'",
        TokenKind::In => "'in'",
        TokenKind::Return => "'return'",
        TokenKind::Match => "'match'",
        TokenKind::Break => "'break'",
        TokenKind::Continue => "'continue'",
        TokenKind::Import => "'import'",
        TokenKind::Struct => "'struct'",
        TokenKind::Enum => "'enum'",
        TokenKind::Trait => "'trait'",
        TokenKind::Impl => "'impl'",
        _ => "token",
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── AST Pretty Printer for Debugging ────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Pretty print an AST node for debugging
func ast_pretty_print(node) {
    ast_pp(node, 0)
}

func ast_pp(node, indent) {
    const prefix = "  ".repeat(indent)

    if node == null {
        return prefix + "null"
    }

    if typeof(node) != "map" {
        return prefix + to_string(node)
    }

    if node.has("kind") {
        return ast_pp_expr(node, indent)
    }

    if node.has("stmts") {
        return ast_pp_program(node, indent)
    }

    prefix + to_string(node)
}

func ast_pp_program(prog, indent) {
    const prefix = "  ".repeat(indent)
    let lines = [prefix + "Program"]
    if prog.has("stmts") {
        for stmt in prog["stmts"] {
            lines.push(ast_pp(stmt, indent + 1))
        }
    }
    lines.join("\n")
}

func ast_pp_expr(expr, indent) {
    const prefix = "  ".repeat(indent)
    const kind = expr.kind

    match kind {
        ExprKind::ELiteral(val) => {
            const t = typeof(val)
            match t {
                "string" => prefix + f"Literal(\"{val}\")",
                "null" => prefix + "Literal(null)",
                _ => prefix + f"Literal({val})",
            }
        },
        ExprKind::EVariable(name) => prefix + f"Var({name})",
        ExprKind::EBinary(op, left, right) => {
            let lines = [prefix + f"Binary({op})"]
            lines.push(ast_pp(left, indent + 1))
            lines.push(ast_pp(right, indent + 1))
            lines.join("\n")
        },
        ExprKind::EUnary(op, operand) => {
            let lines = [prefix + f"Unary({op})"]
            lines.push(ast_pp(operand, indent + 1))
            lines.join("\n")
        },
        ExprKind::ECall(name, args, _) => {
            let lines = [prefix + f"Call({name})"]
            for arg in args {
                lines.push(ast_pp(arg, indent + 1))
            }
            lines.join("\n")
        },
        ExprKind::ELambda(params, body) => {
            let lines = [prefix + f"Lambda({params.join(\", \")})"]
            lines.push(ast_pp(body, indent + 1))
            lines.join("\n")
        },
        ExprKind::EFieldAccess(obj, field) => {
            let lines = [prefix + f"FieldAccess(.{field})"]
            lines.push(ast_pp(obj, indent + 1))
            lines.join("\n")
        },
        ExprKind::EIndex(obj, idx) => {
            let lines = [prefix + "Index"]
            lines.push(ast_pp(obj, indent + 1))
            lines.push(ast_pp(idx, indent + 1))
            lines.join("\n")
        },
        ExprKind::EMatch(subject, arms) => {
            let lines = [prefix + "Match"]
            lines.push(ast_pp(subject, indent + 1))
            for arm in arms {
                lines.push(prefix + "  Arm:")
                if arm.has("pattern") { lines.push(ast_pp(arm["pattern"], indent + 2)) }
                if arm.has("body") { lines.push(ast_pp(arm["body"], indent + 2)) }
            }
            lines.join("\n")
        },
        ExprKind::EArrayLiteral(elems) => {
            let lines = [prefix + f"Array({len(elems)} elements)"]
            for elem in elems {
                lines.push(ast_pp(elem, indent + 1))
            }
            lines.join("\n")
        },
        ExprKind::EMapLiteral(entries) => {
            let lines = [prefix + f"Map({len(entries)} entries)"]
            for entry in entries {
                lines.push(prefix + "  Entry:")
                if typeof(entry) == "array" && len(entry) >= 2 {
                    lines.push(ast_pp(entry[0], indent + 2))
                    lines.push(ast_pp(entry[1], indent + 2))
                }
            }
            lines.join("\n")
        },
        ExprKind::EIf(cond, then_br, else_br) => {
            let lines = [prefix + "If"]
            lines.push(prefix + "  Condition:")
            lines.push(ast_pp(cond, indent + 2))
            lines.push(prefix + "  Then:")
            lines.push(ast_pp(then_br, indent + 2))
            if else_br != null {
                lines.push(prefix + "  Else:")
                lines.push(ast_pp(else_br, indent + 2))
            }
            lines.join("\n")
        },
        ExprKind::EStringInterp(parts) => {
            let lines = [prefix + "StringInterp"]
            for part in parts {
                lines.push(ast_pp(part, indent + 1))
            }
            lines.join("\n")
        },
        ExprKind::EStructConstruct(name, fields) => {
            let lines = [prefix + f"Struct({name})"]
            for f in fields {
                if typeof(f) == "array" && len(f) >= 2 {
                    lines.push(prefix + f"  {f[0]}:")
                    lines.push(ast_pp(f[1], indent + 2))
                }
            }
            lines.join("\n")
        },
        ExprKind::EEnumConstruct(enum_name, variant, args) => {
            let lines = [prefix + f"Enum({enum_name}::{variant})"]
            for arg in args {
                lines.push(ast_pp(arg, indent + 1))
            }
            lines.join("\n")
        },
        _ => prefix + f"Expr({kind})",
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Parser Combinators ──────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Combinator: try to parse, backtrack on failure
func p_try(parser_fn) {
    const saved_pos = p_pos
    const saved_errors = len(p_errors)
    const result = parser_fn()
    if result == null {
        // Backtrack
        p_pos = saved_pos
        // Remove errors added during the failed attempt
        while len(p_errors) > saved_errors { p_errors.pop() }
        return null
    }
    result
}

// Combinator: sequence of parsers (all must succeed)
func p_sequence(parsers) {
    const saved_pos = p_pos
    let results = []
    for parser in parsers {
        const result = parser()
        if result == null {
            p_pos = saved_pos
            return null
        }
        results.push(result)
    }
    results
}

// Combinator: choice (try each alternative)
func p_choice(parsers) {
    for parser in parsers {
        const result = p_try(parser)
        if result != null { return result }
    }
    null
}

// Combinator: optional (returns null if no match, no error)
func p_optional(parser_fn) {
    const result = p_try(parser_fn)
    result // null is fine
}

// Combinator: many (zero or more matches)
func p_many(parser_fn) {
    let results = []
    while true {
        const result = p_try(parser_fn)
        if result == null { break }
        results.push(result)
    }
    results
}

// Combinator: many1 (one or more matches)
func p_many1(parser_fn) {
    const first = parser_fn()
    if first == null { return null }
    let results = [first]
    while true {
        const result = p_try(parser_fn)
        if result == null { break }
        results.push(result)
    }
    results
}

// Combinator: separated_by (items separated by delimiter)
func p_separated_by(item_fn, sep_kind) {
    let results = []
    const first = p_try(item_fn)
    if first == null { return results }
    results.push(first)

    while p_at(sep_kind) {
        p_advance()
        const next = item_fn()
        if next == null { break }
        results.push(next)
    }
    results
}

// Combinator: separated_by with trailing separator allowed
func p_separated_by_trailing(item_fn, sep_kind) {
    let results = []
    const first = p_try(item_fn)
    if first == null { return results }
    results.push(first)

    while p_at(sep_kind) {
        p_advance()
        const next = p_try(item_fn)
        if next == null { break }
        results.push(next)
    }
    results
}

// Combinator: delimited (open + content + close)
func p_delimited(open_kind, content_fn, close_kind) {
    if !p_at(open_kind) { return null }
    p_advance()
    const content = content_fn()
    p_expect(close_kind)
    content
}

// Combinator: between (wrapper for delimited with better error messages)
func p_between(open_kind, close_kind, content_fn) {
    p_delimited(open_kind, content_fn, close_kind)
}

// ══════════════════════════════════════════════════════════════════════
// ── Source Map Generation ───────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Generate a source map from parsed AST
func generate_source_map(ast, source_file) {
    let mappings = []
    let sources = [source_file]
    let names = []

    collect_source_mappings(ast, mappings, names)

    {
        "version": 3,
        "file": source_file.replace(".magi", ".js"),
        "sourceRoot": "",
        "sources": sources,
        "names": names,
        "mappings": encode_vlq_mappings(mappings),
    }
}

// Collect source position mappings from AST
func collect_source_mappings(node, mappings, names) {
    if node == null { return }
    if typeof(node) != "map" { return }

    if node.has("span") {
        const span = node["span"]
        let name = null
        if node.has("kind") {
            const kind = node.kind
            match kind {
                ExprKind::EVariable(n) => { name = n },
                ExprKind::ECall(n, _, _) => { name = n },
                _ => {},
            }
        }

        let name_idx = -1
        if name != null {
            name_idx = names.index_of(name)
            if name_idx == null || name_idx < 0 {
                names.push(name)
                name_idx = len(names) - 1
            }
        }

        mappings.push({
            "generated_line": span["start_line"],
            "generated_col": span["start_col"],
            "source_idx": 0,
            "source_line": span["start_line"],
            "source_col": span["start_col"],
            "name_idx": name_idx,
        })
    }

    // Recurse
    if node.has("stmts") {
        for stmt in node["stmts"] { collect_source_mappings(stmt, mappings, names) }
    }
    if node.has("body") {
        const body = node["body"]
        if typeof(body) == "array" {
            for item in body { collect_source_mappings(item, mappings, names) }
        } else {
            collect_source_mappings(body, mappings, names)
        }
    }
    if node.has("expr") { collect_source_mappings(node["expr"], mappings, names) }
    if node.has("left") { collect_source_mappings(node["left"], mappings, names) }
    if node.has("right") { collect_source_mappings(node["right"], mappings, names) }
    if node.has("args") {
        for arg in node["args"] { collect_source_mappings(arg, mappings, names) }
    }
}

// Encode VLQ mappings string (simplified)
func encode_vlq_mappings(mappings) {
    if len(mappings) == 0 { return "" }

    // Sort by generated line then col
    mappings.sort((a, b) => {
        if a["generated_line"] != b["generated_line"] {
            a["generated_line"] - b["generated_line"]
        } else {
            a["generated_col"] - b["generated_col"]
        }
    })

    let result = ""
    let prev_line = 0
    let prev_col = 0
    let prev_src_line = 0
    let prev_src_col = 0
    let prev_name = 0

    let current_line = 0
    for m in mappings {
        // Add semicolons for line gaps
        while current_line < m["generated_line"] {
            result = result + ";"
            current_line = current_line + 1
            prev_col = 0
        }

        if result.ends_with(";") || len(result) == 0 {
            // First segment on this line
        } else {
            result = result + ","
        }

        // Encode: generated_col, source_idx, source_line, source_col, [name_idx]
        result = result + vlq_encode(m["generated_col"] - prev_col)
        result = result + vlq_encode(m["source_idx"])
        result = result + vlq_encode(m["source_line"] - prev_src_line)
        result = result + vlq_encode(m["source_col"] - prev_src_col)

        if m["name_idx"] >= 0 {
            result = result + vlq_encode(m["name_idx"] - prev_name)
            prev_name = m["name_idx"]
        }

        prev_col = m["generated_col"]
        prev_src_line = m["source_line"]
        prev_src_col = m["source_col"]
    }

    result
}

// VLQ (Variable Length Quantity) encoding for source maps
const VLQ_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

func vlq_encode(value) {
    let vlq = if value < 0 { (-value * 2) + 1 } else { value * 2 }
    let result = ""
    while true {
        let digit = vlq % 32
        vlq = vlq / 32
        if vlq > 0 { digit = digit + 32 } // continuation bit
        result = result + VLQ_CHARS[digit]
        if vlq == 0 { break }
    }
    result
}
