// MAGI Self-Hosted Compiler — AST Pretty-Printer / Formatter
//
// Converts an AST back to well-formatted MAGI source code.
// Uses 4-space indentation. Idempotent when re-parsed and re-formatted.

// ── Constants ───────────────────────────────────────────────────────

const FMT_NL = "\n"
const FMT_OPEN = "\{"
const FMT_CLOSE = "\}"

// ── Indentation ─────────────────────────────────────────────────────

func fmt_indent(depth) {
    let s = ""
    let i = 0
    while i < depth {
        s = s + "    "
        i = i + 1
    }
    s
}

// ── Format Literal ──────────────────────────────────────────────────

func fmt_literal(lit) {
    match lit {
        Literal::IntLit(n) => to_string(n),
        Literal::FloatLit(f) => to_string(f),
        Literal::StringLit(s) => "\"" + s + "\"",
        Literal::BoolLit(b) => if b { "true" } else { "false" },
        Literal::NullLit => "null",
        Literal::ArrayLit(elems) => {
            const parts = elems.map(e => fmt_expr(e, 0))
            const joined = parts.join(", ")
            "[" + joined + "]"
        },
        Literal::MapLit(entries) => {
            if len(entries) == 0 { return FMT_OPEN + FMT_CLOSE }
            const parts = entries.map(entry => {
                const k = entry[0]
                const v = fmt_expr(entry[1], 0)
                k + ": " + v
            })
            const joined = parts.join(", ")
            FMT_OPEN + " " + joined + " " + FMT_CLOSE
        },
        Literal::SetLit(elems) => {
            const parts = elems.map(e => fmt_expr(e, 0))
            const joined = parts.join(", ")
            "#" + FMT_OPEN + joined + FMT_CLOSE
        },
    }
}

// ── Format Expression ────────────────────────────────────────────────

func fmt_expr(e, depth) {
    if e == null { return "null" }
    const k = e.kind
    match k {
        ExprKind::ELiteral(lit) => fmt_literal(lit),
        ExprKind::EVariable(name) => name,
        ExprKind::EBinaryOp(op, left, right) => {
            const ls = fmt_expr(left, depth)
            const rs = fmt_expr(right, depth)
            const sym = op.symbol()
            ls + " " + sym + " " + rs
        },
        ExprKind::EUnaryOp(op, operand) => {
            const sym = op.symbol()
            const os = fmt_expr(operand, depth)
            sym + os
        },
        ExprKind::ECall(name, args, _) => {
            const parts = args.map(a => fmt_expr(a, depth))
            const joined = parts.join(", ")
            name + "(" + joined + ")"
        },
        ExprKind::EMethodCall(obj, method, args, _) => {
            const os = fmt_expr(obj, depth)
            const parts = args.map(a => fmt_expr(a, depth))
            const joined = parts.join(", ")
            os + "." + method + "(" + joined + ")"
        },
        ExprKind::EFieldAccess(obj, field) => {
            const os = fmt_expr(obj, depth)
            os + "." + field
        },
        ExprKind::EIndex(obj, idx) => {
            const os = fmt_expr(obj, depth)
            const is_ = fmt_expr(idx, depth)
            os + "[" + is_ + "]"
        },
        ExprKind::EPipe(left, right) => {
            const ls = fmt_expr(left, depth)
            const rs = fmt_expr(right, depth)
            ls + " |> " + rs
        },
        ExprKind::EIfElse(cond, then_b, else_b) => {
            const cs = fmt_expr(cond, depth)
            const ts = fmt_block_inline(then_b, depth)
            if else_b == null {
                "if " + cs + " " + ts
            } else {
                const es = fmt_block_inline(else_b, depth)
                "if " + cs + " " + ts + " else " + es
            }
        },
        ExprKind::EBlock(blk) => fmt_block_inline(blk, depth),
        ExprKind::ELambda(params, body) => {
            const pnames = params.map(p => p.name)
            const bs = fmt_expr(body, depth)
            if len(pnames) == 1 {
                const pn = pnames[0]
                pn + " => " + bs
            } else {
                const joined = pnames.join(", ")
                "(" + joined + ") => " + bs
            }
        },
        ExprKind::EMatch(subject, arms) => {
            const ss = fmt_expr(subject, depth)
            const ind = fmt_indent(depth)
            const arm_ind = fmt_indent(depth + 1)
            let arm_strs = []
            for arm in arms {
                const ps = fmt_pattern(arm.pattern)
                const bs = fmt_expr(arm.body, depth + 1)
                arm_strs.push(arm_ind + ps + " => " + bs + ",")
            }
            const arms_joined = arm_strs.join(FMT_NL)
            "match " + ss + " " + FMT_OPEN + FMT_NL + arms_joined + FMT_NL + ind + FMT_CLOSE
        },
        ExprKind::ENullCoalesce(left, right) => {
            const ls = fmt_expr(left, depth)
            const rs = fmt_expr(right, depth)
            ls + " ?? " + rs
        },
        ExprKind::ERange(start, end_, inclusive) => {
            const ss = fmt_expr(start, depth)
            const es = fmt_expr(end_, depth)
            const op = if inclusive { "..=" } else { ".." }
            ss + op + es
        },
        ExprKind::EStringInterp(parts) => {
            let content = ""
            for part in parts {
                match part {
                    StringPart::LiteralPart(s) => { content = content + s },
                    StringPart::ExprPart(e2) => {
                        const es = fmt_expr(e2, depth)
                        content = content + FMT_OPEN + es + FMT_CLOSE
                    },
                }
            }
            "f\"" + content + "\""
        },
        ExprKind::ETupleLiteral(elems) => {
            const parts = elems.map(e2 => fmt_expr(e2, depth))
            const joined = parts.join(", ")
            "(" + joined + ")"
        },
        ExprKind::EStructConstruct(name, fields) => {
            if len(fields) == 0 {
                name + " " + FMT_OPEN + FMT_CLOSE
            } else {
                const parts = fields.map(f2 => fmt_expr(f2, depth))
                const joined = parts.join(", ")
                name + " " + FMT_OPEN + " " + joined + " " + FMT_CLOSE
            }
        },
        ExprKind::EEnumConstruct(enum_, variant, args) => {
            if len(args) == 0 {
                enum_ + "::" + variant
            } else {
                const parts = args.map(a => fmt_expr(a, depth))
                const joined = parts.join(", ")
                enum_ + "::" + variant + "(" + joined + ")"
            }
        },
        ExprKind::EAwait(inner) => "await " + fmt_expr(inner, depth),
        ExprKind::ESpawn(inner) => "spawn " + fmt_expr(inner, depth),
        ExprKind::EYield(inner) => "yield " + fmt_expr(inner, depth),
        ExprKind::EOptionalChain(obj, field) => fmt_expr(obj, depth) + "?." + field,
        ExprKind::ESpread(inner) => "..." + fmt_expr(inner, depth),
        ExprKind::ETryCatch(try_e, err_name, catch_e) => {
            const ts = fmt_expr(try_e, depth)
            const cs = fmt_expr(catch_e, depth)
            "try " + ts + " catch " + err_name + " " + cs
        },
        ExprKind::ETryPropagate(inner) => fmt_expr(inner, depth) + "?",
        ExprKind::EPlaceholder => "_",
        ExprKind::ELoop(body) => "loop " + fmt_block_inline(body, depth),
        _ => "<expr>",
    }
}

// ── Format Pattern ──────────────────────────────────────────────────

func fmt_pattern(pat) {
    match pat {
        Pattern::PWildcard => "_",
        Pattern::PVariable(name) => name,
        Pattern::PLiteral(lit) => fmt_literal(lit),
        Pattern::PEnum(enum_, variant, fields) => {
            if len(fields) == 0 {
                enum_ + "::" + variant
            } else {
                const parts = fields.map(f2 => fmt_pattern(f2))
                const joined = parts.join(", ")
                enum_ + "::" + variant + "(" + joined + ")"
            }
        },
        Pattern::PArray(elems) => {
            const parts = elems.map(e => fmt_pattern(e))
            const joined = parts.join(", ")
            "[" + joined + "]"
        },
        Pattern::PMap(entries) => {
            const parts = entries.map(e => fmt_pattern(e))
            const joined = parts.join(", ")
            FMT_OPEN + " " + joined + " " + FMT_CLOSE
        },
        Pattern::POr(pats) => {
            const parts = pats.map(p => fmt_pattern(p))
            parts.join(" | ")
        },
        Pattern::PRest(name) => "..." + name,
        Pattern::PType(name, type_) => name + ": " + type_,
        Pattern::PBinding(name, inner) => fmt_pattern(inner) + " @ " + name,
        Pattern::PRange(lo, hi, inclusive) => {
            const ls = fmt_pattern(lo)
            const hs = fmt_pattern(hi)
            const op = if inclusive { "..=" } else { ".." }
            ls + op + hs
        },
    }
}

// ── Format Block (inline) ────────────────────────────────────────────

func fmt_block_inline(blk, depth) {
    if blk == null { return FMT_OPEN + FMT_CLOSE }
    if len(blk.stmts) == 0 && blk.tail_expr == null { return FMT_OPEN + FMT_CLOSE }
    const ind = fmt_indent(depth)
    const inner_ind = fmt_indent(depth + 1)
    let lines = []
    for s in blk.stmts {
        lines.push(inner_ind + fmt_stmt(s, depth + 1))
    }
    if blk.tail_expr != null {
        lines.push(inner_ind + fmt_expr(blk.tail_expr, depth + 1))
    }
    const body = lines.join(FMT_NL)
    FMT_OPEN + FMT_NL + body + FMT_NL + ind + FMT_CLOSE
}

// ── Format Statement ─────────────────────────────────────────────────

func fmt_stmt(s, depth) {
    const k = s.kind
    const ind = fmt_indent(depth)
    match k {
        StmtKind::SLet(name, expr) =>
            "let " + name + " = " + fmt_expr(expr, depth),
        StmtKind::SLetMut(name, expr) =>
            "let mut " + name + " = " + fmt_expr(expr, depth),
        StmtKind::SConst(name, expr) =>
            "const " + name + " = " + fmt_expr(expr, depth),
        StmtKind::SAssignment(name, expr) =>
            name + " = " + fmt_expr(expr, depth),
        StmtKind::SCompoundAssign(name, op, expr) => {
            const sym = op.symbol()
            name + " " + sym + "= " + fmt_expr(expr, depth)
        },
        StmtKind::SReturn(expr) => {
            if expr == null { "return" }
            else { "return " + fmt_expr(expr, depth) }
        },
        StmtKind::SBreak(label, _) => {
            if label == "" { "break" } else { "break '" + label }
        },
        StmtKind::SContinue(label) => {
            if label == "" { "continue" } else { "continue '" + label }
        },
        StmtKind::SOutput(expr) =>
            "output " + fmt_expr(expr, depth),
        StmtKind::SExprStmt(expr) =>
            fmt_expr(expr, depth),
        StmtKind::SThrow(expr) =>
            "throw " + fmt_expr(expr, depth),
        StmtKind::SFuncDef(fd) =>
            fmt_funcdef(fd, depth, false),
        StmtKind::SAsyncFuncDef(fd) =>
            fmt_funcdef(fd, depth, true),
        StmtKind::SIf(cond, then_b, else_b) => {
            const cs = fmt_expr(cond, depth)
            const ts = fmt_block_inline(then_b, depth)
            if else_b == null {
                "if " + cs + " " + ts
            } else {
                const es = fmt_block_inline(else_b, depth)
                "if " + cs + " " + ts + " else " + es
            }
        },
        StmtKind::SWhileLoop(label, cond, body) => {
            const cs = fmt_expr(cond, depth)
            const bs = fmt_block_inline(body, depth)
            if label == "" { "while " + cs + " " + bs }
            else { "'" + label + ": while " + cs + " " + bs }
        },
        StmtKind::SForLoop(label, pat, iter, body) => {
            const is_ = fmt_expr(iter, depth)
            const bs = fmt_block_inline(body, depth)
            if label == "" { "for " + pat + " in " + is_ + " " + bs }
            else { "'" + label + ": for " + pat + " in " + is_ + " " + bs }
        },
        StmtKind::SMatch(subject, arms) => {
            const ss = fmt_expr(subject, depth)
            const arm_ind = fmt_indent(depth + 1)
            let arm_strs = []
            for arm in arms {
                const ps = fmt_pattern(arm.pattern)
                const bs = fmt_expr(arm.body, depth + 1)
                arm_strs.push(arm_ind + ps + " => " + bs + ",")
            }
            const arms_joined = arm_strs.join(FMT_NL)
            "match " + ss + " " + FMT_OPEN + FMT_NL + arms_joined + FMT_NL + ind + FMT_CLOSE
        },
        StmtKind::SStructDef(name, _, fields) => {
            let field_strs = []
            for f2 in fields {
                const fa = fmt_indent(depth + 1)
                field_strs.push(fa + f2.name + ": " + f2.type_ann + ",")
            }
            const fbody = field_strs.join(FMT_NL)
            "struct " + name + " " + FMT_OPEN + FMT_NL + fbody + FMT_NL + ind + FMT_CLOSE
        },
        StmtKind::SEnumDef(name, _, variants) => {
            let var_strs = []
            for v in variants {
                const va = fmt_indent(depth + 1)
                if len(v.fields) == 0 {
                    var_strs.push(va + v.name + ",")
                } else {
                    const fjoined = v.fields.join(", ")
                    var_strs.push(va + v.name + "(" + fjoined + "),")
                }
            }
            const vbody = var_strs.join(FMT_NL)
            "enum " + name + " " + FMT_OPEN + FMT_NL + vbody + FMT_NL + ind + FMT_CLOSE
        },
        StmtKind::SImplBlock(name, methods) => {
            let method_strs = []
            for m in methods {
                const ms = fmt_funcdef(m, depth + 1, false)
                const ma = fmt_indent(depth + 1)
                method_strs.push(ma + ms)
            }
            const mbody = method_strs.join(FMT_NL + FMT_NL)
            "impl " + name + " " + FMT_OPEN + FMT_NL + mbody + FMT_NL + ind + FMT_CLOSE
        },
        StmtKind::SImport(path) => "import \"" + path + "\"",
        StmtKind::STypeAlias(name, type_) => "type " + name + " = " + type_,
        StmtKind::SDefer(expr) => "defer " + fmt_expr(expr, depth),
        StmtKind::SIncrement(name) => name + "++",
        StmtKind::SDecrement(name) => name + "--",
        StmtKind::STryCatch(try_b, err_name, catch_b, finally_b) => {
            const ts = fmt_block_inline(try_b, depth)
            const cs = fmt_block_inline(catch_b, depth)
            if finally_b == null {
                "try " + ts + " catch " + err_name + " " + cs
            } else {
                const fs = fmt_block_inline(finally_b, depth)
                "try " + ts + " catch " + err_name + " " + cs + " finally " + fs
            }
        },
        _ => "/* stmt: " + k.describe() + " */",
    }
}

// ── Format Function Definition ───────────────────────────────────────

func fmt_funcdef(fd, depth, is_async) {
    let pstrs = []
    for p in fd.params {
        if p.rest { pstrs.push("..." + p.name) }
        else if p.type_ann != "" { pstrs.push(p.name + ": " + p.type_ann) }
        else { pstrs.push(p.name) }
    }
    const pjoined = pstrs.join(", ")
    const bs = fmt_block_inline(fd.body, depth)
    const kw = if is_async { "async func" } else { "func" }
    if fd.return_type != "" {
        kw + " " + fd.name + "(" + pjoined + ") -> " + fd.return_type + " " + bs
    } else {
        kw + " " + fd.name + "(" + pjoined + ") " + bs
    }
}

// ── Entry Point ──────────────────────────────────────────────────────

func format_program(program) {
    let parts = []
    for s in program.statements {
        parts.push(fmt_stmt(s, 0))
    }
    let result = parts.join(FMT_NL) + FMT_NL

    // Post-processing: sort imports, ensure final newline
    result = fmt_sort_imports(result)
    result = fmt_ensure_final_newline(result)
    result
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Expression Formatting ──────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func fmt_expr_full(expr, depth) {
    if expr == null { return "null" }
    const ek = expr.kind
    match ek {
        ExprKind::ELiteral(lit) => fmt_literal(lit),
        ExprKind::EIntLiteral(n) => to_string(n),
        ExprKind::EFloatLiteral(f) => to_string(f),
        ExprKind::EStringLiteral(s) => "\"" + fmt_escape_string(s) + "\"",
        ExprKind::EBoolLiteral(b) => if b { "true" } else { "false" },
        ExprKind::ENullLiteral => "null",
        ExprKind::EVariable(name) => name,
        ExprKind::EBinaryOp(op, left, right) => {
            const ls = fmt_expr_full(left, depth)
            const rs = fmt_expr_full(right, depth)
            const ops = fmt_binop(op)
            f"{ls} {ops} {rs}"
        },
        ExprKind::EUnaryOp(op, operand) => {
            const os = fmt_expr_full(operand, depth)
            const ops = fmt_unop(op)
            f"{ops}{os}"
        },
        ExprKind::ECall(name, args, type_args) => {
            let arg_strs = []
            if args != null {
                for a in args { arg_strs.push(fmt_expr_full(a, depth)) }
            }
            let ta_str = ""
            if type_args != null && len(type_args) > 0 {
                ta_str = "<" + type_args.join(", ") + ">"
            }
            f"{name}{ta_str}({arg_strs.join(', ')})"
        },
        ExprKind::EMethodCall(obj, method, args, _) => {
            const os = fmt_expr_full(obj, depth)
            let arg_strs = []
            if args != null {
                for a in args { arg_strs.push(fmt_expr_full(a, depth)) }
            }
            f"{os}.{method}({arg_strs.join(', ')})"
        },
        ExprKind::EFieldAccess(obj, field) => {
            const os = fmt_expr_full(obj, depth)
            f"{os}.{field}"
        },
        ExprKind::EIndex(obj, idx) => {
            const os = fmt_expr_full(obj, depth)
            const is = fmt_expr_full(idx, depth)
            f"{os}[{is}]"
        },
        ExprKind::EArrayLiteral(elems) => {
            if elems == null || len(elems) == 0 { return "[]" }
            let elem_strs = []
            for e in elems { elem_strs.push(fmt_expr_full(e, depth)) }
            const inline = "[" + elem_strs.join(", ") + "]"
            // Multi-line if too long
            if len(inline) > 80 {
                const indent = fmt_indent(depth + 1)
                const close_indent = fmt_indent(depth)
                let lines = []
                for es in elem_strs { lines.push(indent + es + ",") }
                return "[\n" + lines.join("\n") + "\n" + close_indent + "]"
            }
            inline
        },
        ExprKind::EMapLiteral(entries) => {
            if entries == null || len(entries) == 0 { return "{}" }
            let entry_strs = []
            for entry in entries {
                const ks = fmt_expr_full(entry[0], depth)
                const vs = fmt_expr_full(entry[1], depth)
                entry_strs.push(f"{ks}: {vs}")
            }
            const inline = "{" + entry_strs.join(", ") + "}"
            if len(inline) > 80 {
                const indent = fmt_indent(depth + 1)
                const close_indent = fmt_indent(depth)
                let lines = []
                for es in entry_strs { lines.push(indent + es + ",") }
                return "{\n" + lines.join("\n") + "\n" + close_indent + "}"
            }
            inline
        },
        ExprKind::EIfElse(cond, then_b, else_b) => {
            const cs = fmt_expr_full(cond, depth)
            const ts = fmt_block_inline(then_b, depth)
            if else_b != null {
                const es = fmt_block_inline(else_b, depth)
                f"if {cs} {ts} else {es}"
            } else {
                f"if {cs} {ts}"
            }
        },
        ExprKind::ELambda(params, body) => {
            let pstrs = []
            for p in params {
                if p.rest { pstrs.push("..." + p.name) }
                else { pstrs.push(p.name) }
            }
            if len(pstrs) == 1 && !params[0].rest {
                const bs = fmt_expr_full(body, depth)
                f"{pstrs[0]} => {bs}"
            } else {
                const bs = fmt_block_inline(body, depth)
                f"({pstrs.join(', ')}) => {bs}"
            }
        },
        ExprKind::EMatch(subject, arms) => {
            const ss = fmt_expr_full(subject, depth)
            let arm_strs = []
            for arm in arms {
                const indent = fmt_indent(depth + 1)
                arm_strs.push(indent + fmt_match_arm(arm, depth + 1))
            }
            const close_indent = fmt_indent(depth)
            f"match {ss} {{\n{arm_strs.join(',\n')}\n{close_indent}}}"
        },
        ExprKind::ERange(start, end_expr, inclusive) => {
            const ss = fmt_expr_full(start, depth)
            const es = fmt_expr_full(end_expr, depth)
            if inclusive { f"{ss}..={es}" } else { f"{ss}..{es}" }
        },
        ExprKind::EStringInterp(parts) => {
            let result = "f\""
            for part in parts {
                match part {
                    StringPart::LiteralPart(s) => { result = result + fmt_escape_string(s) },
                    StringPart::ExprPart(expr) => {
                        result = result + "{" + fmt_expr_full(expr, depth) + "}"
                    },
                }
            }
            result + "\""
        },
        ExprKind::ENullCoalesce(left, right) => {
            const ls = fmt_expr_full(left, depth)
            const rs = fmt_expr_full(right, depth)
            f"{ls} ?? {rs}"
        },
        ExprKind::EOptionalChain(obj, field) => {
            const os = fmt_expr_full(obj, depth)
            f"{os}?.{field}"
        },
        ExprKind::EPipe(left, right) => {
            const ls = fmt_expr_full(left, depth)
            const rs = fmt_expr_full(right, depth)
            f"{ls} |> {rs}"
        },
        ExprKind::ESpread(inner) => {
            "..." + fmt_expr_full(inner, depth)
        },
        ExprKind::ETupleLiteral(elems) => {
            let elem_strs = []
            for e in elems { elem_strs.push(fmt_expr_full(e, depth)) }
            "(" + elem_strs.join(", ") + ")"
        },
        ExprKind::EEnumConstruct(enum_name, variant, args) => {
            if args == null || len(args) == 0 {
                f"{enum_name}::{variant}"
            } else {
                let arg_strs = []
                for a in args { arg_strs.push(fmt_expr_full(a, depth)) }
                f"{enum_name}::{variant}({arg_strs.join(', ')})"
            }
        },
        ExprKind::EStructConstruct(name, field_pairs) => {
            let field_strs = []
            for pair in field_pairs {
                const fname = pair[0]
                const fval = fmt_expr_full(pair[1], depth)
                if fname == "__spread" {
                    field_strs.push("..." + fval)
                } else {
                    field_strs.push(f"{fname}: {fval}")
                }
            }
            const inline = name + " { " + field_strs.join(", ") + " }"
            if len(inline) > 80 {
                const indent = fmt_indent(depth + 1)
                const close_indent = fmt_indent(depth)
                let lines = []
                for fs in field_strs { lines.push(indent + fs + ",") }
                return name + " {\n" + lines.join("\n") + "\n" + close_indent + "}"
            }
            inline
        },
        ExprKind::EBlock(block) => fmt_block_inline(block, depth),
        ExprKind::ELoop(body) => "loop " + fmt_block_inline(body, depth),
        ExprKind::EListComp(elem, var_e, iter, cond) => {
            const es = fmt_expr_full(elem, depth)
            const vs = fmt_expr_full(var_e, depth)
            const is = fmt_expr_full(iter, depth)
            if cond != null {
                const cs = fmt_expr_full(cond, depth)
                f"[{es} for {vs} in {is} if {cs}]"
            } else {
                f"[{es} for {vs} in {is}]"
            }
        },
        _ => "/* expr */"
    }
}

func fmt_match_arm(arm, depth) {
    // Simplified: arm is [pattern, body]
    if typeof(arm) == "array" && len(arm) >= 2 {
        const ps = to_string(arm[0])
        const bs = fmt_expr_full(arm[1], depth)
        f"{ps} => {bs}"
    } else {
        "_ => /* arm */"
    }
}

func fmt_literal(lit) {
    match lit {
        Literal::LInt(n) => to_string(n),
        Literal::LFloat(f) => to_string(f),
        Literal::LString(s) => "\"" + fmt_escape_string(s) + "\"",
        Literal::LBool(b) => if b { "true" } else { "false" },
        _ => "null"
    }
}

func fmt_binop(op) {
    match op {
        BinOp::Add => "+",
        BinOp::Sub => "-",
        BinOp::Mul => "*",
        BinOp::Div => "/",
        BinOp::Mod => "%",
        BinOp::Eq => "==",
        BinOp::Ne => "!=",
        BinOp::Lt => "<",
        BinOp::Le => "<=",
        BinOp::Gt => ">",
        BinOp::Ge => ">=",
        BinOp::And => "&&",
        BinOp::Or => "||",
        _ => "?"
    }
}

func fmt_unop(op) {
    match op {
        UnOp::Not => "!",
        UnOp::Neg => "-",
        _ => "~"
    }
}

func fmt_escape_string(s) {
    let result = ""
    for c in s.chars() {
        if c == "\"" { result = result + "\\\"" }
        else if c == "\\" { result = result + "\\\\" }
        else if c == "\n" { result = result + "\\n" }
        else if c == "\r" { result = result + "\\r" }
        else if c == "\t" { result = result + "\\t" }
        else { result = result + c }
    }
    result
}

// ══════════════════════════════════════════════════════════════════════
// ── Comment Preservation ────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Extract comments from source (to be re-inserted after formatting)
func fmt_extract_comments(source) {
    let comments = []
    const lines = source.split("\n")
    let i = 0
    for ln in lines {
        const trimmed = ln.trim()
        if trimmed.starts_with("//") {
            comments.push({"line": i, "text": trimmed})
        }
        i = i + 1
    }
    comments
}

// ══════════════════════════════════════════════════════════════════════
// ── Import Grouping and Sorting ─────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func fmt_sort_imports(source) {
    const lines = source.split("\n")
    let import_lines = []
    let other_lines = []
    let in_imports = true

    let i = 0
    while i < len(lines) {
        const trimmed = lines[i].trim()
        if in_imports && (trimmed.starts_with("import ") || trimmed.starts_with("use ")) {
            import_lines.push(lines[i])
        } else {
            if in_imports && len(import_lines) > 0 { in_imports = false }
            other_lines.push(lines[i])
        }
        i = i + 1
    }

    if len(import_lines) == 0 { return source }

    // Sort imports alphabetically
    import_lines = import_lines.sort()

    // Group: std imports first, then others
    let std_imports = []
    let user_imports = []
    for il in import_lines {
        if il.trim().starts_with("import std.") {
            std_imports.push(il)
        } else {
            user_imports.push(il)
        }
    }

    let result = []
    for il in std_imports { result.push(il) }
    if len(std_imports) > 0 && len(user_imports) > 0 {
        result.push("") // blank line between groups
    }
    for il in user_imports { result.push(il) }
    if len(import_lines) > 0 { result.push("") } // blank after imports
    for ol in other_lines { result.push(ol) }

    result.join("\n")
}

// ══════════════════════════════════════════════════════════════════════
// ── Trailing Comma Handling ─────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Add trailing commas to multi-line constructs
func fmt_add_trailing_commas(source) {
    const lines = source.split("\n")
    let result = []
    let i = 0
    while i < len(lines) {
        let ln = lines[i]
        const trimmed = ln.trim()
        // If this line ends with a value and next line starts with ] or } or ),
        // ensure trailing comma
        if i + 1 < len(lines) {
            const next_trimmed = lines[i + 1].trim()
            if (next_trimmed == "]" || next_trimmed == "}" || next_trimmed == ")") {
                if len(trimmed) > 0 && !trimmed.ends_with(",") && !trimmed.ends_with("{") && !trimmed.ends_with("[") && !trimmed.starts_with("//") {
                    ln = ln + ","
                }
            }
        }
        result.push(ln)
        i = i + 1
    }
    result.join("\n")
}

// ══════════════════════════════════════════════════════════════════════
// ── Multi-line Expression Formatting ────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Break a long function call across multiple lines
func fmt_break_call(name, args, depth) {
    const indent = fmt_indent(depth + 1)
    const close_indent = fmt_indent(depth)
    let arg_strs = []
    for a in args { arg_strs.push(indent + fmt_expr_full(a, depth + 1) + ",") }
    name + "(\n" + arg_strs.join("\n") + "\n" + close_indent + ")"
}

// Break a long binary chain across multiple lines
func fmt_break_chain(parts, op_str, depth) {
    const indent = fmt_indent(depth + 1)
    let result = parts[0]
    let i = 1
    while i < len(parts) {
        result = result + "\n" + indent + op_str + " " + parts[i]
        i = i + 1
    }
    result
}

// ══════════════════════════════════════════════════════════════════════
// ── Doc Comment Formatting ──────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Format doc comments (/// style)
func fmt_doc_comment(lines, depth) {
    let result = []
    const indent = fmt_indent(depth)
    for ln in lines {
        const trimmed = ln.trim()
        if trimmed.starts_with("///") {
            result.push(indent + trimmed)
        } else if trimmed.starts_with("//") {
            result.push(indent + trimmed)
        }
    }
    result.join("\n")
}

// ══════════════════════════════════════════════════════════════════════
// ── Utility ─────────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func fmt_ensure_final_newline(source) {
    if len(source) == 0 { return "\n" }
    // Remove extra trailing newlines
    let trimmed = source
    while len(trimmed) > 1 && trimmed[len(trimmed) - 1] == "\n" && trimmed[len(trimmed) - 2] == "\n" {
        trimmed = trimmed.substring(0, len(trimmed) - 1)
    }
    if trimmed[len(trimmed) - 1] != "\n" {
        trimmed = trimmed + "\n"
    }
    trimmed
}
