// ══════════════════════════════════════════════════════════════════
// Full JSON Operations (deep path access, validation, diff)
// ══════════════════════════════════════════════════════════════════

// Deep get with dot-path: obj.foo.bar[0].baz
func op_json_get_path(obj, path) {
    let current = obj
    const parts = path.split(".")
    for part in parts {
        if current == null { return null }
        // Check for array index: "items[0]"
        if part.contains("[") {
            const bracket_idx = part.index_of("[")
            const key = part.slice(0, bracket_idx)
            const idx_str = part.slice(bracket_idx + 1, len(part) - 1)
            const idx = parse_int(idx_str)
            if typeof(current) == "map" && current.has(key) {
                current = current[key]
            } else { return null }
            if typeof(current) == "array" && idx >= 0 && idx < len(current) {
                current = current[idx]
            } else { return null }
        } else {
            if typeof(current) == "map" && current.has(part) {
                current = current[part]
            } else { return null }
        }
    }
    current
}

// Deep set with dot-path
func op_json_set_path(obj, path, value) {
    const parts = path.split(".")
    if len(parts) == 1 {
        obj[parts[0]] = value
        return obj
    }
    // Navigate to parent
    let current = obj
    let i = 0
    while i < len(parts) - 1 {
        const part = parts[i]
        if !current.has(part) { current[part] = {} }
        current = current[part]
        i = i + 1
    }
    current[parts[len(parts) - 1]] = value
    obj
}

// JSON diff: returns list of differences between two JSON values
func op_json_diff(a, b) {
    let diffs = []
    op_json_diff_recursive(a, b, "", diffs)
    diffs
}

func op_json_diff_recursive(a, b, path, diffs) {
    if a == b { return null }
    if typeof(a) != typeof(b) {
        diffs.push({"path": path, "type": "type_change", "from": typeof(a), "to": typeof(b)})
        return null
    }
    if typeof(a) == "map" && typeof(b) == "map" {
        // Check keys in a not in b
        for k in a.keys() {
            if k == "__s" || k == "__init" { continue }
            const child_path = if len(path) > 0 { path + "." + k } else { k }
            if !b.has(k) {
                diffs.push({"path": child_path, "type": "removed", "value": a[k]})
            } else {
                op_json_diff_recursive(a[k], b[k], child_path, diffs)
            }
        }
        // Check keys in b not in a
        for k in b.keys() {
            if k == "__s" || k == "__init" { continue }
            if !a.has(k) {
                const child_path = if len(path) > 0 { path + "." + k } else { k }
                diffs.push({"path": child_path, "type": "added", "value": b[k]})
            }
        }
    } else if typeof(a) == "array" && typeof(b) == "array" {
        const max_len = if len(a) > len(b) { len(a) } else { len(b) }
        let i = 0
        while i < max_len {
            const child_path = path + "[" + to_string(i) + "]"
            if i >= len(a) {
                diffs.push({"path": child_path, "type": "added", "value": b[i]})
            } else if i >= len(b) {
                diffs.push({"path": child_path, "type": "removed", "value": a[i]})
            } else {
                op_json_diff_recursive(a[i], b[i], child_path, diffs)
            }
            i = i + 1
        }
    } else {
        diffs.push({"path": path, "type": "changed", "from": a, "to": b})
    }
}

// JSON patch (RFC 6902 subset)
func op_json_patch(obj, patches) {
    let result = obj
    for patch in patches {
        const op = patch["op"]
        const path = patch["path"]
        match op {
            "add" => { result = op_json_set_path(result, path, patch["value"]) },
            "remove" => {
                const parts = path.split(".")
                if len(parts) == 1 {
                    result.delete(parts[0])
                }
            },
            "replace" => { result = op_json_set_path(result, path, patch["value"]) },
            _ => {}
        }
    }
    result
}

