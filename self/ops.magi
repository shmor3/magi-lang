// ══════════════════════════════════════════════════════════════════

func op_big_new(value) { big_new(value) }
func op_big_add(a, b) { big_add(a, b) }
func op_big_sub(a, b) { big_sub(a, b) }
func op_big_mul(a, b) { big_mul(a, b) }
func op_big_div(a, b) { big_div(a, b) }
func op_big_mod(a, b) { big_mod(a, b) }
func op_big_pow(a, b) { big_pow(a, b) }
