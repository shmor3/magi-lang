// ══════════════════════════════════════════════════════════════════
// Path Operations
// ══════════════════════════════════════════════════════════════════

func op_path_join(args) {
    const parts = args
    let result = ""
    for p in parts {
        const s = to_string(p)
        if len(result) == 0 { result = s }
        else if result.ends_with("/") { result = result + s }
        else { result = result + "/" + s }
    }
    result
}

func op_path_dir(args) {
    const p = op_arg(args, 0, "")
    const parts = p.split("/")
    if len(parts) <= 1 { return "." }
    parts.slice(0, len(parts) - 1).join("/")
}

func op_path_base(args) {
    const p = op_arg(args, 0, "")
    const parts = p.split("/")
    parts[len(parts) - 1]
}

func op_path_ext(args) {
    const p = op_arg(args, 0, "")
    const base = op_path_base([p])
    const parts = base.split(".")
    if len(parts) <= 1 { return "" }
    "." + parts[len(parts) - 1]
}

func op_path_stem(args) {
    const p = op_arg(args, 0, "")
    const base = op_path_base([p])
    const parts = base.split(".")
    if len(parts) <= 1 { return base }
    parts.slice(0, len(parts) - 1).join(".")
}

func op_path_abs(args) {
    const p = op_arg(args, 0, "")
    path_abs(p)
}

func op_path_clean(args) {
    const p = op_arg(args, 0, "")
    // Simple path cleaning: remove double slashes and trailing slashes
    let result = p.replace("//", "/")
    while result.ends_with("/") && len(result) > 1 {
        result = result.slice(0, len(result) - 1)
    }
    result
}

