    if host == "" { panic("tcp_connect: host required") }
    const id = f"tcp:{tcp_next_id}"
    tcp_next_id = tcp_next_id + 1
    const result = tcp_connect(host, port)
    if typeof(result) == "string" { return result }
    tcp_connections[id] = {"host": host, "port": port, "connected": true}
    id
}

func op_tcp_write(args) {
    const conn_id = op_arg(args, 0, "")
