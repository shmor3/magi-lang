}

func op_env_get(args) {
    const name = op_arg(args, 0, "")
    const default_val = op_arg(args, 1, "")
    const result = env_get(name)
    if result == null || result == "" { default_val } else { result }
}

func op_env_set(args) {
    const name = op_arg(args, 0, "")
    const value = op_arg(args, 1, "")
    env_set(name, value)
    null
}

func op_env_all(args) {
    env_all()
}

func op_os_exit(args) {
    const code = op_arg(args, 0, 0)
