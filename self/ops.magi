    // ── Reflect (8) ──────────────────────────────────────────────

    "reflect_type_of" => typeof(args[0]),
    "reflect_type_name" => {
        const v = args[0]
        const t = typeof(v)
        if t == "map" && v.has("__struct") { v["__struct"] }
        else if t == "map" && v.has("__enum") { v["__enum"] }
        else { t }
    },
    "reflect_is_type" => typeof(args[0]) == args[1],
    "reflect_fields" => {
        const v = args[0]
        if typeof(v) == "map" {
            v.keys().filter(k => !k.starts_with("__"))
        } else {
            []
        }
    },
    "reflect_has_field" => {
        const v = args[0]
        const field = to_string(args[1])
        typeof(v) == "map" && v.has(field)
    },
    "reflect_callable" => {
        const v = args[0]
        typeof(v) == "map" && v.has("__lambda")
    },
    "reflect_arity" => {
        const v = args[0]
        if typeof(v) == "map" && v.has("params") {
            len(v["params"])
        } else {
            0
        }
    },
    "reflect_inspect" => reflect_inspect(args[0]),

    // ── Collections (8) ──────────────────────────────────────────

    "set_from" => {
        const arr = args[0]
        let seen = {}
        let result = []
        for item in arr {
            const k = to_string(item)
            if !seen.has(k) {
                seen[k] = true
                result.push(item)
            }
        }
        result
    },
    "set_union" => {
        const a = args[0]
        const b = args[1]
        let seen = {}
        let result = []
        for item in a {
            const k = to_string(item)
            if !seen.has(k) {
                seen[k] = true
                result.push(item)
            }
        }
        for item in b {
            const k = to_string(item)
            if !seen.has(k) {
                seen[k] = true
                result.push(item)
            }
        }
        result
    },
    "set_intersection" => {
        const a = args[0]
        const b = args[1]
        let b_set = {}
        for item in b { b_set[to_string(item)] = true }
        let result = []
        for item in a {
            if b_set.has(to_string(item)) {
                result.push(item)
            }
        }
        result
    },
    "set_difference" => {
        const a = args[0]
        const b = args[1]
        let b_set = {}
        for item in b { b_set[to_string(item)] = true }
        let result = []
        for item in a {
            if !b_set.has(to_string(item)) {
                result.push(item)
            }
        }
        result
    },
    "set_symmetric_difference" => {
        const a = args[0]
        const b = args[1]
        let a_set = {}
        let b_set = {}
        for item in a { a_set[to_string(item)] = true }
        for item in b { b_set[to_string(item)] = true }
        let result = []
        for item in a {
            if !b_set.has(to_string(item)) { result.push(item) }
        }
        for item in b {
            if !a_set.has(to_string(item)) { result.push(item) }
        }
        result
    },
    "counter" => {
        let counts = {}
        for item in args[0] {
            const k = to_string(item)
            if counts.has(k) { counts[k] = counts[k] + 1 }
            else { counts[k] = 1 }
        }
        counts
    },
    "most_common" => {
        const arr = args[0]
        const n = op_to_i64(op_arg(args, 1, 1))
        let counts = {}
        for item in arr {
            const k = to_string(item)
            if counts.has(k) { counts[k] = counts[k] + 1 }
            else { counts[k] = 1 }
        }
        let entries = []
        for k in counts.keys() {
            entries.push([k, counts[k]])
        }
        entries = entries.sort()
        entries = entries.reverse()
        entries.slice(0, n)
    },
    "ordered_map" => {
        // Return args[0] as-is (maps are already ordered in MAGI)
        args[0]
    },

    // ── Sort (8) ─────────────────────────────────────────────────

    "sort_asc" => args[0].sort(),
    "sort_desc" => args[0].sort().reverse(),
    "sort_by" => {
        const arr = args[0]
        const fn_val = args[1]
        let decorated = arr.map(x => [fn_val(x), x])
        decorated = decorated.sort()
        decorated.map(pair => pair[1])
    },
    "sort_by_key" => {
        const arr = args[0]
        const key = args[1]
        let decorated = arr.map(x => [x[key], x])
        decorated = decorated.sort()
        decorated.map(pair => pair[1])
    },
    "stable_sort" => args[0].sort(),
    "is_sorted" => {
        const arr = args[0]
        let i = 1
        while i < len(arr) {
            if arr[i] < arr[i - 1] { return false }
            i = i + 1
        }
        true
    },
    "binary_search" => {
        const arr = args[0]
        const target = args[1]
        let lo = 0
        let hi = len(arr) - 1
        while lo <= hi {
            const mid = (lo + hi) / 2
            if arr[mid] == target { return mid }
            if arr[mid] < target { lo = mid + 1 }
            else { hi = mid - 1 }
        }
        -1
    },
    "sort_reverse" => args[0].reverse(),

    // ── Subprocess (3) ───────────────────────────────────────────

    "exec" => exec_cmd(args[0], op_arg(args, 1, [])),
    "exec_status" => exec_status(args[0], op_arg(args, 1, [])),
    "exec_output" => exec_output(args[0], op_arg(args, 1, [])),

    // ── Sync (6) ─────────────────────────────────────────────────

    "mutex_new" => mutex_new(),
    "mutex_lock" => mutex_lock(args[0]),
    "mutex_unlock" => mutex_unlock(args[0]),
    "waitgroup_new" => waitgroup_new(),
    "waitgroup_done" => waitgroup_done(args[0]),
    "waitgroup_wait" => waitgroup_wait(args[0]),

    // ── Concurrency (1) ──────────────────────────────────────────

    "await_all" => await_all(args[0]),

    // ── Log (4) ──────────────────────────────────────────────────

    "log_info" => {
        println(f"[INFO] {to_string(args[0])}")
        null
    },
    "log_warn" => {
        println(f"[WARN] {to_string(args[0])}")
        null
    },
    "log_error" => {
        println(f"[ERROR] {to_string(args[0])}")
        null
    },
    "log_debug" => {
        println(f"[DEBUG] {to_string(args[0])}")
        null
    },

    // ── Itertools (5) ────────────────────────────────────────────

    "iter_chain" => {
        let result = []
        for arr in args {
            if typeof(arr) == "array" {
                result = result.concat(arr)
            }
        }
        result
    },
    "iter_cycle" => {
        // iter_cycle(arr, n) - repeat array n times
        const arr = args[0]
        const n = op_to_i64(args[1])
        let result = []
        let i = 0
        while i < n {
            result = result.concat(arr)
            i = i + 1
        }
        result
    },
    "iter_repeat" => {
        // iter_repeat(val, n) - create array of val repeated n times
        const val = args[0]
        const n = op_to_i64(args[1])
        let result = []
        let i = 0
        while i < n {
            result.push(val)
            i = i + 1
        }
        result
    },
    "iter_product" => {
        // Cartesian product of two arrays
        const a = args[0]
        const b = args[1]
        let result = []
        for x in a {
            for y in b {
                result.push([x, y])
            }
        }
        result
    },
    "iter_pairwise" => {
        // Adjacent pairs
        const arr = args[0]
        let result = []
        let i = 0
        while i + 1 < len(arr) {
            result.push([arr[i], arr[i + 1]])
            i = i + 1
        }
        result
    },

    // ── Template (1) ─────────────────────────────────────────────

    "template_render" => template_render(args[0], args[1]),

    // ── Flag (2) ─────────────────────────────────────────────────

    "flag_parse" => flag_parse(args[0]),
    "flag_args" => flag_args(),

    // ── Additional Math (7) ──────────────────────────────────────

    "gamma" => gamma(op_to_f64(args[0])),
    "lgamma" => lgamma(op_to_f64(args[0])),
    "erf" => erf(op_to_f64(args[0])),
    "erfc" => erfc(op_to_f64(args[0])),
    "expm1" => expm1(op_to_f64(args[0])),
    "nextafter" => nextafter(op_to_f64(args[0]), op_to_f64(args[1])),
    "signbit" => signbit(op_to_f64(args[0])),

    // ── Additional OS (3) ────────────────────────────────────────

    "chown" => chown(args[0], op_to_i64(args[1]), op_to_i64(args[2])),
    "hardlink" => hardlink(args[0], args[1]),
    "pipe" => pipe(),

    // ── Additional strconv (2) ───────────────────────────────────

    "format_float" => format_float(op_to_f64(args[0]), op_arg(args, 1, "g"), op_arg(args, 2, -1)),
    "parse_uint" => parse_uint(args[0], op_arg(args, 1, 10)),

    // ── Additional CLI (3) ───────────────────────────────────────

    "cli_fix" => cli_fix(args[0]),
    "cli_clean" => cli_clean(args[0]),
    "cli_tree" => cli_tree(args[0]),

    // ── Platform: Terminal (4) ───────────────────────────────────

    "raw_mode_enable" => raw_mode_enable(),
    "raw_mode_disable" => raw_mode_disable(),
    "read_byte" => read_byte(),
    "read_byte_timeout" => read_byte_timeout(op_to_i64(args[0])),

    // ── Platform: SDL2 Graphics (11) ─────────────────────────────

    "sdl_init" => sdl_init(args[0], op_to_i64(args[1]), op_to_i64(args[2])),
    "sdl_set_color" => sdl_set_color(op_to_i64(args[0]), op_to_i64(args[1]), op_to_i64(args[2]), op_to_i64(args[3])),
    "sdl_clear" => sdl_clear(),
    "sdl_present" => sdl_present(),
    "sdl_draw_pixel" => sdl_draw_pixel(op_to_i64(args[0]), op_to_i64(args[1])),
    "sdl_draw_line" => sdl_draw_line(op_to_i64(args[0]), op_to_i64(args[1]), op_to_i64(args[2]), op_to_i64(args[3])),
    "sdl_fill_rect" => sdl_fill_rect(op_to_i64(args[0]), op_to_i64(args[1]), op_to_i64(args[2]), op_to_i64(args[3])),
    "sdl_poll_event" => sdl_poll_event(),
    "sdl_delay" => sdl_delay(op_to_i64(args[0])),
    "sdl_ticks" => sdl_ticks(),
    "sdl_destroy" => sdl_destroy(),

    // ── Platform: Audio (4) ──────────────────────────────────────

    "audio_stream_new" => audio_stream_new(op_to_i64(args[0]), op_to_i64(args[1])),
    "audio_write_samples" => audio_write_samples(args[0], args[1]),
    "audio_drain" => audio_drain(args[0]),
    "audio_close" => audio_close(args[0]),

    // ── Platform: WebGPU (12) ────────────────────────────────────

    "gpu_init" => gpu_init(args[0]),
    "gpu_create_buffer" => gpu_create_buffer(args[0], args[1]),
    "gpu_create_shader" => gpu_create_shader(args[0]),
    "gpu_create_pipeline" => gpu_create_pipeline(args[0]),
    "gpu_begin_render_pass" => gpu_begin_render_pass(args[0]),
    "gpu_draw" => gpu_draw(args[0], op_to_i64(args[1])),
    "gpu_end_render_pass" => gpu_end_render_pass(args[0]),
    "gpu_submit" => gpu_submit(args[0]),
    "gpu_present" => gpu_present(args[0]),
    "gpu_write_buffer" => gpu_write_buffer(args[0], args[1]),
    "gpu_create_texture" => gpu_create_texture(args[0]),
    "gpu_destroy" => gpu_destroy(args[0]),

    // ── Fallback ─────────────────────────────────────────────────

    _ => panic(f"unknown operation: {op_name}"),

    }
}
