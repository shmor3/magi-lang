func op_base64_encode(data) { base64_encode(data) }
func op_base64_decode(data) { base64_decode(data) }
func op_hex_encode(data) { hex_encode(data) }
func op_hex_decode(data) { hex_decode(data) }
func op_url_encode(s) { url_encode(s) }
func op_url_decode(s) { url_decode(s) }
