}

func op_tcp_close(args) {
    const conn_id = op_arg(args, 0, "")
    if conn_id == "" { return null }
    tcp_close(conn_id)
    if tcp_connections.has(conn_id) {
        tcp_connections[conn_id]["connected"] = false
    }
    null
}

