// ══════════════════════════════════════════════════════════════════
// Complex Number Operations
// ══════════════════════════════════════════════════════════════════

func op_complex_new(re, im) { {"re": op_to_f64(re), "im": op_to_f64(im)} }
func op_complex_add(a, b) { {"re": a["re"] + b["re"], "im": a["im"] + b["im"]} }
func op_complex_sub(a, b) { {"re": a["re"] - b["re"], "im": a["im"] - b["im"]} }
func op_complex_mul(a, b) {
    {"re": a["re"] * b["re"] - a["im"] * b["im"],
     "im": a["re"] * b["im"] + a["im"] * b["re"]}
}
func op_complex_div(a, b) {
    const denom = b["re"] * b["re"] + b["im"] * b["im"]
    {"re": (a["re"] * b["re"] + a["im"] * b["im"]) / denom,
     "im": (a["im"] * b["re"] - a["re"] * b["im"]) / denom}
}
func op_complex_abs(c) { sqrt(c["re"] * c["re"] + c["im"] * c["im"]) }
func op_complex_conjugate(c) { {"re": c["re"], "im": 0.0 - c["im"]} }

// ══════════════════════════════════════════════════════════════════
// Memoization Operation
// ══════════════════════════════════════════════════════════════════

func op_memoize(fn_val) {
    let cache = {}
    func memoized(...args) {
        const key = to_json(args)
        if cache.has(key) { return cache[key] }
        const result = fn_val(...args)
        cache[key] = result
        result
    }
    memoized
}

// ══════════════════════════════════════════════════════════════════
// Retry/Backoff Operations
// ══════════════════════════════════════════════════════════════════

func op_retry(fn_val, max_retries, delay_ms) {
    let attempts = 0
    while attempts < max_retries {
        let result = null
        let err = null
        // In self-hosted, try-catch is simplified
        result = fn_val()
        if result != null { return result }
        attempts = attempts + 1
        if attempts < max_retries && delay_ms > 0 {
            sleep(delay_ms * attempts) // Exponential backoff
        }
    }
    null
}

// ══════════════════════════════════════════════════════════════════
// Rate Limiter
// ══════════════════════════════════════════════════════════════════

func op_rate_limiter_new(max_requests, window_ms) {
    {"__rate_limiter": true, "max": max_requests, "window": window_ms, "timestamps": []}
}

func op_rate_limiter_allow(limiter) {
    const now = now_timestamp()
    const window = limiter["window"]
    // Remove expired timestamps
    let timestamps = limiter["timestamps"].filter(t => now - t < window)
    if len(timestamps) >= limiter["max"] {
        limiter["timestamps"] = timestamps
        return false
    }
    timestamps.push(now)
    limiter["timestamps"] = timestamps
    true
}

// ══════════════════════════════════════════════════════════════════
// Circuit Breaker
// ══════════════════════════════════════════════════════════════════

func op_circuit_breaker_new(threshold, reset_ms) {
    {"__circuit_breaker": true, "threshold": threshold, "reset_ms": reset_ms,
     "failures": 0, "state": "closed", "last_failure": 0}
}

func op_circuit_breaker_call(cb, fn_val) {
    if cb["state"] == "open" {
        const now = now_timestamp()
        if now - cb["last_failure"] > cb["reset_ms"] {
            cb["state"] = "half-open"
        } else {
            return {"error": "circuit breaker is open"}
        }
    }
    const result = fn_val()
    if result == null || (typeof(result) == "map" && result.has("error")) {
        cb["failures"] = cb["failures"] + 1
        cb["last_failure"] = now_timestamp()
        if cb["failures"] >= cb["threshold"] { cb["state"] = "open" }
        return result
    }
    cb["failures"] = 0
    cb["state"] = "closed"
    result
}

// ══════════════════════════════════════════════════════════════════
// Debounce/Throttle Operations
// ══════════════════════════════════════════════════════════════════

func op_debounce(fn_val, delay_ms) {
    let last_call = 0
    func debounced(...args) {
        const now = now_timestamp()
        if now - last_call < delay_ms { return null }
        last_call = now
        fn_val(...args)
    }
    debounced
}

func op_throttle(fn_val, interval_ms) {
    let last_call = 0
    func throttled(...args) {
        const now = now_timestamp()
        if now - last_call >= interval_ms {
            last_call = now
            fn_val(...args)
        }
    }
    throttled
}

// ══════════════════════════════════════════════════════════════════
// Full Pipeline/Compose Operations
// ══════════════════════════════════════════════════════════════════

func op_pipe_value(value, functions) {
    let result = value
    for fn_val in functions {
        result = fn_val(result)
    }
    result
}

func op_compose(functions) {
    func composed(value) {
        let result = value
        let i = len(functions) - 1
        while i >= 0 {
            result = functions[i](result)
            i = i - 1
        }
        result
    }
    composed
}

func op_partial(fn_val, bound_args) {
    func partial_fn(...args) {
        const all_args = bound_args.concat(args)
        fn_val(...all_args)
    }
    partial_fn
}

func op_curry(fn_val, arity) {
    func curried(...args) {
        if len(args) >= arity {
            fn_val(...args)
        } else {
            func next(...more_args) {
                curried(...args.concat(more_args))
            }
            next
        }
    }
    curried
}

// ══════════════════════════════════════════════════════════════════
// Full Iterator Protocol
// ══════════════════════════════════════════════════════════════════

func op_iter_from_array(arr) {
    {"__iter": true, "data": arr, "index": 0}
}

func op_iter_next(iter) {
    if iter["index"] >= len(iter["data"]) { return {"done": true, "value": null} }
    const val = iter["data"][iter["index"]]
    iter["index"] = iter["index"] + 1
    {"done": false, "value": val}
}

func op_iter_to_array(iter) {
    let result = []
    while true {
        const item = op_iter_next(iter)
        if item["done"] { break }
        result.push(item["value"])
    }
    result
}

func op_iter_map(iter, fn_val) {
    let result = []
    while true {
        const item = op_iter_next(iter)
        if item["done"] { break }
        result.push(fn_val(item["value"]))
    }
    op_iter_from_array(result)
}

func op_iter_filter(iter, fn_val) {
    let result = []
    while true {
        const item = op_iter_next(iter)
        if item["done"] { break }
        if fn_val(item["value"]) { result.push(item["value"]) }
    }
    op_iter_from_array(result)
}

func op_iter_take(iter, n) {
    let result = []
    let count = 0
    while count < n {
        const item = op_iter_next(iter)
        if item["done"] { break }
        result.push(item["value"])
        count = count + 1
    }
    op_iter_from_array(result)
}

func op_iter_skip(iter, n) {
    let count = 0
    while count < n {
        const item = op_iter_next(iter)
        if item["done"] { break }
        count = count + 1
    }
    iter
}

func op_iter_zip_with(iter_a, iter_b) {
    let result = []
    while true {
        const a = op_iter_next(iter_a)
        const b = op_iter_next(iter_b)
        if a["done"] || b["done"] { break }
        result.push([a["value"], b["value"]])
    }
    op_iter_from_array(result)
}

func op_iter_reduce(iter, fn_val, initial) {
    let acc = initial
    while true {
        const item = op_iter_next(iter)
        if item["done"] { break }
        acc = fn_val(acc, item["value"])
    }
    acc
}

func op_iter_count(iter) {
    let count = 0
    while true {
        const item = op_iter_next(iter)
        if item["done"] { break }
        count = count + 1
    }
    count
}

func op_iter_flat_map(iter, fn_val) {
    let result = []
    while true {
        const item = op_iter_next(iter)
        if item["done"] { break }
        const mapped = fn_val(item["value"])
        if typeof(mapped) == "array" {
            result = result.concat(mapped)
        } else {
            result.push(mapped)
        }
    }
    op_iter_from_array(result)
}

// ══════════════════════════════════════════════════════════════════
// Full State Machine
// ══════════════════════════════════════════════════════════════════

func op_state_machine_new(initial_state, transitions) {
    {"__fsm": true, "state": initial_state, "transitions": transitions, "history": [initial_state]}
}

func op_state_machine_transition(fsm, event) {
    const current = fsm["state"]
    const transitions = fsm["transitions"]
    const key = current + ":" + to_string(event)
    if transitions.has(key) {
        const next_state = transitions[key]
        fsm["state"] = next_state
        fsm["history"].push(next_state)
        return next_state
    }
    null // Invalid transition
}

func op_state_machine_state(fsm) { fsm["state"] }
func op_state_machine_history(fsm) { fsm["history"] }
func op_state_machine_can_transition(fsm, event) {
    const key = fsm["state"] + ":" + to_string(event)
    fsm["transitions"].has(key)
}

// ══════════════════════════════════════════════════════════════════
// Full Trie (Prefix Tree) Operations
// ══════════════════════════════════════════════════════════════════

func op_trie_new() { {"__trie": true, "children": {}, "is_end": false, "value": null} }

func op_trie_insert(trie, key, value) {
    let node = trie
    for c in key.chars() {
        if !node["children"].has(c) {
            node["children"][c] = {"children": {}, "is_end": false, "value": null}
        }
        node = node["children"][c]
    }
    node["is_end"] = true
    node["value"] = value
    trie
}

func op_trie_get(trie, key) {
    let node = trie
    for c in key.chars() {
        if !node["children"].has(c) { return null }
        node = node["children"][c]
    }
    if node["is_end"] { node["value"] } else { null }
}

func op_trie_has(trie, key) {
    let node = trie
    for c in key.chars() {
        if !node["children"].has(c) { return false }
        node = node["children"][c]
    }
    node["is_end"]
}

func op_trie_starts_with(trie, prefix) {
    let node = trie
    for c in prefix.chars() {
        if !node["children"].has(c) { return false }
        node = node["children"][c]
    }
    true
}

func op_trie_collect_keys(trie, prefix) {
    let results = []
    op_trie_collect_helper(trie, prefix, results)
    results
}

func op_trie_collect_helper(node, prefix, results) {
    if node["is_end"] { results.push(prefix) }
    for c in node["children"].keys() {
        op_trie_collect_helper(node["children"][c], prefix + c, results)
    }
}

// ══════════════════════════════════════════════════════════════════
// Full Diff/Patch Operations (for text)
// ══════════════════════════════════════════════════════════════════

func op_text_diff(old_text, new_text) {
    const old_lines = old_text.split("\n")
    const new_lines = new_text.split("\n")
    let diffs = []

    // Simple line-by-line diff
    const max_lines = if len(old_lines) > len(new_lines) { len(old_lines) } else { len(new_lines) }
    let i = 0
    while i < max_lines {
        const old_line = if i < len(old_lines) { old_lines[i] } else { null }
        const new_line = if i < len(new_lines) { new_lines[i] } else { null }
        if old_line != new_line {
            if old_line == null {
                diffs.push({"type": "add", "line": i + 1, "content": new_line})
            } else if new_line == null {
                diffs.push({"type": "delete", "line": i + 1, "content": old_line})
            } else {
                diffs.push({"type": "change", "line": i + 1, "old": old_line, "new": new_line})
            }
        }
        i = i + 1
    }
    diffs
}

func op_text_patch(text, patches) {
    let lines = text.split("\n")
    // Apply patches in reverse order (to preserve line numbers)
    let sorted_patches = patches.sort()
    sorted_patches = sorted_patches.reverse()
    for patch in sorted_patches {
        const idx = patch["line"] - 1
        match patch["type"] {
            "add" => {
                if idx >= len(lines) { lines.push(patch["content"]) }
                else {
                    const before = lines.slice(0, idx)
                    const after = lines.slice(idx, len(lines))
                    lines = before.concat([patch["content"]]).concat(after)
                }
            },
            "delete" => {
                if idx >= 0 && idx < len(lines) {
                    lines = lines.slice(0, idx).concat(lines.slice(idx + 1, len(lines)))
                }
            },
            "change" => {
                if idx >= 0 && idx < len(lines) {
                    lines[idx] = patch["new"]
                }
            },
            _ => {}
        }
    }
    lines.join("\n")
}

// ══════════════════════════════════════════════════════════════════
// Full Color Operations (for terminal output)
// ══════════════════════════════════════════════════════════════════

func op_color_red(s) { "\x1b[31m" + s + "\x1b[0m" }
func op_color_green(s) { "\x1b[32m" + s + "\x1b[0m" }
func op_color_yellow(s) { "\x1b[33m" + s + "\x1b[0m" }
func op_color_blue(s) { "\x1b[34m" + s + "\x1b[0m" }
func op_color_magenta(s) { "\x1b[35m" + s + "\x1b[0m" }
func op_color_cyan(s) { "\x1b[36m" + s + "\x1b[0m" }
func op_color_white(s) { "\x1b[37m" + s + "\x1b[0m" }
func op_color_bold(s) { "\x1b[1m" + s + "\x1b[0m" }
func op_color_dim(s) { "\x1b[2m" + s + "\x1b[0m" }
func op_color_underline(s) { "\x1b[4m" + s + "\x1b[0m" }
func op_color_rgb(s, r, g, b) { f"\x1b[38;2;{r};{g};{b}m{s}\x1b[0m" }
func op_color_bg_rgb(s, r, g, b) { f"\x1b[48;2;{r};{g};{b}m{s}\x1b[0m" }
func op_color_strip(s) {
    // Remove ANSI escape sequences
    let result = ""
    let in_escape = false
    for c in s.chars() {
        if c == "\x1b" { in_escape = true; continue }
        if in_escape {
            if c == "m" { in_escape = false }
            continue
        }
        result = result + c
    }
    result
}

// ══════════════════════════════════════════════════════════════════
// Full Table Formatting
// ══════════════════════════════════════════════════════════════════

func op_table_format(headers, rows) {
    // Calculate column widths
    let widths = []
    for h in headers { widths.push(len(h)) }
    for row in rows {
        let i = 0
        while i < len(row) {
            const cell = to_string(row[i])
            if i < len(widths) {
                if len(cell) > widths[i] { widths[i] = len(cell) }
            } else {
                widths.push(len(cell))
            }
            i = i + 1
        }
    }

    // Build header
    let header_cells = []
    let i = 0
    while i < len(headers) {
        header_cells.push(pad_end(headers[i], widths[i], " "))
        i = i + 1
    }
    const header_line = "| " + header_cells.join(" | ") + " |"

    // Build separator
    let sep_cells = []
    for w in widths { sep_cells.push(op_string_repeat("-", w)) }
    const sep_line = "|-" + sep_cells.join("-|-") + "-|"

    // Build rows
    let row_lines = []
    for row in rows {
        let cells = []
        let j = 0
        while j < len(widths) {
            const val = if j < len(row) { to_string(row[j]) } else { "" }
            cells.push(pad_end(val, widths[j], " "))
            j = j + 1
        }
        row_lines.push("| " + cells.join(" | ") + " |")
    }

    header_line + "\n" + sep_line + "\n" + row_lines.join("\n")
}

// ══════════════════════════════════════════════════════════════════
// Full Levenshtein Distance (for typo suggestions)
// ══════════════════════════════════════════════════════════════════

func op_levenshtein_distance(a, b) {
    const m = len(a)
    const n = len(b)
    if m == 0 { return n }
    if n == 0 { return m }

    // Build distance matrix
    let prev = []
    let i = 0
    while i <= n { prev.push(i); i = i + 1 }

    i = 1
    while i <= m {
        let curr = [i]
        let j = 1
        while j <= n {
            const cost = if a[i - 1] == b[j - 1] { 0 } else { 1 }
            const del = prev[j] + 1
            const ins = curr[j - 1] + 1
            const sub = prev[j - 1] + cost
            let min_val = del
            if ins < min_val { min_val = ins }
            if sub < min_val { min_val = sub }
            curr.push(min_val)
            j = j + 1
        }
        prev = curr
        i = i + 1
    }
    prev[n]
}

// Find closest match from candidates
func op_did_you_mean(target, candidates, max_distance) {
    let best = null
    let best_dist = max_distance + 1
    for candidate in candidates {
        const dist = op_levenshtein_distance(target, candidate)
        if dist < best_dist {
            best_dist = dist
            best = candidate
        }
    }
    best
}

// ══════════════════════════════════════════════════════════════════
// Full LinkedList Operations
// ══════════════════════════════════════════════════════════════════

func op_linked_list_new() { {"__ll": true, "head": null, "size": 0} }

func op_linked_list_push_front(list, value) {
    const node = {"value": value, "next": list["head"]}
    list["head"] = node
    list["size"] = list["size"] + 1
    list
}

func op_linked_list_push_back(list, value) {
    const node = {"value": value, "next": null}
    if list["head"] == null {
        list["head"] = node
    } else {
        let current = list["head"]
        while current["next"] != null { current = current["next"] }
        current["next"] = node
    }
    list["size"] = list["size"] + 1
    list
}

func op_linked_list_pop_front(list) {
    if list["head"] == null { return null }
    const val = list["head"]["value"]
    list["head"] = list["head"]["next"]
    list["size"] = list["size"] - 1
    val
}

func op_linked_list_peek(list) {
    if list["head"] == null { return null }
    list["head"]["value"]
}

func op_linked_list_to_array(list) {
    let result = []
    let current = list["head"]
    while current != null {
        result.push(current["value"])
        current = current["next"]
    }
    result
}

func op_linked_list_contains(list, value) {
    let current = list["head"]
    while current != null {
        if current["value"] == value { return true }
        current = current["next"]
    }
    false
}

func op_linked_list_reverse(list) {
    let prev = null
    let current = list["head"]
    while current != null {
        const next = current["next"]
        current["next"] = prev
        prev = current
        current = next
    }
    list["head"] = prev
    list
}

func op_linked_list_size(list) { list["size"] }

// ══════════════════════════════════════════════════════════════════
// Full Deque (Double-Ended Queue)
// ══════════════════════════════════════════════════════════════════

func op_deque_new() { {"__deque": true, "data": []} }
func op_deque_push_front(d, value) {
    d["data"] = [value].concat(d["data"])
    d
}
func op_deque_push_back(d, value) {
    d["data"].push(value)
    d
}
func op_deque_pop_front(d) {
    if len(d["data"]) == 0 { return null }
    const val = d["data"][0]
    d["data"] = d["data"].slice(1, len(d["data"]))
    val
}
func op_deque_pop_back(d) {
    if len(d["data"]) == 0 { return null }
    d["data"].pop()
}
func op_deque_peek_front(d) {
    if len(d["data"]) == 0 { return null }
    d["data"][0]
}
func op_deque_peek_back(d) {
    if len(d["data"]) == 0 { return null }
    d["data"][len(d["data"]) - 1]
}
func op_deque_size(d) { len(d["data"]) }
func op_deque_is_empty(d) { len(d["data"]) == 0 }
func op_deque_to_array(d) { d["data"] }

// ══════════════════════════════════════════════════════════════════
// Full BitSet Operations
// ══════════════════════════════════════════════════════════════════

func op_bitset_new(size) {
    let bits = []
    let i = 0
    while i < size { bits.push(false); i = i + 1 }
    {"__bitset": true, "bits": bits, "size": size}
}

func op_bitset_set(bs, idx) {
    if idx >= 0 && idx < bs["size"] { bs["bits"][idx] = true }
    bs
}

func op_bitset_clear(bs, idx) {
    if idx >= 0 && idx < bs["size"] { bs["bits"][idx] = false }
    bs
}

func op_bitset_test(bs, idx) {
    if idx >= 0 && idx < bs["size"] { bs["bits"][idx] } else { false }
}

func op_bitset_toggle(bs, idx) {
    if idx >= 0 && idx < bs["size"] { bs["bits"][idx] = !bs["bits"][idx] }
    bs
}

func op_bitset_count(bs) {
    let count = 0
    for b in bs["bits"] { if b { count = count + 1 } }
    count
}

func op_bitset_and(a, b) {
    const size = if a["size"] < b["size"] { a["size"] } else { b["size"] }
    let result = op_bitset_new(size)
    let i = 0
    while i < size {
        result["bits"][i] = a["bits"][i] && b["bits"][i]
        i = i + 1
    }
    result
}

func op_bitset_or(a, b) {
    const size = if a["size"] > b["size"] { a["size"] } else { b["size"] }
    let result = op_bitset_new(size)
    let i = 0
    while i < size {
        const a_val = if i < a["size"] { a["bits"][i] } else { false }
        const b_val = if i < b["size"] { b["bits"][i] } else { false }
        result["bits"][i] = a_val || b_val
        i = i + 1
    }
    result
}

func op_bitset_xor(a, b) {
    const size = if a["size"] > b["size"] { a["size"] } else { b["size"] }
    let result = op_bitset_new(size)
    let i = 0
    while i < size {
        const a_val = if i < a["size"] { a["bits"][i] } else { false }
        const b_val = if i < b["size"] { b["bits"][i] } else { false }
        result["bits"][i] = (a_val && !b_val) || (!a_val && b_val)
        i = i + 1
    }
    result
}

// ══════════════════════════════════════════════════════════════════
// Full Promise/Future Operations
// ══════════════════════════════════════════════════════════════════

func op_promise_resolve(value) {
    {"__promise": true, "state": "fulfilled", "value": value, "error": null}
}

func op_promise_reject(error) {
    {"__promise": true, "state": "rejected", "value": null, "error": error}
}

func op_promise_then(promise, on_fulfill) {
    if promise["state"] == "fulfilled" {
        const result = on_fulfill(promise["value"])
        op_promise_resolve(result)
    } else {
        promise
    }
}

func op_promise_catch(promise, on_reject) {
    if promise["state"] == "rejected" {
        const result = on_reject(promise["error"])
        op_promise_resolve(result)
    } else {
        promise
    }
}

func op_promise_finally(promise, callback) {
    callback()
    promise
}

func op_promise_all(promises) {
    let results = []
    for p in promises {
        if p["state"] == "rejected" {
            return op_promise_reject(p["error"])
        }
        results.push(p["value"])
    }
    op_promise_resolve(results)
}

func op_promise_race(promises) {
    // Return the first fulfilled/rejected
    for p in promises {
        if p["state"] != "pending" { return p }
    }
    if len(promises) > 0 { promises[0] } else { op_promise_resolve(null) }
}

func op_promise_all_settled(promises) {
    let results = []
    for p in promises {
        results.push({"status": p["state"], "value": p["value"], "reason": p["error"]})
    }
    op_promise_resolve(results)
}

// ══════════════════════════════════════════════════════════════════
// Full Observable/Reactive Operations
// ══════════════════════════════════════════════════════════════════

func op_observable_new(initial_value) {
    {"__observable": true, "value": initial_value, "subscribers": []}
}

func op_observable_get(obs) { obs["value"] }

func op_observable_set(obs, value) {
    const old_value = obs["value"]
    obs["value"] = value
    // Notify subscribers
    for sub in obs["subscribers"] {
        sub(value, old_value)
    }
    obs
}

func op_observable_subscribe(obs, callback) {
    obs["subscribers"].push(callback)
    obs
}

func op_observable_map(obs, fn_val) {
    const derived = op_observable_new(fn_val(obs["value"]))
    op_observable_subscribe(obs, func(new_val, _old) {
        op_observable_set(derived, fn_val(new_val))
    })
    derived
}

func op_observable_filter(obs, predicate) {
    const initial = if predicate(obs["value"]) { obs["value"] } else { null }
    const derived = op_observable_new(initial)
    op_observable_subscribe(obs, func(new_val, _old) {
        if predicate(new_val) {
            op_observable_set(derived, new_val)
        }
    })
    derived
}

// ══════════════════════════════════════════════════════════════════
// Full Option/Result Type Operations
// ══════════════════════════════════════════════════════════════════

func op_some(value) { {"__option": true, "has_value": true, "value": value} }
func op_none() { {"__option": true, "has_value": false, "value": null} }
func op_is_some(opt) { typeof(opt) == "map" && opt.has("__option") && opt["has_value"] }
func op_is_none(opt) { typeof(opt) == "map" && opt.has("__option") && !opt["has_value"] }
func op_unwrap(opt) {
    if typeof(opt) == "map" && opt.has("__option") {
        if opt["has_value"] { return opt["value"] }
        panic("unwrap called on None")
    }
    opt // Not an option, return as-is
}
func op_unwrap_or(opt, default_val) {
    if typeof(opt) == "map" && opt.has("__option") {
        if opt["has_value"] { return opt["value"] }
        return default_val
    }
    opt
}
func op_option_map(opt, fn_val) {
    if op_is_some(opt) { op_some(fn_val(opt["value"])) }
    else { op_none() }
}
func op_option_flat_map(opt, fn_val) {
    if op_is_some(opt) { fn_val(opt["value"]) }
    else { op_none() }
}
func op_option_filter(opt, predicate) {
    if op_is_some(opt) && predicate(opt["value"]) { opt }
    else { op_none() }
}

func op_ok(value) { {"__result": true, "is_ok": true, "value": value, "error": null} }
func op_err(error) { {"__result": true, "is_ok": false, "value": null, "error": error} }
func op_is_ok(result) { typeof(result) == "map" && result.has("__result") && result["is_ok"] }
func op_is_err(result) { typeof(result) == "map" && result.has("__result") && !result["is_ok"] }
func op_result_unwrap(result) {
    if typeof(result) == "map" && result.has("__result") {
        if result["is_ok"] { return result["value"] }
        panic(f"unwrap called on Err: {result['error']}")
    }
    result
}
func op_result_map(result, fn_val) {
    if op_is_ok(result) { op_ok(fn_val(result["value"])) }
    else { result }
}
func op_result_map_err(result, fn_val) {
    if op_is_err(result) { op_err(fn_val(result["error"])) }
    else { result }
}
func op_result_and_then(result, fn_val) {
    if op_is_ok(result) { fn_val(result["value"]) }
    else { result }
}
func op_result_or_else(result, fn_val) {
    if op_is_err(result) { fn_val(result["error"]) }
    else { result }
}

// ══════════════════════════════════════════════════════════════════
// Full Lazy Evaluation
// ══════════════════════════════════════════════════════════════════

func op_lazy(fn_val) {
    {"__lazy": true, "computed": false, "value": null, "fn": fn_val}
}

func op_force(lazy_val) {
    if typeof(lazy_val) != "map" || !lazy_val.has("__lazy") { return lazy_val }
    if !lazy_val["computed"] {
        lazy_val["value"] = lazy_val["fn"]()
        lazy_val["computed"] = true
    }
    lazy_val["value"]
}

// ══════════════════════════════════════════════════════════════════
// Full Sequence Generator
// ══════════════════════════════════════════════════════════════════

func op_seq_fibonacci(n) {
    if n <= 0 { return [] }
    if n == 1 { return [0] }
    let result = [0, 1]
    let i = 2
    while i < n {
        result.push(result[i - 1] + result[i - 2])
        i = i + 1
    }
    result
}

func op_seq_primes(n) {
    if n <= 0 { return [] }
    let primes = []
    let candidate = 2
    while len(primes) < n {
        let is_prime = true
        for p in primes {
            if p * p > candidate { break }
            if candidate % p == 0 { is_prime = false; break }
        }
        if is_prime { primes.push(candidate) }
        candidate = candidate + 1
    }
    primes
}

func op_seq_range_step(start, end_val, step) {
    let result = []
    let i = start
    if step > 0 {
        while i < end_val { result.push(i); i = i + step }
    } else if step < 0 {
        while i > end_val { result.push(i); i = i + step }
    }
    result
}

func op_seq_linspace(start, end_val, count) {
    if count <= 0 { return [] }
    if count == 1 { return [op_to_f64(start)] }
    let result = []
    const step = (op_to_f64(end_val) - op_to_f64(start)) / op_to_f64(count - 1)
    let i = 0
    while i < count {
        result.push(op_to_f64(start) + step * op_to_f64(i))
        i = i + 1
    }
    result
}

func op_seq_geometric(start, ratio, count) {
    let result = []
    let val = op_to_f64(start)
    let i = 0
    while i < count {
        result.push(val)
        val = val * op_to_f64(ratio)
        i = i + 1
    }
    result
}

// ══════════════════════════════════════════════════════════════════
// Full Regex Builder Operations
// ══════════════════════════════════════════════════════════════════

func op_regex_builder() { {"pattern": "", "flags": ""} }

func op_regex_literal(rb, text) {
    rb["pattern"] = rb["pattern"] + regex_escape(text)
    rb
}
func op_regex_digit(rb) { rb["pattern"] = rb["pattern"] + "\\d"; rb }
func op_regex_word(rb) { rb["pattern"] = rb["pattern"] + "\\w"; rb }
func op_regex_space(rb) { rb["pattern"] = rb["pattern"] + "\\s"; rb }
func op_regex_any(rb) { rb["pattern"] = rb["pattern"] + "."; rb }
func op_regex_start(rb) { rb["pattern"] = "^" + rb["pattern"]; rb }
func op_regex_end(rb) { rb["pattern"] = rb["pattern"] + "$"; rb }
func op_regex_one_or_more(rb) { rb["pattern"] = rb["pattern"] + "+"; rb }
func op_regex_zero_or_more(rb) { rb["pattern"] = rb["pattern"] + "*"; rb }
func op_regex_optional(rb) { rb["pattern"] = rb["pattern"] + "?"; rb }
func op_regex_group(rb, pattern) { rb["pattern"] = rb["pattern"] + "(" + pattern + ")"; rb }
func op_regex_or(rb, a, b) { rb["pattern"] = rb["pattern"] + "(" + a + "|" + b + ")"; rb }
func op_regex_char_class(rb, chars) { rb["pattern"] = rb["pattern"] + "[" + chars + "]"; rb }
func op_regex_repeat(rb, min, max) {
    rb["pattern"] = rb["pattern"] + "{" + to_string(min) + "," + to_string(max) + "}"
    rb
}
func op_regex_build(rb) { rb["pattern"] }

// ══════════════════════════════════════════════════════════════════
// Full Color Conversion Operations
// ══════════════════════════════════════════════════════════════════

func op_rgb_to_hex(r, g, b) {
    const hex_chars = "0123456789abcdef"
    func to_hex2(n) {
        const hi = n / 16
        const lo = n % 16
        hex_chars[hi] + hex_chars[lo]
    }
    "#" + to_hex2(r) + to_hex2(g) + to_hex2(b)
}

func op_hex_to_rgb(hex_str) {
    let s = hex_str
    if starts_with(s, "#") { s = s.slice(1, len(s)) }
    if len(s) != 6 { return {"r": 0, "g": 0, "b": 0} }
    func parse_hex2(h) {
        const hex_chars = "0123456789abcdef"
        const hi = hex_chars.index_of(to_lower(h[0]))
        const lo = hex_chars.index_of(to_lower(h[1]))
        if hi < 0 || lo < 0 { return 0 }
        hi * 16 + lo
    }
    {
        "r": parse_hex2(s.slice(0, 2)),
        "g": parse_hex2(s.slice(2, 4)),
        "b": parse_hex2(s.slice(4, 6))
    }
}

func op_rgb_to_hsl(r, g, b) {
    const rf = op_to_f64(r) / 255.0
    const gf = op_to_f64(g) / 255.0
    const bf = op_to_f64(b) / 255.0
    const max_val = if rf > gf { if rf > bf { rf } else { bf } } else { if gf > bf { gf } else { bf } }
    const min_val = if rf < gf { if rf < bf { rf } else { bf } } else { if gf < bf { gf } else { bf } }
    const l = (max_val + min_val) / 2.0
    if max_val == min_val { return {"h": 0.0, "s": 0.0, "l": l} }
    const d = max_val - min_val
    const s = if l > 0.5 { d / (2.0 - max_val - min_val) } else { d / (max_val + min_val) }
    let h = 0.0
    if max_val == rf { h = (gf - bf) / d + (if gf < bf { 6.0 } else { 0.0 }) }
    else if max_val == gf { h = (bf - rf) / d + 2.0 }
    else { h = (rf - gf) / d + 4.0 }
    h = h / 6.0
    {"h": h * 360.0, "s": s, "l": l}
}

// ══════════════════════════════════════════════════════════════════
// Full Duration/Time Utility Operations
// ══════════════════════════════════════════════════════════════════

func op_duration_ms(ms) { ms }
func op_duration_seconds(s) { s * 1000 }
func op_duration_minutes(m) { m * 60000 }
func op_duration_hours(h) { h * 3600000 }
func op_duration_days(d) { d * 86400000 }

func op_duration_format(ms) {
    const total_ms = op_to_i64(ms)
    if total_ms < 1000 { return f"{total_ms}ms" }
    const total_s = total_ms / 1000
    if total_s < 60 { return f"{total_s}s {total_ms % 1000}ms" }
    const total_m = total_s / 60
    if total_m < 60 { return f"{total_m}m {total_s % 60}s" }
    const total_h = total_m / 60
    if total_h < 24 { return f"{total_h}h {total_m % 60}m" }
    const total_d = total_h / 24
    f"{total_d}d {total_h % 24}h"
}

func op_stopwatch_new() { {"__sw": true, "start": now_timestamp(), "laps": []} }
func op_stopwatch_lap(sw) {
    const now = now_timestamp()
    const elapsed = now - sw["start"]
    sw["laps"].push(elapsed)
    elapsed
}
func op_stopwatch_elapsed(sw) { now_timestamp() - sw["start"] }
func op_stopwatch_reset(sw) { sw["start"] = now_timestamp(); sw["laps"] = []; sw }

// ══════════════════════════════════════════════════════════════════
// Full Percent/Ratio Operations
// ══════════════════════════════════════════════════════════════════

func op_percent_of(value, total) {
    if total == 0 || total == 0.0 { return 0.0 }
    op_to_f64(value) / op_to_f64(total) * 100.0
}

func op_percent_change(old_val, new_val) {
    if old_val == 0 || old_val == 0.0 { return 0.0 }
    (op_to_f64(new_val) - op_to_f64(old_val)) / op_to_f64(old_val) * 100.0
}

func op_ratio(a, b) {
    if b == 0 || b == 0.0 { return 0.0 }
    op_to_f64(a) / op_to_f64(b)
}

func op_proportion(part, whole) { op_percent_of(part, whole) / 100.0 }

// ══════════════════════════════════════════════════════════════════
// Full Number Formatting
// ══════════════════════════════════════════════════════════════════

func op_number_with_commas(n) {
    const s = to_string(op_to_i64(n))
    let result = ""
    let count = 0
    let i = len(s) - 1
    while i >= 0 {
        if count > 0 && count % 3 == 0 { result = "," + result }
        result = s[i] + result
        count = count + 1
        i = i - 1
    }
    result
}

func op_number_to_words(n) {
    const val = op_to_i64(n)
    if val == 0 { return "zero" }
    const ones = ["", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine",
                   "ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen",
                   "seventeen", "eighteen", "nineteen"]
    const tens = ["", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety"]
    if val < 0 { return "negative " + op_number_to_words(0 - val) }
    if val < 20 { return ones[val] }
    if val < 100 {
        const t = tens[val / 10]
        const o = ones[val % 10]
        return if len(o) > 0 { t + "-" + o } else { t }
    }
    if val < 1000 {
        return ones[val / 100] + " hundred" + (if val % 100 > 0 { " and " + op_number_to_words(val % 100) } else { "" })
    }
    to_string(val) // Simplified for large numbers
}

func op_number_ordinal(n) {
    const val = op_to_i64(n)
    const suffix = if val % 100 >= 11 && val % 100 <= 13 { "th" }
                   else if val % 10 == 1 { "st" }
                   else if val % 10 == 2 { "nd" }
                   else if val % 10 == 3 { "rd" }
                   else { "th" }
    to_string(val) + suffix
}

func op_number_roman(n) {
    let val = op_to_i64(n)
    if val <= 0 || val > 3999 { return to_string(val) }
    const values = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
    const symbols = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
    let result = ""
    let i = 0
    while i < len(values) {
        while val >= values[i] {
            result = result + symbols[i]
            val = val - values[i]
        }
        i = i + 1
    }
    result
}

// ══════════════════════════════════════════════════════════════════
// Full String Similarity Operations
// ══════════════════════════════════════════════════════════════════

func op_jaccard_similarity(a, b) {
    let set_a = {}
    let set_b = {}
    for c in a.chars() { set_a[c] = true }
    for c in b.chars() { set_b[c] = true }
    let intersection = 0
    let union_size = 0
    for k in set_a.keys() {
        union_size = union_size + 1
        if set_b.has(k) { intersection = intersection + 1 }
    }
    for k in set_b.keys() {
        if !set_a.has(k) { union_size = union_size + 1 }
    }
    if union_size == 0 { return 1.0 }
    op_to_f64(intersection) / op_to_f64(union_size)
}

func op_dice_coefficient(a, b) {
    // Dice = 2 * |A intersect B| / (|A| + |B|)
    let set_a = {}
    let set_b = {}
    for c in a.chars() { set_a[c] = true }
    for c in b.chars() { set_b[c] = true }
    let intersection = 0
    for k in set_a.keys() {
        if set_b.has(k) { intersection = intersection + 1 }
    }
    const total = len(set_a.keys()) + len(set_b.keys())
    if total == 0 { return 1.0 }
    2.0 * op_to_f64(intersection) / op_to_f64(total)
}

func op_hamming_distance(a, b) {
    const limit = if len(a) < len(b) { len(a) } else { len(b) }
    let dist = abs(len(a) - len(b))
    let i = 0
    while i < limit {
        if a[i] != b[i] { dist = dist + 1 }
        i = i + 1
    }
    dist
}

func op_longest_common_substring(a, b) {
    let best = ""
    let i = 0
    while i < len(a) {
        let j = 0
        while j < len(b) {
            let k = 0
            while i + k < len(a) && j + k < len(b) && a[i + k] == b[j + k] {
                k = k + 1
            }
            if k > len(best) {
                best = a.slice(i, i + k)
            }
            j = j + 1
        }
        i = i + 1
    }
    best
}

func op_longest_common_subsequence(a, b) {
    const m = len(a)
    const n = len(b)
    // Build LCS table
    let dp = []
    let i = 0
    while i <= m {
        let row = []
        let j = 0
        while j <= n { row.push(0); j = j + 1 }
        dp.push(row)
        i = i + 1
    }
    i = 1
    while i <= m {
        let j = 1
        while j <= n {
            if a[i - 1] == b[j - 1] {
                dp[i][j] = dp[i - 1][j - 1] + 1
            } else {
                dp[i][j] = if dp[i - 1][j] > dp[i][j - 1] { dp[i - 1][j] } else { dp[i][j - 1] }
            }
            j = j + 1
        }
        i = i + 1
    }
    // Backtrack to find the subsequence
    let result = ""
    i = m
    let j = n
    while i > 0 && j > 0 {
        if a[i - 1] == b[j - 1] {
            result = a[i - 1] + result
            i = i - 1
            j = j - 1
        } else if dp[i - 1][j] > dp[i][j - 1] {
            i = i - 1
        } else {
            j = j - 1
        }
    }
    result
}

// ══════════════════════════════════════════════════════════════════
// Full Functional Combinators
// ══════════════════════════════════════════════════════════════════

func op_identity(x) { x }
func op_constant(x) { func() { x } }
func op_flip(fn_val) { func(a, b) { fn_val(b, a) } }
func op_negate_fn(fn_val) { func(x) { !fn_val(x) } }
func op_on(fn_val, transform) { func(a, b) { fn_val(transform(a), transform(b)) } }
func op_juxt(fns) {
    func(x) {
        let results = []
        for fn_val in fns { results.push(fn_val(x)) }
        results
    }
}
func op_converge(fn_val, branches) {
    func(x) {
        let args = []
        for branch in branches { args.push(branch(x)) }
        fn_val(...args)
    }
}

// ══════════════════════════════════════════════════════════════════
// Full Batch/Chunk Processing
// ══════════════════════════════════════════════════════════════════

func op_batch_process(items, batch_size, processor) {
    let results = []
    let i = 0
    while i < len(items) {
        const end_idx = if i + batch_size < len(items) { i + batch_size } else { len(items) }
        const batch = items.slice(i, end_idx)
        const batch_result = processor(batch)
        results.push(batch_result)
        i = i + batch_size
    }
    results
}

func op_parallel_map(items, fn_val, concurrency) {
    // In self-hosted, this is sequential (true parallelism requires runtime support)
    items.map(x => fn_val(x))
}

func op_reduce_batched(items, fn_val, initial, batch_size) {
    let acc = initial
    let i = 0
    while i < len(items) {
        const end_idx = if i + batch_size < len(items) { i + batch_size } else { len(items) }
        const batch = items.slice(i, end_idx)
        for item in batch {
            acc = fn_val(acc, item)
        }
        i = i + batch_size
    }
    acc
}

// ══════════════════════════════════════════════════════════════════
// Full Interpolation Operations
// ══════════════════════════════════════════════════════════════════

func op_interpolate_linear(x, x0, y0, x1, y1) {
    const xf = op_to_f64(x)
    const x0f = op_to_f64(x0)
    const y0f = op_to_f64(y0)
    const x1f = op_to_f64(x1)
    const y1f = op_to_f64(y1)
    if x1f == x0f { return y0f }
    y0f + (y1f - y0f) * (xf - x0f) / (x1f - x0f)
}

func op_interpolate_cubic(t) {
    const tf = op_to_f64(t)
    tf * tf * (3.0 - 2.0 * tf)
}

func op_interpolate_cosine(t) {
    const tf = op_to_f64(t)
    (1.0 - cos(tf * 3.14159265358979323846)) / 2.0
}

func op_bezier_point(t, p0, p1, p2, p3) {
    const tf = op_to_f64(t)
    const u = 1.0 - tf
    u * u * u * op_to_f64(p0) +
    3.0 * u * u * tf * op_to_f64(p1) +
    3.0 * u * tf * tf * op_to_f64(p2) +
    tf * tf * tf * op_to_f64(p3)
}

// ══════════════════════════════════════════════════════════════════
// Full Geometry Operations
// ══════════════════════════════════════════════════════════════════

func op_point_distance(x1, y1, x2, y2) {
    const dx = op_to_f64(x2) - op_to_f64(x1)
    const dy = op_to_f64(y2) - op_to_f64(y1)
    sqrt(dx * dx + dy * dy)
}

func op_point_midpoint(x1, y1, x2, y2) {
    {"x": (op_to_f64(x1) + op_to_f64(x2)) / 2.0,
     "y": (op_to_f64(y1) + op_to_f64(y2)) / 2.0}
}

func op_line_slope(x1, y1, x2, y2) {
    const dx = op_to_f64(x2) - op_to_f64(x1)
    if dx == 0.0 { return null } // Vertical line
    (op_to_f64(y2) - op_to_f64(y1)) / dx
}

func op_circle_area(radius) {
    3.14159265358979323846 * op_to_f64(radius) * op_to_f64(radius)
}

func op_circle_circumference(radius) {
    2.0 * 3.14159265358979323846 * op_to_f64(radius)
}

func op_triangle_area(x1, y1, x2, y2, x3, y3) {
    abs(op_to_f64(x1) * (op_to_f64(y2) - op_to_f64(y3)) +
        op_to_f64(x2) * (op_to_f64(y3) - op_to_f64(y1)) +
        op_to_f64(x3) * (op_to_f64(y1) - op_to_f64(y2))) / 2.0
}

func op_polygon_area(points) {
    // Shoelace formula
    const n = len(points)
    if n < 3 { return 0.0 }
    let area = 0.0
    let i = 0
    while i < n {
        const j = (i + 1) % n
        area = area + op_to_f64(points[i][0]) * op_to_f64(points[j][1])
        area = area - op_to_f64(points[j][0]) * op_to_f64(points[i][1])
        i = i + 1
    }
    abs(area) / 2.0
}

func op_point_in_rect(px, py, rx, ry, rw, rh) {
    op_to_f64(px) >= op_to_f64(rx) &&
    op_to_f64(px) <= op_to_f64(rx) + op_to_f64(rw) &&
    op_to_f64(py) >= op_to_f64(ry) &&
    op_to_f64(py) <= op_to_f64(ry) + op_to_f64(rh)
}

func op_point_in_circle(px, py, cx, cy, radius) {
    const dx = op_to_f64(px) - op_to_f64(cx)
    const dy = op_to_f64(py) - op_to_f64(cy)
    dx * dx + dy * dy <= op_to_f64(radius) * op_to_f64(radius)
}

func op_rects_overlap(x1, y1, w1, h1, x2, y2, w2, h2) {
    op_to_f64(x1) < op_to_f64(x2) + op_to_f64(w2) &&
    op_to_f64(x1) + op_to_f64(w1) > op_to_f64(x2) &&
    op_to_f64(y1) < op_to_f64(y2) + op_to_f64(h2) &&
    op_to_f64(y1) + op_to_f64(h1) > op_to_f64(y2)
}

// ══════════════════════════════════════════════════════════════════
// Full Vector2D/Vector3D Operations
// ══════════════════════════════════════════════════════════════════

func op_vec2(x, y) { {"x": op_to_f64(x), "y": op_to_f64(y)} }
func op_vec2_add(a, b) { {"x": a["x"] + b["x"], "y": a["y"] + b["y"]} }
func op_vec2_sub(a, b) { {"x": a["x"] - b["x"], "y": a["y"] - b["y"]} }
func op_vec2_scale(v, s) { {"x": v["x"] * op_to_f64(s), "y": v["y"] * op_to_f64(s)} }
func op_vec2_dot(a, b) { a["x"] * b["x"] + a["y"] * b["y"] }
func op_vec2_length(v) { sqrt(v["x"] * v["x"] + v["y"] * v["y"]) }
func op_vec2_normalize(v) {
    const len_val = op_vec2_length(v)
    if len_val == 0.0 { return {"x": 0.0, "y": 0.0} }
    {"x": v["x"] / len_val, "y": v["y"] / len_val}
}
func op_vec2_distance(a, b) { op_vec2_length(op_vec2_sub(a, b)) }
func op_vec2_angle(v) { atan2(v["y"], v["x"]) }
func op_vec2_rotate(v, angle) {
    const c = cos(op_to_f64(angle))
    const s = sin(op_to_f64(angle))
    {"x": v["x"] * c - v["y"] * s, "y": v["x"] * s + v["y"] * c}
}
func op_vec2_lerp(a, b, t) {
    const tf = op_to_f64(t)
    {"x": a["x"] + (b["x"] - a["x"]) * tf, "y": a["y"] + (b["y"] - a["y"]) * tf}
}
func op_vec2_reflect(v, normal) {
    const d = 2.0 * op_vec2_dot(v, normal)
    op_vec2_sub(v, op_vec2_scale(normal, d))
}

func op_vec3(x, y, z) { {"x": op_to_f64(x), "y": op_to_f64(y), "z": op_to_f64(z)} }
func op_vec3_add(a, b) { {"x": a["x"] + b["x"], "y": a["y"] + b["y"], "z": a["z"] + b["z"]} }
func op_vec3_sub(a, b) { {"x": a["x"] - b["x"], "y": a["y"] - b["y"], "z": a["z"] - b["z"]} }
func op_vec3_scale(v, s) { {"x": v["x"] * op_to_f64(s), "y": v["y"] * op_to_f64(s), "z": v["z"] * op_to_f64(s)} }
func op_vec3_dot(a, b) { a["x"] * b["x"] + a["y"] * b["y"] + a["z"] * b["z"] }
func op_vec3_cross(a, b) {
    {"x": a["y"] * b["z"] - a["z"] * b["y"],
     "y": a["z"] * b["x"] - a["x"] * b["z"],
     "z": a["x"] * b["y"] - a["y"] * b["x"]}
}
func op_vec3_length(v) { sqrt(v["x"] * v["x"] + v["y"] * v["y"] + v["z"] * v["z"]) }
func op_vec3_normalize(v) {
    const len_val = op_vec3_length(v)
    if len_val == 0.0 { return {"x": 0.0, "y": 0.0, "z": 0.0} }
    {"x": v["x"] / len_val, "y": v["y"] / len_val, "z": v["z"] / len_val}
}
func op_vec3_distance(a, b) { op_vec3_length(op_vec3_sub(a, b)) }
func op_vec3_lerp(a, b, t) {
    const tf = op_to_f64(t)
    {"x": a["x"] + (b["x"] - a["x"]) * tf,
     "y": a["y"] + (b["y"] - a["y"]) * tf,
     "z": a["z"] + (b["z"] - a["z"]) * tf}
}

// ══════════════════════════════════════════════════════════════════
// Full Noise Generation
// ══════════════════════════════════════════════════════════════════

// Simple hash-based noise (deterministic)
func op_noise_hash(x, y) {
    let n = op_to_i64(x) * 374761393 + op_to_i64(y) * 668265263
    n = (n ^ (n >> 13)) * 1274126177
    n = n ^ (n >> 16)
    op_to_f64(abs(n) % 1000000) / 1000000.0
}

func op_noise_value_2d(x, y) {
    const xi = floor(op_to_f64(x))
    const yi = floor(op_to_f64(y))
    const xf = op_to_f64(x) - xi
    const yf = op_to_f64(y) - yi
    const n00 = op_noise_hash(xi, yi)
    const n10 = op_noise_hash(xi + 1, yi)
    const n01 = op_noise_hash(xi, yi + 1)
    const n11 = op_noise_hash(xi + 1, yi + 1)
    const sx = xf * xf * (3.0 - 2.0 * xf)
    const sy = yf * yf * (3.0 - 2.0 * yf)
    const nx0 = n00 + sx * (n10 - n00)
    const nx1 = n01 + sx * (n11 - n01)
    nx0 + sy * (nx1 - nx0)
}

func op_noise_fbm(x, y, octaves) {
    let total = 0.0
    let amplitude = 1.0
    let frequency = 1.0
    let max_val = 0.0
    let i = 0
    while i < octaves {
        total = total + op_noise_value_2d(op_to_f64(x) * frequency, op_to_f64(y) * frequency) * amplitude
        max_val = max_val + amplitude
        amplitude = amplitude * 0.5
        frequency = frequency * 2.0
        i = i + 1
    }
    total / max_val
}

// ══════════════════════════════════════════════════════════════════
// Full ECS (Entity Component System) Operations
// ══════════════════════════════════════════════════════════════════

func op_ecs_world_new() {
    {"__ecs": true, "entities": {}, "next_id": 0, "components": {}}
}

func op_ecs_spawn(world) {
    const id = world["next_id"]
    world["next_id"] = id + 1
    world["entities"][to_string(id)] = {}
    id
}

func op_ecs_add_component(world, entity_id, component_name, data) {
    const eid = to_string(entity_id)
    if !world["entities"].has(eid) { return world }
    let entity = world["entities"][eid]
    entity[component_name] = data
    world["entities"][eid] = entity
    // Index by component
    if !world["components"].has(component_name) {
        world["components"][component_name] = []
    }
    let comp_list = world["components"][component_name]
    if !comp_list.contains(entity_id) { comp_list.push(entity_id) }
    world["components"][component_name] = comp_list
    world
}

func op_ecs_get_component(world, entity_id, component_name) {
    const eid = to_string(entity_id)
    if !world["entities"].has(eid) { return null }
    const entity = world["entities"][eid]
    if entity.has(component_name) { entity[component_name] } else { null }
}

func op_ecs_query(world, component_names) {
    // Return all entities that have ALL specified components
    if len(component_names) == 0 { return [] }
    let candidates = null
    for cname in component_names {
        if !world["components"].has(cname) { return [] }
        const ids = world["components"][cname]
        if candidates == null { candidates = ids }
        else {
            let filtered = []
            for id in candidates {
                if ids.contains(id) { filtered.push(id) }
            }
            candidates = filtered
        }
    }
    if candidates == null { [] } else { candidates }
}

func op_ecs_remove_entity(world, entity_id) {
    const eid = to_string(entity_id)
    if world["entities"].has(eid) {
        world["entities"].delete(eid)
    }
    // Remove from component indices
    for cname in world["components"].keys() {
        if cname == "__s" { continue }
        world["components"][cname] = world["components"][cname].filter(id => id != entity_id)
    }
    world
}

func op_ecs_system(world, component_names, system_fn) {
    const entities = op_ecs_query(world, component_names)
    for entity_id in entities {
        let components = {}
        for cname in component_names {
            components[cname] = op_ecs_get_component(world, entity_id, cname)
        }
        system_fn(entity_id, components)
    }
}

// ══════════════════════════════════════════════════════════════════
// Full HTTP Operations — matching stage 0 response format
// ══════════════════════════════════════════════════════════════════

func op_http_response(status, body, headers) {
    let h = {}
    if headers != null && typeof(headers) == "map" {
        h = headers
    }
    {"status": status, "body": body, "headers": h}
}

func op_http_get(args) {
    const url = op_arg(args, 0, "")
    if url == "" { panic("http_get: url required") }
    // Delegate to host http_get builtin
    const resp = http_get(url)
    if typeof(resp) == "map" { return resp }
    op_http_response(200, to_string(resp), {})
}

func op_http_post(args) {
    const url = op_arg(args, 0, "")
    const body = op_arg(args, 1, "")
    if url == "" { panic("http_post: url required") }
    const resp = http_post(url, body)
    if typeof(resp) == "map" { return resp }
    op_http_response(200, to_string(resp), {})
}

func op_http_put(args) {
    const url = op_arg(args, 0, "")
    const body = op_arg(args, 1, "")
    if url == "" { panic("http_put: url required") }
    const resp = http_put(url, body)
    if typeof(resp) == "map" { return resp }
    op_http_response(200, to_string(resp), {})
}

func op_http_delete(args) {
    const url = op_arg(args, 0, "")
    if url == "" { panic("http_delete: url required") }
    const resp = http_delete(url)
    if typeof(resp) == "map" { return resp }
    op_http_response(200, to_string(resp), {})
}

func op_http_patch(args) {
    const url = op_arg(args, 0, "")
    const body = op_arg(args, 1, "")
    if url == "" { panic("http_patch: url required") }
    const resp = http_patch(url, body)
    if typeof(resp) == "map" { return resp }
    op_http_response(200, to_string(resp), {})
}

func op_http_head(args) {
    const url = op_arg(args, 0, "")
    if url == "" { panic("http_head: url required") }
    const resp = http_head(url)
    if typeof(resp) == "map" { return resp }
    {"status": 200, "headers": {}}
}

func op_http_options(args) {
    const url = op_arg(args, 0, "")
    if url == "" { panic("http_options: url required") }
    const resp = http_options(url)
    if typeof(resp) == "map" { return resp }
    {"status": 200, "headers": {}, "allow": ""}
}

func op_http_request(args) {
    const method = op_arg(args, 0, "GET")
    const url = op_arg(args, 1, "")
    const headers = op_arg(args, 2, {})
    const body = op_arg(args, 3, null)
    if url == "" { panic("http_request: url required") }
    const upper = method.to_upper()
    const resp = http_request(upper, url, headers, body)
    if typeof(resp) == "map" { return resp }
    op_http_response(200, to_string(resp), {})
}

