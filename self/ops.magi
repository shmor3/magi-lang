func op_base32_decode(data) { base32_decode(data) }

// ══════════════════════════════════════════════════════════════════
// Full Validate Operations
// ══════════════════════════════════════════════════════════════════

func op_validate_email(s) {
    if len(s) < 3 { return false }
    const at_idx = s.index_of("@")
    if at_idx < 1 { return false }
    const domain = s.slice(at_idx + 1, len(s))
    if len(domain) < 3 { return false }
    domain.contains(".")
}

func op_validate_url(s) {
    starts_with(s, "http://") || starts_with(s, "https://") || starts_with(s, "ftp://")
}

func op_validate_ipv4(s) {
    const parts = s.split(".")
    if len(parts) != 4 { return false }
    for part in parts {
        const n = parse_int(part)
        if n < 0 || n > 255 { return false }
    }
    true
}

func op_validate_uuid(s) { uuid_is_valid(s) }

func op_validate_iso_date(s) {
    // YYYY-MM-DD format
    if len(s) != 10 { return false }
    if s[4] != "-" || s[7] != "-" { return false }
    true
}

func op_validate_json(s) { json_validate(s) }

func op_validate_not_empty(s) { len(s) > 0 }

func op_validate_length(s, min_len, max_len) {
    len(s) >= min_len && len(s) <= max_len
}

func op_validate_matches(s, pattern) { regex_test(s, pattern) }

func op_validate_range(n, min_val, max_val) {
    n >= min_val && n <= max_val
}

// ══════════════════════════════════════════════════════════════════
// Full Set Operations (beyond basic)
// ══════════════════════════════════════════════════════════════════

func op_set_is_subset(a, b) {
    let b_set = {}
    for item in b { b_set[to_string(item)] = true }
    for item in a {
        if !b_set.has(to_string(item)) { return false }
    }
    true
}

func op_set_is_superset(a, b) { op_set_is_subset(b, a) }

func op_set_is_disjoint(a, b) {
    let b_set = {}
    for item in b { b_set[to_string(item)] = true }
    for item in a {
        if b_set.has(to_string(item)) { return false }
    }
    true
}

func op_set_power_set(arr) {
    let result = [[]]
    for item in arr {
        const current_len = len(result)
        let i = 0
        while i < current_len {
            let subset = result[i].concat([item])
            result.push(subset)
            i = i + 1
        }
    }
    result
}

func op_set_cartesian_product(a, b) {
    let result = []
    for x in a {
        for y in b {
            result.push([x, y])
        }
    }
    result
}

// ══════════════════════════════════════════════════════════════════
// Full Matrix Operations
// ══════════════════════════════════════════════════════════════════

func op_matrix_new(rows, cols, fill) {
    let result = []
    let r = 0
    while r < rows {
        let row = []
        let c = 0
        while c < cols { row.push(fill); c = c + 1 }
        result.push(row)
        r = r + 1
    }
    result
}

func op_matrix_identity(n) {
    let result = op_matrix_new(n, n, 0)
    let i = 0
    while i < n { result[i][i] = 1; i = i + 1 }
    result
}

func op_matrix_add(a, b) {
    let result = []
    let i = 0
    while i < len(a) {
        let row = []
        let j = 0
        while j < len(a[i]) {
            row.push(a[i][j] + b[i][j])
            j = j + 1
        }
        result.push(row)
        i = i + 1
    }
    result
}

func op_matrix_multiply(a, b) {
    const rows = len(a)
    const cols = len(b[0])
    const inner = len(b)
    let result = op_matrix_new(rows, cols, 0)
    let i = 0
    while i < rows {
        let j = 0
        while j < cols {
            let sum = 0
            let k = 0
            while k < inner {
                sum = sum + a[i][k] * b[k][j]
                k = k + 1
            }
            result[i][j] = sum
            j = j + 1
        }
        i = i + 1
    }
    result
}

func op_matrix_transpose(m) {
    if len(m) == 0 { return [] }
    const rows = len(m)
    const cols = len(m[0])
    let result = op_matrix_new(cols, rows, 0)
    let i = 0
    while i < rows {
        let j = 0
        while j < cols { result[j][i] = m[i][j]; j = j + 1 }
        i = i + 1
    }
    result
}

func op_matrix_scalar_mul(m, s) {
    let result = []
    for row in m {
        let new_row = []
        for v in row { new_row.push(v * s) }
        result.push(new_row)
    }
    result
}

func op_matrix_determinant(m) {
    const n = len(m)
    if n == 1 { return m[0][0] }
    if n == 2 { return m[0][0] * m[1][1] - m[0][1] * m[1][0] }
    let det = 0
    let j = 0
    while j < n {
        const minor = op_matrix_minor(m, 0, j)
        const sign = if j % 2 == 0 { 1 } else { -1 }
        det = det + sign * m[0][j] * op_matrix_determinant(minor)
        j = j + 1
    }
    det
}

func op_matrix_minor(m, row, col) {
    let result = []
    let i = 0
    while i < len(m) {
        if i == row { i = i + 1; continue }
        let new_row = []
        let j = 0
        while j < len(m[i]) {
            if j != col { new_row.push(m[i][j]) }
            j = j + 1
        }
        result.push(new_row)
        i = i + 1
    }
    result
}

// ══════════════════════════════════════════════════════════════════
// Full Graph Operations
// ══════════════════════════════════════════════════════════════════

func op_graph_new() { {"nodes": {}, "edges": []} }

func op_graph_add_node(g, id, data) {
    g["nodes"][to_string(id)] = data
    g
}

func op_graph_add_edge(g, from, to, weight) {
    let edges = g["edges"]
    edges.push({"from": to_string(from), "to": to_string(to), "weight": weight})
    g["edges"] = edges
    g
}

func op_graph_neighbors(g, id) {
    const id_str = to_string(id)
    let result = []
    for edge in g["edges"] {
        if edge["from"] == id_str { result.push(edge["to"]) }
    }
    result
}

func op_graph_bfs(g, start) {
    let visited = {"__s": true}
    let queue = [to_string(start)]
    let order = []
    while len(queue) > 0 {
        const current = queue[0]
        queue = queue.slice(1, len(queue))
        if visited.has(current) { continue }
        visited[current] = true
        order.push(current)
        const neighbors = op_graph_neighbors(g, current)
        for n in neighbors { if !visited.has(n) { queue.push(n) } }
    }
    order
}

func op_graph_dfs(g, start) {
    let visited = {"__s": true}
    let stack = [to_string(start)]
    let order = []
    while len(stack) > 0 {
        const current = stack.pop()
        if visited.has(current) { continue }
        visited[current] = true
        order.push(current)
        const neighbors = op_graph_neighbors(g, current)
        let i = len(neighbors) - 1
        while i >= 0 { if !visited.has(neighbors[i]) { stack.push(neighbors[i]) }; i = i - 1 }
    }
    order
}

func op_graph_shortest_path(g, start, end) {
    // BFS-based shortest path
    const start_str = to_string(start)
    const end_str = to_string(end)
    let visited = {"__s": true}
    let queue = [[start_str]]
    while len(queue) > 0 {
        const path = queue[0]
        queue = queue.slice(1, len(queue))
        const current = path[len(path) - 1]
        if current == end_str { return path }
        if visited.has(current) { continue }
        visited[current] = true
        for n in op_graph_neighbors(g, current) {
            if !visited.has(n) {
                let new_path = path.concat([n])
                queue.push(new_path)
            }
        }
    }
    [] // No path found
}

func op_graph_topological_sort(g) {
    let in_degree = {}
    for id in g["nodes"].keys() {
        if id == "__s" || id == "__init" { continue }
        in_degree[id] = 0
    }
    for edge in g["edges"] {
        const to = edge["to"]
        if in_degree.has(to) { in_degree[to] = in_degree[to] + 1 }
        else { in_degree[to] = 1 }
    }
    let queue = []
    for id in in_degree.keys() {
        if in_degree[id] == 0 { queue.push(id) }
    }
    let order = []
    while len(queue) > 0 {
        const current = queue[0]
        queue = queue.slice(1, len(queue))
        order.push(current)
        for edge in g["edges"] {
            if edge["from"] == current {
                const to = edge["to"]
                in_degree[to] = in_degree[to] - 1
                if in_degree[to] == 0 { queue.push(to) }
            }
        }
    }
    order
}

// ══════════════════════════════════════════════════════════════════
// Full Event/Observer Operations
// ══════════════════════════════════════════════════════════════════

func op_event_emitter_new() {
    {"__event_emitter": true, "handlers": {}}
}

func op_event_on(emitter, event_name, handler) {
    if !emitter["handlers"].has(event_name) {
        emitter["handlers"][event_name] = []
    }
    let handlers = emitter["handlers"][event_name]
    handlers.push(handler)
    emitter["handlers"][event_name] = handlers
    emitter
}

func op_event_emit(emitter, event_name, data) {
    if !emitter["handlers"].has(event_name) { return null }
    const handlers = emitter["handlers"][event_name]
    for handler in handlers {
        handler(data)
    }
    null
}

func op_event_off(emitter, event_name) {
    if emitter["handlers"].has(event_name) {
        emitter["handlers"][event_name] = []
    }
    emitter
}

// ══════════════════════════════════════════════════════════════════
// Full Pool/Ring/Queue/Heap Operations
// ══════════════════════════════════════════════════════════════════

// Priority queue (min-heap)
func op_heap_new() { {"__heap": true, "data": []} }

func op_heap_push(heap, priority, value) {
    let data = heap["data"]
    data.push([priority, value])
    // Bubble up
    let i = len(data) - 1
    while i > 0 {
        const parent = (i - 1) / 2
        if data[i][0] < data[parent][0] {
            const temp = data[i]
            data[i] = data[parent]
            data[parent] = temp
            i = parent
        } else { break }
    }
    heap["data"] = data
    heap
}

func op_heap_pop(heap) {
    let data = heap["data"]
    if len(data) == 0 { return null }
    const result = data[0]
    if len(data) == 1 { heap["data"] = []; return result[1] }
    data[0] = data[len(data) - 1]
    data = data.slice(0, len(data) - 1)
    // Bubble down
    let i = 0
    while true {
        const left = 2 * i + 1
        const right = 2 * i + 2
        let smallest = i
        if left < len(data) && data[left][0] < data[smallest][0] { smallest = left }
        if right < len(data) && data[right][0] < data[smallest][0] { smallest = right }
        if smallest == i { break }
        const temp = data[i]
        data[i] = data[smallest]
        data[smallest] = temp
        i = smallest
    }
    heap["data"] = data
    result[1]
}

func op_heap_peek(heap) {
    const data = heap["data"]
    if len(data) == 0 { return null }
    data[0][1]
}

func op_heap_size(heap) { len(heap["data"]) }

// Ring buffer
func op_ring_new(capacity) {
    {"__ring": true, "data": [], "capacity": capacity, "head": 0, "size": 0}
}

func op_ring_push(ring, value) {
    const cap = ring["capacity"]
    if ring["size"] < cap {
        ring["data"].push(value)
        ring["size"] = ring["size"] + 1
    } else {
        ring["data"][ring["head"]] = value
    }
    ring["head"] = (ring["head"] + 1) % cap
    ring
}

func op_ring_to_array(ring) {
    const data = ring["data"]
    const size = ring["size"]
    const cap = ring["capacity"]
    if size < cap { return data.slice(0, size) }
    let result = []
    let i = ring["head"]
    let count = 0
    while count < size {
        result.push(data[i % cap])
        i = i + 1
        count = count + 1
    }
    result
}

// Queue (FIFO)
func op_queue_new() { {"__queue": true, "data": []} }
func op_queue_enqueue(q, value) { q["data"].push(value); q }
func op_queue_dequeue(q) {
    if len(q["data"]) == 0 { return null }
    const val = q["data"][0]
    q["data"] = q["data"].slice(1, len(q["data"]))
    val
}
func op_queue_peek(q) {
    if len(q["data"]) == 0 { return null }
    q["data"][0]
}
func op_queue_size(q) { len(q["data"]) }
func op_queue_is_empty(q) { len(q["data"]) == 0 }

// Stack (LIFO)
func op_stack_new() { {"__stack": true, "data": []} }
func op_stack_push(s, value) { s["data"].push(value); s }
func op_stack_pop(s) {
    if len(s["data"]) == 0 { return null }
    s["data"].pop()
}
func op_stack_peek(s) {
    const data = s["data"]
    if len(data) == 0 { return null }
    data[len(data) - 1]
}
func op_stack_size(s) { len(s["data"]) }

// ══════════════════════════════════════════════════════════════════
// Full Bloom Filter
// ══════════════════════════════════════════════════════════════════

func op_bloom_new(size, num_hashes) {
    let bits = []
    let i = 0
    while i < size { bits.push(false); i = i + 1 }
    {"__bloom": true, "bits": bits, "size": size, "num_hashes": num_hashes}
}

func op_bloom_add(bloom, item) {
    const s = to_string(item)
    let i = 0
    while i < bloom["num_hashes"] {
        const h = op_bloom_hash(s, i) % bloom["size"]
        bloom["bits"][h] = true
        i = i + 1
    }
    bloom
}

func op_bloom_test(bloom, item) {
    const s = to_string(item)
    let i = 0
    while i < bloom["num_hashes"] {
        const h = op_bloom_hash(s, i) % bloom["size"]
        if !bloom["bits"][h] { return false }
        i = i + 1
    }
    true
}

func op_bloom_hash(s, seed) {
    let h = seed * 31 + 17
    for c in s.chars() {
        h = h * 31 + char_code(c)
    }
    abs(h)
}

// ══════════════════════════════════════════════════════════════════
// Full LRU Cache
// ══════════════════════════════════════════════════════════════════

func op_lru_new(capacity) {
    {"__lru": true, "capacity": capacity, "data": {}, "order": [], "size": 0}
}

func op_lru_get(cache, key) {
    const k = to_string(key)
    if !cache["data"].has(k) { return null }
    // Move to end of order (most recently used)
    let order = cache["order"].filter(x => x != k)
    order.push(k)
    cache["order"] = order
    cache["data"][k]
}

func op_lru_put(cache, key, value) {
    const k = to_string(key)
    if cache["data"].has(k) {
        cache["data"][k] = value
        let order = cache["order"].filter(x => x != k)
        order.push(k)
        cache["order"] = order
    } else {
        if cache["size"] >= cache["capacity"] {
            // Evict least recently used
            const evict_key = cache["order"][0]
            cache["order"] = cache["order"].slice(1, len(cache["order"]))
            cache["data"].delete(evict_key)
            cache["size"] = cache["size"] - 1
        }
        cache["data"][k] = value
        cache["order"].push(k)
        cache["size"] = cache["size"] + 1
    }
    cache
}

func op_lru_has(cache, key) { cache["data"].has(to_string(key)) }
func op_lru_size(cache) { cache["size"] }

// ══════════════════════════════════════════════════════════════════
// Full Semver Operations
// ══════════════════════════════════════════════════════════════════

func op_semver_parse(version_str) {
    const parts = version_str.split(".")
    if len(parts) < 3 { return {"major": 0, "minor": 0, "patch": 0} }
    // Handle pre-release: "1.2.3-beta.1"
    const patch_str = parts[2]
    let patch_val = 0
    let prerelease = ""
    if patch_str.contains("-") {
        const pp = patch_str.split("-")
        patch_val = parse_int(pp[0])
        prerelease = pp[1]
    } else {
        patch_val = parse_int(patch_str)
    }
    {
        "major": parse_int(parts[0]),
        "minor": parse_int(parts[1]),
        "patch": patch_val,
        "prerelease": prerelease
    }
}

func op_semver_compare(a, b) {
    const va = op_semver_parse(a)
    const vb = op_semver_parse(b)
    if va["major"] != vb["major"] { return va["major"] - vb["major"] }
    if va["minor"] != vb["minor"] { return va["minor"] - vb["minor"] }
    va["patch"] - vb["patch"]
}

func op_semver_satisfies(version, constraint) {
    // Simple constraint: ">=1.0.0", "^1.0.0", "~1.0.0"
    if starts_with(constraint, ">=") {
        return op_semver_compare(version, constraint.slice(2, len(constraint))) >= 0
    }
    if starts_with(constraint, "<=") {
        return op_semver_compare(version, constraint.slice(2, len(constraint))) <= 0
    }
    if starts_with(constraint, ">") {
        return op_semver_compare(version, constraint.slice(1, len(constraint))) > 0
    }
    if starts_with(constraint, "<") {
        return op_semver_compare(version, constraint.slice(1, len(constraint))) < 0
    }
    if starts_with(constraint, "^") {
        // Compatible: same major version
        const cv = op_semver_parse(constraint.slice(1, len(constraint)))
        const vv = op_semver_parse(version)
        return vv["major"] == cv["major"] && op_semver_compare(version, constraint.slice(1, len(constraint))) >= 0
    }
    if starts_with(constraint, "~") {
        // Approximately: same major.minor
        const cv = op_semver_parse(constraint.slice(1, len(constraint)))
        const vv = op_semver_parse(version)
        return vv["major"] == cv["major"] && vv["minor"] == cv["minor"] && op_semver_compare(version, constraint.slice(1, len(constraint))) >= 0
    }
    // Exact match
    op_semver_compare(version, constraint) == 0
}

func op_semver_increment(version, part) {
    const v = op_semver_parse(version)
    match part {
        "major" => f"{v['major'] + 1}.0.0",
        "minor" => f"{v['major']}.{v['minor'] + 1}.0",
        "patch" => f"{v['major']}.{v['minor']}.{v['patch'] + 1}",
        _ => version
    }
}

