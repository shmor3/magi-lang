}

// ══════════════════════════════════════════════════════════════════
// Extended dispatch: add new operations to the main eval_operation
// ══════════════════════════════════════════════════════════════════

func eval_operation_extended(op_name, args) {
    match op_name {
    // HTTP
    "http_get" => op_http_get(args),
    "http_post" => op_http_post(args),
    "http_put" => op_http_put(args),
    "http_delete" => op_http_delete(args),
    "http_patch" => op_http_patch(args),
    "http_head" => op_http_head(args),
    "http_options" => op_http_options(args),
    "http_request" => op_http_request(args),

    // Certificates
    "cert_generate" | "cert_self_signed" => op_cert_generate(args),
    "cert_parse" => op_cert_parse(args),
    "cert_info" => op_cert_info(args),
    "cert_verify" => op_cert_verify(args),
    "key_generate" => op_key_generate(args),

    // WebSocket
    "ws_connect" | "websocket_connect" => op_ws_connect(args),
    "ws_send" | "websocket_send" => op_ws_send(args),
    "ws_receive" | "websocket_receive" | "ws_read" => op_ws_receive(args),
    "ws_close" | "websocket_close" => op_ws_close(args),

    // SSE
    "sse_connect" => op_sse_connect(args),
    "sse_read_event" => op_sse_read_event(args),
    "sse_close" => op_sse_close(args),

    // HTTP Server
    "http_server_start" => op_http_server_start(args),
    "http_server_receive" => op_http_server_receive(args),
    "http_server_respond" => op_http_server_respond(args),
    "http_server_stop" => op_http_server_stop(args),

    // TCP
    "tcp_connect" => op_tcp_connect(args),
    "tcp_write" => op_tcp_write(args),
    "tcp_read" => op_tcp_read(args),
    "tcp_close" => op_tcp_close(args),

    // UDP
    "udp_bind" => op_udp_bind(args),
    "udp_send" => op_udp_send(args),
    "udp_recv" => op_udp_recv(args),
    "udp_close" => op_udp_close(args),

    // TLS
    "tls_connect" => op_tls_connect(args),
    "tls_write" => op_tls_write(args),
    "tls_read" => op_tls_read(args),
    "tls_close" => op_tls_close(args),

    // DNS
    "dns_lookup" => op_dns_lookup(args),
    "dns_reverse" => op_dns_reverse(args),

    // Compression
    "compress_zstd" => op_compress_zstd(args),
    "decompress_zstd" => op_decompress_zstd(args),
    "compress_gzip" => op_compress_gzip(args),
    "decompress_gzip" => op_decompress_gzip(args),
    "compress_lz4" => op_compress_lz4(args),
    "decompress_lz4" => op_decompress_lz4(args),

    // Encoding
    "base64_encode" => op_base64_encode(args),
    "base64_decode" => op_base64_decode(args),
    "hex_encode" => op_hex_encode(args),
    "hex_decode" => op_hex_decode(args),
    "url_encode" => op_url_encode(args),
    "url_decode" => op_url_decode(args),

    // Hashing
    "sha256" | "hash_sha256" => op_hash_sha256(args),
    "sha512" | "hash_sha512" => op_hash_sha512(args),
    "md5" | "hash_md5" => op_hash_md5(args),
    "blake3" | "hash_blake3" => op_hash_blake3(args),
    "hmac" => op_hmac(args),

    // UUID
    "uuid_v4" | "uuid" => op_uuid_v4(args),
    "uuid_v7" => op_uuid_v7(args),
    "uuid_parse" => op_uuid_parse(args),

    // Time
    "time_now" => op_time_now(args),
    "time_unix" => op_time_unix(args),
    "time_format" => op_time_format(args),
    "time_parse" => op_time_parse(args),
    "time_diff" => op_time_diff(args),
    "sleep" => op_sleep(args),

    // Regex
    "regex_match" => op_regex_match(args),
    "regex_test" => op_regex_test(args),
    "regex_find" => op_regex_find(args),
    "regex_find_all" => op_regex_find_all(args),
    "regex_replace" => op_regex_replace(args),
    "regex_split" => op_regex_split(args),

    // JSON/YAML/TOML/CSV
    "json_parse" => op_json_parse(args),
    "json_stringify" => op_json_stringify(args),
    "yaml_parse" => op_yaml_parse(args),
    "yaml_stringify" => op_yaml_stringify(args),
    "toml_parse" => op_toml_parse(args),
    "toml_stringify" => op_toml_stringify(args),
    "csv_parse" => op_csv_parse(args),
    "csv_stringify" => op_csv_stringify(args),

    // Process/OS
    "exec" | "command" | "os_exec" => op_exec(args),
    "env_get" | "getenv" | "os_getenv" => op_env_get(args),
    "env_set" | "setenv" | "os_setenv" => op_env_set(args),
    "env_all" | "os_environ" => op_env_all(args),
    "exit" | "os_exit" => op_os_exit(args),
    "os_args" | "args" => op_os_args(args),
    "os_pid" | "pid" => op_os_pid(args),
    "os_hostname" | "hostname" => op_os_hostname(args),
    "os_cwd" | "cwd" => op_os_cwd(args),

    // File System
    "fs_read" | "read_file" | "file_read" => op_fs_read(args),
    "fs_write" | "write_file" | "file_write" => op_fs_write(args),
    "fs_append" | "file_append" => op_fs_append(args),
    "fs_exists" | "file_exists" | "path_exists" => op_fs_exists(args),
    "fs_remove" | "file_remove" | "file_delete" => op_fs_remove(args),
    "fs_rename" | "file_rename" => op_fs_rename(args),
    "fs_mkdir" | "mkdir" | "mkdirp" => op_fs_mkdir(args),
    "fs_readdir" | "readdir" | "ls" => op_fs_readdir(args),
    "fs_stat" | "file_stat" | "stat" => op_fs_stat(args),
    "fs_is_dir" | "is_dir" => op_fs_is_dir(args),
    "fs_is_file" | "is_file" => op_fs_is_file(args),
    "fs_copy" | "file_copy" | "cp" => op_fs_copy(args),
    "fs_glob" | "glob" => op_fs_glob(args),
    "fs_temp_file" | "temp_file" => op_fs_temp_file(args),
    "fs_temp_dir" | "temp_dir" => op_fs_temp_dir(args),

    // Path
    "path_join" => op_path_join(args),
    "path_dir" | "dirname" => op_path_dir(args),
    "path_base" | "basename" => op_path_base(args),
    "path_ext" | "extname" => op_path_ext(args),
    "path_stem" => op_path_stem(args),
    "path_abs" | "abspath" => op_path_abs(args),
    "path_clean" | "filepath_clean" => op_path_clean(args),

    // Concurrency
    "spawn" => op_spawn(args),
    "await" | "await_task" => op_await_task(args),
    "channel" | "chan_new" => op_channel(args),
    "chan_send" => op_chan_send(args),
    "chan_recv" => op_chan_recv(args),
    "chan_close" => op_chan_close(args),
    "mutex_new" => op_mutex_new(args),
    "mutex_lock" => op_mutex_lock(args),
    "mutex_unlock" => op_mutex_unlock(args),
    "atomic_new" => op_atomic_new(args),
    "atomic_load" => op_atomic_load(args),
    "atomic_store" => op_atomic_store(args),
    "atomic_add" | "atomic_fetch_add" => op_atomic_add(args),

    _ => null,
    }
}

// ══════════════════════════════════════════════════════════════════
// ── Extended Operation Implementations ──────────────────────────
// ══════════════════════════════════════════════════════════════════

// ── Trigonometric Operations (full set) ─────────────────────────

func op_sinh(args) {
    const x = op_to_f64(args[0])
    (exp(x) - exp(0.0 - x)) / 2.0
}

func op_cosh(args) {
    const x = op_to_f64(args[0])
    (exp(x) + exp(0.0 - x)) / 2.0
}

func op_tanh(args) {
    const x = op_to_f64(args[0])
    const ex = exp(x)
    const emx = exp(0.0 - x)
    (ex - emx) / (ex + emx)
}

func op_asinh(args) {
    const x = op_to_f64(args[0])
    ln(x + sqrt(x * x + 1.0))
}

func op_acosh(args) {
    const x = op_to_f64(args[0])
    if x < 1.0 { panic("acosh: argument must be >= 1.0") }
    ln(x + sqrt(x * x - 1.0))
}

func op_atanh(args) {
    const x = op_to_f64(args[0])
    if x <= -1.0 || x >= 1.0 { panic("atanh: argument must be in (-1, 1)") }
    0.5 * ln((1.0 + x) / (1.0 - x))
}

func op_deg_to_rad(args) {
    const deg = op_to_f64(args[0])
    deg * 3.141592653589793 / 180.0
}

func op_rad_to_deg(args) {
    const rad = op_to_f64(args[0])
    rad * 180.0 / 3.141592653589793
}

// ── Advanced Math ───────────────────────────────────────────────

func op_factorial(args) {
    const n = op_to_i64(args[0])
    if n < 0 { panic("factorial: negative argument") }
    if n <= 1 { return 1 }
    let result = 1
    let i = 2
    while i <= n { result = result * i; i = i + 1 }
    result
}

func op_gcd(args) {
    let a = abs(op_to_i64(args[0]))
    let b = abs(op_to_i64(args[1]))
    while b != 0 {
        const t = b
        b = a % b
        a = t
    }
    a
}

func op_lcm(args) {
    const a = op_to_i64(args[0])
    const b = op_to_i64(args[1])
    if a == 0 || b == 0 { return 0 }
    abs(a * b) / op_gcd([a, b])
}

func op_is_prime(args) {
    const n = op_to_i64(args[0])
    if n < 2 { return false }
    if n < 4 { return true }
    if n % 2 == 0 || n % 3 == 0 { return false }
    let i = 5
    while i * i <= n {
        if n % i == 0 || n % (i + 2) == 0 { return false }
        i = i + 6
    }
    true
}

func op_fibonacci(args) {
    const n = op_to_i64(args[0])
    if n <= 0 { return 0 }
    if n == 1 { return 1 }
    let a = 0
    let b = 1
    let i = 2
    while i <= n {
        const c = a + b
        a = b
        b = c
        i = i + 1
    }
    b
}

func op_combinations(args) {
    const n = op_to_i64(args[0])
    const k = op_to_i64(args[1])
    if k < 0 || k > n { return 0 }
    if k == 0 || k == n { return 1 }
    let result = 1
    let i = 0
    while i < min(k, n - k) {
        result = result * (n - i) / (i + 1)
        i = i + 1
    }
    result
}

func op_permutations(args) {
    const n = op_to_i64(args[0])
    const k = op_to_i64(args[1])
    if k < 0 || k > n { return 0 }
    let result = 1
    let i = 0
    while i < k {
        result = result * (n - i)
        i = i + 1
    }
    result
}

// ── String Operations (extended) ────────────────────────────────

func op_string_center(args) {
    const s = to_string(args[0])
    const width = op_to_i64(args[1])
    const fill = if len(args) > 2 { to_string(args[2]) } else { " " }
    if len(s) >= width { return s }
    const total_pad = width - len(s)
    const left_pad = int(total_pad / 2)
    const right_pad = total_pad - left_pad
    fill.repeat(left_pad) + s + fill.repeat(right_pad)
}

func op_string_count(args) {
    const s = to_string(args[0])
    const sub = to_string(args[1])
    if len(sub) == 0 { return len(s) + 1 }
    let count = 0
    let pos = 0
    while pos <= len(s) - len(sub) {
        const idx = s[pos..len(s)].index_of(sub)
        if idx < 0 { break }
        count = count + 1
        pos = pos + idx + len(sub)
    }
    count
}

func op_string_is_digit(args) {
    const s = to_string(args[0])
    if len(s) == 0 { return false }
    let i = 0
    while i < len(s) {
        const c = s[i]
        if c < "0" || c > "9" { return false }
        i = i + 1
    }
    true
}

func op_string_is_alpha(args) {
    const s = to_string(args[0])
    if len(s) == 0 { return false }
    let i = 0
    while i < len(s) {
        const c = s[i]
        if !((c >= "a" && c <= "z") || (c >= "A" && c <= "Z")) { return false }
        i = i + 1
    }
    true
}

func op_string_is_alnum(args) {
    const s = to_string(args[0])
    if len(s) == 0 { return false }
    let i = 0
    while i < len(s) {
        const c = s[i]
        if !((c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9")) { return false }
        i = i + 1
    }
    true
}

func op_string_title_case(args) {
    const s = to_string(args[0])
    let result = ""
    let capitalize = true
    let i = 0
    while i < len(s) {
        const c = s[i]
        if c == " " || c == "\t" || c == "\n" || c == "-" || c == "_" {
            result = result + c
            capitalize = true
        } else if capitalize {
            if c >= "a" && c <= "z" {
                result = result + char_from_code(char_code_at(c, 0) - 32)
            } else {
                result = result + c
            }
            capitalize = false
        } else {
            result = result + c
        }
        i = i + 1
    }
    result
}

func op_string_camel_case(args) {
    const s = to_string(args[0])
    const parts = s.replace("-", "_").split("_")
    if len(parts) == 0 { return "" }
    let result = parts[0].to_lower()
    let i = 1
    while i < len(parts) {
        const part = parts[i]
        if len(part) > 0 {
            const first = part[0]
            const upper = if first >= "a" && first <= "z" { char_from_code(char_code_at(first, 0) - 32) } else { first }
            result = result + upper + part[1..len(part)].to_lower()
        }
        i = i + 1
    }
    result
}

// ── Array Operations (extended) ─────────────────────────────────

func op_array_zip(args) {
    const a = args[0]
    const b = args[1]
    const min_len = min(len(a), len(b))
    let result = []
    let i = 0
    while i < min_len {
        result.push([a[i], b[i]])
        i = i + 1
    }
    result
}

func op_array_unzip(args) {
    const pairs = args[0]
    let a = []
    let b = []
    for pair in pairs {
        a.push(pair[0])
        b.push(pair[1])
    }
    [a, b]
}

func op_array_chunk(args) {
    const arr = args[0]
    const size = op_to_i64(args[1])
    if size <= 0 { return [arr] }
    let chunks = []
    let i = 0
    while i < len(arr) {
        const end = min(i + size, len(arr))
        let chunk = []
        let j = i
        while j < end { chunk.push(arr[j]); j = j + 1 }
        chunks.push(chunk)
        i = i + size
    }
    chunks
}

func op_array_window(args) {
    const arr = args[0]
    const size = op_to_i64(args[1])
    if size <= 0 || size > len(arr) { return [] }
    let windows = []
    let i = 0
    while i <= len(arr) - size {
        let window = []
        let j = 0
        while j < size { window.push(arr[i + j]); j = j + 1 }
        windows.push(window)
        i = i + 1
    }
    windows
}

func op_array_unique(args) {
    const arr = args[0]
    let seen = {"__s": true}
    let result = []
    for item in arr {
        const key = to_string(item)
        if !seen.has(key) {
            seen[key] = true
            result.push(item)
        }
    }
    result
}

func op_array_flatten_deep(args) {
    const arr = args[0]
    const depth = if len(args) > 1 { op_to_i64(args[1]) } else { 999 }
    flatten_recursive(arr, depth)
}

func flatten_recursive(arr, depth) {
    if depth <= 0 { return arr }
    let result = []
    for item in arr {
        if typeof(item) == "array" {
            const flattened = flatten_recursive(item, depth - 1)
            for f in flattened { result.push(f) }
        } else {
            result.push(item)
        }
    }
    result
}

func op_array_group_by(args) {
    const arr = args[0]
    const key_fn = args[1]
    let groups = {"__s": true}
    for item in arr {
        const key = to_string(key_fn(item))
        if !groups.has(key) { groups[key] = [] }
        groups[key].push(item)
    }
    groups
}

func op_array_partition(args) {
    const arr = args[0]
    const pred = args[1]
    let pass = []
    let fail = []
    for item in arr {
        if pred(item) { pass.push(item) } else { fail.push(item) }
    }
    [pass, fail]
}

func op_array_scan(args) {
    const arr = args[0]
    const init = args[1]
    const cb = args[2]
    let acc = init
    let result = [acc]
    for item in arr {
        acc = cb(acc, item)
        result.push(acc)
    }
    result
}

// ── Map Operations (extended) ───────────────────────────────────

func op_map_map_keys(args) {
    const m = args[0]
    const cb = args[1]
    let result = {"__s": true}
    for key in m.keys() {
        if key == "__s" { continue }
        const new_key = to_string(cb(key))
        result[new_key] = m[key]
    }
    result
}

func op_map_map_values(args) {
    const m = args[0]
    const cb = args[1]
    let result = {"__s": true}
    for key in m.keys() {
        if key == "__s" { continue }
        result[key] = cb(m[key])
    }
    result
}

func op_map_select_keys(args) {
    const m = args[0]
    const keys_list = args[1]
    let result = {"__s": true}
    for key in keys_list {
        if m.has(key) { result[key] = m[key] }
    }
    result
}

func op_map_reject_keys(args) {
    const m = args[0]
    const keys_list = args[1]
    let reject_set = {"__s": true}
    for key in keys_list { reject_set[key] = true }
    let result = {"__s": true}
    for key in m.keys() {
        if key == "__s" { continue }
        if !reject_set.has(key) { result[key] = m[key] }
    }
    result
}

func op_map_deep_merge(args) {
    const a = args[0]
    const b = args[1]
    let result = {"__s": true}
    // Copy all from a
    for key in a.keys() {
        if key == "__s" { continue }
        result[key] = a[key]
    }
    // Merge from b, deep-merging maps
    for key in b.keys() {
        if key == "__s" { continue }
        if result.has(key) && typeof(result[key]) == "map" && typeof(b[key]) == "map" {
            result[key] = op_map_deep_merge([result[key], b[key]])
        } else {
            result[key] = b[key]
        }
    }
    result
}

// ── Additional dispatch entries ─────────────────────────────────

func eval_operation_extended(op_name, args) {
    match op_name {
        "sinh" => op_sinh(args),
        "cosh" => op_cosh(args),
        "tanh" => op_tanh(args),
        "asinh" => op_asinh(args),
        "acosh" => op_acosh(args),
        "atanh" => op_atanh(args),
        "deg_to_rad" | "to_radians" => op_deg_to_rad(args),
        "rad_to_deg" | "to_degrees" => op_rad_to_deg(args),
        "factorial" => op_factorial(args),
        "gcd" => op_gcd(args),
        "lcm" => op_lcm(args),
        "is_prime" => op_is_prime(args),
        "fibonacci" | "fib" => op_fibonacci(args),
        "combinations" | "nCr" => op_combinations(args),
        "permutations" | "nPr" => op_permutations(args),
        "string_center" | "center" => op_string_center(args),
        "string_count" | "count_substr" => op_string_count(args),
        "is_digit" => op_string_is_digit(args),
        "is_alpha" => op_string_is_alpha(args),
        "is_alnum" => op_string_is_alnum(args),
        "title_case" => op_string_title_case(args),
        "camel_case" => op_string_camel_case(args),
        "zip" => op_array_zip(args),
        "unzip" => op_array_unzip(args),
        "chunk" | "chunks" => op_array_chunk(args),
        "window" | "windows" | "sliding_window" => op_array_window(args),
        "unique" | "distinct" => op_array_unique(args),
        "flatten_deep" | "deep_flatten" => op_array_flatten_deep(args),
        "group_by" => op_array_group_by(args),
        "partition" => op_array_partition(args),
        "scan" | "accumulate" => op_array_scan(args),
        "map_keys" => op_map_map_keys(args),
        "map_values" => op_map_map_values(args),
        "select_keys" | "pick" => op_map_select_keys(args),
        "reject_keys" | "omit" => op_map_reject_keys(args),
        "deep_merge" => op_map_deep_merge(args),
        _ => null,
    }
}

// ══════════════════════════════════════════════════════════════════
// Stats Operations (moving average, exponential smoothing, histogram)
// ══════════════════════════════════════════════════════════════════

func op_moving_average(args) {
    const data = args[0]
    const window = if len(args) > 1 { op_to_i64(args[1]) } else { 3 }
    if typeof(data) != "array" || len(data) == 0 { return [] }

    let result = []
    let i = 0
    while i < len(data) {
        let sum = 0.0
        let count = 0
        let j = if i - window + 1 > 0 { i - window + 1 } else { 0 }
        while j <= i {
            sum = sum + op_to_f64(data[j])
            count = count + 1
            j = j + 1
        }
        result.push(sum / to_float64(count))
        i = i + 1
    }
    result
}

func op_exponential_smoothing(args) {
    const data = args[0]
    const alpha = if len(args) > 1 { op_to_f64(args[1]) } else { 0.3 }
    if typeof(data) != "array" || len(data) == 0 { return [] }

    let result = [op_to_f64(data[0])]
    let i = 1
    while i < len(data) {
        const prev = result[i - 1]
        const curr = op_to_f64(data[i])
        result.push(alpha * curr + (1.0 - alpha) * prev)
        i = i + 1
    }
    result
}

func op_histogram(args) {
    const data = args[0]
    const bins = if len(args) > 1 { op_to_i64(args[1]) } else { 10 }
    if typeof(data) != "array" || len(data) == 0 { return [] }

    // Find min/max
    let min_val = op_to_f64(data[0])
    let max_val = op_to_f64(data[0])
    for d in data {
        const v = op_to_f64(d)
        if v < min_val { min_val = v }
        if v > max_val { max_val = v }
    }

    const range = max_val - min_val
    if range == 0.0 { return [{"low": min_val, "high": max_val, "count": len(data)}] }

    const bin_width = range / to_float64(bins)

    // Initialize bins
    let counts = []
    let edges = []
    let i = 0
    while i < bins {
        counts.push(0)
        edges.push(min_val + to_float64(i) * bin_width)
        i = i + 1
    }
    edges.push(max_val)

    // Count items in each bin
    for d in data {
        const v = op_to_f64(d)
        let bin_idx = to_int64((v - min_val) / bin_width)
        if bin_idx >= bins { bin_idx = bins - 1 }
        if bin_idx < 0 { bin_idx = 0 }
        counts[bin_idx] = counts[bin_idx] + 1
    }

    // Build result
    let result = []
    i = 0
    while i < bins {
        result.push({
            "low": edges[i],
            "high": edges[i + 1],
            "count": counts[i],
        })
        i = i + 1
    }
    result
}

func op_weighted_average(args) {
    const values = args[0]
    const weights = args[1]
    if typeof(values) != "array" || typeof(weights) != "array" { return 0.0 }
    if len(values) != len(weights) { return 0.0 }

    let sum = 0.0
    let weight_sum = 0.0
    let i = 0
    while i < len(values) {
        const v = op_to_f64(values[i])
        const w = op_to_f64(weights[i])
        sum = sum + v * w
        weight_sum = weight_sum + w
        i = i + 1
    }
    if weight_sum == 0.0 { 0.0 } else { sum / weight_sum }
}

func op_covariance(args) {
    const xs = args[0]
    const ys = args[1]
    if typeof(xs) != "array" || typeof(ys) != "array" { return 0.0 }
    const n = if len(xs) < len(ys) { len(xs) } else { len(ys) }
    if n == 0 { return 0.0 }

    let sum_x = 0.0
    let sum_y = 0.0
    let i = 0
    while i < n { sum_x = sum_x + op_to_f64(xs[i]); sum_y = sum_y + op_to_f64(ys[i]); i = i + 1 }
    const mean_x = sum_x / to_float64(n)
    const mean_y = sum_y / to_float64(n)

    let cov = 0.0
    i = 0
    while i < n {
        cov = cov + (op_to_f64(xs[i]) - mean_x) * (op_to_f64(ys[i]) - mean_y)
        i = i + 1
    }
    cov / to_float64(n)
}

func op_percentile(args) {
    const data = args[0]
    const p = op_to_f64(args[1])
    if typeof(data) != "array" || len(data) == 0 { return 0.0 }

    let sorted = data.map(d => op_to_f64(d))
    sorted.sort((a, b) => a - b)

    const idx = (p / 100.0) * to_float64(len(sorted) - 1)
    const lower = to_int64(floor(idx))
    const upper = to_int64(ceil(idx))
    if lower == upper { return sorted[lower] }
    const frac = idx - to_float64(lower)
    sorted[lower] * (1.0 - frac) + sorted[upper] * frac
}

func op_zscore(args) {
    const data = args[0]
    if typeof(data) != "array" || len(data) <= 1 { return [] }

    let sum = 0.0
    for d in data { sum = sum + op_to_f64(d) }
    const mean = sum / to_float64(len(data))

    let sq_sum = 0.0
    for d in data {
        const diff = op_to_f64(d) - mean
        sq_sum = sq_sum + diff * diff
    }
    const std_dev = sqrt(sq_sum / to_float64(len(data)))
    if std_dev == 0.0 { return data.map(d => 0.0) }

    data.map(d => (op_to_f64(d) - mean) / std_dev)
}

// ══════════════════════════════════════════════════════════════════
// Format Operations (all format specifiers)
// ══════════════════════════════════════════════════════════════════

func op_format(args) {
    const fmt = to_string(args[0])
    const values = if len(args) > 1 { args.slice(1) } else { [] }

    let result = ""
    let vi = 0
    let i = 0
    while i < len(fmt) {
        if fmt[i] == "{" && i + 1 < len(fmt) {
            if fmt[i + 1] == "{" {
                result = result + "{"
                i = i + 2
                continue
            }
            // Find closing brace
            let end = i + 1
            while end < len(fmt) && fmt[end] != "}" { end = end + 1 }
            if end < len(fmt) {
                const spec = fmt.slice(i + 1, end)
                if vi < len(values) {
                    if len(spec) == 0 {
                        result = result + to_string(values[vi])
                    } else if spec.contains(":") {
                        const parts = spec.split(":")
                        const format_str = parts[1]
                        result = result + format_value(values[vi], format_str)
                    } else {
                        result = result + to_string(values[vi])
                    }
                    vi = vi + 1
                }
                i = end + 1
                continue
            }
        }
        if fmt[i] == "}" && i + 1 < len(fmt) && fmt[i + 1] == "}" {
            result = result + "}"
            i = i + 2
            continue
        }
        result = result + fmt[i]
        i = i + 1
    }
    result
}

func format_value(value, spec) {
    const t = typeof(value)
    if t == "int64" || t == "float64" {
        return i_format_number(value, spec)
    }
    if t == "string" {
        return format_string(value, spec)
    }
    to_string(value)
}

func format_string(s, spec) {
    // Parse width and alignment for strings
    let width = 0
    let fill = " "
    let align = "<" // strings default left-aligned

    let i = 0
    if len(spec) >= 2 && (spec[1] == "<" || spec[1] == ">" || spec[1] == "^") {
        fill = spec[0]
        align = spec[1]
        i = 2
    } else if len(spec) >= 1 && (spec[0] == "<" || spec[0] == ">" || spec[0] == "^") {
        align = spec[0]
        i = 1
    }

    // Parse width
    let width_str = ""
    while i < len(spec) && spec[i] >= "0" && spec[i] <= "9" {
        width_str = width_str + spec[i]
        i = i + 1
    }
    if len(width_str) > 0 { width = to_int64(width_str) }

    // Parse precision (max length for strings)
    let max_len = -1
    if i < len(spec) && spec[i] == "." {
        i = i + 1
        let prec_str = ""
        while i < len(spec) && spec[i] >= "0" && spec[i] <= "9" {
            prec_str = prec_str + spec[i]
            i = i + 1
        }
        if len(prec_str) > 0 { max_len = to_int64(prec_str) }
    }

    let result = s
    if max_len >= 0 && len(result) > max_len { result = result.slice(0, max_len) }

    if width > 0 && len(result) < width {
        const padding = width - len(result)
        match align {
            "<" => { result = result + fill.repeat(padding) },
            ">" => { result = fill.repeat(padding) + result },
            "^" => {
                const left = padding / 2
                const right = padding - left
                result = fill.repeat(left) + result + fill.repeat(right)
            },
            _ => { result = result + fill.repeat(padding) },
        }
    }
    result
}

// ══════════════════════════════════════════════════════════════════
// Reflect Operations
// ══════════════════════════════════════════════════════════════════

func op_reflect_fields(args) {
    const obj = args[0]
    if typeof(obj) != "map" { return [] }
    obj.keys().filter(k => k != "__s" && !k.starts_with("__"))
}

func op_reflect_methods(args) {
    const obj = args[0]
    if typeof(obj) != "map" { return [] }
    let methods = []
    for k in obj.keys() {
        if k == "__s" { continue }
        const v = obj[k]
        if typeof(v) == "map" && (v.has("__lambda") || v.has("__builtin")) {
            methods.push(k)
        }
    }
    methods
}

func op_reflect_implements(args) {
    const obj = args[0]
    const iface_name = to_string(args[1])
    // Check if object has all required methods of the interface
    // Simplified: check if it has the fields expected
    if typeof(obj) != "map" { return false }
    true // Structural typing: any map "implements" any interface
}

func op_reflect_arity(args) {
    const cb = args[0]
    if typeof(fn_val) != "map" { return -1 }
    if fn_val.has("params") { return len(fn_val["params"]) }
    if fn_val.has("__lambda") && fn_val.has("params") { return len(fn_val["params"]) }
    -1
}

func op_reflect_type_name(args) {
    const val = args[0]
    if val == null { return "Null" }
    const t = typeof(val)
    if t == "map" {
        if val.has("__struct") { return val["__struct"] }
        if val.has("__enum") { return val["__enum"] }
        if val.has("__lambda") { return "Function" }
        if val.has("__channel") { return "Channel" }
        if val.has("__promise") { return "Promise" }
        return "Map"
    }
    if t == "array" { return "Array" }
    if t == "int64" { return "Int" }
    if t == "float64" { return "Float" }
    if t == "string" { return "String" }
    if t == "bool" { return "Bool" }
    t
}

func op_reflect_is_struct(args) {
    typeof(args[0]) == "map" && args[0].has("__struct")
}

func op_reflect_is_enum(args) {
    typeof(args[0]) == "map" && args[0].has("__enum")
}

func op_reflect_is_function(args) {
    const v = args[0]
    typeof(v) == "map" && (v.has("__lambda") || v.has("__builtin"))
}

func op_reflect_struct_name(args) {
    const v = args[0]
    if typeof(v) == "map" && v.has("__struct") { v["__struct"] } else { null }
}

func op_reflect_enum_variant(args) {
    const v = args[0]
    if typeof(v) == "map" && v.has("__variant") { v["__variant"] } else { null }
}

// ══════════════════════════════════════════════════════════════════
// Itertools Operations
// ══════════════════════════════════════════════════════════════════

func op_combinations(args) {
    const items = args[0]
    const k = if len(args) > 1 { op_to_i64(args[1]) } else { 2 }
    if typeof(items) != "array" { return [] }
    if k > len(items) || k < 0 { return [] }
    if k == 0 { return [[]] }

    let result = []
    combinations_rec(items, k, 0, [], result)
    result
}

func combinations_rec(items, k, start, current, result) {
    if len(current) == k {
        let combo = []
        for c in current { combo.push(c) }
        result.push(combo)
        return
    }
    let i = start
    while i < len(items) {
        current.push(items[i])
        combinations_rec(items, k, i + 1, current, result)
        current.pop()
        i = i + 1
    }
}

func op_permutations(args) {
    const items = args[0]
    const k = if len(args) > 1 { op_to_i64(args[1]) } else { len(items) }
    if typeof(items) != "array" { return [] }
    if k > len(items) || k < 0 { return [] }
    if k == 0 { return [[]] }

    let result = []
    let used = items.map(x => false)
    permutations_rec(items, k, [], used, result)
    result
}

func permutations_rec(items, k, current, used, result) {
    if len(current) == k {
        let perm = []
        for c in current { perm.push(c) }
        result.push(perm)
        return
    }
    let i = 0
    while i < len(items) {
        if !used[i] {
            used[i] = true
            current.push(items[i])
            permutations_rec(items, k, current, used, result)
            current.pop()
            used[i] = false
        }
        i = i + 1
    }
}

func op_powerset(args) {
    const items = args[0]
    if typeof(items) != "array" { return [[]] }

    let result = [[]]
    for item in items {
        const current_len = len(result)
        let i = 0
        while i < current_len {
            let new_set = []
            for x in result[i] { new_set.push(x) }
            new_set.push(item)
            result.push(new_set)
            i = i + 1
        }
    }
    result
}

func op_cartesian_product(args) {
    if len(args) < 2 { return [] }
    const a = args[0]
    const b = args[1]
    if typeof(a) != "array" || typeof(b) != "array" { return [] }

    let result = []
    for x in a {
        for y in b {
            result.push([x, y])
        }
    }
    result
}

func op_interleave(args) {
    const a = args[0]
    const b = args[1]
    if typeof(a) != "array" || typeof(b) != "array" { return [] }

    let result = []
    const max_len = if len(a) > len(b) { len(a) } else { len(b) }
    let i = 0
    while i < max_len {
        if i < len(a) { result.push(a[i]) }
        if i < len(b) { result.push(b[i]) }
        i = i + 1
    }
    result
}

func op_cycle(args) {
    const items = args[0]
    const n = if len(args) > 1 { op_to_i64(args[1]) } else { len(items) * 2 }
    if typeof(items) != "array" || len(items) == 0 { return [] }

    let result = []
    let i = 0
    while i < n {
        result.push(items[i % len(items)])
        i = i + 1
    }
    result
}

func op_repeat_each(args) {
    const items = args[0]
    const n = if len(args) > 1 { op_to_i64(args[1]) } else { 2 }
    if typeof(items) != "array" { return [] }

    let result = []
    for item in items {
        let i = 0
        while i < n {
            result.push(item)
            i = i + 1
        }
    }
    result
}

func op_adjacent_pairs(args) {
    const items = args[0]
    if typeof(items) != "array" || len(items) < 2 { return [] }

    let result = []
    let i = 0
    while i < len(items) - 1 {
        result.push([items[i], items[i + 1]])
        i = i + 1
    }
    result
}
