// ══════════════════════════════════════════════════════════════════
// Full Template Operations
// ══════════════════════════════════════════════════════════════════

func op_template_render_full(template, vars) {
    let result = template
    for k in vars.keys() {
        if k == "__s" || k == "__init" { continue }
        const placeholder = "{{" + k + "}}"
        result = result.replace(placeholder, to_string(vars[k]))
    }
    result
}

// Template with conditional blocks: {{#if cond}}...{{/if}}
func op_template_with_conditions(template, vars) {
    let result = op_template_render_full(template, vars)
    // Process {{#if key}}...{{/if}} blocks
    while result.contains("{{#if ") {
        const start = result.index_of("{{#if ")
        const end_tag_start = result.index_of("{{/if}}")
        if start < 0 || end_tag_start < 0 { break }
        const cond_end = result.index_of("}}", start)
        const cond_name = result.slice(start + 6, cond_end)
        const block_content = result.slice(cond_end + 2, end_tag_start)
        const cond_val = if vars.has(cond_name.trim()) { vars[cond_name.trim()] } else { null }
        const replacement = if cond_val && cond_val != false && cond_val != null && cond_val != 0 { block_content } else { "" }
        result = result.slice(0, start) + replacement + result.slice(end_tag_start + 7, len(result))
    }
    result
}

