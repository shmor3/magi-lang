    // ── Stats (12) ───────────────────────────────────────────────

    "stats_mean" => {
        const arr = args[0]
        if len(arr) == 0 { return 0.0 }
        let sum = 0.0
        for x in arr { sum = sum + op_to_f64(x) }
        sum / to_float64(len(arr))
    },
    "stats_median" => {
        let arr = args[0].sort()
        const n = len(arr)
        if n == 0 { return 0.0 }
        if n % 2 == 1 {
            op_to_f64(arr[n / 2])
        } else {
            (op_to_f64(arr[n / 2 - 1]) + op_to_f64(arr[n / 2])) / 2.0
        }
    },
    "stats_mode" => {
        const arr = args[0]
        let counts = {}
        for x in arr {
            const k = to_string(x)
            if counts.has(k) {
                counts[k] = counts[k] + 1
            } else {
                counts[k] = 1
            }
        }
        let best_key = null
        let best_count = 0
        for k in counts.keys() {
            if counts[k] > best_count {
                best_count = counts[k]
                best_key = k
            }
        }
        // Return the original value, not the string key
        for x in arr {
            if to_string(x) == best_key { return x }
        }
        null
    },
    "stats_variance" => {
        const arr = args[0]
        const n = len(arr)
        if n == 0 { return 0.0 }
        let sum = 0.0
        for x in arr { sum = sum + op_to_f64(x) }
        const mean = sum / to_float64(n)
        let var_sum = 0.0
        for x in arr {
            const diff = op_to_f64(x) - mean
            var_sum = var_sum + diff * diff
        }
        var_sum / to_float64(n)
    },
    "stats_std_dev" => {
        const arr = args[0]
        const n = len(arr)
        if n == 0 { return 0.0 }
        let sum = 0.0
        for x in arr { sum = sum + op_to_f64(x) }
        const mean = sum / to_float64(n)
        let var_sum = 0.0
        for x in arr {
            const diff = op_to_f64(x) - mean
            var_sum = var_sum + diff * diff
        }
        sqrt(var_sum / to_float64(n))
    },
    "stats_min_by" => {
        const arr = args[0]
        const fn_val = args[1]
        if len(arr) == 0 { return null }
        let best = arr[0]
        let best_key = fn_val(arr[0])
        let i = 1
        while i < len(arr) {
            const k = fn_val(arr[i])
            if k < best_key {
                best = arr[i]
                best_key = k
            }
            i = i + 1
        }
        best
    },
    "stats_max_by" => {
        const arr = args[0]
        const fn_val = args[1]
        if len(arr) == 0 { return null }
        let best = arr[0]
        let best_key = fn_val(arr[0])
        let i = 1
        while i < len(arr) {
            const k = fn_val(arr[i])
            if k > best_key {
                best = arr[i]
                best_key = k
            }
            i = i + 1
        }
        best
    },
    "stats_sum" => {
        let total = 0
        for x in args[0] { total = total + x }
        total
    },
    "stats_percentile" => stats_percentile(args[0], op_to_f64(args[1])),
    "stats_quantile" => stats_quantile(args[0], op_to_f64(args[1])),
    "stats_covariance" => stats_covariance(args[0], args[1]),
    "stats_correlation" => stats_correlation(args[0], args[1]),

    // ── Text (10) ────────────────────────────────────────────────

    "text_wrap" => text_wrap(args[0], op_to_i64(args[1])),
    "text_dedent" => text_dedent(args[0]),
    "text_indent" => text_indent(args[0], args[1]),
    "text_pad_left" => pad_start(args[0], op_to_i64(args[1]), op_arg(args, 2, " ")),
    "text_pad_right" => pad_end(args[0], op_to_i64(args[1]), op_arg(args, 2, " ")),
    "text_truncate" => {
        const s = args[0]
        const max_len = op_to_i64(args[1])
        const suffix = op_arg(args, 2, "...")
        if len(s) <= max_len { s }
        else { s.slice(0, max_len - len(suffix)) + suffix }
    },
    "text_slug" => text_slug(args[0]),
    "text_camel_case" => text_camel_case(args[0]),
    "text_snake_case" => text_snake_case(args[0]),
