    // ── Reflect (8) ──────────────────────────────────────────────

    "reflect_type_of" => typeof(args[0]),
    "reflect_type_name" => {
        const v = args[0]
        const t = typeof(v)
        if t == "map" && v.has("__struct") { v["__struct"] }
        else if t == "map" && v.has("__enum") { v["__enum"] }
        else { t }
    },
    "reflect_is_type" => typeof(args[0]) == args[1],
    "reflect_fields" => {
        const v = args[0]
        if typeof(v) == "map" {
            v.keys().filter(k => !k.starts_with("__"))
        } else {
            []
        }
    },
    "reflect_has_field" => {
        const v = args[0]
        const field = to_string(args[1])
        typeof(v) == "map" && v.has(field)
    },
    "reflect_callable" => {
        const v = args[0]
        typeof(v) == "map" && v.has("__lambda")
    },
    "reflect_arity" => {
        const v = args[0]
        if typeof(v) == "map" && v.has("params") {
            len(v["params"])
        } else {
            0
        }
    },
    "reflect_inspect" => reflect_inspect(args[0]),

    // ── Collections (8) ──────────────────────────────────────────

    "set_from" => {
        const arr = args[0]
        let seen = {}
        let result = []
        for item in arr {
            const k = to_string(item)
            if !seen.has(k) {
                seen[k] = true
                result.push(item)
            }
        }
        result
    },
    "set_union" => {
        const a = args[0]
        const b = args[1]
        let seen = {}
        let result = []
        for item in a {
            const k = to_string(item)
            if !seen.has(k) {
                seen[k] = true
                result.push(item)
            }
        }
        for item in b {
            const k = to_string(item)
            if !seen.has(k) {
                seen[k] = true
                result.push(item)
            }
        }
        result
    },
    "set_intersection" => {
        const a = args[0]
        const b = args[1]
        let b_set = {}
        for item in b { b_set[to_string(item)] = true }
        let result = []
        for item in a {
            if b_set.has(to_string(item)) {
                result.push(item)
            }
        }
        result
    },
    "set_difference" => {
        const a = args[0]
        const b = args[1]
        let b_set = {}
        for item in b { b_set[to_string(item)] = true }
        let result = []
        for item in a {
            if !b_set.has(to_string(item)) {
                result.push(item)
            }
        }
        result
    },
    "set_symmetric_difference" => {
        const a = args[0]
        const b = args[1]
        let a_set = {}
        let b_set = {}
        for item in a { a_set[to_string(item)] = true }
        for item in b { b_set[to_string(item)] = true }
        let result = []
        for item in a {
            if !b_set.has(to_string(item)) { result.push(item) }
        }
        for item in b {
            if !a_set.has(to_string(item)) { result.push(item) }
        }
        result
    },
    "counter" => {
        let counts = {}
        for item in args[0] {
            const k = to_string(item)
            if counts.has(k) { counts[k] = counts[k] + 1 }
            else { counts[k] = 1 }
        }
        counts
    },
    "most_common" => {
        const arr = args[0]
        const n = op_to_i64(op_arg(args, 1, 1))
        let counts = {}
        for item in arr {
            const k = to_string(item)
            if counts.has(k) { counts[k] = counts[k] + 1 }
            else { counts[k] = 1 }
        }
        let entries = []
        for k in counts.keys() {
            entries.push([k, counts[k]])
        }
        entries = entries.sort()
        entries = entries.reverse()
        entries.slice(0, n)
    },
    "ordered_map" => {
        // Return args[0] as-is (maps are already ordered in MAGI)
        args[0]
    },

    // ── Sort (8) ─────────────────────────────────────────────────

    "sort_asc" => args[0].sort(),
    "sort_desc" => args[0].sort().reverse(),
    "sort_by" => {
        const arr = args[0]
        const fn_val = args[1]
        let decorated = arr.map(x => [fn_val(x), x])
        decorated = decorated.sort()
        decorated.map(pair => pair[1])
    },
    "sort_by_key" => {
        const arr = args[0]
        const key = args[1]
        let decorated = arr.map(x => [x[key], x])
        decorated = decorated.sort()
        decorated.map(pair => pair[1])
    },
    "stable_sort" => args[0].sort(),
    "is_sorted" => {
        const arr = args[0]
        let i = 1
        while i < len(arr) {
            if arr[i] < arr[i - 1] { return false }
            i = i + 1
        }
        true
    },
    "binary_search" => {
        const arr = args[0]
        const target = args[1]
        let lo = 0
        let hi = len(arr) - 1
        while lo <= hi {
            const mid = (lo + hi) / 2
            if arr[mid] == target { return mid }
            if arr[mid] < target { lo = mid + 1 }
            else { hi = mid - 1 }
        }
        -1
    },
    "sort_reverse" => args[0].reverse(),

    // ── Subprocess (3) ───────────────────────────────────────────

    "exec" => exec_cmd(args[0], op_arg(args, 1, [])),
    "exec_status" => exec_status(args[0], op_arg(args, 1, [])),
    "exec_output" => exec_output(args[0], op_arg(args, 1, [])),

    // ── Sync (6) ─────────────────────────────────────────────────

    "mutex_new" => mutex_new(),
    "mutex_lock" => mutex_lock(args[0]),
    "mutex_unlock" => mutex_unlock(args[0]),
    "waitgroup_new" => waitgroup_new(),
    "waitgroup_done" => waitgroup_done(args[0]),
    "waitgroup_wait" => waitgroup_wait(args[0]),

    // ── Concurrency (1) ──────────────────────────────────────────

    "await_all" => await_all(args[0]),

    // ── Log (4) ──────────────────────────────────────────────────

    "log_info" => {
        println(f"[INFO] {to_string(args[0])}")
        null
    },
    "log_warn" => {
        println(f"[WARN] {to_string(args[0])}")
        null
    },
    "log_error" => {
        println(f"[ERROR] {to_string(args[0])}")
        null
    },
    "log_debug" => {
        println(f"[DEBUG] {to_string(args[0])}")
        null
    },

    // ── Itertools (5) ────────────────────────────────────────────

    "iter_chain" => {
        let result = []
        for arr in args {
            if typeof(arr) == "array" {
                result = result.concat(arr)
            }
        }
        result
    },
    "iter_cycle" => {
        // iter_cycle(arr, n) - repeat array n times
        const arr = args[0]
        const n = op_to_i64(args[1])
        let result = []
        let i = 0
        while i < n {
            result = result.concat(arr)
            i = i + 1
        }
        result
    },
    "iter_repeat" => {
        // iter_repeat(val, n) - create array of val repeated n times
        const val = args[0]
        const n = op_to_i64(args[1])
        let result = []
        let i = 0
        while i < n {
            result.push(val)
            i = i + 1
        }
        result
    },
    "iter_product" => {
        // Cartesian product of two arrays
        const a = args[0]
        const b = args[1]
        let result = []
        for x in a {
            for y in b {
                result.push([x, y])
            }
        }
        result
    },
    "iter_pairwise" => {
        // Adjacent pairs
        const arr = args[0]
        let result = []
        let i = 0
        while i + 1 < len(arr) {
            result.push([arr[i], arr[i + 1]])
            i = i + 1
        }
        result
    },

    // ── Template (1) ─────────────────────────────────────────────

    "template_render" => template_render(args[0], args[1]),

    // ── Flag (2) ─────────────────────────────────────────────────

    "flag_parse" => flag_parse(args[0]),
    "flag_args" => flag_args(),

    // ── Additional Math (7) ──────────────────────────────────────

    "gamma" => gamma(op_to_f64(args[0])),
    "lgamma" => lgamma(op_to_f64(args[0])),
    "erf" => erf(op_to_f64(args[0])),
    "erfc" => erfc(op_to_f64(args[0])),
    "expm1" => expm1(op_to_f64(args[0])),
    "nextafter" => nextafter(op_to_f64(args[0]), op_to_f64(args[1])),
    "signbit" => signbit(op_to_f64(args[0])),

    // ── Additional OS (3) ────────────────────────────────────────

    "chown" => chown(args[0], op_to_i64(args[1]), op_to_i64(args[2])),
    "hardlink" => hardlink(args[0], args[1]),
    "pipe" => pipe(),

    // ── Additional strconv (2) ───────────────────────────────────

    "format_float" => format_float(op_to_f64(args[0]), op_arg(args, 1, "g"), op_arg(args, 2, -1)),
    "parse_uint" => parse_uint(args[0], op_arg(args, 1, 10)),

    // ── Additional CLI (3) ───────────────────────────────────────

    "cli_fix" => cli_fix(args[0]),
    "cli_clean" => cli_clean(args[0]),
    "cli_tree" => cli_tree(args[0]),

    // ── Platform: Terminal (4) ───────────────────────────────────

    "raw_mode_enable" => raw_mode_enable(),
    "raw_mode_disable" => raw_mode_disable(),
    "read_byte" => read_byte(),
    "read_byte_timeout" => read_byte_timeout(op_to_i64(args[0])),

    // ── Platform: SDL2 Graphics (11) ─────────────────────────────

    "sdl_init" => sdl_init(args[0], op_to_i64(args[1]), op_to_i64(args[2])),
    "sdl_set_color" => sdl_set_color(op_to_i64(args[0]), op_to_i64(args[1]), op_to_i64(args[2]), op_to_i64(args[3])),
    "sdl_clear" => sdl_clear(),
    "sdl_present" => sdl_present(),
    "sdl_draw_pixel" => sdl_draw_pixel(op_to_i64(args[0]), op_to_i64(args[1])),
    "sdl_draw_line" => sdl_draw_line(op_to_i64(args[0]), op_to_i64(args[1]), op_to_i64(args[2]), op_to_i64(args[3])),
    "sdl_fill_rect" => sdl_fill_rect(op_to_i64(args[0]), op_to_i64(args[1]), op_to_i64(args[2]), op_to_i64(args[3])),
    "sdl_poll_event" => sdl_poll_event(),
    "sdl_delay" => sdl_delay(op_to_i64(args[0])),
    "sdl_ticks" => sdl_ticks(),
    "sdl_destroy" => sdl_destroy(),

    // ── Platform: Audio (4) ──────────────────────────────────────

    "audio_stream_new" => audio_stream_new(op_to_i64(args[0]), op_to_i64(args[1])),
    "audio_write_samples" => audio_write_samples(args[0], args[1]),
    "audio_drain" => audio_drain(args[0]),
    "audio_close" => audio_close(args[0]),

    // ── Platform: WebGPU (12) ────────────────────────────────────

    "gpu_init" => gpu_init(args[0]),
    "gpu_create_buffer" => gpu_create_buffer(args[0], args[1]),
    "gpu_create_shader" => gpu_create_shader(args[0]),
    "gpu_create_pipeline" => gpu_create_pipeline(args[0]),
    "gpu_begin_render_pass" => gpu_begin_render_pass(args[0]),
    "gpu_draw" => gpu_draw(args[0], op_to_i64(args[1])),
    "gpu_end_render_pass" => gpu_end_render_pass(args[0]),
    "gpu_submit" => gpu_submit(args[0]),
    "gpu_present" => gpu_present(args[0]),
    "gpu_write_buffer" => gpu_write_buffer(args[0], args[1]),
    "gpu_create_texture" => gpu_create_texture(args[0]),
    "gpu_destroy" => gpu_destroy(args[0]),

    // ── Fallback ─────────────────────────────────────────────────

    _ => panic(f"unknown operation: {op_name}"),

    }
}

// ══════════════════════════════════════════════════════════════════
// Full String Operations with Edge Cases
// ══════════════════════════════════════════════════════════════════

func op_string_repeat(s, count) {
    if count <= 0 { return "" }
    let result = ""
    let i = 0
    while i < count { result = result + s; i = i + 1 }
    result
}

func op_string_reverse(s) {
    let result = ""
    let i = len(s) - 1
    while i >= 0 { result = result + s[i]; i = i - 1 }
    result
}

func op_string_center(s, width, fill) {
    if len(s) >= width { return s }
    const padding = width - len(s)
    const left = padding / 2
    const right = padding - left
    op_string_repeat(fill, left) + s + op_string_repeat(fill, right)
}

func op_string_count(haystack, needle) {
    if len(needle) == 0 { return len(haystack) + 1 }
    let count = 0
    let i = 0
    while i <= len(haystack) - len(needle) {
        if haystack.substring(i, i + len(needle)) == needle {
            count = count + 1; i = i + len(needle)
        } else { i = i + 1 }
    }
    count
}

func op_string_words(s) {
    let result = []
    let current = ""
    for c in s.chars() {
        if c == " " || c == "\t" || c == "\n" || c == "\r" {
            if len(current) > 0 { result.push(current); current = "" }
        } else { current = current + c }
    }
    if len(current) > 0 { result.push(current) }
    result
}

func op_string_capitalize(s) {
    if len(s) == 0 { return "" }
    to_upper(s[0]) + s.substring(1, len(s))
}

func op_string_last_index_of(haystack, needle) {
    let i = len(haystack) - len(needle)
    while i >= 0 {
        if haystack.substring(i, i + len(needle)) == needle { return i }
        i = i - 1
    }
    -1
}

// ══════════════════════════════════════════════════════════════════
// Full Stats Operations
// ══════════════════════════════════════════════════════════════════

func op_stats_mean(arr) {
    if len(arr) == 0 { return 0.0 }
    let sum = 0.0
    for v in arr { sum = sum + op_to_f64(v) }
    sum / op_to_f64(len(arr))
}

func op_stats_median(arr) {
    if len(arr) == 0 { return 0.0 }
    let sorted = arr.sort()
    const n = len(sorted)
    if n % 2 == 1 { op_to_f64(sorted[n / 2]) }
    else { (op_to_f64(sorted[n / 2 - 1]) + op_to_f64(sorted[n / 2])) / 2.0 }
}

func op_stats_variance(arr) {
    if len(arr) <= 1 { return 0.0 }
    const mean = op_stats_mean(arr)
    let sum_sq = 0.0
    for v in arr { const diff = op_to_f64(v) - mean; sum_sq = sum_sq + diff * diff }
    sum_sq / op_to_f64(len(arr) - 1)
}

func op_stats_stddev(arr) { sqrt(op_stats_variance(arr)) }

func op_stats_covariance(xs, ys) {
    if len(xs) != len(ys) || len(xs) <= 1 { return 0.0 }
    const mx = op_stats_mean(xs)
    const my = op_stats_mean(ys)
    let sum = 0.0
    let i = 0
    while i < len(xs) { sum = sum + (op_to_f64(xs[i]) - mx) * (op_to_f64(ys[i]) - my); i = i + 1 }
    sum / op_to_f64(len(xs) - 1)
}

func op_stats_correlation(xs, ys) {
    const cov = op_stats_covariance(xs, ys)
    const sx = op_stats_stddev(xs)
    const sy = op_stats_stddev(ys)
    if sx == 0.0 || sy == 0.0 { return 0.0 }
    cov / (sx * sy)
}

func op_stats_percentile(arr, p) {
    if len(arr) == 0 { return 0.0 }
    let sorted = arr.sort()
    const idx = op_to_f64(p) / 100.0 * op_to_f64(len(sorted) - 1)
    const lower = floor(idx)
    const upper = ceil(idx)
    if lower == upper { return op_to_f64(sorted[lower]) }
    const frac = idx - op_to_f64(lower)
    op_to_f64(sorted[lower]) * (1.0 - frac) + op_to_f64(sorted[upper]) * frac
}

func op_stats_z_score(arr, value) {
    const mean = op_stats_mean(arr)
    const sd = op_stats_stddev(arr)
    if sd == 0.0 { return 0.0 }
    (op_to_f64(value) - mean) / sd
}

// ══════════════════════════════════════════════════════════════════
// Full Text Case Operations
// ══════════════════════════════════════════════════════════════════

func op_text_camel_case(s) {
    let parts = []
    let current = ""
    for c in s.chars() {
        if c == " " || c == "_" || c == "-" {
            if len(current) > 0 { parts.push(current); current = "" }
        } else { current = current + c }
    }
    if len(current) > 0 { parts.push(current) }
    if len(parts) == 0 { return "" }
    let result = to_lower(parts[0])
    let i = 1
    while i < len(parts) {
        const p = parts[i]
        if len(p) > 0 { result = result + to_upper(p[0]) + to_lower(p.substring(1, len(p))) }
        i = i + 1
    }
    result
}

func op_text_snake_case(s) {
    let result = ""
    let prev_lower = false
    for c in s.chars() {
        if c == " " || c == "-" { result = result + "_"; prev_lower = false }
        else if c >= "A" && c <= "Z" {
            if prev_lower { result = result + "_" }
            result = result + to_lower(c); prev_lower = false
        } else { result = result + c; prev_lower = (c >= "a" && c <= "z") }
    }
    result
}

func op_text_title_case(s) {
    let result = ""
    let cap_next = true
    for c in s.chars() {
        if c == " " || c == "\t" || c == "-" || c == "_" { result = result + c; cap_next = true }
        else if cap_next { result = result + to_upper(c); cap_next = false }
        else { result = result + to_lower(c) }
    }
    result
}

func op_text_kebab_case(s) {
    let result = ""
    let prev_lower = false
    for c in s.chars() {
        if c == " " || c == "_" { result = result + "-"; prev_lower = false }
        else if c >= "A" && c <= "Z" {
            if prev_lower { result = result + "-" }
            result = result + to_lower(c); prev_lower = false
        } else { result = result + c; prev_lower = (c >= "a" && c <= "z") }
    }
    result
}

// ══════════════════════════════════════════════════════════════════
// Full Format Operations
// ══════════════════════════════════════════════════════════════════

func op_fmt_number(n, decimals) {
    const factor = power(10.0, op_to_f64(decimals))
    to_string(round(op_to_f64(n) * factor) / factor)
}

func op_fmt_bytes(n) {
    const units = ["B", "KB", "MB", "GB", "TB", "PB"]
    let val = op_to_f64(n)
    let ui = 0
    while val >= 1024.0 && ui < len(units) - 1 { val = val / 1024.0; ui = ui + 1 }
    if ui == 0 { f"{op_to_i64(val)} {units[ui]}" }
    else { f"{round(val * 100.0) / 100.0} {units[ui]}" }
}

func op_fmt_duration(ms) {
    const total = op_to_i64(ms)
    if total < 1000 { return f"{total}ms" }
    const s = total / 1000
    if s < 60 { return f"{s}.{(total % 1000) / 100}s" }
    const m = s / 60
    if m < 60 { return f"{m}m {s % 60}s" }
    f"{m / 60}h {m % 60}m"
}

func op_fmt_hex(n) {
    const hex_chars = "0123456789abcdef"
    let val = op_to_i64(n)
    if val == 0 { return "0x0" }
    let neg = val < 0
    if neg { val = 0 - val }
    let result = ""
    while val > 0 { result = hex_chars[val % 16] + result; val = val / 16 }
    if neg { "0x-" + result } else { "0x" + result }
}

func op_fmt_binary(n) {
    let val = op_to_i64(n)
    if val == 0 { return "0b0" }
    let neg = val < 0
    if neg { val = 0 - val }
    let result = ""
    while val > 0 { result = to_string(val % 2) + result; val = val / 2 }
    if neg { "0b-" + result } else { "0b" + result }
}

func op_fmt_percent(n, decimals) { op_fmt_number(op_to_f64(n) * 100.0, decimals) + "%" }

// ══════════════════════════════════════════════════════════════════
// Full Path Operations
// ══════════════════════════════════════════════════════════════════

func op_path_join(parts) { parts.join("/") }
func op_path_dirname(path) {
    const idx = op_string_last_index_of(path, "/")
    if idx < 0 { return "." }
    path.substring(0, idx)
}
func op_path_basename(path) {
    const idx = op_string_last_index_of(path, "/")
    if idx < 0 { return path }
    path.substring(idx + 1, len(path))
}
func op_path_extension(path) {
    const base = op_path_basename(path)
    const idx = op_string_last_index_of(base, ".")
    if idx < 0 { return "" }
    base.substring(idx + 1, len(base))
}
func op_path_stem(path) {
    const base = op_path_basename(path)
    const idx = op_string_last_index_of(base, ".")
    if idx < 0 { return base }
    base.substring(0, idx)
}
func op_path_is_absolute(path) { len(path) > 0 && path[0] == "/" }
func op_path_normalize(path) {
    const parts = path.split("/")
    let result = []
    for part in parts {
        if part == "." { continue }
        if part == ".." && len(result) > 0 { result.pop(); continue }
        if part != "" { result.push(part) }
    }
    const joined = result.join("/")
    if op_path_is_absolute(path) { "/" + joined } else { joined }
}

// ══════════════════════════════════════════════════════════════════
// Array Higher-Order Operations
// ══════════════════════════════════════════════════════════════════

func op_array_unique(arr) {
    let seen = {"__init": true}
    let result = []
    for item in arr {
        const key = to_string(item)
        if !seen.has(key) { seen[key] = true; result.push(item) }
    }
    result
}

func op_array_chunk(arr, size) {
    let result = []
    let i = 0
    while i < len(arr) { result.push(arr.slice(i, min(i + size, len(arr)))); i = i + size }
    result
}

func op_array_window(arr, size) {
    let result = []
    let i = 0
    while i + size <= len(arr) { result.push(arr.slice(i, i + size)); i = i + 1 }
    result
}

func op_array_dedup(arr) {
    if len(arr) == 0 { return [] }
    let result = [arr[0]]
    let i = 1
    while i < len(arr) { if arr[i] != arr[i - 1] { result.push(arr[i]) }; i = i + 1 }
    result
}

// ══════════════════════════════════════════════════════════════════
// Map Operations
// ══════════════════════════════════════════════════════════════════

func op_map_from_entries(entries) {
    let result = {"__init": true}
    for entry in entries {
        if typeof(entry) == "array" && len(entry) >= 2 {
            result[to_string(entry[0])] = entry[1]
        }
    }
    result
}

func op_map_to_entries(m) {
    let result = []
    for k in m.keys() {
        if k == "__s" || k == "__init" { continue }
        result.push([k, m[k]])
    }
    result
}

func op_map_invert(m) {
    let result = {"__init": true}
    for k in m.keys() {
        if k == "__s" || k == "__init" { continue }
        result[to_string(m[k])] = k
    }
    result
}

func op_map_deep_merge(a, b) {
    let result = {}
    for k in a.keys() { result[k] = a[k] }
    for k in b.keys() {
        if result.has(k) && typeof(result[k]) == "map" && typeof(b[k]) == "map" {
            result[k] = op_map_deep_merge(result[k], b[k])
        } else { result[k] = b[k] }
    }
    result
}

// ══════════════════════════════════════════════════════════════════
// Crypto/Compress/Cert/Process/HTTP Operations (delegate to stage 0)
// ══════════════════════════════════════════════════════════════════

func op_crypto_md5(data) { md5(data) }
func op_crypto_sha256(data) { sha256(data) }
func op_crypto_sha512(data) { sha512(data) }
func op_crypto_hmac(key, data, algo) { hmac(key, data, algo) }
func op_crypto_random_bytes(n) { random_bytes(n) }
func op_crypto_uuid() { uuid() }

func op_compress_gzip(data) { gzip_compress(data) }
func op_decompress_gzip(data) { gzip_decompress(data) }

func op_cert_generate(cn, days) { cert_generate(cn, days) }
func op_cert_parse(pem) { cert_parse(pem) }

func op_run_command(cmd) { run_command(cmd) }
func op_run_command_output(cmd) { run_command_output(cmd) }
func op_exit(code) { exit(code) }
func op_pid() { pid() }
func op_env_get(key) { env_get(key) }
func op_cwd() { cwd() }

func op_http_get(url, headers) { http_get(url, headers) }
func op_http_post(url, body, headers) { http_post(url, body, headers) }
func op_http_put(url, body, headers) { http_put(url, body, headers) }
func op_http_delete(url, headers) { http_delete(url, headers) }

// ══════════════════════════════════════════════════════════════════
// Full HTTP Operations — request construction, response parsing
// ══════════════════════════════════════════════════════════════════

func op_http_request_full(method, url, body, headers) {
    // Construct proper HTTP request and parse response
    const raw = http_request(url, method, body, headers)
    if raw == null { return {"status": 0, "headers": {}, "body": null, "error": "no response"} }
    if typeof(raw) == "map" { return raw }
    // If raw is a string, parse as response
    op_parse_http_response(raw)
}

func op_parse_http_response(raw) {
    if typeof(raw) == "map" { return raw }
    // Default response structure
    {"status": 200, "headers": {}, "body": raw, "error": null}
}

func op_http_head(url, headers) {
    const resp = http_head(url)
    if typeof(resp) == "map" { resp } else { {"status": 200, "headers": {}} }
}

func op_http_options(url) {
    const resp = http_options(url)
    if typeof(resp) == "map" { resp } else { {"allow": "", "headers": {}} }
}

func op_http_patch(url, body, headers) {
    http_patch(url, body, headers)
}

// Build HTTP headers map from pairs
func op_build_headers(pairs) {
    let headers = {}
    for pair in pairs {
        if typeof(pair) == "array" && len(pair) >= 2 {
            headers[to_string(pair[0])] = to_string(pair[1])
        }
    }
    headers
}

// URL query string builder
func op_build_query_string(params) {
    let parts = []
    for k in params.keys() {
        if k == "__s" || k == "__init" { continue }
        parts.push(url_encode(k) + "=" + url_encode(to_string(params[k])))
    }
    parts.join("&")
}

// URL with query parameters
func op_url_with_params(base_url, params) {
    const qs = op_build_query_string(params)
    if len(qs) == 0 { return base_url }
    const sep = if base_url.contains("?") { "&" } else { "?" }
    base_url + sep + qs
}

// ══════════════════════════════════════════════════════════════════
// Full Filesystem Operations
// ══════════════════════════════════════════════════════════════════

func op_fs_read(path) { fs_read(path) }
func op_fs_write(path, content) { fs_write(path, content) }
func op_fs_append(path, content) { fs_append(path, content) }
func op_fs_exists(path) { fs_exists(path) }
func op_fs_remove(path) { fs_remove(path) }
func op_fs_list(path) { fs_list(path) }
func op_fs_mkdir(path) { fs_mkdir(path) }
func op_fs_copy(src, dst) { fs_copy(src, dst) }
func op_fs_move(src, dst) { fs_move(src, dst) }
func op_fs_size(path) { fs_size(path) }
func op_fs_is_file(path) { fs_is_file(path) }
func op_fs_is_dir(path) { fs_is_dir(path) }
func op_fs_chmod(path, mode) { fs_chmod(path, mode) }
func op_fs_symlink(target, link) { fs_symlink(target, link) }
func op_fs_readlink(path) { fs_readlink(path) }

// Read file as bytes
func op_fs_read_bytes(path) { fs_read_bytes(path) }

// Write bytes to file
func op_fs_write_bytes(path, data) { fs_write_bytes(path, data) }

// List directory recursively
func op_fs_walk(path) {
    let results = []
    const entries = fs_list(path)
    if entries == null { return results }
    for entry in entries {
        const full_path = path_join(path, entry)
        results.push(full_path)
        if fs_is_dir(full_path) {
            const sub = op_fs_walk(full_path)
            results = results.concat(sub)
        }
    }
    results
}

// Glob-style file matching
func op_fs_glob(pattern, base_dir) {
    const all_files = op_fs_walk(base_dir)
    let matched = []
    for f in all_files {
        if op_glob_matches(f, pattern) {
            matched.push(f)
        }
    }
    matched
}

// Simple glob matching
func op_glob_matches(path, pattern) {
    // Support * and ** wildcards
    if pattern == "*" { return true }
    if pattern == "**" { return true }
    // Check extension match like "*.magi"
    if starts_with(pattern, "*.") {
        const ext = pattern.slice(1, len(pattern))
        return ends_with(path, ext)
    }
    // Check directory prefix like "src/**"
    if ends_with(pattern, "/**") {
        const prefix = pattern.slice(0, len(pattern) - 3)
        return starts_with(path, prefix)
    }
    // Exact match
    path == pattern
}

// File stat: return {size, is_file, is_dir, modified}
func op_fs_stat(path) {
    {
        "path": path,
        "size": fs_size(path),
        "is_file": fs_is_file(path),
        "is_dir": fs_is_dir(path),
        "exists": fs_exists(path)
    }
}

// Read lines from file
func op_fs_read_lines(path) {
    const content = fs_read(path)
    if content == null { return [] }
    content.split("\n")
}

// Write lines to file
func op_fs_write_lines(path, lines) {
    fs_write(path, lines.join("\n"))
}

// Temporary file creation
func op_fs_temp_file(prefix) {
    const name = prefix + "_" + to_string(now_timestamp()) + "_" + to_string(random_int(0, 999999))
    const path = "/tmp/" + name
    fs_write(path, "")
    path
}

// Temporary directory creation
func op_fs_temp_dir(prefix) {
    const name = prefix + "_" + to_string(now_timestamp()) + "_" + to_string(random_int(0, 999999))
    const path = "/tmp/" + name
    fs_mkdir(path)
    path
}

// ══════════════════════════════════════════════════════════════════
// Full Process Operations
// ══════════════════════════════════════════════════════════════════

// Execute command and return {stdout, stderr, exit_code}
func op_exec_full(cmd, args) {
    const result = exec_cmd(cmd, args)
    if typeof(result) == "map" { return result }
    // Wrap raw output in structured response
    {"stdout": to_string(result), "stderr": "", "exit_code": 0}
}

// Execute command and return just stdout as string
func op_exec_output_str(cmd, args) {
    const result = exec_output(cmd, args)
    if result == null { return "" }
    to_string(result)
}

// Execute and return just the exit code
func op_exec_status_code(cmd, args) {
    const result = exec_status(cmd, args)
    if typeof(result) == "int64" { return result }
    if typeof(result) == "map" && result.has("exit_code") { return result["exit_code"] }
    0
}

// Execute with stdin
func op_exec_with_stdin(cmd, args, stdin_data) {
    exec_with_stdin(cmd, args, stdin_data)
}

// Execute with environment variables
func op_exec_with_env(cmd, args, env_vars) {
    exec_with_env(cmd, args, env_vars)
}

// Execute with working directory
func op_exec_with_cwd(cmd, args, cwd_path) {
    exec_with_cwd(cmd, args, cwd_path)
}

// Execute command in background (non-blocking)
func op_exec_background(cmd, args) {
    exec_background(cmd, args)
}

// Shell execution (wraps in sh -c)
func op_shell(command) {
    exec_cmd("sh", ["-c", command])
}

// ══════════════════════════════════════════════════════════════════
// Full Network Operations — TCP
// ══════════════════════════════════════════════════════════════════

// TCP connect and return handle
func op_tcp_connect_full(host, port) {
    const addr = host + ":" + to_string(port)
    tcp_connect(addr)
}

// TCP read with timeout
func op_tcp_read_timeout(handle, size, timeout_ms) {
    tcp_read_timeout(handle, size, timeout_ms)
}

// TCP write all bytes
func op_tcp_write_all(handle, data) {
    let written = 0
    let remaining = data
    while len(remaining) > 0 {
        const n = tcp_write(handle, remaining)
        if n <= 0 { break }
        written = written + n
        remaining = remaining.slice(n, len(remaining))
    }
    written
}

// TCP line-buffered read
func op_tcp_read_line(handle) {
    let line = ""
    while true {
        const byte_val = tcp_read(handle, 1)
        if byte_val == null || len(byte_val) == 0 { break }
        const ch = to_string(byte_val)
        if ch == "\n" { break }
        line = line + ch
    }
    line
}

// TCP server with connection handling
func op_tcp_serve(addr, handler) {
    const server = tcp_bind(addr)
    if server == null { return {"error": "failed to bind"} }
    while true {
        const client = tcp_accept(server)
        if client == null { continue }
        handler(client)
    }
}

// ══════════════════════════════════════════════════════════════════
