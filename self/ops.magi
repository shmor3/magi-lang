// ══════════════════════════════════════════════════════════════════
// Full WebSocket Operations
// ══════════════════════════════════════════════════════════════════

// Global WebSocket connection registry
let ws_connections = {}
let ws_next_id = 0

func op_ws_connect(args) {
    const url = op_arg(args, 0, "")
    if url == "" { panic("ws_connect: url required") }
    const id = f"ws:{ws_next_id}"
    ws_next_id = ws_next_id + 1
    // Delegate to host ws_connect if available
    const conn = ws_connect(url)
    if typeof(conn) == "string" { return conn }
    ws_connections[id] = {
        "url": url,
        "connected": true,
        "buffer": [],
    }
    id
}

func op_ws_send(args) {
    const conn_id = op_arg(args, 0, "")
    const message = op_arg(args, 1, "")
    if conn_id == "" { panic("ws_send: conn_id required") }
    // Delegate to host
    const result = ws_send(conn_id, message)
    if result != null { return result }
    // Track in local state
    if ws_connections.has(conn_id) {
        if !ws_connections[conn_id]["connected"] {
            panic("ws_send: connection closed")
        }
    }
    null
}

func op_ws_receive(args) {
    const conn_id = op_arg(args, 0, "")
    if conn_id == "" { panic("ws_receive: conn_id required") }
    // Delegate to host
    const result = ws_receive(conn_id)
    if result != null { return result }
    // Check local buffer
    if ws_connections.has(conn_id) {
        const conn = ws_connections[conn_id]
        if len(conn["buffer"]) > 0 {
            const msg = conn["buffer"][0]
            conn["buffer"] = conn["buffer"].slice(1, len(conn["buffer"]))
            ws_connections[conn_id] = conn
            return msg
        }
    }
    null
}

func op_ws_close(args) {
    const conn_id = op_arg(args, 0, "")
    if conn_id == "" { return null }
    // Delegate to host
    ws_close(conn_id)
    if ws_connections.has(conn_id) {
        let conn = ws_connections[conn_id]
        conn["connected"] = false
        ws_connections[conn_id] = conn
    }
    null
}

// ══════════════════════════════════════════════════════════════════
// Full SSE (Server-Sent Events) Operations
// ══════════════════════════════════════════════════════════════════

let sse_connections = {}
let sse_next_id = 0

func op_sse_connect(args) {
    const url = op_arg(args, 0, "")
    if url == "" { panic("sse_connect: url required") }
    const id = f"sse:{sse_next_id}"
    sse_next_id = sse_next_id + 1
    // Delegate to host
    const conn = sse_connect(url)
    if typeof(conn) == "string" { return conn }
    sse_connections[id] = {
        "url": url,
        "connected": true,
        "events": [],
    }
    id
}

func op_sse_read_event(args) {
    const conn_id = op_arg(args, 0, "")
    if conn_id == "" { panic("sse_read_event: conn_id required") }
    // Delegate to host
    const result = sse_read_event(conn_id)
    if result != null { return result }
    // Check local buffer
    if sse_connections.has(conn_id) {
        const conn = sse_connections[conn_id]
        if len(conn["events"]) > 0 {
            const evt = conn["events"][0]
            conn["events"] = conn["events"].slice(1, len(conn["events"]))
            sse_connections[conn_id] = conn
            return evt
        }
    }
    null
}

func op_sse_close(args) {
    const conn_id = op_arg(args, 0, "")
    if conn_id == "" { return null }
    sse_close(conn_id)
    if sse_connections.has(conn_id) {
        let conn = sse_connections[conn_id]
        conn["connected"] = false
        sse_connections[conn_id] = conn
    }
    null
}

// ══════════════════════════════════════════════════════════════════
// Full HTTP Server Operations
// ══════════════════════════════════════════════════════════════════

let http_servers = {}
let http_server_next_id = 0

func op_http_server_start(args) {
    const port = op_arg(args, 0, 8080)
    const id = f"srv:{http_server_next_id}"
    http_server_next_id = http_server_next_id + 1
    // Delegate to host
    const result = http_server_start(port)
    if typeof(result) == "string" { return result }
    http_servers[id] = {
        "port": port,
        "running": true,
        "request_queue": [],
    }
    id
}

func op_http_server_receive(args) {
    const server_id = op_arg(args, 0, "")
    if server_id == "" { panic("http_server_receive: server_id required") }
    // Delegate to host
    const result = http_server_receive(server_id)
    if result != null { return result }
    // Return from local queue
    if http_servers.has(server_id) {
        const srv = http_servers[server_id]
        if len(srv["request_queue"]) > 0 {
            const req = srv["request_queue"][0]
            srv["request_queue"] = srv["request_queue"].slice(1, len(srv["request_queue"]))
            http_servers[server_id] = srv
            return req
        }
    }
    null
}

func op_http_server_respond(args) {
    const server_id = op_arg(args, 0, "")
    const request_id = op_arg(args, 1, "")
    const status = op_arg(args, 2, 200)
    const body = op_arg(args, 3, "")
    const headers = op_arg(args, 4, {})
    // Delegate to host
    http_server_respond(server_id, request_id, status, body, headers)
    null
}

func op_http_server_stop(args) {
    const server_id = op_arg(args, 0, "")
    if server_id == "" { return null }
    http_server_stop(server_id)
    if http_servers.has(server_id) {
        let srv = http_servers[server_id]
        srv["running"] = false
        http_servers[server_id] = srv
    }
    null
}

