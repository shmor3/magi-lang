    const has_header = op_arg(args, 2, true)
    csv_parse(s, delimiter, has_header)
}

func op_csv_stringify(args) {
    const data = op_arg(args, 0, [])
    const delimiter = op_arg(args, 1, ",")
    csv_stringify(data, delimiter)
}

