let cl_cache = {"__init": true}

let cl_paths = ["."]
func classloader_init(paths) {
    cl_cache = {"__init": true}
    cl_paths = ["."]
    let i = 0
    while i < len(paths) {
        if len(paths[i]) > 0 {
            cl_paths.push(paths[i])
        }
        i = i + 1
    }
    null
}

func classloader_add_path(path) {
    cl_paths.push(path)
}
func classloader_resolve(name) {
    let filename = name
    if !filename.ends_with(".magc") {
        filename = name + ".magc"
    }

    let i = 0
    while i < len(cl_paths) {
        const dir = cl_paths[i]
        let candidate = ""
        if dir == "." || dir == "" {
            candidate = filename
        } else {
            candidate = dir + "/" + filename
        }
        if fs_exists(candidate) {
            return candidate
        }
        i = i + 1
    }
    null
}
func classloader_load(name) {
    if cl_cache.has(name) {
        return cl_cache[name]
    }

    const path = classloader_resolve(name)
    if path == null {
        const paths_str = cl_paths.join(", ")
        panic(f"class not found: {name} (searched: {paths_str})")
    }

    const cf_map = classloader_load_path(path)
    cl_cache[name] = cf_map
    cf_map
}

func classloader_load_path(path) {
    const raw = file.read_bytes(path)
    decode_classfile(raw)
}

func classloader_load_bytes(name, bytes) {
    const cf_map = decode_classfile(bytes)
    cl_cache[name] = cf_map
    cf_map
}
func classloader_is_loaded(name) {
    cl_cache.has(name)
}

func classloader_get(name) {
    if cl_cache.has(name) {
        return cl_cache[name]
    }
    null
}

func classloader_evict(name) {
    if cl_cache.has(name) {
        cl_cache = delete(cl_cache, name)
    }
}

func classloader_clear_cache() {
    cl_cache = {"__init": true}
}
func classloader_loaded_names() {
    let names = []
    for key in cl_cache.keys() {
        if key != "__init" {
            names.push(key)
        }
    }
    names
}

func classloader_search_paths() {
    cl_paths
}
