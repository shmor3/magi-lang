let gc_heap = {"__init": true}

let gc_roots = {"__init": true}

let gc_next_id     = 1
let gc_allocated   = 0
let gc_threshold   = 1048576
let gc_collections = 0
let gc_total_freed = 0
func gc_estimate_size(value) {
    const t = typeof(value)
    if t == "null"   { return 8 }
    if t == "bool"   { return 8 }
    if t == "int"    { return 8 }
    if t == "float"  { return 8 }
    if t == "string" { return 24 + len(value) }
    if t == "array"  { return 24 + len(value) * 16 }
    if t == "map"    { return 48 + len(value) * 32 }
    8
}
func gc_init() {
    gc_heap = {"__init": true}
    gc_roots = {"__init": true}
    gc_next_id = 1
    gc_allocated = 0
    gc_threshold = 1048576
    gc_collections = 0
    gc_total_freed = 0
}
func gc_alloc(value) {
    const id = gc_next_id
    gc_next_id = gc_next_id + 1
    const size = gc_estimate_size(value)
    gc_heap[id] = {"data": value, "marked": false, "size": size}
    gc_allocated = gc_allocated + size

    if gc_allocated > gc_threshold {
        gc_collect()
    }

    id
}

func gc_read(id) {
    const key = to_string(id)
    if !gc_heap.has(key) { return null }
    gc_heap[key]["data"]
}

func gc_write(id, value) {
    const key = to_string(id)
    if !gc_heap.has(key) { return null }
    const old = gc_heap[key]
    const old_size = old["size"]
    const new_size = gc_estimate_size(value)
    gc_heap[key] = {"data": value, "marked": old["marked"], "size": new_size}
    gc_allocated = gc_allocated - old_size + new_size
    null
}
func gc_add_root(id) {
    gc_roots[to_string(id)] = true
}

func gc_remove_root(id) {
    const key = to_string(id)
    if gc_roots.has(key) {
        gc_roots = delete(gc_roots, key)
    }
}
func gc_mark_object(id) {
    const key = to_string(id)
    if !gc_heap.has(key) { return null }
    let obj = gc_heap[key]
    if obj["marked"] { return null }

    obj["marked"] = true
    gc_heap[key] = obj

    const data = obj["data"]
    const t = typeof(data)

    if t == "array" {
        let i = 0
        while i < len(data) {
            const elem = data[i]
            if typeof(elem) == "int" && elem > 0 {
                gc_mark_object(elem)
            }
            i = i + 1
        }
    } else if t == "map" {
        for k in data.keys() {
            const v = data[k]
            if typeof(v) == "int" && v > 0 {
                gc_mark_object(v)
            }
        }
    }
}

func gc_mark_phase() {
    for key in gc_heap.keys() {
        if key == "__init" { continue }
        let obj = gc_heap[key]
        obj["marked"] = false
        gc_heap[key] = obj
    }

    for key in gc_roots.keys() {
        if key == "__init" { continue }
        gc_mark_object(to_int64(key))
    }
}
func gc_sweep_phase() {
    let freed_count = 0
    let freed_bytes = 0
    let dead_keys = []

    for key in gc_heap.keys() {
        if key == "__init" { continue }
        const obj = gc_heap[key]
        if !obj["marked"] {
            dead_keys.push(key)
            freed_bytes = freed_bytes + obj["size"]
            freed_count = freed_count + 1
        }
    }

    let i = 0
    while i < len(dead_keys) {
        gc_heap = delete(gc_heap, dead_keys[i])
        i = i + 1
    }

    gc_allocated = gc_allocated - freed_bytes
    if gc_allocated < 0 { gc_allocated = 0 }
    gc_total_freed = gc_total_freed + freed_count
    freed_count
}
func gc_collect() {
    gc_mark_phase()
    const freed = gc_sweep_phase()
    gc_collections = gc_collections + 1

    if gc_allocated > gc_threshold / 2 {
        gc_threshold = gc_threshold * 2
    }

    freed
}
func gc_stats() {
    let object_count = 0
    for key in gc_heap.keys() {
        if key != "__init" {
            object_count = object_count + 1
        }
    }

    {
        "objects":       object_count,
        "bytes":         gc_allocated,
        "collections":   gc_collections,
        "total_freed":   gc_total_freed,
        "threshold":     gc_threshold,
    }
}
func gc_is_alive(id) {
    const key = to_string(id)
    gc_heap.has(key)
}

func gc_live_count() {
    let n = 0
    for key in gc_heap.keys() {
        if key != "__init" { n = n + 1 }
    }
    n
}

func gc_force_collect() {
    gc_collect()
}
