// MAGI Self-Hosted Compiler — Telemetry and Performance Stats
//
// Collects performance metrics during compilation and execution:
//   - Phase timing (lex, parse, type-check, compile, etc.)
//   - Memory usage tracking
//   - Instruction counts
//   - Cache hit rates
//   - Source code metrics (LOC, function count, complexity)

// ══════════════════════════════════════════════════════════════════
// ── Phase Timer ─────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

let telemetry_timers = {"__s": true}
let telemetry_enabled = false

// Enable/disable telemetry collection
func telemetry_enable() { telemetry_enabled = true }
func telemetry_disable() { telemetry_enabled = false }
func telemetry_is_enabled() { telemetry_enabled }

// Start timing a phase
func telemetry_start(phase_name) {
    if !telemetry_enabled { return null }
    const now = time_now_ms()
    telemetry_timers[phase_name] = {"start": now, "end": 0, "elapsed": 0}
}

// End timing a phase
func telemetry_end(phase_name) {
    if !telemetry_enabled { return null }
    if !telemetry_timers.has(phase_name) { return null }
    const now = time_now_ms()
    let timer = telemetry_timers[phase_name]
    timer["end"] = now
    timer["elapsed"] = now - timer["start"]
    telemetry_timers[phase_name] = timer
}

// Get elapsed time for a phase in milliseconds
func telemetry_elapsed(phase_name) {
    if !telemetry_timers.has(phase_name) || phase_name == "__s" { return 0 }
    telemetry_timers[phase_name]["elapsed"]
}

// ══════════════════════════════════════════════════════════════════
// ── Counters ────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

let telemetry_counters = {"__s": true}

func telemetry_count(name) {
    if !telemetry_enabled { return null }
    if telemetry_counters.has(name) {
        telemetry_counters[name] = telemetry_counters[name] + 1
    } else {
        telemetry_counters[name] = 1
    }
}

func telemetry_count_add(name, amount) {
    if !telemetry_enabled { return null }
    if telemetry_counters.has(name) {
        telemetry_counters[name] = telemetry_counters[name] + amount
    } else {
        telemetry_counters[name] = amount
    }
}

func telemetry_get_count(name) {
    if telemetry_counters.has(name) && name != "__s" { telemetry_counters[name] } else { 0 }
}

// ══════════════════════════════════════════════════════════════════
// ── Gauges (current values) ─────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

let telemetry_gauges = {"__s": true}

func telemetry_gauge_set(name, value) {
    if !telemetry_enabled { return null }
    telemetry_gauges[name] = value
}

func telemetry_gauge_get(name) {
    if telemetry_gauges.has(name) && name != "__s" { telemetry_gauges[name] } else { 0 }
}

// ══════════════════════════════════════════════════════════════════
// ── Source Code Metrics ─────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

// Compute metrics from source code
func telemetry_source_metrics(source) {
    const lines = source.split("\n")
    let total_lines = len(lines)
    let blank_lines = 0
    let comment_lines = 0
    let code_lines = 0

    for ln in lines {
        const trimmed = ln.trim()
        if len(trimmed) == 0 { blank_lines = blank_lines + 1 }
        else if trimmed.starts_with("//") { comment_lines = comment_lines + 1 }
        else { code_lines = code_lines + 1 }
    }

    {
        "total_lines": total_lines,
        "code_lines": code_lines,
        "blank_lines": blank_lines,
        "comment_lines": comment_lines,
        "bytes": len(source),
    }
}

// Compute metrics from a parsed program
func telemetry_program_metrics(program) {
    if program == null { return {"functions": 0, "structs": 0, "enums": 0, "imports": 0, "tests": 0} }

    let func_count = 0
    let struct_count = 0
    let enum_count = 0
    let import_count = 0
    let test_count = 0
    let const_count = 0
    let let_count = 0

    for stmt in program.statements {
        const sk = stmt.kind
        match sk {
            StmtKind::SFuncDef(_) => { func_count = func_count + 1 },
            StmtKind::SAsyncFuncDef(_) => { func_count = func_count + 1 },
            StmtKind::SStructDef(_, _, _) => { struct_count = struct_count + 1 },
            StmtKind::SEnumDef(_, _, _) => { enum_count = enum_count + 1 },
            StmtKind::SImportModule(_, _, _) => { import_count = import_count + 1 },
            StmtKind::STestDef(_, _) => { test_count = test_count + 1 },
            StmtKind::SConst(_, _) => { const_count = const_count + 1 },
            StmtKind::SLet(_, _) => { let_count = let_count + 1 },
            StmtKind::SLetMut(_, _) => { let_count = let_count + 1 },
            _ => {}
        }
    }

    {
        "functions": func_count,
        "structs": struct_count,
        "enums": enum_count,
        "imports": import_count,
        "tests": test_count,
        "constants": const_count,
        "variables": let_count,
        "total_statements": len(program.statements),
    }
}

// ══════════════════════════════════════════════════════════════════
// ── Report Generation ───────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

// Generate a summary report
func telemetry_report() {
    let lines = []
    lines.push("=== MAGI Telemetry Report ===")
    lines.push("")

    // Phase timings
    lines.push("Phase Timings:")
    for name in telemetry_timers.keys() {
        if name == "__s" { continue }
        const elapsed = telemetry_elapsed(name)
        lines.push(f"  {name}: {elapsed}ms")
    }
    lines.push("")

    // Counters
    if telemetry_has_counters() {
        lines.push("Counters:")
        for name in telemetry_counters.keys() {
            if name == "__s" { continue }
            lines.push(f"  {name}: {telemetry_counters[name]}")
        }
        lines.push("")
    }

    // Gauges
    if telemetry_has_gauges() {
        lines.push("Gauges:")
        for name in telemetry_gauges.keys() {
            if name == "__s" { continue }
            lines.push(f"  {name}: {telemetry_gauges[name]}")
        }
        lines.push("")
    }

    // Total time
    let total_ms = 0
    for name in telemetry_timers.keys() {
        if name != "__s" { total_ms = total_ms + telemetry_elapsed(name) }
    }
    lines.push(f"Total: {total_ms}ms")

    lines.join("\n")
}

func telemetry_has_counters() {
    for k in telemetry_counters.keys() { if k != "__s" { return true } }
    false
}

func telemetry_has_gauges() {
    for k in telemetry_gauges.keys() { if k != "__s" { return true } }
    false
}

// Generate JSON report
func telemetry_report_json() {
    let timings = {"__s": true}
    for name in telemetry_timers.keys() {
        if name == "__s" { continue }
        timings[name] = telemetry_elapsed(name)
    }

    let counters = {"__s": true}
    for name in telemetry_counters.keys() {
        if name == "__s" { continue }
        counters[name] = telemetry_counters[name]
    }

    let gauges = {"__s": true}
    for name in telemetry_gauges.keys() {
        if name == "__s" { continue }
        gauges[name] = telemetry_gauges[name]
    }

    to_json({
        "timings": timings,
        "counters": counters,
        "gauges": gauges
    })
}

// ══════════════════════════════════════════════════════════════════
// ── Reset ───────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════

func telemetry_reset() {
    telemetry_timers = {"__s": true}
    telemetry_counters = {"__s": true}
    telemetry_gauges = {"__s": true}
}
