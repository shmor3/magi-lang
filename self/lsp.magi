        methods.push({"label": "unique", "kind": CIK_METHOD, "detail": "func unique() -> array", "documentation": "Removes duplicates"})
        methods.push({"label": "chunk", "kind": CIK_METHOD, "detail": "func chunk(size: int) -> array", "documentation": "Splits into chunks of size"})
