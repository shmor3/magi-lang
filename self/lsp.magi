        methods.push({"label": "values", "kind": CIK_METHOD, "detail": "func values() -> array", "documentation": "Returns all values"})
        methods.push({"label": "has", "kind": CIK_METHOD, "detail": "func has(key: string) -> bool", "documentation": "Checks if key exists"})
