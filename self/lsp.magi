// ══════════════════════════════════════════════════════════════════════
// ── Request Dispatch ─────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func lsp_dispatch(method, params) {
    match method {
        // Lifecycle
        "initialize" => handle_initialize(params),
        "initialized" => { handle_initialized(params); null },
        "shutdown" => handle_shutdown(params),
        "exit" => { handle_exit(params); null },

        // Document sync (notifications — return publish diagnostics)
        "textDocument/didOpen" => { handle_did_open(params); null },
        "textDocument/didChange" => { handle_did_change(params); null },
        "textDocument/didClose" => { handle_did_close(params); null },

        // Language features (requests — return result)
        "textDocument/completion" => handle_completion(params),
        "textDocument/hover" => handle_hover(params),
        "textDocument/definition" => handle_definition(params),
        "textDocument/typeDefinition" => handle_type_definition(params),
        "textDocument/references" => handle_references(params),
        "textDocument/rename" => handle_rename(params),
        "textDocument/prepareRename" => handle_prepare_rename(params),
        "textDocument/formatting" => handle_formatting(params),
        "textDocument/rangeFormatting" => handle_range_formatting(params),
        "textDocument/onTypeFormatting" => handle_on_type_formatting(params),
        "textDocument/codeAction" => handle_code_action(params),
        "textDocument/signatureHelp" => handle_signature_help(params),
        "textDocument/documentSymbol" => handle_document_symbol(params),
        "textDocument/semanticTokens/full" => handle_semantic_tokens_full(params),
        "textDocument/foldingRange" => handle_folding_range(params),
        "textDocument/selectionRange" => handle_selection_range(params),
        "textDocument/codeLens" => handle_code_lens(params),
        "textDocument/inlayHint" => handle_inlay_hint(params),
        "textDocument/documentLink" => handle_document_link(params),
        "textDocument/linkedEditingRange" => handle_linked_editing_range(params),
        "textDocument/documentHighlight" => handle_document_highlight(params),
        "textDocument/documentColor" => handle_document_color(params),
        "textDocument/prepareCallHierarchy" => handle_prepare_call_hierarchy(params),
        "textDocument/prepareTypeHierarchy" => handle_prepare_type_hierarchy(params),

        // Call hierarchy
        "callHierarchy/incomingCalls" => handle_incoming_calls(params),
        "callHierarchy/outgoingCalls" => handle_outgoing_calls(params),

        // Type hierarchy
        "typeHierarchy/supertypes" => handle_type_hierarchy_supertypes(params),
        "typeHierarchy/subtypes" => handle_type_hierarchy_subtypes(params),

        // Workspace
        "workspace/symbol" => handle_workspace_symbol(params),
        "workspace/executeCommand" => handle_execute_command(params),

        // Unknown method
        _ => null
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Stdio JSON-RPC Transport ─────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Read Content-Length header and JSON body from stdin.
// Returns parsed JSON request or null on EOF.
func read_message() {
    // Read header lines until blank line
    let content_length = 0
    while true {
        const line = input()
        if line == null { return null }
        const trimmed = line.trim()
        if trimmed == "" { break }
        if trimmed.starts_with("Content-Length:") {
            const num_str = trimmed[15..len(trimmed)].trim()
            content_length = to_int(num_str)
        }
    }

    if content_length == 0 { return null }

    // Read exactly content_length bytes
    // In a real implementation this would use binary read.
    // Here we read line by line and accumulate.
    let body = input()
    if body == null { return null }

    json_parse(body)
}

// Write JSON-RPC response to stdout
func write_message(response) {
    const body = json_encode(response)
    const header = f"Content-Length: {len(body)}\r\n\r\n"
    print(header + body)
}

// ── Main server loop ─────────────────────────────────────────────────

func run_lsp_server() {
    let running = true
    while running {
        const request = read_message()
        if request == null { break }

        const method = if request.has("method") { request["method"] } else { null }
        const id = if request.has("id") { request["id"] } else { null }
        const params = if request.has("params") { request["params"] } else { null }

        if method == null { continue }

        // Exit notification
        if method == "exit" {
            running = false
            continue
        }

        const result = lsp_dispatch(method, params)

        // Notifications don't get responses (no id)
        if id == null { continue }

        // Send response
        if result != null {
            write_message(jsonrpc_result(id, result))
        } else {
            // Null result
            write_message(jsonrpc_result(id, null))
        }
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Utility: Count handlers for verification ─────────────────────────
// ══════════════════════════════════════════════════════════════════════

const LSP_HANDLER_COUNT = 43
const LSP_HANDLERS = [
    "initialize", "initialized", "shutdown", "exit",
    "textDocument/didOpen", "textDocument/didChange", "textDocument/didClose",
    "textDocument/completion", "textDocument/hover",
    "textDocument/definition", "textDocument/typeDefinition",
    "textDocument/references", "textDocument/rename", "textDocument/prepareRename",
    "textDocument/formatting", "textDocument/rangeFormatting", "textDocument/onTypeFormatting",
    "textDocument/codeAction", "textDocument/signatureHelp",
    "textDocument/documentSymbol", "textDocument/semanticTokens/full",
    "textDocument/foldingRange", "textDocument/selectionRange",
    "textDocument/codeLens", "textDocument/inlayHint",
    "textDocument/documentLink", "textDocument/linkedEditingRange",
    "textDocument/documentHighlight", "textDocument/documentColor",
    "textDocument/prepareCallHierarchy", "textDocument/prepareTypeHierarchy",
    "callHierarchy/incomingCalls", "callHierarchy/outgoingCalls",
    "typeHierarchy/supertypes", "typeHierarchy/subtypes",
    "workspace/symbol", "workspace/executeCommand",
    // Additional: these share handlers or are sub-protocols
    "textDocument/didSave", "textDocument/willSave",
    "textDocument/colorPresentation",
    "codeLens/resolve", "completionItem/resolve", "inlayHint/resolve"
]

