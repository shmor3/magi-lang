const SEM_NAMESPACE = 0
const SEM_TYPE = 1
const SEM_CLASS = 2
const SEM_ENUM = 3
const SEM_INTERFACE = 4
const SEM_STRUCT = 5
const SEM_TYPE_PARAMETER = 6
const SEM_PARAMETER = 7
const SEM_VARIABLE = 8
const SEM_PROPERTY = 9
const SEM_ENUM_MEMBER = 10
const SEM_FUNCTION = 11
const SEM_METHOD = 12
const SEM_KEYWORD = 13
const SEM_MODIFIER = 14
const SEM_COMMENT = 15
const SEM_STRING = 16
const SEM_NUMBER = 17
const SEM_OPERATOR = 18

const SEMANTIC_TOKEN_TYPES = [
    "namespace", "type", "class", "enum", "interface", "struct",
    "typeParameter", "parameter", "variable", "property", "enumMember",
    "function", "method", "keyword", "modifier", "comment",
    "string", "number", "operator"
