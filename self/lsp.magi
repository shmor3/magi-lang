// Enhanced signature help handler
func handle_signature_help_full(params) {
    const uri = params["textDocument"]["uri"]
    const pos = params["position"]
    const line = pos["line"]
    const character = pos["character"]

    const doc = lsp_get_document(uri)
    if doc == null { return null }

    const source = doc["source"]
    const src_lines = source_lines(source)
    if line >= len(src_lines) { return null }
    const ln = src_lines[line]

    // Find the opening paren before cursor position
    let paren_pos = character - 1
    let depth = 0
    while paren_pos >= 0 {
        const c = ln[paren_pos]
        if c == ")" { depth = depth + 1 }
        if c == "(" {
            if depth == 0 { break }
            depth = depth - 1
        }
        paren_pos = paren_pos - 1
    }
    if paren_pos < 0 { return null }

    // Get function name before paren
    const func_word = word_at_position(source, line, paren_pos)
    if func_word == null { return null }
    const func_name = func_word["word"]

    // Count commas to determine active parameter
    let active_param = 0
    let ci = paren_pos + 1
    let comma_depth = 0
    while ci < character {
        if ln[ci] == "(" { comma_depth = comma_depth + 1 }
        if ln[ci] == ")" { comma_depth = comma_depth - 1 }
        if ln[ci] == "," && comma_depth == 0 {
            active_param = active_param + 1
        }
        ci = ci + 1
    }

    // Check user-defined functions first
    const program = doc["program"]
    if program != null {
        for stmt in program.statements {
            const sk = stmt.kind
            match sk {
                StmtKind::SFuncDef(fdef) => {
                    if fdef.name == func_name {
                        let param_strs = []
                        let param_labels = []
                        for p in fdef.params {
                            let pstr = p.name
                            if p.type_ann != "" { pstr = pstr + ": " + p.type_ann }
                            if p.rest { pstr = "..." + pstr }
                            param_strs.push(pstr)
                            param_labels.push({"label": pstr})
                        }
                        let ret = ""
                        if fdef.return_type != "" { ret = " -> " + fdef.return_type }
                        const label = f"func {func_name}({param_strs.join(', ')}){ret}"
                        return {
                            "signatures": [{
                                "label": label,
                                "parameters": param_labels,
                                "activeParameter": active_param
                            }],
                            "activeSignature": 0,
                            "activeParameter": active_param
                        }
                    }
                },
                _ => {}
            }
        }
    }

    // Check builtin signatures
    if BUILTIN_SIGS.has(func_name) {
        const sig = BUILTIN_SIGS[func_name]
        let param_labels = []
        for p in sig["params"] {
            param_labels.push({"label": p})
        }
        return {
            "signatures": [{
                "label": sig["label"],
                "parameters": param_labels,
                "activeParameter": active_param
            }],
            "activeSignature": 0,
            "activeParameter": active_param
        }
    }

    null
}

// ══════════════════════════════════════════════════════════════════════
// ── Collect test names helper ────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func collect_test_names(program) {
    let names = []
    if program == null { return names }
    for stmt in program.statements {
        const sk = stmt.kind
        match sk {
            StmtKind::STestDef(name, _) => {
                names.push(name)
            },
            StmtKind::SFuncDef(fdef) => {
                if fdef.name.starts_with("test_") {
                    names.push(fdef.name)
                }
            },
            _ => {}
        }
    }
    names
}

