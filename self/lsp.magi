// Snippet completions for common code patterns
func get_snippet_completions(prefix) {
    let snippets = []

    // if snippet
    if prefix == "" || "if".starts_with(prefix) {
        snippets.push({
            "label": "if",
            "kind": CIK_SNIPPET,
            "detail": "if statement",
            "insertText": "if ${1:condition} {\n    ${2}\n}",
            "insertTextFormat": 2
        })
    }

    // if-else snippet
    if prefix == "" || "if".starts_with(prefix) {
        snippets.push({
            "label": "ifelse",
            "kind": CIK_SNIPPET,
            "detail": "if-else statement",
            "insertText": "if ${1:condition} {\n    ${2}\n} else {\n    ${3}\n}",
            "insertTextFormat": 2
        })
    }

    // for loop snippet
    if prefix == "" || "for".starts_with(prefix) {
        snippets.push({
            "label": "for",
            "kind": CIK_SNIPPET,
            "detail": "for-in loop",
            "insertText": "for ${1:item} in ${2:collection} {\n    ${3}\n}",
            "insertTextFormat": 2
        })
    }

    // while loop snippet
    if prefix == "" || "while".starts_with(prefix) {
        snippets.push({
            "label": "while",
            "kind": CIK_SNIPPET,
            "detail": "while loop",
            "insertText": "while ${1:condition} {\n    ${2}\n}",
            "insertTextFormat": 2
        })
    }

    // func snippet
    if prefix == "" || "func".starts_with(prefix) {
        snippets.push({
            "label": "func",
            "kind": CIK_SNIPPET,
            "detail": "function definition",
            "insertText": "func ${1:name}(${2:params}) {\n    ${3}\n}",
            "insertTextFormat": 2
        })
    }

    // match snippet
    if prefix == "" || "match".starts_with(prefix) {
        snippets.push({
            "label": "match",
            "kind": CIK_SNIPPET,
            "detail": "match expression",
            "insertText": "match ${1:value} {\n    ${2:pattern} => ${3:expr},\n    _ => ${4:default}\n}",
            "insertTextFormat": 2
        })
    }

    // struct snippet
    if prefix == "" || "struct".starts_with(prefix) {
        snippets.push({
            "label": "struct",
            "kind": CIK_SNIPPET,
            "detail": "struct definition",
            "insertText": "struct ${1:Name} {\n    ${2:field}: ${3:type}\n}",
            "insertTextFormat": 2
        })
    }

    // enum snippet
    if prefix == "" || "enum".starts_with(prefix) {
        snippets.push({
            "label": "enum",
            "kind": CIK_SNIPPET,
            "detail": "enum definition",
            "insertText": "enum ${1:Name} {\n    ${2:Variant}\n}",
            "insertTextFormat": 2
        })
    }

    // interface/trait snippet
    if prefix == "" || "interface".starts_with(prefix) || "trait".starts_with(prefix) {
        snippets.push({
            "label": "interface",
            "kind": CIK_SNIPPET,
            "detail": "interface definition",
            "insertText": "interface ${1:Name} {\n    func ${2:method}(${3:self})\n}",
            "insertTextFormat": 2
        })
    }

    // test snippet
    if prefix == "" || "test".starts_with(prefix) {
        snippets.push({
            "label": "test",
            "kind": CIK_SNIPPET,
            "detail": "test definition",
            "insertText": "test \"${1:description}\" {\n    ${2:assert(true)}\n}",
            "insertTextFormat": 2
        })
    }

    // try-catch snippet
    if prefix == "" || "try".starts_with(prefix) {
        snippets.push({
            "label": "trycatch",
            "kind": CIK_SNIPPET,
            "detail": "try-catch block",
            "insertText": "try {\n    ${1}\n} catch err {\n    ${2}\n}",
            "insertTextFormat": 2
        })
    }

    // import snippet
    if prefix == "" || "import".starts_with(prefix) {
        snippets.push({
            "label": "import",
            "kind": CIK_SNIPPET,
            "detail": "import statement",
            "insertText": "import std.${1:module}",
            "insertTextFormat": 2
        })
    }

    // const snippet
    if prefix == "" || "const".starts_with(prefix) {
        snippets.push({
            "label": "const",
            "kind": CIK_SNIPPET,
            "detail": "constant declaration",
            "insertText": "const ${1:name} = ${2:value}",
            "insertTextFormat": 2
        })
    }

    // let snippet
    if prefix == "" || "let".starts_with(prefix) {
        snippets.push({
            "label": "let",
            "kind": CIK_SNIPPET,
            "detail": "mutable variable declaration",
            "insertText": "let ${1:name} = ${2:value}",
            "insertTextFormat": 2
        })
    }

    // async func snippet
    if prefix == "" || "async".starts_with(prefix) {
        snippets.push({
            "label": "async func",
            "kind": CIK_SNIPPET,
            "detail": "async function definition",
            "insertText": "async func ${1:name}(${2:params}) {\n    ${3}\n}",
            "insertTextFormat": 2
        })
    }

    // impl snippet
    if prefix == "" || "impl".starts_with(prefix) {
        snippets.push({
            "label": "impl",
            "kind": CIK_SNIPPET,
            "detail": "implementation block",
            "insertText": "impl ${1:Type} {\n    func ${2:method}(self) {\n        ${3}\n    }\n}",
            "insertTextFormat": 2
        })
    }

    snippets
}

// Method completions based on receiver type
func get_method_completions_for_type(type_str) {
    let methods = []

    if type_str == "string" || type_str == "String" {
        methods.push({"label": "len", "kind": CIK_METHOD, "detail": "func len() -> int", "documentation": "Returns the length of the string"})
        methods.push({"label": "trim", "kind": CIK_METHOD, "detail": "func trim() -> string", "documentation": "Removes leading and trailing whitespace"})
        methods.push({"label": "trim_start", "kind": CIK_METHOD, "detail": "func trim_start() -> string", "documentation": "Removes leading whitespace"})
        methods.push({"label": "trim_end", "kind": CIK_METHOD, "detail": "func trim_end() -> string", "documentation": "Removes trailing whitespace"})
        methods.push({"label": "to_upper", "kind": CIK_METHOD, "detail": "func to_upper() -> string", "documentation": "Converts to uppercase"})
        methods.push({"label": "to_lower", "kind": CIK_METHOD, "detail": "func to_lower() -> string", "documentation": "Converts to lowercase"})
        methods.push({"label": "split", "kind": CIK_METHOD, "detail": "func split(sep: string) -> array", "documentation": "Splits string by separator"})
        methods.push({"label": "contains", "kind": CIK_METHOD, "detail": "func contains(sub: string) -> bool", "documentation": "Checks if string contains substring"})
        methods.push({"label": "starts_with", "kind": CIK_METHOD, "detail": "func starts_with(prefix: string) -> bool", "documentation": "Checks if string starts with prefix"})
        methods.push({"label": "ends_with", "kind": CIK_METHOD, "detail": "func ends_with(suffix: string) -> bool", "documentation": "Checks if string ends with suffix"})
        methods.push({"label": "replace", "kind": CIK_METHOD, "detail": "func replace(from: string, to: string) -> string", "documentation": "Replaces all occurrences"})
        methods.push({"label": "substring", "kind": CIK_METHOD, "detail": "func substring(start: int, end?: int) -> string", "documentation": "Extracts substring by indices"})
        methods.push({"label": "char_at", "kind": CIK_METHOD, "detail": "func char_at(index: int) -> string", "documentation": "Returns character at index"})
        methods.push({"label": "index_of", "kind": CIK_METHOD, "detail": "func index_of(sub: string) -> int", "documentation": "Finds index of first occurrence"})
        methods.push({"label": "last_index_of", "kind": CIK_METHOD, "detail": "func last_index_of(sub: string) -> int", "documentation": "Finds index of last occurrence"})
        methods.push({"label": "pad_start", "kind": CIK_METHOD, "detail": "func pad_start(len: int, fill?: string) -> string", "documentation": "Pads the start to target length"})
        methods.push({"label": "pad_end", "kind": CIK_METHOD, "detail": "func pad_end(len: int, fill?: string) -> string", "documentation": "Pads the end to target length"})
        methods.push({"label": "repeat", "kind": CIK_METHOD, "detail": "func repeat(count: int) -> string", "documentation": "Repeats string count times"})
        methods.push({"label": "reverse", "kind": CIK_METHOD, "detail": "func reverse() -> string", "documentation": "Reverses the string"})
        methods.push({"label": "lines", "kind": CIK_METHOD, "detail": "func lines() -> array", "documentation": "Splits string into lines"})
        methods.push({"label": "words", "kind": CIK_METHOD, "detail": "func words() -> array", "documentation": "Splits string into words"})
