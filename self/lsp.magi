// MAGI Self-Hosted Compiler — LSP Server (Language Server Protocol)
//
// Full LSP server with 43 handlers over JSON-RPC 2.0 stdio transport.
// Uses the self-hosted parser, type checker, linter, and formatter.
//
// Handler list mirrors src/lsp/mod.rs:
//   initialize, initialized, shutdown, exit
//   textDocument/didOpen, didChange, didClose
//   textDocument/completion, hover, definition, typeDefinition
//   textDocument/references, rename, prepareRename
//   textDocument/formatting, rangeFormatting, onTypeFormatting
//   textDocument/codeAction, signatureHelp, documentSymbol
//   textDocument/semanticTokens/full, foldingRange, selectionRange
//   textDocument/codeLens, inlayHint, documentLink
//   textDocument/linkedEditingRange, documentHighlight, documentColor
//   textDocument/prepareCallHierarchy, prepareTypeHierarchy
//   workspace/symbol, workspace/executeCommand
//   callHierarchy/incomingCalls, callHierarchy/outgoingCalls
//   typeHierarchy/supertypes, typeHierarchy/subtypes

// ══════════════════════════════════════════════════════════════════════
// ── LSP Types ────────────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func lsp_position(line, character) {
    {"line": line, "character": character}
}

func lsp_range(start_line, start_char, end_line, end_char) {
    {"start": lsp_position(start_line, start_char), "end": lsp_position(end_line, end_char)}
}

func lsp_location(uri, range) {
    {"uri": uri, "range": range}
}

func lsp_text_edit(range, new_text) {
    {"range": range, "newText": new_text}
}

func lsp_diagnostic(range, severity, message, source, code) {
    const diag = {"range": range, "message": message}
    if severity != null { diag["severity"] = severity }
    if source != null { diag["source"] = source }
    if code != null { diag["code"] = code }
    diag
}

func lsp_markup_content(kind, value) {
    {"kind": kind, "value": value}
}

// ── Symbol kinds (LSP spec) ──────────────────────────────────────────

const SK_FILE = 1
const SK_MODULE = 2
const SK_NAMESPACE = 3
const SK_PACKAGE = 4
const SK_CLASS = 5
const SK_METHOD = 6
const SK_PROPERTY = 7
const SK_FIELD = 8
const SK_CONSTRUCTOR = 9
const SK_ENUM = 10
const SK_INTERFACE = 11
const SK_FUNCTION = 12
const SK_VARIABLE = 13
const SK_CONSTANT = 14
const SK_STRING = 15
const SK_NUMBER = 16
const SK_BOOLEAN = 17
const SK_ARRAY = 18
const SK_STRUCT = 23
const SK_EVENT = 24
const SK_OPERATOR = 25
const SK_TYPE_PARAMETER = 26

// ── Completion item kinds ────────────────────────────────────────────

const CIK_TEXT = 1
const CIK_METHOD = 2
const CIK_FUNCTION = 3
const CIK_CONSTRUCTOR = 4
const CIK_FIELD = 5
const CIK_VARIABLE = 6
const CIK_CLASS = 7
const CIK_INTERFACE = 8
const CIK_MODULE = 9
const CIK_PROPERTY = 10
const CIK_KEYWORD = 14
const CIK_SNIPPET = 15
const CIK_ENUM_MEMBER = 20
const CIK_CONSTANT = 21
const CIK_STRUCT = 22

// ── Diagnostic severities ────────────────────────────────────────────

const DIAG_ERROR = 1
const DIAG_WARNING = 2
const DIAG_INFO = 3
const DIAG_HINT = 4

