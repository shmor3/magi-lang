// ══════════════════════════════════════════════════════════════════════
// ── Section 10: Enhanced Inlay Hints ─────────────────────────────────
// ══════════════════════════════════════════════════════════════════════
//
// Better inlay hints using the deep type inference engine

func handle_inlay_hint_full(params) {
    const uri = params["textDocument"]["uri"]
    const range = params["range"]
    const doc = lsp_get_document(uri)
    if doc == null { return null }

    // Check if inlay hints are enabled
    if lsp_config.has("inlayHints.enabled") && !lsp_config["inlayHints.enabled"] {
        return null
    }

    let hints = []
    const program = doc["program"]
    const source = doc["source"]
    if program == null { return null }

    const start_line = range["start"]["line"]
    const end_line = range["end"]["line"]
    const src_lines = source_lines(source)

    for stmt in program.statements {
        const sl = stmt.span.start_line - 1
        if sl < start_line || sl > end_line { continue }
        const sk = stmt.kind

        match sk {
            // Type hints for let/const bindings without explicit type annotations
            StmtKind::SLet(var_name, value) => {
                if value != null && lsp_config.has("inlayHints.typeHints") && lsp_config["inlayHints.typeHints"] {
                    const inferred = infer_expr_type_deep(value, program)
                    if inferred != null && inferred != "unknown" {
                        // Find the position after the variable name
                        const line_text = if sl < len(src_lines) { src_lines[sl] } else { "" }
                        const name_idx = line_text.index_of(var_name)
                        if name_idx >= 0 {
                            const hint_pos = name_idx + len(var_name)
                            // Only add if there's no explicit type annotation
                            const after_name = line_text[hint_pos..len(line_text)].trim()
                            if !after_name.starts_with(":") {
                                hints.push({
                                    "position": lsp_position(sl, hint_pos),
                                    "label": f": {inferred}",
                                    "kind": 1,
                                    "paddingLeft": false,
                                    "paddingRight": true,
                                    "tooltip": {
                                        "kind": "markdown",
                                        "value": f"Inferred type: `{inferred}`"
                                    }
                                })
                            }
                        }
                    }
                }
            },
            StmtKind::SLetMut(var_name, value) => {
                if value != null && lsp_config.has("inlayHints.typeHints") && lsp_config["inlayHints.typeHints"] {
                    const inferred = infer_expr_type_deep(value, program)
                    if inferred != null && inferred != "unknown" {
                        const line_text = if sl < len(src_lines) { src_lines[sl] } else { "" }
                        const name_idx = line_text.index_of(var_name)
                        if name_idx >= 0 {
                            const hint_pos = name_idx + len(var_name)
                            const after_name = line_text[hint_pos..len(line_text)].trim()
                            if !after_name.starts_with(":") {
                                hints.push({
                                    "position": lsp_position(sl, hint_pos),
                                    "label": f": {inferred}",
                                    "kind": 1,
                                    "paddingLeft": false,
                                    "paddingRight": true,
                                    "tooltip": {
                                        "kind": "markdown",
                                        "value": f"Inferred type: `{inferred}` (mutable)"
                                    }
                                })
                            }
                        }
                    }
                }
            },
            StmtKind::SConst(var_name, value) => {
                if value != null && lsp_config.has("inlayHints.typeHints") && lsp_config["inlayHints.typeHints"] {
                    const inferred = infer_expr_type_deep(value, program)
                    if inferred != null && inferred != "unknown" {
                        const line_text = if sl < len(src_lines) { src_lines[sl] } else { "" }
                        const name_idx = line_text.index_of(var_name)
                        if name_idx >= 0 {
                            const hint_pos = name_idx + len(var_name)
                            const after_name = line_text[hint_pos..len(line_text)].trim()
                            if !after_name.starts_with(":") {
                                hints.push({
                                    "position": lsp_position(sl, hint_pos),
                                    "label": f": {inferred}",
                                    "kind": 1,
                                    "paddingLeft": false,
                                    "paddingRight": true,
                                    "tooltip": {
                                        "kind": "markdown",
                                        "value": f"Inferred type: `{inferred}` (constant)"
                                    }
                                })
                            }
                        }
                    }
                }
            },

            // Return type hints for functions without explicit return type
            StmtKind::SFuncDef(fdef) => {
                if fdef.return_type == "" && lsp_config.has("inlayHints.returnTypeHints") && lsp_config["inlayHints.returnTypeHints"] {
                    // Try to infer return type from body
                    const ret_type = infer_function_return_type(fdef, program)
                    if ret_type != null {
                        const line_text = if sl < len(src_lines) { src_lines[sl] } else { "" }
                        const brace_idx = line_text.index_of("{")
                        if brace_idx >= 0 {
                            hints.push({
                                "position": lsp_position(sl, brace_idx),
                                "label": f"-> {ret_type} ",
                                "kind": 1,
                                "paddingLeft": true,
                                "paddingRight": false,
                                "tooltip": {
                                    "kind": "markdown",
                                    "value": f"Inferred return type: `{ret_type}`"
                                }
                            })
                        }
                    }
                }

                // Parameter name hints at call sites
                if lsp_config.has("inlayHints.parameterHints") && lsp_config["inlayHints.parameterHints"] {
                    // Find calls to this function in the visible range
                    for other_stmt in program.statements {
                        const osl = other_stmt.span.start_line - 1
                        if osl < start_line || osl > end_line { continue }
                        add_parameter_hints(hints, other_stmt, fdef, osl)
                    }
                }
            },
            _ => {}
        }
    }

    if len(hints) == 0 { return null }
    hints
}

// Infer function return type from its body
func infer_function_return_type(fdef, program) {
    if fdef.body == null { return null }
    const stmts = fdef.body.statements
    if len(stmts) == 0 { return null }

    // Check last statement for implicit return
    const last = stmts[len(stmts) - 1]
    const sk = last.kind
    match sk {
        StmtKind::SReturn(value) => {
            if value != null { return infer_expr_type_deep(value, program) }
            "null"
        },
        StmtKind::SExprStmt(expr) => {
            infer_expr_type_deep(expr, program)
        },
        _ => null
    }
}

// Add parameter name hints for function calls
func add_parameter_hints(hints, stmt, fdef, line) {
    const sk = stmt.kind
    match sk {
        StmtKind::SExprStmt(expr) => {
            add_param_hints_expr(hints, expr, fdef, line)
        },
        StmtKind::SLet(_, expr) => {
            if expr != null { add_param_hints_expr(hints, expr, fdef, line) }
        },
        StmtKind::SConst(_, expr) => {
            if expr != null { add_param_hints_expr(hints, expr, fdef, line) }
        },
        StmtKind::SReturn(expr) => {
            if expr != null { add_param_hints_expr(hints, expr, fdef, line) }
        },
        _ => {}
    }
}

func add_param_hints_expr(hints, expr, fdef, line) {
    if expr == null { return }
    const ek = expr.kind
    match ek {
        ExprKind::ECall(name, args, _) => {
            if name == fdef.name && args != null {
                let pi = 0
                while pi < len(args) && pi < len(fdef.params) {
                    const param = fdef.params[pi]
                    const arg = args[pi]
                    // Only add hint if the argument is not just a variable with the same name
                    let arg_name = null
                    const arg_kind = arg.kind
                    match arg_kind {
                        ExprKind::EVariable(vn) => { arg_name = vn },
                        _ => {}
                    }
                    if arg_name != param.name {
                        hints.push({
                            "position": lsp_position(arg.span.start_line - 1, arg.span.start_col - 1),
                            "label": param.name + ": ",
                            "kind": 2,
                            "paddingLeft": false,
                            "paddingRight": false
                        })
                    }
                    pi = pi + 1
                }
            }
        },
        _ => {}
    }
}


// ══════════════════════════════════════════════════════════════════════
// ── Section 11: Enhanced Document Highlights ─────────────────────────
// ══════════════════════════════════════════════════════════════════════
//
// More precise document highlights using word-boundary matching
// instead of just AST references.

func handle_document_highlight_full(params) {
    const uri = params["textDocument"]["uri"]
    const pos = params["position"]
    const line = pos["line"]
    const character = pos["character"]

    const doc = lsp_get_document(uri)
    if doc == null { return null }

    const word_info = word_at_position(doc["source"], line, character)
    if word_info == null { return null }

    const word = word_info["word"]
    const source = doc["source"]
    const program = doc["program"]

    // Use AST references for precise highlighting
    const refs = find_references(program, word)

    // Also find text-based occurrences for things the AST might miss
    let text_refs = find_text_occurrences(source, word)

    // Merge: prefer AST refs (which have write/read info)
    let highlights = []
    let ast_positions = {"__s": true}

    for r in refs {
        const key = to_string(r["line"]) + ":" + to_string(r["col"])
        ast_positions[key] = true
        const highlight_kind = if r["kind"] == "definition" { 3 } else { 2 }
        highlights.push({
            "range": lsp_range(r["line"], r["col"], r["line"], r["col"] + len(word)),
            "kind": highlight_kind
        })
    }

    // Add text-based refs not covered by AST
    for tr in text_refs {
        const key = to_string(tr["line"]) + ":" + to_string(tr["col"])
        if !ast_positions.has(key) || key == "__s" {
            highlights.push({
                "range": lsp_range(tr["line"], tr["col"], tr["line"], tr["col"] + len(word)),
                "kind": 1  // Text highlight
            })
        }
    }

    if len(highlights) == 0 { return null }
    highlights
}

// Find all text occurrences of a word (word-boundary aware)
func find_text_occurrences(source, word) {
    let occurrences = []
    const lines = source.split("\n")
    let i = 0
    while i < len(lines) {
        const ln = lines[i]
        let search_start = 0
        while search_start < len(ln) {
            const idx = ln[search_start..len(ln)].index_of(word)
            if idx == -1 { break }
            const abs_idx = search_start + idx
            const after_idx = abs_idx + len(word)
            const before_ok = abs_idx == 0 || !is_ident_char(ln[abs_idx - 1])
            const after_ok = after_idx >= len(ln) || !is_ident_char(ln[after_idx])
            if before_ok && after_ok {
                occurrences.push({"line": i, "col": abs_idx})
            }
            search_start = abs_idx + len(word)
            if search_start >= len(ln) { break }
        }
        i = i + 1
    }
    occurrences
}


// ══════════════════════════════════════════════════════════════════════
// ── Section 12: Enhanced Call Hierarchy ───────────────────────────────
// ══════════════════════════════════════════════════════════════════════
//
// Cross-file call hierarchy support

func handle_prepare_call_hierarchy_full(params) {
    const uri = params["textDocument"]["uri"]
    const pos = params["position"]
    const line = pos["line"]
    const character = pos["character"]

    const doc = lsp_get_document(uri)
    if doc == null { return null }

    const word_info = word_at_position(doc["source"], line, character)
    if word_info == null { return null }

    // Check current file
    const def = find_definition(doc["program"], word_info["word"])
    if def != null && def["kind"] == "function" {
        return [{
            "name": def["name"],
            "kind": SK_FUNCTION,
            "uri": uri,
            "range": lsp_range(def["line"], def["col"], def["line"] + 1, 0),
            "selectionRange": lsp_range(def["line"], def["col"], def["line"], def["col"] + len(def["name"]))
        }]
    }

    // Check cross-file
    const cross = find_definition_across_files(word_info["word"])
    if cross != null {
        const cd = cross["def"]
        if cd["kind"] == "function" {
            return [{
                "name": cd["name"],
                "kind": SK_FUNCTION,
                "uri": cross["uri"],
                "range": lsp_range(cd["line"], cd["col"], cd["line"] + 1, 0),
                "selectionRange": lsp_range(cd["line"], cd["col"], cd["line"], cd["col"] + len(cd["name"]))
            }]
        }
    }

    null
}

// Cross-file incoming calls
func handle_incoming_calls_full(params) {
    const item = params["item"]
    const target_name = item["name"]

    let callers = []
    for uri in lsp_documents.keys() {
        if uri == "__s" { continue }
        const doc = lsp_documents[uri]
        if doc == null { continue }

        const symbols = collect_symbols(doc["program"])
        for sym in symbols {
            if sym["kind"] == SK_FUNCTION && sym["name"] != target_name {
                const refs = find_refs_in_function(doc["program"], sym["name"], target_name)
                if len(refs) > 0 {
                    let from_ranges = []
                    for r in refs {
                        from_ranges.push(lsp_range(r["line"], r["col"], r["line"], r["col"] + len(target_name)))
                    }
                    callers.push({
                        "from": {
                            "name": sym["name"],
                            "kind": SK_FUNCTION,
                            "uri": uri,
                            "range": lsp_range(sym["line"], sym["col"], sym["end_line"], 0),
                            "selectionRange": lsp_range(sym["line"], sym["col"], sym["line"], sym["col"] + len(sym["name"]))
                        },
                        "fromRanges": from_ranges
                    })
                }
            }
        }
    }

    if len(callers) == 0 { return null }
    callers
}

// Cross-file outgoing calls
func handle_outgoing_calls_full(params) {
    const item = params["item"]
    const func_name = item["name"]
    const target_uri = item["uri"]

    const doc = lsp_get_document(target_uri)
    if doc == null { return null }

    let callees = {"__s": true}
    let all_functions = {"__s": true}

    // Collect all known functions across workspace
    for uri in lsp_documents.keys() {
        if uri == "__s" { continue }
        const ws_doc = lsp_documents[uri]
        if ws_doc == null { continue }
        const symbols = collect_symbols(ws_doc["program"])
        for sym in symbols {
            if sym["kind"] == SK_FUNCTION {
                all_functions[sym["name"]] = {"uri": uri, "sym": sym}
            }
        }
    }

    // Find calls from func_name
    if doc["program"] != null {
        for stmt in doc["program"].statements {
            const sk = stmt.kind
            match sk {
                StmtKind::SFuncDef(fdef) => {
                    if fdef.name == func_name && fdef.body != null {
                        for s in fdef.body.statements {
                            collect_calls_in_stmt(callees, s, all_functions)
                        }
                    }
                },
                _ => {}
            }
        }
    }

    let result = []
    for callee_name in callees.keys() {
        if callee_name == "__s" { continue }
        if all_functions.has(callee_name) && callee_name != "__s" {
            const info = all_functions[callee_name]
            const sym = info["sym"]
            const callee_uri = info["uri"]
            const ranges = callees[callee_name]
            result.push({
                "to": {
                    "name": callee_name,
                    "kind": SK_FUNCTION,
                    "uri": callee_uri,
                    "range": lsp_range(sym["line"], sym["col"], sym["end_line"], 0),
                    "selectionRange": lsp_range(sym["line"], sym["col"], sym["line"], sym["col"] + len(callee_name))
                },
                "fromRanges": ranges
            })
        }
    }

    if len(result) == 0 { return null }
    result
}


// ══════════════════════════════════════════════════════════════════════
// ── Section 13: Enhanced Signature Help with Overload Resolution ─────
// ══════════════════════════════════════════════════════════════════════
//
// Display full parameter information, support overloaded functions,
// active parameter highlighting

// Find call context at position: returns [func_name, active_param]
func find_call_context(source, line, character) {
    const lines = source.split("\n")
    if line >= len(lines) { return null }
    const ln = lines[line]

    // Walk backward to find function call context
    let paren_pos = character - 1
    let depth = 0

    while paren_pos >= 0 {
        const c = ln[paren_pos]
        if c == ")" || c == "]" { depth = depth + 1 }
        if c == "(" || c == "[" {
            if depth == 0 {
                if c == "(" {
                    // Found opening paren — get function name
                    const func_word = word_at_position(source, line, paren_pos)
                    if func_word != null {
                        // Count commas for active parameter
                        let active = 0
                        let ci = paren_pos + 1
                        let d = 0
                        while ci < character {
                            if ln[ci] == "(" || ln[ci] == "[" { d = d + 1 }
                            if ln[ci] == ")" || ln[ci] == "]" { d = d - 1 }
                            if ln[ci] == "," && d == 0 { active = active + 1 }
                            ci = ci + 1
                        }
                        return {"name": func_word["word"], "active_param": active}
                    }
                }
                return null
            }
            depth = depth - 1
        }
        paren_pos = paren_pos - 1
    }
    null
}

// Enhanced signature help with method signatures
func handle_signature_help_v2(params) {
    const uri = params["textDocument"]["uri"]
    const pos = params["position"]
    const line = pos["line"]
    const character = pos["character"]

    const doc = lsp_get_document(uri)
    if doc == null { return null }

    const ctx = find_call_context(doc["source"], line, character)
    if ctx == null { return null }

    const func_name = ctx["name"]
    const active_param = ctx["active_param"]
    const program = doc["program"]

    // 1. User-defined function signatures
    if program != null {
        for stmt in program.statements {
            const sk = stmt.kind
            match sk {
                StmtKind::SFuncDef(fdef) => {
                    if fdef.name == func_name {
                        let param_strs = []
                        let param_labels = []
                        for p in fdef.params {
                            let pstr = p.name
                            if p.type_ann != "" { pstr = pstr + ": " + p.type_ann }
                            if p.rest { pstr = "..." + pstr }
                            if p.default_value != null { pstr = pstr + " = ..." }
                            param_strs.push(pstr)
                            param_labels.push({"label": pstr})
                        }
                        let ret = ""
                        if fdef.return_type != "" { ret = " -> " + fdef.return_type }
                        const label = f"func {func_name}({param_strs.join(', ')}){ret}"

                        // Extract doc comment for documentation
                        const doc_comment = extract_doc_comments(doc["source"], stmt.span.start_line)
                        let sig_doc = null
                        if doc_comment != "" {
                            sig_doc = {"kind": "markdown", "value": doc_comment}
                        }

                        return {
                            "signatures": [{
                                "label": label,
                                "documentation": sig_doc,
                                "parameters": param_labels,
                                "activeParameter": active_param
                            }],
                            "activeSignature": 0,
                            "activeParameter": active_param
                        }
                    }
                },
                StmtKind::SAsyncFuncDef(fdef) => {
                    if fdef.name == func_name {
                        let param_strs = []
                        let param_labels = []
                        for p in fdef.params {
                            param_strs.push(p.name)
                            param_labels.push({"label": p.name})
                        }
                        const label = f"async func {func_name}({param_strs.join(', ')})"
                        return {
                            "signatures": [{
                                "label": label,
                                "parameters": param_labels,
                                "activeParameter": active_param
                            }],
                            "activeSignature": 0,
                            "activeParameter": active_param
                        }
                    }
                },
                _ => {}
            }
        }
    }

    // 2. Builtin signatures
    if BUILTIN_SIGS.has(func_name) {
        const sig = BUILTIN_SIGS[func_name]
        let param_labels = []
        for p in sig["params"] {
            param_labels.push({"label": p})
        }
        let sig_doc = null
        if BUILTIN_DOCS.has(func_name) {
            sig_doc = {"kind": "markdown", "value": BUILTIN_DOCS[func_name]}
        }
        return {
            "signatures": [{
                "label": sig["label"],
                "documentation": sig_doc,
                "parameters": param_labels,
                "activeParameter": active_param
            }],
            "activeSignature": 0,
            "activeParameter": active_param
        }
    }

    null
}


// ══════════════════════════════════════════════════════════════════════
// ── Section 14: Enhanced Folding Ranges ──────────────────────────────
// ══════════════════════════════════════════════════════════════════════
//
// More precise folding using AST and multi-line string detection

func handle_folding_range_full(params) {
    const uri = params["textDocument"]["uri"]
    const doc = lsp_get_document(uri)
    if doc == null { return null }

    const source = doc["source"]
    const lines = source_lines(source)
    const program = doc["program"]
    let ranges = []

    // 1. AST-based folding for function bodies, struct/enum definitions
    if program != null {
        for stmt in program.statements {
            const sl = stmt.span.start_line - 1
            const sk = stmt.kind
            match sk {
                StmtKind::SFuncDef(fdef) => {
                    if fdef.body != null {
                        const body_stmts = fdef.body.statements
                        if len(body_stmts) > 0 {
                            const last_stmt = body_stmts[len(body_stmts) - 1]
                            const end_line = last_stmt.span.start_line
                            if end_line > sl + 1 {
                                ranges.push({
                                    "startLine": sl,
                                    "endLine": end_line,
                                    "kind": "region"
                                })
                            }
                        }
                    }
                },
                StmtKind::SAsyncFuncDef(fdef) => {
                    if fdef.body != null && len(fdef.body.statements) > 0 {
                        const last_stmt = fdef.body.statements[len(fdef.body.statements) - 1]
                        const end_line = last_stmt.span.start_line
                        if end_line > sl + 1 {
                            ranges.push({"startLine": sl, "endLine": end_line, "kind": "region"})
                        }
                    }
                },
                StmtKind::SEnumDef(_, variants, _) => {
                    if len(variants) > 1 {
                        ranges.push({"startLine": sl, "endLine": sl + len(variants), "kind": "region"})
                    }
                },
                StmtKind::SStructDef(_, fields, _) => {
                    if len(fields) > 1 {
                        ranges.push({"startLine": sl, "endLine": sl + len(fields), "kind": "region"})
                    }
                },
                StmtKind::STestDef(_, body) => {
                    if body != null && len(body.statements) > 0 {
                        const last_stmt = body.statements[len(body.statements) - 1]
                        const end_line = last_stmt.span.start_line
                        if end_line > sl + 1 {
                            ranges.push({"startLine": sl, "endLine": end_line, "kind": "region"})
                        }
                    }
                },
                StmtKind::SImplBlock(_, methods) => {
                    if methods != null && len(methods) > 0 {
                        const last_method = methods[len(methods) - 1]
                        const end_line = last_method.span.start_line
                        if end_line > sl + 1 {
                            ranges.push({"startLine": sl, "endLine": end_line, "kind": "region"})
                        }
                    }
                },
                StmtKind::SModuleDef(_, body) => {
                    if body != null && len(body.statements) > 0 {
                        const last_stmt = body.statements[len(body.statements) - 1]
                        const end_line = last_stmt.span.start_line
                        if end_line > sl + 1 {
                            ranges.push({"startLine": sl, "endLine": end_line, "kind": "region"})
                        }
                    }
                },
                _ => {}
            }
        }
    }

    // 2. Comment block folding
    let i = 0
    while i < len(lines) {
        const ln = lines[i].trim()
        if ln.starts_with("//") {
            const start = i
            let j = i + 1
            while j < len(lines) && lines[j].trim().starts_with("//") {
                j = j + 1
            }
            if j > start + 1 {
                ranges.push({"startLine": start, "endLine": j - 1, "kind": FOLD_COMMENT})
                i = j
                continue
            }
        }
        i = i + 1
    }

    // 3. Import block folding
    i = 0
    while i < len(lines) {
        const ln = lines[i].trim()
        if ln.starts_with("import ") || ln.starts_with("use ") {
            const start = i
            let j = i + 1
            while j < len(lines) {
                const next = lines[j].trim()
                if next.starts_with("import ") || next.starts_with("use ") {
                    j = j + 1
                } else {
                    break
                }
            }
            if j > start + 1 {
                ranges.push({"startLine": start, "endLine": j - 1, "kind": FOLD_IMPORTS})
            }
            i = j
            continue
        }
        i = i + 1
    }

    // 4. Multi-line string folding
    i = 0
    while i < len(lines) {
        const ln = lines[i]
        if ln.contains("\"\"\"") {
            const start = i
            let j = i + 1
            while j < len(lines) && !lines[j].contains("\"\"\"") {
                j = j + 1
            }
            if j > start && j < len(lines) {
                ranges.push({"startLine": start, "endLine": j, "kind": "region"})
            }
            i = j + 1
            continue
        }
        i = i + 1
    }

    // 5. Brace-based folding as fallback for constructs not in AST
    i = 0
    while i < len(lines) {
        const ln = lines[i].trim()
        if ln.ends_with("{") && !ranges.any(r => r["startLine"] == i) {
            let depth = 1
            let j = i + 1
            while j < len(lines) && depth > 0 {
                const jln = lines[j]
                let k = 0
                while k < len(jln) {
                    if jln[k] == "{" { depth = depth + 1 }
                    if jln[k] == "}" { depth = depth - 1 }
                    k = k + 1
                }
                if depth == 0 && j > i + 1 {
                    ranges.push({"startLine": i, "endLine": j, "kind": "region"})
                }
                j = j + 1
            }
        }
        i = i + 1
    }

    if len(ranges) == 0 { return null }
    ranges
}


// ══════════════════════════════════════════════════════════════════════
// ── Section 15: Enhanced Document Links ──────────────────────────────
// ══════════════════════════════════════════════════════════════════════
//
// Resolve import paths to file URIs, detect URL strings

func handle_document_link_full(params) {
    const uri = params["textDocument"]["uri"]
    const doc = lsp_get_document(uri)
    if doc == null { return null }

    let links = []
    const source = doc["source"]
    const lines = source_lines(source)

    let i = 0
    while i < len(lines) {
        const ln = lines[i]
        const trimmed = ln.trim()

        // Import/use statements
        if trimmed.starts_with("import ") {
            const path_start = 7
            const path_part = trimmed[path_start..len(trimmed)]
            if len(path_part) > 0 {
                // Convert module path to potential file path
                const file_path = path_part.replace(".", "/") + ".magi"
                const indent = len(ln) - len(trimmed)
                links.push({
                    "range": lsp_range(i, indent + path_start, i, indent + path_start + len(path_part)),
                    "tooltip": f"Module: {path_part}\nFile: {file_path}",
                    "data": {"type": "import", "module": path_part}
                })
            }
        }
        if trimmed.starts_with("use ") {
            const path_start = 4
            let path_end = len(trimmed)
            if trimmed.ends_with(";") { path_end = path_end - 1 }
            const path_part = trimmed[path_start..path_end].trim()
            if len(path_part) > 0 {
                const indent = len(ln) - len(trimmed)
                links.push({
                    "range": lsp_range(i, indent + path_start, i, indent + path_start + len(path_part)),
                    "tooltip": f"Use: {path_part}"
                })
            }
        }

        // Detect URLs in strings and comments
        let search_start = 0
        while search_start < len(ln) {
            const http_idx = ln[search_start..len(ln)].index_of("http")
            if http_idx == -1 { break }
            const abs_idx = search_start + http_idx
            // Check for http:// or https://
            if abs_idx + 7 < len(ln) && (ln[abs_idx..abs_idx + 7] == "http://" || ln[abs_idx..abs_idx + 8] == "https://") {
                // Find end of URL
                let url_end = abs_idx
                while url_end < len(ln) && ln[url_end] != " " && ln[url_end] != "\"" && ln[url_end] != "'" && ln[url_end] != ")" && ln[url_end] != ">" {
                    url_end = url_end + 1
                }
                if url_end > abs_idx + 8 {
                    const url = ln[abs_idx..url_end]
                    links.push({
                        "range": lsp_range(i, abs_idx, i, url_end),
                        "target": url,
                        "tooltip": f"Open: {url}"
                    })
                }
                search_start = url_end
            } else {
                search_start = abs_idx + 4
            }
        }

        i = i + 1
    }

    if len(links) == 0 { return null }
    links
}


// ══════════════════════════════════════════════════════════════════════
// ── Section 16: Enhanced Selection Ranges ────────────────────────────
// ══════════════════════════════════════════════════════════════════════
//
// AST-aware selection ranges for better expand/shrink selection

func handle_selection_range_full(params) {
    const uri = params["textDocument"]["uri"]
    const positions = params["positions"]

    const doc = lsp_get_document(uri)
    if doc == null { return null }

    const source = doc["source"]
    const program = doc["program"]
    const lines = source_lines(source)

    let result = []
    for pos in positions {
        const line = pos["line"]
        const character = pos["character"]

        let ranges = []

        // Level 1: Word
        const word_info = word_at_position(source, line, character)
        if word_info != null {
            ranges.push(lsp_range(line, word_info["start"], line, word_info["end"]))
        }

        // Level 2: Expression (find containing expression in AST)
        if program != null {
            const expr_range = find_containing_expression_range(program, line, character)
            if expr_range != null {
                ranges.push(expr_range)
            }
        }

        // Level 3: Statement
        if program != null {
            const stmt_range = find_containing_statement_range(program, line)
            if stmt_range != null {
                ranges.push(stmt_range)
            }
        }

        // Level 4: Block
        if program != null {
            const block_range = find_containing_block_range(program, line)
            if block_range != null {
                ranges.push(block_range)
            }
        }

        // Level 5: Line
        if line < len(lines) {
            ranges.push(lsp_range(line, 0, line, len(lines[line])))
        }

        // Level 6: Document
        const last_line = len(lines) - 1
        const last_char = if last_line >= 0 { len(lines[last_line]) } else { 0 }
        ranges.push(lsp_range(0, 0, last_line, last_char))

        // Deduplicate ranges
        let unique_ranges = []
        for r in ranges {
            let dup = false
            for ur in unique_ranges {
                if ur["start"]["line"] == r["start"]["line"] &&
                   ur["start"]["character"] == r["start"]["character"] &&
                   ur["end"]["line"] == r["end"]["line"] &&
                   ur["end"]["character"] == r["end"]["character"] {
                    dup = true
                    break
                }
            }
            if !dup { unique_ranges.push(r) }
        }

        // Build nested selection range (innermost to outermost)
        let sel = null
        let ri = len(unique_ranges) - 1
        while ri >= 0 {
            sel = {"range": unique_ranges[ri], "parent": sel}
            ri = ri - 1
        }
        result.push(sel)
    }

    if len(result) == 0 { return null }
    result
}

// Find the containing expression range at a position
func find_containing_expression_range(program, line, character) {
    if program == null { return null }
    for stmt in program.statements {
        const sl = stmt.span.start_line - 1
        if sl == line {
            // Simple: return the statement's expression range
            const sk = stmt.kind
            match sk {
                StmtKind::SExprStmt(expr) => {
                    if expr != null {
                        const el = expr.span.start_line - 1
                        const ec = expr.span.start_col - 1
                        return lsp_range(el, ec, el, ec + 20)
                    }
                },
                _ => {}
            }
        }
    }
    null
}

// Find the containing statement range at a line
func find_containing_statement_range(program, line) {
    if program == null { return null }
    for stmt in program.statements {
        const sl = stmt.span.start_line - 1
        if sl == line {
            return lsp_range(sl, 0, sl + 1, 0)
        }
        // Check nested statements in function bodies
        const sk = stmt.kind
        match sk {
            StmtKind::SFuncDef(fdef) => {
                if fdef.body != null {
                    for s in fdef.body.statements {
                        const ssl = s.span.start_line - 1
                        if ssl == line {
                            return lsp_range(ssl, 0, ssl + 1, 0)
                        }
                    }
                }
            },
            _ => {}
        }
    }
    null
}

// Find the containing block range at a line
func find_containing_block_range(program, line) {
    if program == null { return null }
    for stmt in program.statements {
        const sl = stmt.span.start_line - 1
        const sk = stmt.kind
        match sk {
            StmtKind::SFuncDef(fdef) => {
                if fdef.body != null && len(fdef.body.statements) > 0 {
                    const first_sl = fdef.body.statements[0].span.start_line - 1
                    const last_sl = fdef.body.statements[len(fdef.body.statements) - 1].span.start_line - 1
                    if line >= first_sl && line <= last_sl {
                        return lsp_range(sl, 0, last_sl + 1, 0)
                    }
                }
            },
            _ => {}
        }
    }
    null
}

// ══════════════════════════════════════════════════════════════════════
// ── Final: Version constant ──────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

const LSP_VERSION = "2.0.0"


// ══════════════════════════════════════════════════════════════════════
// ── Section 17: Diagnostics Severity Mapping ─────────────────────────
// ══════════════════════════════════════════════════════════════════════
//
// Map error codes to severity levels and provide related information

// Error code to severity mapping
func diagnostic_severity_for_code(code) {
    if code == null { return DIAG_ERROR }
    const first = code[0]
    if first == "E" { return DIAG_ERROR }
    if first == "W" { return DIAG_WARNING }
    if first == "I" { return DIAG_INFO }
    if first == "H" { return DIAG_HINT }
    DIAG_ERROR
}

// Error code to diagnostic tag mapping
// Tags: 1 = Unnecessary, 2 = Deprecated
func diagnostic_tags_for_code(code) {
    if code == null { return [] }
    if code == "W100" { return [1] }  // Unused import
    if code == "W101" { return [1] }  // Empty block
    if code == "W102" { return [1] }  // Unused variable
    if code == "W103" { return [2] }  // Deprecated
    []
}

// Build related information for a diagnostic
func diagnostic_related_info(source, program, code, message) {
    let related = []

    // For undefined function errors, show where similar functions are defined
    if code == "E201" {
        const func_name = extract_name_from_diagnostic(message)
        if func_name != null {
            const suggestion = find_closest_symbol(program, func_name)
            if suggestion != null {
                const def = find_definition(program, suggestion)
                if def != null {
                    related.push({
                        "message": f"Did you mean '{suggestion}'?",
                        "location": {
                            "range": lsp_range(def["line"], def["col"], def["line"], def["col"] + len(suggestion))
                        }
                    })
                }
            }
        }
    }

    // For duplicate definition errors, show the original
    if code == "E100" {
        const dup_name = extract_name_from_diagnostic(message)
        if dup_name != null {
            const def = find_definition(program, dup_name)
            if def != null {
                related.push({
                    "message": f"'{dup_name}' is first defined here",
                    "location": {
                        "range": lsp_range(def["line"], def["col"], def["line"], def["col"] + len(dup_name))
                    }
                })
            }
        }
    }

    related
}


// ══════════════════════════════════════════════════════════════════════
// ── Section 18: Code Action — Extract Function ───────────────────────
// ══════════════════════════════════════════════════════════════════════
//
// Extract selected code into a new function

func make_extract_function_action(uri, source, start_line, start_char, end_line, end_char) {
    const lines = source.split("\n")

    // Extract the selected text
    let selected_lines = []
    let i = start_line
    while i <= end_line && i < len(lines) {
        if i == start_line && i == end_line {
            selected_lines.push(lines[i][start_char..end_char])
        } else if i == start_line {
            selected_lines.push(lines[i][start_char..len(lines[i])])
        } else if i == end_line {
            selected_lines.push(lines[i][0..end_char])
        } else {
            selected_lines.push(lines[i])
        }
        i = i + 1
    }

    const selected_text = selected_lines.join("\n")
    if len(selected_text.trim()) == 0 { return null }

    // Detect free variables in the selection (simple heuristic)
    let free_vars = detect_free_variables(selected_text)

    // Build the new function
    const params_str = free_vars.join(", ")
    const func_name = "extracted_function"
    let func_body = ""
    for sl in selected_lines {
        func_body = func_body + "    " + sl.trim() + "\n"
    }

    const new_func = f"\nfunc {func_name}({params_str}) {{\n{func_body}}}\n"

    // Build the call expression
    const call_text = f"{func_name}({params_str})"

    // Find insertion point (after the current function, or at end of file)
    let insert_line = len(lines)

    let changes = {"__s": true}
    let edits = []

    // Replace selected text with function call
    edits.push(lsp_text_edit(
        lsp_range(start_line, start_char, end_line, end_char),
        call_text
    ))

    // Insert new function at end
    edits.push(lsp_text_edit(
        lsp_range(insert_line, 0, insert_line, 0),
        new_func
    ))

    changes[uri] = edits

    {
        "title": "Extract function",
        "kind": "refactor.extract",
        "edit": {"changes": changes}
    }
}

// Detect free variables in a code snippet (simple heuristic)
func detect_free_variables(code) {
    let vars = []
    let declared = {"__s": true}

    const lines = code.split("\n")
    for ln in lines {
        const trimmed = ln.trim()

        // Track declarations
        if trimmed.starts_with("let ") || trimmed.starts_with("const ") {
            const prefix_len = if trimmed.starts_with("let ") { 4 } else { 6 }
            const rest = trimmed[prefix_len..len(trimmed)].trim()
            let name_end = 0
            while name_end < len(rest) && is_ident_char(rest[name_end]) {
                name_end = name_end + 1
            }
            if name_end > 0 {
                declared[rest[0..name_end]] = true
            }
        }

        // Find identifiers that aren't declared locally
        let ci = 0
        while ci < len(trimmed) {
            if is_ident_char(trimmed[ci]) && (ci == 0 || !is_ident_char(trimmed[ci - 1])) {
                let end = ci
                while end < len(trimmed) && is_ident_char(trimmed[end]) { end = end + 1 }
                const word = trimmed[ci..end]
                if !MAGI_KEYWORDS.contains(word) && !MAGI_BUILTINS.contains(word) && !declared.has(word) {
                    if !vars.contains(word) {
                        vars.push(word)
                    }
                }
                ci = end
            } else {
                ci = ci + 1
            }
        }
    }

    vars
}


// ══════════════════════════════════════════════════════════════════════
// ── Section 19: Code Action — Inline Variable ────────────────────────
// ══════════════════════════════════════════════════════════════════════
//
// Replace a variable with its value at all usage sites

func make_inline_variable_action(uri, source, program, var_name) {
    if program == null { return null }

    // Find the variable's value
    let var_value_text = null
    let def_line = -1

    const lines = source.split("\n")
    for stmt in program.statements {
        const sl = stmt.span.start_line - 1
        const sk = stmt.kind
        match sk {
            StmtKind::SLet(name, _) => {
                if name == var_name {
                    def_line = sl
                    // Extract the value text from source
                    const ln = lines[sl]
                    const eq_idx = ln.index_of("=")
                    if eq_idx >= 0 {
                        var_value_text = ln[eq_idx + 1..len(ln)].trim()
                        // Remove trailing semicolons if any
                        if var_value_text.ends_with(";") {
                            var_value_text = var_value_text[0..len(var_value_text) - 1].trim()
                        }
                    }
                }
            },
            StmtKind::SConst(name, _) => {
                if name == var_name {
                    def_line = sl
                    const ln = lines[sl]
                    const eq_idx = ln.index_of("=")
                    if eq_idx >= 0 {
                        var_value_text = ln[eq_idx + 1..len(ln)].trim()
                        if var_value_text.ends_with(";") {
                            var_value_text = var_value_text[0..len(var_value_text) - 1].trim()
                        }
                    }
                }
            },
            _ => {}
        }
    }

    if var_value_text == null || def_line == -1 { return null }

    // Find all references to the variable (excluding the definition)
    const refs = find_references(program, var_name)
    let usage_refs = []
    for r in refs {
        if r["line"] != def_line || r["kind"] != "definition" {
            usage_refs.push(r)
        }
    }

    if len(usage_refs) == 0 { return null }

    let edits = []

    // Replace each usage with the value
    // Process in reverse order to preserve positions
    let ri = len(usage_refs) - 1
    while ri >= 0 {
        const r = usage_refs[ri]
        edits.push(lsp_text_edit(
            lsp_range(r["line"], r["col"], r["line"], r["col"] + len(var_name)),
            var_value_text
        ))
        ri = ri - 1
    }

    // Remove the definition line
    if def_line >= 0 && def_line < len(lines) {
        edits.push(lsp_text_edit(
            lsp_range(def_line, 0, def_line + 1, 0),
            ""
        ))
    }

    let changes = {"__s": true}
    changes[uri] = edits

    {
        "title": f"Inline variable '{var_name}'",
        "kind": "refactor.inline",
        "edit": {"changes": changes}
    }
}


// ══════════════════════════════════════════════════════════════════════
// ── Section 20: Server Capabilities Extension ────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Full initialize response with all capabilities
func handle_initialize_full(params) {
    if params != null && params.has("rootUri") && params["rootUri"] != null {
        lsp_workspace_root = params["rootUri"]
    }

    // Extract client capabilities for feature negotiation
    let client_caps = null
    if params != null && params.has("capabilities") {
        client_caps = params["capabilities"]
    }

    {
        "capabilities": {
            "textDocumentSync": {
                "openClose": true,
                "change": 1,
                "save": {"includeText": true},
                "willSave": true,
                "willSaveWaitUntil": false
            },
            "completionProvider": {
                "triggerCharacters": [".", ":", "@", "/"],
                "resolveProvider": true
            },
            "hoverProvider": true,
            "definitionProvider": true,
            "typeDefinitionProvider": true,
            "referencesProvider": true,
            "renameProvider": {"prepareProvider": true},
            "documentFormattingProvider": true,
            "documentRangeFormattingProvider": true,
            "documentOnTypeFormattingProvider": {
                "firstTriggerCharacter": "}",
                "moreTriggerCharacter": [";", "\n"]
            },
            "codeActionProvider": {
                "codeActionKinds": [
                    "quickfix",
                    "refactor.extract",
                    "refactor.inline",
                    "refactor.rewrite",
                    "source.organizeImports",
                    "source.fixAll"
                ]
            },
            "signatureHelpProvider": {
                "triggerCharacters": ["(", ","],
                "retriggerCharacters": [","]
            },
            "documentSymbolProvider": true,
            "semanticTokensProvider": {
                "legend": {
                    "tokenTypes": SEMANTIC_TOKEN_TYPES,
                    "tokenModifiers": SEMANTIC_TOKEN_MODIFIERS
                },
                "full": true,
                "range": false
            },
            "foldingRangeProvider": true,
            "selectionRangeProvider": true,
            "codeLensProvider": {"resolveProvider": true},
            "inlayHintProvider": {"resolveProvider": true},
            "documentLinkProvider": {"resolveSupport": true},
            "linkedEditingRangeProvider": true,
            "documentHighlightProvider": true,
            "documentColorProvider": true,
            "callHierarchyProvider": true,
            "typeHierarchyProvider": true,
            "workspaceSymbolProvider": true,
            "executeCommandProvider": {
                "commands": ["magi.run", "magi.check", "magi.lint", "magi.format", "magi.runTest", "magi.runTests"]
            },
            "workspace": {
                "workspaceFolders": {
                    "supported": true,
                    "changeNotifications": true
                },
                "fileOperations": {
                    "didCreate": {"filters": [{"pattern": {"glob": "**/*.magi"}}]},
                    "didDelete": {"filters": [{"pattern": {"glob": "**/*.magi"}}]}
                }
            },
            "diagnosticProvider": {
                "interFileDependencies": true,
                "workspaceDiagnostics": false
            }
        },
        "serverInfo": {
            "name": "magi-lsp-self",
            "version": LSP_VERSION
        }
    }
}
