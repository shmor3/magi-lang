// Get hover info for a function definition
func get_function_hover(program, name) {
    if program == null { return null }
    for stmt in program.statements {
        const sk = stmt.kind
        match sk {
            StmtKind::SFuncDef(fdef) => {
                if fdef.name == name {
                    let param_strs = []
                    for p in fdef.params {
                        if p.rest {
                            param_strs.push("..." + p.name)
                        } else if p.type_ann != "" {
                            param_strs.push(p.name + ": " + p.type_ann)
                        } else {
                            param_strs.push(p.name)
                        }
                    }
                    let ret_str = if fdef.return_type != "" { " -> " + fdef.return_type } else { "" }
                    const sig = f"func {name}({param_strs.join(', ')}){ret_str}"

                    // Extract preceding doc comments
                    const doc = extract_doc_comment(program, stmt.span.start_line)

                    let md = "```magi\n" + sig + "\n```"
                    if doc != "" {
                        md = md + "\n\n" + doc
                    }
                    return md
                }
            },
            StmtKind::SAsyncFuncDef(fdef) => {
                if fdef.name == name {
                    let param_strs = []
                    for p in fdef.params { param_strs.push(p.name) }
                    const sig = f"async func {name}({param_strs.join(', ')})"
                    return "```magi\n" + sig + "\n```\n\nAsynchronous function."
                }
            },
            _ => {}
        }
    }
    null
}

// Get hover info for a struct
func get_struct_hover(program, name) {
    if program == null { return null }
    for stmt in program.statements {
        const sk = stmt.kind
        match sk {
            StmtKind::SStructDef(sname, fields, _) => {
                if sname == name {
                    let field_strs = []
                    for field in fields {
                        const fname = field[0]
                        const ftype = if len(field) > 1 { field[1] } else { "unknown" }
                        field_strs.push(f"    {fname}: {ftype}")
                    }
                    const body = field_strs.join(",\n")
                    return f"```magi\nstruct {name} {{\n{body}\n}}\n```"
                }
            },
            _ => {}
        }
    }
    null
}

// Get hover info for an enum
func get_enum_hover(program, name) {
    if program == null { return null }
    for stmt in program.statements {
        const sk = stmt.kind
        match sk {
            StmtKind::SEnumDef(ename, variants, _) => {
                if ename == name {
                    let variant_strs = []
                    for v in variants {
                        const vname = if typeof(v) == "string" { v } else { v[0] }
                        variant_strs.push("    " + vname)
                    }
                    const body = variant_strs.join(",\n")
                    return f"```magi\nenum {name} {{\n{body}\n}}\n```"
                }
            },
            _ => {}
        }
    }
    null
}

// Get hover info for a variable
func get_variable_hover(program, name) {
    if program == null { return null }
    for stmt in program.statements {
        const sk = stmt.kind
        match sk {
            StmtKind::SConst(vname, expr) => {
                if vname == name {
                    let type_info = infer_simple_type(expr)
                    return f"```magi\nconst {name}: {type_info}\n```\n\nImmutable constant."
                }
            },
            StmtKind::SLet(vname, expr) => {
                if vname == name {
                    let type_info = infer_simple_type(expr)
                    return f"```magi\nlet {name}: {type_info}\n```\n\nImmutable variable."
                }
            },
            StmtKind::SLetMut(vname, expr) => {
                if vname == name {
                    let type_info = infer_simple_type(expr)
                    return f"```magi\nlet mut {name}: {type_info}\n```\n\nMutable variable."
                }
            },
            _ => {}
        }
    }
    null
}

// Get hover info for an interface/trait
func get_interface_hover(program, name) {
    if program == null { return null }
    for stmt in program.statements {
        const sk = stmt.kind
        match sk {
            StmtKind::SInterfaceDef(iname, methods, _) => {
                if iname == name {
                    let method_strs = []
                    for m in methods {
                        method_strs.push("    func " + to_string(m))
                    }
                    const body = method_strs.join("\n")
                    return f"```magi\ninterface {name} {{\n{body}\n}}\n```"
                }
            },
            _ => {}
        }
    }
    null
}

