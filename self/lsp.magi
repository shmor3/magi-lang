// ── Configuration and Workspace Support ─────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// LSP configuration settings
let lsp_config = {
    "__s": true,
    "inlayHints.enabled": true,
    "inlayHints.typeHints": true,
    "inlayHints.parameterHints": true,
    "inlayHints.returnTypeHints": true,
    "lint.enabled": true,
    "format.onSave": false,
    "completion.snippets": true,
    "completion.autoImport": true,
    "diagnostics.enabled": true,
    "semanticHighlighting.enabled": true
}

// Handle configuration change notification
func handle_configuration_changed(params) {
    if params != null && params.has("settings") {
        const settings = params["settings"]
        if typeof(settings) == "map" {
            for k in settings.keys() {
                if k != "__s" {
                    lsp_config[k] = settings[k]
                }
            }
        }
    }
    null
}

// ══════════════════════════════════════════════════════════════════════
// ── Workspace File Operations ───────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Handle workspace folder changes
func handle_workspace_folders_change(params) {
    if params == null { return null }
    if params.has("event") {
        const event = params["event"]
        if event.has("added") {
            for folder in event["added"] {
                // Index new workspace folder
                send_log_message(MSG_INFO, f"Workspace folder added: {folder['uri']}")
            }
        }
        if event.has("removed") {
            for folder in event["removed"] {
                send_log_message(MSG_INFO, f"Workspace folder removed: {folder['uri']}")
            }
        }
    }
    null
}

// ══════════════════════════════════════════════════════════════════════
// ── Formatting Utilities ────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Sort import statements
func sort_imports(source) {
    const lines = source.split("\n")
    let import_lines = []
    let other_lines = []
    let in_imports = true

    for ln in lines {
        const trimmed = ln.trim()
        if in_imports && (trimmed.starts_with("import ") || trimmed.starts_with("use ")) {
            import_lines.push(ln)
        } else {
            if in_imports && len(import_lines) > 0 {
                in_imports = false
            }
            other_lines.push(ln)
        }
    }

    // Sort imports alphabetically
    import_lines = import_lines.sort()

    let result = []
    for il in import_lines { result.push(il) }
    if len(import_lines) > 0 && len(other_lines) > 0 {
        result.push("") // blank line after imports
    }
    for ol in other_lines { result.push(ol) }

    result.join("\n")
}

// Remove trailing whitespace from all lines
func remove_trailing_whitespace(source) {
    const lines = source.split("\n")
    let result = []
    for ln in lines {
        let end = len(ln)
        while end > 0 && (ln[end - 1] == " " || ln[end - 1] == "\t") {
            end = end - 1
        }
        result.push(ln.substring(0, end))
    }
    result.join("\n")
}

// Ensure file ends with exactly one newline
func ensure_final_newline(source) {
    let trimmed = source
    while len(trimmed) > 0 && trimmed[len(trimmed) - 1] == "\n" {
        trimmed = trimmed.substring(0, len(trimmed) - 1)
    }
    trimmed + "\n"
}

// ######################################################################
// ######################################################################
// ##                                                                  ##
// ##   FULL LSP DEPTH — Phase 2                                       ##
// ##   Completions, Hover, Semantics, Code Actions, Diagnostics       ##
// ##                                                                  ##
// ######################################################################
// ######################################################################

// ══════════════════════════════════════════════════════════════════════
// ── Section 1: Full Completion Engine ─────────────────────────────────
// ══════════════════════════════════════════════════════════════════════
//
// Context-aware completions matching src/lsp/completion.rs:
//   - Inside struct literal -> field names
//   - Inside match -> variant names
//   - After dot -> methods for that type
//   - Import completions (all stdlib modules)
//   - Type annotation completions
//   - Fuzzy matching with Levenshtein distance

// Levenshtein distance between two strings
func levenshtein(a, b) {
    const la = len(a)
    const lb = len(b)
    if la == 0 { return lb }
    if lb == 0 { return la }

    // Use a single-row DP approach
    let prev_row = []
    let i = 0
    while i <= lb {
        prev_row.push(i)
        i = i + 1
    }

    let ai = 0
    while ai < la {
        let curr_row = [ai + 1]
        let bi = 0
        while bi < lb {
            const cost = if a[ai] == b[bi] { 0 } else { 1 }
            const insert_cost = curr_row[bi] + 1
            const delete_cost = prev_row[bi + 1] + 1
            const replace_cost = prev_row[bi] + cost
            let min_cost = insert_cost
            if delete_cost < min_cost { min_cost = delete_cost }
            if replace_cost < min_cost { min_cost = replace_cost }
            curr_row.push(min_cost)
            bi = bi + 1
        }
        prev_row = curr_row
        ai = ai + 1
    }

    prev_row[lb]
}

// Detect if cursor is inside a struct literal: `StructName { field: ... , |`
func find_struct_literal_context(source, line, character) {
    const lines = source.split("\n")
    if line >= len(lines) { return null }
    const ln = lines[line]

    // Walk backwards from cursor to find opening brace
    let pos = character - 1
    let depth = 0
    while pos >= 0 {
        const c = ln[pos]
        if c == "}" { depth = depth + 1 }
        if c == "{" {
            if depth == 0 {
                // Found opening brace — look for struct name before it
                let name_end = pos - 1
                while name_end >= 0 && ln[name_end] == " " { name_end = name_end - 1 }
                if name_end < 0 { return null }
                let name_start = name_end
                while name_start > 0 && is_ident_char(ln[name_start - 1]) {
                    name_start = name_start - 1
                }
                if name_start > name_end { return null }
                const name = ln[name_start..name_end + 1]
                // Must start with uppercase to be a struct name
                if len(name) > 0 && name[0] >= "A" && name[0] <= "Z" {
                    return name
                }
                return null
            }
            depth = depth - 1
        }
        pos = pos - 1
    }
    null
}

// Detect if cursor is inside a match expression and return the matched type name
func find_match_context(source, line, character) {
    const lines = source.split("\n")
    if line >= len(lines) { return null }

    // Scan upward from current line looking for `match <expr> {`
    let scan_line = line
    while scan_line >= 0 {
        const ln = lines[scan_line].trim()
        if ln.starts_with("match ") {
            // Extract the expression being matched
            const after_match = ln[6..len(ln)].trim()
            // Strip trailing {
            let expr_str = after_match
            if expr_str.ends_with("{") {
                expr_str = expr_str[0..len(expr_str) - 1].trim()
            }
            return expr_str
        }
        // If we hit a line with unmatched {, stop searching
        if ln.ends_with("{") && !ln.starts_with("match") && !ln.starts_with("//") {
            return null
        }
        scan_line = scan_line - 1
    }
    null
}

// Detect dot-access context: returns the receiver name before the dot
func find_dot_receiver(source, line, character) {
    const lines = source.split("\n")
    if line >= len(lines) { return null }
    const ln = lines[line]

    // Walk backward from cursor position
    let pos = character - 1
    // Skip any partial identifier the user is typing after the dot
    while pos >= 0 && is_ident_char(ln[pos]) {
        pos = pos - 1
    }
    // Check for the dot
    if pos < 0 || ln[pos] != "." { return null }
    pos = pos - 1

    // Handle method chain: skip closing parens and brackets
    if pos >= 0 && (ln[pos] == ")" || ln[pos] == "]") {
        // For now, return generic methods for chained calls
        return "__chained__"
    }

    // Collect the receiver name
    let end = pos + 1
    while pos >= 0 && is_ident_char(ln[pos]) {
        pos = pos - 1
    }
    if pos + 1 >= end { return null }
    ln[pos + 1..end]
}

// Full context-aware completion handler
func handle_completion_full(params) {
    const uri = params["textDocument"]["uri"]
    const pos = params["position"]
    const line = pos["line"]
    const character = pos["character"]

    const doc = lsp_get_document(uri)
    if doc == null { return {"isIncomplete": false, "items": []} }

    const source = doc["source"]
    const program = doc["program"]
    let items = []

    // Get the current word prefix for filtering
    const word_info = word_at_position(source, line, character)
    const prefix = if word_info != null { word_info["word"] } else { "" }
    const prefix_lower = if prefix != "" { prefix.to_lower() } else { "" }

    // 1. Check for double-colon context: `EnumName::` -> suggest variants
    const enum_context = find_double_colon_context(source, line, character)
    if enum_context != null {
        const variants = get_enum_variant_completions(program, enum_context)
        if len(variants) > 0 {
            return {"isIncomplete": false, "items": variants}
        }
    }

    // 2. Check for dot-access context: `expr.` -> suggest fields/methods
    const receiver = find_dot_receiver(source, line, character)
    if receiver != null {
        return handle_dot_completion(doc, receiver, prefix, prefix_lower, line)
    }

    // 3. Check for struct literal context
    const struct_context = find_struct_literal_context(source, line, character)
    if struct_context != null {
        const field_items = get_struct_field_completions(program, struct_context)
        if len(field_items) > 0 {
            return {"isIncomplete": false, "items": field_items}
        }
    }

    // 4. Check for match context: suggest enum variants
    const match_expr = find_match_context(source, line, character)
    if match_expr != null {
        // Try to find enum for the matched expression
        const match_items = get_match_completions(program, match_expr, prefix)
        if len(match_items) > 0 {
            for mi in match_items { items.push(mi) }
        }
    }

    // 5. Check for import context
    const line_text = source.split("\n")
    if line < len(line_text) {
        const current_line = line_text[line].trim()
        if current_line.starts_with("import ") || current_line.starts_with("use ") {
            const import_items = get_import_completions(prefix)
            return {"isIncomplete": false, "items": import_items}
        }
    }

    // 6. Check for type annotation context (after : in parameter or let)
    if is_type_annotation_context(source, line, character) {
        const type_items = get_type_annotation_completions(prefix)
        for ti in type_items { items.push(ti) }
    }

    // 7. Keywords with details
    for kw in MAGI_KEYWORDS {
        if prefix == "" || kw.starts_with(prefix_lower) {
            let detail = "keyword"
            if KEYWORD_DETAILS.has(kw) {
                detail = KEYWORD_DETAILS[kw]
            }
            items.push({
                "label": kw,
                "kind": CIK_KEYWORD,
                "detail": detail,
                "sortText": "3" + kw
            })
        }
    }

    // 8. Builtin functions with signatures
    for b in MAGI_BUILTINS {
        if prefix == "" || b.starts_with(prefix_lower) {
            let detail = "builtin"
            if BUILTIN_SIGNATURES.has(b) {
                detail = BUILTIN_SIGNATURES[b]
            }
            items.push({
                "label": b,
                "kind": CIK_FUNCTION,
                "detail": detail,
                "sortText": "2" + b
            })
        }
    }

    // 9. Snippet completions
    const snippets = get_snippet_completions(prefix)
    for s in snippets { items.push(s) }

    // 10. Document symbols (functions, variables, structs, enums)
    const func_items = get_function_completions(program, prefix)
    for fi in func_items { items.push(fi) }

    const var_items = get_variable_completions(program, prefix, line)
    for vi in var_items { items.push(vi) }

    // Struct and enum names
    if program != null {
        for stmt in program.statements {
            const sk = stmt.kind
            match sk {
                StmtKind::SStructDef(name, fields, _) => {
                    if prefix == "" || name.starts_with(prefix) {
                        items.push({
                            "label": name,
                            "kind": CIK_STRUCT,
                            "detail": f"struct {name} ({len(fields)} fields)",
                            "sortText": "1" + name
                        })
                    }
                },
                StmtKind::SEnumDef(name, variants, _) => {
                    if prefix == "" || name.starts_with(prefix) {
                        items.push({
                            "label": name,
                            "kind": CIK_CLASS,
                            "detail": f"enum {name} ({len(variants)} variants)",
                            "sortText": "1" + name
                        })
                    }
                },
                StmtKind::SInterfaceDef(name, _, _) => {
                    if prefix == "" || name.starts_with(prefix) {
                        items.push({
                            "label": name,
                            "kind": CIK_INTERFACE,
                            "detail": f"interface {name}",
                            "sortText": "1" + name
                        })
                    }
                },
                _ => {}
            }
        }
    }

    // 11. Cross-file symbol completions from workspace
    for ws_uri in lsp_documents.keys() {
        if ws_uri == "__s" || ws_uri == uri { continue }
        const ws_doc = lsp_documents[ws_uri]
        if ws_doc == null { continue }
        const ws_symbols = collect_symbols(ws_doc["program"])
        for sym in ws_symbols {
            if prefix == "" || sym["name"].starts_with(prefix) {
                items.push({
                    "label": sym["name"],
                    "kind": match sym["kind"] {
                        SK_FUNCTION => CIK_FUNCTION,
                        SK_VARIABLE => CIK_VARIABLE,
                        SK_CONSTANT => CIK_CONSTANT,
                        SK_ENUM => CIK_CLASS,
                        SK_STRUCT => CIK_STRUCT,
                        _ => CIK_TEXT
                    },
                    "detail": sym["detail"] + " (from " + ws_uri + ")",
                    "sortText": "5" + sym["name"]
                })
            }
        }
    }

    // 12. Fuzzy matching fallback when no exact prefix matches
    if prefix != "" && len(items) == 0 {
        items = fuzzy_complete(source, program, prefix, prefix_lower, line)
    }

    {"isIncomplete": len(items) > 100, "items": items}
}

// Dot-access completion: type-specific method/field suggestions
func handle_dot_completion(doc, receiver, prefix, prefix_lower, line) {
    let items = []
    const program = doc["program"]

    // Determine receiver type
    let receiver_type = null
    if receiver == "__chained__" {
        receiver_type = "any"
    } else if program != null {
        // Look up variable type
        for stmt in program.statements {
            const sl = stmt.span.start_line - 1
            if sl > line { break }
            const sk = stmt.kind
            match sk {
                StmtKind::SLet(name, expr) => {
                    if name == receiver {
                        receiver_type = infer_simple_type(expr)
                    }
                },
                StmtKind::SLetMut(name, expr) => {
                    if name == receiver {
                        receiver_type = infer_simple_type(expr)
                    }
                },
                StmtKind::SConst(name, expr) => {
                    if name == receiver {
                        receiver_type = infer_simple_type(expr)
                    }
                },
                _ => {}
            }
        }

        // Check if receiver is a struct instance
        if receiver_type == null || receiver_type == "unknown" {
            const struct_fields = find_struct_for_variable(program, receiver)
            if struct_fields != null {
                for f in struct_fields { items.push(f) }
            }
        }
    }

    // Add type-specific methods
    if receiver_type != null {
        const type_methods = get_method_completions_for_type(receiver_type)
        for m in type_methods {
            if prefix_lower == "" || m["label"].to_lower().starts_with(prefix_lower) {
                items.push(m)
            }
        }
    }

    // Always add generic methods
    const generic_methods = [
        {"label": "to_string", "kind": CIK_METHOD, "detail": "func to_string() -> string", "documentation": "Converts to string"},
        {"label": "to_json", "kind": CIK_METHOD, "detail": "func to_json() -> string", "documentation": "Converts to JSON string"},
        {"label": "to_int", "kind": CIK_METHOD, "detail": "func to_int() -> int", "documentation": "Converts to integer"},
        {"label": "to_float", "kind": CIK_METHOD, "detail": "func to_float() -> float", "documentation": "Converts to float"},
        {"label": "to_bool", "kind": CIK_METHOD, "detail": "func to_bool() -> bool", "documentation": "Converts to boolean"},
        {"label": "typeof", "kind": CIK_METHOD, "detail": "func typeof() -> string", "documentation": "Returns type name"}
    ]
    for gm in generic_methods {
        if prefix_lower == "" || gm["label"].to_lower().starts_with(prefix_lower) {
            // Avoid duplicates
            let found = false
            for existing in items {
                if existing["label"] == gm["label"] { found = true; break }
            }
            if !found { items.push(gm) }
        }
    }

    // If prefix given but nothing matches exactly, try fuzzy
    if prefix != "" && len(items) == 0 {
        let all_methods = get_method_completions_for_type(if receiver_type != null { receiver_type } else { "any" })
        for gm in generic_methods { all_methods.push(gm) }
        const max_dist = if len(prefix) <= 2 { 1 } else if len(prefix) <= 5 { 2 } else { 3 }
        for m in all_methods {
            const dist = levenshtein(prefix_lower, m["label"].to_lower())
            if dist > 0 && dist <= max_dist {
                m["sortText"] = "zz" + to_string(dist) + m["label"]
                items.push(m)
            }
        }
    }

    {"isIncomplete": false, "items": items}
}

// Find struct fields for a variable that was constructed from a struct literal
func find_struct_for_variable(program, var_name) {
    if program == null { return null }
    for stmt in program.statements {
        const sk = stmt.kind
        match sk {
            StmtKind::SLet(name, expr) => {
                if name == var_name && expr != null {
                    const struct_name = detect_struct_construction(expr)
                    if struct_name != null {
                        return get_struct_field_completions(program, struct_name)
                    }
                }
            },
            StmtKind::SConst(name, expr) => {
                if name == var_name && expr != null {
                    const struct_name = detect_struct_construction(expr)
                    if struct_name != null {
                        return get_struct_field_completions(program, struct_name)
                    }
                }
            },
            _ => {}
        }
    }
    null
}

// Detect struct construction in an expression (e.g., `StructName { ... }`)
func detect_struct_construction(expr) {
    if expr == null { return null }
    const ek = expr.kind
    match ek {
        ExprKind::ECall(name, _, _) => {
            // Struct construction looks like a call: StructName { ... }
            if len(name) > 0 && name[0] >= "A" && name[0] <= "Z" {
                return name
            }
            null
        },
        ExprKind::EStructLiteral(name, _) => name,
        _ => null
    }
}

// Match completions: suggest enum variants for matched expression
func get_match_completions(program, match_expr, prefix) {
    let items = []
    if program == null { return items }

    // Try to identify the enum type from the expression
    for stmt in program.statements {
        const sk = stmt.kind
        match sk {
            StmtKind::SEnumDef(name, variants, _) => {
                // Check if the match expression references this enum type
                if match_expr == name || match_expr.contains(name) {
                    for v in variants {
                        const vname = if typeof(v) == "string" { v } else { v[0] }
                        const full = name + "::" + vname
                        if prefix == "" || vname.starts_with(prefix) || full.starts_with(prefix) {
                            items.push({
                                "label": full,
                                "kind": CIK_ENUM_MEMBER,
                                "detail": f"Variant of {name}",
                                "insertText": full + " => ",
                                "sortText": "0" + vname
                            })
                        }
                    }
                    // Also suggest wildcard pattern
                    items.push({
                        "label": "_",
                        "kind": CIK_KEYWORD,
                        "detail": "Wildcard pattern (matches anything)",
                        "insertText": "_ => ",
                        "sortText": "9_"
                    })
                }
            },
            _ => {}
        }
    }

    // If no enum matched, suggest common match patterns
    if len(items) == 0 {
        items.push({"label": "true", "kind": CIK_KEYWORD, "detail": "Match true", "insertText": "true => "})
        items.push({"label": "false", "kind": CIK_KEYWORD, "detail": "Match false", "insertText": "false => "})
        items.push({"label": "null", "kind": CIK_KEYWORD, "detail": "Match null", "insertText": "null => "})
        items.push({"label": "_", "kind": CIK_KEYWORD, "detail": "Wildcard pattern", "insertText": "_ => "})
    }

    items
}

// Type annotation completions (after `:` in declarations)
func is_type_annotation_context(source, line, character) {
    const lines = source.split("\n")
    if line >= len(lines) { return false }
    const ln = lines[line]
    // Walk backward from cursor to find `:`
    let pos = character - 1
    // Skip current word
    while pos >= 0 && is_ident_char(ln[pos]) { pos = pos - 1 }
    // Skip whitespace
    while pos >= 0 && (ln[pos] == " " || ln[pos] == "\t") { pos = pos - 1 }
    // Check for colon
    if pos >= 0 && ln[pos] == ":" {
        // Make sure it's not :: (double colon for enum variants)
        if pos > 0 && ln[pos - 1] == ":" { return false }
        return true
    }
    false
}

func get_type_annotation_completions(prefix) {
    let items = []
    const types = [
        ["int", "32-bit integer type"],
        ["int32", "32-bit signed integer"],
        ["int64", "64-bit signed integer"],
        ["uint32", "32-bit unsigned integer"],
        ["uint64", "64-bit unsigned integer"],
        ["float", "64-bit floating point type"],
        ["float32", "32-bit floating point"],
        ["float64", "64-bit floating point"],
        ["string", "String type"],
        ["bool", "Boolean type (true/false)"],
        ["null", "Null type"],
        ["any", "Any type (no type constraint)"],
        ["Array", "Dynamic array type"],
        ["Map", "Ordered map type"],
        ["Bytes", "Byte array type"],
        ["Function", "Function type"],
        ["void", "Void (no return value)"],
        ["never", "Never type (function does not return)"]
    ]
    for t in types {
        const name = t[0]
        const desc = t[1]
        if prefix == "" || name.to_lower().starts_with(prefix.to_lower()) {
            items.push({
                "label": name,
                "kind": CIK_CLASS,
                "detail": desc,
                "sortText": "0" + name
            })
        }
    }
    items
}

// Fuzzy completion fallback using Levenshtein distance
func fuzzy_complete(source, program, prefix, prefix_lower, line) {
    let candidates = []

    // Collect all potential completion labels
    for kw in MAGI_KEYWORDS {
        candidates.push({"label": kw, "kind": CIK_KEYWORD, "detail": "keyword"})
    }
    for b in MAGI_BUILTINS {
        let detail = "builtin"
        if BUILTIN_SIGNATURES.has(b) { detail = BUILTIN_SIGNATURES[b] }
        candidates.push({"label": b, "kind": CIK_FUNCTION, "detail": detail})
    }
    if program != null {
        const symbols = collect_symbols(program)
        for sym in symbols {
            candidates.push({
                "label": sym["name"],
                "kind": match sym["kind"] {
                    SK_FUNCTION => CIK_FUNCTION,
                    SK_VARIABLE => CIK_VARIABLE,
                    SK_CONSTANT => CIK_CONSTANT,
                    _ => CIK_TEXT
                },
                "detail": sym["detail"]
            })
        }
    }

    // Score by Levenshtein distance
    const max_dist = if len(prefix) <= 2 { 1 } else if len(prefix) <= 5 { 2 } else { 3 }
    let scored = []
    for c in candidates {
        const dist = levenshtein(prefix_lower, c["label"].to_lower())
        if dist > 0 && dist <= max_dist {
            c["sortText"] = "zz" + to_string(dist) + c["label"]
            scored.push(c)
        }
    }

    scored
}

// Find double-colon context: `EnumName::` returns the enum name
func find_double_colon_context(source, line, character) {
    const lines = source.split("\n")
    if line >= len(lines) { return null }
    const ln = lines[line]

    // Walk backward: skip any partial identifier
    let pos = character
    while pos > 0 && is_ident_char(ln[pos - 1]) {
        pos = pos - 1
    }

    // Check for `::`
    if pos < 2 || ln[pos - 1] != ":" || ln[pos - 2] != ":" {
        return null
    }
    pos = pos - 2

    // Scan backward for the enum name
    let name_end = pos
    let name_start = name_end
    while name_start > 0 && is_ident_char(ln[name_start - 1]) {
        name_start = name_start - 1
    }
    if name_start >= name_end { return null }
    ln[name_start..name_end]
}


