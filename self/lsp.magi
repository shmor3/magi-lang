        methods.push({"label": "entries", "kind": CIK_METHOD, "detail": "func entries() -> array", "documentation": "Returns [key, value] pairs"})
        methods.push({"label": "from_entries", "kind": CIK_METHOD, "detail": "func from_entries(entries: array) -> map", "documentation": "Creates map from [key, value] pairs"})
        methods.push({"label": "to_entries", "kind": CIK_METHOD, "detail": "func to_entries() -> array", "documentation": "Converts to [key, value] pairs"})
        methods.push({"label": "contains_key", "kind": CIK_METHOD, "detail": "func contains_key(key: string) -> bool", "documentation": "Checks if key exists"})
        methods.push({"label": "contains_value", "kind": CIK_METHOD, "detail": "func contains_value(value) -> bool", "documentation": "Checks if value exists"})
        methods.push({"label": "is_empty", "kind": CIK_METHOD, "detail": "func is_empty() -> bool", "documentation": "True if map is empty"})
        methods.push({"label": "invert", "kind": CIK_METHOD, "detail": "func invert() -> map", "documentation": "Swaps keys and values"})
        methods.push({"label": "select", "kind": CIK_METHOD, "detail": "func select(keys: array) -> map", "documentation": "Select only specified keys"})
        methods.push({"label": "reject", "kind": CIK_METHOD, "detail": "func reject(keys: array) -> map", "documentation": "Remove specified keys"})
        methods.push({"label": "deep_merge", "kind": CIK_METHOD, "detail": "func deep_merge(other: map) -> map", "documentation": "Recursively merges maps"})
    }

    methods
}

// Enhanced completion: variable completions with type info
func get_variable_completions(program, prefix, line) {
    let completions = []
    if program == null { return completions }

    for stmt in program.statements {
        const sl = stmt.span.start_line - 1
        if sl > line { break }

        const sk = stmt.kind
        match sk {
            StmtKind::SConst(name, expr) => {
                if prefix == "" || name.starts_with(prefix) {
                    let type_info = infer_simple_type(expr)
                    completions.push({
                        "label": name,
                        "kind": CIK_CONSTANT,
                        "detail": f"const {name}: {type_info}",
                        "documentation": f"Immutable constant defined at line {sl + 1}",
                        "sortText": "0" + name
                    })
                }
            },
            StmtKind::SLet(name, expr) => {
                if prefix == "" || name.starts_with(prefix) {
                    let type_info = infer_simple_type(expr)
                    completions.push({
                        "label": name,
                        "kind": CIK_VARIABLE,
                        "detail": f"let {name}: {type_info}",
                        "documentation": f"Immutable variable defined at line {sl + 1}",
                        "sortText": "0" + name
                    })
                }
            },
            StmtKind::SLetMut(name, expr) => {
                if prefix == "" || name.starts_with(prefix) {
                    let type_info = infer_simple_type(expr)
                    completions.push({
                        "label": name,
                        "kind": CIK_VARIABLE,
                        "detail": f"let mut {name}: {type_info}",
                        "documentation": f"Mutable variable defined at line {sl + 1}",
                        "sortText": "0" + name
                    })
                }
            },
            _ => {}
        }
    }

    completions
}

// Simple type inference for completion detail
func infer_simple_type(expr) {
    if expr == null { return "unknown" }
    const ek = expr.kind
    match ek {
        ExprKind::EIntLiteral(_) => "int",
        ExprKind::EFloatLiteral(_) => "float",
        ExprKind::EStringLiteral(_) => "string",
        ExprKind::EBoolLiteral(_) => "bool",
        ExprKind::EArrayLiteral(_) => "array",
        ExprKind::EMapLiteral(_) => "map",
        ExprKind::ENullLiteral => "null",
        ExprKind::ECall(name, _, _) => f"result of {name}()",
        ExprKind::ELambda(_, _) => "function",
        _ => "unknown"
    }
}

// Function completions with full signatures
func get_function_completions(program, prefix) {
    let completions = []
    if program == null { return completions }

    for stmt in program.statements {
        const sk = stmt.kind
        match sk {
            StmtKind::SFuncDef(fdef) => {
                if prefix == "" || fdef.name.starts_with(prefix) {
                    let param_strs = []
                    for p in fdef.params {
                        if p.rest {
                            param_strs.push("..." + p.name)
                        } else if p.type_ann != "" {
                            param_strs.push(p.name + ": " + p.type_ann)
                        } else {
                            param_strs.push(p.name)
                        }
                    }
                    let ret_type = if fdef.return_type != "" { " -> " + fdef.return_type } else { "" }
                    const sig = f"func {fdef.name}({param_strs.join(', ')}){ret_type}"
                    const sl = stmt.span.start_line

                    // Build insert text with parameter placeholders
                    let insert_params = []
                    let idx = 1
                    for p in fdef.params {
                        insert_params.push(f"${{{idx}:{p.name}}}")
                        idx = idx + 1
                    }

                    completions.push({
                        "label": fdef.name,
                        "kind": CIK_FUNCTION,
                        "detail": sig,
                        "documentation": f"Defined at line {sl}",
                        "insertText": fdef.name + "(" + insert_params.join(", ") + ")",
                        "insertTextFormat": 2,
                        "sortText": "1" + fdef.name
                    })
                }
            },
            StmtKind::SAsyncFuncDef(fdef) => {
                if prefix == "" || fdef.name.starts_with(prefix) {
                    let param_strs = []
                    for p in fdef.params {
                        param_strs.push(p.name)
                    }
                    const sig = f"async func {fdef.name}({param_strs.join(', ')})"
                    completions.push({
                        "label": fdef.name,
                        "kind": CIK_FUNCTION,
                        "detail": sig,
                        "documentation": "Async function",
                        "sortText": "1" + fdef.name
                    })
                }
            },
            _ => {}
        }
    }

    completions
}

// Struct field completions
func get_struct_field_completions(program, struct_name) {
    let completions = []
    if program == null { return completions }

    for stmt in program.statements {
        const sk = stmt.kind
        match sk {
            StmtKind::SStructDef(name, fields, _) => {
                if name == struct_name {
                    for field in fields {
                        const fname = field[0]
                        const ftype = if len(field) > 1 { field[1] } else { "unknown" }
                        completions.push({
                            "label": fname,
                            "kind": CIK_FIELD,
                            "detail": f"{fname}: {ftype}",
                            "documentation": f"Field of struct {struct_name}"
                        })
                    }
                }
            },
            _ => {}
        }
    }

    completions
}

// Enum variant completions
func get_enum_variant_completions(program, enum_name) {
    let completions = []
    if program == null { return completions }

    for stmt in program.statements {
        const sk = stmt.kind
        match sk {
            StmtKind::SEnumDef(name, variants, _) => {
                if name == enum_name {
                    for variant in variants {
                        const vname = if typeof(variant) == "string" { variant } else { variant[0] }
                        completions.push({
                            "label": vname,
                            "kind": CIK_ENUM_MEMBER,
                            "detail": f"{enum_name}::{vname}",
                            "documentation": f"Variant of enum {enum_name}",
                            "insertText": f"{enum_name}::{vname}"
                        })
                    }
                }
            },
            _ => {}
        }
    }

    completions
}

// Import path completions
func get_import_completions(prefix) {
    let completions = []
    const modules = [
        "array", "array_ext", "big", "binary", "bits", "bloom", "bufio",
        "build", "bytes", "cert", "cmp", "collections", "complex", "compress",
        "concurrent", "container", "control", "conv", "crypto", "csv",
        "debug", "embed", "encoding", "env", "error_chain", "errors",
        "expvar", "filepath", "flag", "fmt", "fs", "glob", "graph", "hash",
        "heap", "hex", "html", "http", "image", "inspect", "io", "iter",
        "json", "lazy", "log", "map", "math", "matrix", "memo", "mime",
        "multipart", "net", "number", "observe", "option", "os", "path",
        "pattern", "pipe", "platform", "pool", "process", "profile",
        "protocol", "ptr", "queue", "rand", "reflect", "regex", "result",
        "ring", "runtime", "semver", "serialize", "signal", "simd", "slice",
        "sort", "sql", "state", "stream", "string", "string_ext", "struct",
        "sync", "sysinfo", "template", "test", "text", "thread", "time",
        "tls", "trace", "tuple", "type", "unicode", "unsafe", "url",
        "uuid", "validate", "wasm", "xml", "yaml", "zip"
    ]

    for mod_name in modules {
        const full = "std." + mod_name
        if prefix == "" || full.starts_with(prefix) || mod_name.starts_with(prefix) {
            completions.push({
                "label": full,
                "kind": CIK_MODULE,
                "detail": f"Standard library module: {mod_name}",
                "insertText": full
            })
        }
    }

    completions
}

