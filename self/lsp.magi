// ── 36. workspace/symbol ────────────────────────────────────────────

func handle_workspace_symbol(params) {
    const query = if params.has("query") { params["query"] } else { "" }

    // Gather symbols from all cached documents
    let all_symbols = []
    for uri in keys(lsp_documents) {
        if uri == "__s" { continue }
        const doc = lsp_documents[uri]
        if doc == null { continue }
        const symbols = collect_symbols(doc["program"])
        for sym in symbols {
            if query == "" || sym["name"].contains(query) {
                all_symbols.push({
                    "name": sym["name"],
                    "kind": sym["kind"],
                    "location": lsp_location(uri, lsp_range(sym["line"], sym["col"], sym["end_line"], 0)),
                    "containerName": uri
                })
            }
        }
    }

    if len(all_symbols) == 0 { return null }
    all_symbols
}

// ── 37. workspace/executeCommand ────────────────────────────────────

func handle_execute_command(params) {
    const command = params["command"]
    const arguments = if params.has("arguments") { params["arguments"] } else { [] }

    match command {
        "magi.run" => {
            if len(arguments) > 0 {
                const uri = arguments[0]
                const doc = lsp_get_document(uri)
                if doc != null {
                    const source = doc["source"]
                    // Would invoke run_source(source) in full implementation
                    return {"result": "run completed"}
                }
            }
            null
        },
        "magi.check" => {
            if len(arguments) > 0 {
                const uri = arguments[0]
                const doc = lsp_get_document(uri)
                if doc != null {
                    return {"result": "check completed"}
                }
            }
            null
        },
        "magi.lint" => {
            if len(arguments) > 0 {
                const uri = arguments[0]
                const doc = lsp_get_document(uri)
                if doc != null {
                    const warnings = lint(doc["program"])
                    return {"result": f"{len(warnings)} warnings"}
                }
            }
            null
        },
        "magi.format" => {
            if len(arguments) > 0 {
                const uri = arguments[0]
                const doc = lsp_get_document(uri)
                if doc != null {
                    const formatted = format_program(doc["program"])
                    return {"result": formatted}
                }
            }
            null
        },
        _ => null
    }
}

