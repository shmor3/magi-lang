// ── Log and Show Message ────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

const MSG_ERROR = 1
const MSG_WARNING = 2
const MSG_INFO = 3
const MSG_LOG = 4

func send_log_message(msg_type, message) {
    jsonrpc_notification("window/logMessage", {
        "type": msg_type,
        "message": message
    })
}

func send_show_message(msg_type, message) {
    jsonrpc_notification("window/showMessage", {
        "type": msg_type,
        "message": message
    })
}

// ══════════════════════════════════════════════════════════════════════
// ── Configuration and Workspace Support ─────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// LSP configuration settings
let lsp_config = {
    "__s": true,
    "inlayHints.enabled": true,
    "inlayHints.typeHints": true,
    "inlayHints.parameterHints": true,
    "inlayHints.returnTypeHints": true,
    "lint.enabled": true,
    "format.onSave": false,
    "completion.snippets": true,
    "completion.autoImport": true,
    "diagnostics.enabled": true,
    "semanticHighlighting.enabled": true
}

// Handle configuration change notification
func handle_configuration_changed(params) {
    if params != null && params.has("settings") {
        const settings = params["settings"]
        if typeof(settings) == "map" {
            for k in settings.keys() {
                if k != "__s" {
                    lsp_config[k] = settings[k]
                }
            }
        }
    }
    null
}

// ══════════════════════════════════════════════════════════════════════
// ── Workspace File Operations ───────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Handle workspace folder changes
func handle_workspace_folders_change(params) {
    if params == null { return null }
    if params.has("event") {
        const event = params["event"]
        if event.has("added") {
            for folder in event["added"] {
                // Index new workspace folder
                send_log_message(MSG_INFO, f"Workspace folder added: {folder['uri']}")
            }
        }
        if event.has("removed") {
            for folder in event["removed"] {
                send_log_message(MSG_INFO, f"Workspace folder removed: {folder['uri']}")
            }
        }
    }
    null
}

// ══════════════════════════════════════════════════════════════════════
// ── Formatting Utilities ────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Sort import statements
func sort_imports(source) {
    const lines = source.split("\n")
    let import_lines = []
    let other_lines = []
    let in_imports = true

    for ln in lines {
        const trimmed = ln.trim()
        if in_imports && (trimmed.starts_with("import ") || trimmed.starts_with("use ")) {
            import_lines.push(ln)
        } else {
            if in_imports && len(import_lines) > 0 {
                in_imports = false
            }
            other_lines.push(ln)
        }
    }

    // Sort imports alphabetically
    import_lines = import_lines.sort()

    let result = []
    for il in import_lines { result.push(il) }
    if len(import_lines) > 0 && len(other_lines) > 0 {
        result.push("") // blank line after imports
    }
    for ol in other_lines { result.push(ol) }

    result.join("\n")
}

// Remove trailing whitespace from all lines
func remove_trailing_whitespace(source) {
    const lines = source.split("\n")
    let result = []
    for ln in lines {
        let end = len(ln)
        while end > 0 && (ln[end - 1] == " " || ln[end - 1] == "\t") {
            end = end - 1
        }
        result.push(ln.substring(0, end))
    }
    result.join("\n")
}

// Ensure file ends with exactly one newline
func ensure_final_newline(source) {
    let trimmed = source
    while len(trimmed) > 0 && trimmed[len(trimmed) - 1] == "\n" {
        trimmed = trimmed.substring(0, len(trimmed) - 1)
    }
    trimmed + "\n"
}
