const LSP_FULL_HANDLER_COUNT = 53

// ══════════════════════════════════════════════════════════════════════
// ── Section 9: Extended Type Inference Engine ─────────────────────────
// ══════════════════════════════════════════════════════════════════════
//
// Deep type inference across expressions for better completions,
// hover info, and diagnostics.

// Infer the type of an expression by walking the AST
func infer_expr_type_deep(expr, program) {
    if expr == null { return null }
    const ek = expr.kind
    match ek {
        ExprKind::ELiteral(lit) => {
            match lit {
                Literal::IntLit(_) => "int64",
                Literal::FloatLit(_) => "float64",
                Literal::StringLit(_) => "string",
                Literal::BoolLit(_) => "bool",
                Literal::NullLit => "null",
                Literal::ArrayLit(elements) => {
                    if len(elements) > 0 {
                        const elem_type = infer_expr_type_deep(elements[0], program)
                        if elem_type != null { f"[{elem_type}]" } else { "Array" }
                    } else { "Array" }
                },
                Literal::MapLit(_) => "Map",
                _ => null
            }
        },
        ExprKind::EVariable(name) => {
            // Look up variable type in program definitions
            if program != null {
                for stmt in program.statements {
                    const sk = stmt.kind
                    match sk {
                        StmtKind::SLet(vname, value) => {
                            if vname == name && value != null {
                                return infer_expr_type_deep(value, program)
                            }
                        },
                        StmtKind::SConst(vname, value) => {
                            if vname == name && value != null {
                                return infer_expr_type_deep(value, program)
                            }
                        },
                        StmtKind::SLetMut(vname, value) => {
                            if vname == name && value != null {
                                return infer_expr_type_deep(value, program)
                            }
                        },
                        _ => {}
                    }
                }
            }
            null
        },
        ExprKind::ECall(name, args, _) => {
            // Infer return type from known function signatures
            if BUILTIN_RETURN_TYPES.has(name) {
                return BUILTIN_RETURN_TYPES[name]
            }
            // Check user-defined functions
            if program != null {
                for stmt in program.statements {
                    const sk = stmt.kind
                    match sk {
                        StmtKind::SFuncDef(fdef) => {
                            if fdef.name == name && fdef.return_type != "" {
                                return fdef.return_type
                            }
                        },
                        _ => {}
                    }
                }
            }
            null
        },
        ExprKind::EBinaryOp(op, left, right) => {
            match op {
                BinOp::Eq => "bool", BinOp::NotEq => "bool",
                BinOp::Lt => "bool", BinOp::Gt => "bool",
                BinOp::LtEq => "bool", BinOp::GtEq => "bool",
                BinOp::And => "bool", BinOp::Or => "bool",
                BinOp::Add => {
                    const lt = infer_expr_type_deep(left, program)
                    if lt == "string" { return "string" }
                    if lt == "int64" || lt == "int" { return "int64" }
                    if lt == "float64" || lt == "float" { return "float64" }
                    lt
                },
                BinOp::Sub => infer_expr_type_deep(left, program),
                BinOp::Mul => infer_expr_type_deep(left, program),
                BinOp::Div => "float64",
                BinOp::Mod => "int64",
                _ => infer_expr_type_deep(left, program)
            }
        },
        ExprKind::EUnaryOp(op, operand) => {
            match op {
                UnOp::Not => "bool",
                UnOp::Neg => infer_expr_type_deep(operand, program)
            }
        },
        ExprKind::EMethodCall(object, method_name, _, _) => {
            // Infer return type based on method
            if METHOD_RETURN_TYPES.has(method_name) {
                return METHOD_RETURN_TYPES[method_name]
            }
            null
        },
        ExprKind::EFieldAccess(object, field) => {
            // Try to resolve struct field type
            const obj_type = infer_expr_type_deep(object, program)
            if obj_type != null && program != null {
                for stmt in program.statements {
                    const sk = stmt.kind
                    match sk {
                        StmtKind::SStructDef(name, fields, _) => {
                            if name == obj_type {
                                for f in fields {
                                    if f[0] == field && len(f) > 1 {
                                        return f[1]
                                    }
                                }
                            }
                        },
                        _ => {}
                    }
                }
            }
            null
        },
        ExprKind::EIndex(object, _) => {
            const obj_type = infer_expr_type_deep(object, program)
            if obj_type != null && obj_type.starts_with("[") {
                // Array element type
                return obj_type[1..len(obj_type) - 1]
            }
            if obj_type == "string" { return "string" }
            null
        },
        ExprKind::EIfExpr(_, then_expr, else_expr) => {
            infer_expr_type_deep(then_expr, program)
        },
        ExprKind::ELambda(_, _) => "Function",
        ExprKind::EStructLiteral(name, _) => name,
        ExprKind::ERange(_, _, _) => "[int64]",
        ExprKind::ETuple(elements) => {
            let types = []
            for e in elements {
                const t = infer_expr_type_deep(e, program)
                types.push(if t != null { t } else { "any" })
            }
            "(" + types.join(", ") + ")"
        },
        _ => null
    }
}

