// Enhanced hover handler with full feature set
func handle_hover_full(params) {
    const uri = params["textDocument"]["uri"]
    const pos = params["position"]
    const line = pos["line"]
    const character = pos["character"]

    const doc = lsp_get_document(uri)
    if doc == null { return null }

    const source = doc["source"]
    const program = doc["program"]

    // Check for enum variant pattern: EnumName::Variant
    const enum_variant = find_enum_variant_at(source, line, character)
    if enum_variant != null {
        const ename = enum_variant["enum"]
        const vname = enum_variant["variant"]
        const hover_md = get_enum_variant_hover(program, ename, vname)
        if hover_md != null {
            return {
                "contents": lsp_markup_content("markdown", hover_md),
                "range": lsp_range(line, enum_variant["start"], line, enum_variant["end"])
            }
        }
    }

    const word_info = word_at_position(source, line, character)
    if word_info == null { return null }
    const word = word_info["word"]
    const word_range = lsp_range(line, word_info["start"], line, word_info["end"])

    // 1. Check user-defined functions (with doc comments and full signatures)
    const func_hover = get_function_hover(program, word)
    if func_hover != null {
        return {"contents": lsp_markup_content("markdown", func_hover), "range": word_range}
    }

    // 2. Check user-defined structs
    const struct_hover = get_struct_hover(program, word)
    if struct_hover != null {
        return {"contents": lsp_markup_content("markdown", struct_hover), "range": word_range}
    }

    // 3. Check user-defined enums
    const enum_hover = get_enum_hover(program, word)
    if enum_hover != null {
        return {"contents": lsp_markup_content("markdown", enum_hover), "range": word_range}
    }

    // 4. Check user-defined variables with type inference
    const var_hover = get_variable_hover(program, word)
    if var_hover != null {
        return {"contents": lsp_markup_content("markdown", var_hover), "range": word_range}
    }

    // 5. Check user-defined interfaces/traits
    const iface_hover = get_interface_hover(program, word)
    if iface_hover != null {
        return {"contents": lsp_markup_content("markdown", iface_hover), "range": word_range}
    }

    // 6. Check builtin functions with full documentation
    if BUILTIN_DOCS.has(word) {
        return {
            "contents": lsp_markup_content("markdown", BUILTIN_DOCS[word]),
            "range": word_range
        }
    }

    // 7. Check method names
    if METHOD_DOCS.has(word) {
        const desc = METHOD_DOCS[word]
        const md = f"```magi\n.{word}(...)\n```\n\n{desc}"
        return {"contents": lsp_markup_content("markdown", md), "range": word_range}
    }

    // 8. Check keyword documentation
    if KEYWORD_DOCS.has(word) {
        return {
            "contents": lsp_markup_content("markdown", KEYWORD_DOCS[word]),
            "range": word_range
        }
    }

    // 9. Check stdlib operations
    if STDLIB_OPS.has(word) {
        const op_info = STDLIB_OPS[word]
        const mod_name = op_info[0]
        const desc = op_info[1]
        const md = f"```magi\nfunc {word}(...)\n```\n\n{desc}\n\n*From `std::{mod_name}`*"
        return {"contents": lsp_markup_content("markdown", md), "range": word_range}
    }

    // 10. Check cross-file definitions
    const cross_def = find_definition_across_files(word)
    if cross_def != null {
        const def = cross_def["def"]
        const def_uri = cross_def["uri"]
        const md = f"```magi\n({def['kind']}) {word}\n```\n\nDefined in `{def_uri}` at line {def['line'] + 1}."
        return {"contents": lsp_markup_content("markdown", md), "range": word_range}
    }

    // 11. Type names
    const type_names = ["int", "int32", "int64", "uint32", "uint64", "float", "float32", "float64",
                        "string", "bool", "null", "any", "Array", "Map", "Bytes", "String",
                        "Bool", "Int32", "Int64", "Uint32", "Uint64", "Float32", "Float64"]
    if type_names.contains(word) {
        const md = f"`{word}` -- MAGI built-in type"
        return {"contents": lsp_markup_content("markdown", md), "range": word_range}
    }

    null
}

// Detect enum variant at position: returns {enum, variant, start, end} or null
func find_enum_variant_at(source, line, character) {
    const lines = source.split("\n")
    if line >= len(lines) { return null }
    const ln = lines[line]

    // Expand to find the word at cursor
    let start = character
    while start > 0 && is_ident_char(ln[start - 1]) { start = start - 1 }
    let end_pos = character
    while end_pos < len(ln) && is_ident_char(ln[end_pos]) { end_pos = end_pos + 1 }
    if start >= end_pos { return null }
    const word = ln[start..end_pos]

    // Check if preceded by ::
    if start >= 2 && ln[start - 1] == ":" && ln[start - 2] == ":" {
        // Get enum name before ::
        let enum_end = start - 2
        let enum_start = enum_end
        while enum_start > 0 && is_ident_char(ln[enum_start - 1]) { enum_start = enum_start - 1 }
        if enum_start < enum_end {
            const enum_name = ln[enum_start..enum_end]
            return {"enum": enum_name, "variant": word, "start": enum_start, "end": end_pos}
        }
    }

    // Check if followed by :: (cursor is on enum name)
    if end_pos + 1 < len(ln) && ln[end_pos] == ":" && ln[end_pos + 1] == ":" {
        let var_start = end_pos + 2
        let var_end = var_start
        while var_end < len(ln) && is_ident_char(ln[var_end]) { var_end = var_end + 1 }
        if var_start < var_end {
            const variant = ln[var_start..var_end]
            return {"enum": word, "variant": variant, "start": start, "end": var_end}
        }
    }

    null
}

// Get hover info for an enum variant
func get_enum_variant_hover(program, enum_name, variant_name) {
    if program == null { return null }
    for stmt in program.statements {
        const sk = stmt.kind
        match sk {
            StmtKind::SEnumDef(name, variants, _) => {
                if name == enum_name {
                    let all_variants = []
                    let found = false
                    let variant_data = null
                    for v in variants {
                        const vname = if typeof(v) == "string" { v } else { v[0] }
                        all_variants.push(vname)
                        if vname == variant_name {
                            found = true
                            if typeof(v) != "string" && len(v) > 1 {
                                variant_data = v[1]
                            }
                        }
                    }
                    if found {
                        let md = f"```magi\n{enum_name}::{variant_name}\n```\n\nVariant of `enum {enum_name} {{ {all_variants.join(', ')} }}`"
                        if variant_data != null {
                            md = md + f"\n\nData type: `{variant_data}`"
                        }
                        return md
                    }
                }
            },
            _ => {}
        }
    }
    null
}

// Extract doc comments (///) preceding a statement
func extract_doc_comments(source, target_line) {
    const lines = source.split("\n")
    let doc_lines = []
    let check_line = target_line - 2  // 0-based, line before the definition
    while check_line >= 0 {
        const ln = lines[check_line].trim()
        if ln.starts_with("///") {
            const comment_text = ln[3..len(ln)].trim()
            doc_lines.push(comment_text)
        } else if ln.starts_with("//") {
            // Regular comment, stop
            break
        } else if ln == "" {
            // Blank line, stop
            break
        } else {
            break
        }
        check_line = check_line - 1
    }
    if len(doc_lines) == 0 { return "" }
    // Reverse since we collected bottom-up
    doc_lines.reverse().join("\n")
}


// ══════════════════════════════════════════════════════════════════════
// ── Section 3: Full Semantic Tokens ──────────────────────────────────
// ══════════════════════════════════════════════════════════════════════
//
// Walk entire AST and emit token for EVERY node:
//   - Keywords, string literals, number literals, comments
//   - Function names, variable names, type names, field names
//   - Operator tokens, enum members, struct names
//   - Modifiers: definition, readonly, deprecated

// Full semantic tokens handler using AST-aware classification
func handle_semantic_tokens_full_v2(params) {
    const uri = params["textDocument"]["uri"]
    const doc = lsp_get_document(uri)
    if doc == null { return {"data": []} }

    const source = doc["source"]
    const program = doc["program"]

    // Build symbol lookup tables for fast classification
    let known_functions = {"__s": true}
    let known_structs = {"__s": true}
    let known_enums = {"__s": true}
    let known_constants = {"__s": true}
    let known_variables = {"__s": true}
    let known_params = {"__s": true}
    let known_type_aliases = {"__s": true}

    if program != null {
        for stmt in program.statements {
            const sk = stmt.kind
            match sk {
                StmtKind::SFuncDef(fdef) => {
                    known_functions[fdef.name] = true
                    for p in fdef.params {
                        known_params[p.name] = true
                    }
                },
                StmtKind::SAsyncFuncDef(fdef) => {
                    known_functions[fdef.name] = true
                    for p in fdef.params {
                        known_params[p.name] = true
                    }
                },
                StmtKind::SStructDef(name, _, _) => { known_structs[name] = true },
                StmtKind::SEnumDef(name, _, _) => { known_enums[name] = true },
                StmtKind::SConst(name, _) => { known_constants[name] = true },
                StmtKind::SLet(name, _) => { known_variables[name] = true },
                StmtKind::SLetMut(name, _) => { known_variables[name] = true },
                _ => {}
            }
        }
    }

    // Tokenize source using the self-hosted lexer
    const save_tokens = p_tokens
    const save_pos = p_pos
    p_tokens = tokenize(source)
    const tokens = p_tokens
    p_tokens = save_tokens
    p_pos = save_pos

    // Classify each token with rich semantic information
    let raw = []  // Array of [line, col, len, type, modifiers]

    for tok in tokens {
        const tl = tok.line - 1
        const tc = tok.col - 1
        const tlen = len(tok.text)
        if tlen == 0 { continue }

        let token_type = null
        let token_mods = 0
        const tk = tok.kind

        match tk {
            // String literals
            TokenKind::StringLit => {
                token_type = SEM_STRING
            },
            // Number literals
            TokenKind::IntLit => {
                token_type = SEM_NUMBER
            },
            TokenKind::FloatLit => {
                token_type = SEM_NUMBER
            },
            // Keywords
            TokenKind::Func => { token_type = SEM_KEYWORD },
            TokenKind::Let => { token_type = SEM_KEYWORD },
            TokenKind::Const => { token_type = SEM_KEYWORD },
            TokenKind::If => { token_type = SEM_KEYWORD },
            TokenKind::Else => { token_type = SEM_KEYWORD },
            TokenKind::While => { token_type = SEM_KEYWORD },
            TokenKind::For => { token_type = SEM_KEYWORD },
            TokenKind::Return => { token_type = SEM_KEYWORD },
            TokenKind::Match => { token_type = SEM_KEYWORD },
            TokenKind::Enum => { token_type = SEM_KEYWORD },
            TokenKind::Struct => { token_type = SEM_KEYWORD },
            TokenKind::Trait => { token_type = SEM_KEYWORD },
            TokenKind::Impl => { token_type = SEM_KEYWORD },
            TokenKind::Import => { token_type = SEM_KEYWORD },
            TokenKind::True => { token_type = SEM_KEYWORD },
            TokenKind::False => { token_type = SEM_KEYWORD },
            TokenKind::Null => { token_type = SEM_KEYWORD },
            TokenKind::In => { token_type = SEM_KEYWORD },
            TokenKind::As => { token_type = SEM_KEYWORD },
            TokenKind::Break => { token_type = SEM_KEYWORD },
            TokenKind::Continue => { token_type = SEM_KEYWORD },
            TokenKind::Async => { token_type = SEM_KEYWORD },
            TokenKind::Await => { token_type = SEM_KEYWORD },
            TokenKind::Try => { token_type = SEM_KEYWORD },
            TokenKind::Catch => { token_type = SEM_KEYWORD },
            TokenKind::Throw => { token_type = SEM_KEYWORD },
            TokenKind::Spawn => { token_type = SEM_KEYWORD },
            TokenKind::Yield => { token_type = SEM_KEYWORD },
            TokenKind::Pub => { token_type = SEM_KEYWORD },
            TokenKind::Test => { token_type = SEM_KEYWORD },
            // Operators
            TokenKind::Plus => { token_type = SEM_OPERATOR },
            TokenKind::Minus => { token_type = SEM_OPERATOR },
            TokenKind::Star => { token_type = SEM_OPERATOR },
            TokenKind::Slash => { token_type = SEM_OPERATOR },
            TokenKind::Percent => { token_type = SEM_OPERATOR },
            TokenKind::EqEq => { token_type = SEM_OPERATOR },
            TokenKind::NotEq => { token_type = SEM_OPERATOR },
            TokenKind::Lt => { token_type = SEM_OPERATOR },
            TokenKind::Gt => { token_type = SEM_OPERATOR },
            TokenKind::LtEq => { token_type = SEM_OPERATOR },
            TokenKind::GtEq => { token_type = SEM_OPERATOR },
            TokenKind::And => { token_type = SEM_OPERATOR },
            TokenKind::Or => { token_type = SEM_OPERATOR },
            TokenKind::Not => { token_type = SEM_OPERATOR },
            TokenKind::Eq => { token_type = SEM_OPERATOR },
            TokenKind::Arrow => { token_type = SEM_OPERATOR },
            TokenKind::FatArrow => { token_type = SEM_OPERATOR },
            TokenKind::Pipe => { token_type = SEM_OPERATOR },
            TokenKind::Ampersand => { token_type = SEM_OPERATOR },
            TokenKind::DotDot => { token_type = SEM_OPERATOR },
            TokenKind::ColonColon => { token_type = SEM_OPERATOR },
            // Identifiers — classify using symbol tables
            TokenKind::Ident => {
                const txt = tok.text
                if MAGI_KEYWORDS.contains(txt) {
                    token_type = SEM_KEYWORD
                } else if known_functions.has(txt) && txt != "__s" {
                    token_type = SEM_FUNCTION
                    token_mods = MOD_DECLARATION
                } else if known_structs.has(txt) && txt != "__s" {
                    token_type = SEM_STRUCT
                    token_mods = MOD_DECLARATION
                } else if known_enums.has(txt) && txt != "__s" {
                    token_type = SEM_ENUM
                    token_mods = MOD_DECLARATION
                } else if known_constants.has(txt) && txt != "__s" {
                    token_type = SEM_VARIABLE
                    token_mods = MOD_READONLY
                } else if known_params.has(txt) && txt != "__s" {
                    token_type = SEM_PARAMETER
                } else if known_variables.has(txt) && txt != "__s" {
                    token_type = SEM_VARIABLE
                } else if MAGI_BUILTINS.contains(txt) {
                    token_type = SEM_FUNCTION
                    token_mods = MOD_DEFAULT_LIBRARY
                } else if is_type_name_str(txt) {
                    token_type = SEM_TYPE
                } else {
                    // Check context: preceded by dot -> property/method
                    const src_lines = source.split("\n")
                    if tl < len(src_lines) {
                        const line_text = src_lines[tl]
                        if tc > 0 && line_text[tc - 1] == "." {
                            // Check if followed by ( -> method call
                            let next_pos = tc + tlen
                            while next_pos < len(line_text) && line_text[next_pos] == " " { next_pos = next_pos + 1 }
                            if next_pos < len(line_text) && line_text[next_pos] == "(" {
                                token_type = SEM_METHOD
                            } else {
                                token_type = SEM_PROPERTY
                            }
                        } else if tc >= 2 && line_text[tc - 1] == ":" && line_text[tc - 2] == ":" {
                            token_type = SEM_ENUM_MEMBER
                        } else {
                            // Check if followed by ( -> function call
                            let next_pos = tc + tlen
                            while next_pos < len(line_text) && line_text[next_pos] == " " { next_pos = next_pos + 1 }
                            if next_pos < len(line_text) && line_text[next_pos] == "(" {
                                token_type = SEM_FUNCTION
                            } else {
                                token_type = SEM_VARIABLE
                            }
                        }
                    } else {
                        token_type = SEM_VARIABLE
                    }
                }
            },
            _ => {}
        }

        if token_type != null {
            raw.push([tl, tc, tlen, token_type, token_mods])
        }
    }

    // Also emit comment tokens by scanning source lines
    const src_lines = source.split("\n")
    let li = 0
    while li < len(src_lines) {
        const ln = src_lines[li]
        let ci = 0
        // Skip whitespace
        while ci < len(ln) && (ln[ci] == " " || ln[ci] == "\t") { ci = ci + 1 }
        if ci < len(ln) - 1 && ln[ci] == "/" && ln[ci + 1] == "/" {
            const comment_len = len(ln) - ci
            let is_doc = ci < len(ln) - 2 && ln[ci + 2] == "/"
            let mods = 0
            if is_doc { mods = MOD_DOCUMENTATION }
            raw.push([li, ci, comment_len, SEM_COMMENT, mods])
        }
        li = li + 1
    }

    // Sort by line then column
    raw = raw.sort_by((a, b) => {
        if a[0] != b[0] { return a[0] - b[0] }
        a[1] - b[1]
    })

    // Encode as delta format
    let data = []
    let prev_line = 0
    let prev_char = 0

    for entry in raw {
        const rl = entry[0]
        const rc = entry[1]
        const rlen = entry[2]
        const rtype = entry[3]
        const rmods = entry[4]

        const delta_line = rl - prev_line
        const delta_char = if delta_line == 0 { rc - prev_char } else { rc }
        data.push(delta_line)
        data.push(delta_char)
        data.push(rlen)
        data.push(rtype)
        data.push(rmods)

        prev_line = rl
        prev_char = rc
    }

    {"data": data}
}

// Check if a string is a type name
func is_type_name_str(name) {
    const types = ["int", "int32", "int64", "uint32", "uint64", "float", "float32", "float64",
                   "string", "bool", "null", "any", "Array", "Map", "Bytes", "String",
                   "Bool", "Int32", "Int64", "Uint32", "Uint64", "Float32", "Float64",
                   "Function", "void", "never"]
    types.contains(name)
}


// ══════════════════════════════════════════════════════════════════════
// ── Section 4: Full Code Actions ─────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════
//
// Matching src/lsp/code_actions.rs:
//   - Fix misspelled identifier (suggest closest match)
//   - Add missing import (E201)
//   - Remove unused import
//   - Convert let to const (if never reassigned)
//   - Add type annotation
//   - Rename to snake_case (W200)
//   - Organize imports
//   - Extract function
//   - Inline variable

// Full code actions handler
func handle_code_action_full(params) {
    const uri = params["textDocument"]["uri"]
    const range = params["range"]
    const context = params["context"]

    const doc = lsp_get_document(uri)
    if doc == null { return [] }

    let actions = []
    const source = doc["source"]
    const program = doc["program"]

    // Process diagnostics for quick fixes
    if context != null && context.has("diagnostics") {
        const diags = context["diagnostics"]
        for diag in diags {
            const msg = diag["message"]
            const code = if diag.has("code") { diag["code"] } else { null }

            // E201: Undefined function — suggest import
            if code == "E201" || msg.contains("Undefined function") {
                const func_name = extract_name_from_diagnostic(msg)
                if func_name != null {
                    const import_action = make_import_action(uri, source, func_name, diag)
                    if import_action != null {
                        actions.push(import_action)
                    }
                }
            }

            // W200: Naming convention — suggest snake_case rename
            if code == "W200" || msg.contains("should be snake_case") {
                const ident = extract_name_from_diagnostic(msg)
                if ident != null {
                    const snake_action = make_snake_case_action(uri, source, ident, diag)
                    if snake_action != null {
                        actions.push(snake_action)
                    }
                }
            }

            // Unused variable: prefix with underscore
            if msg.contains("unused") {
                const var_name = extract_name_from_diagnostic(msg)
                if var_name != null && !var_name.starts_with("_") {
                    actions.push({
                        "title": f"Prefix '{var_name}' with underscore",
                        "kind": "quickfix",
                        "diagnostics": [diag],
                        "edit": {
                            "changes": make_rename_edits(uri, source, var_name, "_" + var_name)
                        },
                        "isPreferred": true
                    })
                }
            }

            // Misspelled identifier: suggest closest match
            if msg.contains("Undefined") || msg.contains("undefined") {
                const unknown = extract_name_from_diagnostic(msg)
                if unknown != null {
                    const suggestion = find_closest_symbol(program, unknown)
                    if suggestion != null {
                        actions.push({
                            "title": f"Did you mean '{suggestion}'?",
                            "kind": "quickfix",
                            "diagnostics": [diag],
                            "edit": {
                                "changes": make_rename_edits(uri, source, unknown, suggestion)
                            }
                        })
                    }
                }
            }
        }
    }

    // Source actions (always available)

    // Organize imports
    const organize_action = make_organize_imports_action(uri, source)
    if organize_action != null {
        actions.push(organize_action)
    }

    // Convert let to const (if variable is never reassigned)
    const start_line = range["start"]["line"]
    const end_line = range["end"]["line"]
    const let_to_const = make_let_to_const_action(uri, source, program, start_line, end_line)
    if let_to_const != null {
        actions.push(let_to_const)
    }

    // Add type annotation for untyped declarations in range
    const add_type_action = make_add_type_annotation_action(uri, source, program, start_line, end_line)
    if add_type_action != null {
        actions.push(add_type_action)
    }

    // Format document
    actions.push({
        "title": "Format document",
        "kind": "source.fixAll",
        "command": {
            "title": "Format",
            "command": "magi.format",
            "arguments": [uri]
        }
    })

    actions
}

// Extract a quoted name from diagnostic message: "blah 'name' blah"
func extract_name_from_diagnostic(message) {
    let start = -1
    let i = 0
    while i < len(message) {
        if message[i] == "'" {
            if start == -1 {
                start = i + 1
            } else {
                return message[start..i]
            }
        }
        i = i + 1
    }
    null
}

// Find the closest matching symbol for a misspelled identifier
func find_closest_symbol(program, unknown) {
    if program == null { return null }
    let best_name = null
    let best_dist = 999

    const symbols = collect_symbols(program)
    for sym in symbols {
        const dist = levenshtein(unknown.to_lower(), sym["name"].to_lower())
        if dist > 0 && dist < best_dist && dist <= 3 {
            best_dist = dist
            best_name = sym["name"]
        }
    }

    // Also check builtins and keywords
    for b in MAGI_BUILTINS {
        const dist = levenshtein(unknown.to_lower(), b.to_lower())
        if dist > 0 && dist < best_dist && dist <= 3 {
            best_dist = dist
            best_name = b
        }
    }

    best_name
}

// Make an import suggestion code action
func make_import_action(uri, source, func_name, diag) {
    // Check if the function exists in any stdlib module
    const module = find_stdlib_module_for_function(func_name)
    if module == null { return null }

    const insert_line = find_import_insert_line(source)
    const import_text = f"import std.{module}\n"

    let changes = {"__s": true}
    changes[uri] = [{
        "range": lsp_range(insert_line, 0, insert_line, 0),
        "newText": import_text
    }]

    {
        "title": f"Import '{func_name}' from std.{module}",
        "kind": "quickfix",
        "diagnostics": [diag],
        "edit": {"changes": changes},
        "isPreferred": true
    }
}

// Find which stdlib module exports a function
func find_stdlib_module_for_function(func_name) {
    for key in STDLIB_OPS.keys() {
        if key == "__s" { continue }
        if key == func_name {
            return STDLIB_OPS[key][0]
        }
    }
    // Check common mappings
    if func_name.starts_with("array_") { return "array" }
    if func_name.starts_with("map_") { return "map" }
    if func_name.starts_with("string_") { return "str" }
    if func_name.starts_with("json_") { return "json" }
    if func_name.starts_with("regex_") { return "str" }
    if func_name.starts_with("bit_") { return "bits" }
    null
}

// Find the line to insert a new import statement
func find_import_insert_line(source) {
    const lines = source.split("\n")
    let last_import_line = -1
    let i = 0
    while i < len(lines) {
        const trimmed = lines[i].trim()
        if trimmed.starts_with("import ") || trimmed.starts_with("use ") {
            last_import_line = i
        } else if trimmed != "" && last_import_line >= 0 {
            break
        } else if trimmed != "" && last_import_line == -1 {
            break
        }
        i = i + 1
    }
    if last_import_line >= 0 { last_import_line + 1 } else { 0 }
}

// Convert string to snake_case
func to_snake_case(name) {
    let result = ""
    let i = 0
    while i < len(name) {
        const c = name[i]
        if c >= "A" && c <= "Z" {
            if i > 0 && result[len(result) - 1] != "_" {
                result = result + "_"
            }
            result = result + c.to_lower()
        } else {
            result = result + c
        }
        i = i + 1
    }
    result
}

// Make a snake_case rename action
func make_snake_case_action(uri, source, ident, diag) {
    const snake = to_snake_case(ident)
    if snake == ident || len(snake) == 0 { return null }

    let changes = make_rename_edits(uri, source, ident, snake)

    {
        "title": f"Rename '{ident}' to '{snake}'",
        "kind": "quickfix",
        "diagnostics": [diag],
        "edit": {"changes": changes},
        "isPreferred": true
    }
}

// Make text edits to rename all occurrences of a name in a document
func make_rename_edits(uri, source, old_name, new_name) {
    let edits = []
    const lines = source.split("\n")
    let i = 0
    while i < len(lines) {
        const ln = lines[i]
        let search_start = 0
        while search_start < len(ln) {
            const idx = ln[search_start..len(ln)].index_of(old_name)
            if idx == -1 { break }
            const abs_idx = search_start + idx
            const after_idx = abs_idx + len(old_name)
            // Check word boundary
            const before_ok = abs_idx == 0 || !is_ident_char(ln[abs_idx - 1])
            const after_ok = after_idx >= len(ln) || !is_ident_char(ln[after_idx])
            if before_ok && after_ok {
                edits.push(lsp_text_edit(
                    lsp_range(i, abs_idx, i, after_idx),
                    new_name
                ))
            }
            search_start = abs_idx + len(old_name)
            if search_start >= len(ln) { break }
        }
        i = i + 1
    }
    let changes = {"__s": true}
    changes[uri] = edits
    changes
}

// Make organize imports action
func make_organize_imports_action(uri, source) {
    const lines = source.split("\n")
    let import_lines = []
    let i = 0
    while i < len(lines) {
        const trimmed = lines[i].trim()
        if trimmed.starts_with("import ") || trimmed.starts_with("use ") {
            import_lines.push({"line": i, "text": trimmed})
        }
        i = i + 1
    }

    if len(import_lines) < 2 { return null }

    // Check if already sorted
    let sorted_texts = []
    for il in import_lines { sorted_texts.push(il["text"]) }
    sorted_texts = sorted_texts.sort()

    let already_sorted = true
    i = 0
    while i < len(import_lines) {
        if import_lines[i]["text"] != sorted_texts[i] {
            already_sorted = false
            break
        }
        i = i + 1
    }
    if already_sorted { return null }

    // Build edits to replace each import line
    let edits = []
    i = 0
    while i < len(import_lines) {
        const il = import_lines[i]
        const original = lines[il["line"]]
        edits.push(lsp_text_edit(
            lsp_range(il["line"], 0, il["line"], len(original)),
            sorted_texts[i]
        ))
        i = i + 1
    }

    let changes = {"__s": true}
    changes[uri] = edits

    {
        "title": "Organize imports",
        "kind": "source.organizeImports",
        "edit": {"changes": changes}
    }
}

// Make let-to-const action for variables that are never reassigned
func make_let_to_const_action(uri, source, program, start_line, end_line) {
    if program == null { return null }
    const lines = source.split("\n")

    let i = start_line
    while i <= end_line && i < len(lines) {
        const ln = lines[i].trim()
        if ln.starts_with("let ") && !ln.starts_with("let mut ") {
            // Extract variable name
            const after_let = ln[4..len(ln)].trim()
            let name_end = 0
            while name_end < len(after_let) && is_ident_char(after_let[name_end]) {
                name_end = name_end + 1
            }
            if name_end > 0 {
                const var_name = after_let[0..name_end]
                // Check if the variable is ever reassigned
                const is_reassigned = check_reassignment(program, var_name)
                if !is_reassigned {
                    // Find the "let " in the original line
                    const original = lines[i]
                    const let_idx = original.index_of("let ")
                    if let_idx >= 0 {
                        let changes = {"__s": true}
                        changes[uri] = [lsp_text_edit(
                            lsp_range(i, let_idx, i, let_idx + 3),
                            "const"
                        )]
                        return {
                            "title": f"Convert 'let {var_name}' to 'const {var_name}'",
                            "kind": "refactor.rewrite",
                            "edit": {"changes": changes}
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    null
}

// Check if a variable is reassigned in the program
func check_reassignment(program, var_name) {
    if program == null { return false }
    for stmt in program.statements {
        const sk = stmt.kind
        match sk {
            StmtKind::SAssignment(name, _) => {
                if name == var_name { return true }
            },
            StmtKind::SCompoundAssign(name, _, _) => {
                if name == var_name { return true }
            },
            StmtKind::SFuncDef(fdef) => {
                if fdef.body != null {
                    for s in fdef.body.statements {
                        if check_reassignment_in_stmt(s, var_name) { return true }
                    }
                }
            },
            StmtKind::SIf(_, then_body, else_body) => {
                if then_body != null {
                    for s in then_body.statements {
                        if check_reassignment_in_stmt(s, var_name) { return true }
                    }
                }
                if else_body != null {
                    for s in else_body.statements {
                        if check_reassignment_in_stmt(s, var_name) { return true }
                    }
                }
            },
            StmtKind::SWhileLoop(_, _, body) => {
                if body != null {
                    for s in body.statements {
                        if check_reassignment_in_stmt(s, var_name) { return true }
                    }
                }
            },
            StmtKind::SForLoop(_, _, body, _) => {
                if body != null {
                    for s in body.statements {
                        if check_reassignment_in_stmt(s, var_name) { return true }
                    }
                }
            },
            _ => {}
        }
    }
    false
}

func check_reassignment_in_stmt(stmt, var_name) {
    const sk = stmt.kind
    match sk {
        StmtKind::SAssignment(name, _) => name == var_name,
        StmtKind::SCompoundAssign(name, _, _) => name == var_name,
        _ => false
    }
}

// Make add type annotation action
func make_add_type_annotation_action(uri, source, program, start_line, end_line) {
    if program == null { return null }
    const lines = source.split("\n")

    let i = start_line
    while i <= end_line && i < len(lines) {
        for stmt in program.statements {
            const sl = stmt.span.start_line - 1
            if sl != i { continue }
            const sk = stmt.kind
            match sk {
                StmtKind::SLet(name, expr) => {
                    if expr != null {
                        const inferred = infer_simple_type(expr)
                        if inferred != "unknown" && inferred != null {
                            const original = lines[i]
                            // Find the variable name position
                            const name_idx = original.index_of(name)
                            if name_idx >= 0 {
                                const insert_pos = name_idx + len(name)
                                let changes = {"__s": true}
                                changes[uri] = [lsp_text_edit(
                                    lsp_range(i, insert_pos, i, insert_pos),
                                    f": {inferred}"
                                )]
                                return {
                                    "title": f"Add type annotation ': {inferred}' to '{name}'",
                                    "kind": "refactor.rewrite",
                                    "edit": {"changes": changes}
                                }
                            }
                        }
                    }
                },
                StmtKind::SConst(name, expr) => {
                    if expr != null {
                        const inferred = infer_simple_type(expr)
                        if inferred != "unknown" && inferred != null {
                            const original = lines[i]
                            const name_idx = original.index_of(name)
                            if name_idx >= 0 {
                                const insert_pos = name_idx + len(name)
                                let changes = {"__s": true}
                                changes[uri] = [lsp_text_edit(
                                    lsp_range(i, insert_pos, i, insert_pos),
                                    f": {inferred}"
                                )]
                                return {
                                    "title": f"Add type annotation ': {inferred}' to '{name}'",
                                    "kind": "refactor.rewrite",
                                    "edit": {"changes": changes}
                                }
                            }
                        }
                    }
                },
                _ => {}
            }
        }
        i = i + 1
    }
    null
}


// ══════════════════════════════════════════════════════════════════════
// ── Section 5: Full Document Formatting ──────────────────────────────
// ══════════════════════════════════════════════════════════════════════
//
// Uses the self-hosted formatter for full document and range formatting
// with additional cleanup passes

// Full formatting handler with cleanup passes
func handle_formatting_full(params) {
    const uri = params["textDocument"]["uri"]
    const options = if params.has("options") { params["options"] } else { null }
    const doc = lsp_get_document(uri)
    if doc == null { return null }

    const source = doc["source"]
    const program = doc["program"]

    // If we have a parsed program, use the AST formatter
    let formatted = source
    if program != null {
        formatted = format_program(program)
    }

    // Apply cleanup passes
    formatted = sort_imports(formatted)
    formatted = remove_trailing_whitespace(formatted)
    formatted = normalize_blank_lines(formatted)
    formatted = ensure_final_newline(formatted)

    // Apply tab/space preference from options
    if options != null {
        const use_tabs = if options.has("insertSpaces") { !options["insertSpaces"] } else { false }
        const tab_size = if options.has("tabSize") { options["tabSize"] } else { 4 }
        if use_tabs {
            formatted = convert_spaces_to_tabs(formatted, tab_size)
        }
    }

    // If no changes, return empty edits
    if formatted == source { return [] }

    const lines = source_lines(source)
    const last_line = len(lines) - 1
    const last_char = if last_line >= 0 { len(lines[last_line]) } else { 0 }

    [lsp_text_edit(lsp_range(0, 0, last_line, last_char), formatted)]
}

// Full range formatting handler
func handle_range_formatting_full(params) {
    const uri = params["textDocument"]["uri"]
    const range = params["range"]
    const doc = lsp_get_document(uri)
    if doc == null { return null }

    const source = doc["source"]
    const program = doc["program"]

    let formatted = source
    if program != null {
        formatted = format_program(program)
    }
    formatted = remove_trailing_whitespace(formatted)

    const fmt_lines = formatted.split("\n")
    const src_lines = source_lines(source)

    const start_line = range["start"]["line"]
    const end_line = range["end"]["line"]

    // Extract formatted lines for the range
    let range_text = ""
    let i = start_line
    while i <= end_line && i < len(fmt_lines) {
        if i > start_line { range_text = range_text + "\n" }
        range_text = range_text + fmt_lines[i]
        i = i + 1
    }

    const end_char = if end_line < len(src_lines) { len(src_lines[end_line]) } else { 0 }

    [lsp_text_edit(lsp_range(start_line, 0, end_line, end_char), range_text)]
}

// Normalize consecutive blank lines (max 2)
func normalize_blank_lines(source) {
    const lines = source.split("\n")
    let result = []
    let blank_count = 0

    for ln in lines {
        if ln.trim() == "" {
            blank_count = blank_count + 1
            if blank_count <= 2 {
                result.push(ln)
            }
        } else {
            blank_count = 0
            result.push(ln)
        }
    }

    result.join("\n")
}

// Convert spaces to tabs
func convert_spaces_to_tabs(source, tab_size) {
    const lines = source.split("\n")
    let result = []
    const spaces = " ".repeat(tab_size)

    for ln in lines {
        let new_line = ln
        // Only convert leading spaces
        let indent_end = 0
        while indent_end < len(ln) && ln[indent_end] == " " {
            indent_end = indent_end + 1
        }
        if indent_end > 0 {
            const indent = ln[0..indent_end]
            const rest = ln[indent_end..len(ln)]
            const tab_count = indent_end / tab_size
            const remainder = indent_end % tab_size
            new_line = "\t".repeat(tab_count) + " ".repeat(remainder) + rest
        }
        result.push(new_line)
    }

    result.join("\n")
}

// On-type formatting: auto-indent after { and dedent after }
func handle_on_type_formatting_full(params) {
    const uri = params["textDocument"]["uri"]
    const pos = params["position"]
    const ch = if params.has("ch") { params["ch"] } else { "" }
    const doc = lsp_get_document(uri)
    if doc == null { return [] }

    const source = doc["source"]
    const lines = source_lines(source)
    const line = pos["line"]

    if ch == "}" && line > 0 {
        // Find the matching { and use its indentation
        const current_line = if line < len(lines) { lines[line] } else { "" }
        let current_indent = 0
        while current_indent < len(current_line) && current_line[current_indent] == " " {
            current_indent = current_indent + 1
        }

        // Look for the matching opening brace
        let depth = 0
        let target_indent = 0
        let scan = line
        while scan >= 0 {
            const ln = lines[scan]
            let ci = len(ln) - 1
            while ci >= 0 {
                if ln[ci] == "}" { depth = depth + 1 }
                if ln[ci] == "{" {
                    depth = depth - 1
                    if depth == 0 {
                        // Found matching brace — compute its indent
                        let bi = 0
                        while bi < len(ln) && ln[bi] == " " { bi = bi + 1 }
                        target_indent = bi
                        break
                    }
                }
                ci = ci - 1
            }
            if depth == 0 { break }
            scan = scan - 1
        }

        if target_indent != current_indent {
            const new_indent = " ".repeat(target_indent)
            const rest = current_line.trim()
            return [lsp_text_edit(
                lsp_range(line, 0, line, len(current_line)),
                new_indent + rest
            )]
        }
    }

    []
}


// ══════════════════════════════════════════════════════════════════════
// ── Section 6: Diagnostics Integration ───────────────────────────────
// ══════════════════════════════════════════════════════════════════════
//
// After each document change, run type checker and linter,
// report errors and warnings as LSP diagnostics with proper ranges.

// Enhanced diagnostics with source position tracking
func compute_diagnostics_full(uri, text) {
    let diagnostics = []

    // Save parser state
    const save_tokens = p_tokens
    const save_pos = p_pos

    // Tokenize
    const tokens = tokenize(text)
    p_tokens = tokens
    p_pos = 0
    let program = null
    let parse_errors = []

    // Parse
    if len(tokens) > 0 {
        p_pos = 0
        program = parse_program()
    }

    // Restore parser state
    p_tokens = save_tokens
    p_pos = save_pos

    // Type check with position tracking
    if program != null {
        const save_errors = tc_errors
        const save_warnings = tc_warnings
        tc_errors = []
        tc_warnings = []

        check(program)

        for err in tc_errors {
            const pos_info = extract_position_from_error(err, text)
            diagnostics.push(lsp_diagnostic(
                lsp_range(pos_info["line"], pos_info["col"], pos_info["line"], pos_info["end_col"]),
                DIAG_ERROR,
                pos_info["message"],
                "magi",
                pos_info["code"]
            ))
        }
        for w in tc_warnings {
            const pos_info = extract_position_from_error(w, text)
            diagnostics.push(lsp_diagnostic(
                lsp_range(pos_info["line"], pos_info["col"], pos_info["line"], pos_info["end_col"]),
                DIAG_WARNING,
                pos_info["message"],
                "magi",
                pos_info["code"]
            ))
        }

        tc_errors = save_errors
        tc_warnings = save_warnings
    }

    // Lint
    if program != null {
        const lint_warnings = lint(program)
        for w in lint_warnings {
            const pos_info = extract_position_from_error(w, text)
            diagnostics.push(lsp_diagnostic(
                lsp_range(pos_info["line"], pos_info["col"], pos_info["line"], pos_info["end_col"]),
                DIAG_INFO,
                pos_info["message"],
                "magi-lint",
                null
            ))
        }
    }

    // Check for common issues not caught by type checker

    // 1. Duplicate function definitions
    if program != null {
        let func_names = {"__s": true}
        for stmt in program.statements {
            const sk = stmt.kind
            match sk {
                StmtKind::SFuncDef(fdef) => {
                    if func_names.has(fdef.name) && fdef.name != "__s" {
                        const sl = stmt.span.start_line - 1
                        const sc = stmt.span.start_col - 1
                        diagnostics.push(lsp_diagnostic(
                            lsp_range(sl, sc, sl, sc + len(fdef.name) + 5),
                            DIAG_ERROR,
                            f"Duplicate function definition '{fdef.name}'",
                            "magi",
                            "E100"
                        ))
                    }
                    func_names[fdef.name] = true
                },
                _ => {}
            }
        }
    }

    // 2. Unused imports
    if program != null {
        const lines = text.split("\n")
        for stmt in program.statements {
            const sk = stmt.kind
            match sk {
                StmtKind::SImport(module_path, _) => {
                    const sl = stmt.span.start_line - 1
                    const parts = module_path.split(".")
                    const mod_name = if len(parts) > 0 { parts[len(parts) - 1] } else { module_path }
                    // Simple check: does the module name appear elsewhere in the source?
                    let used = false
                    let li = 0
                    while li < len(lines) {
                        if li != sl && lines[li].contains(mod_name) {
                            used = true
                            break
                        }
                        li = li + 1
                    }
                    if !used {
                        const sc = stmt.span.start_col - 1
                        diagnostics.push(lsp_diagnostic(
                            lsp_range(sl, sc, sl, sc + len(module_path) + 7),
                            DIAG_HINT,
                            f"Unused import '{module_path}'",
                            "magi-lint",
                            "W100"
                        ))
                    }
                },
                _ => {}
            }
        }
    }

    // 3. Empty blocks
    if program != null {
        for stmt in program.statements {
            const sl = stmt.span.start_line - 1
            const sc = stmt.span.start_col - 1
            const sk = stmt.kind
            match sk {
                StmtKind::SFuncDef(fdef) => {
                    if fdef.body != null && len(fdef.body.statements) == 0 {
                        diagnostics.push(lsp_diagnostic(
                            lsp_range(sl, sc, sl, sc + len(fdef.name) + 5),
                            DIAG_INFO,
                            f"Function '{fdef.name}' has an empty body",
                            "magi-lint",
                            "W101"
                        ))
                    }
                },
                _ => {}
            }
        }
    }

    diagnostics
}

// Extract position information from error messages
// Error format might be: "line N col M: message" or just "message"
func extract_position_from_error(error_msg, source) {
    let line = 0
    let col = 0
    let end_col = 1
    let message = error_msg
    let code = null

    // Try to extract "line N" pattern
    if error_msg.contains("line ") {
        const line_idx = error_msg.index_of("line ")
        if line_idx >= 0 {
            const after = error_msg[line_idx + 5..len(error_msg)]
            let num_end = 0
            while num_end < len(after) && after[num_end] >= "0" && after[num_end] <= "9" {
                num_end = num_end + 1
            }
            if num_end > 0 {
                line = to_int(after[0..num_end]) - 1
                if line < 0 { line = 0 }
            }
        }
    }

    // Try to extract "col N" pattern
    if error_msg.contains("col ") {
        const col_idx = error_msg.index_of("col ")
        if col_idx >= 0 {
            const after = error_msg[col_idx + 4..len(error_msg)]
            let num_end = 0
            while num_end < len(after) && after[num_end] >= "0" && after[num_end] <= "9" {
                num_end = num_end + 1
            }
            if num_end > 0 {
                col = to_int(after[0..num_end]) - 1
                if col < 0 { col = 0 }
                end_col = col + 10
            }
        }
    }

    // Try to extract error code: E200, W100, etc.
    if len(error_msg) >= 4 {
        const first = error_msg[0]
        if (first == "E" || first == "W") && error_msg[1] >= "0" && error_msg[1] <= "9" {
            let code_end = 1
            while code_end < len(error_msg) && error_msg[code_end] >= "0" && error_msg[code_end] <= "9" {
                code_end = code_end + 1
            }
            code = error_msg[0..code_end]
            if code_end < len(error_msg) && error_msg[code_end] == ":" {
                message = error_msg[code_end + 1..len(error_msg)].trim()
            }
        }
    }

    // Clamp end_col to line length
    const lines = source.split("\n")
    if line < len(lines) {
        const line_len = len(lines[line])
        if end_col > line_len { end_col = line_len }
    }

    {"line": line, "col": col, "end_col": end_col, "message": message, "code": code}
}

// Enhanced document caching with full diagnostics
func lsp_cache_document_full(uri, text) {
    let program = null
    let diagnostics = []

    // Parse
    const save_tokens = p_tokens
    const save_pos = p_pos
    p_tokens = tokenize(text)
    p_pos = 0
    if len(p_tokens) > 0 {
        p_pos = 0
        program = parse_program()
    }
    p_tokens = save_tokens
    p_pos = save_pos

    // Compute full diagnostics
    diagnostics = compute_diagnostics_full(uri, text)

    lsp_documents[uri] = {
        "source": text,
        "program": program,
        "diagnostics": diagnostics,
        "version": 0
    }
    diagnostics
}


// ══════════════════════════════════════════════════════════════════════
// ── Section 7: Full Workspace Support ────────────────────────────────
// ══════════════════════════════════════════════════════════════════════
//
// Track all open documents, parse on change, cross-file symbol resolution.
// This section adds workspace-level operations.

// Workspace document version tracking
let lsp_document_versions = {"__s": true}

// Update document version
func update_document_version(uri, version) {
    lsp_document_versions[uri] = version
}

// Get document version
func get_document_version(uri) {
    if lsp_document_versions.has(uri) { lsp_document_versions[uri] } else { 0 }
}

// Workspace symbol index: name -> [{uri, line, col, kind}]
let lsp_symbol_index = {"__s": true}

// Rebuild symbol index for a document
func rebuild_symbol_index(uri) {
    const doc = lsp_get_document(uri)
    if doc == null { return }

    const symbols = collect_symbols(doc["program"])
    for sym in symbols {
        const name = sym["name"]
        if !lsp_symbol_index.has(name) || name == "__s" {
            lsp_symbol_index[name] = []
        }
        // Remove old entries for this URI
        let filtered = []
        for entry in lsp_symbol_index[name] {
            if entry["uri"] != uri {
                filtered.push(entry)
            }
        }
        filtered.push({
            "uri": uri,
            "line": sym["line"],
            "col": sym["col"],
            "kind": sym["kind"],
            "detail": sym["detail"]
        })
        lsp_symbol_index[name] = filtered
    }
}

// Cross-file go-to-definition using symbol index
func goto_definition_cross_file(uri, name) {
    // First check current document
    const doc = lsp_get_document(uri)
    if doc != null {
        const def = find_definition(doc["program"], name)
        if def != null {
            return lsp_location(uri, lsp_range(def["line"], def["col"], def["line"], def["col"] + len(name)))
        }
    }

    // Then check symbol index
    if lsp_symbol_index.has(name) && name != "__s" {
        const entries = lsp_symbol_index[name]
        if len(entries) > 0 {
            const entry = entries[0]  // First match
            return lsp_location(entry["uri"], lsp_range(entry["line"], entry["col"], entry["line"], entry["col"] + len(name)))
        }
    }

    null
}

// Cross-file find-all-references using symbol index
func find_all_references_cross_file(name) {
    let locations = []

    for uri in lsp_documents.keys() {
        if uri == "__s" { continue }
        const doc = lsp_documents[uri]
        if doc == null { continue }
        const refs = find_references(doc["program"], name)
        for r in refs {
            locations.push(lsp_location(uri, lsp_range(r["line"], r["col"], r["line"], r["col"] + len(name))))
        }
    }

    locations
}

// Workspace symbol search with scoring
func search_workspace_symbols(query) {
    let results = []
    const query_lower = query.to_lower()

    for uri in lsp_documents.keys() {
        if uri == "__s" { continue }
        const doc = lsp_documents[uri]
        if doc == null { continue }

        const symbols = collect_symbols(doc["program"])
        for sym in symbols {
            const name = sym["name"]
            const name_lower = name.to_lower()

            // Score: exact match > prefix > contains > fuzzy
            let score = 0
            if query == "" {
                score = 1
            } else if name_lower == query_lower {
                score = 100
            } else if name_lower.starts_with(query_lower) {
                score = 80
            } else if name_lower.contains(query_lower) {
                score = 50
            } else {
                const dist = levenshtein(query_lower, name_lower)
                if dist <= 3 {
                    score = 30 - dist * 5
                }
            }

            if score > 0 {
                results.push({
                    "name": name,
                    "kind": sym["kind"],
                    "location": lsp_location(uri, lsp_range(sym["line"], sym["col"], sym["end_line"], 0)),
                    "containerName": uri,
                    "score": score
                })
            }
        }
    }

    // Sort by score descending
    results = results.sort_by((a, b) => b["score"] - a["score"])

    // Remove score field from results
    let clean = []
    for r in results {
        clean.push({
            "name": r["name"],
            "kind": r["kind"],
            "location": r["location"],
            "containerName": r["containerName"]
        })
    }
    clean
}

// Enhanced workspace symbol handler
func handle_workspace_symbol_full(params) {
    const query = if params.has("query") { params["query"] } else { "" }
    const results = search_workspace_symbols(query)
    if len(results) == 0 { return null }
    results
}

// Handle workspace/didChangeWatchedFiles notification
func handle_did_change_watched_files(params) {
    if params == null || !params.has("changes") { return null }

    for change in params["changes"] {
        const uri = change["uri"]
        const change_type = change["type"]
        match change_type {
            1 => {
                // Created: could index new file
                send_log_message(MSG_INFO, f"File created: {uri}")
            },
            2 => {
                // Changed: re-index if it's a .magi file
                if uri.ends_with(".magi") {
                    send_log_message(MSG_INFO, f"File changed: {uri}")
                }
            },
            3 => {
                // Deleted: remove from index
                if lsp_documents.has(uri) {
                    lsp_documents[uri] = null
                }
                send_log_message(MSG_INFO, f"File deleted: {uri}")
            },
            _ => {}
        }
    }
    null
}

// Handle workspace/configuration request
func handle_workspace_configuration(params) {
    if params == null || !params.has("items") { return [] }

    let results = []
    for item in params["items"] {
        const section = if item.has("section") { item["section"] } else { "" }
        if section == "magi" || section == "" {
            results.push(lsp_config)
        } else {
            results.push(null)
        }
    }
    results
}


// ══════════════════════════════════════════════════════════════════════
// ── Section 8: JSON-RPC Infrastructure ───────────────────────────────
// ══════════════════════════════════════════════════════════════════════
//
// Full Content-Length header parsing, request ID tracking,
// notification handling, error responses, batching support.

// JSON-RPC error codes
const JSONRPC_PARSE_ERROR = -32700
const JSONRPC_INVALID_REQUEST = -32600
const JSONRPC_METHOD_NOT_FOUND = -32601
const JSONRPC_INVALID_PARAMS = -32602
const JSONRPC_INTERNAL_ERROR = -32603
const JSONRPC_SERVER_NOT_INITIALIZED = -32002
const JSONRPC_REQUEST_CANCELLED = -32800

// Server state
let lsp_initialized = false
let lsp_shutdown_requested = false
let lsp_request_counter = 0

// Track pending requests (for cancellation)
let lsp_pending_requests = {"__s": true}

// Read a full JSON-RPC message with proper Content-Length handling
func read_jsonrpc_message() {
    let content_length = -1
    let content_type = "application/vscode-jsonrpc; charset=utf-8"

    // Read headers until empty line
    while true {
        const line = input()
        if line == null { return null }  // EOF
        const trimmed = line.trim()
        if trimmed == "" { break }  // End of headers

        // Parse Content-Length
        if trimmed.starts_with("Content-Length:") {
            const value = trimmed[15..len(trimmed)].trim()
            content_length = to_int(value)
        }
        // Parse Content-Type (optional)
        if trimmed.starts_with("Content-Type:") {
            content_type = trimmed[13..len(trimmed)].trim()
        }
    }

    if content_length < 0 { return null }
    if content_length == 0 { return null }

    // Read the body (content_length bytes)
    const body = input()
    if body == null { return null }

    // Parse JSON
    const message = json_parse(body)
    if message == null {
        return {"error": "parse_error"}
    }

    message
}

// Write a JSON-RPC message with Content-Length header
func write_jsonrpc_message(message) {
    const body = json_encode(message)
    const header = "Content-Length: " + to_string(len(body)) + "\r\n\r\n"
    print(header + body)
}

// Send a JSON-RPC error response
func send_error_response(id, code, message) {
    write_jsonrpc_message(jsonrpc_error(id, code, message))
}

// Send a JSON-RPC success response
func send_success_response(id, result) {
    write_jsonrpc_message(jsonrpc_result(id, result))
}

// Send a notification (no id, no response expected)
func send_notification(method, params) {
    write_jsonrpc_message(jsonrpc_notification(method, params))
}

// Handle request cancellation
func handle_cancel_request(params) {
    if params != null && params.has("id") {
        const cancel_id = params["id"]
        if lsp_pending_requests.has(to_string(cancel_id)) {
            lsp_pending_requests[to_string(cancel_id)] = "cancelled"
        }
    }
    null
}

// Check if a request has been cancelled
func is_request_cancelled(id) {
    const key = to_string(id)
    if lsp_pending_requests.has(key) {
        return lsp_pending_requests[key] == "cancelled"
    }
    false
}

// Enhanced dispatch with full protocol support
func lsp_dispatch_full(method, params, id) {
    // Track request
    if id != null {
        lsp_pending_requests[to_string(id)] = "pending"
    }

    // Pre-initialization: only allow initialize
    if !lsp_initialized && method != "initialize" && method != "exit" {
        if id != null {
            return jsonrpc_error(id, JSONRPC_SERVER_NOT_INITIALIZED, "Server not initialized")
        }
        return null
    }

    // After shutdown: only allow exit
    if lsp_shutdown_requested && method != "exit" {
        if id != null {
            return jsonrpc_error(id, JSONRPC_INVALID_REQUEST, "Server is shutting down")
        }
        return null
    }

    const result = match method {
        // Lifecycle
        "initialize" => {
            const init_result = handle_initialize(params)
            lsp_initialized = true
            init_result
        },
        "initialized" => {
            handle_initialized(params)
            null
        },
        "shutdown" => {
            lsp_shutdown_requested = true
            null
        },
        "exit" => null,

        // Request cancellation
        "$/cancelRequest" => { handle_cancel_request(params); null },

        // Document sync
        "textDocument/didOpen" => {
            const td = params["textDocument"]
            const open_uri = td["uri"]
            const open_text = td["text"]
            const open_version = if td.has("version") { td["version"] } else { 0 }
            update_document_version(open_uri, open_version)
            const diags = lsp_cache_document_full(open_uri, open_text)
            rebuild_symbol_index(open_uri)
            send_notification("textDocument/publishDiagnostics", {
                "uri": open_uri, "diagnostics": diags
            })
            null
        },
        "textDocument/didChange" => {
            const change_uri = params["textDocument"]["uri"]
            const change_version = if params["textDocument"].has("version") { params["textDocument"]["version"] } else { 0 }
            const changes = params["contentChanges"]
            if len(changes) > 0 {
                const change_text = changes[len(changes) - 1]["text"]
                update_document_version(change_uri, change_version)
                const diags = lsp_cache_document_full(change_uri, change_text)
                rebuild_symbol_index(change_uri)
                send_notification("textDocument/publishDiagnostics", {
                    "uri": change_uri, "diagnostics": diags
                })
            }
            null
        },
        "textDocument/didClose" => {
            handle_did_close(params)
            null
        },
        "textDocument/didSave" => {
            handle_did_save(params)
            null
        },
        "textDocument/willSave" => { handle_will_save(params); null },

        // Language features — use full implementations
        "textDocument/completion" => handle_completion_full(params),
        "textDocument/hover" => handle_hover_full(params),
        "textDocument/definition" => {
            const def_uri = params["textDocument"]["uri"]
            const def_pos = params["position"]
            const def_doc = lsp_get_document(def_uri)
            if def_doc != null {
                const wi = word_at_position(def_doc["source"], def_pos["line"], def_pos["character"])
                if wi != null {
                    goto_definition_cross_file(def_uri, wi["word"])
                } else { null }
            } else { null }
        },
        "textDocument/typeDefinition" => handle_type_definition(params),
        "textDocument/references" => {
            const ref_uri = params["textDocument"]["uri"]
            const ref_pos = params["position"]
            const ref_doc = lsp_get_document(ref_uri)
            if ref_doc != null {
                const wi = word_at_position(ref_doc["source"], ref_pos["line"], ref_pos["character"])
                if wi != null {
                    find_all_references_cross_file(wi["word"])
                } else { null }
            } else { null }
        },
        "textDocument/rename" => handle_rename(params),
        "textDocument/prepareRename" => handle_prepare_rename(params),
        "textDocument/formatting" => handle_formatting_full(params),
        "textDocument/rangeFormatting" => handle_range_formatting_full(params),
        "textDocument/onTypeFormatting" => handle_on_type_formatting_full(params),
        "textDocument/codeAction" => handle_code_action_full(params),
        "textDocument/signatureHelp" => handle_signature_help(params),
        "textDocument/documentSymbol" => handle_document_symbol(params),
        "textDocument/semanticTokens/full" => handle_semantic_tokens_full_v2(params),
        "textDocument/foldingRange" => handle_folding_range(params),
        "textDocument/selectionRange" => handle_selection_range(params),
        "textDocument/codeLens" => handle_code_lens(params),
        "textDocument/inlayHint" => handle_inlay_hint(params),
        "textDocument/documentLink" => handle_document_link(params),
        "textDocument/linkedEditingRange" => handle_linked_editing_range(params),
        "textDocument/documentHighlight" => handle_document_highlight(params),
        "textDocument/documentColor" => handle_document_color(params),
        "textDocument/prepareCallHierarchy" => handle_prepare_call_hierarchy(params),
        "textDocument/prepareTypeHierarchy" => handle_prepare_type_hierarchy(params),

        // Call hierarchy
        "callHierarchy/incomingCalls" => handle_incoming_calls(params),
        "callHierarchy/outgoingCalls" => handle_outgoing_calls(params),

        // Type hierarchy
        "typeHierarchy/supertypes" => handle_type_hierarchy_supertypes(params),
        "typeHierarchy/subtypes" => handle_type_hierarchy_subtypes(params),

        // Workspace
        "workspace/symbol" => handle_workspace_symbol_full(params),
        "workspace/executeCommand" => handle_execute_command(params),
        "workspace/didChangeConfiguration" => { handle_configuration_changed(params); null },
        "workspace/didChangeWatchedFiles" => { handle_did_change_watched_files(params); null },
        "workspace/didChangeWorkspaceFolders" => { handle_workspace_folders_change(params); null },
        "workspace/configuration" => handle_workspace_configuration(params),

        // Resolve handlers
        "completionItem/resolve" => resolve_completion_item(params),
        "inlayHint/resolve" => resolve_inlay_hint(params),
        "codeLens/resolve" => resolve_code_lens(params),

        // Unrecognized
        _ => {
            if id != null {
                return jsonrpc_error(id, JSONRPC_METHOD_NOT_FOUND, f"Method not found: {method}")
            }
            null
        }
    }

    // Clean up pending request
    if id != null {
        const key = to_string(id)
        if lsp_pending_requests.has(key) {
            lsp_pending_requests[key] = "done"
        }
    }

    result
}

// Full server main loop with proper protocol handling
func run_lsp_server_full() {
    let running = true
    lsp_initialized = false
    lsp_shutdown_requested = false

    send_log_message(MSG_INFO, "MAGI LSP server starting (self-hosted)")

    while running {
        const message = read_jsonrpc_message()
        if message == null { break }

        // Handle parse error
        if typeof(message) == "map" && message.has("error") {
            send_error_response(null, JSONRPC_PARSE_ERROR, "Parse error")
            continue
        }

        const method = if message.has("method") { message["method"] } else { null }
        const id = if message.has("id") { message["id"] } else { null }
        const msg_params = if message.has("params") { message["params"] } else { null }

        // Validate JSON-RPC version
        if message.has("jsonrpc") && message["jsonrpc"] != "2.0" {
            if id != null {
                send_error_response(id, JSONRPC_INVALID_REQUEST, "Invalid JSON-RPC version")
            }
            continue
        }

        // Exit notification
        if method == "exit" {
            running = false
            continue
        }

        // Dispatch
        if method != null {
            const result = lsp_dispatch_full(method, msg_params, id)

            // Only send response for requests (has id), not notifications
            if id != null {
                if result != null && typeof(result) == "map" && result.has("error") {
                    // Error response already formed
                    write_jsonrpc_message(result)
                } else {
                    send_success_response(id, result)
                }
            }
        } else if id != null {
            // Request without method
            send_error_response(id, JSONRPC_INVALID_REQUEST, "Missing method")
        }

        lsp_request_counter = lsp_request_counter + 1
    }

    send_log_message(MSG_INFO, "MAGI LSP server shutting down")
}


