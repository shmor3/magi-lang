        methods.push({"label": "max_by", "kind": CIK_METHOD, "detail": "func max_by(fn: (item) -> value) -> value?", "documentation": "Max by key function"})
        methods.push({"label": "binary_search", "kind": CIK_METHOD, "detail": "func binary_search(value) -> int?", "documentation": "Searches sorted array"})
        methods.push({"label": "frequencies", "kind": CIK_METHOD, "detail": "func frequencies() -> map", "documentation": "Count occurrences of each element"})
    }

    if type_str == "map" || type_str == "Map" {
