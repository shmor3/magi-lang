        methods.push({"label": "is_empty", "kind": CIK_METHOD, "detail": "func is_empty() -> bool", "documentation": "Returns true if string is empty"})
        methods.push({"label": "count", "kind": CIK_METHOD, "detail": "func count(sub: string) -> int", "documentation": "Counts occurrences of substring"})
