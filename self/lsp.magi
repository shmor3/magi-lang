// ══════════════════════════════════════════════════════════════════════
// ── Full Definition (Jump to Definition) Across Files ───────────────
// ══════════════════════════════════════════════════════════════════════

// Multi-file import resolution: try to resolve imported names
func resolve_import_definition(program, name) {
    if program == null { return null }
    for stmt in program.statements {
        const sk = stmt.kind
        match sk {
            StmtKind::SImport(module_path, alias) => {
                // Check if the name matches the module or alias
                const parts = module_path.split(".")
                const last_part = if len(parts) > 0 { parts[len(parts) - 1] } else { module_path }
                const effective_name = if alias != null && alias != "" { alias } else { last_part }
                if effective_name == name {
                    return {
                        "module": module_path,
                        "name": name,
                        "kind": "import"
                    }
                }
            },
            _ => {}
        }
    }
    null
}

// Find definition in all open workspace documents
func find_definition_across_files(name) {
    for uri in lsp_documents.keys() {
        if uri == "__s" { continue }
        const doc = lsp_documents[uri]
        if doc == null { continue }
        const def = find_definition(doc["program"], name)
        if def != null {
            return {"uri": uri, "def": def}
        }
    }
    null
}

// ══════════════════════════════════════════════════════════════════════
// ── Full References (Find All Occurrences) Across Files ─────────────
// ══════════════════════════════════════════════════════════════════════

// Find references across all open documents
func find_references_across_files(name) {
    let all_refs = []
    for uri in lsp_documents.keys() {
        if uri == "__s" { continue }
        const doc = lsp_documents[uri]
        if doc == null { continue }
        const refs = find_references(doc["program"], name)
        for r in refs {
            all_refs.push({
                "uri": uri,
                "line": r["line"],
                "col": r["col"],
                "kind": r["kind"]
            })
        }
    }
    all_refs
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Rename (Across All Files) ──────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Validate a new name for renaming
func validate_rename(new_name) {
    if len(new_name) == 0 { return "Name cannot be empty" }
    // Check first character is letter or underscore
    const first = new_name[0]
    if !((first >= "a" && first <= "z") || (first >= "A" && first <= "Z") || first == "_") {
        return "Name must start with a letter or underscore"
    }
    // Check remaining characters
    let i = 1
    while i < len(new_name) {
        const c = new_name[i]
        if !is_ident_char(c) {
            return f"Invalid character '{c}' in name"
        }
        i = i + 1
    }
    // Check not a keyword
    if MAGI_KEYWORDS.contains(new_name) {
        return f"'{new_name}' is a reserved keyword"
    }
    null
}

// Rename across all open documents
func rename_across_files(old_name, new_name) {
    let changes = {"__s": true}
    for uri in lsp_documents.keys() {
        if uri == "__s" { continue }
        const doc = lsp_documents[uri]
        if doc == null { continue }
        const refs = find_references(doc["program"], old_name)
        if len(refs) > 0 {
            let edits = []
            for r in refs {
                edits.push(lsp_text_edit(
                    lsp_range(r["line"], r["col"], r["line"], r["col"] + len(old_name)),
                    new_name
                ))
            }
            changes[uri] = edits
        }
    }
    changes
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Semantic Tokens with Modifiers ─────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Semantic token modifier flags
const MOD_DECLARATION = 1
const MOD_DEFINITION = 2
const MOD_READONLY = 4
const MOD_STATIC = 8
const MOD_DEPRECATED = 16
const MOD_ABSTRACT = 32
const MOD_ASYNC = 64
const MOD_MODIFICATION = 128
const MOD_DOCUMENTATION = 256
const MOD_DEFAULT_LIBRARY = 512

// Classify an identifier with semantic information
func classify_identifier(tok_text, program) {
    // Check if it's a builtin
    if MAGI_BUILTINS.contains(tok_text) {
        return {"type": SEM_FUNCTION, "modifiers": MOD_DEFAULT_LIBRARY}
    }

    if program == null {
        return {"type": SEM_VARIABLE, "modifiers": 0}
    }

    // Check if it's a function definition
    for stmt in program.statements {
        const sk = stmt.kind
        match sk {
            StmtKind::SFuncDef(fdef) => {
                if fdef.name == tok_text {
                    return {"type": SEM_FUNCTION, "modifiers": MOD_DECLARATION}
                }
            },
            StmtKind::SAsyncFuncDef(fdef) => {
                if fdef.name == tok_text {
                    return {"type": SEM_FUNCTION, "modifiers": MOD_DECLARATION + MOD_ASYNC}
                }
            },
            StmtKind::SEnumDef(name, _, _) => {
                if name == tok_text {
                    return {"type": SEM_ENUM, "modifiers": MOD_DECLARATION}
                }
            },
            StmtKind::SStructDef(name, _, _) => {
                if name == tok_text {
                    return {"type": SEM_STRUCT, "modifiers": MOD_DECLARATION}
                }
            },
            StmtKind::SInterfaceDef(name, _, _) => {
                if name == tok_text {
                    return {"type": SEM_INTERFACE, "modifiers": MOD_DECLARATION}
                }
            },
            StmtKind::SConst(name, _) => {
                if name == tok_text {
                    return {"type": SEM_VARIABLE, "modifiers": MOD_READONLY + MOD_DECLARATION}
                }
            },
            StmtKind::SLet(name, _) => {
                if name == tok_text {
                    return {"type": SEM_VARIABLE, "modifiers": MOD_DECLARATION}
                }
            },
            StmtKind::SLetMut(name, _) => {
                if name == tok_text {
                    return {"type": SEM_VARIABLE, "modifiers": MOD_DECLARATION + MOD_MODIFICATION}
                }
            },
            _ => {}
        }
    }

    {"type": SEM_VARIABLE, "modifiers": 0}
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Code Actions ───────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Extract function from selected range
func make_extract_function_action(uri, range, source) {
    const start_line = range["start"]["line"]
    const end_line = range["end"]["line"]
    const lines = source.split("\n")

    let selected_lines = []
    let i = start_line
    while i <= end_line && i < len(lines) {
        selected_lines.push(lines[i])
        i = i + 1
    }
    const selected_text = selected_lines.join("\n")

    // Create a simple extract function refactoring
    const func_name = "extracted_function"
    const new_func = f"\nfunc {func_name}() {{\n{selected_text}\n}}\n"
    const call_text = f"{func_name}()"

    let edits = []
    // Replace selection with call
    edits.push(lsp_text_edit(range, call_text))
    // Insert function at end of file
    const last_line = len(lines) - 1
    const last_char = if last_line >= 0 { len(lines[last_line]) } else { 0 }
    edits.push(lsp_text_edit(lsp_range(last_line, last_char, last_line, last_char), new_func))

    {
        "title": "Extract function",
        "kind": "refactor.extract",
        "edit": {
            "changes": {uri: edits}
        }
    }
}

// Extract variable from expression
func make_extract_variable_action(uri, range, source, word) {
    let edits = []
    const var_name = "extracted"

    // Insert const declaration before the line
    const line = range["start"]["line"]
    const decl = f"const {var_name} = {word}\n"
    edits.push(lsp_text_edit(lsp_range(line, 0, line, 0), decl))

    // Replace expression with variable name
    edits.push(lsp_text_edit(range, var_name))

    {
        "title": "Extract variable",
        "kind": "refactor.extract",
        "edit": {
            "changes": {uri: edits}
        }
    }
}

// Inline variable action
func make_inline_variable_action(uri, program, source, var_name, line) {
    // Find the definition and its value
    let def_value = null
    let def_line = -1

    for stmt in program.statements {
        const sk = stmt.kind
        const sl = stmt.span.start_line - 1
        match sk {
            StmtKind::SConst(name, expr) => {
                if name == var_name {
                    def_value = get_expr_source_text(source, expr)
                    def_line = sl
                }
            },
            StmtKind::SLet(name, expr) => {
                if name == var_name {
                    def_value = get_expr_source_text(source, expr)
                    def_line = sl
                }
            },
            _ => {}
        }
    }

    if def_value == null { return null }

    // Find all references and replace with the value
    const refs = find_references(program, var_name)
    let edits = []
    for r in refs {
        if r["kind"] != "definition" {
            edits.push(lsp_text_edit(
                lsp_range(r["line"], r["col"], r["line"], r["col"] + len(var_name)),
                def_value
            ))
        }
    }

    // Remove the definition line
    const lines = source.split("\n")
    if def_line >= 0 && def_line < len(lines) {
        edits.push(lsp_text_edit(
            lsp_range(def_line, 0, def_line + 1, 0),
            ""
        ))
    }

    {
        "title": f"Inline variable '{var_name}'",
        "kind": "refactor.inline",
        "edit": {
            "changes": {uri: edits}
        }
    }
}

// Get source text for an expression (approximate by span)
func get_expr_source_text(source, expr) {
    if expr == null { return "" }
    const lines = source.split("\n")
    const line = expr.span.start_line - 1
    const col = expr.span.start_col - 1
    if line < len(lines) {
        // Extract from col to end of line (simple heuristic)
        const ln = lines[line]
        if col < len(ln) {
            return ln.substring(col, len(ln))
        }
    }
    ""
}

// Add missing import action
func make_add_import_action(uri, module_name, source) {
    const lines = source.split("\n")
    // Find the last import line
    let insert_line = 0
    let i = 0
    while i < len(lines) {
        const ln = lines[i].trim()
        if ln.starts_with("import ") || ln.starts_with("use ") {
            insert_line = i + 1
        }
        i = i + 1
    }

    let edits = [
        lsp_text_edit(lsp_range(insert_line, 0, insert_line, 0), f"import {module_name}\n")
    ]

    {
        "title": f"Add import '{module_name}'",
        "kind": "quickfix",
        "edit": {
            "changes": {uri: edits}
        }
    }
}

// Remove unused import action
func make_remove_unused_action(uri, source, line_num) {
    let edits = [
        lsp_text_edit(lsp_range(line_num, 0, line_num + 1, 0), "")
    ]

    {
        "title": "Remove unused import",
        "kind": "quickfix",
        "edit": {
            "changes": {uri: edits}
        }
    }
}

// Fix naming convention action
func make_fix_naming_action(uri, source, old_name, new_name, line, col) {
    let edits = [
        lsp_text_edit(
            lsp_range(line, col, line, col + len(old_name)),
            new_name
        )
    ]

    {
        "title": f"Rename to '{new_name}' (naming convention)",
        "kind": "quickfix",
        "edit": {
            "changes": {uri: edits}
        }
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Signature Help ─────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Get full signature information for a function
func get_full_signature(program, func_name) {
    if program == null { return null }

    // First check builtins
    if BUILTIN_SIGNATURES.has(func_name) {
        const sig = BUILTIN_SIGNATURES[func_name]
        return {
            "label": sig,
            "parameters": extract_param_labels(sig),
            "documentation": if BUILTIN_DOCS.has(func_name) { BUILTIN_DOCS[func_name] } else { "" }
        }
    }

    // Check user-defined functions
    for stmt in program.statements {
        const sk = stmt.kind
        match sk {
            StmtKind::SFuncDef(fdef) => {
                if fdef.name == func_name {
                    let param_strs = []
                    let param_labels = []
                    for p in fdef.params {
                        let pstr = p.name
                        if p.type_ann != "" {
                            pstr = p.name + ": " + p.type_ann
                        }
                        if p.rest {
                            pstr = "..." + p.name
                        }
                        param_strs.push(pstr)
                        param_labels.push({"label": pstr})
                    }
                    let ret = ""
                    if fdef.return_type != "" {
                        ret = " -> " + fdef.return_type
                    }
                    const label = f"func {func_name}({param_strs.join(', ')}){ret}"
                    return {
                        "label": label,
                        "parameters": param_labels,
                        "documentation": ""
                    }
                }
            },
            _ => {}
        }
    }
    null
}

// Extract parameter labels from a function signature string
func extract_param_labels(sig) {
    let labels = []
    // Find content between ( and )
    const paren_start = sig.index_of("(")
    const paren_end = sig.index_of(")")
    if paren_start < 0 || paren_end < 0 { return labels }

    const params_str = sig.substring(paren_start + 1, paren_end)
    if len(params_str.trim()) == 0 { return labels }

    const parts = params_str.split(",")
    for part in parts {
        labels.push({"label": part.trim()})
    }
    labels
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Document Symbols with Nested Symbols ───────────────────────
// ══════════════════════════════════════════════════════════════════════

// Collect symbols with children (nested symbols)
func collect_symbols_nested(program) {
    let symbols = []
    if program == null { return symbols }

    for stmt in program.statements {
        const sk = stmt.kind
        const line = stmt.span.start_line - 1
        const col = stmt.span.start_col - 1

        match sk {
            StmtKind::SFuncDef(fdef) => {
                let children = []
                // Collect local variables inside the function
                if fdef.body != null {
                    for s in fdef.body.statements {
                        const csk = s.kind
                        const cl = s.span.start_line - 1
                        const cc = s.span.start_col - 1
                        match csk {
                            StmtKind::SConst(name, _) => {
                                children.push({
                                    "name": name,
                                    "kind": SK_CONSTANT,
                                    "range": lsp_range(cl, cc, cl, cc + len(name)),
                                    "selectionRange": lsp_range(cl, cc, cl, cc + len(name))
                                })
                            },
                            StmtKind::SLet(name, _) => {
                                children.push({
                                    "name": name,
                                    "kind": SK_VARIABLE,
                                    "range": lsp_range(cl, cc, cl, cc + len(name)),
                                    "selectionRange": lsp_range(cl, cc, cl, cc + len(name))
                                })
                            },
                            StmtKind::SLetMut(name, _) => {
                                children.push({
                                    "name": name,
                                    "kind": SK_VARIABLE,
                                    "range": lsp_range(cl, cc, cl, cc + len(name)),
                                    "selectionRange": lsp_range(cl, cc, cl, cc + len(name))
                                })
                            },
                            _ => {}
                        }
                    }
                }

                let param_names = []
                for p in fdef.params { param_names.push(p.name) }
                let sym = {
                    "name": fdef.name,
                    "kind": SK_FUNCTION,
                    "range": lsp_range(line, col, line + 1, 0),
                    "selectionRange": lsp_range(line, col, line, col + len(fdef.name)),
                    "detail": "func " + fdef.name + "(" + param_names.join(", ") + ")"
                }
                if len(children) > 0 {
                    sym["children"] = children
                }
                symbols.push(sym)
            },
            StmtKind::SEnumDef(name, variants, _) => {
                let children = []
                let vi = 0
                for v in variants {
                    const vname = if typeof(v) == "string" { v } else { v[0] }
                    children.push({
                        "name": vname,
                        "kind": SK_ENUM_MEMBER,
                        "range": lsp_range(line + 1 + vi, col + 4, line + 1 + vi, col + 4 + len(vname)),
                        "selectionRange": lsp_range(line + 1 + vi, col + 4, line + 1 + vi, col + 4 + len(vname))
                    })
                    vi = vi + 1
                }
                symbols.push({
                    "name": name,
                    "kind": SK_ENUM,
                    "range": lsp_range(line, col, line + len(variants) + 1, 0),
                    "selectionRange": lsp_range(line, col, line, col + len(name)),
                    "detail": "enum " + name,
                    "children": children
                })
            },
            StmtKind::SStructDef(name, fields, _) => {
                let children = []
                let fi = 0
                for field in fields {
                    const fname = field[0]
                    children.push({
                        "name": fname,
                        "kind": SK_FIELD,
                        "range": lsp_range(line + 1 + fi, col + 4, line + 1 + fi, col + 4 + len(fname)),
                        "selectionRange": lsp_range(line + 1 + fi, col + 4, line + 1 + fi, col + 4 + len(fname))
                    })
                    fi = fi + 1
                }
                symbols.push({
                    "name": name,
                    "kind": SK_STRUCT,
                    "range": lsp_range(line, col, line + len(fields) + 1, 0),
                    "selectionRange": lsp_range(line, col, line, col + len(name)),
                    "detail": "struct " + name,
                    "children": children
                })
            },
            StmtKind::SInterfaceDef(name, methods, _) => {
                let children = []
                for m in methods {
                    const mname = to_string(m)
                    children.push({
                        "name": mname,
                        "kind": SK_METHOD,
                        "range": lsp_range(line + 1, col + 4, line + 1, col + 4 + len(mname)),
                        "selectionRange": lsp_range(line + 1, col + 4, line + 1, col + 4 + len(mname))
                    })
                }
                symbols.push({
                    "name": name,
                    "kind": SK_INTERFACE,
                    "range": lsp_range(line, col, line + len(methods) + 1, 0),
                    "selectionRange": lsp_range(line, col, line, col + len(name)),
                    "detail": "interface " + name,
                    "children": children
                })
            },
            StmtKind::SImplBlock(type_name, methods) => {
                let children = []
                for m in methods {
                    const mk = m.kind
                    match mk {
                        StmtKind::SFuncDef(fdef) => {
                            children.push({
                                "name": fdef.name,
                                "kind": SK_METHOD,
                                "range": lsp_range(m.span.start_line - 1, m.span.start_col - 1, m.span.start_line, 0),
                                "selectionRange": lsp_range(m.span.start_line - 1, m.span.start_col - 1, m.span.start_line - 1, m.span.start_col - 1 + len(fdef.name))
                            })
                        },
                        _ => {}
                    }
                }
                symbols.push({
                    "name": type_name,
                    "kind": SK_CLASS,
                    "range": lsp_range(line, col, line + len(methods) + 1, 0),
                    "selectionRange": lsp_range(line, col, line, col + len(type_name)),
                    "detail": "impl " + type_name,
                    "children": children
                })
            },
            StmtKind::SModuleDef(name, body) => {
                let children = []
                if body != null {
                    const inner = collect_symbols(body)
                    for s in inner { children.push(s) }
                }
                symbols.push({
                    "name": name,
                    "kind": SK_MODULE,
                    "range": lsp_range(line, col, line + 1, 0),
                    "selectionRange": lsp_range(line, col, line, col + len(name)),
                    "detail": "module " + name,
                    "children": children
                })
            },
            StmtKind::SConst(name, _) => {
                symbols.push({
                    "name": name,
                    "kind": SK_CONSTANT,
                    "range": lsp_range(line, col, line, col + len(name)),
                    "selectionRange": lsp_range(line, col, line, col + len(name)),
                    "detail": "const " + name
                })
            },
            StmtKind::SLet(name, _) => {
                symbols.push({
                    "name": name,
                    "kind": SK_VARIABLE,
                    "range": lsp_range(line, col, line, col + len(name)),
                    "selectionRange": lsp_range(line, col, line, col + len(name)),
                    "detail": "let " + name
                })
            },
            StmtKind::SLetMut(name, _) => {
                symbols.push({
                    "name": name,
                    "kind": SK_VARIABLE,
                    "range": lsp_range(line, col, line, col + len(name)),
                    "selectionRange": lsp_range(line, col, line, col + len(name)),
                    "detail": "let mut " + name
                })
            },
            StmtKind::STestDef(name, _) => {
                symbols.push({
                    "name": name,
                    "kind": SK_FUNCTION,
                    "range": lsp_range(line, col, line + 1, 0),
                    "selectionRange": lsp_range(line, col, line, col + len(name)),
                    "detail": "test " + name
                })
            },
            _ => {}
        }
    }
    symbols
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Folding Ranges ─────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Enhanced folding: also fold multi-line strings, arrays, maps
func compute_folding_ranges(source) {
    let ranges = []
    const lines = source.split("\n")

    let i = 0
    while i < len(lines) {
        const ln = lines[i].trim()

        // Multi-line comment blocks (// consecutive lines)
        if ln.starts_with("//") {
            const start = i
            let j = i + 1
            while j < len(lines) && lines[j].trim().starts_with("//") {
                j = j + 1
            }
            if j > start + 1 {
                ranges.push({
                    "startLine": start,
                    "endLine": j - 1,
                    "kind": FOLD_COMMENT
                })
            }
            i = j
            continue
        }

        // Import blocks
        if ln.starts_with("import ") || ln.starts_with("use ") {
            const start = i
            let j = i + 1
            while j < len(lines) {
                const next = lines[j].trim()
                if next.starts_with("import ") || next.starts_with("use ") {
                    j = j + 1
                } else {
                    break
                }
            }
            if j > start + 1 {
                ranges.push({
                    "startLine": start,
                    "endLine": j - 1,
                    "kind": FOLD_IMPORTS
                })
            }
            i = j
            continue
        }

        // Brace-delimited blocks (functions, structs, enums, etc.)
        if ln.ends_with("{") {
            const start = i
            let depth = 0
            let k = 0
            // Count opening braces in this line
            while k < len(lines[i]) {
                if lines[i][k] == "{" { depth = depth + 1 }
                if lines[i][k] == "}" { depth = depth - 1 }
                k = k + 1
            }
            let j = i + 1
            while j < len(lines) && depth > 0 {
                let k2 = 0
                while k2 < len(lines[j]) {
                    if lines[j][k2] == "{" { depth = depth + 1 }
                    if lines[j][k2] == "}" { depth = depth - 1 }
                    k2 = k2 + 1
                }
                if depth <= 0 {
                    if j > start + 1 {
                        ranges.push({
                            "startLine": start,
                            "endLine": j,
                            "kind": FOLD_REGION
                        })
                    }
                }
                j = j + 1
            }
        }

        // Multi-line array literals
        if ln.ends_with("[") && !ln.ends_with("//") {
            const start = i
            let depth = 0
            let k = 0
            while k < len(lines[i]) {
                if lines[i][k] == "[" { depth = depth + 1 }
                if lines[i][k] == "]" { depth = depth - 1 }
                k = k + 1
            }
            let j = i + 1
            while j < len(lines) && depth > 0 {
                let k2 = 0
                while k2 < len(lines[j]) {
                    if lines[j][k2] == "[" { depth = depth + 1 }
                    if lines[j][k2] == "]" { depth = depth - 1 }
                    k2 = k2 + 1
                }
                j = j + 1
            }
            if j - 1 > start + 1 {
                ranges.push({
                    "startLine": start,
                    "endLine": j - 1,
                    "kind": FOLD_REGION
                })
            }
        }

        i = i + 1
    }

    ranges
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Code Lens ──────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Count tests in a document
func count_tests(program) {
    let count = 0
    if program == null { return count }
    for stmt in program.statements {
        const sk = stmt.kind
        match sk {
            StmtKind::STestDef(_, _) => { count = count + 1 },
            StmtKind::SFuncDef(fdef) => {
                if fdef.name.starts_with("test_") { count = count + 1 }
            },
            _ => {}
        }
    }
    count
}

// Get test names
func collect_test_names(program) {
    let names = []
    if program == null { return names }
    for stmt in program.statements {
        const sk = stmt.kind
        match sk {
            StmtKind::STestDef(name, _) => { names.push(name) },
            StmtKind::SFuncDef(fdef) => {
                if fdef.name.starts_with("test_") { names.push(fdef.name) }
            },
            _ => {}
        }
    }
    names
}

// Enhanced code lens with test runner and implementation count
func compute_code_lenses(uri, program) {
    let lenses = []
    if program == null { return lenses }

    const symbols = collect_symbols(program)
    const test_count = count_tests(program)

    // File-level test count lens
    if test_count > 0 {
        lenses.push({
            "range": lsp_range(0, 0, 0, 0),
            "command": {
                "title": f"{test_count} test(s) in file",
                "command": "magi.runTests",
                "arguments": [uri]
            }
        })
    }

    for sym in symbols {
        const name = sym["name"]
        const sl = sym["line"]
        const sc = sym["col"]
        const name_end = sc + len(name)

        if sym["kind"] == SK_FUNCTION {
            // Reference count
            const refs = find_references(program, name)
            const ref_count = len(refs) - 1

            lenses.push({
                "range": lsp_range(sl, sc, sl, name_end),
                "command": {
                    "title": f"{ref_count} reference(s)",
                    "command": "magi.showReferences",
                    "arguments": [uri, sl, sc]
                }
            })

            // Run lens for test functions
            if name == "main" || name.starts_with("test_") {
                lenses.push({
                    "range": lsp_range(sl, sc, sl, name_end),
                    "command": {
                        "title": if name == "main" { "Run" } else { "Run Test" },
                        "command": if name == "main" { "magi.run" } else { "magi.runTest" },
                        "arguments": [uri, name]
                    }
                })
            }
        }

        // Struct: show implementation count
        if sym["kind"] == SK_STRUCT {
            let impl_count = 0
            for s in program.statements {
                const sk2 = s.kind
                match sk2 {
                    StmtKind::SImplBlock(type_name, _) => {
                        if type_name == name { impl_count = impl_count + 1 }
                    },
                    _ => {}
                }
            }
            if impl_count > 0 {
                lenses.push({
                    "range": lsp_range(sl, sc, sl, name_end),
                    "command": {
                        "title": f"{impl_count} implementation(s)",
                        "command": "magi.showImplementations",
                        "arguments": [uri, name]
                    }
                })
            }
        }

        // Interface: show implementors
        if sym["kind"] == SK_INTERFACE {
            lenses.push({
                "range": lsp_range(sl, sc, sl, name_end),
                "command": {
                    "title": "Show implementors",
                    "command": "magi.showImplementors",
                    "arguments": [uri, name]
                }
            })
        }
    }

    lenses
}

// ══════════════════════════════════════════════════════════════════════
// ── Full Inlay Hints ────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Inlay hint kinds
const INLAY_TYPE = 1
const INLAY_PARAMETER = 2

// Compute inlay hints for a document
func compute_inlay_hints(program, source, range) {
    let hints = []
    if program == null { return hints }

    const start_line = range["start"]["line"]
    const end_line = range["end"]["line"]

    for stmt in program.statements {
        const sl = stmt.span.start_line - 1
        if sl < start_line || sl > end_line { continue }

        const sk = stmt.kind
        match sk {
            // Variable type hints (infer and show type after variable name)
            StmtKind::SConst(name, expr) => {
                let type_info = infer_simple_type(expr)
                if type_info != "unknown" {
                    const col = stmt.span.start_col - 1 + 6 + len(name) // after "const name"
                    hints.push({
                        "position": lsp_position(sl, col),
                        "label": f": {type_info}",
                        "kind": INLAY_TYPE,
                        "paddingLeft": false,
                        "paddingRight": true
                    })
                }
            },
            StmtKind::SLet(name, expr) => {
                let type_info = infer_simple_type(expr)
                if type_info != "unknown" {
                    const col = stmt.span.start_col - 1 + 4 + len(name) // after "let name"
                    hints.push({
                        "position": lsp_position(sl, col),
                        "label": f": {type_info}",
                        "kind": INLAY_TYPE,
                        "paddingLeft": false,
                        "paddingRight": true
                    })
                }
            },
            StmtKind::SLetMut(name, expr) => {
                let type_info = infer_simple_type(expr)
                if type_info != "unknown" {
                    const col = stmt.span.start_col - 1 + 4 + len(name) // after "let name"
                    hints.push({
                        "position": lsp_position(sl, col),
                        "label": f": {type_info}",
                        "kind": INLAY_TYPE,
                        "paddingLeft": false,
                        "paddingRight": true
                    })
                }
            },
            // Parameter name hints at call sites
            StmtKind::SExprStmt(expr) => {
                hints = collect_call_param_hints(hints, expr, program)
            },
            _ => {}
        }

        // Check return type hints for function definitions
        match sk {
            StmtKind::SFuncDef(fdef) => {
                if fdef.return_type == "" {
                    // Try to infer return type
                    let inferred = infer_function_return_type(fdef)
                    if inferred != "unknown" {
                        let param_strs = []
                        for p in fdef.params { param_strs.push(p.name) }
                        const paren_end = stmt.span.start_col - 1 + 5 + len(fdef.name) + len(param_strs.join(", ")) + 2
                        hints.push({
                            "position": lsp_position(sl, paren_end),
                            "label": f" -> {inferred}",
                            "kind": INLAY_TYPE,
                            "paddingLeft": true,
                            "paddingRight": false
                        })
                    }
                }
            },
            _ => {}
        }
    }

    hints
}

// Collect parameter name hints for function calls
func collect_call_param_hints(hints, expr, program) {
    if expr == null { return hints }
    const ek = expr.kind
    match ek {
        ExprKind::ECall(func_name, args, _) => {
            // Look up function definition to get param names
            let fdef = null
            for stmt in program.statements {
                const sk = stmt.kind
                match sk {
                    StmtKind::SFuncDef(fd) => {
                        if fd.name == func_name { fdef = fd }
                    },
                    _ => {}
                }
            }

            if fdef != null && args != null {
                let i = 0
                while i < len(args) && i < len(fdef.params) {
                    const param_name = fdef.params[i].name
                    const arg = args[i]
                    // Only show hint if arg is not a simple variable with same name
                    let show_hint = true
                    const ak = arg.kind
                    match ak {
                        ExprKind::EVariable(vname) => {
                            if vname == param_name { show_hint = false }
                        },
                        _ => {}
                    }

                    if show_hint {
                        const al = arg.span.start_line - 1
                        const ac = arg.span.start_col - 1
                        hints.push({
                            "position": lsp_position(al, ac),
                            "label": f"{param_name}: ",
                            "kind": INLAY_PARAMETER,
                            "paddingLeft": false,
                            "paddingRight": false
                        })
                    }
                    i = i + 1
                }
            }

            // Recurse into arguments
            if args != null {
                for arg in args {
                    hints = collect_call_param_hints(hints, arg, program)
                }
            }
        },
        ExprKind::EMethodCall(obj, _, args, _) => {
            hints = collect_call_param_hints(hints, obj, program)
            if args != null {
                for arg in args {
                    hints = collect_call_param_hints(hints, arg, program)
                }
            }
        },
        ExprKind::EBinaryOp(_, left, right) => {
            hints = collect_call_param_hints(hints, left, program)
            hints = collect_call_param_hints(hints, right, program)
        },
        ExprKind::EUnaryOp(_, operand) => {
            hints = collect_call_param_hints(hints, operand, program)
        },
        _ => {}
    }
    hints
}

// Infer function return type from body (simple heuristic)
func infer_function_return_type(fdef) {
    if fdef.body == null { return "unknown" }
    const stmts = fdef.body.statements
    if len(stmts) == 0 { return "unknown" }

    // Check last statement or explicit returns
    let last = stmts[len(stmts) - 1]
    const sk = last.kind
    match sk {
        StmtKind::SReturn(expr) => {
            if expr != null { return infer_simple_type(expr) }
            "void"
        },
        StmtKind::SExprStmt(expr) => {
            infer_simple_type(expr)
        },
        _ => "unknown"
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Document Highlight ──────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Document highlight kinds
const HIGHLIGHT_TEXT = 1
const HIGHLIGHT_READ = 2
const HIGHLIGHT_WRITE = 3

// Compute highlights for all occurrences of a symbol
func compute_highlights(program, source, name) {
    let highlights = []
    if program == null { return highlights }

    const refs = find_references(program, name)
    for r in refs {
        const kind = match r["kind"] {
            "definition" => HIGHLIGHT_WRITE,
            "assignment" => HIGHLIGHT_WRITE,
            _ => HIGHLIGHT_READ
        }
        highlights.push({
            "range": lsp_range(r["line"], r["col"], r["line"], r["col"] + len(name)),
            "kind": kind
        })
    }
    highlights
}

// ══════════════════════════════════════════════════════════════════════
// ── Document Link ───────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Find import links in source
func compute_document_links(source) {
    let links = []
    const lines = source.split("\n")
    let i = 0
    while i < len(lines) {
        const ln = lines[i].trim()
        if ln.starts_with("import ") {
            const module_path = ln.substring(7, len(ln)).trim()
            // Convert module path to a hypothetical file URI
            const parts = module_path.split(".")
            if len(parts) > 0 {
                const start_col = lines[i].index_of(module_path)
                if start_col >= 0 {
                    links.push({
                        "range": lsp_range(i, start_col, i, start_col + len(module_path)),
                        "tooltip": f"Go to module {module_path}"
                    })
                }
            }
        }
        i = i + 1
    }
    links
}

// ══════════════════════════════════════════════════════════════════════
// ── Linked Editing Range ────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Get linked editing ranges (e.g., rename all occurrences at once)
func compute_linked_editing_ranges(program, source, name) {
    let ranges = []
    if program == null { return ranges }

    const refs = find_references(program, name)
    for r in refs {
        ranges.push(lsp_range(r["line"], r["col"], r["line"], r["col"] + len(name)))
    }

    if len(ranges) == 0 { return null }
    {"ranges": ranges}
}

// ══════════════════════════════════════════════════════════════════════
// ── Document Color ──────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Parse color literals from source (e.g., "#FF0000", "rgb(255,0,0)")
func compute_document_colors(source) {
    let colors = []
    const lines = source.split("\n")
    let i = 0
    while i < len(lines) {
        const ln = lines[i]
        // Find hex color literals: "#RRGGBB"
        let j = 0
        while j < len(ln) - 6 {
            if ln[j] == "#" {
                let valid = true
                let k = 1
                while k <= 6 && valid {
                    const c = ln[j + k]
                    if !((c >= "0" && c <= "9") || (c >= "a" && c <= "f") || (c >= "A" && c <= "F")) {
                        valid = false
                    }
                    k = k + 1
                }
                if valid && (j + 7 >= len(ln) || !is_ident_char(ln[j + 7])) {
                    const hex = ln.substring(j + 1, j + 7)
                    const r = hex_to_int(hex.substring(0, 2))
                    const g = hex_to_int(hex.substring(2, 4))
                    const b = hex_to_int(hex.substring(4, 6))
                    colors.push({
                        "range": lsp_range(i, j, i, j + 7),
                        "color": {
                            "red": r / 255.0,
                            "green": g / 255.0,
                            "blue": b / 255.0,
                            "alpha": 1.0
                        }
                    })
                    j = j + 7
                    continue
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    colors
}

// Simple hex-to-int conversion
func hex_to_int(hex_str) {
    let result = 0
    for c in hex_str.chars() {
        result = result * 16
        if c >= "0" && c <= "9" { result = result + (char_code(c) - char_code("0")) }
        else if c >= "a" && c <= "f" { result = result + 10 + (char_code(c) - char_code("a")) }
        else if c >= "A" && c <= "F" { result = result + 10 + (char_code(c) - char_code("A")) }
    }
    result
}

// ══════════════════════════════════════════════════════════════════════
// ── Call Hierarchy ──────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Prepare call hierarchy item at position
func prepare_call_hierarchy(program, source, name, uri) {
    if program == null { return null }
    const def = find_definition(program, name)
    if def == null { return null }
    if def["kind"] != "function" { return null }

    [{
        "name": name,
        "kind": SK_FUNCTION,
        "uri": uri,
        "range": lsp_range(def["line"], def["col"], def["line"] + 1, 0),
        "selectionRange": lsp_range(def["line"], def["col"], def["line"], def["col"] + len(name))
    }]
}

// Find all callers of a function (incoming calls)
func find_incoming_calls(program, target_name, uri) {
    let calls = []
    if program == null { return calls }

    for stmt in program.statements {
        const sk = stmt.kind
        match sk {
            StmtKind::SFuncDef(fdef) => {
                // Check if fdef's body calls target_name
                if fdef.body != null {
                    let found = false
                    for s in fdef.body.statements {
                        if stmt_calls_function(s, target_name) {
                            found = true
                        }
                    }
                    if found {
                        const sl = stmt.span.start_line - 1
                        const sc = stmt.span.start_col - 1
                        calls.push({
                            "from": {
                                "name": fdef.name,
                                "kind": SK_FUNCTION,
                                "uri": uri,
                                "range": lsp_range(sl, sc, sl + 1, 0),
                                "selectionRange": lsp_range(sl, sc, sl, sc + len(fdef.name))
                            },
                            "fromRanges": [lsp_range(sl, sc, sl, sc + len(fdef.name))]
                        })
                    }
                }
            },
            _ => {}
        }
    }
    calls
}

// Check if a statement calls a specific function
func stmt_calls_function(stmt, func_name) {
    const sk = stmt.kind
    match sk {
        StmtKind::SExprStmt(expr) => expr_calls_function(expr, func_name),
        StmtKind::SReturn(expr) => {
            if expr != null { expr_calls_function(expr, func_name) } else { false }
        },
        StmtKind::SConst(_, expr) => {
            if expr != null { expr_calls_function(expr, func_name) } else { false }
        },
        StmtKind::SLet(_, expr) => {
            if expr != null { expr_calls_function(expr, func_name) } else { false }
        },
        StmtKind::SLetMut(_, expr) => {
            if expr != null { expr_calls_function(expr, func_name) } else { false }
        },
        _ => false
    }
}

// Check if an expression calls a specific function
func expr_calls_function(expr, func_name) {
    if expr == null { return false }
    const ek = expr.kind
    match ek {
        ExprKind::ECall(name, args, _) => {
            if name == func_name { return true }
            if args != null {
                for arg in args {
                    if expr_calls_function(arg, func_name) { return true }
                }
            }
            false
        },
        ExprKind::EMethodCall(obj, _, args, _) => {
            if expr_calls_function(obj, func_name) { return true }
            if args != null {
                for arg in args {
                    if expr_calls_function(arg, func_name) { return true }
                }
            }
            false
        },
        ExprKind::EBinaryOp(_, left, right) => {
            expr_calls_function(left, func_name) || expr_calls_function(right, func_name)
        },
        ExprKind::EUnaryOp(_, operand) => {
            expr_calls_function(operand, func_name)
        },
        _ => false
    }
}

// Find all functions called by a function (outgoing calls)
func find_outgoing_calls(program, source_name, uri) {
    let calls = []
    if program == null { return calls }

    // Find the function definition
    let target_body = null
    for stmt in program.statements {
        const sk = stmt.kind
        match sk {
            StmtKind::SFuncDef(fdef) => {
                if fdef.name == source_name {
                    target_body = fdef.body
                }
            },
            _ => {}
        }
    }

    if target_body == null { return calls }

    // Collect all function calls in the body
    let called_names = {"__s": true}
    for s in target_body.statements {
        collect_called_functions(s, called_names)
    }

    // Create call hierarchy items for each called function
    for name in called_names.keys() {
        if name == "__s" { continue }
        const def = find_definition(program, name)
        if def != null {
            calls.push({
                "to": {
                    "name": name,
                    "kind": SK_FUNCTION,
                    "uri": uri,
                    "range": lsp_range(def["line"], def["col"], def["line"] + 1, 0),
                    "selectionRange": lsp_range(def["line"], def["col"], def["line"], def["col"] + len(name))
                },
                "fromRanges": [lsp_range(def["line"], def["col"], def["line"], def["col"] + len(name))]
            })
        }
    }
    calls
}

// Collect all function names called in a statement
func collect_called_functions(stmt, names) {
    const sk = stmt.kind
    match sk {
        StmtKind::SExprStmt(expr) => { collect_calls_in_expr(expr, names) },
        StmtKind::SReturn(expr) => { if expr != null { collect_calls_in_expr(expr, names) } },
        StmtKind::SConst(_, expr) => { if expr != null { collect_calls_in_expr(expr, names) } },
        StmtKind::SLet(_, expr) => { if expr != null { collect_calls_in_expr(expr, names) } },
        StmtKind::SLetMut(_, expr) => { if expr != null { collect_calls_in_expr(expr, names) } },
        StmtKind::SAssignment(_, expr) => { if expr != null { collect_calls_in_expr(expr, names) } },
        StmtKind::SIf(cond, then_b, else_b) => {
            collect_calls_in_expr(cond, names)
            if then_b != null {
                for s in then_b.statements { collect_called_functions(s, names) }
            }
            if else_b != null {
                for s in else_b.statements { collect_called_functions(s, names) }
            }
        },
        StmtKind::SWhileLoop(_, cond, body) => {
            collect_calls_in_expr(cond, names)
            if body != null {
                for s in body.statements { collect_called_functions(s, names) }
            }
        },
        StmtKind::SForLoop(_, _, iter, body) => {
            collect_calls_in_expr(iter, names)
            if body != null {
                for s in body.statements { collect_called_functions(s, names) }
            }
        },
        _ => {}
    }
}

// Collect function call names from expressions
func collect_calls_in_expr(expr, names) {
    if expr == null { return }
    const ek = expr.kind
    match ek {
        ExprKind::ECall(name, args, _) => {
            names[name] = true
            if args != null {
                for arg in args { collect_calls_in_expr(arg, names) }
            }
        },
        ExprKind::EMethodCall(obj, method, args, _) => {
            collect_calls_in_expr(obj, names)
            if args != null {
                for arg in args { collect_calls_in_expr(arg, names) }
            }
        },
        ExprKind::EBinaryOp(_, left, right) => {
            collect_calls_in_expr(left, names)
            collect_calls_in_expr(right, names)
        },
        ExprKind::EUnaryOp(_, operand) => {
            collect_calls_in_expr(operand, names)
        },
        ExprKind::EIndex(obj, idx) => {
            collect_calls_in_expr(obj, names)
            collect_calls_in_expr(idx, names)
        },
        ExprKind::EFieldAccess(obj, _) => {
            collect_calls_in_expr(obj, names)
        },
        ExprKind::EIf(cond, then_e, else_e) => {
            collect_calls_in_expr(cond, names)
            collect_calls_in_expr(then_e, names)
            if else_e != null { collect_calls_in_expr(else_e, names) }
        },
        ExprKind::EArrayLiteral(elements) => {
            for e in elements { collect_calls_in_expr(e, names) }
        },
        ExprKind::EMapLiteral(entries) => {
            for entry in entries {
                collect_calls_in_expr(entry[0], names)
                collect_calls_in_expr(entry[1], names)
            }
        },
        _ => {}
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Type Hierarchy ──────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Prepare type hierarchy item
func prepare_type_hierarchy(program, name, uri) {
    if program == null { return null }

    for stmt in program.statements {
        const sk = stmt.kind
        const sl = stmt.span.start_line - 1
        const sc = stmt.span.start_col - 1
        match sk {
            StmtKind::SStructDef(sname, _, _) => {
                if sname == name {
                    return [{
                        "name": name,
                        "kind": SK_STRUCT,
                        "uri": uri,
                        "range": lsp_range(sl, sc, sl + 1, 0),
                        "selectionRange": lsp_range(sl, sc, sl, sc + len(name))
                    }]
                }
            },
            StmtKind::SEnumDef(ename, _, _) => {
                if ename == name {
                    return [{
                        "name": name,
                        "kind": SK_ENUM,
                        "uri": uri,
                        "range": lsp_range(sl, sc, sl + 1, 0),
                        "selectionRange": lsp_range(sl, sc, sl, sc + len(name))
                    }]
                }
            },
            StmtKind::SInterfaceDef(iname, _, _) => {
                if iname == name {
                    return [{
                        "name": name,
                        "kind": SK_INTERFACE,
                        "uri": uri,
                        "range": lsp_range(sl, sc, sl + 1, 0),
                        "selectionRange": lsp_range(sl, sc, sl, sc + len(name))
                    }]
                }
            },
            _ => {}
        }
    }
    null
}

// Find supertypes (interfaces that a type implements)
func find_supertypes(program, type_name, uri) {
    let supertypes = []
    if program == null { return supertypes }

    for stmt in program.statements {
        const sk = stmt.kind
        match sk {
            StmtKind::SImplBlock(tname, _) => {
                // In MAGI, impl blocks can specify interfaces
                // For now, we can't distinguish which interface is being implemented
                // without more AST information
            },
            _ => {}
        }
    }
    supertypes
}

// Find subtypes (types that implement an interface)
func find_subtypes(program, interface_name, uri) {
    let subtypes = []
    if program == null { return subtypes }

    // Find all structs that have impl blocks
    for stmt in program.statements {
        const sk = stmt.kind
        match sk {
            StmtKind::SStructDef(sname, _, _) => {
                // Check if this struct has methods that match the interface
                let has_impl = false
                for s2 in program.statements {
                    const sk2 = s2.kind
                    match sk2 {
                        StmtKind::SImplBlock(tname, _) => {
                            if tname == sname { has_impl = true }
                        },
                        _ => {}
                    }
                }
                if has_impl {
                    const sl = stmt.span.start_line - 1
                    const sc = stmt.span.start_col - 1
                    subtypes.push({
                        "name": sname,
                        "kind": SK_STRUCT,
                        "uri": uri,
                        "range": lsp_range(sl, sc, sl + 1, 0),
                        "selectionRange": lsp_range(sl, sc, sl, sc + len(sname))
                    })
                }
            },
            _ => {}
        }
    }
    subtypes
}

// ══════════════════════════════════════════════════════════════════════
// ── Workspace Symbol Search ─────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Search for symbols across all open documents
func workspace_symbol_search(query) {
    let results = []
    for uri in lsp_documents.keys() {
        if uri == "__s" { continue }
        const doc = lsp_documents[uri]
        if doc == null { continue }
        const symbols = collect_symbols(doc["program"])
        for sym in symbols {
            // Fuzzy match: check if query is a substring of symbol name
            if query == "" || sym["name"].contains(query) {
                results.push({
                    "name": sym["name"],
                    "kind": sym["kind"],
                    "location": lsp_location(uri, lsp_range(sym["line"], sym["col"], sym["end_line"], 0))
                })
            }
        }
    }
    results
}

// ══════════════════════════════════════════════════════════════════════
// ── Execute Command ─────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Execute a workspace command
func execute_command(command, arguments) {
    match command {
        "magi.run" => {
            if arguments != null && len(arguments) > 0 {
                const uri = arguments[0]
                const doc = lsp_get_document(uri)
                if doc != null && doc["program"] != null {
                    // We would run the program here
                    return {"status": "ok", "message": "Program execution requested"}
                }
            }
            {"status": "error", "message": "No document to run"}
        },
        "magi.check" => {
            if arguments != null && len(arguments) > 0 {
                const uri = arguments[0]
                const doc = lsp_get_document(uri)
                if doc != null {
                    return {"status": "ok", "diagnostics": doc["diagnostics"]}
                }
            }
            {"status": "error", "message": "No document to check"}
        },
        "magi.lint" => {
            if arguments != null && len(arguments) > 0 {
                const uri = arguments[0]
                const doc = lsp_get_document(uri)
                if doc != null && doc["program"] != null {
                    const warnings = lint(doc["program"])
                    return {"status": "ok", "warnings": warnings}
                }
            }
            {"status": "error", "message": "No document to lint"}
        },
        "magi.format" => {
            if arguments != null && len(arguments) > 0 {
                const uri = arguments[0]
                const doc = lsp_get_document(uri)
                if doc != null && doc["program"] != null {
                    const formatted = format_program(doc["program"])
                    return {"status": "ok", "formatted": formatted}
                }
            }
            {"status": "error", "message": "No document to format"}
        },
        "magi.runTest" => {
            if arguments != null && len(arguments) > 1 {
                const uri = arguments[0]
                const test_name = arguments[1]
                return {"status": "ok", "message": f"Test '{test_name}' execution requested"}
            }
            {"status": "error", "message": "No test specified"}
        },
        "magi.runTests" => {
            if arguments != null && len(arguments) > 0 {
                const uri = arguments[0]
                const doc = lsp_get_document(uri)
                if doc != null {
                    const test_names = collect_test_names(doc["program"])
                    return {"status": "ok", "tests": test_names, "count": len(test_names)}
                }
            }
            {"status": "error", "message": "No document"}
        },
        _ => {"status": "error", "message": f"Unknown command: {command}"}
    }
}

// ══════════════════════════════════════════════════════════════════════
// ── Diagnostics Publishing ──────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Enhanced diagnostics with lint integration
func compute_diagnostics(uri, text) {
    let diagnostics = []

    // Save parser state
    const save_tokens = p_tokens
    const save_pos = p_pos

    // Tokenize and parse
    p_tokens = tokenize(text)
    p_pos = 0
    let program = null

    if len(p_tokens) > 0 {
        p_pos = 0
        program = parse_program()
    }

    // Restore parser state
    p_tokens = save_tokens
    p_pos = save_pos

    // Type check
    if program != null {
        const save_errors = tc_errors
        const save_warnings = tc_warnings
        tc_errors = []
        tc_warnings = []

        check(program)

        for err in tc_errors {
            diagnostics.push(lsp_diagnostic(
                lsp_range(0, 0, 0, 1),
                DIAG_ERROR,
                err,
                "magi-type-checker",
                null
            ))
        }
        for w in tc_warnings {
            diagnostics.push(lsp_diagnostic(
                lsp_range(0, 0, 0, 1),
                DIAG_WARNING,
                w,
                "magi-type-checker",
                null
            ))
        }

        tc_errors = save_errors
        tc_warnings = save_warnings
    }

    // Lint
    if program != null {
        const lint_warnings = lint(program)
        for w in lint_warnings {
            diagnostics.push(lsp_diagnostic(
                lsp_range(0, 0, 0, 1),
                DIAG_INFO,
                w,
                "magi-linter",
                null
            ))
        }
    }

    diagnostics
}

// Publish diagnostics notification
func make_publish_diagnostics(uri, diagnostics) {
    jsonrpc_notification("textDocument/publishDiagnostics", {
        "uri": uri,
        "diagnostics": diagnostics
    })
}

// ══════════════════════════════════════════════════════════════════════
// ── Color Presentation ──────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Generate color presentation options
func compute_color_presentations(color) {
    let presentations = []
    const r = to_int(color["red"] * 255.0)
    const g = to_int(color["green"] * 255.0)
    const b = to_int(color["blue"] * 255.0)

    // Hex format
    const hex = "#" + int_to_hex(r) + int_to_hex(g) + int_to_hex(b)
    presentations.push({"label": hex})

    // RGB format
    presentations.push({"label": f"rgb({r}, {g}, {b})"})

    // RGBA format
    const a = if color.has("alpha") { color["alpha"] } else { 1.0 }
    presentations.push({"label": f"rgba({r}, {g}, {b}, {a})"})

    presentations
}

// Convert integer to 2-digit hex string
func int_to_hex(n) {
    const hex_chars = "0123456789abcdef"
    const high = n / 16
    const low = n % 16
    "" + hex_chars[high] + hex_chars[low]
}

// ══════════════════════════════════════════════════════════════════════
// ── Completion Item Resolve ─────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

// Resolve additional information for a completion item
func resolve_completion_item(item) {
    const label = item["label"]
    const kind = if item.has("kind") { item["kind"] } else { CIK_TEXT }

    // Add documentation for builtins
    if kind == CIK_FUNCTION && BUILTIN_DOCS.has(label) {
        item["documentation"] = {
            "kind": "markdown",
            "value": BUILTIN_DOCS[label]
        }
    }

    // Add documentation for keywords
    if kind == CIK_KEYWORD && KEYWORD_DOCS.has(label) {
        item["documentation"] = {
            "kind": "markdown",
            "value": KEYWORD_DOCS[label]
        }
    }

    item
}

// ══════════════════════════════════════════════════════════════════════
// ── Inlay Hint Resolve ──────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func resolve_inlay_hint(hint) {
    // Add tooltip with more detail
    if hint.has("label") {
        const label = hint["label"]
        if label.starts_with(": ") {
            hint["tooltip"] = {
                "kind": "markdown",
                "value": f"Inferred type: `{label.substring(2, len(label))}`"
            }
        }
    }
    hint
}

// ══════════════════════════════════════════════════════════════════════
// ── Code Lens Resolve ───────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func resolve_code_lens(lens) {
    // Code lenses are already resolved in compute_code_lenses
    lens
}

// ══════════════════════════════════════════════════════════════════════
// ── didSave / willSave Handlers ─────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════

func handle_did_save(params) {
    const uri = params["textDocument"]["uri"]
    // Re-validate the document on save
    if params.has("text") {
        const text = params["text"]
        const diags = lsp_cache_document(uri, text)
        return make_publish_diagnostics(uri, diags)
    }
    // If no text included, use cached
    const doc = lsp_get_document(uri)
    if doc != null {
        return make_publish_diagnostics(uri, doc["diagnostics"])
    }
    null
}

func handle_will_save(params) {
    // Notification before save — no action needed
    null
}

