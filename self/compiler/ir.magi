enum Instruction {
    PushNull,
    PushBool(bool),
    PushI64(int),
    PushF64(float),
    PushString(int),

    LocalGet(int),
    LocalSet(int),
    GlobalGet(int),
    GlobalSet(int),

    I64Add,
    I64Sub,
    I64Mul,
    I64Div,
    I64Rem,
    I64Neg,

    F64Add,
    F64Sub,
    F64Mul,
    F64Div,

    I64Eq,
    I64Ne,
    I64Lt,
    I64Gt,
    I64Le,
    I64Ge,

    BoolNot,

    Block,
    Loop,
    End,
    Br(int),
    BrIf(int),
    If,
    IfVoid,
    Else,
    Return,
    Drop,

    Call(string, int),
    Print,

    ArrayNew(int),
    ArrayGet,
    StringConcat,

    RuntimeCall(string),
}

func Instruction.dump(self) {
    match self {
        Instruction::PushNull => "push_null",
        Instruction::PushBool(b) => f"push_bool({b})",
        Instruction::PushI64(n) => f"push_i64({n})",
        Instruction::PushF64(f) => f"push_f64({f})",
        Instruction::PushString(i) => f"push_string({i})",
        Instruction::LocalGet(i) => f"local_get({i})",
        Instruction::LocalSet(i) => f"local_set({i})",
        Instruction::GlobalGet(i) => f"global_get({i})",
        Instruction::GlobalSet(i) => f"global_set({i})",
        Instruction::I64Add => "i64.add",
        Instruction::I64Sub => "i64.sub",
        Instruction::I64Mul => "i64.mul",
        Instruction::I64Div => "i64.div",
        Instruction::I64Rem => "i64.rem",
        Instruction::I64Neg => "i64.neg",
        Instruction::F64Add => "f64.add",
        Instruction::F64Sub => "f64.sub",
        Instruction::F64Mul => "f64.mul",
        Instruction::F64Div => "f64.div",
        Instruction::I64Eq => "i64.eq",
        Instruction::I64Ne => "i64.ne",
        Instruction::I64Lt => "i64.lt",
        Instruction::I64Gt => "i64.gt",
        Instruction::I64Le => "i64.le",
        Instruction::I64Ge => "i64.ge",
        Instruction::BoolNot => "bool.not",
        Instruction::Block => "block",
        Instruction::Loop => "loop",
        Instruction::End => "end",
        Instruction::Br(d) => f"br({d})",
        Instruction::BrIf(d) => f"br_if({d})",
        Instruction::If => "if",
        Instruction::IfVoid => "if_void",
        Instruction::Else => "else",
        Instruction::Return => "return",
        Instruction::Drop => "drop",
        Instruction::Call(name, argc) => f"call({name}, {argc})",
        Instruction::Print => "print",
        Instruction::ArrayNew(n) => f"array_new({n})",
        Instruction::ArrayGet => "array_get",
        Instruction::StringConcat => "string_concat",
        Instruction::RuntimeCall(name) => f"runtime_call({name})",
    }
}
struct IrLocal {
    name: string,
    idx: int,
}
func ir_func_new(name, param_count) {
    { "name": name, "param_count": param_count, "locals": [], "instructions": [] }
}

func ir_func_local_count(f) {
    len(f["locals"])
}

func ir_func_find_local(f, name) {
    const locs = f["locals"]
    let found = -1
    let i = 0
    while i < len(locs) {
        const loc = locs[i]
        if loc["name"] == name {
            found = i
        }
        i = i + 1
    }
    found
}
let ir_strings = []
let ir_functions = []
let ir_globals = []

func ir_module_reset() {
    ir_strings = []
    ir_functions = []
    ir_globals = []
}

func ir_intern_string(s) {
    let i = 0
    while i < len(ir_strings) {
        if ir_strings[i] == s {
            return i
        }
        i = i + 1
    }
    const idx = len(ir_strings)
    ir_strings.push(s)
    idx
}

func ir_add_function(f) {
    ir_functions.push(f)
}

func ir_find_function(name) {
    let i = 0
    while i < len(ir_functions) {
        const f = ir_functions[i]
        if f["name"] == name {
            return i
        }
        i = i + 1
    }
    -1
}
func ir_snapshot() {
    {
        "functions": ir_functions,
        "strings": ir_strings,
        "globals": ir_globals,
    }
}
