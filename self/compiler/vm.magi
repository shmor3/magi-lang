let vm_stack = []
let vm_locals = []
let vm_globals = []
let vm_output = []
let vm_strings = []
let vm_functions = []

let vm_instrs = []
let vm_n = 0
let vm_ip = 0

let vm_frame_stack = []

let vm_call_stack = []
func vm_push(v) { vm_stack.push(v) }

func vm_pop() {
    const n = len(vm_stack)
    if n == 0 { return null }
    const v = vm_stack[n - 1]
    vm_stack = vm_stack.slice(0, n - 1)
    v
}

func vm_peek() {
    const n = len(vm_stack)
    if n == 0 { null } else { vm_stack[n - 1] }
}
func vm_truthy(v) {
    if v == null { return false }
    if v == false { return false }
    if v == 0 { return false }
    if v == "" { return false }
    true
}

func vm_str(v) {
    if v == null { return "null" }
    to_string(v)
}
func vm_scan_end(from) {
    let depth = 1
    let i = from
    while i < vm_n {
        const d = vm_instrs[i].dump()
        if d == "block" || d == "loop" || d == "if_void" || d == "if" {
            depth = depth + 1
        } else if d == "end" {
            depth = depth - 1
            if depth == 0 { return i }
        }
        i = i + 1
    }
    vm_n
}

func vm_scan_else_end(from) {
    let depth = 1
    let i = from
    while i < vm_n {
        const d = vm_instrs[i].dump()
        if d == "block" || d == "loop" || d == "if_void" || d == "if" {
            depth = depth + 1
        } else if d == "end" {
            depth = depth - 1
            if depth == 0 { return [i, false] }
        } else if d == "else" && depth == 1 {
            return [i, true]
        }
        i = i + 1
    }
    [vm_n, false]
}
func vm_setup_func(f, args) {
    vm_instrs = f["instructions"]
    vm_n = f["instruction_count"]
    vm_ip = 0
    vm_frame_stack = []
    vm_stack = []
    vm_locals = []
    let pi = 0
    while pi < len(args) {
        vm_locals.push(args[pi])
        pi = pi + 1
    }
    const f_lc = f["local_count"]
    while len(vm_locals) < f_lc {
        vm_locals.push(null)
    }
}
func vm_rt(name, arg) {
    match name {
        "to_string" => vm_str(arg),
        "array_len" => {
            if arg == null { 0 } else { len(arg) }
        },
        _ => null,
    }
}
func vm_exec() {
    let result = null
    let running = true

    while running && vm_ip < vm_n {
        const instr = vm_instrs[vm_ip]
        vm_ip = vm_ip + 1
        const d = instr.dump()

        if d == "push_null" {
            vm_push(null)
        } else if d == "push_bool(true)" {
            vm_push(true)
        } else if d == "push_bool(false)" {
            vm_push(false)
        } else if d.slice(0, 9) == "push_i64(" {
            match instr { Instruction::PushI64(n) => vm_push(n), _ => {} }
        } else if d.slice(0, 9) == "push_f64(" {
            match instr { Instruction::PushF64(f) => vm_push(f), _ => {} }
        } else if d.slice(0, 10) == "push_bool(" {
            match instr { Instruction::PushBool(b) => vm_push(b), _ => {} }
        } else if d.slice(0, 12) == "push_string(" {
            match instr {
                Instruction::PushString(idx) => {
                    if idx < len(vm_strings) { vm_push(vm_strings[idx]) }
                    else { vm_push("") }
                },
                _ => {},
            }

        } else if d.slice(0, 10) == "local_get(" {
            match instr {
                Instruction::LocalGet(idx) => {
                    if idx < len(vm_locals) { vm_push(vm_locals[idx]) }
                    else { vm_push(null) }
                },
                _ => {},
            }
        } else if d.slice(0, 10) == "local_set(" {
            match instr {
                Instruction::LocalSet(idx) => {
                    const v = vm_pop()
                    while len(vm_locals) <= idx { vm_locals.push(null) }
                    vm_locals[idx] = v
                },
                _ => {},
            }
        } else if d.slice(0, 11) == "global_get(" {
            match instr {
                Instruction::GlobalGet(idx) => {
                    if idx < len(vm_globals) { vm_push(vm_globals[idx]) }
                    else { vm_push(null) }
                },
                _ => {},
            }
        } else if d.slice(0, 11) == "global_set(" {
            match instr {
                Instruction::GlobalSet(idx) => {
                    const v = vm_pop()
                    while len(vm_globals) <= idx { vm_globals.push(null) }
                    vm_globals[idx] = v
                },
                _ => {},
            }

        } else if d == "i64.add" {
            const b = vm_pop(); const a = vm_pop()
            if reflect_type_of(a) == "string" || reflect_type_of(b) == "string" {
                vm_push(vm_str(a) + vm_str(b))
            } else { vm_push(a + b) }
        } else if d == "i64.sub" {
            const b = vm_pop(); const a = vm_pop(); vm_push(a - b)
        } else if d == "i64.mul" {
            const b = vm_pop(); const a = vm_pop(); vm_push(a * b)
        } else if d == "i64.div" {
            const b = vm_pop(); const a = vm_pop()
            if b == 0 { vm_push(0) } else { vm_push(a / b) }
        } else if d == "i64.rem" {
            const b = vm_pop(); const a = vm_pop()
            if b == 0 { vm_push(0) } else { vm_push(a % b) }
        } else if d == "i64.neg" {
            const a = vm_pop(); vm_push(0 - a)
        } else if d == "f64.add" {
            const b = vm_pop(); const a = vm_pop(); vm_push(a + b)
        } else if d == "f64.sub" {
            const b = vm_pop(); const a = vm_pop(); vm_push(a - b)
        } else if d == "f64.mul" {
            const b = vm_pop(); const a = vm_pop(); vm_push(a * b)
        } else if d == "f64.div" {
            const b = vm_pop(); const a = vm_pop(); vm_push(a / b)
        } else if d == "i64.eq" {
            const b = vm_pop(); const a = vm_pop(); vm_push(a == b)
        } else if d == "i64.ne" {
            const b = vm_pop(); const a = vm_pop(); vm_push(a != b)
        } else if d == "i64.lt" {
            const b = vm_pop(); const a = vm_pop(); vm_push(a < b)
        } else if d == "i64.gt" {
            const b = vm_pop(); const a = vm_pop(); vm_push(a > b)
        } else if d == "i64.le" {
            const b = vm_pop(); const a = vm_pop(); vm_push(a <= b)
        } else if d == "i64.ge" {
            const b = vm_pop(); const a = vm_pop(); vm_push(a >= b)
        } else if d == "bool.not" {
            const a = vm_pop(); vm_push(!vm_truthy(a))

        } else if d == "drop" {
            vm_pop()
        } else if d == "print" {
            const v = vm_pop()
            const s = vm_str(v)
            vm_output.push(s)
            println(s)
        } else if d == "string_concat" {
            const b = vm_pop(); const a = vm_pop()
            vm_push(vm_str(a) + vm_str(b))

        } else if d.slice(0, 10) == "array_new(" {
            match instr {
                Instruction::ArrayNew(count) => {
                    let elems = []
                    let ai = 0
                    while ai < count {
                        elems.push(vm_pop())
                        ai = ai + 1
                    }
                    let arr = []
                    let ri = len(elems) - 1
                    while ri >= 0 {
                        arr.push(elems[ri])
                        ri = ri - 1
                    }
                    vm_push(arr)
                },
                _ => {},
            }
        } else if d == "array_get" {
            const idx = vm_pop()
            const arr = vm_pop()
            if arr != null && idx >= 0 && idx < len(arr) {
                vm_push(arr[idx])
            } else {
                vm_push(null)
            }

        } else if d.slice(0, 13) == "runtime_call(" {
            match instr {
                Instruction::RuntimeCall(name) => {
                    const arg = vm_pop()
                    vm_push(vm_rt(name, arg))
                },
                _ => {},
            }

        } else if d.slice(0, 5) == "call(" {
            match instr {
                Instruction::Call(cname, argc) => {
                    let cargs = []
                    let ci = 0
                    while ci < argc {
                        cargs.push(vm_pop())
                        ci = ci + 1
                    }
                    let rargs = []
                    let ri = len(cargs) - 1
                    while ri >= 0 {
                        rargs.push(cargs[ri])
                        ri = ri - 1
                    }
                    let found_f = null
                    let fi = 0
                    while fi < len(vm_functions) {
                        const ff = vm_functions[fi]
                        if ff["name"] == cname { found_f = ff }
                        fi = fi + 1
                    }
                    if found_f != null {
                        const saved = {
                            "instrs": vm_instrs,
                            "n": vm_n,
                            "ip": vm_ip,
                            "stack": vm_stack,
                            "locals": vm_locals,
                            "frames": vm_frame_stack,
                        }
                        vm_call_stack.push(saved)
                        vm_setup_func(found_f, rargs)
                    } else {
                        const br = vm_builtin(cname, rargs)
                        vm_push(br)
                    }
                },
                _ => {},
            }

        } else if d == "return" {
            result = vm_pop()
            const cs_n = len(vm_call_stack)
            if cs_n > 0 {
                const saved = vm_call_stack[cs_n - 1]
                vm_call_stack = vm_call_stack.slice(0, cs_n - 1)
                vm_instrs = saved["instrs"]
                vm_n = saved["n"]
                vm_ip = saved["ip"]
                vm_stack = saved["stack"]
                vm_locals = saved["locals"]
                vm_frame_stack = saved["frames"]
                vm_push(result)
            } else {
                running = false
            }

        } else if d == "loop" {
            const loop_end = vm_scan_end(vm_ip)
            const frame = { "type": "loop", "start": vm_ip, "end": loop_end }
            vm_frame_stack.push(frame)

        } else if d == "if" {
            const cond = vm_pop()
            const locs = vm_scan_else_end(vm_ip)
            const split = locs[0]
            const has_else = locs[1]
            const end_pos = if has_else { vm_scan_end(split + 1) } else { split }
            if vm_truthy(cond) {
                const frame = { "type": "if", "start": vm_ip, "end": end_pos, "split": split, "has_else": has_else }
                vm_frame_stack.push(frame)
            } else {
                if has_else {
                    const frame = { "type": "if", "start": vm_ip, "end": end_pos, "split": split, "has_else": has_else }
                    vm_frame_stack.push(frame)
                    vm_ip = split + 1
                } else {
                    vm_push(null)
                    vm_ip = split + 1
                }
            }

        } else if d == "if_void" {
            const cond = vm_pop()
            const locs = vm_scan_else_end(vm_ip)
            const split = locs[0]
            const has_else = locs[1]
            const end_pos = if has_else { vm_scan_end(split + 1) } else { split }
            if vm_truthy(cond) {
                const frame = { "type": "if_void", "start": vm_ip, "end": end_pos, "split": split, "has_else": has_else }
                vm_frame_stack.push(frame)
            } else {
                if has_else {
                    const frame = { "type": "if_void", "start": vm_ip, "end": end_pos, "split": split, "has_else": has_else }
                    vm_frame_stack.push(frame)
                    vm_ip = split + 1
                } else {
                    vm_ip = split + 1
                }
            }

        } else if d == "else" {
            const fns = len(vm_frame_stack)
            if fns > 0 {
                const fr = vm_frame_stack[fns - 1]
                vm_frame_stack = vm_frame_stack.slice(0, fns - 1)
                vm_ip = fr["end"] + 1
            }

        } else if d == "end" {
            const fns = len(vm_frame_stack)
            if fns > 0 {
                const fr = vm_frame_stack[fns - 1]
                if fr["type"] == "loop" {
                    vm_ip = fr["start"]
                } else {
                    vm_frame_stack = vm_frame_stack.slice(0, fns - 1)
                }
            }

        } else if d == "block" {
            const block_end = vm_scan_end(vm_ip)
            const frame = { "type": "block", "start": vm_ip, "end": block_end }
            vm_frame_stack.push(frame)

        } else if d.slice(0, 6) == "br_if(" {
            const cond = vm_pop()
            if vm_truthy(cond) {
                match instr {
                    Instruction::BrIf(depth) => {
                        vm_ip = vm_br(depth)
                    },
                    _ => {},
                }
            }

        } else if d.slice(0, 3) == "br(" {
            match instr {
                Instruction::Br(depth) => {
                    vm_ip = vm_br(depth)
                },
                _ => {},
            }
        }
    }

    result
}
func vm_br(depth) {
    let bd = depth
    let target_ip = vm_n
    let fns = len(vm_frame_stack)
    while bd >= 0 && fns > 0 {
        const fr = vm_frame_stack[fns - 1]
        vm_frame_stack = vm_frame_stack.slice(0, fns - 1)
        fns = fns - 1
        if bd == 0 {
            if fr["type"] == "loop" {
                vm_frame_stack.push(fr)
                fns = fns + 1
                target_ip = fr["start"]
            } else {
                target_ip = fr["end"] + 1
            }
            bd = -1
        } else {
            bd = bd - 1
            target_ip = fr["end"] + 1
        }
    }
    target_ip
}
func vm_builtin(name, args) {
    match name {
        "println" => {
            const s = if len(args) > 0 { vm_str(args[0]) } else { "" }
            vm_output.push(s)
            println(s)
            null
        },
        "to_string" => {
            if len(args) > 0 { vm_str(args[0]) } else { "" }
        },
        "len" => {
            if len(args) > 0 { len(args[0]) } else { 0 }
        },
        "assert" => {
            if len(args) > 0 && !vm_truthy(args[0]) {
                panic("VM assertion failed")
            }
            null
        },
        _ => null,
    }
}
func run_ir(module_snapshot) {
    vm_stack = []
    vm_locals = []
    vm_globals = []
    vm_output = []
    vm_strings = module_snapshot["strings"]
    vm_functions = module_snapshot["functions"]
    vm_call_stack = []

    let main_f = null
    let i = 0
    while i < len(vm_functions) {
        const f = vm_functions[i]
        if f["name"] == "__main" { main_f = f }
        i = i + 1
    }
    if main_f == null { return [] }

    vm_setup_func(main_f, [])
    vm_exec()
    vm_output
}
func compile_and_run(source) {
    const program = parse(source)
    const module = compile_to_ir(program)
    run_ir(module)
}

let wvm_memory = []
let wvm_globals = []
let wvm_stack = []
let wvm_locals = []
let wvm_call_stack = []
let wvm_types = []
let wvm_code = []
let wvm_func_type_indices = []
let wvm_imports = []
let wvm_exports = {}
let wvm_func_table = []
let wvm_host_fns = {}
let wvm_num_imports = 0
let wvm_output = []
func wvm_push(v) { wvm_stack.push(v) }

func wvm_pop() {
    const n = len(wvm_stack)
    if n == 0 { return 0 }
    const v = wvm_stack[n - 1]
    wvm_stack = wvm_stack.slice(0, n - 1)
    v
}

func wvm_pop_i32() {
    const v = wvm_pop()
    if reflect_type_of(v) == "float" { return 0 }
    v
}

func wvm_pop_i64() {
    wvm_pop()
}

func wvm_pop_f64() {
    const v = wvm_pop()
    v
}
func wvm_read_u32(code, pos) {
    let result = 0
    let shift = 0
    let p = pos
    while true {
        const b = code[p]
        p = p + 1
        result = result + ((b & 127) * (1 << shift))
        if (b & 128) == 0 { return [result, p - pos] }
        shift = shift + 7
        if shift >= 35 { return [result, p - pos] }
    }
    [result, p - pos]
}

func wvm_read_i32(code, pos) {
    let result = 0
    let shift = 0
    let p = pos
    while true {
        const b = code[p]
        p = p + 1
        result = result + ((b & 127) * (1 << shift))
        shift = shift + 7
        if (b & 128) == 0 {
            if shift < 32 && (b & 64) != 0 {
                result = result - (1 << shift)
            }
            return [result, p - pos]
        }
        if shift >= 35 { return [result, p - pos] }
    }
    [result, p - pos]
}

func wvm_read_i64(code, pos) {
    let result = 0
    let shift = 0
    let p = pos
    while true {
        const b = code[p]
        p = p + 1
        result = result + ((b & 127) * (1 << shift))
        shift = shift + 7
        if (b & 128) == 0 {
            if shift < 64 && (b & 64) != 0 {
                result = result - (1 << shift)
            }
            return [result, p - pos]
        }
        if shift >= 70 { return [result, p - pos] }
    }
    [result, p - pos]
}

func wvm_read_f64(code, pos) {
    let result = 0
    let i = 0
    while i < 8 {
        result = result + (code[pos + i] * (1 << (i * 8)))
        i = i + 1
    }
    [result, 8]
}

func wvm_read_memarg(code, pos) {
    const r1 = wvm_read_u32(code, pos)
    const align = r1[0]
    const c1 = r1[1]
    const r2 = wvm_read_u32(code, pos + c1)
    const offset = r2[0]
    const c2 = r2[1]
    [align, offset, c1 + c2]
}
func wvm_mem_ensure(addr, size) {
    while len(wvm_memory) < addr + size {
        wvm_memory.push(0)
    }
}

func wvm_mem_read_i32(addr) {
    if addr + 4 > len(wvm_memory) { return 0 }
    wvm_memory[addr] + wvm_memory[addr + 1] * 256 +
    wvm_memory[addr + 2] * 65536 + wvm_memory[addr + 3] * 16777216
}

func wvm_mem_read_i64(addr) {
    if addr + 8 > len(wvm_memory) { return 0 }
    let result = 0
    let i = 0
    while i < 8 {
        result = result + wvm_memory[addr + i] * (1 << (i * 8))
        i = i + 1
    }
    result
}

func wvm_mem_read_f64(addr) {
    wvm_mem_read_i64(addr)
}

func wvm_mem_write_i32(addr, val) {
    wvm_mem_ensure(addr, 4)
    let v = val
    wvm_memory[addr] = v & 255
    wvm_memory[addr + 1] = (v >> 8) & 255
    wvm_memory[addr + 2] = (v >> 16) & 255
    wvm_memory[addr + 3] = (v >> 24) & 255
}

func wvm_mem_write_i64(addr, val) {
    wvm_mem_ensure(addr, 8)
    let v = val
    let i = 0
    while i < 8 {
        wvm_memory[addr + i] = v & 255
        v = v >> 8
        i = i + 1
    }
}

func wvm_mem_write_f64(addr, val) {
    wvm_mem_write_i64(addr, val)
}

func wvm_mem_read_u8(addr) {
    if addr >= len(wvm_memory) { return 0 }
    wvm_memory[addr]
}

func wvm_mem_write_u8(addr, val) {
    wvm_mem_ensure(addr, 1)
    wvm_memory[addr] = val & 255
}

func wvm_mem_read_i16(addr) {
    if addr + 2 > len(wvm_memory) { return 0 }
    const raw = wvm_memory[addr] + wvm_memory[addr + 1] * 256
    if raw >= 32768 { return raw - 65536 }
    raw
}

func wvm_mem_write_i16(addr, val) {
    wvm_mem_ensure(addr, 2)
    wvm_memory[addr] = val & 255
    wvm_memory[addr + 1] = (val >> 8) & 255
}
let wvm_block_stack = []

func wvm_find_end(code, start) {
    let depth = 1
    let pc = start
    while pc < len(code) {
        const op = code[pc]
        if op == 0x02 || op == 0x03 || op == 0x04 {
            depth = depth + 1
            pc = pc + 2
        } else if op == 0x0B {
            depth = depth - 1
            if depth == 0 { return pc + 1 }
            pc = pc + 1
        } else if op == 0x05 {
            pc = pc + 1
        } else if op == 0x0C || op == 0x0D {
            pc = pc + 1
            const r = wvm_read_u32(code, pc)
            pc = pc + r[1]
        } else if op == 0x0E {
            pc = pc + 1
            const r = wvm_read_u32(code, pc)
            const count = r[0]
            pc = pc + r[1]
            let ti = 0
            while ti <= count {
                const tr = wvm_read_u32(code, pc)
                pc = pc + tr[1]
                ti = ti + 1
            }
        } else if op == 0x10 || op == 0x20 || op == 0x21 || op == 0x22 ||
                  op == 0x23 || op == 0x24 || op == 0x3F || op == 0x40 {
            pc = pc + 1
            const r = wvm_read_u32(code, pc)
            pc = pc + r[1]
        } else if op == 0x11 {
            pc = pc + 1
            const r1 = wvm_read_u32(code, pc); pc = pc + r1[1]
            const r2 = wvm_read_u32(code, pc); pc = pc + r2[1]
        } else if op == 0x28 || op == 0x29 || op == 0x2B || op == 0x36 || op == 0x37 {
            pc = pc + 1
            const r1 = wvm_read_u32(code, pc); pc = pc + r1[1]
            const r2 = wvm_read_u32(code, pc); pc = pc + r2[1]
        } else if op == 0x41 {
            pc = pc + 1
            const r = wvm_read_i32(code, pc); pc = pc + r[1]
        } else if op == 0x42 {
            pc = pc + 1
            const r = wvm_read_i64(code, pc); pc = pc + r[1]
        } else if op == 0x44 {
            pc = pc + 9
        } else if op == 0xFC {
            pc = pc + 1
            const r1 = wvm_read_u32(code, pc); pc = pc + r1[1]
            const r2 = wvm_read_u32(code, pc); pc = pc + r2[1]
            const r3 = wvm_read_u32(code, pc); pc = pc + r3[1]
        } else {
            pc = pc + 1
        }
    }
    len(code)
}

func wvm_find_else(code, start) {
    let depth = 1
    let pc = start
    while pc < len(code) {
        const op = code[pc]
        if op == 0x02 || op == 0x03 || op == 0x04 {
            depth = depth + 1
            pc = pc + 2
        } else if op == 0x0B {
            depth = depth - 1
            if depth == 0 { return null }
            pc = pc + 1
        } else if op == 0x05 {
            if depth == 1 { return pc + 1 }
            pc = pc + 1
        } else if op == 0x0C || op == 0x0D {
            pc = pc + 1
            const r = wvm_read_u32(code, pc); pc = pc + r[1]
        } else if op == 0x41 {
            pc = pc + 1
            const r = wvm_read_i32(code, pc); pc = pc + r[1]
        } else if op == 0x42 {
            pc = pc + 1
            const r = wvm_read_i64(code, pc); pc = pc + r[1]
