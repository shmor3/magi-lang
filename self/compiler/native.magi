func x86_f64_neg() {
    nat_push(0x58)
    nat_push(0x66); nat_push(0x48); nat_push(0x0F); nat_push(0x6E); nat_push(0xC0)
    nat_push(0x48); nat_push(0xB8)
    nat_push(0x00); nat_push(0x00); nat_push(0x00); nat_push(0x00)
    nat_push(0x00); nat_push(0x00); nat_push(0x00); nat_push(0x80)
    nat_push(0x66); nat_push(0x48); nat_push(0x0F); nat_push(0x6E); nat_push(0xC8)
    nat_push(0x66); nat_push(0x0F); nat_push(0x57); nat_push(0xC1)
    nat_push(0x66); nat_push(0x48); nat_push(0x0F); nat_push(0x7E); nat_push(0xC0)
