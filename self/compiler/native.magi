func x86_call_func(offset) {
    nat_push(0xE8)
    nat_push_u32(offset)
}
func x86_function_prologue(local_bytes) {
    nat_push(0x55)
    nat_push(0x48); nat_push(0x89); nat_push(0xE5)
    const aligned = ((local_bytes + 15) / 16) * 16
    nat_push(0x48); nat_push(0x81); nat_push(0xEC)
    nat_push_u32(aligned)
}

func x86_function_epilogue() {
    nat_push(0x48); nat_push(0x89); nat_push(0xEC)
    nat_push(0x5D)
    nat_push(0xC3)
}
func x86_sys_write(fd) {
    nat_push(0x48); nat_push(0xC7); nat_push(0xC0)
    nat_push(0x01); nat_push(0x00); nat_push(0x00); nat_push(0x00)
    nat_push(0x48); nat_push(0xC7); nat_push(0xC7)
    nat_push(fd); nat_push(0x00); nat_push(0x00); nat_push(0x00)
    nat_push(0x0F); nat_push(0x05)
}

func x86_print_integer() {
    x86_push_rax()

    nat_push(0x48); nat_push(0x83); nat_push(0xEC); nat_push(0x20)

    x86_pop_rax()

    nat_push(0x48); nat_push(0x85); nat_push(0xC0)

    nat_push(0x88); nat_push(0x04); nat_push(0x24)
    nat_push(0x48); nat_push(0x8D); nat_push(0x34); nat_push(0x24)
    nat_push(0x48); nat_push(0xC7); nat_push(0xC2)
    nat_push(0x01); nat_push(0x00); nat_push(0x00); nat_push(0x00)

    x86_sys_write(1)

    nat_push(0x48); nat_push(0x83); nat_push(0xC4); nat_push(0x20)
}

func x86_itoa_print() {

    x86_pop_rax()

    nat_push(0x48); nat_push(0x83); nat_push(0xEC); nat_push(0x20)

    nat_push(0x48); nat_push(0x85); nat_push(0xC0)

    nat_push(0x48); nat_push(0x31); nat_push(0xC9)

    nat_push(0x49); nat_push(0xC7); nat_push(0xC0)
    nat_push(0x0A); nat_push(0x00); nat_push(0x00); nat_push(0x00)
    nat_push(0x48); nat_push(0x31); nat_push(0xD2)
    nat_push(0x49); nat_push(0xF7); nat_push(0xF0)
    nat_push(0x80); nat_push(0xC2); nat_push(0x30)
    nat_push(0x88); nat_push(0x14); nat_push(0x0C)
    nat_push(0x48); nat_push(0xFF); nat_push(0xC1)
    nat_push(0x48); nat_push(0x85); nat_push(0xC0)
    nat_push(0x75); nat_push(0xED)

    nat_push(0x48); nat_push(0x8D); nat_push(0x34); nat_push(0x24)
    nat_push(0x48); nat_push(0x89); nat_push(0xCA)

    x86_sys_write(1)

    nat_push(0xC6); nat_push(0x04); nat_push(0x24); nat_push(0x0A)
    nat_push(0x48); nat_push(0x8D); nat_push(0x34); nat_push(0x24)
    nat_push(0x48); nat_push(0xC7); nat_push(0xC2)
    nat_push(0x01); nat_push(0x00); nat_push(0x00); nat_push(0x00)
    x86_sys_write(1)

    nat_push(0x48); nat_push(0x83); nat_push(0xC4); nat_push(0x20)
}
let nat_strings = []
let nat_string_data = []
let nat_data_offset = 0

func nat_add_string(s) {
    const idx = len(nat_strings)
    const offset = nat_data_offset
    nat_strings.push(offset)

    const bytes = []
    let i = 0
    while i < len(s) {
        const c = s[i]
        bytes.push(wasm_char_code(c))
        i = i + 1
    }
    const slen = len(bytes)
    nat_string_data.push(slen & 255)
    nat_string_data.push((slen >> 8) & 255)
    nat_string_data.push((slen >> 16) & 255)
    nat_string_data.push((slen >> 24) & 255)
    let bi = 0
    while bi < slen {
        nat_string_data.push(bytes[bi])
        bi = bi + 1
    }
    nat_data_offset = nat_data_offset + 4 + slen
    idx
}
let nat_jump_fixups = []  // each: { "patch_offset", "target_label" }
let nat_labels = {}

func nat_define_label(name) {
    nat_labels[name] = len(nat_out)
}

func nat_emit_jump_fixup(label_name) {
    nat_push(0xE9)
    const patch_offset = len(nat_out)
    nat_push_u32(0)
    nat_jump_fixups.push({ "patch_offset": patch_offset, "target_label": label_name })
}

func nat_emit_jz_fixup(label_name) {
    nat_push(0x0F); nat_push(0x84)
    const patch_offset = len(nat_out)
    nat_push_u32(0)
    nat_jump_fixups.push({ "patch_offset": patch_offset, "target_label": label_name })
}

func nat_emit_jnz_fixup(label_name) {
    nat_push(0x0F); nat_push(0x85)
    const patch_offset = len(nat_out)
    nat_push_u32(0)
    nat_jump_fixups.push({ "patch_offset": patch_offset, "target_label": label_name })
}

func nat_resolve_fixups() {
    let i = 0
    while i < len(nat_jump_fixups) {
        const fixup = nat_jump_fixups[i]
        const patch_off = fixup["patch_offset"]
        const label = fixup["target_label"]
        const target = nat_labels[label]
        if target != null {
            const rel = target - (patch_off + 4)
            nat_out[patch_off] = rel & 255
            nat_out[patch_off + 1] = (rel >> 8) & 255
            nat_out[patch_off + 2] = (rel >> 16) & 255
            nat_out[patch_off + 3] = (rel >> 24) & 255
        }
        i = i + 1
    }
}
func native_translate_full(instr, func_offsets) {
    const d = instr.dump()

    if d == "push_null" { x86_push_imm64(0); return null }
    if d.starts_with("push_i64(") {
        const n = parse_int(d.slice(9, len(d) - 1))
        x86_push_imm64(n)
        return null
    }
    if d.starts_with("push_f64(") {
        const n = parse_int(d.slice(9, len(d) - 1))
        x86_push_imm64(n)
        return null
    }
    if d.starts_with("push_bool(") {
        const b_str = d.slice(10, len(d) - 1)
        if b_str == "true" { x86_push_imm64(1) } else { x86_push_imm64(0) }
        return null
    }
    if d.starts_with("push_string(") {
        const idx = parse_int(d.slice(12, len(d) - 1))
        const offset = if idx < len(nat_strings) { nat_strings[idx] } else { 0 }
        x86_push_imm64(offset)
        return null
    }
    if d.starts_with("push_i32(") {
        const n = parse_int(d.slice(9, len(d) - 1))
        x86_push_imm64(n)
        return null
    }

    if d.starts_with("local_get(") {
        const idx = parse_int(d.slice(10, len(d) - 1))
        const offset = 0 - ((idx + 1) * 8)
        nat_push(0x48); nat_push(0x8B); nat_push(0x85)
        nat_push_u32(offset)
        x86_push_rax()
        return null
    }
    if d.starts_with("local_set(") {
        const idx = parse_int(d.slice(10, len(d) - 1))
        x86_pop_rax()
        const offset = 0 - ((idx + 1) * 8)
        nat_push(0x48); nat_push(0x89); nat_push(0x85)
        nat_push_u32(offset)
        return null
    }
    if d.starts_with("local_tee(") {
        const idx = parse_int(d.slice(10, len(d) - 1))
        nat_push(0x48); nat_push(0x8B); nat_push(0x04); nat_push(0x24)
        const offset = 0 - ((idx + 1) * 8)
        nat_push(0x48); nat_push(0x89); nat_push(0x85)
        nat_push_u32(offset)
        return null
    }
    if d.starts_with("global_get(") {
        x86_push_imm64(0)
        return null
    }
    if d.starts_with("global_set(") {
        x86_pop_rax()
        return null
    }

    if d == "i64.add"  { x86_add();  return null }
    if d == "i64.sub"  { x86_sub();  return null }
    if d == "i64.mul"  { x86_mul();  return null }
    if d == "i64.div"  { x86_div();  return null }
    if d == "i64.rem"  { x86_rem();  return null }
    if d == "i64.neg"  { x86_neg();  return null }

    if d == "f64.add"  { x86_f64_add();  return null }
    if d == "f64.sub"  { x86_f64_sub();  return null }
    if d == "f64.mul"  { x86_f64_mul();  return null }
    if d == "f64.div"  { x86_f64_div();  return null }
    if d == "f64.neg"  { x86_f64_neg();  return null }
    if d == "f64.sqrt" { x86_f64_sqrt(); return null }

    if d == "i64.and"  { x86_and();   return null }
    if d == "i64.or"   { x86_or();    return null }
    if d == "i64.xor"  { x86_xor();   return null }
    if d == "i64.shl"  { x86_shl();   return null }
    if d == "i64.shr_s" { x86_shr();  return null }
    if d == "i64.shr_u" { x86_shr_u(); return null }

    if d == "i64.eq"   { x86_cmp_eq();  return null }
    if d == "i64.ne"   { x86_cmp_ne();  return null }
    if d == "i64.lt"   { x86_cmp_lt();  return null }
    if d == "i64.gt"   { x86_cmp_gt();  return null }
    if d == "i64.le"   { x86_cmp_le();  return null }
    if d == "i64.ge"   { x86_cmp_ge();  return null }

    if d == "bool.not" {
        x86_pop_rax()
        nat_push(0x48); nat_push(0x85); nat_push(0xC0)
        nat_push(0x0F); nat_push(0x94); nat_push(0xC0)
        nat_push(0x48); nat_push(0x0F); nat_push(0xB6); nat_push(0xC0)
        x86_push_rax()
        return null
    }

    if d == "return"   { x86_function_epilogue(); return null }
    if d == "drop"     {
        nat_push(0x48); nat_push(0x83); nat_push(0xC4); nat_push(0x08)
        return null
    }
    if d == "print"    { x86_itoa_print(); return null }
    if d == "string_concat" { nat_push(0x90); return null }
    if d == "array_get"     { nat_push(0x90); return null }
    if d == "array_set"     { nat_push(0x90); return null }
    if d == "array_len"     { nat_push(0x90); return null }
    if d == "unreachable"   { nat_push(0xCC); return null }
    if d == "nop"      { nat_push(0x90); return null }

    if d == "block" || d == "loop" || d == "end" ||
       d == "if" || d == "if_void" || d == "else" {
        nat_push(0x90)
        return null
    }
    if d.starts_with("br(") || d.starts_with("br_if(") {
        nat_push(0x90)
        return null
    }

    if d.starts_with("call(") {
        nat_push(0x90)
        return null
    }
    if d.starts_with("call_indirect(") {
        nat_push(0x90)
        return null
    }

    if d == "select" {
        x86_pop_rax()
        x86_pop_rbx()
        nat_push(0x59)
        nat_push(0x48); nat_push(0x85); nat_push(0xC0)
        nat_push(0x48); nat_push(0x0F); nat_push(0x44); nat_push(0xCB)
        nat_push(0x51)
        return null
    }

    if d == "mem_load_i64" || d == "mem_store_i64" ||
       d == "mem_load_f64" || d == "mem_store_f64" ||
       d == "mem_load_i32" || d == "mem_store_i32" {
        nat_push(0x90)
        return null
    }
    if d.starts_with("heap_alloc(") {
        nat_push(0x90)
        return null
    }

    if d == "i64_to_f64" {
        x86_pop_rax()
        nat_push(0xF2); nat_push(0x48); nat_push(0x0F); nat_push(0x2A); nat_push(0xC0)
        nat_push(0x66); nat_push(0x48); nat_push(0x0F); nat_push(0x7E); nat_push(0xC0)
        x86_push_rax()
        return null
    }
    if d == "f64_to_i64" {
        x86_pop_rax()
        nat_push(0x66); nat_push(0x48); nat_push(0x0F); nat_push(0x6E); nat_push(0xC0)
        nat_push(0xF2); nat_push(0x48); nat_push(0x0F); nat_push(0x2C); nat_push(0xC0)
        x86_push_rax()
        return null
    }

    if d == "tag_i64" || d == "tag_f64" || d == "tag_bool" ||
       d == "tag_string" || d == "untag_i64" || d == "untag_f64" ||
       d == "untag_bool" || d == "get_tag" {
        nat_push(0x90)
        return null
    }

    if d.starts_with("map_new(") || d == "map_get" || d == "map_set" ||
       d == "string_len" || d.starts_with("runtime_call(") ||
       d.starts_with("array_new(") {
        nat_push(0x90)
        return null
    }

    nat_push(0x90)
}
let arm_out = []

func arm_push(b) { arm_out.push(b) }

func arm_push_u32(val) {
    let v = val
    arm_push(v & 255)
    arm_push((v >> 8) & 255)
    arm_push((v >> 16) & 255)
    arm_push((v >> 24) & 255)
}
func arm_add_imm(rd, rn, imm) {
    const instr = 0x91000000 + (imm << 10) + (rn << 5) + rd
    arm_push_u32(instr)
}

func arm_sub_imm(rd, rn, imm) {
    const instr = 0xD1000000 + (imm << 10) + (rn << 5) + rd
    arm_push_u32(instr)
}

func arm_mov_imm(rd, imm) {
    const instr = 0xD2800000 + (imm << 5) + rd
    arm_push_u32(instr)
}

func arm_add_reg(rd, rn, rm) {
    const instr = 0x8B000000 + (rm << 16) + (rn << 5) + rd
    arm_push_u32(instr)
}

func arm_sub_reg(rd, rn, rm) {
    const instr = 0xCB000000 + (rm << 16) + (rn << 5) + rd
    arm_push_u32(instr)
}

func arm_mul_reg(rd, rn, rm) {
    const instr = 0x9B007C00 + (rm << 16) + (rn << 5) + rd
    arm_push_u32(instr)
}

func arm_sdiv_reg(rd, rn, rm) {
    const instr = 0x9AC00C00 + (rm << 16) + (rn << 5) + rd
    arm_push_u32(instr)
}

func arm_and_reg(rd, rn, rm) {
    const instr = 0x8A000000 + (rm << 16) + (rn << 5) + rd
    arm_push_u32(instr)
}

func arm_orr_reg(rd, rn, rm) {
    const instr = 0xAA000000 + (rm << 16) + (rn << 5) + rd
    arm_push_u32(instr)
}

func arm_eor_reg(rd, rn, rm) {
    const instr = 0xCA000000 + (rm << 16) + (rn << 5) + rd
    arm_push_u32(instr)
}

func arm_lsl_reg(rd, rn, rm) {
    const instr = 0x9AC02000 + (rm << 16) + (rn << 5) + rd
    arm_push_u32(instr)
}

func arm_asr_reg(rd, rn, rm) {
    const instr = 0x9AC02800 + (rm << 16) + (rn << 5) + rd
    arm_push_u32(instr)
}

func arm_neg(rd, rm) {
    const instr = 0xCB000000 + (rm << 16) + (31 << 5) + rd
    arm_push_u32(instr)
}

func arm_cmp_reg(rn, rm) {
    const instr = 0xEB000000 + (rm << 16) + (rn << 5) + 31
    arm_push_u32(instr)
}

func arm_cset(rd, cond) {
    const inv_cond = cond ^ 1
    const instr = 0x9A9F0400 + (inv_cond << 12) + rd
    arm_push_u32(instr)
}

func arm_cmp_and_set(rd, rn, rm, cond) {
    arm_cmp_reg(rn, rm)
    arm_cset(rd, cond)
}

func arm_str(rt, rn, offset) {
    const scaled = offset / 8
    const instr = 0xF9000000 + (scaled << 10) + (rn << 5) + rt
    arm_push_u32(instr)
}

func arm_ldr(rt, rn, offset) {
    const scaled = offset / 8
    const instr = 0xF9400000 + (scaled << 10) + (rn << 5) + rt
    arm_push_u32(instr)
}

func arm_svc(imm) {
    const instr = 0xD4000001 + (imm << 5)
    arm_push_u32(instr)
}

func arm_ret() {
    arm_push_u32(0xD65F03C0)
}

func arm_bl(offset) {
    const off26 = (offset / 4) & 0x3FFFFFF
    const instr = 0x94000000 + off26
    arm_push_u32(instr)
}

func arm_b(offset) {
    const off26 = (offset / 4) & 0x3FFFFFF
    const instr = 0x14000000 + off26
    arm_push_u32(instr)
}

func arm_syscall_exit(code) {
    arm_mov_imm(0, code)
    arm_mov_imm(8, 93)
    arm_svc(0)
}
func macho_emit_header(entry_offset, code_size) {
    nat_push_u32(0xFEEDFACF)
    nat_push_u32(0x01000007)
    nat_push_u32(3)
    nat_push_u32(2)
    nat_push_u32(2)
    nat_push_u32(0)
    nat_push_u32(0)
    nat_push_u32(0)
}
func compile_to_native_full(module) {
    const functions = module["functions"]
    const strings   = module["strings"]
    const nfuncs    = len(functions)

    nat_out = []
    nat_strings = []
    nat_string_data = []
    nat_data_offset = 0
    nat_jump_fixups = []
    nat_labels = {}

    let si = 0
    while si < len(strings) {
        nat_add_string(strings[si])
        si = si + 1
    }

    const LOAD_ADDR = 0x400000
    const HDR_SIZE  = 64
    const PHDR_SIZE = 56
    const PHDR_COUNT = 2
    const CODE_OFF  = HDR_SIZE + PHDR_SIZE * PHDR_COUNT

    const entry_vaddr = LOAD_ADDR + CODE_OFF

    elf64_emit_header(entry_vaddr)
    elf64_emit_phdr(LOAD_ADDR, 0)

    const code_start = len(nat_out)

    x86_function_prologue(4096)

    let fi = 0
    while fi < nfuncs {
        nat_define_label(functions[fi]["name"])
        const fn_def = functions[fi]
        const instrs = fn_def["instructions"]
        const n = fn_def["instruction_count"]
        let ii = 0
        while ii < n {
            native_translate_full(instrs[ii], {})
            ii = ii + 1
        }
        fi = fi + 1
    }

    x86_function_epilogue()
    x86_syscall_exit()

    nat_resolve_fixups()

    const result = nat_out
    nat_out = []
    result
}
