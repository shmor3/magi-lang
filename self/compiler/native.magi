func x86_f64_add() {
    nat_push(0x58)
    nat_push(0x66); nat_push(0x48); nat_push(0x0F); nat_push(0x6E); nat_push(0xC8)
    nat_push(0x58)
    nat_push(0x66); nat_push(0x48); nat_push(0x0F); nat_push(0x6E); nat_push(0xC0)
    nat_push(0xF2); nat_push(0x0F); nat_push(0x58); nat_push(0xC1)
    nat_push(0x66); nat_push(0x48); nat_push(0x0F); nat_push(0x7E); nat_push(0xC0)
    nat_push(0x50)
}

func x86_f64_sub() {
    nat_push(0x58)
    nat_push(0x66); nat_push(0x48); nat_push(0x0F); nat_push(0x6E); nat_push(0xC8)
    nat_push(0x58)
    nat_push(0x66); nat_push(0x48); nat_push(0x0F); nat_push(0x6E); nat_push(0xC0)
    nat_push(0xF2); nat_push(0x0F); nat_push(0x5C); nat_push(0xC1)
    nat_push(0x66); nat_push(0x48); nat_push(0x0F); nat_push(0x7E); nat_push(0xC0)
    nat_push(0x50)
}

func x86_f64_mul() {
    nat_push(0x58)
    nat_push(0x66); nat_push(0x48); nat_push(0x0F); nat_push(0x6E); nat_push(0xC8)
    nat_push(0x58)
    nat_push(0x66); nat_push(0x48); nat_push(0x0F); nat_push(0x6E); nat_push(0xC0)
    nat_push(0xF2); nat_push(0x0F); nat_push(0x59); nat_push(0xC1)
    nat_push(0x66); nat_push(0x48); nat_push(0x0F); nat_push(0x7E); nat_push(0xC0)
    nat_push(0x50)
