let nat_out = []

func nat_push(b) {
    nat_out.push(b)
}

func nat_push_u64(val) {
    let v = val
    let i = 0
    while i < 8 {
        nat_push(v & 255)
        v = v >> 8
        i = i + 1
    }
}

func nat_push_u32(val) {
    let v = val
    let i = 0
    while i < 4 {
        nat_push(v & 255)
        v = v >> 8
        i = i + 1
    }
}

func nat_push_u16(val) {
    nat_push(val & 255)
    nat_push((val >> 8) & 255)
}
func x86_push_imm64(val) {
    nat_push(0x48); nat_push(0xB8)
    nat_push_u64(val)
    nat_push(0x50)
}

func x86_pop_rax() { nat_push(0x58) }
func x86_pop_rbx() { nat_push(0x5B) }
func x86_push_rax() { nat_push(0x50) }

func x86_add() {
    x86_pop_rbx(); x86_pop_rax()
    nat_push(0x48); nat_push(0x01); nat_push(0xD8)
    x86_push_rax()
}

func x86_sub() {
    x86_pop_rbx(); x86_pop_rax()
    nat_push(0x48); nat_push(0x29); nat_push(0xD8)
    x86_push_rax()
}

func x86_mul() {
    x86_pop_rbx(); x86_pop_rax()
    nat_push(0x48); nat_push(0x0F); nat_push(0xAF); nat_push(0xC3)
    x86_push_rax()
}

func x86_div() {
    x86_pop_rbx(); x86_pop_rax()
    nat_push(0x48); nat_push(0x99)
    nat_push(0x48); nat_push(0xF7); nat_push(0xFB)
    x86_push_rax()
}

func x86_rem() {
    x86_pop_rbx(); x86_pop_rax()
    nat_push(0x48); nat_push(0x99)
    nat_push(0x48); nat_push(0xF7); nat_push(0xFB)
    nat_push(0x52)
}

func x86_neg() {
    x86_pop_rax()
    nat_push(0x48); nat_push(0xF7); nat_push(0xD8)
    x86_push_rax()
}

func x86_cmp_helper(set_byte) {
    x86_pop_rbx(); x86_pop_rax()
    nat_push(0x48); nat_push(0x39); nat_push(0xD8)
    nat_push(0x0F); nat_push(set_byte); nat_push(0xC0)
    nat_push(0x48); nat_push(0x0F); nat_push(0xB6); nat_push(0xC0)
    x86_push_rax()
}

func x86_cmp_eq()  { x86_cmp_helper(0x94) }
func x86_cmp_ne()  { x86_cmp_helper(0x95) }
func x86_cmp_lt()  { x86_cmp_helper(0x9C) }
func x86_cmp_gt()  { x86_cmp_helper(0x9F) }
func x86_cmp_le()  { x86_cmp_helper(0x9E) }
func x86_cmp_ge()  { x86_cmp_helper(0x9D) }

func x86_print_stub() {
    x86_pop_rax()
    nat_push(0x90)
}

func x86_syscall_exit() {
    nat_push(0x48); nat_push(0xC7); nat_push(0xC0)
    nat_push(0x3C); nat_push(0x00); nat_push(0x00); nat_push(0x00)
    nat_push(0x48); nat_push(0x31); nat_push(0xFF)
    nat_push(0x0F); nat_push(0x05)
}
func native_translate_instr(instr) {
    const d = instr.dump()

    if d == "i64.add"  { x86_add();  return null }
    if d == "i64.sub"  { x86_sub();  return null }
    if d == "i64.mul"  { x86_mul();  return null }
    if d == "i64.div"  { x86_div();  return null }
    if d == "i64.rem"  { x86_rem();  return null }
    if d == "i64.neg"  { x86_neg();  return null }
    if d == "i64.eq"   { x86_cmp_eq();  return null }
    if d == "i64.ne"   { x86_cmp_ne();  return null }
    if d == "i64.lt"   { x86_cmp_lt();  return null }
    if d == "i64.gt"   { x86_cmp_gt();  return null }
    if d == "i64.le"   { x86_cmp_le();  return null }
    if d == "i64.ge"   { x86_cmp_ge();  return null }
    if d == "bool.not" {
        x86_pop_rax()
        nat_push(0x48); nat_push(0x85); nat_push(0xC0)
        nat_push(0x0F); nat_push(0x94); nat_push(0xC0)
        nat_push(0x48); nat_push(0x0F); nat_push(0xB6); nat_push(0xC0)
        x86_push_rax()
        return null
    }
    if d == "drop"     {
        nat_push(0x48); nat_push(0x83); nat_push(0xC4); nat_push(0x08)
        return null
    }
    if d == "return"   { nat_push(0xC3); return null }
    if d == "print"    { x86_print_stub(); return null }
    if d == "push_null" { x86_push_imm64(0); return null }
    if d == "string_concat" { nat_push(0x90); return null }
    if d == "array_get"     { nat_push(0x90); return null }

    if d.starts_with("push_i64(") {
        const n_str = d.slice(9, len(d) - 1)
        const n = parse_int(n_str)
        x86_push_imm64(n)
        return null
    }
    if d.starts_with("push_bool(") {
        const b_str = d.slice(10, len(d) - 1)
        if b_str == "true" { x86_push_imm64(1) } else { x86_push_imm64(0) }
        return null
    }
    if d.starts_with("push_string(") {
        const idx_str = d.slice(12, len(d) - 1)
        const idx = parse_int(idx_str)
        x86_push_imm64(idx)
        return null
    }
    if d.starts_with("local_get(") {
        const idx_str = d.slice(10, len(d) - 1)
        const idx = parse_int(idx_str)
        const offset = 0 - ((idx + 1) * 8)
        nat_push(0x48); nat_push(0x8B); nat_push(0x85)
        nat_push_u32(offset)
        x86_push_rax()
        return null
    }
    if d.starts_with("local_set(") {
        const idx_str = d.slice(10, len(d) - 1)
        const idx = parse_int(idx_str)
        x86_pop_rax()
        const offset = 0 - ((idx + 1) * 8)
        nat_push(0x48); nat_push(0x89); nat_push(0x85)
        nat_push_u32(offset)
        return null
    }
    if d.starts_with("global_get(") {
        x86_push_imm64(0)
        return null
    }
    if d.starts_with("global_set(") {
        x86_pop_rax()
        return null
    }
    if d.starts_with("br(") || d.starts_with("br_if(") ||
       d == "block" || d == "loop" || d == "end" ||
       d == "if" || d == "if_void" || d == "else" {
        nat_push(0x90)
        return null
    }
    if d.starts_with("call(") {
        nat_push(0x90)
        return null
    }
    nat_push(0x90)
}
func elf64_emit_header(entry_vaddr) {
    nat_push(127); nat_push(69); nat_push(76); nat_push(70)
    nat_push(2)
    nat_push(1)
    nat_push(1)
    nat_push(0)
    let p = 0
    while p < 8 { nat_push(0); p = p + 1 }

    nat_push_u16(2)
    nat_push_u16(0x3E)
    nat_push_u32(1)
    nat_push_u64(entry_vaddr)
    nat_push_u64(64)
    nat_push_u64(0)
    nat_push_u32(0)
    nat_push_u16(64)
    nat_push_u16(56)
    nat_push_u16(1)
    nat_push_u16(64)
    nat_push_u16(0)
    nat_push_u16(0)
}

func elf64_emit_phdr(vaddr, filesz) {
    nat_push_u32(1)
    nat_push_u32(5)
    nat_push_u64(0)
    nat_push_u64(vaddr)
    nat_push_u64(vaddr)
    nat_push_u64(filesz)
    nat_push_u64(filesz)
    nat_push_u64(0x200000)
}
func compile_to_native(module) {
    const functions = module["functions"]
    const nfuncs    = len(functions)

    nat_out = []

    const LOAD_ADDR = 0x400000
    const HDR_SIZE  = 64
    const PHDR_SIZE = 56
    const CODE_OFF  = HDR_SIZE + PHDR_SIZE

    const entry_vaddr = LOAD_ADDR + CODE_OFF

    elf64_emit_header(entry_vaddr)

    elf64_emit_phdr(LOAD_ADDR, 0)

    nat_push(0x55)
    nat_push(0x48); nat_push(0x89); nat_push(0xE5)
    nat_push(0x48); nat_push(0x81); nat_push(0xEC)
    nat_push(0x00); nat_push(0x08); nat_push(0x00); nat_push(0x00)

    let fi = 0
    while fi < nfuncs {
        const fn_def = functions[fi]
        const instrs = fn_def["instructions"]
        const n      = fn_def["instruction_count"]
        let ii = 0
        while ii < n {
            native_translate_instr(instrs[ii])
            ii = ii + 1
        }
        fi = fi + 1
    }

    nat_push(0x5D)
    x86_syscall_exit()

    const result = nat_out
    nat_out = []
    result
}

func x86_rex(w, r, x, b) {
    nat_push(0x40 + w * 8 + r * 4 + x * 2 + b)
}
func x86_and() {
    x86_pop_rbx(); x86_pop_rax()
    nat_push(0x48); nat_push(0x21); nat_push(0xD8)
    x86_push_rax()
}

func x86_or() {
